/**
 * Parallel Pipeline Example
 *
 * Demonstrates using parallel each to process a batch of inputs
 * concurrently, then formatting and displaying the collected results.
 *
 * Run with: cargo run --bin harn -- run examples/parallel-pipeline.harn
 */
pipeline main(harness: Harness, task) {
  const prompts = [
    "What is 2 + 2?",
    "Name one planet in our solar system.",
    "What color is the sky on a clear day?",
    "How many legs does a spider have?",
    "What is the chemical symbol for water?",
  ]
  harness.stdio.log("Processing ${len(prompts)} prompts in parallel...")
  // parallel each runs the closure concurrently for each item
  const results = parallel each prompts { prompt ->
    "Answer to: ${prompt}"
  }
  // In production, replace with: harness.llm.call(prompt, "Answer in one word.")
  // Using string transform here so the example runs without an API key.
  harness.stdio.log("")
  harness.stdio.log("=== Results ===")
  const idx = 0
  for result in results {
    harness.stdio.log("[${idx + 1}] ${prompts[idx]}")
    harness.stdio.log("    -> ${result}")
    idx = idx + 1
  }
  harness.stdio.log("")
  harness.stdio.log("Processed ${len(results)} items total.")
  // Demonstrate chaining: filter results by length
  const short_answers = results.filter({ r -> len(r) < 40 })
  harness.stdio.log("Short answers (< 40 chars): ${len(short_answers)}")
}
