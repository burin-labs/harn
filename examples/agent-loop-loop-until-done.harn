import { agent_loop } from "std/agent/loop"

pipeline default(harness: Harness, task: unknown) {
  const result = agent_loop(
    harness,
    "Count from 1 to 5, one number per line. Then output ##DONE##.",
    "You are a helpful assistant.",
    {loop_until_done: true, max_nudges: 2},
  )
  harness.stdio.log("Agent output:")
  harness.stdio.log(result.text)
}
