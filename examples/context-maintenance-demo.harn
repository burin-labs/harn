import {
  on_file_edited,
  on_session_end,
  run_crystallize_job,
  run_refresh_job,
} from "./triggers/context-maintenance/lib"

pipeline default(harness: Harness) {
  const refresh = on_file_edited(harness, {event: "FileEdited", session: {id: "demo"}, path: "src/lib.rs"})
  const crystallize = on_session_end(harness, {event: "SessionEnd", session: {id: "demo"}, final_status: "done"},
  )
  harness.stdio.println(run_refresh_job(refresh).status)
  harness.stdio.println(run_crystallize_job(crystallize).artifact_ids[0])
}
