import { triage_start_my_day } from "std/triage"

fn fixture(fs: HarnessFs, name: string) {
  const root = fs.workspace_root()
  return json_parse(fs.read_text(path_join(root, "examples/triage/fixtures/" + name + ".json")))
}

pipeline default(harness: Harness) {
  const feed = triage_start_my_day(
    harness.obs,
    [
      fixture(harness.fs, "github_issue"),
      fixture(harness.fs, "slack_message"),
      fixture(harness.fs, "notion_page"),
    ],
    {
      title: "Start My Day",
      generated_at: "fixture",
      emit: true,
      topic: "triage.inbox.start_my_day",
    },
  )
  for event in feed.events {
    harness.stdio.println(event.provider + " " + event.summary)
  }
  harness.stdio.println("events=" + to_string(len(feed.events)))
  harness.stdio.println("receipts=" + to_string(len(feed.receipts)))
}
