import { triage_start_my_day } from "std/triage"

fn fixture(name) {
  let root = project_root() ?? cwd()
  return json_parse(read_file(path_join(root, "examples/triage/fixtures/" + name + ".json")))
}

pipeline default() {
  let feed = triage_start_my_day(
    [fixture("github_issue"), fixture("slack_message"), fixture("notion_page")],
    {title: "Start My Day", generated_at: "fixture", emit: true, topic: "triage.inbox.start_my_day"},
  )
  for event in feed.events {
    println(event.provider + " " + event.summary)
  }
  println("events=" + to_string(len(feed.events)))
  println("receipts=" + to_string(len(feed.receipts)))
}
