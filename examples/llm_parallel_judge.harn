// Demo: std/llm/ensemble — parallel_judge
//
// Runs a synthetic judge_fn over a list of items concurrently. Output
// preserves input order. No real LLM calls — judge_fn is a plain closure.
//
// Run with: cargo run --quiet --bin harn -- run examples/llm_parallel_judge.harn
import { parallel_judge } from "std/llm/ensemble"

pipeline default() {
  const items = [1, 2, 3, 4]
  const judge_fn = { item -> return {score: item * 10} }
  const results = parallel_judge(items, judge_fn, {max_concurrent: 2})
  for r in results {
    __io_println("item=" + to_string(r.item) + " score=" + to_string(r.verdict.score))
  }
}
