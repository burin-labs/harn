// Demo: std/llm/refine — refine_prompt
//
// Runs a single meta-prompt LLM call to rewrite the user prompt. The mock
// model returns a refined prompt followed by a "DIFF: ..." trailer that
// refine_prompt parses out.
//
// Run with: cargo run --quiet --bin harn -- run examples/llm_refine.harn
import { refine_prompt } from "std/llm/refine"

pipeline default(harness: Harness) {
  harness.llm.mock_clear()
  harness.llm.mock_enqueue(
    {
      text:
        "Summarize the article in 3 bullet points, each under 12 words.\nDIFF: tightened length, added bullet structure",
    },
  )
  const result = refine_prompt(harness,  harness, {
      user_prompt: "please summarize this article briefly with bullets",
      provider: "mock",
      model: "mock-small",
      style: "imperative",
    },
  )
  harness.stdio.println("ok           = " + to_string(result.ok))
  harness.stdio.println("original     = " + result.original)
  harness.stdio.println("refined      = " + result.refined)
  harness.stdio.println("diff_summary = " + result.diff_summary)
}
