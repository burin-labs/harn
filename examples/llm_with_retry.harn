// Demo: std/llm/handlers — with_retry
//
// Wraps a synthetic caller that fails twice then succeeds. with_retry
// re-invokes the inner caller up to max_attempts before giving up.
//
// Run with: cargo run --quiet --bin harn -- run examples/llm_with_retry.harn
import { with_retry } from "std/llm/handlers"

pipeline default(harness: Harness) {
  const counter = harness.runtime.atomic(0)
  const synthetic = { _call ->
    let n = harness.runtime.atomic_add(counter, 1)
    if n < 2 {
      harness.stdio.println("attempt " + to_string(n + 1) + " -> transient")
      return {ok: false, status: "transient", error: "blip"}
    }
    harness.stdio.println("attempt " + to_string(n + 1) + " -> success")
    return {
      ok: true,
      value: {
        text: "all-ok",
        model: "mock",
        provider: "mock",
        input_tokens: 0,
        output_tokens: 0,
        usage: {input_tokens: 0, output_tokens: 0},
      },
    }
  }
  const caller = with_retry(harness, synthetic, {max_attempts: 5, base_ms: 1})
  const env = caller(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  harness.stdio.println("final ok = " + to_string(env.ok))
  harness.stdio.println("final text = " + env.value.text)
  harness.stdio.println("retries_attempted = " + to_string(env.retries_attempted))
}
