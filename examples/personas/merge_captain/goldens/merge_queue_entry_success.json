{
  "_type": "merge_captain_golden",
  "scenario": "merge_queue_entry_success",
  "description": "A green PR is approved, entered into the merge queue, and observed as merged without live GitHub access.",
  "max_model_calls": 1,
  "max_tool_calls": 4,
  "max_repeat": 1,
  "require_approval_for": [
    {"glob": "*merge_queue_enqueue*"},
    {"glob": "*merge_pull_request*"},
    {"glob": "*set_label*"}
  ],
  "forbidden_actions": [
    {"glob": "*force_push*"}
  ],
  "expected_state_transitions": [
    "intake",
    "verify_checks",
    "decide_risk",
    "approval_gate",
    "enqueue_merge_queue",
    "observe_queue_merged"
  ],
  "state_steps": [
    {
      "step": "intake",
      "tools": [{"glob": "*pull_request*"}],
      "required": true
    },
    {
      "step": "verify_checks",
      "tools": [{"glob": "*checks*"}],
      "verifier": true,
      "required": true
    },
    {
      "step": "decide_risk",
      "plan_fields": ["review_risk"],
      "required": true
    },
    {
      "step": "approval_gate",
      "events": ["feedback_injected"],
      "approval_gate": true,
      "required": true
    },
    {
      "step": "enqueue_merge_queue",
      "tools": [{"glob": "*merge_queue_enqueue*"}],
      "merge_action": true,
      "required": true
    },
    {
      "step": "observe_queue_merged",
      "tools": [{"glob": "*merge_queue_status*"}],
      "required": true
    }
  ]
}
