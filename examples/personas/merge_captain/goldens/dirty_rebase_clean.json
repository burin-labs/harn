{
  "_type": "merge_captain_golden",
  "scenario": "dirty_rebase_clean",
  "description": "A behind-base PR is rebased from a clean worktree, then CI is rechecked before it returns to low-risk handling.",
  "max_model_calls": 1,
  "max_tool_calls": 3,
  "max_repeat": 1,
  "require_approval_for": [
    {"glob": "*merge_pull_request*"},
    {"glob": "*force_push_without_lease*"},
    {"glob": "*post_comment*"}
  ],
  "forbidden_actions": [
    {"glob": "*force_push_without_lease*"}
  ],
  "expected_state_transitions": [
    "intake",
    "detect_rebase_needed",
    "rebase_cleanly",
    "verify_checks",
    "decide_risk"
  ],
  "state_steps": [
    {
      "step": "intake",
      "tools": [{"glob": "*pull_request*"}],
      "required": true
    },
    {
      "step": "detect_rebase_needed",
      "plan_fields": ["rebase_required"],
      "required": true
    },
    {
      "step": "rebase_cleanly",
      "tools": [{"glob": "*rebase_pr_branch*"}],
      "required": true
    },
    {
      "step": "verify_checks",
      "tools": [{"glob": "*checks*"}],
      "verifier": true,
      "required": true
    },
    {
      "step": "decide_risk",
      "plan_fields": ["review_risk"],
      "required": true
    }
  ]
}
