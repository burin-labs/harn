/**
 * MCP Client Example
 *
 * Demonstrates connecting to an external MCP server, discovering its
 * tools, invoking them, and cleaning up the connection.
 *
 * This example connects to the echo server bundled with the conformance
 * suite. For real use, replace the server command with your MCP server.
 *
 * Run with: cargo run --bin harn -- run examples/mcp-client.harn
 */
pipeline main(harness: Harness, task) {
  // Locate the bundled echo server for demonstration
  let root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  let harn_bin = harness.env.get("HARN_BIN") ?? "harn"
  let server_path = path_join(root, "conformance/helpers/mcp_echo_server.harn")
  harness.stdio.println("Connecting to MCP echo server...")
  let client = mcp_connect(harn_bin, ["serve", "mcp", server_path])
  harness.stdio.println("Connected (type: ${type_of(client)})")
  // Discover available tools
  let tools = mcp_list_tools(client)
  harness.stdio.println("")
  harness.stdio.println("=== Available Tools (${tools.count}) ===")
  for t in tools {
    harness.stdio.println("  - ${t.name}: ${t.description}")
  }
  // Call the echo tool
  harness.stdio.println("")
  harness.stdio.println("Calling echo tool...")
  let echo_result = mcp_call(client, "echo", {message: "hello from harn"})
  harness.stdio.println("Echo result: ${echo_result}")
  // Call the add tool
  harness.stdio.println("Calling add tool...")
  let sum = mcp_call(client, "add", {a: 17, b: 25})
  harness.stdio.println("17 + 25 = ${sum}")
  // Check server info
  let info = mcp_server_info(client)
  harness.stdio.println("")
  harness.stdio.println("Server connected: ${info.connected}")
  // Clean up
  mcp_disconnect(client)
  harness.stdio.println("Disconnected from MCP server.")
}
