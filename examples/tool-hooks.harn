/**
 * Tool Hooks Example
 *
 * Demonstrates registering pre-hook and post-hook functions on tool
 * calls for observability, access control, and output management.
 *
 * Tool hooks let you:
 *   - Deny specific tools by pattern (pre-hook)
 *   - Truncate oversized tool output (post-hook)
 *   - Apply policies across all tools with wildcard patterns
 *
 * Run with: cargo run --bin harn -- run examples/tool-hooks.harn
 */
pipeline main(harness: Harness, task: unknown) {
  harness.stdio.log("=== Tool Hooks Demo ===")
  harness.stdio.log("")
  // 1. Register a deny hook: block any tool matching "dangerous_*"
  //    If an agent tries to call a tool whose name starts with
  //    "dangerous_", the call is rejected with the given reason.
  harness.tools.register_hook({pattern: "dangerous_*", deny: "This tool is blocked by policy"})
  harness.stdio.log("Registered deny hook for 'dangerous_*' tools")
  // 2. Register an output-limiting hook: truncate any tool output
  //    longer than 500 characters. Applies to all tools via wildcard.
  harness.tools.register_hook({pattern: "*", max_output: 500})
  harness.stdio.log("Registered max_output hook (500 chars) for all tools")
  // 3. Register a hook for a specific tool pattern
  harness.tools.register_hook({pattern: "read_file_*", max_output: 200})
  harness.stdio.log("Registered max_output hook (200 chars) for 'read_file_*' tools")
  harness.stdio.log("")
  harness.stdio.log("All hooks registered. These hooks will be evaluated in order")
  harness.stdio.log("whenever an agent invokes a tool during its execution loop.")
  harness.stdio.log("")
  // Hooks are now active for any subsequent agent_loop or workflow
  // execution in this pipeline. For example:
  //
  //   let result = agent_loop(harness, //     "Analyze this codebase",
  //     "You are a code reviewer.",
  //     {loop_until_done: true, max_nudges: 3}
  //   )
  //
  // Any tool call the agent makes will pass through these hooks.
  // Clean up all hooks when done
  harness.tools.clear_hooks()
  harness.stdio.log("Cleared all tool hooks.")
}
