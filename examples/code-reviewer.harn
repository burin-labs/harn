/**
 * Code Review Agent Example
 *
 * Run with:
 *   harn run examples/code-reviewer.harn -- "$(git diff)"
 *
 * This is a compact review agent that reviews a pasted patch or a task
 * description with optional context files.
 *
 * The patch arrives through `argv`, which is how `harn run` passes input to a
 * pipeline. A host that drives Harn over ACP supplies its own task instead;
 * see docs/src/acp-editor-hosts.md.
 */
pipeline default(harness: Harness) {
  harness.stdio.log("Starting code review agent")
  const task = argv[0]
    ?? "No patch supplied. Pass one with: harn run examples/code-reviewer.harn -- \"$(git diff)\""
  const system = """
You are a senior code reviewer.
Review the change for correctness, security, maintainability, and tests.
Return:
- must-fix issues
- suggestions
- missing tests
End with a short verdict.
"""
  const review = harness.llm.call(task, system, {temperature: 0.2, max_tokens: 1200})
  eval_metric("review_chars", review.text.count)
  harness.stdio.println(review.text)
}
