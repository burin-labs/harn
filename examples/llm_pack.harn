// Demo: std/llm/defaults — pack_for / pack_agent
//
// Shows how a single call to pack_agent produces a fully-resolved llm_call
// option dict with provider/family-aware defaults (temperature, thinking
// budget, max_tokens) baked in.
//
// Run with: cargo run --quiet --bin harn -- run examples/llm_pack.harn
import { pack_agent } from "std/llm/defaults"

pipeline default(harness: Harness) {
  const opts = pack_agent(
    harness.agent,
    harness.llm,
    "claude-sonnet-4-5",
    {prompt: "Build a TODO list", system: "You are precise."},
  )
  harness.stdio.println("model = " + to_string(opts?.model))
  harness.stdio.println("provider = " + to_string(opts?.provider))
  harness.stdio.println("temperature = " + to_string(opts?.temperature))
  harness.stdio.println("thinking budget = " + to_string(opts?.thinking?.budget_tokens))
  harness.stdio.println("max_tokens = " + to_string(opts?.max_tokens))
}
