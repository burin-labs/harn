import { post_message } from "std/connectors/slack"

@persona(name: "merge_captain")
fn merge_captain(ctx: dict) -> string {
  return admin_merge(ctx)
}

@step(name: "admin_merge", approval: required, receipt: audit)
fn admin_merge(ctx: dict) -> string {
  return "merged " + ctx.pr
}

pipeline default(harness: Harness) {
  harness.agent.register_step_hook(
    "merge_captain",
    "admin_merge",
    "PostStep",
    { ctx ->
      post_message(
        harness,
        "#release-ops",
        "merge_captain.admin_merge completed: " + to_string(ctx.output),
        nil,
        {metadata: {persona_hook_target: ctx.target}},
      )
      return nil
    },
  )
  harness.stdio.println(merge_captain({pr: "burin-labs/harn#1075"}))
}
