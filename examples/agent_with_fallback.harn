// Demo: std/llm/handlers — with_fallback wrapped into agent_loop.
//
// Primary caller fails with auth error; secondary caller succeeds. The
// fallback envelope's text becomes agent_loop's visible_text. Both callers
// are synthetic so the example runs in CI without credentials.
//
// Run with: cargo run --quiet --bin harn -- run examples/agent_with_fallback.harn
import { agent_loop } from "std/agent/loop"
import { with_fallback } from "std/llm/handlers"

pipeline default(harness: Harness) {
  const primary = { _call ->
    harness.stdio.println("[primary]   -> auth failure")
    return {ok: false, status: "auth", error: "no creds"}
  }
  const secondary = { _call ->
    harness.stdio.println("[secondary] -> success")
    return {
      ok: true,
      value: {
        text: "answer-from-secondary",
        model: "mock",
        provider: "mock",
        input_tokens: 0,
        output_tokens: 0,
        usage: {input_tokens: 0, output_tokens: 0},
      },
    }
  }
  const caller = with_fallback(harness.agent, [primary, secondary])
  const result = agent_loop(harness, "hi", nil, {provider: "mock", llm_caller: caller})
  harness.stdio.println("status      = " + result.status)
  harness.stdio.println("visible     = " + result.visible_text)
}
