import "std/triggers"
import { triage_issue_payload } from "lib"

fn local_triage(harness: Harness, event: TriggerEvent) -> dict {
  const raw = event.provider_payload.raw ?? {}
  const context = harness.runtime.handler_context()
  return triage_issue_payload(raw, context?.trace_id ?? event.trace_id, context?.replay_of_event_id)
}

fn register_local(harness: Harness) {
  return harness.runtime.trigger_register(
    {
      id: "issue-triage-local-demo",
      kind: "webhook",
      provider: "github",
      match: {events: ["issues.opened"]},
      handler: local_triage,
      retry: {max: 1, backoff: "immediate"},
    },
  )
}

fn register_remote(harness: Harness, port) {
  return harness.runtime.trigger_register(
    {
      id: "issue-triage-a2a-demo",
      kind: "webhook",
      provider: "github",
      match: {events: ["issues.opened"]},
      handler: "a2a://127.0.0.1:" + port + "/triage",
      allow_cleartext: true,
      retry: {max: 1, backoff: "immediate"},
    },
  )
}

fn fire(harness: Harness, handle, suffix) {
  return harness.runtime.trigger_fire(
    handle,
    {
      id: "evt-demo-" + suffix,
      provider: "github",
      kind: "issues.opened",
      trace_id: "trace-demo-" + suffix,
      dedupe_key: "demo:" + suffix,
      issue: {title: "Trust boundary dispatch demo"},
    },
  )
}

pipeline default(harness: Harness) {
  const port = harness.env.get_or("HARN_DEMO_REMOTE_PORT", "8787")
  const local = fire(harness, register_local(harness), "local")
  const remote = fire(harness, register_remote(harness, port), "a2a")
  harness.stdio.println(
    json_stringify(
      {
        local_status: local.status,
        remote_status: remote.status,
        same_logical_output: local.result.status == remote.result.status
          && local.result.title
          == remote
          .result.title
          && local.result.labels[0] == remote.result.labels[0],
        local_result: local.result,
        remote_result: remote.result,
      },
    ),
  )
}
