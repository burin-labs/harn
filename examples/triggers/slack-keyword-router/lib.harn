import "std/triggers"

/** Route a Slack message based on simple keyword classes. */
pub fn route_message(event: TriggerEvent) -> dict {
  const raw = event.provider_payload.raw
  const text = lowercase(raw.text ?? raw.event?.text ?? "")
  const route = if contains(text, "urgent") {
    "priority"
  } else if contains(text, "help") {
    "support"
  } else {
    "ambient"
  }
  return {route: route, channel: raw.channel ?? raw.event?.channel, text: text}
}
