import { connector_http_json } from "std/connectors/shared"
import "std/eval/stats"
import "std/triggers"

const DEFAULT_NAMESPACE = "eval-suite-regression-notifier"

const DEFAULT_SUITE = "eval-suite-regression"

const DEFAULT_MODEL = "mock-model"

const DEFAULT_SLACK_CHANNEL = "C0123456789"

const DEFAULT_SLACK_API_BASE_URL = "https://slack.com/api"

/**
 * Run the scheduled eval, gate it against the prior ledger commit, and notify only on a gate flip.
 */
pub fn notify_on_eval_gate_flip(event: TriggerEvent) -> dict {
  const outcome = eval_gate_verdict(event)
  if !(outcome.notify ?? false) {
    return outcome
  }
  const config = outcome.config
  const posted = post_eval_verdict(outcome.verdict, slack_options(config))
  if is_err(posted) {
    return outcome + {notified: false, notify_error: unwrap_err(posted)}
  }
  return outcome + {notified: true, slack: posted}
}

/** Run the eval pack and build the structured verdict without posting to Slack. */
pub fn eval_gate_verdict(event: TriggerEvent) -> dict {
  const config = notifier_config(event)
  const manifest = load_eval_manifest()
  const options = ledger_options(config)
  const report = eval_pack_run(manifest, options)
  const current_rows = rows_for_split(report.stats_rows, config.split)
  const prior = eval_ledger_prior_commit_rows(options)
  if len(prior.rows) == 0 {
    return {
      notified: false,
      notify: false,
      reason: "no_prior_baseline",
      config: config,
      report: report,
      prior: prior,
      current_rows: current_rows,
    }
  }
  const gate = regression_gate(prior.rows, current_rows, config.k)
  const paired = paired_delta_report(prior.rows, current_rows, config.resamples, config.seed)
  const decision = verdict_decision(gate, paired)
  const verdict = {
    suite: config.suite,
    model: config.model,
    split: config.split ?? "all",
    decision: decision,
    macro_pass_at_1: gate.current_macro,
    baseline_macro_pass_at_1: gate.baseline_macro,
    gate: gate,
    paired_delta: paired,
    reliability: reliability_breakdown(current_rows),
    top_regressed_cases: top_regressed_cases(prior.rows, current_rows),
    ledger_url: config.ledger_url,
    dashboard_url: config.dashboard_url,
  }
  const notify = should_notify(decision, config)
  return {
    notified: false,
    notify: notify,
    decision: decision,
    config: config,
    verdict: verdict,
    report: report,
    prior: prior,
    current_rows: current_rows,
  }
}

fn load_eval_manifest() -> dict {
  const path = path_join(source_dir(), "harn.eval.toml")
  return eval_pack_manifest(toml_parse(harness.fs.read_text(path)) + {base_dir: source_dir()})
}

fn notifier_config(event) -> dict {
  const payload = event?.provider_payload ?? {}
  const raw = payload?.config ?? payload?.raw?.config ?? payload
  return compact(
    {
      namespace: raw?.namespace ?? DEFAULT_NAMESPACE,
      suite: raw?.suite ?? DEFAULT_SUITE,
      model: raw?.model ?? DEFAULT_MODEL,
      split: raw?.split,
      commit: raw?.commit ?? "example-commit",
      branch: raw?.branch ?? "main",
      k: raw?.k ?? 1.0,
      resamples: raw?.resamples ?? 2000,
      seed: raw?.seed ?? 1234567,
      slack_channel: raw?.slack_channel ?? raw?.channel ?? DEFAULT_SLACK_CHANNEL,
      bot_token: raw?.bot_token,
      bot_token_secret: raw?.bot_token_secret ?? "slack/bot-token",
      thread_ts: raw?.thread_ts,
      api_base_url: raw?.api_base_url,
      ledger_url: raw?.ledger_url,
      dashboard_url: raw?.dashboard_url,
      notify_inconclusive: raw?.notify_inconclusive ?? false,
    },
  )
}

fn ledger_options(config) -> dict {
  return compact(
    {
      namespace: config.namespace,
      suite: config.suite,
      model: config.model,
      split: config.split,
      commit: config.commit,
      branch: config.branch,
    },
  )
}

fn slack_options(config) -> dict {
  return compact(
    {
      channel: config.slack_channel,
      bot_token: config.bot_token,
      bot_token_secret: config.bot_token_secret,
      thread_ts: config.thread_ts,
      api_base_url: config.api_base_url,
    },
  )
}

fn post_eval_verdict(verdict, options) {
  const opts = options ?? {}
  const token = trim(to_string(opts?.bot_token ?? ""))
  if token == "" {
    return Err(
      "Slack bot_token is required; resolve "
        + to_string(opts?.bot_token_secret ?? "slack/bot-token")
        + " before invoking the handler",
    )
  }
  const api_base_url = trim(to_string(opts?.api_base_url ?? DEFAULT_SLACK_API_BASE_URL))
  const response = connector_http_json(
    "POST",
    api_base_url + "/chat.postMessage",
    {
      headers: {
        Authorization: "Bearer " + token,
        Accept: "application/json",
        "Content-Type": "application/json; charset=utf-8",
      },
      body: json_stringify(slack_verdict_payload(verdict, opts)),
      provider: "slack",
      operation: "chat.postMessage",
      redact_error_body: true,
    },
  )
  if !(response?.ok ?? false) {
    return Err(
      "Slack chat.postMessage failed: "
        + to_string(
        response?.error?.message ?? response?.error?.category ?? response?.status ?? "unknown",
      ),
    )
  }
  const body = response?.json ?? {}
  if body?.ok == false {
    return Err("Slack chat.postMessage rejected: " + to_string(body?.error ?? "unknown"))
  }
  return body + {status: response.status}
}

fn slack_verdict_payload(verdict, options) -> dict {
  const title = slack_verdict_title(verdict)
  const summary = slack_verdict_summary(verdict)
  return compact(
    {
      channel: options?.channel,
      thread_ts: options?.thread_ts,
      text: title + " - " + summary,
      blocks: [
        {type: "section", text: {type: "mrkdwn", text: "*" + title + "*"}},
        {type: "section", fields: slack_verdict_fields(verdict)},
        {type: "section", text: {type: "mrkdwn", text: slack_regressed_cases_text(verdict)}},
      ],
    },
  )
}

fn slack_verdict_title(verdict) -> string {
  if verdict?.decision == "regression" {
    return "Eval regression detected"
  }
  if verdict?.decision == "improved" {
    return "Eval improvement detected"
  }
  return "Eval result inconclusive"
}

fn slack_verdict_summary(verdict) -> string {
  return to_string(verdict?.suite ?? "eval suite") + " / " + to_string(verdict?.model ?? "model")
    + " / "
    + to_string(verdict?.split ?? "all")
}

fn slack_verdict_fields(verdict) -> list {
  return [
    {type: "mrkdwn", text: "*Suite*\n" + to_string(verdict?.suite ?? "unknown")},
    {type: "mrkdwn", text: "*Model*\n" + to_string(verdict?.model ?? "unknown")},
    {type: "mrkdwn", text: "*Split*\n" + to_string(verdict?.split ?? "all")},
    {type: "mrkdwn", text: "*Current macro pass@1*\n" + slack_rate(verdict?.macro_pass_at_1)},
    {
      type: "mrkdwn",
      text: "*Baseline macro pass@1*\n" + slack_rate(verdict?.baseline_macro_pass_at_1),
    },
    {
      type: "mrkdwn",
      text: "*Paired delta*\n" + to_string(verdict?.paired_delta?.status ?? "unknown"),
    },
  ]
}

fn slack_regressed_cases_text(verdict) -> string {
  const cases = verdict?.top_regressed_cases ?? []
  if len(cases) == 0 {
    return "*Top regressed cases*\nNone"
  }
  let lines = []
  let count = 0
  for item in cases {
    if count < 5 {
      lines = lines
        + [
        "- " + to_string(item?.name ?? "unknown") + " (" + slack_signed_rate_delta(item?.delta)
          + " pp)",
      ]
      count = count + 1
    }
  }
  return "*Top regressed cases*\n" + join(lines, "\n")
}

fn slack_rate(value) -> string {
  if value == nil {
    return "unknown"
  }
  return to_string(round((to_float(value) ?? 0.0) * 1000.0) / 10.0) + "%"
}

fn slack_signed_rate_delta(value) -> string {
  const delta = (to_float(value) ?? 0.0) * 100.0
  const prefix = if delta > 0.0 {
    "+"
  } else {
    ""
  }
  return prefix + to_string(round(delta * 10.0) / 10.0)
}

fn rows_for_split(rows, split) -> list {
  if split == nil {
    return rows
  }
  let filtered = []
  for row in rows ?? [] {
    if row?.split == split {
      filtered = filtered + [row]
    }
  }
  return filtered
}

fn verdict_decision(gate, paired) -> string {
  if !(gate?.passed ?? true) {
    return "regression"
  }
  if paired?.status == "improved" {
    return "improved"
  }
  return "inconclusive"
}

fn should_notify(decision, config) -> bool {
  const notify_inconclusive = config.notify_inconclusive ?? false
  return decision == "regression" || decision == "improved"
    || (decision == "inconclusive"
    && notify_inconclusive)
}

fn top_regressed_cases(baseline_rows, current_rows) -> list {
  let baseline = {}
  for row in baseline_rows ?? [] {
    baseline[row.case_name ?? row.name] = row
  }
  let cases = []
  for row in current_rows ?? [] {
    const name = row.case_name ?? row.name
    const base = baseline[name]
    if base != nil && fingerprints_match(base, row) {
      const delta = row_pass_rate(row) - row_pass_rate(base)
      if delta < 0.0 {
        cases = insert_regressed_case(
          cases,
          {
            name: name,
            fingerprint: row.case_fingerprint,
            delta: delta,
            baseline_pass_rate: row_pass_rate(base),
            current_pass_rate: row_pass_rate(row),
          },
        )
      }
    }
  }
  return cases
}

fn insert_regressed_case(cases, candidate) -> list {
  let out = []
  let inserted = false
  for item in cases {
    if !inserted && candidate.delta < item.delta {
      out = out + [candidate]
      inserted = true
    }
    out = out + [item]
  }
  if !inserted {
    out = out + [candidate]
  }
  return out
}

fn fingerprints_match(left, right) -> bool {
  const left_harness = left?.harness_config_fingerprint ?? ""
  const right_harness = right?.harness_config_fingerprint ?? ""
  return left?.case_fingerprint == right?.case_fingerprint
    && left_harness == right_harness
}

fn row_pass_rate(row) -> float {
  if row?.pass_rate != nil {
    return row.pass_rate
  }
  const passes = row?.passes ?? 0
  const fails = row?.fails ?? 0
  const decided = passes + fails
  if decided <= 0 {
    return 0.0
  }
  return passes * 1.0 / (decided * 1.0)
}

fn compact(input) -> dict {
  let out = {}
  for entry in (input ?? {}).entries() {
    if entry.value != nil {
      out[entry.key] = entry.value
    }
  }
  return out
}
