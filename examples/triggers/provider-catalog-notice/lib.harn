import "std/triggers"

/**
 * Invoke the transport-neutral workflow after an external adapter writes one
 * ProviderNotice JSON file. The configured repository must be a dedicated,
 * clean worktree; the workflow itself retains the fail-closed validation.
 */
pub fn run_provider_catalog_notice(harness: Harness, _event: TriggerEvent) -> dict {
  const root = harness.env.get_or("HARN_PROVIDER_NOTICE_WORKTREE", "")
  const notice = harness.env.get_or("HARN_PROVIDER_NOTICE_FILE", "")
  if root == "" || notice == "" {
    return {
      status: "skipped",
      reason: "set HARN_PROVIDER_NOTICE_WORKTREE and HARN_PROVIDER_NOTICE_FILE",
    }
  }
  let args = [
    "run",
    path_join(root, "scripts/provider_catalog_notice.harn"),
    "--",
    "--notice",
    notice,
    "--repo-root",
    root,
    "--apply",
    "--open-pr",
  ]
  const extraction = harness.env.get_or("HARN_PROVIDER_NOTICE_EXTRACTION_FILE", "")
  if extraction != "" {
    args = args + ["--extraction", extraction]
  } else {
    const provider = harness.env.get_or("HARN_PROVIDER_NOTICE_EXTRACTION_PROVIDER", "")
    const model = harness.env.get_or("HARN_PROVIDER_NOTICE_EXTRACTION_MODEL", "")
    if provider != "" {
      args = args + ["--provider", provider]
    }
    if model != "" {
      args = args + ["--model", model]
    }
  }
  const tool_report = harness.env.get_or("HARN_PROVIDER_NOTICE_TOOL_PROBE_REPORT", "")
  if tool_report != "" {
    args = args + ["--tool-probe-report", tool_report]
  }
  const result = harness.process.run({program: "harn", args: args, cwd: root})
  return {
    status: if result.exit_code == 0 {
      "completed"
    } else {
      "failed"
    },
    exit_code: result.exit_code,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}
