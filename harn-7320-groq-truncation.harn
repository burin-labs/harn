pipeline default(harness: Harness, task: unknown) {
  const result = harness.llm.call_safe(
    "Write the alphabet with one letter per word.",
    "Follow the user request.",
    {
      provider: "groq",
      model: "groq/openai/gpt-oss-20b",
      stream: true,
      max_tokens: 1,
      temperature: 0.0,
      retries: 0,
      timeout_ms: 30000,
    },
  )
  harness.stdio.println(json_stringify(result))
}
