#!/bin/sh
# Strip agent-session URL trailers from the commit message.
#
# This repository is public, so a trailer naming a private session URL is an
# exposure the moment it is pushed. Several assistants append one automatically
# and there is no per-assistant setting to rely on: the trailer shows up under
# a different key depending on the tool, and any of them can add a new key
# tomorrow. Matching the SHAPE — a single trailer word ending in `Session`
# whose value is a URL — is what keeps this from being a list of tool names
# that goes stale.
#
# A global `core.hooksPath` cannot do this job. `make setup` points this
# repository's `core.hooksPath` at `.githooks`, and the repository-local
# setting wins, so a clone that has been set up runs only the hooks in here.
# That is why the guard lives in the repository rather than in one machine's
# global configuration.
#
# Rewriting rather than refusing is deliberate. The trailer is appended by a
# tool, not typed by a person, so refusing the commit would ask an author to
# fix something they did not write and cannot stop writing. Stripping is
# lossless for everything a reviewer reads.
set -e

message_file=$1
[ -n "$message_file" ] || exit 0
[ -f "$message_file" ] || exit 0

# `<Word>Session: <scheme>://…` and `<Word>-Session: <scheme>://…` at the start
# of a line. The trailing URL is required: it is what makes the line an
# exposure, and it keeps prose that happens to end in "Session" out of scope.
session_trailer='^[A-Za-z][A-Za-z-]*Session:[[:space:]]*[A-Za-z][A-Za-z0-9+.-]*://'

if ! grep -Eq "$session_trailer" "$message_file"; then
  exit 0
fi

stripped="$message_file.session-trailer.$$"
# Drop the trailers, then drop trailing blank lines the removal can leave
# behind, so a message whose last line was the trailer does not end in a run of
# empty lines.
grep -Ev "$session_trailer" "$message_file" |
  awk '{ lines[NR] = $0 } END { last = 0; for (i = 1; i <= NR; i++) if (lines[i] ~ /[^[:space:]]/) last = i; for (i = 1; i <= last; i++) print lines[i] }' \
    > "$stripped"

mv "$stripped" "$message_file"

echo "commit-msg: removed a session URL trailer; this repository is public." >&2
exit 0
