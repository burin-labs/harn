{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/run-authority-plan.v1.json",
  "title": "RunAuthorityPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent_id",
    "capability_policy",
    "requirements",
    "budget",
    "provenance",
    "interactivity",
    "startup_deadline_at_ms",
    "receipt_uri"
  ],
  "properties": {
    "schema": {
      "const": "harn.run_authority_plan.v1"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_policy": {
      "$ref": "#/$defs/capabilityPolicy"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "interactivity": {
      "enum": ["interactive", "non_interactive"]
    },
    "startup_deadline_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "receipt_uri": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "capabilities",
        "workspace_roots",
        "read_only_roots",
        "recursion_limit",
        "tool_arg_constraints",
        "tool_annotations",
        "sandbox_profile",
        "process_sandbox"
      ],
      "properties": {
        "tools": {
          "$ref": "#/$defs/stringArray"
        },
        "tools_restricted": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringArray"
          }
        },
        "capabilities_restricted": {
          "type": "boolean"
        },
        "workspace_roots": {
          "$ref": "#/$defs/stringArray"
        },
        "read_only_roots": {
          "$ref": "#/$defs/stringArray"
        },
        "side_effect_level": {
          "type": ["string", "null"]
        },
        "recursion_limit": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "tool_arg_constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tool_annotations": {
          "type": "object"
        },
        "sandbox_profile": {
          "enum": [
            "unrestricted",
            "workspace_paths",
            "worktree",
            "wasi",
            "os_hardened"
          ]
        },
        "process_sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["presets", "read_roots", "write_roots", "read_deny_roots"],
          "properties": {
            "presets": {
              "type": ["array", "null"],
              "items": {
                "enum": [
                  "system_runtime",
                  "developer_toolchains",
                  "package_manager_config",
                  "user_temp"
                ]
              },
              "uniqueItems": true
            },
            "read_roots": {
              "$ref": "#/$defs/stringArray"
            },
            "write_roots": {
              "$ref": "#/$defs/stringArray"
            },
            "read_deny_roots": {
              "$ref": "#/$defs/stringArray"
            },
            "allow_tcp_loopback": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spend_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harn_version",
        "harn_revision",
        "host_name",
        "host_version",
        "host_revision",
        "contracts_version",
        "runtime_digest"
      ],
      "properties": {
        "harn_version": {
          "type": "string",
          "minLength": 1
        },
        "harn_revision": {
          "type": "string",
          "minLength": 1
        },
        "host_name": {
          "type": "string",
          "minLength": 1
        },
        "host_version": {
          "type": "string",
          "minLength": 1
        },
        "host_revision": {
          "type": "string",
          "minLength": 1
        },
        "contracts_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["provider", "process", "mcp", "connector"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "environment_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root"],
          "properties": {
            "kind": {
              "enum": [
                "filesystem_read",
                "filesystem_write",
                "process_read_root",
                "process_write_root"
              ]
            },
            "root": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "probe_id",
            "executable",
            "arguments",
            "working_directory",
            "read_root_ceiling"
          ],
          "properties": {
            "kind": {
              "const": "toolchain_probe"
            },
            "probe_id": {
              "type": "string",
              "minLength": 1
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "working_directory": {
              "type": "string",
              "minLength": 1
            },
            "read_root_ceiling": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "broker_id",
            "source",
            "renewal",
            "binding"
          ],
          "properties": {
            "kind": {
              "const": "identity_broker"
            },
            "reference": {
              "type": "string",
              "pattern": "^harn-identity://[^/]+/[^/]+$"
            },
            "broker_id": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "sdk_profile",
                "workload_identity",
                "instance_metadata",
                "hosted_broker"
              ]
            },
            "renewal": {
              "enum": ["none", "broker_managed"]
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "audience", "consumer"],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "audience": {
                  "type": "string",
                  "minLength": 1
                },
                "tenant": {
                  "type": "string",
                  "minLength": 1
                },
                "consumer": {
                  "$ref": "#/$defs/consumer"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "profile", "preset"],
          "properties": {
            "kind": {
              "const": "process_sandbox"
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "destination", "protocol", "port"],
          "properties": {
            "kind": {
              "const": "network"
            },
            "destination": {
              "type": "string",
              "minLength": 1
            },
            "protocol": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "source", "consumer"],
          "properties": {
            "kind": {
              "const": "secret"
            },
            "reference": {
              "type": "string",
              "pattern": "^harn-secret://[^/]+/[^@]+(?:@[0-9]+)?$"
            },
            "source": {
              "enum": ["process_local", "durable_broker"]
            },
            "consumer": {
              "$ref": "#/$defs/consumer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "socket_kind"],
          "properties": {
            "kind": {
              "const": "process_socket"
            },
            "socket_kind": {
              "enum": ["unix", "tcp_loopback", "docker", "ssh_agent"]
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "const": "environment"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "tool"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "capability", "operation"],
          "properties": {
            "kind": {
              "const": "host_capability"
            },
            "capability": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "level"],
          "properties": {
            "kind": {
              "const": "side_effect_ceiling"
            },
            "level": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "depth"],
          "properties": {
            "kind": {
              "const": "recursion_limit"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "server", "tool", "side_effect"],
          "properties": {
            "kind": {
              "const": "mcp"
            },
            "server": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "side_effect": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "budget"],
          "properties": {
            "kind": {
              "const": "budget"
            },
            "budget": {
              "$ref": "#/$defs/budget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provenance"],
          "properties": {
            "kind": {
              "const": "provenance"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "deadline_at_ms", "receipt_uri"],
          "properties": {
            "kind": {
              "const": "startup"
            },
            "deadline_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "receipt_uri": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
