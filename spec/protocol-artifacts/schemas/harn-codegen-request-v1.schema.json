            },
            "kind": {
              "const": "tuple",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "map",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WireTypeId"
            }
          },
          "required": [
            "kind",
            "value"
          ],
