{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "User-confirmed facts for one credential. Unknown is distinct from false.",
  "properties": {
    "billing_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "contributor_sharing_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "credential_fingerprint": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "credential_fingerprint"
  ],
  "title": "ProviderAccountAttestation",
  "type": "object"
}
