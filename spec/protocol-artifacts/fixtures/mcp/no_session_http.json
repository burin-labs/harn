{
  "name": "harn.mcp.no_session_http",
  "description": "Stable tools/list posted to an HTTP MCP server without an Mcp-Session-Id. The server must accept the request and the response must not echo a session id back.",
  "kind": "http_header_exchange",
  "documents": [
    {
      "MCP-Protocol-Version": "2026-07-28",
      "Mcp-Method": "tools/list",
      "Mcp-Name": ""
    },
    {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tools/list",
      "params": {
        "_meta": {
          "io.modelcontextprotocol/protocolVersion": "2026-07-28",
          "io.modelcontextprotocol/clientInfo": {"name": "harn-mcp-compat-client", "version": "0.1.0"},
          "io.modelcontextprotocol/clientCapabilities": {}
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 7,
      "result": {
        "resultType": "complete",
        "ttlMs": 5000,
        "cacheScope": "private",
        "tools": []
      }
    }
  ]
}
