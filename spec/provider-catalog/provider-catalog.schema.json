        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "icon": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "latency_p50_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "protocols": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rpm": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "display_name",
        "classification",
        "endpoint",
        "auth",
        "protocols",
        "features",
        "caveats"
      ],
      "type": "object"
    },
    "reasoning": {
      "additionalProperties": false,
      "properties": {
        "effort_supported": {
          "type": "boolean"
        },
        "interleaved_supported": {
          "type": "boolean"
        },
        "modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "none_supported": {
          "type": "boolean"
        },
        "preserve_thinking": {
          "type": "boolean"
        }
      },
      "required": [
        "modes",
        "effort_supported",
        "none_supported",
        "interleaved_supported",
        "preserve_thinking"
      ],
      "type": "object"
    },
    "tool_empirical_parity": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "string"
        },
        "last_evaluated": {
          "minLength": 1,
          "type": "string"
        },
        "native_pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "preferred_format": {
          "type": "string"
        },
        "sample_size": {
          "minimum": 1,
          "type": "integer"
        },
        "text_pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "verdict": {
          "type": "string"
        },
        "verifier_divergence_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "verdict",
        "preferred_format",
        "confidence",
        "sample_size",
        "last_evaluated",
        "native_pass_rate",
        "text_pass_rate",
        "verifier_divergence_rate"
      ],
      "type": "object"
    },
    "tool_support": {
      "additionalProperties": false,
      "properties": {
        "empirical_parity": {
          "$ref": "#/$defs/tool_empirical_parity"
