{
  "$defs": {
    "alias": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "tool_calling": {
          "additionalProperties": false,
          "properties": {
            "failure_reason": {
              "type": "string"
            },
            "fallback_mode": {
              "type": "string"
            },
            "last_probe_at": {
              "type": "string"
            },
            "native": {
              "type": "string"
            },
            "streaming_native": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "tool_format": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_id",
        "provider"
      ],
      "type": "object"
    },
    "auth": {
      "additionalProperties": false,
      "properties": {
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "header": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "style": {
          "type": "string"
        }
      },
      "required": [
        "style",
        "env",
        "required"
      ],
      "type": "object"
    },
    "deprecation": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "deprecated"
          ]
        },
        "superseded_by": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "endpoint": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string"
        },
        "base_url_env": {
          "type": "string"
        },
        "chat_endpoint": {
          "minLength": 1,
          "type": "string"
        },
        "completion_endpoint": {
          "type": "string"
        }
      },
      "required": [
        "base_url",
        "chat_endpoint"
      ],
      "type": "object"
    },
    "fast_mode": {
      "additionalProperties": false,
      "properties": {
        "beta_header": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "otps_speedup": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "param": {
          "minLength": 1,
          "type": "string"
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "status": {
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "param",
        "value"
      ],
      "type": "object"
    },
    "format_preferences": {
      "additionalProperties": false,
      "properties": {
        "prefers_markdown_scaffolding": {
          "type": "boolean"
        },
        "prefers_role_developer": {
          "type": "boolean"
        },
        "prefers_xml_scaffolding": {
          "type": "boolean"
        },
        "prefers_xml_tools": {
          "type": "boolean"
        },
        "structured_output_mode": {
          "enum": [
            "native_json",
            "delimited",
            "xml_tagged",
            "none"
          ]
        },
        "supports_assistant_prefill": {
          "type": "boolean"
        },
        "thinking_block_style": {
          "enum": [
            "none",
            "thinking_blocks",
            "reasoning_summary",
            "inline"
          ]
        }
      },
      "required": [
        "prefers_xml_scaffolding",
        "prefers_markdown_scaffolding",
        "structured_output_mode",
        "supports_assistant_prefill",
        "prefers_role_developer",
        "prefers_xml_tools",
        "thinking_block_style"
      ],
      "type": "object"
    },
    "modalities": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "output": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "availability": {
          "enum": [
            "serverless",
            "dedicated",
            "unknown"
          ]
        },
        "benchmarks": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "capability_tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context_window": {
          "minimum": 1,
          "type": "integer"
        },
        "deprecation": {
          "$ref": "#/$defs/deprecation"
        },
        "fast_mode": {
          "$ref": "#/$defs/fast_mode"
        },
        "format_preferences": {
          "$ref": "#/$defs/format_preferences"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "modalities": {
          "$ref": "#/$defs/modalities"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "open_weight": {
          "type": "boolean"
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "prompt_cache": {
          "type": "boolean"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "quality_tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "runtime_context_window": {
          "minimum": 1,
          "type": "integer"
        },
        "stream_timeout": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "structured_output": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "small",
            "mid",
            "frontier",
            "reasoning"
          ]
        },
        "tool_support": {
          "$ref": "#/$defs/tool_support"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "aliases",
        "context_window",
        "modalities",
        "tool_support",
        "structured_output",
        "format_preferences",
        "reasoning",
        "prompt_cache",
        "deprecation",
        "availability",
        "quality_tags",
        "capability_tags",
        "tier"
      ],
      "type": "object"
    },
    "pricing": {
      "additionalProperties": false,
      "properties": {
        "cache_read_per_mtok": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cache_write_per_mtok": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "input_per_mtok": {
          "minimum": 0,
          "type": "number"
        },
        "output_per_mtok": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "input_per_mtok",
        "output_per_mtok"
      ],
      "type": "object"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "caveats": {
          "items": {
            "type": "string"
