  "$id": "https://harnlang.com/schemas/provider-catalog.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "items": {
        "$ref": "#/$defs/alias"
      },
      "type": "array"
    },
    "generated_by": {
      "type": "string"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/model"
      },
      "type": "array"
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/provider"
      },
      "type": "array"
    },
    "qc_defaults": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "schema": {
      "const": "https://harnlang.com/schemas/provider-catalog.v2.json"
    },
    "schema_version": {
      "const": 2
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/variant"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "schema",
    "generated_by",
    "providers",
    "models",
    "aliases",
    "variants",
    "qc_defaults"
  ],
  "title": "Harn provider catalog",
  "type": "object"
}
