        "max_tools": {
          "minimum": 1,
          "type": "integer"
        },
        "native": {
          "type": "boolean"
        },
        "parity": {
          "type": "string"
        },
        "parity_notes": {
          "type": "string"
        },
        "preferred_format": {
          "type": "string"
        },
        "text": {
          "type": "boolean"
        },
        "tool_search": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "native",
        "text",
        "tool_search"
      ],
      "type": "object"
    },
    "variant": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "model_id",
        "provider",
        "source"
      ],
      "type": "object"
    }
