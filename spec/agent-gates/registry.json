  "scopes": [
    {
      "id": "retry-destructured-options",
      "kind": "option",
      "glob": "crates/harn-stdlib/src/stdlib/llm/resilience.harn",
      "language": "harn",
      "query": "((fn_declaration name: (identifier) @owner (block (const_binding name: (dict_pattern (dict_pattern_field . (identifier) @key))))) (#eq? @owner \"with_retry\"))",
      "prefix": "AgentLoopRetryOptions.",
      "key_form": "field"
    },
    {
      "id": "native-runner-option-helpers",
      "kind": "option",
      "glob": "crates/harn-vm/src/llm/**/*.rs",
      "language": "rust",
      "query": "((call_expression function: (_) @callee arguments: (arguments . (_) . (_) @key)) (#match? @callee \"(^|::)(opt_str|opt_int|opt_float|opt_bool|opt_json|opt_str_list|agent_primitive_option_str|agent_primitive_option_int|agent_primitive_option_bool)$\"))",
      "prefix": "AgentSpec.",
      "key_form": "literal"
    },
    {
      "id": "native-daemon-options",
      "kind": "option",
      "glob": "crates/harn-vm/src/llm/daemon.rs",
      "language": "rust",
      "query": "((call_expression function: (field_expression value: (identifier) @receiver field: (field_identifier) @method) arguments: (arguments . (_) @key)) (#eq? @receiver \"options\") (#eq? @method \"get\"))",
      "prefix": "AgentSpec.",
      "key_form": "literal"
    },
    {
      "id": "native-reminder-options",
      "kind": "option",
      "glob": "crates/harn-vm/src/llm/reminder_providers.rs",
      "language": "rust",
      "query": "((call_expression function: (field_expression value: (identifier) @receiver field: (field_identifier) @method) arguments: (arguments . (_) @key)) (#eq? @receiver \"options\") (#eq? @method \"get\"))",
      "prefix": "AgentSpec.",
      "key_form": "literal"
    },
    {
      "id": "native-reminder-policy",
      "kind": "option",
      "glob": "crates/harn-vm/src/llm/reminder_providers.rs",
      "language": "rust",
      "query": "((call_expression function: (field_expression value: (identifier) @receiver field: (field_identifier) @method) arguments: (arguments . (_) @key)) (#eq? @receiver \"reminders\") (#eq? @method \"get\"))",
      "prefix": "AgentSpec.reminders.",
      "key_form": "literal"
    },
    {
      "id": "missing-tool-recovery-key-domain",
      "kind": "option",
      "glob": "crates/harn-stdlib/src/stdlib/llm/missing_tool_call.harn",
      "language": "harn",
      "query": "((for_statement variable: (identifier) @variable iterable: (list_literal (string_literal) @key)) (#eq? @variable \"key\"))",
      "prefix": "MissingToolCallRecoveryOptions.",
      "key_form": "literal"
    },
    {
      "id": "judge-override-key-domain",
      "kind": "option",
      "glob": "crates/harn-stdlib/src/stdlib/agent/judge_internals.harn",
      "language": "harn",
      "query": "((const_binding name: (identifier) @domain value: (list_literal (string_literal) @key)) (#eq? @domain \"__JUDGE_LLM_OVERRIDE_KEYS\"))",
      "prefix": "JudgeConfig.",
      "key_form": "literal"
    },
    {
      "id": "judge-model-key-domain",
      "kind": "option",
      "glob": "crates/harn-stdlib/src/stdlib/agent/judge_internals.harn",
      "language": "harn",
      "query": "((const_binding name: (identifier) @domain value: (string_literal) @key) (#eq? @domain \"__JUDGE_MODEL_SETTING\"))",
      "prefix": "JudgeConfig.",
      "key_form": "literal"
    },
    {
      "id": "runner-model-environment",
      "kind": "environment",
      "glob": "crates/harn-vm/src/llm/**/*.rs",
      "language": "rust",
      "query": "((call_expression function: (_) @callee arguments: (arguments . (_) @key)) (#match? @callee \"(^|::)(var|var_os|env_var_seamed|env_var_os_seamed|non_empty_env|env_bool|env_usize|env_u64|env_flag_enabled)$\"))",
      "prefix": "",
      "key_form": "literal"
    },
    {
      "id": "runner-native-environment",
      "kind": "environment",
      "glob": "crates/harn-vm/src/orchestration/**/*.rs",
      "language": "rust",
      "query": "((call_expression function: (_) @callee arguments: (arguments . (_) @key)) (#match? @callee \"(^|::)(var|var_os|env_var_seamed|env_var_os_seamed|non_empty_env|env_bool|env_usize|env_u64)$\"))",
      "prefix": "",
      "key_form": "literal"
    },
    {
      "id": "runner-stdlib-environment",
      "kind": "environment",
      "glob": "crates/harn-stdlib/src/stdlib/agent/**/*.harn",
      "language": "harn",
      "query": "((call_expression function: (property_access object: (_) @receiver property: (identifier) @method) (argument_list . (_) @key)) (#match? @receiver \"^(harness\\.env|env)$\") (#match? @method \"^(get|get_or|require)$\"))",
      "prefix": "",
      "key_form": "literal"
    },
    {
      "id": "native-stage-environment",
      "kind": "environment",
      "glob": "crates/harn-vm/src/orchestration/stage_options.rs",
      "language": "rust",
      "query": "[((call_expression function: (identifier) @callee arguments: (arguments . (_) @key)) (#eq? @callee \"non_empty_env\")) ((token_tree (identifier) @callee . (token_tree . (string_literal) @key)) (#eq? @callee \"non_empty_env\"))]",
      "prefix": "",
      "key_form": "literal"
    },
    {
      "id": "cli-runner-environment",
      "kind": "environment",
      "glob": "crates/harn-stdlib/src/stdlib/cli/try.harn",
      "language": "harn",
      "query": "[((call_expression function: (property_access object: (_) @receiver property: (identifier) @method) (argument_list . (_) @key)) (#match? @receiver \"^(harness\\.env|env)$\") (#match? @method \"^(get|get_or|require)$\")) ((call_expression function: (identifier) @callee (argument_list . (_) . (_) @key)) (#eq? @callee \"__trimmed_env\"))]",
      "prefix": "",
      "key_form": "literal"
    },
    {
      "id": "runner-environment-constants",
      "kind": "environment",
      "glob": "crates/harn-vm/src/llm/**/*.rs",
      "language": "rust",
      "query": "((const_item name: (identifier) @constant value: (string_literal) @key) (#match? @constant \"(_ENV|_ENV_VAR)$\"))",
      "prefix": "",
      "key_form": "literal"
    }
  ],
