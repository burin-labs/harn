{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/artifact-manifest.v1.schema.json",
  "title": "Harn artifact manifest v1",
  "description": "Portable file-artifact manifest for Harn sessions, managed-agent receipts, and document/media outputs.",
  "type": "object",
  "required": ["schema_version", "kind", "artifact_count", "artifacts"],
  "properties": {
    "schema_version": { "const": "harn.artifacts.v1" },
    "kind": { "const": "artifact_manifest" },
    "title": { "type": "string" },
    "artifact_count": { "type": "integer", "minimum": 0 },
    "total_size_bytes": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_artifact_spec" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file_artifact_spec": {
      "type": "object",
      "description": "Reference to an artifact payload stored outside the manifest body.",
      "required": ["uri", "name", "mime_type"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(file://|artifact://|harn-artifact://|urn:)"
        },
        "name": { "type": "string", "minLength": 1 },
        "mime_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "path": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
        },
        "description": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "not": {
        "anyOf": [
          { "required": ["base64"] },
          { "required": ["bytes"] },
          { "required": ["content"] },
          { "required": ["data"] },
          { "required": ["text"] }
        ]
      },
      "additionalProperties": false
    }
  }
}
