import { parse_args } from "std/cli"
import { find_files } from "std/fs"

const SKIP_SEGMENTS = ["/.git/", "/.harn/", "/.harn-runs/", "/docs/dist/", "/node_modules/", "/target/"]

const SCANNED_SUFFIXES = [".harn", ".harn.prompt", ".md", ".prompt", ".rs", ".ts", ".tsx"]

fn repo_root() -> string {
  return path_normalize(path_join(source_dir(), ".."))
}

fn rel_path(path: string, root: string) -> string {
  const normalized = replace(path_normalize(path), "\\", "/")
  const normalized_root = replace(path_normalize(root), "\\", "/")
  const prefix = normalized_root + "/"
  if normalized == normalized_root {
    return "."
  }
  if normalized.starts_with(prefix) {
    return normalized[len(prefix):]
  }
  return normalized
}

fn is_skipped(path: string) -> bool {
  const wrapped = "/" + replace(path, "\\", "/")
  for segment in SKIP_SEGMENTS {
    if wrapped.contains(segment) {
      return true
    }
  }
  return false
}

fn has_scanned_suffix(path: string) -> bool {
  const lower = path.lower()
  for suffix in SCANNED_SUFFIXES {
    if lower.ends_with(suffix) {
      return true
    }
  }
  return false
}

pub fn harn_syntax_sensitive_files(root: string = "") -> list<string> {
  const resolved_root = if root == "" {
    repo_root()
  } else {
    path_normalize(root)
  }
  let out: list<string> = []
  for path in find_files(resolved_root, "**/*") {
    const rel = rel_path(path, resolved_root)
    if is_skipped(rel) || !has_scanned_suffix(rel) || !harness.fs.stat(path).is_file {
      continue
    }
    out = out + [rel]
  }
  return out.sort()
}

fn line_finding(path: string, line: int, kind: string, message: string) -> dict {
  return {path: path, line: line, kind: kind, message: message}
}

pub fn line_has_let_only_harn_binding_regex(line: string) -> bool {
  if !line.contains("let\\\\s") {
    return false
  }
  const compact = replace(line, " ", "")
  return !compact.contains("const|let")
    && !compact.contains("let|const")
    && !compact.contains("const\\\\s")
}

pub fn line_has_stale_var_tool_registry_example(line: string) -> bool {
  return len(regex_captures(r"(^|[^A-Za-z0-9_])var\s+[A-Za-z_][A-Za-z0-9_]*\s*=\s*tool_registry\s*\(", line))
    > 0
}

pub fn harn_syntax_sensitive_scan_text(path: string, text: string) -> list {
  let findings = []
  const lines = text.split("\n")
  let index = 0
  while index < len(lines) {
    const line = lines[index]
    const line_no = index + 1
    if line_has_let_only_harn_binding_regex(line) {
      findings = findings
        + [
        line_finding(
          path,
          line_no,
          "let-only-harn-binding-regex",
          "Harn binding regex matches `let` but not `const`; use a shared parser/codemod helper or accept both `const` and `let`.",
        ),
      ]
    }
    if line_has_stale_var_tool_registry_example(line) {
      findings = findings
        + [
        line_finding(
          path,
          line_no,
          "stale-var-tool-registry-example",
          "Harn examples should not teach removed `var`; use `let` for mutable tool registries or `const` for immutable values.",
        ),
      ]
    }
    index = index + 1
  }
  return findings
}

pub fn check_harn_syntax_sensitive_scans(root: string = "") -> dict {
  const resolved_root = if root == "" {
    repo_root()
  } else {
    path_normalize(root)
  }
  let findings = []
  for rel in harn_syntax_sensitive_files(resolved_root) {
    const path = path_join(resolved_root, rel)
    if !harness.fs.exists(path) {
      continue
    }
    const text = harness.fs.read_text(path)
    findings = findings + harn_syntax_sensitive_scan_text(rel, text)
  }
  return {root: resolved_root, findings: findings, violation_count: len(findings)}
}

fn render_report(report: dict) -> string {
  if report.violation_count == 0 {
    return "harn syntax-sensitive scan check passed: no let-only Harn binding regexes or stale var tool_registry examples found."
  }
  let lines = [
    "harn syntax-sensitive scan check failed: " + to_string(report.violation_count) + " finding(s)",
    "",
    "Use parser/codemod facts where possible. If text scanning is unavoidable, accept both current and recently migrated Harn keyword spellings or document an explicit non-Harn target.",
  ]
  for finding in report.findings {
    lines = lines
      + [
      "- "
        + to_string(finding.path)
        + ":"
        + to_string(finding.line)
        + " ["
        + to_string(finding.kind)
        + "] "
        + to_string(finding.message),
    ]
  }
  return join(lines, "\n")
}

fn arg_spec() -> list {
  return [
    {kind: "option", name: "root", flags: ["--root"], parse: "string", default: ""},
    {kind: "flag", name: "json", flags: ["--json"], default: false},
  ]
}

fn main(harness: Harness) {
  const parsed = parse_args(argv, arg_spec())
  if parsed?._help ?? false {
    harness.stdio
      .println(
      "usage: harn run scripts/check_harn_syntax_sensitive_scans.harn -- [--json] [--root PATH]",
    )
    return nil
  }
  if len(parsed?._errors ?? []) > 0 || len(parsed?._extras ?? []) > 0 {
    const errors = (parsed?._errors ?? []) + (parsed?._extras ?? [])
    harness.stdio.eprintln(join(errors, "\n"))
    exit(2)
  }
  const report = check_harn_syntax_sensitive_scans(to_string(parsed?.root ?? ""))
  if parsed?.json ?? false {
    harness.stdio.println(json_stringify_pretty(report))
  } else {
    const out = render_report(report)
    if report.violation_count == 0 {
      harness.stdio.println(out)
    } else {
      harness.stdio.eprintln(out)
    }
  }
  if report.violation_count > 0 {
    exit(1)
  }
  return nil
}
