// Project every `harness.<capability>.<method>` that `harn-vm` declares into a
// static table the parser can read without the VM.
//
// `harn-capability-contracts` is the dependency-leaf owner of capability method
// contracts precisely so "correctness never depends on a VM having initialized
// a process-global registry first". Most methods honour that, but 280 of them
// are declared by `#[harn_builtin(exposure = "harness.…")]` inside `harn-vm`,
// whose bodies close over VM internals and cannot move to a leaf crate. Until
// `install_builtin_manifest` runs, the parser cannot tell one of those from a
// typo — so `harn check` had to stay silent about every unknown capability
// method (#6101).
//
// This generates the *names* only. The signature, effects, and documentation
// stay with the `#[harn_builtin]` declaration, which remains their one owner;
// this table answers exactly one question the parser cannot otherwise answer:
// does this capability have this method at all?
//
// Usage:
//   harn run scripts/gen_vm_capability_exposures.harn            # write
//   harn run scripts/gen_vm_capability_exposures.harn -- --check # drift gate
const SOURCE_GLOB = "crates/harn-vm/src/**/*.rs"

const OUTPUT = "crates/harn-capability-contracts/src/vm_declared.rs"

// `exposure = "harness.<capability>.<method>"`, the one spelling the
// `#[harn_builtin]` macro accepts for a capability method. A declaration that
// stopped matching would drop out of the table silently, so the count is
// asserted against the parsed manifest below rather than trusted.
const EXPOSURE_PATTERN = "exposure = \"harness\\.([a-z_0-9]+)\\.([a-z_0-9]+)\""

const HEADER_LINES = [
  "//! Capability methods declared by `#[harn_builtin]` inside `harn-vm`.",
  "//!",
  "//! GENERATED by `make gen-vm-exposures` from the `exposure = \"harness.…\"`",
  "//! declarations in `crates/harn-vm/src/`. Do not edit by hand.",
  "//!",
  "//! These are names only. Their signatures, effects, and documentation live",
  "//! with the declaration in `harn-vm` and are installed into the builtin",
  "//! manifest at VM startup. This table exists so a consumer that runs *before*",
  "//! that installation — `harn check` — can still tell a real capability method",
  "//! from a typo (#6101).",
  "",
  "/// Every `(capability_field, method)` pair `harn-vm` exposes on a `Harness`",
  "/// sub-handle, sorted so lookups can binary-search.",
  "pub static VM_DECLARED_CAPABILITY_METHODS: &[(&str, &str)] = &[",
  "",
]

/**
 * Repo-relative path for a recursive-glob result. Glob yields absolute paths
 * with a `/./` marker between the search root and the matched suffix.
 */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/**
 * Every `capability\tmethod` pair declared in one Rust source text.
 *
 * Returned tab-joined so the caller can sort and de-duplicate with plain list
 * operations; the pair is split apart again only at render time.
 */
pub fn exposures_in_text(text: string) -> list<string> {
  let out: list<string> = []
  for capture in regex_captures(EXPOSURE_PATTERN, text) {
    const groups = capture.groups
    if groups.count == 2 {
      out = out + ["${groups[0]}\t${groups[1]}"]
    }
  }
  return out
}

/** Render the generated Rust source for a sorted, de-duplicated pair list. */
pub fn render(pairs: list<string>) -> string {
  let body = ""
  for pair in pairs {
    const parts = pair.split("\t")
    body = body + "    (\"${parts[0]}\", \"${parts[1]}\"),\n"
  }
  return HEADER_LINES.join("\n") + body + "];\n"
}

/** Sorted, de-duplicated pairs from every scanned file. */
pub fn collect(fs: HarnessFs) -> list<string> {
  let seen: list<string> = []
  for path in fs.glob(SOURCE_GLOB).sorted() {
    for pair in exposures_in_text(fs.read_text(path)) {
      if !seen.contains(pair) {
        seen = seen + [pair]
      }
    }
  }
  return seen.sorted()
}

pipeline main(harness: Harness, task: unknown) {
  const pairs = collect(harness.fs)
  if pairs.count == 0 {
    harness.stdio.eprintln(
      "error: no `exposure = \"harness.…\"` declarations found under ${SOURCE_GLOB}",
    )
    harness.stdio.eprintln("hint: the declaration spelling changed; update EXPOSURE_PATTERN")
    return 1
  }
  const generated = render(pairs)
  if argv.contains("--check") {
    const disk = if harness.fs.exists(OUTPUT) {
      harness.fs.read_text(OUTPUT)
    } else {
      ""
    }
    if disk != generated {
      harness.stdio.eprintln("error: ${OUTPUT} is stale relative to ${SOURCE_GLOB}")
      harness.stdio.eprintln("hint: run 'make gen-vm-exposures' and commit the result")
      return 1
    }
    harness.stdio.println("${pairs.count} VM-declared capability methods; ${OUTPUT} is up to date")
    return 0
  }
  harness.fs.write_text(OUTPUT, generated)
  harness.stdio.println("wrote ${pairs.count} VM-declared capability methods to ${OUTPUT}")
  return 0
}
