// Smoke-test the Langfuse sink end-to-end.
//
// Wires `with_telemetry({sink: "langfuse"})` over a mocked agent_loop
// turn that fires two tool calls. The Langfuse sink POSTs each span
// to ${LANGFUSE_BASE_URL}/api/public/ingestion via http_request.
//
// Run with:
//   LANGFUSE_BASE_URL=https://us.cloud.langfuse.com \
//   LANGFUSE_PUBLIC_KEY=pk-... \
//   LANGFUSE_SECRET_KEY=sk-... \
//   cargo run --bin harn -- run scripts/smoke_telemetry_langfuse.harn
//
// On success the script prints "spans posted: 2" and "errors: 0". HTTP
// failures are captured via `on_error` so the script never silently
// swallows a misconfigured endpoint.
import { compose_tool_callers, with_telemetry } from "std/llm/tool_middleware"

pipeline default() {
  const posted = atomic(0)
  const errors = atomic(0)
  // Two-sink fan-out: one to Langfuse for real export, one to a local
  // counter so the smoke can be observed without polling Langfuse.
  const stack = compose_tool_callers(
    [
      with_telemetry(
        {
          sinks: [
            {
              sink: "langfuse",
              project: "harn-smoke",
              environment: "dev",
              on_error: { message, _span ->
                let _ = atomic_add(errors, 1)
                __io_println("langfuse error: " + to_string(message))
              },
            },
            { _span ->
              let _ = atomic_add(posted, 1)
            },
          ],
          persona: "smoke_captain",
        },
      ),
    ],
  )
  // Two tools — a read and a write — so child spans surface both
  // status: "ok" and an executor field.
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "lookup",
    "Look up evidence",
    {
      handler: { args -> "evidence for " + to_string(args?.q ?? "") },
      parameters: {q: {type: "string"}},
      annotations: {kind: "read"},
    },
  )
  registry = tool_define(
    registry,
    "summarize",
    "Summarize evidence",
    {
      handler: { args -> "summary of " + to_string(args?.text ?? "") },
      parameters: {text: {type: "string"}},
      annotations: {kind: "think"},
    },
  )
  // Mocked LLM driving two tool calls then a done sentinel.
  llm_mock_clear()
  llm_mock(
    {
      tool_calls: [
        {id: "smoke-1", name: "lookup", arguments: {q: "rate limiter"}},
        {id: "smoke-2", name: "summarize", arguments: {text: "rate limiter docs"}},
      ],
    },
  )
  llm_mock({text: "Done. ##DONE##"})
  const result = agent_loop(
    "smoke telemetry",
    nil,
    {
      provider: "mock",
      tools: registry,
      tool_format: "native",
      max_iterations: 3,
      loop_until_done: true,
      tool_caller: stack,
    },
  )
  __io_println("status: " + to_string(result.status))
  __io_println("spans posted: " + to_string(atomic_get(posted)))
  __io_println("errors: " + to_string(atomic_get(errors)))
}
