// Verify that Cargo.toml declares CHANGELOG.md's stable target as X.Y.Z-dev,
// then print the release harness's patch operation.
//
// Used by .github/workflows/bump-release.yml to derive the right
// `release_ship.sh --bump <type>` flag automatically when a "Prepare
// vX.Y.Z release" commit lands on main. The version comparison is
// canonical via CHANGELOG. The workspace no longer describes the previous
// stable release, so release recovery must strip the exact `-dev` identity
// rather than reinterpret the target as a fresh SemVer bump.
//
// Exits 0 with `patch`, `minor`, or `major` on stdout.
// Exits 1 on shape mismatch with a human-readable error on stderr.
// Exits 2 when Cargo.toml and CHANGELOG.md already match (no bump needed).
import { stable_version_from_development } from "./release_metadata.harn"

const CARGO_PATH = "Cargo.toml"

const CHANGELOG_PATH = "CHANGELOG.md"

/**
 * Pull the workspace version literal from a Cargo.toml. Errors loudly
 * if no `version = "..."` line is at the top of the file.
 */
pub fn read_cargo_version(fs: HarnessFs) -> string {
  const captures = regex_captures(r"(?m)^version = \x22([^\x22]+)\x22", fs.read_text(CARGO_PATH))
  if captures.count == 0 {
    throw "could not find workspace version in ${CARGO_PATH}"
  }
  return captures[0].groups[0]
}

/** Pull the topmost `## vX.Y.Z` heading from CHANGELOG.md. */
pub fn read_changelog_top_version(fs: HarnessFs) -> string {
  const captures = regex_captures(r"(?m)^## v(\d+\.\d+\.\d+)\s*$", fs.read_text(CHANGELOG_PATH))
  if captures.count == 0 {
    throw "no `## vX.Y.Z` heading found in ${CHANGELOG_PATH}"
  }
  return captures[0].groups[0]
}

/** Require `current` to be the exact development form of `target`. */
pub fn detect(current: string, target: string) -> "patch" {
  const declared = stable_version_from_development(current)
  if declared != target {
    throw "workspace declares ${declared}, but CHANGELOG.md targets ${target}"
  }
  return "patch"
}

pipeline main(harness: Harness, task) {
  try {
    const current = read_cargo_version(harness.fs)
    const target = read_changelog_top_version(harness.fs)
    if current == target {
      harness.stdio.eprintln(
        "warning: Cargo.toml and CHANGELOG.md both at ${current}; nothing to bump",
      )
      return 2
    }
    harness.stdio.println(detect(current, target))
    return 0
  } catch (e) {
    harness.stdio.eprintln("error: ${e}")
    return 1
  }
}
