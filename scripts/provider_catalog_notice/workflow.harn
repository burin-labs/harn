import { LlmCallOptions } from "std/llm/options"
import "./types.harn"

pub fn provider_notice_checks() -> list<string> {
  return [
    "check-provider-catalog-drift-core",
    "check-provider-catalog",
    "check-provider-matrix",
    "check-provider-support",
  ]
}

fn __nonempty(value: string?) -> bool {
  return type_of(value) == "string" && trim(value) != ""
}

fn __notice_id(harness: Harness, notice: dict) -> string {
  return sha256(
    json_stringify(
      {
        source_id: notice?.source_id,
        retrieved_at: notice?.retrieved_at,
        provider: notice?.provider,
        text: notice?.text,
        source_url: notice?.source_url,
        provenance: notice?.provenance,
      },
    ),
  )
}

pub fn validate_notice(harness: Harness, notice: dict) -> Result<ProviderNotice, string> {
  if !__nonempty(notice?.source_id) {
    return Err("notice.source_id is required")
  }
  if !__nonempty(notice?.retrieved_at) {
    return Err("notice.retrieved_at is required")
  }
  if regex_match(
    "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$",
    notice.retrieved_at,
  )
    == nil {
    return Err("notice.retrieved_at must be an RFC 3339 timestamp")
  }
  if !__nonempty(notice?.provider) {
    return Err("notice.provider is required")
  }
  if !contains(["authenticated", "verified_link", "unverified", "failed"], notice?.provenance) {
    return Err("notice.provenance is invalid")
  }
  if !__nonempty(notice?.text) && !__nonempty(notice?.source_url) {
    return Err("notice requires text or an immutable source_url")
  }
  const trusted: ProviderNotice = {
    source_id: notice.source_id,
    retrieved_at: notice.retrieved_at,
    provider: notice.provider,
    text: notice?.text,
    source_url: notice?.source_url,
    provenance: notice.provenance,
  }
  return Ok(trusted)
}

fn __provider_rows(catalog: dict, provider: string) -> list {
  let rows = []
  for row in catalog?.providers ?? [] {
    if row?.name == provider || row?.id == provider {
      rows = rows + [row]
    }
  }
  return rows
}

fn __model_rows(catalog: dict, provider: string, model_id: string) -> list {
  let rows = []
  for row in catalog?.models ?? [] {
    if row?.provider == provider && row?.id == model_id {
      rows = rows + [row]
    }
  }
  return rows
}

fn __trusted_no_op_identity(
  notice: ProviderNotice,
  candidate: dict,
  model_row: dict,
  current_matches_old: bool,
) -> bool {
  if current_matches_old {
    return true
  }
  const text = lowercase(notice.text ?? "")
  return contains(text, lowercase(candidate.model_id))
    || (__nonempty(model_row?.name) && contains(text, lowercase(model_row.name)))
}

fn __base_receipt(
  harness: Harness,
  notice: ProviderNotice,
  disposition: NoticeDisposition,
  reason: string,
) -> NoticeValidationReceipt {
  const schema_version: "harn.provider_catalog_notice.v1" = "harn.provider_catalog_notice.v1"
  const unresolved_verification: list<string> = []
  const checks: list<string> = []
  const receipt = {
    schema_version: schema_version,
    notice_id: __notice_id(harness, notice),
    source_id: notice.source_id,
    retrieved_at: notice.retrieved_at,
    provenance: notice.provenance,
    provider: notice.provider,
    model_id: nil,
    change_kind: nil,
    effective_date: nil,
    disposition: disposition,
    reason: reason,
    evidence: nil,
    source_url: notice.source_url,
    source_path: nil,
    unresolved_verification: unresolved_verification,
    checks: checks,
  }
  return schema_expect(receipt, schema_of(NoticeValidationReceipt))
}

fn __candidate_common_error(notice: ProviderNotice, candidate: dict) -> string? {
  if !contains(
    ["addition", "price", "promotion", "retirement", "endpoint", "capability"],
    candidate?.kind,
  ) {
    return "candidate.kind must be addition, price, promotion, retirement, endpoint, or capability"
  }
  if !__nonempty(candidate?.provider) || !__nonempty(candidate?.model_id) {
    return "candidate provider and model_id are required"
  }
  if candidate.provider != notice.provider {
    return "candidate provider conflicts with notice provider"
  }
  if candidate.kind != "addition" && !__nonempty(candidate?.effective_date) {
    return "candidate effective_date is required"
  }
  if candidate.kind != "addition"
    && regex_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", candidate.effective_date) == nil {
    return "candidate effective_date must be YYYY-MM-DD"
  }
  if !__nonempty(candidate?.evidence) {
    return "candidate supporting evidence is required"
  }
  return nil
}

fn __promotion_candidate_error(candidate: dict) -> string? {
  if !__nonempty(candidate?.promotion_id) || !__nonempty(candidate?.source_url) {
    return "promotion candidate requires promotion_id and source_url"
  }
  for date in [candidate?.ends_on, candidate?.review_after] {
    if date != nil && regex_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", date) == nil {
      return "promotion end and review dates must be YYYY-MM-DD"
    }
  }
  if candidate?.ends_on != nil && candidate.ends_on < candidate.effective_date {
    return "promotion ends_on must not precede effective_date"
  }
  if candidate?.review_after != nil && candidate.review_after < candidate.effective_date {
    return "promotion review_after must not precede effective_date"
  }
  for rates in [candidate?.old_value, candidate?.new_value] {
    if type_of(rates?.input_per_mtok) != "float"
      && type_of(rates?.input_per_mtok) != "int" {
      return "promotion input price must be numeric"
    }
    if type_of(rates?.output_per_mtok) != "float"
      && type_of(rates?.output_per_mtok) != "int" {
      return "promotion output price must be numeric"
    }
  }
  return nil
}

fn __candidate_variant_error(candidate: dict) -> string? {
  if candidate.kind == "addition" {
    return nil
  }
  if candidate.kind == "price" {
    if !contains(
      ["input_per_mtok", "output_per_mtok", "cache_read_per_mtok", "cache_write_per_mtok"],
      candidate?.field,
    ) {
      return "price candidate field is invalid"
    }
    if type_of(candidate?.new_value) != "float" && type_of(candidate?.new_value) != "int" {
      return "price candidate new_value must be numeric"
    }
    return nil
  }
  if candidate.kind == "promotion" {
    return __promotion_candidate_error(candidate)
  }
  if candidate.kind == "retirement" {
    if type_of(candidate?.old_value) != "bool" || type_of(candidate?.new_value) != "bool" {
      return "retirement old_value and new_value must be booleans"
    }
    return nil
  }
  if candidate.kind == "endpoint" {
    if !contains(["base_url", "chat_endpoint", "completion_endpoint"], candidate?.field) {
      return "endpoint candidate field is invalid"
    }
    if !__nonempty(candidate?.old_value) || !__nonempty(candidate?.new_value) {
      return "endpoint old_value and new_value are required"
    }
    return nil
  }
  if !contains(
    [
      "native_tools",
      "vision",
      "prompt_caching",
      "audio_supported",
      "pdf_supported",
      "files_api_supported",
    ],
    candidate?.capability,
  ) {
    return "capability candidate capability is invalid"
  }
  if type_of(candidate?.old_value) != "bool" || type_of(candidate?.new_value) != "bool" {
    return "capability old_value and new_value must be booleans"
  }
  return nil
}

fn __current_value(candidate: dict, provider_row: dict, model_row: dict) {
  if candidate.kind == "price" {
    return model_row?.pricing?.[candidate.field]
  }
  if candidate.kind == "promotion" {
    return model_row?.pricing
  }
  if candidate.kind == "retirement" {
    if model_row?.deprecation?.status != nil {
      return model_row.deprecation.status != "active"
    }
    return model_row?.deprecated ?? false
  }
  if candidate.kind == "endpoint" {
    return provider_row?.endpoint?.[candidate.field] ?? provider_row[candidate.field]
  }
  if candidate.capability == "native_tools" && model_row?.tool_support?.native != nil {
    return model_row.tool_support.native
  }
  if candidate.capability == "prompt_caching" && model_row?.prompt_cache != nil {
    return model_row.prompt_cache
  }
  const artifact_name = if candidate.capability == "vision" {
    "image"
  } else if candidate.capability == "audio_supported" {
    "audio"
  } else if candidate.capability == "pdf_supported" {
    "pdf"
  } else if candidate.capability == "files_api_supported" {
    "files"
  } else if candidate.capability == "native_tools" {
    "tools"
  } else {
    candidate.capability
  }
  if model_row?.modalities?.input != nil && artifact_name != "files" {
    return model_row.modalities.input.contains(artifact_name)
  }
  return (model_row?.capability_tags ?? model_row?.capabilities ?? []).contains(artifact_name)
}

fn __values_equal(left: any, right: any) -> bool {
  if type_of(left) == "int" || type_of(left) == "float" {
    if type_of(right) != "int" && type_of(right) != "float" {
      return false
    }
    return to_float(left) == to_float(right)
  }
  return left == right
}

fn __price_rates_equal(current: any, expected: any) -> bool {
  for field in ["input_per_mtok", "output_per_mtok", "cache_read_per_mtok", "cache_write_per_mtok"] {
    const wanted = expected?.[field]
    if wanted != nil && !__values_equal(current?.[field], wanted) {
      return false
    }
  }
  return true
}

fn __promotion_by_id(pricing: dict, promotion_id: any) {
  for promotion in pricing?.promotions ?? [] {
    if promotion?.id == promotion_id {
      return promotion
    }
  }
  return nil
}

fn __promotion_matches(promotion: dict, candidate: dict) -> bool {
  if promotion == nil
    || promotion?.starts_on != candidate.effective_date
    || promotion?.ends_on != candidate?.ends_on
    || promotion?.review_after != candidate?.review_after
    || promotion?.source_url
      != candidate.source_url {
    return false
  }
  return __price_rates_equal(promotion, candidate.new_value)
}

fn __patch_descriptor(candidate: dict) -> dict {
  if candidate.kind == "price" {
    return {
      table_kind: "model",
      field: "pricing." + candidate.field,
      old_value: candidate.old_value,
      new_value: candidate.new_value,
    }
  }
  if candidate.kind == "promotion" {
    return {
      table_kind: "model",
      field: "pricing.promotions",
      old_value: candidate.old_value,
      new_value: candidate.new_value,
      promotion_id: candidate.promotion_id,
      starts_on: candidate.effective_date,
      ends_on: candidate?.ends_on,
      review_after: candidate?.review_after,
      source_url: candidate.source_url,
    }
  }
  if candidate.kind == "retirement" {
    return {
      table_kind: "model",
      field: "deprecated",
      old_value: candidate.old_value,
      new_value: candidate.new_value,
      note: "Retires " + candidate.effective_date + " per " + candidate.evidence,
      replacement: candidate?.replacement,
    }
  }
  if candidate.kind == "endpoint" {
    return {
      table_kind: "provider",
      field: candidate.field,
      old_value: candidate.old_value,
      new_value: candidate.new_value,
    }
  }
  return {
    table_kind: "model",
    field: "capabilities." + candidate.capability,
    old_value: candidate.old_value,
    new_value: candidate.new_value,
  }
}

/**
 * Evidence comes from Harn's validating scorecard command, separately from model-extracted facts.
 */
fn __missing_native_tool_evidence(candidate: dict, tool_evidence: dict?) -> bool {
  if candidate.kind != "capability"
    || candidate.capability != "native_tools"
    || !candidate.new_value {
    return false
  }
  return !(tool_evidence?.routes ?? []).any(
    { route ->
      route?.provider == candidate.provider
        && route?.model == candidate.model_id
        && (route?.passed_probes ?? []).contains("native_tool_probe")
    },
  )
}

/**
 * A retirement's old value is the row's own flag, which the catalog already
 * knows; only the replacement is the notice's to supply, and it must name a
 * row the catalog can route to.
 */
fn __resolve_retirement(candidate: dict, current: unknown, catalog: dict) -> Result<dict, string> {
  if candidate.kind != "retirement" {
    return Ok(candidate)
  }
  let resolved = candidate + {old_value: current}
  if __nonempty(candidate?.replacement) {
    const replacement = regex_replace(r"[.\s]+$", "", trim(candidate.replacement))
    if len(__model_rows(catalog, candidate.provider, replacement)) != 1 {
      return Err("replacement must be exactly one catalog model id")
    }
    resolved = resolved + {replacement: replacement}
  }
  return Ok(resolved)
}

pub fn plan_notice(
  harness: Harness,
  notice_raw: dict,
  extraction: dict,
  catalog: dict,
  tool_evidence: dict? = nil,
) -> NoticePlan {
  const validated = validate_notice(harness, notice_raw)
  if is_err(validated) {
    const fallback: ProviderNotice = {
      source_id: to_string(notice_raw?.source_id ?? "malformed"),
      retrieved_at: to_string(notice_raw?.retrieved_at ?? "unknown"),
      provider: to_string(notice_raw?.provider ?? "unknown"),
      text: to_string(notice_raw?.text ?? "malformed notice"),
      provenance: "failed",
    }
    return {receipt: __base_receipt(harness, fallback, "rejected", unwrap_err(validated))}
  }
  const notice = unwrap(validated)
  if notice.provenance == "failed" || notice.provenance == "unverified" {
    return {
      receipt: __base_receipt(harness, notice, "rejected", "notice provenance is not trusted"),
    }
  }
  if extraction?.classification == "irrelevant" {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "no_op",
        extraction?.reason ?? "notice does not affect the provider catalog",
      ),
    }
  }
  if extraction?.classification == "uncertain" {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "rejected",
        extraction?.reason ?? "notice requires model identity review",
      ),
    }
  }
  if extraction?.classification != "candidate" || extraction?.candidate == nil {
    return {receipt: __base_receipt(harness, notice, "rejected", "malformed extraction result")}
  }
  let candidate = extraction.candidate
  const candidate_error = __candidate_common_error(notice, candidate)
    ?? __candidate_variant_error(candidate)
  if candidate_error != nil {
    return {receipt: __base_receipt(harness, notice, "rejected", candidate_error)}
  }
  const providers = __provider_rows(catalog, candidate.provider)
  if len(providers) == 0 {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "no_op",
        "provider is not supported by the current catalog",
      )
        + {
          model_id: candidate.model_id,
          change_kind: candidate.kind,
          effective_date: candidate.effective_date,
          evidence: candidate.evidence,
        },
      candidate: candidate,
    }
  }
  if len(providers) != 1 {
    return {receipt: __base_receipt(harness, notice, "rejected", "provider identity is ambiguous")}
  }
  const models = __model_rows(catalog, candidate.provider, candidate.model_id)
  if len(models) == 0 {
    if candidate.kind != "addition" {
      return {
        receipt: __base_receipt(
          harness,
          notice,
          "rejected",
          "existing-model change requires an exact catalog model id",
        )
          + {
            model_id: candidate.model_id,
            change_kind: candidate.kind,
            evidence: candidate.evidence,
          },
      }
    }
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "incomplete_add",
        "new model on a supported provider requires verification before catalog insertion",
      )
        + {
          model_id: candidate.model_id,
          change_kind: candidate.kind,
          effective_date: candidate.effective_date,
          evidence: candidate.evidence,
          unresolved_verification: [
            "context window and canonical provider model id",
            "complete pricing and capability row",
            "provider capability-matrix behavior",
            "replacement/default routing impact",
          ],
        },
      candidate: candidate,
    }
  }
  if len(models) != 1 {
    return {receipt: __base_receipt(harness, notice, "rejected", "model identity is ambiguous")}
  }
  if candidate.kind == "addition" {
    return {
      receipt: __base_receipt(harness, notice, "no_op", "model is already in the catalog")
        + {model_id: candidate.model_id, change_kind: candidate.kind, evidence: candidate.evidence},
      candidate: candidate,
    }
  }
  const current = __current_value(candidate, providers[0], models[0])
  const resolved = __resolve_retirement(candidate, current, catalog)
  if is_err(resolved) {
    return {
      receipt: __base_receipt(harness, notice, "rejected", unwrap_err(resolved))
        + {model_id: candidate.model_id, change_kind: candidate.kind, evidence: candidate.evidence},
    }
  }
  candidate = unwrap(resolved)
  const current_promotion = if candidate.kind == "promotion" {
    __promotion_by_id(current, candidate.promotion_id)
  } else {
    nil
  }
  const already_applied = if candidate.kind == "promotion" {
    __promotion_matches(current_promotion, candidate)
  } else {
    __values_equal(current, candidate.new_value)
  }
  const current_matches_old = if candidate.kind == "promotion" {
    current_promotion == nil && __price_rates_equal(current, candidate.old_value)
  } else {
    __values_equal(current, candidate.old_value)
  }
  if already_applied
    && !__trusted_no_op_identity(notice, candidate, models[0], current_matches_old) {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "rejected",
        "proposed value is present but the notice does not identify this exact model",
      )
        + {model_id: candidate.model_id, change_kind: candidate.kind, evidence: candidate.evidence},
      candidate: candidate,
    }
  }
  if already_applied {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "no_op",
        "current catalog already contains the proposed value",
      )
        + {
          model_id: candidate.model_id,
          change_kind: candidate.kind,
          effective_date: candidate.effective_date,
          evidence: candidate.evidence,
        },
      candidate: candidate,
    }
  }
  if !current_matches_old {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "rejected",
        "candidate old_value conflicts with the current catalog row",
      )
        + {
          model_id: candidate.model_id,
          change_kind: candidate.kind,
          effective_date: candidate.effective_date,
          evidence: candidate.evidence,
        },
      candidate: candidate,
    }
  }
  if __missing_native_tool_evidence(candidate, tool_evidence) {
    return {
      receipt: __base_receipt(
        harness,
        notice,
        "incomplete_capability",
        "native tools require a passing live probe of this exact provider and model",
      )
        + {
          model_id: candidate.model_id,
          change_kind: candidate.kind,
          tool_evidence: tool_evidence,
          unresolved_verification: ["passing live native_tool_probe for the exact catalog route"],
        },
      candidate: candidate,
    }
  }
  return {
    receipt: __base_receipt(harness, notice, "patch", "validated against one current catalog row")
      + {
        tool_evidence: tool_evidence,
        model_id: candidate.model_id,
        change_kind: candidate.kind,
        effective_date: candidate.effective_date,
        evidence: candidate.evidence,
      },
    candidate: candidate,
    patch: __patch_descriptor(candidate),
  }
}

fn __table_header(candidate: dict) -> string {
  if candidate.kind == "endpoint" {
    return "[providers." + candidate.provider + "]"
  }
  return "[models.\"" + candidate.model_id + "\"]"
}

fn __capability_bounds(lines: list<string>, candidate: dict) -> Result<dict, string> {
  const provider_header = "[[provider." + candidate.provider + "]]"
  const match_line = "model_match = " + json_stringify(candidate.model_id)
  let matches: list<int> = []
  let index = 0
  for line in lines {
    if trim(line) == match_line {
      matches = matches + [index]
    }
    index = index + 1
  }
  if len(matches) == 0 {
    return Err(
      "capability changes require one exact model_match rule; wildcard ownership is ambiguous",
    )
  }
  if len(matches) != 1 {
    return Err("exact capability model_match rule is ambiguous")
  }
  const match_index = matches[0] ?? 0
  let start = match_index
  while start > 0 && trim(lines[start]) != provider_header {
    start = start - 1
  }
  if trim(lines[start]) != provider_header {
    return Err("exact capability rule is not owned by the candidate provider")
  }
  let end = match_index + 1
  while end < len(lines) && !starts_with(trim(lines[end]), "[[provider.") {
    end = end + 1
  }
  return Ok({start: start, end: end})
}

fn __replace_line(lines: list<string>, index: int, replacement: string) -> list<string> {
  let out: list<string> = []
  let cursor = 0
  for line in lines {
    out = out
      + [
        if cursor == index {
          replacement
        } else {
          line
        },
      ]
    cursor = cursor + 1
  }
  return out
}

fn __insert_lines(lines: list<string>, index: int, additions: list<string>) -> list<string> {
  let out: list<string> = []
  let cursor = 0
  for line in lines {
    if cursor == index {
      out = out + additions
    }
    out = out + [line]
    cursor = cursor + 1
  }
  if index == len(lines) {
    out = out + additions
  }
  return out
}

fn __table_bounds(lines: list<string>, header: string) -> Result<dict, string> {
  let matches: list<int> = []
  let index = 0
  for line in lines {
    if trim(line) == header {
      matches = matches + [index]
    }
    index = index + 1
  }
  if len(matches) == 0 {
    return Err("owning source table was not found")
  }
  if len(matches) != 1 {
    return Err("owning source table is ambiguous")
  }
  const start = matches[0] ?? 0
  let end = len(lines)
  let cursor = start + 1
  while cursor < len(lines) {
    if starts_with(trim(lines[cursor]), "[") {
      end = cursor
      break
    }
    cursor = cursor + 1
  }
  // Blank lines and comments before the next header belong to that header,
  // so a field appended at `end` stays with this table's own fields.
  while end > start + 1 && (trim(lines[end - 1]) == "" || starts_with(trim(lines[end - 1]), "#")) {
    end = end - 1
  }
  return Ok({start: start, end: end})
}

fn __find_field_line(lines: list<string>, bounds: dict, field: string) -> Result<int, string> {
  let matches: list<int> = []
  let index = bounds.start + 1
  while index < bounds.end {
    if starts_with(trim(lines[index]), field + " =") {
      matches = matches + [index]
    }
    index = index + 1
  }
  if len(matches) == 0 {
    return Err("field '" + field + "' was not found in the owning source table")
  }
  if len(matches) != 1 {
    return Err("field '" + field + "' is ambiguous in the owning source table")
  }
  return Ok(matches[0] ?? 0)
}

fn __apply_price(
  lines: list<string>,
  bounds: dict,
  candidate: dict,
) -> Result<list<string>, string> {
  const found = __find_field_line(lines, bounds, "pricing")
  if is_err(found) {
    return Err(unwrap_err(found))
  }
  const index = unwrap(found)
  const pattern = candidate.field + r"\s*=\s*[0-9]+(?:\.[0-9]+)?"
  const replacement = candidate.field + " = " + to_string(candidate.new_value)
  const updated = regex_replace(pattern, replacement, lines[index])
  if updated == lines[index] {
    return Err("price field was not found in the owning pricing row")
  }
  return Ok(__replace_line(lines, index, updated))
}

fn __promotion_fields(candidate: dict) -> list<string> {
  let fields = [
    "id = " + json_stringify(candidate.promotion_id),
    "starts_on = " + json_stringify(candidate.effective_date),
  ]
  if candidate?.ends_on != nil {
    fields = fields + ["ends_on = " + json_stringify(candidate.ends_on)]
  }
  if candidate?.review_after != nil {
    fields = fields + ["review_after = " + json_stringify(candidate.review_after)]
  }
  fields = fields + ["source_url = " + json_stringify(candidate.source_url)]
  for field in ["input_per_mtok", "output_per_mtok", "cache_read_per_mtok", "cache_write_per_mtok"] {
    if candidate.new_value?.[field] != nil {
      fields = fields + [field + " = " + to_string(candidate.new_value[field])]
    }
  }
  return fields
}

fn __apply_promotion(
  lines: list<string>,
  bounds: dict,
  candidate: dict,
) -> Result<list<string>, string> {
  const found = __find_field_line(lines, bounds, "pricing")
  if is_err(found) {
    return Err(unwrap_err(found))
  }
  const index = unwrap(found)
  let current = lines[index] ?? ""
  if contains(current, "id = " + json_stringify(candidate.promotion_id)) {
    return Err("promotion id already exists in the owning pricing row")
  }
  const promotion = "{ " + join(__promotion_fields(candidate), ", ") + " }"
  if contains(current, "promotions = [") {
    current = regex_replace(r"promotions\s*=\s*\[", "promotions = [" + promotion + ", ", current)
  } else {
    const updated = regex_replace(r"\s*}\s*$", ", promotions = [" + promotion + "] }", current)
    if updated == current {
      return Err("pricing must be an inline table for promotion insertion")
    }
    current = updated
  }
  return Ok(__replace_line(lines, index, current))
}

fn __apply_endpoint(
  lines: list<string>,
  bounds: dict,
  candidate: dict,
) -> Result<list<string>, string> {
  const found = __find_field_line(lines, bounds, candidate.field)
  if is_err(found) {
    return Err(unwrap_err(found))
  }
  const index = unwrap(found)
  return Ok(
    __replace_line(lines, index, candidate.field + " = " + json_stringify(candidate.new_value)),
  )
}

fn __optional_field_line(lines: list<string>, bounds: dict, field: string) -> Result<int?, string> {
  const found = __find_field_line(lines, bounds, field)
  if is_ok(found) {
    return Ok(unwrap(found))
  }
  if contains(unwrap_err(found), "ambiguous") {
    return Err(unwrap_err(found))
  }
  return Ok(nil)
}

fn __apply_retirement(
  lines: list<string>,
  bounds: dict,
  candidate: dict,
) -> Result<list<string>, string> {
  const has_replacement = candidate?.replacement != nil && trim(candidate.replacement) != ""
  const evidence = regex_replace(r"[.\s]+$", "", candidate.evidence)
  let note = "Retires " + candidate.effective_date + " per " + evidence + "."
  if has_replacement {
    note = note + " Use " + candidate.replacement + "."
  }
  let fields: list<{name: string, value: string}> = [
    {name: "deprecated", value: to_string(candidate.new_value)},
    {name: "deprecation_note", value: json_stringify(note)},
  ]
  // The retirement date and replacement are typed catalog fields; the note
  // alone would leave them readable only as prose.
  if candidate.new_value {
    fields = fields + [{name: "sunset_date", value: json_stringify(candidate.effective_date)}]
    if has_replacement {
      fields = fields
        + [{name: "superseded_by", value: json_stringify(trim(candidate.replacement))}]
    }
  }
  // Insertions land at the table end, after every existing field line, so
  // line indices found in `lines` stay valid in `updated`.
  let updated = lines
  let insertion = bounds.end
  for field in fields {
    const existing = __optional_field_line(lines, bounds, field.name)
    if is_err(existing) {
      return Err(unwrap_err(existing))
    }
    const line = field.name + " = " + field.value
    if unwrap(existing) != nil {
      updated = __replace_line(updated, unwrap(existing) ?? 0, line)
    } else {
      updated = __insert_lines(updated, insertion, [line])
      insertion = insertion + 1
    }
  }
  return Ok(updated)
}

fn __apply_capability(
  lines: list<string>,
  bounds: dict,
  candidate: dict,
) -> Result<list<string>, string> {
  const found = __optional_field_line(lines, bounds, candidate.capability)
  if is_err(found) {
    return Err(unwrap_err(found))
  }
  if unwrap(found) != nil {
    return Ok(
      __replace_line(
        lines,
        unwrap(found) ?? 0,
        candidate.capability + " = " + to_string(candidate.new_value),
      ),
    )
  }
  if candidate.old_value {
    return Err("true capability is missing from the exact owning rule")
  }
  return Ok(
    __insert_lines(
      lines,
      bounds.end,
      [candidate.capability + " = " + to_string(candidate.new_value)],
    ),
  )
}

/**
 * Apply one already-validated candidate to the single owning TOML table.
 * This function does no model work and refuses missing or duplicate tables.
 */
pub fn apply_candidate_to_source(
  source: string,
  candidate: ProviderCatalogCandidate,
) -> Result<string, string> {
  const lines = source.split("\n")
  const bounds_result = if candidate.kind == "capability" {
    __capability_bounds(lines, candidate)
  } else {
    __table_bounds(lines, __table_header(candidate))
  }
  if is_err(bounds_result) {
    return Err(unwrap_err(bounds_result))
  }
  const bounds = unwrap(bounds_result)
  const outcome = if candidate.kind == "price" {
    __apply_price(lines, bounds, candidate)
  } else if candidate.kind == "promotion" {
    __apply_promotion(lines, bounds, candidate)
  } else if candidate.kind == "retirement" {
    __apply_retirement(lines, bounds, candidate)
  } else if candidate.kind == "endpoint" {
    __apply_endpoint(lines, bounds, candidate)
  } else {
    __apply_capability(lines, bounds, candidate)
  }
  if is_err(outcome) {
    return Err(unwrap_err(outcome))
  }
  return Ok(unwrap(outcome).join("\n"))
}

pub fn catalog_model_context(catalog: dict, notice: ProviderNotice) -> list {
  let provider_models = []
  for row in catalog?.models ?? [] {
    if row?.provider == notice.provider {
      provider_models = provider_models + [row]
    }
  }
  let context = []
  for row in provider_models {
    if len(provider_models) <= 60
      || (__nonempty(row?.id) && contains(notice.text ?? "", row.id))
      || (__nonempty(row?.name) && contains(notice.text ?? "", row.name)) {
      context = context + [{id: row.id, name: row?.name, pricing: row?.pricing}]
    }
  }
  return context
}

pub fn extraction_prompt(notice: ProviderNotice, catalog: dict) -> string {
  return """
Extract at most one provider-catalog change from this trusted notice.
Return classification "candidate" with kind "addition" when the notice explicitly names a
new provider model. An addition needs provider, model_id, and evidence only; it becomes a
reviewable incomplete proposal, never an automatic catalog row. For existing models, extract
one explicit price, temporary promotion, retirement, endpoint, or capability change. Select
model_id only from the catalog rows below, using the old value and model name to disambiguate.
For a price change, match the stated old price to that row's current field; do not select
a different row merely because its current price equals the proposed new price.
For a retirement, effective_date is the date requests to the model stop working, not the
date the deprecation was announced. When the notice states more than one retirement date,
use the earliest. Write every date as a calendar date, YYYY-MM-DD, with no time of day.
If no row matches unambiguously, do not invent an id; return "uncertain" with the ambiguity
as the reason. An actual addition must be explicitly described as a new model by the notice.
Return "irrelevant" only when no catalog change is stated. Never infer missing identifiers
or values. Preserve a short supporting excerpt or immutable link as evidence.

Current provider catalog rows:
${json_stringify_pretty(catalog_model_context(catalog, notice))}

Neutral notice:
${json_stringify_pretty(notice)}
"""
}

pub fn extract_notice(
  llm: HarnessLlm,
  notice: ProviderNotice,
  catalog: dict,
  options: dict,
) -> NoticeExtraction {
  const resolved: LlmCallOptions = schema_expect(
    options + {budget: options?.budget ?? {max_cost_usd: 0.1}, max_tokens: 1200},
    schema_of(LlmCallOptions),
  )
  return llm.call_structured(
    extraction_prompt(notice, catalog),
    schema_of(NoticeExtraction),
    resolved,
  )
}
