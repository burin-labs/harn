// Check local links in docs/src Markdown files resolve to repository files.
//
// Ported from scripts/check_docs_links.py — behavior-identical: same three
// link regexes (inline, reference, HTML href/src), same fenced-code-block
// blanking, same urlsplit/unquote local-path extraction, same candidate
// suffix fallbacks (.html->.md, extensionless ->.md and /index.md,
// trailing-slash ->/index.md), same within-repo + exists gating, and the
// same `path:line: target -> missing expected` failure output.
//
// Usage:
//   harn run scripts/check_docs_links.harn   # exit 1 on any dead local link
const DOCS_DIR = "docs/src"

// Inline `[text](target ...)` / `![alt](target ...)` links. Group 1 is the
// target up to the first whitespace or close paren.
const INLINE_LINK_RE = r"!?\[[^\]\n]*(?:\][^\[\]\n]*)?\]\(([^)\s]+)(?:\s+[^)]*)?\)"

// Reference-style `[label]: target` definitions (<=3 leading spaces).
const REFERENCE_LINK_RE = r"^\s{0,3}\[[^\]]+\]:\s+(\S+)"

// HTML `href="..."` / `src='...'` attributes. The Rust regex engine has no
// backreferences, so the Python `(['"])(.*?)\1` is split into matched-quote
// alternatives: group 1 is the double-quoted value, group 2 the single.
const HTML_ATTR_RE = r#"\b(?:href|src)=(?:"([^"]*)"|'([^']*)')"#

/**
 * Blank fenced code blocks while preserving line numbers. Each fence line
 * (``` or ~~~) and every line inside an open fence becomes empty; line
 * breaks are kept so `regex_captures` line numbers still line up with the
 * original source. Mirrors the Python `strip_fenced_blocks`.
 */
pub fn strip_fenced_blocks(text: string) -> string {
  let out: list<string> = []
  let in_fence = false
  let fence_marker = ""
  for line in text.split("\n") {
    const marker = left_trim(line).substring(0, 3)
    const is_fence = marker == "```" || marker == "~~~"
    if is_fence {
      if !in_fence {
        in_fence = true
        fence_marker = marker
      } else if marker == fence_marker {
        in_fence = false
        fence_marker = ""
      }
      out = out + [""]
      continue
    }
    if in_fence {
      out = out + [""]
    } else {
      out = out + [line]
    }
  }
  return out.join("\n")
}

/** Strip leading ASCII whitespace (space, tab, CR, NL) from `s`. */
pub fn left_trim(s: string) -> string {
  let i = 0
  const n = s.len()
  while i < n {
    const c = s.char_at(i)
    if c == " " || c == "\t" || c == "\r" || c == "\n" {
      i = i + 1
    } else {
      break
    }
  }
  return s.substring(i, n)
}

/**
 * Strip every leading/trailing occurrence of the characters in `chars`
 * from `s`. Mirrors Python's `str.strip(chars)` (used for `<>` removal).
 */
pub fn strip_chars(s: string, chars: string) -> string {
  let start = 0
  let end = s.len()
  while start < end && chars.contains(s.char_at(start)) {
    start = start + 1
  }
  while end > start && chars.contains(s.char_at(end - 1)) {
    end = end - 1
  }
  return s.substring(start, end)
}

/** Hex digit value of a single char (0-15), or -1 if not a hex digit. */
pub fn hex_digit(c: string) -> int {
  return "0123456789abcdef".index_of(c.to_lower())
}

/** Printable-ASCII char (codes 32..126) for `code`, or "" otherwise. */
pub fn printable_ascii(code: int) -> string {
  const ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  if code < 32 || code > 126 {
    return ""
  }
  return ascii.char_at(code - 32)
}

/**
 * Percent-decode `%XX` escapes in `s` (printable ASCII range). Non-escape
 * text passes through untouched; a malformed or out-of-range escape is
 * left literal. Stands in for `urllib.parse.unquote` for doc-link paths.
 */
pub fn unquote(s: string) -> string {
  let out = ""
  let i = 0
  const n = s.len()
  while i < n {
    const c = s.char_at(i)
    if c == "%" && i + 2 < n {
      const hi = hex_digit(s.char_at(i + 1))
      const lo = hex_digit(s.char_at(i + 2))
      if hi >= 0 && lo >= 0 {
        const decoded = printable_ascii(hi * 16 + lo)
        if decoded != "" {
          out = out + decoded
          i = i + 3
          continue
        }
      }
    }
    out = out + c
    i = i + 1
  }
  return out
}

/** True when `c` is a valid URL-scheme character (letter/digit/+/-/.). */
pub fn is_scheme_char(c: string) -> bool {
  const lc = c.to_lower()
  if "abcdefghijklmnopqrstuvwxyz".contains(lc) {
    return true
  }
  if "0123456789".contains(c) {
    return true
  }
  return c == "+" || c == "-" || c == "."
}

/**
 * True when `target` carries a URL scheme (e.g. `https:`, `mailto:`),
 * matching `urlsplit(...).scheme` being non-empty: a run of scheme chars
 * starting with a letter, ended by `:`, with no `/` before the `:`.
 */
pub fn has_scheme(target: string) -> bool {
  const n = target.len()
  if n == 0 {
    return false
  }
  const first = target.char_at(0)
  if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(first) {
    return false
  }
  let i = 0
  while i < n {
    const c = target.char_at(i)
    if c == ":" {
      return i > 0
    }
    if c == "/" {
      return false
    }
    if !is_scheme_char(c) {
      return false
    }
    i = i + 1
  }
  return false
}

/**
 * Resolve a raw markdown link target to a repo-relative *local* path, or
 * `nil` when it is not a local file reference. Mirrors Python `local_path`:
 * trims whitespace + `<>`, drops empty / anchor-only targets, rejects
 * absolute URLs (scheme or `//netloc`), drops query/fragment, percent-
 * decodes, and drops empties.
 */
pub fn local_path(raw_target: string) -> string? {
  const target = strip_chars(strip_chars(raw_target, " \t\r\n"), "<>")
  if target.len() == 0 || target.starts_with("#") {
    return nil
  }
  if has_scheme(target) {
    return nil
  }
  if target.starts_with("//") {
    return nil
  }
  // Path = everything before the first `?` or `#`.
  let cut = target.len()
  const q = target.index_of("?")
  if q >= 0 && q < cut {
    cut = q
  }
  const h = target.index_of("#")
  if h >= 0 && h < cut {
    cut = h
  }
  const path = unquote(target.substring(0, cut))
  if path.len() == 0 {
    return nil
  }
  return path
}

/** The trailing path component of `p` (after the last `/`). */
pub fn base_name(p: string) -> string {
  const idx = last_index_of(p, "/")
  if idx < 0 {
    return p
  }
  return p.substring(idx + 1, p.len())
}

/** Index of the last occurrence of `needle` in `s`, or -1. */
pub fn last_index_of(s: string, needle: string) -> int {
  let found = -1
  let i = 0
  const n = s.len()
  const m = needle.len()
  while i + m <= n {
    if s.substring(i, i + m) == needle {
      found = i
    }
    i = i + 1
  }
  return found
}

/**
 * File suffix (including the dot) of `link_path`, mirroring
 * `pathlib.Path(link_path).suffix`: the last `.ext` of the final path
 * component, but empty when the dot is the component's first char (a
 * dotfile like `.config`). A bare trailing dot yields ".".
 */
pub fn path_suffix(link_path: string) -> string {
  // Path() normalises a single trailing slash away before taking suffix.
  let p = link_path
  while p.ends_with("/") && p.len() > 1 {
    p = p.substring(0, p.len() - 1)
  }
  const name = base_name(p)
  const dot = last_index_of(name, ".")
  if dot <= 0 {
    return ""
  }
  return name.substring(dot, name.len())
}

/** Drop a single `*.ext` suffix from `p` and append `.md`. */
pub fn with_md_suffix(p: string) -> string {
  const suf = path_suffix(p)
  if suf == "" {
    return p + ".md"
  }
  return p.substring(0, p.len() - suf.len()) + ".md"
}

/** Join two path fragments with a single `/`. */
pub fn join_path(a: string, b: string) -> string {
  if a.ends_with("/") {
    return a + b
  }
  return a + "/" + b
}

/**
 * Repo-relative candidate paths for `link_path` referenced from a doc in
 * `source_dir`, using `docs_dir` as the root for absolute (`/`-leading)
 * links. Strings may contain `.`/`..`; the caller normalises before use.
 * Mirrors `candidate_paths` branch-for-branch.
 */
pub fn candidate_rel_paths(source_dir: string, link_path: string, docs_dir: string) -> list<string> {
  let primary = ""
  if link_path.starts_with("/") {
    let rest = link_path
    while rest.starts_with("/") {
      rest = rest.substring(1, rest.len())
    }
    primary = join_path(docs_dir, rest)
  } else {
    primary = join_path(source_dir, link_path)
  }
  // Path() drops a trailing slash from the primary (so suffix / md /
  // index.md fallbacks operate on the bare component).
  while primary.ends_with("/") && primary.len() > 1 {
    primary = primary.substring(0, primary.len() - 1)
  }
  let candidates = [primary]
  const suf = path_suffix(link_path)
  if suf == ".html" {
    candidates = candidates + [with_md_suffix(primary)]
  } else if suf == "" {
    candidates = candidates + [with_md_suffix(primary)]
    candidates = candidates + [join_path(primary, "index.md")]
  } else if link_path.ends_with("/") {
    candidates = candidates + [join_path(primary, "index.md")]
  }
  return candidates
}

/**
 * Lexically resolve `.` / `..` segments in `path`, clamping at the
 * filesystem root (a leading `/` stays absolute and `..` can never pop
 * past it). Mirrors `Path.resolve(strict=False)` segment collapsing.
 */
pub fn normalize_path(path: string) -> string {
  const absolute = path.starts_with("/")
  let parts: list<string> = []
  for seg in path.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    if seg == ".." {
      if parts.count > 0 && parts[parts.count - 1] != ".." {
        parts = parts.slice(0, parts.count - 1)
      } else if !absolute {
        parts = parts + [".."]
      }
      // For absolute paths, `..` past root is dropped.
      continue
    }
    parts = parts + [seg]
  }
  const joined = parts.join("/")
  if absolute {
    return "/" + joined
  }
  return joined
}

/**
 * True when normalised absolute `abs_path` is `repo_root` or lives beneath
 * it. Mirrors `within_repo` (`Path.relative_to(REPO_ROOT)` succeeding).
 */
pub fn within_repo(repo_root: string, abs_path: string) -> bool {
  return abs_path == repo_root || abs_path.starts_with(repo_root + "/")
}

/**
 * Repo-relative path for a recursive-glob result. Glob yields absolute
 * paths with a `/./` marker between the search root and the matched
 * suffix; the suffix is the repo-relative form.
 */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/** Directory portion of a repo-relative file path (`""` for a bare name). */
pub fn dir_of(rel: string) -> string {
  const idx = last_index_of(rel, "/")
  if idx < 0 {
    return ""
  }
  return rel.substring(0, idx)
}

/**
 * Gather `{target, line}` records for every local-link candidate in the
 * fenced-block-stripped `text`, in source order. `target` is the raw link
 * target; non-local links are skipped here. Pure (no filesystem) so the
 * tests can drive it.
 */
pub fn collect_links(text: string) -> list {
  let out: list = []
  for m in regex_captures(INLINE_LINK_RE, text) {
    out = out + [{target: m.groups[0], start: m.start, line: m.line}]
  }
  for m in regex_captures(REFERENCE_LINK_RE, text, "m") {
    out = out + [{target: m.groups[0], start: m.start, line: m.line}]
  }
  for m in regex_captures(HTML_ATTR_RE, text, "i") {
    let value = m.groups[0]
    if value == nil {
      value = m.groups[1]
    }
    out = out + [{target: value, start: m.start, line: m.line}]
  }
  return sort_by_start(out)
}

/** Stable insertion sort of link records by their `start` offset. */
pub fn sort_by_start(links: list) -> list {
  let out: list = []
  for link in links {
    let lo = 0
    let hi = out.count
    while lo < hi {
      const mid = (lo + hi) / 2
      if out[mid].start <= link.start {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    out = out.slice(0, lo) + [link] + out.slice(lo, out.count)
  }
  return out
}

pipeline main(task) {
  const globbed = harness.fs.glob("${DOCS_DIR}/**/*.md")
  let repo_root = ""
  for g in globbed {
    const idx = g.index_of("/./")
    if idx >= 0 {
      repo_root = g.substring(0, idx)
    }
    break
  }
  let sources: list<string> = []
  for g in globbed {
    sources = sources + [rel_path(g)]
  }
  sources = sources.sort()
  let checked = 0
  let failures: list = []
  for source in sources {
    const text = strip_fenced_blocks(harness.fs.read_text(source))
    const source_dir = dir_of(source)
    for link in collect_links(text) {
      const path = local_path(link.target)
      if path == nil {
        continue
      }
      checked = checked + 1
      const candidates = candidate_rel_paths(source_dir, path, DOCS_DIR)
      let ok = false
      for cand in candidates {
        const abs = normalize_path(join_path(repo_root, cand))
        if within_repo(repo_root, abs) && harness.fs.exists(abs) {
          ok = true
          break
        }
      }
      if ok {
        continue
      }
      const expected_abs = normalize_path(join_path(repo_root, candidates[0]))
      let expected = expected_abs
      if within_repo(repo_root, expected_abs) {
        expected = expected_abs.substring(repo_root.len() + 1, expected_abs.len())
      }
      failures = failures + [{source: source, line: link.line, target: link.target, expected: expected}]
    }
  }
  if failures.count > 0 {
    __io_eprintln("error: dead docs internal link(s):")
    for f in failures {
      __io_eprintln("  ${f.source}:${f.line}: ${f.target} -> missing ${f.expected}")
    }
    return 1
  }
  __io_println("docs links OK: ${checked} local link target(s) checked")
  return 0
}
