// Shared Codex and Claude PreToolUse guard for shell commands.
//
// Two failure modes this exists to stop:
//
//   1. Bare `cargo ...`. The Makefile targets set the environment and private
//      build directory the current worktree needs. A raw `cargo` call silently
//      skips that setup and can contend with another worktree's build output.
//
//   2. Piping a long build or test straight into a filter. `cargo test | grep
//      -c ok` throws the run away: the moment you want a line the filter did
//      not print, the only way to get it is to run the whole thing again.
//      Commands over the slow-command threshold must land their full output in
//      a file first, then be grepped from there.
//
//   3. Raw agent-created Git worktrees. Fleet worktrees must go through the
//      owning admission command so the remote lease, recovery journal, and
//      filesystem projection cannot diverge. The refusal names the branch-only
//      form; an issue or pull request URL is optional.
//
//   4. `git stash` forms that write the stash list, which every linked worktree
//      shares. A pop after another agent's push applies their changes and
//      loses yours; a work-in-progress commit is private to its branch.
//
//   5. Bare `swift build` / `swift test`, and any other build tool whose setup
//      a repository's root Makefile owns. Unlike Cargo these are not universal,
//      so the rule fires only against a target the wrapper measured to exist.
//
// Contract: reads a Codex or Claude PreToolUse payload on stdin, prints a
// permission decision on stdout. Exit status is always 0 — a crashed guard
// must not look like a denial.
import {
  DISPOSABLE_PATH_POLICY,
  MAKE_OWNED_COMMAND_RULES,
  WORKTREE_ADMISSION_POLICY,
  git_program_in_hook_path,
  git_program_is_absolute,
} from "./agent_shell_guard_policy"

// Commands whose full output is worth keeping. Grepping any of these through a
// pipe without a redirect is what forces a rerun.
const SLOW_COMMANDS = ["cargo", "make", "nextest", "swift", "pnpm", "npm", "xcodebuild"]

// `cargo <verb>` calls that have a Makefile owner. Anything not listed here is
// a one-off (`cargo tree`, `cargo add`) and passes through.
const CARGO_VERB_TARGETS = {
  bench: "make bench",
  build: "make build",
  check: "make check",
  clippy: "make lint",
  fmt: "make fmt",
  nextest: "make test",
  test: "make test",
}

pub type ShellGuardDecision = {allow: bool, reason: string}

/**
 * Whether the repository this command runs in owns a Fleet admission command.
 *
 * `available` false with an empty `denial` means the guard looked and the
 * repository genuinely has none, so raw worktree creation is allowed there.
 * A non-empty `denial` means the guard could NOT look, which is not the same
 * answer and must never read as "no admission command": the guard refuses and
 * says the census failed.
 */
pub type WorktreeAdmission = {available: bool, command: string, denial: string}

/**
 * `xargs_child_argv` is absent from runtimes older than the release that added it, and the
 * guard must run on the oldest runtime a consumer pins, so it is optional here.
 */
type ShellCommandStage = {
  text: string,
  argv: list<string>,
  xargs_child_argv?: list<string>,
  writes_to_file: bool,
}

const EMPTY_SHELL_STAGE: ShellCommandStage = {text: "", argv: [], writes_to_file: false}

fn command_groups(command: string) -> list<list<ShellCommandStage>> {
  const scan = command_risk_scan({request: {mode: "shell", command: command}})
  return scan.shell_command_groups ?? []
}

fn stage_program(stage: ShellCommandStage) -> string {
  return argv_program(stage.argv)
}

pub fn program_of(segment: string) -> string {
  const groups = command_groups(segment)
  if len(groups) == 0 || len(groups[0] ?? []) == 0 {
    return ""
  }
  return stage_program((groups[0] ?? [])[0] ?? EMPTY_SHELL_STAGE)
}

/** Split a compound command into independently classified stages. */
pub fn segments_of(command: string) -> list<string> {
  let segments: list<string> = []
  for group in command_groups(command) {
    for stage in group {
      segments = segments + [stage.text]
    }
  }
  return segments
}

const RAW_CARGO_ESCAPE: string = "HARN_ALLOW_RAW_CARGO=1"

pub fn cargo_violation(command: string) -> string {
  for group in command_groups(command) {
    for stage in group {
      if stage_program(stage) != "cargo" {
        continue
      }
      // Per stage, for the same reason the Make-owned rule reads it per stage:
      // the escape used to be a substring of the whole command, so
      // `echo HARN_ALLOW_RAW_CARGO=1; cargo test` released a stage nothing set
      // the variable for.
      if stage_declares_assignment(stage, RAW_CARGO_ESCAPE) {
        continue
      }
      const verb_index = if (stage.argv[1] ?? "").starts_with("+") {
        2
      } else {
        1
      }
      const verb = if len(stage.argv) > verb_index {
        stage.argv[verb_index] ?? ""
      } else {
        ""
      }
      const target = CARGO_VERB_TARGETS[verb] ?? ""
      if target == "" {
        continue
      }
      return "`cargo " + verb + "` bypasses the repository Make target, including "
        + "its worktree-local build directory and required environment. Run `"
        + target
        + "` instead. "
        + "For a genuine one-off, set HARN_ALLOW_RAW_CARGO=1 in the command."
    }
  }
  return ""
}

/**
 * The Make targets the wrapper found in the repository's root Makefile.
 *
 * `checked` false means nobody looked, which is NOT the same as a repository
 * that declares no targets. The distinction decides the opposite way from the
 * worktree rule, and deliberately: refusing `git worktree add` on an unreadable
 * census is safe because the harm it prevents is real wherever it fires, while
 * refusing `swift build` on an unreadable census would send the operator to a
 * Make target that may not exist. An unmeasured repository therefore allows,
 * and the rule is inert rather than wrong.
 */
pub type MakeTargetCensus = {checked: bool, targets: list<string>}

pub const UNMEASURED_MAKE_TARGETS: MakeTargetCensus = {checked: false, targets: []}

pub const MAKE_TARGETS_ENV: string = "HARN_EXT_SHELL_GUARD_MAKE_TARGETS"

pub const MAKE_TARGETS_CHECKED_ENV: string = "HARN_EXT_SHELL_GUARD_MAKE_TARGETS_CHECKED"

/** Parse the whitespace-separated target list the wrapper reports. */
pub fn make_target_census(checked: string, reported: string) -> MakeTargetCensus {
  if checked != "1" {
    return UNMEASURED_MAKE_TARGETS
  }
  let targets: list<string> = []
  for line in reported.split("\n") {
    for word in line.split(" ") {
      const name = word.trim()
      if name != "" && !targets.contains(name) {
        targets = targets + [name]
      }
    }
  }
  return {checked: true, targets: targets}
}

pub fn make_target_census_from_env(env: HarnessEnv) -> MakeTargetCensus {
  return make_target_census(
    to_string(env.get(MAKE_TARGETS_CHECKED_ENV) ?? ""),
    to_string(env.get(MAKE_TARGETS_ENV) ?? ""),
  )
}

/**
 * Options that take a separate value, so the value is not a subcommand.
 *
 * Mirrors the flag tables in `is_git_worktree_add` and `git_directory_argument`
 * on purpose. This one only narrows the over-refusal described below; it is not
 * what makes the classification safe, so an option missing from it is not a
 * bypass.
 */
const VALUE_TAKING_OPTIONS: list<string> = [
  "-C",
  "--package-path",
  "--scratch-path",
  "--build-path",
  "--cache-path",
  "--destination",
  "--toolchain",
  "--configuration",
  "-c",
  "--filter",
  "--jobs",
  "-j",
  "--triple",
  "--sdk",
]

/**
 * Whether a stage runs `<program> <verb>`, fail-closed about option values.
 *
 * The obvious reading — "the first argument that does not begin with `-`" —
 * silently skips an option but not the option's value, so
 * `swift --package-path /tmp test` classifies as the verb `/tmp` and no rule
 * matches. Any option with a value bypasses the rule that way, whatever the
 * option is called, so an arity table alone cannot close it: an option the
 * table has never heard of is skipped as a bare flag and its value becomes the
 * verb again.
 *
 * This asks a different question. The verb is present when it appears as ANY
 * argument that is neither an option nor a known option's value. An option the
 * table does not know leaves its value in the candidate set, where a value that
 * happens to be the verb refuses rather than allows.
 *
 * The cost is a narrow over-refusal: a command that passes the literal string
 * `test` or `build` as the value of an option this table does not list is
 * refused and told to run the Make target. That direction is deliberate. The
 * escape hatch exists for the case the rule gets wrong, and there is no escape
 * from a rule that silently did not fire.
 */
fn stage_runs_verb(argv: list<string>, verb: string) -> bool {
  let consumes_next = false
  for token in argv.slice(1, len(argv)) {
    if consumes_next {
      consumes_next = false
      continue
    }
    if VALUE_TAKING_OPTIONS.contains(token) {
      consumes_next = true
      continue
    }
    if token.starts_with("-") {
      continue
    }
    if token == verb {
      return true
    }
  }
  return false
}

/**
 * Whether this stage itself sets `assignment` in the environment it runs with.
 *
 * The escape used to be honoured with a substring search over the whole command
 * text, so `echo HARN_ALLOW_RAW_SWIFT=1; swift test` released the `swift` stage
 * although nothing set the variable for it. An escape is only an escape where
 * it actually applies, which is the stage that runs the guarded program.
 *
 * `command_risk_scan` strips a leading assignment prefix and an `env` wrapper
 * out of `argv` but keeps both in `text`, so the prefix is read back from the
 * stage's own text and stops at the first word that is neither an assignment
 * nor `env`.
 */
fn stage_declares_assignment(stage: ShellCommandStage, assignment: string) -> bool {
  for token in stage.text.split(" ") {
    if token == "" {
      continue
    }
    if token == assignment {
      return true
    }
    if token == "env" || token.contains("=") {
      continue
    }
    return false
  }
  return false
}

/**
 * Refuse a build command whose Make target this repository is measured to own.
 *
 * Nothing fires without a measurement: an unmeasured census, or one that does
 * not list the target, allows. That is the whole point of the rule — a
 * repository that has no `swift-test` target must never be told to run one.
 */
pub fn make_owned_command_violation(command: string, census: MakeTargetCensus) -> string {
  if !census.checked {
    return ""
  }
  for group in command_groups(command) {
    for stage in group {
      const argv = launched_argv(stage.argv, 0)
      const program = argv_program(argv)
      for rule in MAKE_OWNED_COMMAND_RULES {
        if program != rule.program || !stage_runs_verb(argv, rule.verb) {
          continue
        }
        if !census.targets.contains(rule.target) {
          continue
        }
        if stage_declares_assignment(stage, rule.escape) {
          continue
        }
        return "`" + rule.program + " " + rule.verb + "` bypasses the repository Make target, "
          + "including the build limit and environment it sets. Run `make "
          + rule.target
          + "` instead, passing a focused selection with ARGS=... . "
          + "For a genuine one-off, set "
          + rule.escape
          + " in the command."
      }
    }
  }
  return ""
}

/** Git's global options that take a separate value, so the value is not the subcommand. */
const GIT_VALUE_TAKING_OPTIONS: list<string> = [
  "-C",
  "-c",
  "--git-dir",
  "--work-tree",
  "--namespace",
  "--super-prefix",
  "--config-env",
  "--exec-path",
]

/** The stash subcommands that only read the list. Every other form writes it. */
const GIT_STASH_READ_ONLY: list<string> = ["list", "show"]

/**
 * The git subcommand and every token after it, verbatim. Only the global
 * options before the subcommand are skipped: after it, an option value such as
 * a stash message must stay in place, or it would read as a verb.
 */
fn git_args_after_options(args: list<string>) -> list<string> {
  let consumes_next = false
  let index = 0
  for token in args {
    if consumes_next {
      consumes_next = false
    } else if GIT_VALUE_TAKING_OPTIONS.contains(token) {
      consumes_next = true
    } else if !token.starts_with("-") {
      return args.slice(index, len(args))
    }
    index = index + 1
  }
  return []
}

fn git_subcommand_args(argv: list<string>) -> list<string> {
  return git_args_after_options(argv.slice(1, len(argv)))
}

fn is_git_worktree_add(argv: list<string>) -> bool {
  const args = git_subcommand_args(argv)
  if (args[0] ?? "") != "worktree" {
    return false
  }
  return (git_args_after_options(args.slice(1, len(args)))[0] ?? "") == "add"
}

/**
 * The directory a `git -C <path> ...` invocation runs in, or "" when none is given.
 *
 * Mirrors the flag table in `is_git_worktree_add` on purpose: the two walk the
 * same argv and have to agree about which flags consume a value, or this one
 * would read a flag's argument as a directory. Git accumulates repeated `-C`
 * relative to each other; the last one is taken here, which is the same answer
 * whenever it is absolute and the only case this is consulted for.
 */
fn git_directory_argument(argv: list<string>) -> string {
  let consumes_next = false
  let pending_directory = false
  let directory = ""
  for token in argv.slice(1, len(argv)) {
    if pending_directory {
      directory = token
      pending_directory = false
      continue
    }
    if consumes_next {
      consumes_next = false
      continue
    }
    if token == "-C" {
      pending_directory = true
      continue
    }
    if [
      "-c",
      "--git-dir",
      "--work-tree",
      "--namespace",
      "--super-prefix",
      "--config-env",
      "--exec-path",
    ]
      .contains(token) {
      consumes_next = true
      continue
    }
  }
  return directory
}

fn argv_program(argv: list<string>) -> string {
  if len(argv) == 0 {
    return ""
  }
  // Keep only the basename so `./target/release/harn` and `/usr/bin/make`
  // classify the same as their bare names.
  const parts = to_string(argv[0] ?? "").split("/")
  return parts[len(parts) - 1] ?? ""
}

/** Unwrap standard process launchers so policy follows the executed command. */
fn launched_argv(argv: list<string>, depth: int) -> list<string> {
  if depth >= 4 || len(argv) == 0 {
    return argv
  }
  const program = argv_program(argv)
  if program == "env" {
    let consumes_next = false
    for index in range(1, len(argv)) {
      const token = to_string(argv[index] ?? "")
      if consumes_next {
        consumes_next = false
        continue
      }
      if ["-u", "--unset", "-C", "--chdir", "-S", "--split-string"].contains(token) {
        consumes_next = true
        continue
      }
      if token.starts_with("-") || token.contains("=") {
        continue
      }
      return launched_argv(argv.slice(index, len(argv)), depth + 1)
    }
  }
  if ["command", "exec", "nohup"].contains(program) {
    for index in range(1, len(argv)) {
      const token = to_string(argv[index] ?? "")
      if token.starts_with("-") {
        continue
      }
      return launched_argv(argv.slice(index, len(argv)), depth + 1)
    }
  }
  return argv
}

fn nested_shell_payload(argv: list<string>) -> string {
  // `eval` runs its operands as a command line, the same as a `-c` payload.
  if argv_program(argv) == "eval" {
    return argv.slice(1, len(argv)).join(" ")
  }
  if !["bash", "dash", "sh", "zsh"].contains(argv_program(argv)) {
    return ""
  }
  let takes_payload = false
  for token in argv.slice(1, len(argv)) {
    if takes_payload {
      return token
    }
    const short_command_flag = token.starts_with("-")
      && !token.starts_with("--")
      && token.contains("c")
    if token == "--command" || short_command_flag {
      takes_payload = true
    }
  }
  return ""
}

/**
 * The worktree-creation attempt in a command, with the directory it targets.
 *
 * `reason` is empty when there is no attempt. `target` is the `-C` directory
 * of the same invocation, so the caller can ask about the repository the
 * command actually points at rather than the one this guard happens to be
 * installed in.
 */
/**
 * A raw creation, and every directory it could be running in.
 *
 * `targets` is a list because a `cd` the shell may skip leaves the directory
 * AMBIGUOUS, and the guard must not pick one. `true || cd /elsewhere` never
 * runs its right side, so the command runs where it started; a guard that
 * remembered the skipped `cd` answered for a repository the command never
 * reached, and two words disarmed the rule. Every reachable directory is
 * carried and the caller denies if any of them denies.
 */
type WorktreeAddAttempt = {reason: string, targets: list<string>}

const NO_WORKTREE_ADD: WorktreeAddAttempt = {reason: "", targets: []}

/**
 * The shell operator joining each stage to the one before it, read off the
 * raw text.
 *
 * `command_risk_scan` groups by PIPELINE, so `&&`, `||` and `;` all produce
 * separate groups and are indistinguishable in its output. The operators are
 * exactly what decides whether a `cd` runs, so they are read here from the
 * command itself, anchored on each stage's own text and scanned forward only.
 *
 * The first stage has no operator and answers "". A stage whose text cannot be
 * located answers "?", which every caller treats as the ambiguous case rather
 * than as a missing operator.
 */
fn stage_operators(command: string, texts: list<string>) -> list<string> {
  let operators: list<string> = []
  let rest = command
  let first = true
  for text in texts {
    if text == "" {
      operators = operators + ["?"]
      continue
    }
    const at = rest.index_of(text)
    if at < 0 {
      operators = operators + ["?"]
      continue
    }
    const between = rest.slice(0, at)
    if first {
      operators = operators + [""]
      first = false
    } else if between.contains("&&") {
      operators = operators + ["&&"]
    } else if between.contains("||") {
      operators = operators + ["||"]
    } else if between.contains(";") || between.contains("\n") {
      operators = operators + [";"]
    } else {
      operators = operators + ["?"]
    }
    rest = rest.slice(at + len(text), len(rest))
  }
  return operators
}

/**
 * The operands a `cd` carries, with its option words removed.
 *
 * The count matters as much as the first value: `cd` accepts exactly one
 * operand, so two is a `cd` that fails rather than a `cd` with a spare word.
 */
fn cd_operands(argv: list<string>) -> list<string> {
  if argv_program(argv) != "cd" {
    return []
  }
  // OPTIONS ARE NOT THE DESTINATION. `cd` takes option words, and reading the
  // first one as the directory answers "no absolute target", which leaves the
  // working directory empty and the raw command ALLOWED in a repository that
  // advertises an admission command. `-P` is what a script writes when it
  // wants the physical path, so this is an ordinary spelling rather than an
  // exotic one.
  //
  // `--` ends option processing rather than being skipped like an option: a
  // directory literally named `-P` is reachable as `cd -- -P`, and treating
  // the token after `--` as another option would lose it.
  //
  // A bare `-` is an operand, not an option. It means the previous directory,
  // which this guard has no way to resolve, so it falls through to the
  // not-absolute answer below rather than being stepped over in search of a
  // later token that was never the destination.
  //
  // EVERY operand is collected, not only the first. `cd` takes exactly one,
  // so a second one is not extra information to ignore: it makes the `cd`
  // FAIL, and a failing `cd` leaves the rest of the list running where it
  // started. A reader that stops at the first operand reports a move that
  // never happens.
  let options_ended = false
  let operands: list<string> = []
  for token in argv.slice(1, len(argv)) {
    if !options_ended && token == "--" {
      options_ended = true
      continue
    }
    if !options_ended && token != "-" && token.starts_with("-") {
      continue
    }
    operands = operands + [token]
  }
  return operands
}

/**
 * The directory an absolute `cd` moves the rest of the command into.
 *
 * A relative one answers "", for the same reason `git_directory_argument` is
 * only consulted when absolute: the hook payload carries no working directory
 * to resolve it against, and inventing one would be the error this rule
 * exists to prevent.
 */
fn cd_target(argv: list<string>) -> string {
  const target = cd_operands(argv)[0] ?? ""
  if target.starts_with("/") {
    return target
  }
  return ""
}

/**
 * NO DEFAULT PARAMETER VALUE HERE, and the empty string at the two outer call
 * sites is the whole reason.
 *
 * A default value compiles to an `__assert_schema` call at the call site, and
 * this guard runs under an allow list naming only its two policy builtins. A
 * runtime that does not exempt that builtin from the list refuses it, the guard
 * faults before it reaches a verdict, and every command it is asked about gets
 * the same generic "policy faulted" refusal instead of the answer. Worse, the
 * guard's sources are rendered onto consumers pinned to the previous release,
 * so the floor a construct has to clear is the OLDEST runtime any consumer
 * pins, not this branch's.
 */
fn raw_worktree_add_attempt_at(
  command: string,
  depth: int,
  inherited_directory: string,
) -> WorktreeAddAttempt {
  // A `cd` names the repository as plainly as `-C` does, and unlike `-C` it
  // holds for every stage after it rather than for one invocation. So it is
  // carried across groups in command order, and `-C` still wins on the
  // invocation that names one.
  //
  // It also holds across a shell launched after it. A nested payload scanned
  // from a fresh directory is judged against the repository this guard is
  // installed in, so the directory travels into the recursion as well.
  // A `cd` is only carried forward when the shell is certain to run it and
  // certain that its failure is not being swallowed. Otherwise BOTH the
  // directory before it and its target stay reachable, and the rule is
  // answered for each.
  const groups = command_groups(command)
  let texts: list<string> = []
  for group in groups {
    for stage in group {
      texts = texts + [stage.text]
    }
  }
  const operators = stage_operators(command, texts)
  // THREE CLAUSES, ALL REQUIRED, and each one closed a hole review found.
  //
  // A `cd` narrows the set of directories a later command could be running in
  // only when all of these hold:
  //
  //   (a) the `cd` carries exactly one operand and is not inside a pipeline.
  //       Two operands make `cd` FAIL, and a pipeline stage is a subshell
  //       whose directory never reaches what follows.
  //   (b) the `cd` is itself reached unconditionally: it is at the start of
  //       the list, or only `&&` stands before it.
  //   (c) every operator between the `cd` and the command is `&&`. This is
  //       not a guess about the shell: `&&` runs the next element only when
  //       every element before it succeeded, so reaching the command through
  //       an unbroken `&&` chain proves the `cd` succeeded.
  //
  // Any `||` or `;` between the `cd` and the command, or before the `cd`,
  // and the reachable set is the union of the directory before the `cd` and
  // its target, with the first refusal winning. `cd X; cmd` unions because
  // `;` runs `cmd` whether or not the `cd` succeeded.
  let reachable: list<string> = [inherited_directory]
  // (b): every operator seen so far has been "" or `&&`.
  let reached_unconditionally = true
  // (c): a narrowing is live until a non-`&&` operator breaks the chain.
  let narrowed = false
  let before_narrow: list<string> = []
  let narrow_target = ""
  let index = 0
  for group in groups {
    for stage in group {
      const before = to_string(operators[index] ?? "?")
      if before != "" && before != "&&" {
        reached_unconditionally = false
        if narrowed {
          // (c) broken: the command after this operator can be reached
          // without the `cd` having taken effect, so both are live again.
          reachable = before_narrow
          if !reachable.contains(narrow_target) {
            reachable = reachable + [narrow_target]
          }
          narrowed = false
        }
      }
      const argv = launched_argv(stage.argv, 0)
      const moved = cd_target(argv)
      if moved != "" {
        // (a)
        const single_operand = len(cd_operands(argv)) == 1
        const in_pipeline = len(group) > 1
        if single_operand && !in_pipeline && reached_unconditionally {
          before_narrow = reachable
          narrow_target = moved
          reachable = [moved]
          narrowed = true
        } else {
          narrowed = false
          if !reachable.contains(moved) {
            reachable = reachable + [moved]
          }
        }
      }
      if argv_program(argv) == "git" && is_git_worktree_add(argv) {
        const named = git_directory_argument(argv)
        // `-C` names the directory for this one invocation whatever the shell
        // did, so it is the single answer rather than one candidate.
        let targets = reachable
        if named != "" {
          targets = [named]
        }
        return {
          reason: "Raw `git worktree add` bypasses Fleet admission and can create an unowned worktree. "
            + "Run the owning `fleet-worktree-admit` command instead; it acquires the remote lease "
            + "and journals its recovery receipts before returning success.",
          targets: targets,
        }
      }
      if depth < 4 {
        const nested = nested_shell_payload(argv)
        if nested != "" {
          // EVERY CANDIDATE, NOT THE FIRST THAT MATCHES. The nested shell
          // inherits every directory this one could be in, and the scan used
          // to return as soon as one of them produced a match. The candidate
          // that ends the loop early is whichever comes first, and a
          // directory that ALLOWS is exactly the one that then hid every
          // other reachable directory that would have refused.
          //
          // So the candidates are scanned to the end and their targets are
          // unioned. The caller refuses if any one of them refuses, which is
          // the same rule the unnested path already followed.
          let nested_reason = ""
          let nested_targets: list<string> = []
          for candidate in reachable {
            const attempt = raw_worktree_add_attempt_at(nested, depth + 1, candidate)
            if attempt.reason != "" {
              nested_reason = attempt.reason
              for found in attempt.targets {
                if !nested_targets.contains(found) {
                  nested_targets = nested_targets + [found]
                }
              }
            }
          }
          if nested_reason != "" {
            return {reason: nested_reason, targets: nested_targets}
          }
        }
      }
      index = index + 1
    }
  }
  return NO_WORKTREE_ADD
}

/** Reject only Git's worktree-creation subcommand, including shell wrappers. */
pub fn raw_worktree_add_violation(command: string) -> string {
  return raw_worktree_add_attempt_at(command, 0, "").reason
}

/** The same walk, keeping the directory the attempt targets. */
pub fn raw_worktree_add_attempt(command: string) -> WorktreeAddAttempt {
  return raw_worktree_add_attempt_at(command, 0, "")
}

/** True only for a path rooted in an OS-temp or known generated-output tree. */
pub fn is_disposable_path(token: string) -> bool {
  // Forward slashes are accepted by Windows shells and let every platform use
  // one component-aware matcher. Single-quoted Windows paths retain their
  // backslashes through shell tokenization and normalize here.
  const path = token.trim().replace("\\", "/")
  for root in DISPOSABLE_PATH_POLICY.posix_temp_roots {
    if path == root || path.starts_with(root + "/") {
      return true
    }
  }
  for variable in DISPOSABLE_PATH_POLICY.posix_temp_variables {
    if path == variable || path.starts_with(variable + "/") {
      return true
    }
  }
  const folded_path = lowercase(path)
  for variable in DISPOSABLE_PATH_POLICY.windows_temp_variables {
    const folded_variable = lowercase(variable)
    if folded_path == folded_variable || folded_path.starts_with(folded_variable + "/") {
      return true
    }
  }
  for marker in DISPOSABLE_PATH_POLICY.windows_temp_markers {
    if folded_path.ends_with(marker) || folded_path.contains(marker + "/") {
      return true
    }
  }
  for prefix in DISPOSABLE_PATH_POLICY.macos_temp_prefixes {
    const component = DISPOSABLE_PATH_POLICY.macos_temp_component
    if path.starts_with(prefix)
      && (path.ends_with(component) || path.contains(component + "/")) {
      return true
    }
  }
  for root in DISPOSABLE_PATH_POLICY.generated_relative_roots {
    if path == root
      || path == "./" + root
      || path.starts_with(root + "/")
      || path.starts_with("./" + root + "/")
      || path.ends_with("/" + root)
      || path.contains("/" + root + "/") {
      return true
    }
  }
  return false
}

/** Reject Trash as a cleanup backend only when an argv path is disposable. */
pub fn disposable_trash_violation(command: string) -> string {
  for group in command_groups(command) {
    for stage in group {
      const program = stage_program(stage)
      if program != "trash" && program != "trash-put" {
        continue
      }
      for token in stage.argv.slice(1, len(stage.argv)) {
        if token == "--" || token.starts_with("-") {
          continue
        }
        if is_disposable_path(token) {
          return "`" + program
            + "` would move disposable generated data into the user's visible Trash. "
            + "Keep rebuildable caches in place unless invalidation is required. For temporary output, "
            + "use an OS temporary directory and an exact, validated permanent cleanup accepted by the host. "
            + "If permanent cleanup is refused, leave the artifact in its temporary/build root and report it; "
            + "reserve Trash for user-authored or uncertain data."
        }
      }
    }
  }
  return ""
}

/**
 * The aliases git's effective configuration defines, from the output of
 * `git config --get-regexp '^alias\.'` (one `alias.NAME EXPANSION` per line).
 * Repository, user and system files and `GIT_CONFIG_*` variables all land
 * there, which the command text alone never shows.
 */
pub fn git_config_aliases(listing: string) -> dict {
  let aliases = {}
  for line in listing.split("\n") {
    if !line.starts_with("alias.") {
      continue
    }
    const body = line.substring(len("alias."), len(line))
    const space = body.index_of(" ")
    if space > 0 {
      aliases[body.substring(0, space)] = body.substring(space + 1, len(body)).trim()
    }
  }
  return aliases
}

/** Only the installed Git can establish which command names cannot be aliases. */
fn git_program_is_trusted(env: HarnessEnv, system: HarnessSystem, program: string) -> bool {
  return git_program_in_hook_path(
    env.get("PATH") ?? "",
    program,
    system.platform().os == "windows" ? ";" : ":",
  )
}

pub fn git_builtin_commands(
  process: HarnessProcess,
  env: HarnessEnv,
  system: HarnessSystem,
  program: string,
) -> list<string> {
  if !git_program_is_trusted(env, system, program) {
    return []
  }
  const listed = process.run({program: program, args: ["--list-cmds=builtins"]})
  if listed.exit_code != 0 {
    return []
  }
  return listed.stdout.trim().split("\n").map({ line -> line.trim() }).to_list()
}

/**
 * Shell builtins and wrappers that change the environment, directory or shell state for what follows.
 */
const ENVIRONMENT_CHANGING_WORDS: list<string> = [
  "env",
  "unset",
  "export",
  "cd",
  "pushd",
  "popd",
  "source",
  "eval",
  "exec",
  "declare",
  "typeset",
  "readonly",
  "set",
  ".",
]

const VARIABLE_NAME_CHARACTERS: string =
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

/**
 * Whether anything in the command line could change git's environment, working directory or
 * configuration sources before git runs: a `NAME=` assignment, `env`, `unset`, `export`, `cd` and
 * the other builtins that change the shell's state, a subshell, or command substitution. The alias
 * lookup runs in the hook's own environment, so a command like this runs git under a configuration
 * the lookup cannot read. The rule is structural, not a list of variable names.
 */
fn command_may_change_git_environment(command: string) -> bool {
  if command.contains("(") || command.contains("`") {
    return true
  }
  for group in command_groups(command) {
    for stage in group {
      const child = stage.xargs_child_argv ?? []
      const args = launched_argv(len(child) > 0 ? child : stage.argv, 0)
      if argv_program(args) == "git" && (git_subcommand_args(args)[0] ?? "") == "config" {
        return true
      }
      const nested = nested_shell_payload(args)
      if nested != "" && command_may_change_git_environment(nested) {
        return true
      }
    }
  }
  let spaced = command
  for separator in ["\"", "'", ";", "&", "|", ")", "{", "}", "\n", "\t"] {
    spaced = spaced.replace(separator, " ")
  }
  for word in spaced.split(" ") {
    if word == "" {
      continue
    }
    if ENVIRONMENT_CHANGING_WORDS.contains(word) || is_variable_assignment(word) {
      return true
    }
  }
  return false
}

type GitExecutableContext = {path_changed: bool, cwd_changed: bool}

type GitExecutionStage = {argv: list<string>, source_argv?: list<string>}

/** The older scanner can omit standalone assignments, including inside shell control flow. */
fn unprojected_path_assignment(command: string) -> bool {
  let single = false
  let double = false
  let index = 0
  while index < len(command) {
    const char = command.substring(index, index + 1)
    if char == "\\" && !single {
      // Escaping can construct a variable name outside the scanner's projection.
      return true
    }
    if char == "'" && !double {
      single = !single
    } else if char == "\"" && !single {
      double = !double
    } else if !single && !double && command.substring(index, index + 4) == "PATH" {
      const previous = index == 0 ? "" : command.substring(index - 1, index)
      const next = command.substring(index + 4, index + 6)
      if (previous == "" || !VARIABLE_NAME_CHARACTERS.contains(previous))
        && (next.starts_with("=") || next == "+=") {
        return true
      }
    }
    index = index + 1
  }
  return single || double
}

/** Older scanners expose source stages in their complete shell command groups. */
fn legacy_git_source_groups(command: string, scan: dict) -> list<list<GitExecutionStage>>? {
  if scan.shell_io_complete != true {
    const substitutions = substitution_bodies(command, true)
    if !substitutions.ok || len(substitutions.bodies) == 0 {
      return nil
    }
  }
  const groups: list<list<ShellCommandStage>>? = scan.shell_command_groups
  if groups == nil || len(groups) == 0 {
    return nil
  }
  let projected: list<list<GitExecutionStage>> = []
  for group in groups {
    let stages: list<GitExecutionStage> = []
    for stage in group {
      stages = stages + [{argv: stage.argv, source_argv: stage.argv}]
    }
    projected = projected + [stages]
  }
  return projected
}

fn git_executable_context(command: string) -> GitExecutableContext {
  const scan = command_risk_scan({request: {mode: "shell", command: command}})
  const source_groups: list<list<GitExecutionStage>>? = scan.shell_source_groups
    ?? legacy_git_source_groups(command, scan)
  if scan.execution_semantics?.resolved != true {
    return {path_changed: true, cwd_changed: true}
  }
  if source_groups == nil {
    return {path_changed: true, cwd_changed: true}
  }
  // Older scanners omit assignment-only commands from both stage inventories.
  if scan.shell_source_groups == nil && unprojected_path_assignment(command) {
    return {path_changed: true, cwd_changed: true}
  }
  let stages: list<GitExecutionStage> = scan.execution_stages ?? []
  for group in source_groups {
    stages = stages + group
  }
  let path_changed = false
  let cwd_changed = false
  for stage in stages {
    const source = stage.source_argv
    if source == nil {
      return {path_changed: true, cwd_changed: true}
    }
    const prefix_length = len(source) > len(stage.argv) ? len(source) - len(stage.argv) : 0
    const prefix = source.slice(0, prefix_length)
    if prefix.any(
      { word ->
        word == "PATH" || word.starts_with("PATH=")
          || word.starts_with("PATH+=")
          || ["-i", "--ignore-environment", "--unset=PATH", "sudo", "doas"].contains(word)
      },
    ) {
      path_changed = true
    }
    const program = argv_program(stage.argv)
    if ["cd", "pushd", "popd"].contains(program) {
      cwd_changed = true
    }
    if ["source", ".", "alias", "function", "eval"].contains(program)
      || (ENVIRONMENT_CHANGING_WORDS.contains(program)
        && stage.argv.slice(1, len(stage.argv)).any(
          { word ->
            word == "PATH" || word.starts_with("PATH=") || word.starts_with("PATH+=")
              || word.contains("$")
              || word.contains("`")
          },
        )) {
      path_changed = true
    }
  }
  return {path_changed: path_changed, cwd_changed: cwd_changed}
}

/** Whether a word is a `NAME=value` (or `NAME+=value`) assignment. */
fn is_variable_assignment(word: string) -> bool {
  const equals = word.index_of("=")
  if equals <= 0 {
    return false
  }
  let name = word.substring(0, equals)
  if name.ends_with("+") {
    name = name.substring(0, len(name) - 1)
  }
  if name == "" || "0123456789".contains(name.substring(0, 1)) {
    return false
  }
  for index in range(0, len(name)) {
    if !VARIABLE_NAME_CHARACTERS.contains(name.substring(index, index + 1)) {
      return false
    }
  }
  return true
}

/** Key a lookup returns when git could not read the configuration the command selects. */
pub const GIT_ALIASES_UNREADABLE: string = "<unreadable>"

/** The lookup for callers that read no configuration. */
pub type GitAliasContext = {program: string, options: list<string>}

pub const NO_CONFIG_ALIASES: fn(GitAliasContext) -> dict = { context -> {} }

pub const NO_GIT_BUILTINS: fn(string) -> list<string> = { program -> [] }

/**
 * Aliases git defines for the configuration that `options` (a command's own
 * global options such as `-C dir` or `--git-dir=...`) select. A listing git
 * cannot produce is unreadable, so the caller refuses rather than guesses.
 */
pub fn git_config_aliases_for(
  process: HarnessProcess,
  env: HarnessEnv,
  system: HarnessSystem,
  context: GitAliasContext,
) -> dict {
  if !git_program_is_trusted(env, system, context.program) {
    return {"<unreadable>": ""}
  }
  const listed = process.run(
    {program: context.program, args: context.options + ["config", "--get-regexp", "^alias\\."]},
  )
  if listed.exit_code == 0 {
    return git_config_aliases(listed.stdout)
  }
  if listed.exit_code == 1 {
    return {}
  }
  return {"<unreadable>": ""}
}

/** Marks an inline alias whose value git reads from the environment, which the guard cannot see. */
const GIT_ALIAS_UNRESOLVED: string = "<unresolved>"

/**
 * The aliases a command defines before its subcommand with `git -c alias.NAME=VALUE`.
 * `--config-env=alias.NAME=VAR` reads its value from the environment, so it is refused.
 */
fn git_inline_aliases(argv: list<string>) -> dict {
  let aliases = {}
  let pending = ""
  for token in argv.slice(1, len(argv)) {
    if pending != "" {
      const parts = token.split("=")
      const head = parts[0] ?? ""
      if head.starts_with("alias.") && len(parts) > 1 {
        const name = head.replace("alias.", "")
        aliases[name] = if pending == "-c" {
          parts.slice(1, len(parts)).join("=")
        } else {
          GIT_ALIAS_UNRESOLVED
        }
      }
      pending = ""
    } else if token == "-c" || token == "--config-env" {
      pending = token
    } else if token.starts_with("--config-env=") {
      const head = token.replace("--config-env=", "").split("=")[0] ?? ""
      if head.starts_with("alias.") {
        aliases[head.replace("alias.", "")] = GIT_ALIAS_UNRESOLVED
      }
    } else if GIT_VALUE_TAKING_OPTIONS.contains(token) {
      pending = "skip"
    } else if !token.starts_with("-") {
      break
    }
  }
  return aliases
}

/**
 * Whether a git invocation writes the stash list, directly or through an inline alias.
 * Git reads the verb only from the token right after `stash`; an option there
 * (`-u`, `-m list`) means push. Anything but a read-only verb writes.
 */
fn git_args_write_stash(
  argv: list<string>,
  args: list<string>,
  depth: int,
  alias_lookup: fn(GitAliasContext) -> dict,
  builtin_lookup: fn(string) -> list<string>,
) -> bool {
  const verb = args[0] ?? ""
  if verb == "" {
    return false
  }
  if verb == "stash" {
    return !GIT_STASH_READ_ONLY.contains(args[1] ?? "")
  }
  if builtin_lookup(argv[0] ?? "git").contains(verb) {
    return false
  }
  let expansion = git_inline_aliases(argv)[verb] ?? ""
  if expansion == "" {
    // The configuration that applies is the one the command's own global options select.
    const configured = alias_lookup(
      {
        program: argv[0] ?? "git",
        options: argv.slice(1, len(argv) - len(git_subcommand_args(argv))),
      },
    )
    if configured.has(GIT_ALIASES_UNREADABLE) {
      return true
    }
    expansion = configured[verb] ?? ""
  }
  if expansion == "" || depth >= 4 {
    return false
  }
  if expansion == GIT_ALIAS_UNRESOLVED {
    return true
  }
  if expansion.starts_with("!") {
    return git_stash_write_in(
      expansion.replace("!", "") + " " + args.slice(1, len(args)).join(" "),
      depth + 1,
      alias_lookup,
      builtin_lookup,
    )
  }
  const words = expansion.split(" ").filter({ word -> word != "" })
  const expanded = ["git"] + words + args.slice(1, len(args))
  return git_args_write_stash(
    argv,
    git_subcommand_args(expanded),
    depth + 1,
    alias_lookup,
    builtin_lookup,
  )
}

/**
 * Whether raw operand text names a `stash` that is not provably read-only. The text is cut into
 * words at whitespace, quotes, `;` and brackets, so a payload inside `sh -c`, `python -c`,
 * `perl -e` or `eval` is read without parsing any interpreter. Every `stash` word must be followed
 * by `list` or `show`; a bare `stash`, any other verb, and a word that merely contains `stash`
 * (`alias.s=stash`) all count as a write.
 */
fn operand_text_writes_stash(text: string) -> bool {
  let spaced = text
  for separator in ["\"", "'", "`", ";", "(", ")", "|", "&", "\n", "\t"] {
    spaced = spaced.replace(separator, " ")
  }
  const words = spaced.split(" ").filter({ word -> word != "" })
  for index in range(0, len(words)) {
    const word = words[index] ?? ""
    if word.starts_with("stash@") || !word.contains("stash") {
      continue
    }
    if word != "stash" || !GIT_STASH_READ_ONLY.contains(words[index + 1] ?? "") {
      return true
    }
  }
  return false
}

/**
 * Fails closed for an `xargs` stage whose launched command the scanner could not place, such as
 * `xargs -a input git stash drop` (`-a` is outside the scanner's option boundary), or any `xargs`
 * under a runtime that predates `xargs_child_argv`. A `git` operand gets the precise stash rule,
 * which also resolves inline aliases; every other operand is judged by its raw text. The accepted
 * cost is that an unresolved `xargs` whose operands mention a non-read-only `stash`, even as
 * `xargs -a f grep stash`, is refused.
 */
fn xargs_operands_write_stash(
  argv: list<string>,
  alias_lookup: fn(GitAliasContext) -> dict,
  builtin_lookup: fn(string) -> list<string>,
) -> bool {
  if argv_program(argv) != "xargs" {
    return false
  }
  for index in range(1, len(argv)) {
    const launched = argv.slice(index, len(argv))
    if argv_program(launched) == "git"
      && git_args_write_stash(
        launched,
        git_subcommand_args(launched),
        0,
        alias_lookup,
        builtin_lookup,
      ) {
      return true
    }
  }
  return operand_text_writes_stash(argv.slice(1, len(argv)).join(" "))
}

/**
 * The index of the `)` that closes a `(` already consumed before `start`, or -1 when the text ends
 * first. Parentheses inside quotes or after a backslash do not count.
 */
fn closing_paren(text: string, start: int) -> int {
  let depth = 1
  let in_single = false
  let in_double = false
  let index = start
  while index < len(text) {
    const char = text.substring(index, index + 1)
    if in_single {
      in_single = char != "'"
    } else if char == "\\" {
      index = index + 1
    } else if in_double {
      in_double = char != "\""
    } else if char == "'" {
      in_single = true
    } else if char == "\"" {
      in_double = true
    } else if char == "(" {
      depth = depth + 1
    } else if char == ")" {
      depth = depth - 1
      if depth == 0 {
        return index
      }
    }
    index = index + 1
  }
  return -1
}

/**
 * The index of the backtick that closes one opened before `start`, or -1. A backslash escapes the next character.
 */
fn closing_backtick(text: string, start: int) -> int {
  let index = start
  while index < len(text) {
    const char = text.substring(index, index + 1)
    if char == "\\" {
      index = index + 1
    } else if char == "`" {
      return index
    }
    index = index + 1
  }
  return -1
}

/**
 * The bodies of `$(...)`, backtick and process-substitution (`<(...)`, `>(...)`) forms the shell
 * would run, outermost only (a body is scanned again when it is analyzed). Single quotes make text
 * literal; double quotes still expand `$(...)` and backticks but not `<(`/`>(`. `ok` is false when a
 * body never closes, which the caller refuses rather than guesses at.
 */
fn substitution_bodies(command: string, quotes_literal: bool) -> dict {
  let bodies: list<string> = []
  let in_single = false
  let in_double = false
  let index = 0
  while index < len(command) {
    const char = command.substring(index, index + 1)
    const next = command.substring(index + 1, index + 2)
    if in_single {
      in_single = char != "'"
    } else if char == "\\" {
      index = index + 1
    } else if char == "'" && !in_double && quotes_literal {
      in_single = true
    } else if char == "\"" {
      in_double = !in_double
    } else if char == "`" {
      const end = closing_backtick(command, index + 1)
      if end < 0 {
        return {ok: false, bodies: bodies}
      }
      bodies = bodies + [command.substring(index + 1, end)]
      index = end
    } else if (char == "$" || (!in_double && (char == "<" || char == ">"))) && next == "(" {
      // `$((` is arithmetic: its text is scanned in place, so a substitution inside it is found.
      if command.substring(index + 2, index + 3) != "(" || char != "$" {
        const end = closing_paren(command, index + 2)
        if end < 0 {
          return {ok: false, bodies: bodies}
        }
        bodies = bodies + [command.substring(index + 2, end)]
        index = end
      }
    }
    index = index + 1
  }
  return {ok: true, bodies: bodies}
}

/** The shared shell scanner does not yet expose every expansion in an unquoted heredoc. */
fn has_expanding_heredoc(command: string) -> bool {
  let index = command.index_of("<<")
  while index >= 0 {
    let after = index + 2
    if command.substring(after, after + 1) != "<" {
      if command.substring(after, after + 1) == "-" {
        after = after + 1
      }
      while command.substring(after, after + 1) == " "
        || command.substring(after, after + 1) == "\t" {
        after = after + 1
      }
      const first = command.substring(after, after + 1)
      if first != "'" && first != "\"" && first != "\\" && first != "" {
        return true
      }
    }
    const next = command.substring(index + 2).index_of("<<")
    if next < 0 {
      return false
    }
    index = index + 2 + next
  }
  return false
}

fn git_builtin_lookup_in_context(
  command: string,
  builtin_lookup: fn(string) -> list<string>,
) -> fn(string) -> list<string> {
  const context = git_executable_context(command)
  return { program ->
    // builtin_lookup independently checks the hook's platform and PATH.
    if !(git_program_is_absolute(program, ":") || git_program_is_absolute(program, ";"))
      && (context.path_changed
        || (context.cwd_changed && (program.contains("/") || program.contains("\\")))) {
      return []
    }
    return builtin_lookup(program)
  }
}

/** Reuse measured executable facts only for this one policy decision. */
fn cached_git_builtin_lookup(lookup: fn(string) -> list<string>) -> fn(string) -> list<string> {
  let facts: dict<string, list<string>> = {}
  return { program ->
    const cached = facts[program]
    if cached != nil {
      return cached
    }
    const commands = lookup(program)
    facts[program] = commands
    return commands
  }
}

/** Inspect the shared scanner's executed stages, including nested substitutions. */
fn executed_stages_write_stash(
  command: string,
  depth: int,
  alias_lookup: fn(GitAliasContext) -> dict,
  builtin_lookup: fn(string) -> list<string>,
  require_resolved: bool,
) -> bool {
  const scan = command_risk_scan({request: {mode: "shell", command: command}})
  if scan.execution_semantics?.resolved != true || len(scan.execution_stages ?? []) == 0 {
    return require_resolved
  }
  for stage in scan.execution_stages ?? [] {
    const argv: list<string> = stage.argv
    if xargs_operands_write_stash(argv, alias_lookup, builtin_lookup) {
      return true
    }
    const launched = launched_argv(argv, 0)
    if argv_program(launched) == "git"
      && git_args_write_stash(
        launched,
        git_subcommand_args(launched),
        depth,
        alias_lookup,
        builtin_lookup,
      ) {
      return true
    }
    // The scanner can leave a shell launcher such as dash in the stage.
    const nested = nested_shell_payload(launched)
    if nested != ""
      && (depth >= 4 || git_stash_write_in(nested, depth + 1, alias_lookup, builtin_lookup)) {
      return true
    }
  }
  return false
}

fn git_stash_write_in(
  command: string,
  depth: int,
  alias_lookup: fn(GitAliasContext) -> dict,
  builtin_lookup: fn(string) -> list<string>,
) -> bool {
  // Alias and nested-shell bodies can change configuration after the outer preflight too.
  const lookup = if command_may_change_git_environment(command) {
    { context -> {"<unreadable>": ""} }
  } else {
    alias_lookup
  }
  // A substitution body is a command line the shell runs, so it gets the same analysis. A body that
  // never closes, or one nested past the depth cap, cannot be proven harmless and is refused.
  const builtins = git_builtin_lookup_in_context(command, builtin_lookup)
  const literal_heredoc = command.contains("<<") && !has_expanding_heredoc(command)
  if executed_stages_write_stash(command, depth, lookup, builtins, literal_heredoc) {
    return true
  }
  if literal_heredoc {
    return false
  }
  const substitutions = substitution_bodies(command, !has_expanding_heredoc(command))
  if !substitutions.ok || (len(substitutions.bodies) > 0 && depth >= 4) {
    return true
  }
  for body in substitutions.bodies {
    if git_stash_write_in(body, depth + 1, lookup, builtins) {
      return true
    }
  }
  for group in command_groups(command) {
    for stage in group {
      // `xargs` launches its operands, so the stash rule reads the child the scanner resolved.
      const xargs_child = stage.xargs_child_argv ?? []
      if len(xargs_child) == 0
        && xargs_operands_write_stash(stage.argv, lookup, builtins) {
        return true
      }
      const launched = if len(xargs_child) > 0 {
        xargs_child
      } else {
        stage.argv
      }
      const argv = launched_argv(launched, 0)
      if argv_program(argv) == "git" {
        if git_args_write_stash(argv, git_subcommand_args(argv), depth, lookup, builtins) {
          return true
        }
      }
      if depth < 4 {
        const nested = nested_shell_payload(argv)
        if nested != "" && git_stash_write_in(nested, depth + 1, lookup, builtins) {
          return true
        }
      }
    }
  }
  return false
}

/** Tree-sitter reports UTF-8 byte offsets; Harn substring indexes characters. */
fn character_offset_at_byte(text: string, target: int) -> int {
  let bytes = 0
  for index in range(0, len(text)) {
    if bytes == target {
      return index
    }
    bytes = bytes + len(bytes_from_string(text.substring(index, index + 1)))
    if bytes > target {
      return -1
    }
  }
  return if bytes == target {
    len(text)
  } else {
    -1
  }
}

/** Validate a capture before removing any text from the command. */
fn heredoc_capture(command: string, found: dict, previous: int) -> dict {
  const start_capture = found.captures?.start
  const start = start_capture?.text
  const body_capture = found.captures?.body
  const body = body_capture?.text
  const range = body_capture?.range
  const redirect = found.captures?.redirect
  if type_of(start) != "string" || type_of(body) != "string" || type_of(range) != "dict"
    || type_of(start_capture?.range) != "dict"
    || type_of(redirect?.text) != "string"
    || type_of(redirect?.range) != "dict" {
    return {ok: false}
  }
  const begin = character_offset_at_byte(command, redirect.range.start_byte)
  const end = character_offset_at_byte(command, redirect.range.end_byte)
  const body_begin = character_offset_at_byte(command, range.start_byte)
  const body_end = character_offset_at_byte(command, range.end_byte)
  const delimiter_begin = character_offset_at_byte(command, start_capture.range.start_byte)
  const delimiter_end = character_offset_at_byte(command, start_capture.range.end_byte)
  if begin < previous || end < begin || body_begin < begin || body_end < body_begin
    || body_end > end
    || delimiter_begin < begin
    || delimiter_end < delimiter_begin
    || delimiter_end > body_begin
    || command.substring(begin, end) != redirect.text
    || command.substring(delimiter_begin, delimiter_end) != start
    || command.substring(body_begin, body_end) != body
    || command.substring(delimiter_end, body_begin).trim() != "" {
    return {ok: false}
  }
  return {ok: true, begin: begin, end: end, start: start, body: body}
}

/**
 * Retry a heredoc denial with syntax-owned body boundaries. Outside each body, normal shell
 * quotes apply; inside an expanding body, quote characters are data and substitutions still run.
 * Any incomplete parse or unexpected capture keeps the original denial.
 */
fn heredoc_stash_write(
  command: string,
  alias_lookup: fn(GitAliasContext) -> dict,
  builtin_lookup: fn(string) -> list<string>,
  parse: fn(string, string) -> dict,
) -> bool {
  const redirects = parse(command, "(heredoc_redirect) @redirect")
  const bodies = parse(
    command,
    "(heredoc_redirect (heredoc_start) @start (heredoc_body) @body) @redirect",
  )
  if redirects.result != "ok" || redirects.had_errors != false || redirects.truncated != false
    || bodies.result != "ok"
    || bodies.had_errors != false
    || bodies.truncated != false
    || redirects.match_count == 0
    || redirects.match_count != bodies.match_count
    || len(redirects.matches) != redirects.match_count
    || len(bodies.matches) != bodies.match_count {
    return true
  }
  let sanitized = ""
  let previous = 0
  for found in bodies.matches {
    const capture = heredoc_capture(command, found, previous)
    if !capture.ok {
      return true
    }
    sanitized = sanitized + command.substring(previous, capture.begin)
    previous = capture.end
    // Any quoted delimiter suppresses expansion for the whole heredoc.
    if !capture.start.contains("'") && !capture.start.contains("\"")
      && !capture.start.contains("\\") {
      const substitutions = substitution_bodies(capture.body, false)
      if !substitutions.ok {
        return true
      }
      for nested in substitutions.bodies {
        if git_stash_write_in(nested, 1, alias_lookup, builtin_lookup) {
          return true
        }
      }
    }
  }
  sanitized = sanitized + command.substring(previous)
  return git_stash_write_in(sanitized, 0, alias_lookup, builtin_lookup)
}

/**
 * Refuse `git stash` forms that write the stash list.
 *
 * The list lives in the repository, not the worktree, so every linked worktree
 * pushes to and pops from the same one. An agent that pops after another agent's
 * push applies that agent's changes and loses its own. A work-in-progress commit
 * is private to a branch and has no such collision.
 */
pub fn git_stash_violation(
  command: string,
  alias_lookup: fn(GitAliasContext) -> dict = NO_CONFIG_ALIASES,
  builtin_lookup: fn(string) -> list<string> = NO_GIT_BUILTINS,
  parse: fn(string, string) -> dict = { source, query -> {} },
) -> string {
  const builtins = cached_git_builtin_lookup(builtin_lookup)
  if !git_stash_write_in(command, 0, alias_lookup, builtins) {
    return ""
  }
  // A resolved executed stage is authoritative, including a substitution whose shell comments
  // make the fallback delimiter scanner ambiguous. Only retry a denial the scanner did not prove.
  if command.contains("<<")
    && !executed_stages_write_stash(command, 0, alias_lookup, builtins, false)
    && !heredoc_stash_write(command, alias_lookup, builtins, parse) {
    return ""
  }
  return "`git stash` is refused: the stash list is shared by every linked worktree, so a pop can apply "
    + "another agent's changes and drop yours. Commit a work-in-progress commit on your branch instead "
    + "(`git commit -am wip`), and undo it later with `git reset --soft HEAD~1`. "
    + "`git stash list` and `git stash show` stay available."
}

fn is_slow(stage: ShellCommandStage) -> bool {
  return SLOW_COMMANDS.contains(stage_program(stage))
}

/**
 * True when the command lands its output somewhere re-readable.
 *
 * `2>&1` and `>&2` duplicate a descriptor rather than opening a file, so they
 * are stripped before looking for a redirect — otherwise `swift build 2>&1 |
 * grep error` reads as "already captured" when nothing was captured at all.
 * `&>file` survives the strip and still counts.
 */
fn writes_to_file(stage: ShellCommandStage) -> bool {
  return stage.writes_to_file
}

fn tee_writes_to_file(stage: ShellCommandStage) -> bool {
  if stage_program(stage) != "tee" {
    return false
  }
  // Options change how tee writes; they are not destinations. Requiring one
  // non-option argument keeps `tee -a | grep` from pretending it saved a log.
  return stage.argv.slice(1, len(stage.argv)).any(
    fn(word: string) { return !word.starts_with("-") },
  )
}

pub fn discarded_output_violation(command: string) -> string {
  for group in command_groups(command) {
    if len(group) < 2 {
      continue
    }
    // Capture must happen before the first filter. Redirecting the filter's
    // output preserves only the filtered lines, not the expensive command.
    let has_previous = false
    let previous = EMPTY_SHELL_STAGE
    for stage in group {
      if has_previous
        && is_slow(previous)
        && !writes_to_file(previous)
        && !tee_writes_to_file(stage) {
        return "`" + stage_program(previous) + "` output is piped into a filter "
          + "and then discarded, so recovering any other line costs a full rerun. "
          + "Redirect first, then read the file:\n"
          + "  <command> > .harn-runs/cmd.log 2>&1; echo \"exit=$?\"; grep ... .harn-runs/cmd.log\n"
          + "Any stable path works; .harn-runs/ is already ignored."
      }
      previous = stage
      has_previous = true
    }
  }
  return ""
}

/**
 * Read the admission answer the wrapper measured.
 *
 * The guard runs in the standalone hook host, which permits no filesystem
 * builtin at all, so it cannot look for the admission command itself. The
 * wrapper beside it is ordinary shell with full access, measures once, and
 * reports the answer here.
 *
 * Two variables, because "no admission command in this repository" and "nobody
 * measured" are different answers and only the first may allow. The checked
 * flag is the discriminator: an unset flag means the guard was invoked outside
 * its wrapper, and it refuses rather than reading a missing measurement as an
 * absent file.
 */
pub const ADMISSION_ENV: string = "HARN_EXT_SHELL_GUARD_WORKTREE_ADMISSION"

pub const ADMISSION_CHECKED_ENV: string = "HARN_EXT_SHELL_GUARD_WORKTREE_ADMISSION_CHECKED"

pub type WorktreeAdmissionRow = {root: string, command: string}

/**
 * Every root the wrapper measured for this one command.
 *
 * The guard cannot read the filesystem, and the wrapper cannot read argv, so
 * neither can answer "does the repository this command targets own an
 * admission command" alone. The wrapper measures every root the command could
 * plausibly mean, and the guard, which owns the argv decision, picks the row
 * for the one it actually means.
 *
 * The first row is the wrapper's own repository, which is the answer when the
 * command names no directory of its own.
 *
 * `denial` is non-empty when the census could not be trusted at all. It stays
 * separate from an empty row set for the reason the whole rule exists: not
 * measuring must never read as measuring absence.
 */
pub type WorktreeAdmissionCensus = {rows: list<WorktreeAdmissionRow>, denial: string}

/**
 * Whether a row's invocation is one this policy admits.
 *
 * Two shapes and no others. A bare program, which is a repository holding the
 * command itself; or that program followed by the root flag and an absolute
 * path equal to the row's own root, which is a repository admitted by a
 * command living elsewhere.
 *
 * The second shape is pinned to the row's own root on purpose. Without that,
 * a wrapper could name any directory and the refusal would send the operator
 * at a repository nobody asked about, which is the failure this rule exists to
 * avoid. Anything else, including a renamed program or an argument this policy
 * has never heard of, is a census refusal rather than an allow: a rule that
 * cannot read its own input must not answer "nothing here".
 */
/**
 * Whether a row's program is one this policy knows.
 *
 * The exact path, which is a repository holding the command itself; or an
 * absolute path ending in one, which is that same command named from outside
 * the repository it is admitting.
 *
 * The absolute form is what makes the refusal checkable. A relative path is
 * only meaningful from the repository that holds the command, so a sentence
 * carrying one tells an operator standing somewhere else nothing they can run
 * and nothing anyone can verify on disk. The allowlist still pins the tail, so
 * a renamed program is refused wherever it lives.
 */
fn admission_program_known(program: string) -> bool {
  for known in WORKTREE_ADMISSION_POLICY.admission_command_paths {
    if program == known {
      return true
    }
    if program.starts_with("/") && program.ends_with("/" + known) {
      return true
    }
  }
  return false
}

fn admission_invocation_known(command: string, root: string) -> bool {
  let tokens: list<string> = []
  for token in command.split(" ") {
    const trimmed = token.trim()
    if trimmed != "" {
      tokens = tokens + [trimmed]
    }
  }
  if len(tokens) == 0 {
    return false
  }
  if !admission_program_known(to_string(tokens[0] ?? "")) {
    return false
  }
  if len(tokens) == 1 {
    return true
  }
  if len(tokens) != 3 {
    return false
  }
  if to_string(tokens[1] ?? "") != WORKTREE_ADMISSION_POLICY.admission_root_flag {
    return false
  }
  const named = to_string(tokens[2] ?? "")
  return named.starts_with("/") && named == root
}

/**
 * Parse the census the wrapper reports.
 *
 * One row per line, root and command separated by a tab, the command empty
 * when that repository owns none. A row naming an invocation this policy does
 * not know is a refusal rather than an allow, because a renamed admission
 * command would otherwise turn the rule off silently.
 *
 * The command is an invocation, not only a path, so that a repository admitted
 * by a command living elsewhere can be expressed at all. What may appear in it
 * is the policy's to say, not this decoder's; see `admission_invocation_known`.
 */
pub fn worktree_admission_census(checked: string, reported: string) -> WorktreeAdmissionCensus {
  if checked != "1" {
    return {
      rows: [],
      denial: "no wrapper reported which repositories own a Fleet admission command ("
        + ADMISSION_CHECKED_ENV
        + " is not set)",
    }
  }
  let rows: list<WorktreeAdmissionRow> = []
  for line in reported.split("\n") {
    const trimmed = line.trim()
    if trimmed == "" {
      continue
    }
    const parts = trimmed.split("\t")
    const root = to_string(parts[0] ?? "").trim()
    let command = ""
    if len(parts) > 1 {
      command = to_string(parts[1] ?? "").trim()
    }
    if root == "" {
      return {rows: [], denial: "the wrapper reported an admission row with no repository root"}
    }
    if command != "" && !admission_invocation_known(command, root) {
      return {
        rows: [],
        denial: "the wrapper reported an admission command this policy does not know: `"
          + command
          + "`",
      }
    }
    rows += [{root: root, command: command}]
  }
  if len(rows) == 0 {
    return {rows: [], denial: "the wrapper reported no repository roots at all"}
  }
  return {rows: rows, denial: ""}
}

pub fn worktree_admission_census_from_env(env: HarnessEnv) -> WorktreeAdmissionCensus {
  return worktree_admission_census(
    to_string(env.get(ADMISSION_CHECKED_ENV) ?? ""),
    to_string(env.get(ADMISSION_ENV) ?? ""),
  )
}

/**
 * The answer for the repository one command targets.
 *
 * An absolute target is matched against the measured roots, longest root
 * first, so a worktree nested inside another repository resolves to the
 * nearest one. A target no row covers is unmeasured and refuses: absence of a
 * row is the wrapper not having looked there, never proof that nothing is
 * there.
 *
 * A command with no directory of its own, or a relative one, takes the
 * wrapper's own repository. A relative path cannot be resolved here because
 * the host payload carries no working directory, and guessing would be the
 * same error this change exists to remove, so it keeps the conservative
 * answer rather than inventing a root.
 */
pub fn worktree_admission_for(
  census: WorktreeAdmissionCensus,
  target: string,
) -> WorktreeAdmission {
  if census.denial != "" {
    return {available: false, command: "", denial: census.denial}
  }
  // Row zero is not an arbitrary row: the wrapper reports its own repository
  // root first, so a command with no directory of its own is judged against
  // the repository this guard is installed in, which is where it will run.
  // That is the target, not a stand-in for one.
  if target == "" || !target.starts_with("/") {
    return admission_of(census.rows[0] ?? {root: "", command: ""})
  }
  let best = ""
  let chosen: WorktreeAdmissionRow = {root: "", command: ""}
  for row in census.rows {
    if (target == row.root || target.starts_with(row.root + "/")) && len(row.root) > len(best) {
      best = row.root
      chosen = row
    }
  }
  if best == "" {
    return {
      available: false,
      command: "",
      denial: "no measured repository covers the directory this command targets (`"
        + target
        + "`), so whether it owns an admission command was never looked at",
    }
  }
  return admission_of(chosen)
}

/**
 * The admission command a measured repository configures for itself.
 *
 * A row with no command is a repository that has stated it configures none.
 * That answer is its own, and it is never filled in from another row.
 */
fn admission_of(row: WorktreeAdmissionRow) -> WorktreeAdmission {
  if row.command == "" {
    return {available: false, command: "", denial: ""}
  }
  return {available: true, command: row.command, denial: ""}
}

pub fn decision(
  payload: string,
  census: WorktreeAdmissionCensus,
  make_targets: MakeTargetCensus,
  alias_lookup: fn(GitAliasContext) -> dict = NO_CONFIG_ALIASES,
  builtin_lookup: fn(string) -> list<string> = NO_GIT_BUILTINS,
  parse: fn(string, string) -> dict = { source, query -> {} },
) -> ShellGuardDecision {
  let parsed = nil
  try {
    parsed = json_parse(payload)
  } catch (_) {
    return {allow: true, reason: ""}
  }
  if type_of(parsed) != "dict" || to_string(parsed?.tool_name ?? "") != "Bash" {
    return {allow: true, reason: ""}
  }
  const command = to_string(parsed?.tool_input?.command ?? "")
  if command == "" {
    return {allow: true, reason: ""}
  }
  const attempt = raw_worktree_add_attempt(command)
  if attempt.reason != "" {
    // ONE RULE, FOUR ANSWERS. The refusal rests on the admission command of
    // the repository the command targets, and on no other repository's:
    //
    //   the census could not be read      -> deny, saying so
    //   the target row has a command      -> deny, naming that command
    //   the target row has none           -> allow, and do not police it
    //   no target resolves                -> answer for row zero, which the
    //                                        wrapper reports as its own root
    //   the directory is ambiguous        -> ask for EVERY reachable
    //                                        directory and take the first
    //                                        refusal
    //
    // Row zero is not a stand-in for an unresolved target. The wrapper puts
    // its own repository first, so a command that names no directory will run
    // there, and that repository is the target.
    //
    // The rule is pure argv analysis, so it fires wherever this guard is
    // wired. The census used to be taken against the guard's own installation
    // whatever the command targeted, so a command pointing at another
    // repository was refused and sent to a path that does not exist there.
    // AMBIGUOUS RESOLVES TO THE MOST RESTRICTIVE ANSWER. `attempt.targets` is
    // every directory the command could be running in, so the rule is asked
    // about each and the first refusal wins. Picking one of them would be
    // modelling the shell, and the guard already lost that argument once: it
    // believed a `cd` the shell had skipped.
    for candidate in attempt.targets {
      const admission = worktree_admission_for(census, candidate)
      if admission.denial != "" {
        return {
          allow: false,
          reason: "Raw `git worktree add` is refused because this guard could not tell whether "
            + "the repository it targets owns a Fleet admission command, and an unreadable census "
            + "must not read as an absent one: "
            + admission.denial,
        }
      }
      if admission.available {
        return {
          allow: false,
          // WHAT TO RUN, not where it lives. The command may be the target's
          // own or one pointed at it from elsewhere, and a sentence asserting
          // the target provides it is false in the second case. Naming a path
          // the operator is not standing next to is the failure this rule
          // exists to avoid, so the sentence states the invocation only.
          reason: attempt.reason
            + " Run it as `"
            + admission.command
            + " "
            + WORKTREE_ADMISSION_POLICY.admission_arguments
            + "`; --issue-url or --pull-request-url is optional.",
        }
      }
    }
    // THE TARGET'S OWN COMMAND, OR NONE. A measured repository that advertises
    // no admission command has stated its own contract, and the guard cannot
    // establish that some other root's command admits it. Reaching into
    // another row produced a refusal rooted at a repository the operator had
    // not named, pointed at one the lender may know nothing about: a remedy
    // that costs the operator an attempt and then fails where this guard
    // cannot see it.
    //
    // So the raw command stays allowed here, which is the behaviour this rule
    // had before the borrowing was added. That is a real loosening and worth
    // naming: a repository the fleet measures but gives no admission command
    // is one the fleet has not asked this rule to police.
  }
  const cargo = cargo_violation(command)
  if cargo != "" {
    return {allow: false, reason: cargo}
  }
  const make_owned = make_owned_command_violation(command, make_targets)
  if make_owned != "" {
    return {allow: false, reason: make_owned}
  }
  const stash = git_stash_violation(command, alias_lookup, builtin_lookup, parse)
  if stash != "" {
    return {allow: false, reason: stash}
  }
  const disposable_trash = disposable_trash_violation(command)
  if disposable_trash != "" {
    return {allow: false, reason: disposable_trash}
  }
  const discarded = discarded_output_violation(command)
  if discarded != "" {
    return {allow: false, reason: discarded}
  }
  return {allow: true, reason: ""}
}

fn main(harness: Harness) {
  // Both hook hosts send one compact JSON object. read_line has been a typed
  // Harness capability since before the oldest release this adapter supports.
  const input = harness.stdio.read_line({trim: false})
  const payload = input.value ?? ""
  const verdict = decision(
    payload,
    worktree_admission_census_from_env(harness.env),
    make_target_census_from_env(harness.env),
    { context -> git_config_aliases_for(harness.process, harness.env, harness.system, context) },
    { program -> git_builtin_commands(harness.process, harness.env, harness.system, program) },
    { source, query -> harness.ast.search({source: source, language: "bash", query: query}) },
  )
  if verdict.allow {
    return nil
  }
  harness.stdio.println(
    json_stringify(
      {
        hookSpecificOutput: {
          hookEventName: "PreToolUse",
          permissionDecision: "deny",
          permissionDecisionReason: verdict.reason,
        },
      },
    ),
  )
  return nil
}
