import { command_output_range, command_run } from "std/command"

pub type GitHubApiFailureKind = "command" | "invalid_json" | "transient_transport"

pub type GitHubApiAttempt = {success: bool, stdout: string, stderr: string, timed_out: bool}

pub type GitHubApiRetryPolicy = {max_attempts: int, delay_ms: int}

pub type GitHubApiReceipt = {
  ok: bool,
  attempts: int,
  value?: unknown,
  failure_kind?: GitHubApiFailureKind,
  detail?: string,
}

pub type GitHubApiAdapters = {request: fn(string) -> GitHubApiAttempt, wait: fn(int) -> nil}

const DEFAULT_RETRY_POLICY: GitHubApiRetryPolicy = {max_attempts: 3, delay_ms: 1000}

type GitHubCommandCapture = {
  stdout_truncated: bool,
  stderr_truncated: bool,
  stdout_path: string,
  stderr_path: string,
  byte_count: int,
  timed_out: bool,
}

type GitHubCommandRange = {
  content: string,
  total_bytes: int,
  offset: int,
  bytes_read: int,
  eof: bool,
  path: string,
}

fn complete_stream(
  tools: HarnessTools,
  path: string,
  inline: string,
  truncated: bool,
  byte_count: int,
) -> string {
  if !truncated {
    return inline
  }
  if path == "" || byte_count <= 0 {
    throw "GitHub API command returned incomplete output without a measured artifact"
  }
  const output: GitHubCommandRange = schema_expect(
    command_output_range(tools, {path: path}, {length: byte_count}),
    schema_of(GitHubCommandRange),
  )
  if !output.eof || output.offset != 0 || output.bytes_read != output.total_bytes
    || output.total_bytes <= 0
    || output.path != path {
    throw "GitHub API command artifact was not read completely"
  }
  return output.content
}

/**
 * Classify only known transport failures as retryable. "stream error: stream ID"
 * is an HTTP/2 stream the server reset, e.g. "stream ID 1; CANCEL; received from peer";
 * "(HTTP 502)" is how gh itself reports a gateway error.
 */
pub fn github_api_failure_kind(attempt: GitHubApiAttempt) -> GitHubApiFailureKind {
  if attempt.timed_out {
    return "transient_transport"
  }
  const detail = attempt.stderr.lower()
  if detail.contains("tls:")
    || detail.contains("x509:")
    || detail.contains("connection reset")
    || detail.contains("connection timed out")
    || detail.contains("unexpected eof")
    || detail.contains("stream error: stream id")
    || detail.contains("temporarily unavailable")
    || detail.contains("502 bad gateway")
    || detail.contains("503 service unavailable")
    || detail.contains("504 gateway timeout")
    || detail.contains("(http 502)")
    || detail.contains("(http 503)")
    || detail.contains("(http 504)")
    || regex_match("(?m)^gh: http (502|503|504)\\r?$", detail.trim()) != nil {
    return "transient_transport"
  }
  return "command"
}

// gh can omit the reason phrase and parentheses. Match the complete
// status line so a neighbouring status such as 5030 is not retryable.
/** Run one read-only GitHub API request with bounded transport recovery. */
pub fn github_api_json_with_retry(
  adapters: GitHubApiAdapters,
  path: string,
  policy: GitHubApiRetryPolicy,
) -> GitHubApiReceipt {
  const max_attempts = max(1, policy.max_attempts)
  const delay_ms = max(0, policy.delay_ms)
  let attempt_number = 1
  while attempt_number <= max_attempts {
    const attempt = adapters.request(path)
    if attempt.success {
      const parsed = try {
        Ok(json_parse(attempt.stdout))
      } catch (_err) {
        Err("invalid_json")
      }
      if is_err(parsed) {
        return {
          ok: false,
          attempts: attempt_number,
          failure_kind: "invalid_json",
          detail: "GitHub API returned invalid JSON",
        }
      }
      return {ok: true, attempts: attempt_number, value: unwrap(parsed)}
    }
    const failure_kind = github_api_failure_kind(attempt)
    if failure_kind != "transient_transport" || attempt_number == max_attempts {
      return {
        ok: false,
        attempts: attempt_number,
        failure_kind: failure_kind,
        detail: "GitHub API request failed: ${attempt.stderr.trim()}",
      }
    }
    adapters.wait(delay_ms)
    attempt_number = attempt_number + 1
  }
  return {
    ok: false,
    attempts: max_attempts,
    failure_kind: "command",
    detail: "GitHub API request exhausted its retry budget",
  }
}

pub fn github_api_json_result(
  tools: HarnessTools,
  clock: HarnessClock,
  path: string,
  policy: GitHubApiRetryPolicy? = nil,
) -> GitHubApiReceipt {
  const adapters: GitHubApiAdapters = {
    request: { requested_path ->
      const api_path = if requested_path.starts_with("/") {
        requested_path[1:]
      } else {
        requested_path
      }
      const result = command_run(tools, ["gh", "api", api_path], {timeout_ms: 30000})
      const capture: GitHubCommandCapture = schema_expect(result, schema_of(GitHubCommandCapture))
      return {
        success: result.success,
        stdout: complete_stream(
          tools,
          capture.stdout_path,
          result.stdout,
          capture.stdout_truncated,
          capture.byte_count,
        ),
        stderr: complete_stream(
          tools,
          capture.stderr_path,
          result.stderr,
          capture.stderr_truncated,
          capture.byte_count,
        ),
        timed_out: capture.timed_out,
      }
    },
    wait: { delay_ms -> clock.sleep_ms(delay_ms) },
  }
  return github_api_json_with_retry(adapters, path, policy ?? DEFAULT_RETRY_POLICY)
}

/** Return parsed JSON or fail closed with the typed retry receipt's detail. */
pub fn github_api_json(
  tools: HarnessTools,
  clock: HarnessClock,
  path: string,
  policy: GitHubApiRetryPolicy? = nil,
) -> unknown {
  const receipt = github_api_json_result(tools, clock, path, policy)
  if !receipt.ok {
    throw receipt.detail ?? "GitHub API request failed"
  }
  return receipt.value
}
