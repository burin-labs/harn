// Guard published manifests from resolving stale Harn workspace siblings.
//
// Cargo strips local `path` entries when publishing crates.io packages, leaving
// the `version` requirement as the only coupling between sibling crates. That
// requirement must be exact, or a downstream pinning one Harn crate can resolve
// older siblings from the same semver line.
import { require_scanned } from "./path_visibility.harn"
import { cargo_dependency_from_line, cargo_section_from_line } from "./release_metadata.harn"

const MANIFEST_GLOBS = ["crates/*/Cargo.toml", "tree-sitter-harn/Cargo.toml"]

pub fn workspace_version_from_text(text: string) -> string {
  const doc = toml_parse(text)
  const version = doc.get("workspace")?.get("package")?.get("version")
  if type_of(version) != "string" || version == "" {
    throw "missing [workspace.package] version in Cargo.toml"
  }
  return version
}

pub fn expected_dependency_version(workspace_version: string) -> string {
  return "=" + workspace_version
}

pub fn manifest_package_name_from_text(text: string) -> string {
  const doc = toml_parse(text)
  const name = doc.get("package")?.get("name")
  if type_of(name) != "string" || name == "" {
    throw "missing [package] name in Cargo.toml"
  }
  return name
}

pub fn manifest_is_publishable_from_text(text: string) -> bool {
  const doc = toml_parse(text)
  const publish = doc.get("package")?.get("publish")
  return !(type_of(publish) == "bool" && !publish)
}

pub fn dependency_section_from_line(line: string) -> string {
  return cargo_section_from_line(line) ?? ""
}

fn is_dev_dependency_section(section: string) -> bool {
  return section == "dev-dependencies" || section.ends_with(".dev-dependencies")
}

pub type SiblingDependencyLineRequest = {
  path: string,
  line_no: int,
  line: string,
  expected_version: string,
  section: string,
  unpublished_sibling_names: list<string>,
  manifest_is_publishable: bool,
  dependent_sibling_names?: list<string>,
  manifest?: unknown,
}

pub fn sibling_dep_errors_from_line_with_context(
  request: SiblingDependencyLineRequest,
) -> list<string> {
  const path = request.path
  const line_no = request.line_no
  const line = request.line
  const expected_version = request.expected_version
  const section = request.section
  const unpublished_sibling_names = request.unpublished_sibling_names
  const manifest_is_publishable = request.manifest_is_publishable
  const dependency = cargo_dependency_from_line(line, request.manifest, section)
  if dependency == nil {
    return []
  }
  const name = dependency.package_name
  if !(name.starts_with("harn-") || name == "tree-sitter-harn") || dependency.path == nil {
    return []
  }
  if unpublished_sibling_names.contains(name) {
    if manifest_is_publishable && !is_dev_dependency_section(section) {
      return [
        "${path}:${line_no}: ${name} is publish = false; publishable manifests may only use it as a dev-dependency",
      ]
    }
    return []
  }
  // A dev-dependency on a sibling that itself depends on this crate closes a
  // cycle. It must stay path-only: publishing strips it, while a version
  // requirement would make this crate's publish wait on the sibling it feeds.
  if is_dev_dependency_section(section)
    && (request.dependent_sibling_names ?? []).contains(name) {
    if dependency.version != nil {
      return [
        "${path}:${line_no}: ${name} depends on this crate; its dev-dependency must stay path-only",
      ]
    }
    return []
  }
  if dependency.version == nil {
    return [
      "${path}:${line_no}: ${name} path dependency must set version = \"${expected_version}\"",
    ]
  }
  const actual = dependency.version
  if actual != expected_version {
    return [
      "${path}:${line_no}: ${name} path dependency version is \"${actual}\", expected \"${expected_version}\"",
    ]
  }
  return []
}

pub fn sibling_dep_errors_from_line(
  path: string,
  line_no: int,
  line: string,
  expected_version: string,
) -> list<string> {
  return sibling_dep_errors_from_line_with_context(
    {
      path: path,
      line_no: line_no,
      line: line,
      expected_version: expected_version,
      section: "",
      unpublished_sibling_names: [],
      manifest_is_publishable: true,
    },
  )
}

pub fn sibling_dep_errors_from_text_with_context(
  path: string,
  text: string,
  workspace_version: string,
  unpublished_sibling_names: list<string>,
  manifest_is_publishable: bool,
  dependent_sibling_names: list<string>,
) -> list<string> {
  const expected = expected_dependency_version(workspace_version)
  const manifest = toml_parse(text)
  let errors: list<string> = []
  let line_no = 1
  let section = ""
  for line in text.lines() {
    const next_section = dependency_section_from_line(line)
    if next_section != "" {
      section = next_section
    }
    errors = errors
      + sibling_dep_errors_from_line_with_context(
        {
          path: path,
          line_no: line_no,
          line: line,
          expected_version: expected,
          section: section,
          unpublished_sibling_names: unpublished_sibling_names,
          manifest_is_publishable: manifest_is_publishable,
          dependent_sibling_names: dependent_sibling_names,
          manifest: manifest,
        },
      )
    line_no = line_no + 1
  }
  return errors
}

pub fn sibling_dep_errors_from_text(
  path: string,
  text: string,
  workspace_version: string,
) -> list<string> {
  return sibling_dep_errors_from_text_with_context(path, text, workspace_version, [], true, [])
}

pub fn manifest_globs() -> list<string> {
  return MANIFEST_GLOBS
}

fn checked_manifest_paths(fs: HarnessFs) -> list<string> {
  let paths: list<string> = []
  for pattern in MANIFEST_GLOBS {
    // scan-refused: require_scanned on the aggregate below.
    for path in fs.glob(pattern) {
      paths = paths + [path]
    }
  }
  // A denied or mis-rooted glob returns an empty list, and every later loop
  // then runs zero times and reports a clean crate graph.
  require_scanned("check-crate-sibling-versions", "crate manifest(s)", len(paths))
  return paths.sorted()
}

fn unpublished_workspace_package_names(fs: HarnessFs, paths: list<string>) -> list<string> {
  let names: list<string> = []
  for path in paths {
    const text = fs.read_text(path)
    if !manifest_is_publishable_from_text(text) {
      names = names + [manifest_package_name_from_text(text)]
    }
  }
  return names.sorted()
}

/** Package names whose regular or build dependencies name a sibling path crate. */
pub fn regular_sibling_dependency_names_from_text(text: string) -> list<string> {
  const doc = toml_parse(text)
  let names: list<string> = []
  for table_name in ["dependencies", "build-dependencies"] {
    const table = doc.get(table_name)
    if type_of(table) != "dict" {
      continue
    }
    for entry in table.entries() {
      const spec = entry.value
      if type_of(spec) == "dict" && spec.get("path") != nil {
        names = names + [spec.get("package") ?? entry.key]
      }
    }
  }
  return names.sorted()
}

/** Map each package to the siblings that depend on it, from every manifest. */
fn dependents_by_package(fs: HarnessFs, paths: list<string>) -> dict<string, list<string>> {
  let dependents: dict<string, list<string>> = {}
  for path in paths {
    const text = fs.read_text(path)
    const dependent = manifest_package_name_from_text(text)
    for name in regular_sibling_dependency_names_from_text(text) {
      dependents = dependents + {[name]: (dependents.get(name) ?? []) + [dependent]}
    }
  }
  return dependents
}

pipeline main(harness: Harness, task: unknown) {
  const workspace_version = workspace_version_from_text(harness.fs.read_text("Cargo.toml"))
  const paths = checked_manifest_paths(harness.fs)
  const unpublished_sibling_names = unpublished_workspace_package_names(harness.fs, paths)
  const dependents = dependents_by_package(harness.fs, paths)
  let errors: list<string> = []
  for path in paths {
    const text = harness.fs.read_text(path)
    errors = errors
      + sibling_dep_errors_from_text_with_context(
        path,
        text,
        workspace_version,
        unpublished_sibling_names,
        manifest_is_publishable_from_text(text),
        dependents.get(manifest_package_name_from_text(text)) ?? [],
      )
  }
  if errors.count > 0 {
    harness.stdio.eprintln("Harn sibling crate dependency pin check failed:")
    for error in errors {
      harness.stdio.eprintln("- " + error)
    }
    return 1
  }
  harness.stdio.println(
    "Harn sibling crate dependency pins match workspace version "
      + expected_dependency_version(workspace_version),
  )
  return 0
}
