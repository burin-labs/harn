/**
 * Live smoke for Gemini 3.8 Flash through the provider catalog.
 *
 * Every cell routes through `harness.llm.call`, so the catalog row, the
 * capability rules and Harn's own cost accounting are all on the path.
 * Nothing here talks raw HTTP.
 *
 * Cell A  plain completion on the new route
 * Cell B  native tool call on the new route
 * Cell C  thinking effort on the new route
 * Cell D  NEGATIVE CONTROL: an id the catalog does not carry must refuse
 */
pipeline default(harness: Harness, args: unknown) {
  const model = "gemini-3.8-flash"
  const base = {provider: "gemini", model: model, stream: false}

  const a = harness.llm.call("Reply with only the word ok.", nil, base + {max_tokens: 512})
  harness.stdio.log("A completion  text=${a.text} cost=${a.usage.cost_usd} base_url=${a.usage.provider_telemetry.serving_base_url}")

  const tools = [{
    name: "get_weather",
    description: "Get the weather for a city",
    parameters: {city: {type: "string", description: "City name", required: true}},
  }]
  const b = harness.llm.call(
    "What is the weather in Toronto? Use the tool.",
    nil,
    base + {tools: tools, max_tokens: 1024},
  )
  harness.stdio.log("B tool_call  calls=${b.tool_calls} cost=${b.usage.cost_usd}")

  const c = harness.llm.call(
    "How many r letters are in strawberry? Answer with the number only.",
    nil,
    base + {effort: "low", max_tokens: 1024},
  )
  harness.stdio.log("C thinking-low  text=${c.text} cost=${c.usage.cost_usd}")

  try {
    const d = harness.llm.call("hi", nil, base + {model: "gemini-3.9-flash", max_tokens: 32})
    harness.stdio.log("D NEGATIVE CONTROL FAILED, an uncatalogued id answered: ${d.text}")
  } catch e {
    harness.stdio.log("D negative control held, uncatalogued id refused: ${e}")
  }
}
