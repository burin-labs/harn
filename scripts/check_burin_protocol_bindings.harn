import { help_requested, parse, parser } from "std/cli/argparse"

const ARTIFACTS_REL = "spec/protocol-artifacts"

const TARGETS = [
  {source: "HarnProtocol.swift", destination: "Sources/BurinCore/ACP/HarnProtocol.generated.swift"},
  {source: "harn-protocol.ts", destination: "server/src/generated/harn-protocol.ts"},
]

fn repo_root() -> string {
  return path_normalize(path_join(source_dir(), ".."))
}

fn effective_repo_root(root: string = "") -> string {
  if root != "" {
    return path_normalize(root)
  }
  return repo_root()
}

fn artifact_root(root: string = "") -> string {
  return path_join(effective_repo_root(root), ARTIFACTS_REL)
}

pub fn normalize_protocol_text(text: string) -> string {
  return text.replace("\r\n", "\n").replace("\r", "\n")
}

fn expand_user(path: string) -> string {
  if path == "~" {
    return harness.env.get("HOME") ?? path
  }
  if path.starts_with("~/") {
    const home = harness.env.get("HOME") ?? ""
    if home != "" {
      return path_join(home, path.substring(2, path.len()))
    }
  }
  return path
}

fn is_dir(path: string) -> bool {
  if path == "" || !harness.fs.exists(path) {
    return false
  }
  return harness.fs.stat(path).is_dir
}

fn is_file(path: string) -> bool {
  if path == "" || !harness.fs.exists(path) {
    return false
  }
  return harness.fs.stat(path).is_file
}

pub fn discover_burin_root(explicit_root: string = "") -> string {
  if explicit_root != "" {
    return path_normalize(expand_user(explicit_root))
  }
  const env_root = harness.env.get("BURIN_CODE_ROOT") ?? ""
  if env_root != "" {
    return path_normalize(expand_user(env_root))
  }
  const home = harness.env.get("HOME") ?? ""
  if home != "" {
    const candidate = path_join(home, "projects", "burin-code")
    if is_dir(candidate) {
      return candidate
    }
  }
  return ""
}

pub fn stale_burin_protocol_bindings(burin_root: string, harn_root: string = "") -> list<string> {
  let stale: list<string> = []
  const source_root = artifact_root(harn_root)
  for target in TARGETS {
    const source = path_join(source_root, to_string(target.source))
    const destination_rel = to_string(target.destination)
    const destination = path_join(burin_root, destination_rel)
    if !is_file(destination) {
      stale = stale + [destination_rel + " (missing)"]
      continue
    }
    const source_text = normalize_protocol_text(harness.fs.read_text(source))
    const destination_text = normalize_protocol_text(harness.fs.read_text(destination))
    if source_text != destination_text {
      stale = stale + [destination_rel]
    }
  }
  return stale
}

pub fn check_burin_protocol_bindings(
  burin_root_arg: string = "",
  required: bool = false,
  harn_root: string = "",
) -> dict {
  const burin_root = discover_burin_root(burin_root_arg)
  const artifacts = artifact_root(harn_root)
  if !is_dir(burin_root) {
    return {
      ok: !required,
      skipped: !required,
      status: "missing_root",
      burin_root: burin_root,
      artifacts: artifacts,
      stale: [],
      stale_count: 0,
    }
  }
  const stale = stale_burin_protocol_bindings(burin_root, harn_root)
  return {
    ok: len(stale) == 0,
    skipped: false,
    status: if len(stale) == 0 {
      "ok"
    } else {
      "stale"
    },
    burin_root: burin_root,
    artifacts: artifacts,
    stale: stale,
    stale_count: len(stale),
  }
}

fn arg_spec() {
  return parser(
    {
      name: "check_burin_protocol_bindings",
      args: [
        {kind: "flag", name: "burin_root", long: "--burin-root", parse: "string", default: ""},
        {kind: "switch", name: "required", long: "--required", default: false},
      ],
    },
  )
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/check_burin_protocol_bindings.harn -- [--burin-root PATH] [--required]",
    )
    return nil
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    exit(2)
  }
  const parsed = unwrap(parsed_result).options
  const report = check_burin_protocol_bindings(
    to_string(parsed?.burin_root ?? ""),
    parsed?.required ?? false,
  )
  if report.status == "missing_root" {
    if parsed?.required ?? false {
      harness.stdio.eprintln("error: Burin Code checkout not found")
      exit(1)
    }
    harness.stdio.println(
      "skipping Burin protocol binding drift check (no Burin Code checkout found)",
    )
    return nil
  }
  if report.stale_count > 0 {
    harness.stdio.eprintln(
      "error: Burin Code protocol bindings diverge from " + to_string(report.artifacts) + ":",
    )
    for path in report.stale {
      harness.stdio.eprintln("  " + to_string(path))
    }
    harness.stdio.eprintln(
      "hint: regenerate Burin's vendored bindings from this Harn checkout or the matching Harn release.",
    )
    exit(1)
  }
  harness.stdio.println("Burin protocol bindings match " + to_string(report.artifacts))
  return nil
}
