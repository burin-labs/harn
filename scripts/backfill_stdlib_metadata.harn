/**
 * Backfill @effects/@allocation/@errors/@api_stability/@example metadata
 * fields on every `pub fn` under `crates/harn-stdlib/src/stdlib/`.
 *
 * Port of scripts/backfill_stdlib_metadata.py. Mutating script: rewrites
 * stdlib .harn files in place to append missing canonical metadata fields.
 *
 * Behavior:
 *   - Functions that already carry every field are skipped.
 *   - Functions with an existing `/** ... */` block but partial metadata
 *     get the missing fields appended inside the block.
 *   - Functions without a doc block at all are skipped.
 *
 * The pure transform lives in process_file(text, path) -> {text, stats} so
 * tests can hand-verify the rewrite without touching disk.
 *
 * Run from the repo root: harn run scripts/backfill_stdlib_metadata.harn
 */
let META_KEYS = ["effects", "allocation", "errors", "api_stability", "example"]

let EXPERIMENTAL_PATH_FRAGMENTS = [
  "/agent/",
  "/triggers",
  "/workflow/",
  "/connectors",
  "/personas",
  "/handoffs",
  "/triage",
  "/dashboard/",
  "/ui_resource",
  "/orchestration/",
]

/** Each rule is [pattern, label]. Order is significant for effect ordering. */
fn _effect_rules() -> list {
  return [
    ["\\bprint\\(", "stdio.write"],
    ["\\bprintln\\(", "stdio.write"],
    ["\\beprintln?\\(", "stdio.write"],
    ["\\bread_to_string\\(", "fs.read"],
    ["\\bread_lines\\(", "fs.read"],
    ["\\bread_bytes\\(", "fs.read"],
    ["\\bwrite_to_file\\(", "fs.write"],
    ["\\bwrite_bytes\\(", "fs.write"],
    ["\\bappend_to_file\\(", "fs.write"],
    ["\\bmake_dirs\\(", "fs.write"],
    ["\\b__fs_[a-z_]*read", "fs.read"],
    ["\\b__fs_[a-z_]*write", "fs.write"],
    ["\\b__fs_remove", "fs.write"],
    ["\\b__fs_[a-z_]*list", "fs.read"],
    ["\\b__fs_[a-z_]*walk", "fs.read"],
    ["\\bfs::", "fs.read"],
    ["\\bllm_call\\(", "llm.call"],
    ["\\bllm_complete\\(", "llm.call"],
    ["\\bllm_judge\\(", "llm.call"],
    ["\\b__llm_", "llm.call"],
    ["\\bhttp_get\\(", "net"],
    ["\\bhttp_post\\(", "net"],
    ["\\bhttp_put\\(", "net"],
    ["\\bhttp_delete\\(", "net"],
    ["\\bhttp_request\\(", "net"],
    ["\\bweb_fetch\\(", "net"],
    ["\\bweb_get\\(", "net"],
    ["\\b__net_", "net"],
    ["\\bcommand_run\\(", "process"],
    ["\\bshell\\(", "process"],
    ["\\b__shell_", "process"],
    ["\\b__process_", "process"],
    ["\\bgit_run\\b", "process"],
    ["\\bcrypto_", "crypto"],
    ["\\b__crypto_", "crypto"],
    ["\\bhash_", "crypto"],
    ["\\btimestamp\\(", "time"],
    ["\\bnow\\(", "time"],
    ["\\b__time_", "time"],
    ["\\bgetenv\\(", "env"],
    ["\\b__env_", "env"],
    ["\\bstore_get\\(", "store.read"],
    ["\\bstore_set\\(", "store.write"],
    ["\\b__store_", "store.read"],
    ["\\bemit\\(", "transcript.write"],
    ["\\b__transcript_", "transcript.write"],
    ["\\bhost_call\\(", "host"],
    ["\\b__host_", "host"],
    ["\\bagent_call\\(", "agent"],
    ["\\bagent_spawn\\(", "agent"],
    ["\\b__agent_", "agent"],
    ["\\bnotion_", "net"],
    ["\\bslack_", "net"],
    ["\\blinear_", "net"],
    ["\\bgithub_", "net"],
    ["\\bmcp_", "mcp"],
    ["\\b__mcp_", "mcp"],
  ]
}

/** Whitespace set matching Python str.strip(): space, tab, CR, FF, VT, NL. */
fn _is_ws(c) -> bool {
  return c == " " || c == "\t" || c == "\r" || c == "\n"
}

/** Strip leading whitespace (Python str.lstrip). */
pub fn lstrip_ws(s) -> string {
  let n = s.len()
  var i = 0
  while i < n {
    if _is_ws(s.char_at(i)) {
      i = i + 1
    } else {
      break
    }
  }
  return s.substring(i, n)
}

/** Strip trailing whitespace (Python str.rstrip). */
pub fn rstrip_ws(s) -> string {
  var n = s.len()
  while n > 0 {
    if _is_ws(s.char_at(n - 1)) {
      n = n - 1
    } else {
      break
    }
  }
  return s.substring(0, n)
}

/** Strip leading and trailing whitespace (Python str.strip). */
pub fn strip_ws(s) -> string {
  return rstrip_ws(lstrip_ws(s))
}

/** Strip leading occurrences of a single char `ch` (Python lstrip("*")). */
pub fn lstrip_char(s, ch) -> string {
  let n = s.len()
  var i = 0
  while i < n {
    if s.char_at(i) == ch {
      i = i + 1
    } else {
      break
    }
  }
  return s.substring(i, n)
}

/** Leading-whitespace prefix of a line (its indentation). */
pub fn leading_indent(s) -> string {
  return s.substring(0, s.len() - lstrip_ws(s).len())
}

/**
 * Match `^pub fn NAME` where NAME is followed (after optional ws) by < or (.
 * Returns the function name, or "" when the line is not a pub fn header.
 */
pub fn match_pub_fn(line) -> string {
  let prefix = "pub fn "
  if !line.starts_with(prefix) {
    return ""
  }
  let rest = line.substring(prefix.len(), line.len())
  let n = rest.len()
  if n == 0 {
    return ""
  }
  let c0 = rest.char_at(0)
  if !_is_ident_start(c0) {
    return ""
  }
  var i = 1
  while i < n {
    let c = rest.char_at(i)
    if _is_ident_part(c) {
      i = i + 1
    } else {
      break
    }
  }
  let name = rest.substring(0, i)
  /* Skip optional whitespace, then require `<` or `(`. */
  var j = i
  while j < n {
    if _is_ws(rest.char_at(j)) {
      j = j + 1
    } else {
      break
    }
  }
  if j >= n {
    return ""
  }
  let nxt = rest.char_at(j)
  if nxt == "<" || nxt == "(" {
    return name
  }
  return ""
}

fn _is_ident_start(c) -> bool {
  return _is_alpha(c) || c == "_"
}

fn _is_ident_part(c) -> bool {
  return _is_alpha(c) || _is_digit(c) || c == "_"
}

fn _is_alpha(c) -> bool {
  return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
}

fn _is_digit(c) -> bool {
  return c >= "0" && c <= "9"
}

/**
 * Walk backward over `out` to find the start index of a canonical doc block
 * immediately above the next line. Returns -1 when none is adjacent.
 */
pub fn find_doc_block_start(out) -> int {
  let total = len(out)
  if total == 0 {
    return -1
  }
  var j = total - 1
  if strip_ws(out[j]) == "" {
    j = j - 1
    if j < 0 {
      return -1
    }
  }
  let last_line = rstrip_ws(out[j])
  if !last_line.ends_with("*/") {
    return -1
  }
  if lstrip_ws(last_line).starts_with("/**") {
    return j
  }
  while j >= 0 {
    let s = lstrip_ws(out[j])
    if s.starts_with("/**") {
      return j
    }
    if !(s.starts_with("*") || strip_ws(out[j]) == "") {
      return -1
    }
    j = j - 1
  }
  return -1
}

/**
 * Parse `@key: value` metadata pairs out of a doc-block slice. Returns a
 * dict of recognized keys -> value (stripped).
 */
pub fn parse_existing_metadata(block_lines) -> dict {
  var out = {}
  for raw in block_lines {
    var s = strip_ws(raw)
    if s.starts_with("/**") {
      s = lstrip_ws(s.substring(3, s.len()))
    }
    if s.ends_with("*/") {
      s = rstrip_ws(s.substring(0, s.len() - 2))
    }
    s = strip_ws(lstrip_char(s, "*"))
    if !s.starts_with("@") {
      continue
    }
    let rest = s.substring(1, s.len())
    let ci = rest.index_of(":")
    if ci == -1 {
      continue
    }
    let key = strip_ws(rest.substring(0, ci))
    let value = strip_ws(rest.substring(ci + 1, rest.len()))
    if META_KEYS.contains(key) {
      out[key] = value
    }
  }
  return out
}

/**
 * Insert `@key: value` lines for new_fields inside an existing doc block,
 * immediately before the closing terminator. Returns the rebuilt lines.
 */
pub fn inject_metadata(block_lines, new_fields) -> list {
  if len(block_lines) == 0 {
    return block_lines
  }
  var lines = block_lines
  var last_idx = len(lines) - 1
  let last_line = lines[last_idx]
  let indent = leading_indent(lines[0])
  if lstrip_ws(last_line).starts_with("/**") && rstrip_ws(last_line).ends_with("*/") {
    /* Expand single-line block into multi-line. inner has no newlines here
       (a line never contains \n), so the inner split is just one token. */
    let trimmed = strip_ws(last_line)
    let inner = strip_ws(trimmed.substring(3, trimmed.len() - 2))
    var rebuilt = ["${indent}/**"]
    if inner != "" {
      /* Python splits inner on "\n"; a single line has no newline. */
      let token = strip_ws(inner)
      if token != "" {
        rebuilt = rebuilt + ["${indent} * ${token}"]
      }
    }
    rebuilt = rebuilt + ["${indent} */"]
    lines = rebuilt
    last_idx = len(lines) - 1
  }
  let insertion_pos = last_idx
  let inner_indent = "${indent} *"
  let prev_stripped = strip_ws(lines[insertion_pos - 1])
  let needs_separator = insertion_pos > 1 && prev_stripped != "*" && prev_stripped != ""
  var inserted = []
  if needs_separator {
    inserted = inserted + [inner_indent]
  }
  for key in META_KEYS {
    if new_fields.keys().contains(key) {
      let value = new_fields[key]
      inserted = inserted + ["${inner_indent} @${key}: ${value}"]
    }
  }
  return lines.slice(0, insertion_pos) + inserted + lines.slice(insertion_pos, len(lines))
}

/**
 * Collect the function body (brace-balanced) starting at line `start`.
 * Returns the joined body text.
 */
pub fn collect_body(lines, start) -> string {
  var depth = 0
  var seen_open = false
  var body_lines = []
  var i = start
  let n = len(lines)
  while i < n {
    let line = lines[i]
    let m = line.len()
    var k = 0
    while k < m {
      let ch = line.char_at(k)
      if ch == "{" {
        depth = depth + 1
        seen_open = true
      } else if ch == "}" {
        depth = depth - 1
      }
      k = k + 1
    }
    if seen_open {
      body_lines = body_lines + [line]
    }
    i = i + 1
    if seen_open && depth == 0 {
      return body_lines.join("\n")
    }
  }
  return body_lines.join("\n")
}

/**
 * Collect the signature: lines from `start` until a line containing `{`,
 * each stripped, joined with single spaces.
 */
pub fn collect_signature(lines, start) -> string {
  var parts = []
  var i = start
  let n = len(lines)
  while i < n {
    parts = parts + [strip_ws(lines[i])]
    if lines[i].contains("{") {
      break
    }
    i = i + 1
  }
  return parts.join(" ")
}

/** Infer effects list label set, in rule order, from the body text. */
pub fn infer_effects(body) -> string {
  var effects = []
  for rule in _effect_rules() {
    let pattern = rule[0]
    let label = rule[1]
    if len(regex_captures(pattern, body)) > 0 && !effects.contains(label) {
      effects = effects + [label]
    }
  }
  return "[${effects.join(", ")}]"
}

/** Infer allocation from the declared return type in the signature. */
pub fn infer_allocation(signature) -> string {
  let ret = _extract_return_type(signature)
  if ret == "" {
    return "heap"
  }
  if ret == "nil" || ret == "void" {
    return "stack-only"
  }
  if ret == "bool" || ret == "int" || ret == "float" {
    return "stack-only"
  }
  return "heap"
}

/**
 * Replicates re.search(r"->\s*([^{}]+?)\s*(?:\{|$)", signature).
 * Returns the captured return type string, or "" when no match.
 */
fn _extract_return_type(signature) -> string {
  let n = signature.len()
  var i = 0
  while i < n - 1 {
    if signature.char_at(i) == "-" && signature.char_at(i + 1) == ">" {
      /* Found "->". Skip following whitespace. */
      var p = i + 2
      while p < n {
        if _is_ws(signature.char_at(p)) {
          p = p + 1
        } else {
          break
        }
      }
      /* Capture [^{}]+? non-greedy up to optional ws then { or end.
         The capture must be at least one char and contain no { or }. */
      let start = p
      var q = start
      while q < n {
        let c = signature.char_at(q)
        if c == "{" || c == "}" {
          break
        }
        q = q + 1
      }
      /* q is first {/}/end. The match needs >=1 char between start and the
         trailing-ws-trimmed boundary. Non-greedy +? with \s*(?:{|$): the
         capture is everything from start up to trailing whitespace before
         the terminator. */
      if q > start {
        return rstrip_ws(signature.substring(start, q))
      }
    }
    i = i + 1
  }
  return ""
}

/** Derive an example call from the function name and signature parameters. */
pub fn derive_example(name, signature) -> string {
  let raw = _extract_params(signature)
  if raw == "" {
    return "${name}()"
  }
  var args = []
  for part in _split_top_level(raw) {
    let token = strip_ws(part)
    if token == "" {
      continue
    }
    /* ident = token.split(":")[0].split("=")[0].strip().lstrip("*&") */
    var ident = token
    let ci = ident.index_of(":")
    if ci != -1 {
      ident = ident.substring(0, ci)
    }
    let ei = ident.index_of("=")
    if ei != -1 {
      ident = ident.substring(0, ei)
    }
    ident = strip_ws(ident)
    ident = _lstrip_set(ident, "*&")
    if ident != "" {
      args = args + [ident]
    }
  }
  return "${name}(${args.join(", ")})"
}

/** Strip leading chars that are in the set string `set`. */
fn _lstrip_set(s, set) -> string {
  let n = s.len()
  var i = 0
  while i < n {
    if set.contains(s.char_at(i)) {
      i = i + 1
    } else {
      break
    }
  }
  return s.substring(i, n)
}

/**
 * Replicates re.search(r"\((.*?)\)\s*(?:->|\{)", signature, DOTALL).
 * Returns the param text (first balanced-by-position group), or "".
 */
fn _extract_params(signature) -> string {
  let n = signature.len()
  let op = signature.index_of("(")
  if op == -1 {
    return ""
  }
  /* .*? non-greedy: smallest span; find first ")" after "(" such that
     after the ")" (and optional ws) comes "->" or "{". */
  var close = op + 1
  while close < n {
    if signature.char_at(close) == ")" {
      var p = close + 1
      while p < n {
        if _is_ws(signature.char_at(p)) {
          p = p + 1
        } else {
          break
        }
      }
      if p < n {
        let c = signature.char_at(p)
        if c == "{" {
          return signature.substring(op + 1, close)
        }
        if c == "-" && p + 1 < n && signature.char_at(p + 1) == ">" {
          return signature.substring(op + 1, close)
        }
      }
    }
    close = close + 1
  }
  return ""
}

/** Split on top-level commas (depth 0 across ()[]{}<>). */
fn _split_top_level(raw) -> list {
  var out = []
  var depth = 0
  var start = 0
  let n = raw.len()
  var idx = 0
  while idx < n {
    let ch = raw.char_at(idx)
    if ch == "(" || ch == "[" || ch == "{" || ch == "<" {
      depth = depth + 1
    } else if ch == ")" || ch == "]" || ch == "}" || ch == ">" {
      depth = depth - 1
    } else if ch == "," && depth == 0 {
      out = out + [raw.substring(start, idx)]
      start = idx + 1
    }
    idx = idx + 1
  }
  out = out + [raw.substring(start, n)]
  return out
}

/** Build the inferred metadata dict for the missing keys. */
pub fn build_inferred(keys, name, signature, body, is_experimental) -> dict {
  var out = {}
  if keys.contains("effects") {
    out = out + {effects: infer_effects(body)}
  }
  if keys.contains("allocation") {
    out = out + {allocation: infer_allocation(signature)}
  }
  if keys.contains("errors") {
    out = out + {errors: "[]"}
  }
  if keys.contains("api_stability") {
    let v = if is_experimental {
      "experimental"
    } else {
      "stable"
    }
    out = out + {api_stability: v}
  }
  if keys.contains("example") {
    out = out + {example: derive_example(name, signature)}
  }
  return out
}

fn _path_is_experimental(path) -> bool {
  for frag in EXPERIMENTAL_PATH_FRAGMENTS {
    if path.contains(frag) {
      return true
    }
  }
  return false
}

/** Pure transform: text + path -> {text, stats}. */
pub fn process_file(text, path) -> dict {
  var total = 0
  var backfilled = 0
  var skipped_no_block = 0
  var already_complete = 0
  let is_experimental = _path_is_experimental(path)
  let lines = text.split("\n")
  var out = []
  var i = 0
  let n = len(lines)
  while i < n {
    let line = lines[i]
    let name = match_pub_fn(line)
    if name == "" {
      out = out + [line]
      i = i + 1
      continue
    }
    total = total + 1
    let block_end = len(out)
    let block_start = find_doc_block_start(out)
    if block_start == -1 {
      skipped_no_block = skipped_no_block + 1
      out = out + [line]
      i = i + 1
      continue
    }
    let block = out.slice(block_start, block_end)
    let existing = parse_existing_metadata(block)
    var have_all = true
    for k in META_KEYS {
      if !existing.keys().contains(k) {
        have_all = false
      }
    }
    if have_all {
      already_complete = already_complete + 1
      out = out + [line]
      i = i + 1
      continue
    }
    let body = collect_body(lines, i)
    let signature = collect_signature(lines, i)
    var missing = []
    for k in META_KEYS {
      if !existing.keys().contains(k) {
        missing = missing + [k]
      }
    }
    let inferred = build_inferred(missing, name, signature, body, is_experimental)
    let new_block = inject_metadata(block, inferred)
    out = out.slice(0, block_start) + new_block + out.slice(block_end, len(out))
    out = out + [line]
    i = i + 1
    backfilled = backfilled + 1
  }
  return {
    text: out.join("\n"),
    stats: {
      total: total,
      backfilled: backfilled,
      skipped_no_block: skipped_no_block,
      already_complete: already_complete,
    },
  }
}

/** Format a ratio as a one-decimal percent, matching Python f"{n/max(d,1):.1%}". */
pub fn pct(num, den) -> string {
  let d = if den < 1 {
    1
  } else {
    den
  }
  /* value * 1000, rounded to nearest, gives tenths of a percent. */
  let scaled = num * 1000.0 / d
  let rounded = floor(scaled + 0.5)
  let whole = to_int(floor(rounded / 10.0))
  let tenth = to_int(rounded - whole * 10)
  return "${whole}.${tenth}%"
}

pipeline main(task) {
  let stdlib = "crates/harn-stdlib/src/stdlib"
  var total = 0
  var backfilled = 0
  var skipped_no_block = 0
  var already_complete = 0
  /* rglob("*.harn") sorted: glob returns abs workspace paths; sort for
     determinism. The absolute path drives @api_stability path fragments. */
  let files = harness.fs.glob("${stdlib}/**/*.harn").sort()
  for path in files {
    let text = harness.fs.read_text(path)
    let result = process_file(text, path)
    let st = result["stats"]
    total = total + st["total"]
    backfilled = backfilled + st["backfilled"]
    skipped_no_block = skipped_no_block + st["skipped_no_block"]
    already_complete = already_complete + st["already_complete"]
    let new_text = result["text"]
    if new_text != text {
      harness.fs.write_text(path, new_text)
    }
  }
  let coverage = pct(already_complete + backfilled, total)
  __io_println(
    "public fns: ${total}; already complete: ${already_complete}; backfilled: ${backfilled}; skipped (no /** */ block): ${skipped_no_block}; final coverage: ${coverage}",
  )
  return 0
}
