// Render GitHub release notes from CHANGELOG.md for a given version.
//
// Port of scripts/render_release_notes.py. Parses the matching
// `## vX.Y.Z` section out of CHANGELOG.md, appends an install/upgrade
// block, and (when the repo + a previous version are known) a
// "Full Changelog" compare link. Writes to a file with --output or to
// stdout otherwise.
//
// Main declares the next unpublished version and CHANGELOG.md gains its section
// only in the version commit after publication. For an unpublished version this
// renders from the source's changelog.d, through the fold that later writes that
// section, so the signed candidate notes and the crate publication step read the
// same bytes from the same commit.
//
// Usage: harn run scripts/render_release_notes.harn -- \
//          --version X.Y.Z [--output PATH] [--repo owner/name]
import { compare_release } from "std/semver"
import { changelog_entries, published_changelog_versions } from "./release_changelog_entries.harn"
import {
  ReleaseFragmentFile,
  fold_candidate_changelog,
  read_fragment_files,
} from "./release_changelog_fold.harn"

const CHANGELOG = "CHANGELOG.md"

/** Drop a leading `v` so `v0.8.71` and `0.8.71` are equivalent. */
pub fn normalize_version(version: string) -> string {
  return if version.starts_with("v") {
    version.substring(1, version.len())
  } else {
    version
  }
}

/** Escape regex metacharacters so a version string matches literally. */
pub fn escape_regex(text: string) -> string {
  const specials = [".", "\\", "+", "*", "?", "(", ")", "[", "]", "{", "}", "^", "$", "|"]
  return text.split("").map(
    fn(ch) {
      if specials.contains(ch) {
        "\\" + ch
      } else {
        ch
      }
    },
  )
    .to_list()
    .join("")
}

/** Collect every canonical stable or prerelease heading version, top to bottom. */
pub fn changelog_versions(changelog: string) -> list<string> {
  return changelog_entries(changelog).map({ entry -> entry.version }).to_list()
}

/**
 * Pull the body of the `## v<version>` section: everything after the
 * heading line up to the next `## ` heading (or end of file), trimmed.
 * Throws if no such section exists.
 */
pub fn extract_section(changelog: string, version: string) -> string {
  const caps = regex_captures(
    r"(?ms)^## v" + escape_regex(version) + r"(?: \(never published\))?\n(.*)",
    changelog,
  )
  if caps.count == 0 {
    throw "error: CHANGELOG.md does not contain a section for ## v${version}"
  }
  const rest = caps[0].groups[0]
  const nexts = regex_captures(r"(?m)^## ", rest)
  const body = if nexts.count > 0 {
    rest.substring(0, nexts[0].start)
  } else {
    rest
  }
  return body.trim()
}

/**
 * Find the version released just before `version` (the next heading
 * down). Returns nil when `version` is absent or is the oldest entry.
 */
pub fn previous_version(versions: list<string>, version: string) -> string? {
  const index = versions.index_of(version)
  if index == -1 {
    return nil
  }
  return if index + 1 < versions.count {
    versions[index + 1]
  } else {
    nil
  }
}

/** Extract `owner/name` from a GitHub remote URL, or nil. */
pub fn parse_remote(url: string) -> string? {
  const caps = regex_captures(r"github\.com[:/]([^/]+/[^/.]+)(?:\.git)?$", url.trim())
  return if caps.count == 0 {
    nil
  } else {
    caps[0].groups[0]
  }
}

/**
 * Assemble the final release notes body. Mirrors the Python join:
 * trimmed section, the install block, and an optional compare link.
 */
pub fn render_notes(section: string, repo: string?, prev: string?, version: string) -> string {
  const base = [
    section.trim(),
    "",
    "## Install / Upgrade",
    "",
    "```bash",
    "cargo install harn-cli",
    "```",
  ]
  const parts = if repo != nil && prev != nil {
    base + ["", "**Full Changelog**: https://github.com/${repo}/compare/v${prev}...v${version}"]
  } else {
    base
  }
  return parts.join("\n") + "\n"
}

/**
 * The changelog holding `version`'s notes: as written when it has a section, or
 * with the fragments folded when `version` is above every published section.
 * Throws for a retired identity and for an absent version at or below the top.
 */
pub fn changelog_with_notes_for(
  changelog: string,
  files: list<ReleaseFragmentFile>,
  version: string,
) -> string {
  const refusal = "error: cannot publish notes for an absent or never-published identity"
  const entries = changelog_entries(changelog)
  for entry in entries {
    if entry.version == version {
      if entry.never_published {
        throw refusal
      }
      return changelog
    }
  }
  const published = published_changelog_versions(changelog)
  if published.count > 0 && compare_release(version, published[0] ?? "") <= 0 {
    throw refusal
  }
  const fold = fold_candidate_changelog(changelog, files, version)
  if !fold.success {
    throw "error: " + fold.findings.join("\n")
  }
  return fold.text
}

/**
 * Read `--flag value` or `--flag=value` style options out of argv.
 * Returns nil when the flag is absent.
 */
pub fn flag_value(args: list<string>, name: string) -> string? {
  const prefix = name + "="
  for item in args.enumerate() {
    const a = item.value
    if a == name && item.index + 1 < args.count {
      return args[item.index + 1]
    }
    if a.starts_with(prefix) {
      return a.substring(prefix.len(), a.len())
    }
  }
  return nil
}

pipeline main(harness: Harness, task: unknown) {
  const raw_version = flag_value(argv, "--version")
  if raw_version == nil {
    harness.stdio.eprintln(
      "usage: render_release_notes.harn --version VERSION [--output OUTPUT] [--repo REPO]",
    )
    harness.stdio.eprintln("error: the following arguments are required: --version")
    return 2
  }
  const version = normalize_version(raw_version ?? "")
  if !harness.fs.exists(CHANGELOG) {
    harness.stdio.eprintln("error: missing ${CHANGELOG}")
    return 1
  }
  const section_and_versions = try {
    const changelog = changelog_with_notes_for(
      harness.fs.read_text(CHANGELOG),
      read_fragment_files(harness.fs, "."),
      version,
    )
    {
      section: extract_section(changelog, version),
      versions: published_changelog_versions(changelog),
    }
  } catch (e) {
    harness.stdio.eprintln("${e}")
    return 1
  }
  const section = section_and_versions.section
  const versions = section_and_versions.versions
  const prev = previous_version(versions, version)
  const repo = detect_repo(harness.env, harness.process, flag_value(argv, "--repo"))
  const output = render_notes(section, repo, prev, version)
  const out_path = flag_value(argv, "--output")
  if out_path != nil {
    harness.fs.write_text(out_path ?? "", output)
  } else {
    harness.stdio.print(output)
  }
  return 0
}

/**
 * Resolve the repo slug: explicit --repo, else $GITHUB_REPOSITORY, else
 * the GitHub `owner/name` parsed from `git remote get-url origin`.
 */
fn detect_repo(env: HarnessEnv, process: HarnessProcess, explicit: string?) -> string? {
  if explicit != nil {
    return explicit
  }
  const env_repo = env.get("GITHUB_REPOSITORY")
  if env_repo != nil && (env_repo ?? "") != "" {
    return env_repo
  }
  const remote = process.run({program: "git", args: ["remote", "get-url", "origin"]})
  if !remote.success {
    return nil
  }
  return parse_remote(remote.stdout)
}
