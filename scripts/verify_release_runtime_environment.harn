import { read_yaml } from "std/fs"

type ReleaseStep = {id?: string, uses?: string, env?: dict}

type ReleaseWorkflow = {env?: dict, jobs: {publish: {env?: dict, steps: list<ReleaseStep>}}}

type ResolveReceipt = {version: string, asset: string}

fn main(harness: Harness) {
  require len(argv) == 1, "usage: verify_release_runtime_environment.harn <published-version>"
  const version = argv[0]
  const root = path_join(harness.fs.source_dir(), "..")
  const workflow: ReleaseWorkflow = schema_expect(
    read_yaml(harness.fs, path_join(root, ".github/workflows/publish-release.yml")),
    schema_of(ReleaseWorkflow),
  )
  let runtime_step: ReleaseStep? = nil
  let compiler_step: ReleaseStep? = nil
  for step in workflow.jobs.publish.steps {
    if step.id == "published-runtime" {
      require runtime_step == nil, "publisher runtime step is duplicated"
      runtime_step = step
    }
    if step.uses == "./.github/actions/rust-toolchain" {
      require compiler_step == nil, "publisher compiler setup is duplicated"
      compiler_step = step
    }
  }
  require runtime_step != nil && compiler_step != nil, "publisher entrypoints were not measured"
  require compiler_step.env?.HARN_RUSTC_FRONTEND_THREADS == "1",
    "publisher compiler setup must retain the stable front end"
  let environment: dict = {}
  for scope in [workflow.env ?? {}, workflow.jobs.publish.env ?? {}, runtime_step.env ?? {}] {
    for entry in scope.entries() {
      require type_of(entry.value) == "string", "publisher environment must contain string literals"
      const value = to_string(entry.value)
      require !value.contains("$" + "{{"),
        "publisher environment expressions need an explicit projection"
      environment[entry.key] = value
    }
  }
  const scratch = harness.fs.mkdtemp_in_workspace("release-runtime-env-")
  const args = [
    path_join(root, "scripts/bootstrap-harn.sh"),
    "resolve",
    "--version",
    version,
    "--cache-dir",
    path_join(scratch, "cache"),
    "--install-dir",
    path_join(scratch, "bin"),
  ]
  const accepted = harness.process.run(
    {program: "sh", args: args, cwd: root, env: environment, timeout_ms: 30000},
  )
  require accepted.success, "actual publisher environment failed bootstrap: " + accepted.stderr
  const receipt: ResolveReceipt = schema_expect(
    json_parse(accepted.stdout),
    schema_of(ResolveReceipt),
  )
  require receipt.version == version && receipt.asset.ends_with(".tar.xz"),
    "publisher bootstrap did not resolve the intended published archive"
  // Intentional unknown fixture, not a production setting. Match the registry's
  // retired_limit_names_are_unknown_at_startup and agent gate fixture convention.
  const unknown_setting = "HARN" + "_UNEXPECTED_RELEASE_RUNTIME_SETTING"
  for name in ["HARN_RUSTC_FRONTEND_THREADS", unknown_setting] {
    let refused_environment = environment + {}
    refused_environment[name] = "1"
    const refused = harness.process.run(
      {program: "sh", args: args, cwd: root, env: refused_environment, timeout_ms: 30000},
    )
    require refused.exit_code == 2 && refused.stderr.contains("HARN-ENV-001")
      && refused.stderr.contains(name),
      "unexpected setting did not reach its expected runtime refusal: "
      + name
  }
  harness.stdio.println(
    "PASS: publisher environment reaches pinned bootstrap; old compiler leak refuses",
  )
}
