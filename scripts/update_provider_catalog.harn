fn __load_secrets(harness: Harness, live: bool, specs: list<dict>) -> dict {
  if !live {
    return {}
  }
  let secrets = {}
  for spec in specs {
    for name in spec?.key_envs ?? [] {
      const value = harness.env.get(name)
      if value != nil {
        secrets = secrets + {[name]: value}
      }
    }
  }
  return secrets
}

/**
 * Run every configured adapter, returning the per-source `run` rows
 * plus the flat list of raw observations they emitted.
 */
pub fn run_adapters(env: dict, specs: list<dict>) -> dict {
  let runs = []
  let raw = []
  for spec in specs {
    const result = spec.run_fn(env)
    runs = runs + [result.run]
    for obs in result.observations {
      raw = raw + [obs]
    }
  }
  return {runs: runs, observations: raw}
}

fn __ensure_run_dir(harness: Harness) {
  if !harness.fs.exists(RUN_OUTPUT_DIR) {
    harness.fs.mkdir(RUN_OUTPUT_DIR)
  }
}

fn __build_meta(run_mode: string, observed_at: string) -> dict {
  return {generated_at: observed_at, run_mode: run_mode}
}

fn __compose_report(env: dict, specs: list<dict>, catalog: dict, run_mode: string) -> dict {
  const adapter_outcome = run_adapters(env, specs)
  const normalized = normalize_observations(adapter_outcome.observations)
  const drift = build_drift(normalized.observations, catalog)
  const meta = __build_meta(run_mode, env.observed_at)
  return {
    report: render_markdown_report(drift, normalized.conflicts, adapter_outcome.runs, meta),
    candidate: render_candidate_toml(drift, meta),
    drift: drift,
    runs: adapter_outcome.runs,
    observations: normalized.observations,
  }
}

fn __write_outputs(harness: Harness, outcome: dict) {
  __ensure_run_dir(harness)
  harness.fs.write_text(path_join(RUN_OUTPUT_DIR, "drift-report.md"), outcome.report)
  harness.fs.write_text(path_join(RUN_OUTPUT_DIR, "candidate.toml"), outcome.candidate)
}

fn __check_against_golden(harness: Harness, outcome: dict, update: bool) -> int {
  if update {
    harness.fs.write_text(EXPECTED_REPORT_PATH, outcome.report)
    harness.fs.write_text(EXPECTED_CANDIDATE_PATH, outcome.candidate)
    __io_println("Updated " + EXPECTED_REPORT_PATH)
    __io_println("Updated " + EXPECTED_CANDIDATE_PATH)
    return 0
  }
  const expected_report = if harness.fs.exists(EXPECTED_REPORT_PATH) {
    harness.fs.read_text(EXPECTED_REPORT_PATH)
  } else {
    ""
  }
  const expected_candidate = if harness.fs.exists(EXPECTED_CANDIDATE_PATH) {
    harness.fs.read_text(EXPECTED_CANDIDATE_PATH)
  } else {
    ""
  }
  if outcome.report != expected_report {
    __io_eprintln("provider catalog drift report drifted from " + EXPECTED_REPORT_PATH)
    __io_eprintln("Run scripts/update_provider_catalog.harn -- --check --update after reviewing.")
    return 1
  }
  if outcome.candidate != expected_candidate {
    __io_eprintln("provider catalog candidate TOML drifted from " + EXPECTED_CANDIDATE_PATH)
    __io_eprintln("Run scripts/update_provider_catalog.harn -- --check --update after reviewing.")
    return 1
  }
  return 0
}

pipeline main(task) {
  const live = argv.contains("--live")
  const check = argv.contains("--check")
  const update = argv.contains("--update")
  const specs = if live {
    __adapter_specs(live) + __live_adapter_specs()
  } else {
    __adapter_specs(live)
  }
  const observed_at = if live {
    date_now_iso()
  } else {
    FIXED_OBSERVED_AT
  }
  if !live {
    __install_fixture_mocks(harness)
  } else {
    __install_live_egress_policy()
  }
  const env_data = {
    observed_at: observed_at,
    secrets: __load_secrets(harness, live, specs),
    http_options: if live {
      {max_response_bytes: 8388608}
    } else {
      {fetched_at: FIXED_FETCHED_AT}
    },
  }
  const run_mode = if live {
    "live"
  } else {
    "fixtures"
  }
  const catalog = if live {
    llm_provider_catalog()
  } else {
    json_parse(harness.fs.read_text(BASELINE_CATALOG_PATH))
  }
  const outcome = __compose_report(env_data, specs, catalog, run_mode)
  if check {
    return __check_against_golden(harness, outcome, update)
  }
  __write_outputs(harness, outcome)
  __io_println("wrote " + path_join(RUN_OUTPUT_DIR, "drift-report.md"))
  __io_println("wrote " + path_join(RUN_OUTPUT_DIR, "candidate.toml"))
  return 0
}
