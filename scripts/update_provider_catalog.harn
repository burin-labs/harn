  const config = {
    id: "anthropic-pricing-page",
    provider: "anthropic",
    source_url: "https://www.anthropic.com/pricing",
    confidence: "high",
    terms_notes: "Public pricing page; provider-owned source.",
    column_map: [
      {header: "Model", field: "model_id"},
      {header: "Input ($/MTok)", field: "input_per_mtok"},
      {header: "Output ($/MTok)", field: "output_per_mtok"},
