  return {run_fn: { env -> json_api_adapter(env, config) }}
}

fn __fireworks_spec() {
  const config = {
    id: "fireworks-models-api",
    kind: "json",
    source_owner: "provider",
    source_url: "https://api.fireworks.ai/inference/v1/models",
    key_envs: ["FIREWORKS_API_KEY"],
    adapter: __fireworks_adapter,
  }
  return {key_envs: config.key_envs, run_fn: { env -> key_required_adapter(env, config) }}
}

fn __adapter_specs(live) {
  if live {
    return [__openrouter_spec(), __fireworks_spec()]
  }
  return [__anthropic_spec(), __openai_spec(), __openrouter_spec(), __fireworks_spec()]
}

