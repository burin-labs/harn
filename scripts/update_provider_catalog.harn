// Provider catalog refresh entry script.
//
// Runs a configured set of source adapters, normalizes the
// observations against `llm_provider_catalog()`, and writes:
//
//   .harn-runs/provider_catalog/drift-report.md
//   .harn-runs/provider_catalog/candidate.toml
//
// Usage:
//
//   harn run scripts/update_provider_catalog.harn               # fixtures
//   harn run scripts/update_provider_catalog.harn -- --live     # live sources
//   harn run scripts/update_provider_catalog.harn -- --check    # compare
//                                                                 against
//                                                                 committed
//                                                                 golden
//
// `--check` is the CI gate that powers `make check-provider-catalog-drift`.
// It runs with the bundled fixtures and verifies the generated
// markdown report matches the committed golden file under
// `scripts/provider_catalog_fixtures/expected_drift_report.md`. Run
// `--check --update` to refresh the golden after intentional adapter
// or library changes.
import "./provider_catalog_refresh.harn"
import "./provider_catalog_sources.harn"

const RUN_OUTPUT_DIR = ".harn-runs/provider_catalog"

const FIXTURE_DIR = "scripts/provider_catalog_fixtures"

const EXPECTED_REPORT_PATH = "scripts/provider_catalog_fixtures/expected_drift_report.md"

const EXPECTED_CANDIDATE_PATH = "scripts/provider_catalog_fixtures/expected_candidate.toml"

const BASELINE_CATALOG_PATH = "scripts/provider_catalog_fixtures/baseline_catalog.json"

const FIXED_OBSERVED_AT = "2026-05-11T00:00:00Z"

const FIXED_FETCHED_AT = "fixture-time"

fn __install_fixture_mocks(harness: Harness) {
  http_mock_clear()
  egress_policy(
    {allow: ["www.anthropic.com", "platform.openai.com", "openrouter.ai"], default: "deny"},
  )
  http_mock(
    "GET",
    "https://www.anthropic.com/pricing",
    {
      status: 200,
      headers: {
        "content-type": "text/html; charset=utf-8",
        etag: "\"fixture\"",
        "last-modified": "Mon, 11 May 2026 00:00:00 GMT",
      },
      body: harness.fs.read_text(path_join(FIXTURE_DIR, "anthropic_pricing.html")),
    },
  )
  http_mock(
    "GET",
    "https://platform.openai.com/docs/pricing",
    {
      status: 200,
      headers: {
        "content-type": "text/html; charset=utf-8",
        etag: "\"fixture\"",
        "last-modified": "Mon, 11 May 2026 00:00:00 GMT",
      },
      body: harness.fs.read_text(path_join(FIXTURE_DIR, "openai_pricing.html")),
    },
  )
  http_mock(
    "GET",
    "https://openrouter.ai/api/v1/models",
    {
      status: 200,
      headers: {
        "content-type": "application/json",
        etag: "\"fixture\"",
        "last-modified": "Mon, 11 May 2026 00:00:00 GMT",
      },
      body: harness.fs.read_text(path_join(FIXTURE_DIR, "openrouter_models.json")),
    },
  )
}

