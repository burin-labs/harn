fn __openrouter_spec() {
  const config = {
    id: "openrouter-models-api",
    provider: "openrouter",
    source_url: "https://openrouter.ai/api/v1/models",
    source_owner: "aggregator",
    confidence: "medium",
    terms_notes: "OpenRouter public /models index; secondary triangulation source.",
    mapper: __openrouter_mapper,
  }
  return {run_fn: { harness, env -> json_api_adapter(harness, env, config) }}
}

fn __fireworks_spec() {
  const config = {
    id: "fireworks-models-api",
    kind: "json",
    source_owner: "provider",
    source_url: "https://api.fireworks.ai/inference/v1/models",
    key_envs: ["FIREWORKS_API_KEY"],
    adapter: __fireworks_adapter,
  }
  return {
    key_envs: config.key_envs,
    run_fn: { harness, env -> key_required_adapter(harness, env, config) },
  }
}

fn __fixture_adapter_specs() {
  return [__anthropic_spec(), __openai_spec(), __openrouter_spec(), __fireworks_spec()]
}

pub fn prepare_model_index_sources(configuration: unknown, catalog: dict) -> PreparedModelSources {
  const configured = schema_expect(configuration, schema_of(ModelIndexSources))
  if configured.sources.count == 0 {
    throw "provider model-index source registry is empty"
  }
  const mappers = {
    generic: __generic_models_mapper,
    gemini: __gemini_models_mapper,
    xai: __xai_models_mapper,
    together: __together_models_mapper,
    cerebras: __cerebras_models_mapper,
    fireworks: __fireworks_mapper,
    openrouter: __openrouter_mapper,
  }
  let specs = []
  let seen = []
  for source in configured.sources {
    if seen.contains(source.id) {
      throw "duplicate provider source id: " + source.id
    }
    seen = seen + [source.id]
    const provider = catalog.providers.find({ row -> row.id == source.provider })
    if provider == nil {
      throw "provider source names an unknown catalog provider: " + source.provider
    }
    const header_auth = provider.auth.style == "header"
    specs = specs
      + [
        __models_spec(
          source.id,
          source.provider,
          source.source_url,
          provider.auth.env,
          {
            confidence: source.confidence,
            terms_notes: source.terms_notes,
            source_owner: source.source_owner,
            requires_key: source.requires_key,
            extra_headers: source.extra_headers,
            auth_header: if header_auth {
              provider.auth.header
            } else {
              nil
            },
            auth_prefix: if header_auth {
              ""
            } else {
              nil
            },
            mapper: mappers[source.mapper],
          },
        ),
      ]
  }
  return {specs: specs, egress_hosts: configured.egress_hosts}
}

fn __load_secrets(env: HarnessEnv, live: bool, specs: list<dict>) -> dict {
  if !live {
    return {}
  }
  let secrets = {}
  for spec in specs {
    for name in spec?.key_envs ?? [] {
      const value = env.get(name)
      if value != nil {
        secrets = secrets + {[name]: value}
      }
    }
  }
  return secrets
}

/**
 * Run every configured adapter, returning the per-source `run` rows
 * plus the flat list of raw observations they emitted.
 */
pub fn run_adapters(harness: Harness, env: dict, specs: list<dict>) -> dict {
  let runs = []
  let raw = []
  for spec in specs {
    const result = spec.run_fn(harness, env)
    runs = runs + [result.run + {observation_count: len(result.observations)}]
    for obs in result.observations {
      raw = raw + [obs]
    }
  }
  return {runs: runs, observations: raw}
}

fn __ensure_run_dir(fs: HarnessFs) {
  if !fs.exists(RUN_OUTPUT_DIR) {
    fs.mkdir(RUN_OUTPUT_DIR)
  }
}

fn __build_meta(run_mode: string, observed_at: string) -> dict {
  return {generated_at: observed_at, run_mode: run_mode}
}

fn __refresh_summary(meta: dict, runs: list<dict>, observations: list<dict>, drift: dict) -> dict {
  return {
    schema_version: 1,
    run_mode: meta.run_mode,
    generated_at: meta.generated_at,
    coverage: refresh_coverage(runs, len(observations)),
    drift: {
      added: len(drift.added),
      removed: len(drift.removed),
      changed: len(drift.changed),
      unknown_pricing: len(drift.unknown_pricing),
    },
    artifacts: {
      manifest: path_join(RUN_OUTPUT_DIR, "refresh.json"),
      report: path_join(RUN_OUTPUT_DIR, "drift-report.md"),
      candidate: path_join(RUN_OUTPUT_DIR, "candidate.toml"),
    },
  }
}

fn __compose_report(
  harness: Harness,
  env: dict,
  specs: list<dict>,
  catalog: dict,
  run_mode: string,
) -> dict {
  const adapter_outcome = run_adapters(harness, env, specs)
  const normalized = normalize_observations(adapter_outcome.observations)
  const drift = build_drift(normalized.observations, catalog)
  const meta = __build_meta(run_mode, env.observed_at)
  const summary = __refresh_summary(meta, adapter_outcome.runs, normalized.observations, drift)
  return {
    report: render_markdown_report(drift, normalized.conflicts, adapter_outcome.runs, meta),
    candidate: render_candidate_toml(drift, meta),
    drift: drift,
    runs: adapter_outcome.runs,
    observations: normalized.observations,
    conflicts: normalized.conflicts,
    summary: summary,
  }
}

fn __write_outputs(fs: HarnessFs, outcome: dict) {
  __ensure_run_dir(fs)
  fs.write_text(path_join(RUN_OUTPUT_DIR, "drift-report.md"), outcome.report)
  fs.write_text(path_join(RUN_OUTPUT_DIR, "candidate.toml"), outcome.candidate)
  fs.write_text(
    path_join(RUN_OUTPUT_DIR, "refresh.json"),
    json_stringify(
      {
        summary: outcome.summary,
        adapters: outcome.runs,
        observations: outcome.observations,
        drift: outcome.drift,
        conflicts: outcome.conflicts,
      },
    )
      + "\n",
  )
}

fn __check_against_golden(fs: HarnessFs, stdio: HarnessStdio, outcome: dict, update: bool) -> int {
  if update {
    fs.write_text(EXPECTED_REPORT_PATH, outcome.report)
    fs.write_text(EXPECTED_CANDIDATE_PATH, outcome.candidate)
    stdio.println("Updated " + EXPECTED_REPORT_PATH)
    stdio.println("Updated " + EXPECTED_CANDIDATE_PATH)
    return 0
  }
  const expected_report = if fs.exists(EXPECTED_REPORT_PATH) {
    fs.read_text(EXPECTED_REPORT_PATH)
  } else {
    ""
  }
  const expected_candidate = if fs.exists(EXPECTED_CANDIDATE_PATH) {
    fs.read_text(EXPECTED_CANDIDATE_PATH)
  } else {
    ""
  }
  if outcome.report != expected_report {
    stdio.eprintln("provider catalog drift report drifted from " + EXPECTED_REPORT_PATH)
    stdio.eprintln("Run scripts/update_provider_catalog.harn -- --check --update after reviewing.")
    return 1
  }
  if outcome.candidate != expected_candidate {
    stdio.eprintln("provider catalog candidate TOML drifted from " + EXPECTED_CANDIDATE_PATH)
    stdio.eprintln("Run scripts/update_provider_catalog.harn -- --check --update after reviewing.")
    return 1
  }
  return 0
}

pipeline main(harness: Harness, task: unknown) {
  const live = argv.contains("--live")
  const check = argv.contains("--check")
  const update = argv.contains("--update")
  const json = argv.contains("--json")
  const provider_catalog = harness.llm.provider_catalog()
  const model_sources = prepare_model_index_sources(
    json_parse(harness.fs.read_text("spec/provider-catalog-refresh-sources.json")),
    provider_catalog,
  )
  const specs = if live {
    model_sources.specs
  } else {
    __fixture_adapter_specs()
  }
  const observed_at = if live {
    harness.clock.date_iso()
  } else {
    FIXED_OBSERVED_AT
  }
  const scoped_harness = if !live {
    __install_fixture_mocks(harness)
  } else {
    __install_live_egress_policy(harness, model_sources.egress_hosts)
  }
  const env_data = {
    observed_at: observed_at,
    secrets: __load_secrets(harness.env, live, specs),
    http_options: if live {
      {max_response_bytes: 8388608}
    } else {
      {fetched_at: FIXED_FETCHED_AT}
    },
  }
  const run_mode = if live {
    "live"
  } else {
    "fixtures"
  }
  const catalog = if live {
    provider_catalog
  } else {
    json_parse(scoped_harness.fs.read_text(BASELINE_CATALOG_PATH))
  }
  const outcome = __compose_report(scoped_harness, env_data, specs, catalog, run_mode)
  if check {
    return __check_against_golden(harness.fs, harness.stdio, outcome, update)
  }
  __write_outputs(harness.fs, outcome)
  if json {
    harness.stdio.println(json_stringify(outcome.summary))
  } else {
    harness.stdio.println("wrote " + path_join(RUN_OUTPUT_DIR, "drift-report.md"))
    harness.stdio.println("wrote " + path_join(RUN_OUTPUT_DIR, "candidate.toml"))
    harness.stdio.println("wrote " + path_join(RUN_OUTPUT_DIR, "refresh.json"))
  }
  if live && outcome.summary.coverage.models_observed == 0 {
    harness.stdio.eprintln("provider catalog refresh observed no models; no live catalog evidence")
    return 1
  }
  return 0
}
