// Provider catalog refresh entry script.
//
// Runs a configured set of source adapters, normalizes the
// observations against `harness.llm.provider_catalog()`, and writes:
//
//   .harn-runs/provider_catalog/drift-report.md
//   .harn-runs/provider_catalog/candidate.toml
//   .harn-runs/provider_catalog/refresh.json
//
// Usage:
//
//   harn run --allow-process-network scripts/update_provider_catalog.harn
//   harn run --allow-process-network scripts/update_provider_catalog.harn -- --live
//   harn run --allow-process-network scripts/update_provider_catalog.harn -- --check
//
// `--check` is the CI gate that powers `make check-provider-catalog-drift`.
// It runs with the bundled fixtures and verifies the generated
// markdown report matches the committed golden file under
// `scripts/provider_catalog_fixtures/expected_drift_report.md`. Run
// `--check --update` to refresh the golden after intentional adapter
// or library changes.
import "./provider_catalog_refresh.harn"
import "./provider_catalog_sources.harn"

const RUN_OUTPUT_DIR = ".harn-runs/provider_catalog"

const FIXTURE_DIR = "scripts/provider_catalog_fixtures"

const EXPECTED_REPORT_PATH = "scripts/provider_catalog_fixtures/expected_drift_report.md"

const EXPECTED_CANDIDATE_PATH = "scripts/provider_catalog_fixtures/expected_candidate.toml"

const BASELINE_CATALOG_PATH = "scripts/provider_catalog_fixtures/baseline_catalog.json"

const FIXED_OBSERVED_AT = "2026-05-11T00:00:00Z"

const FIXED_FETCHED_AT = "fixture-time"

pub type ModelIndexSource = {
  id: string,
  provider: string,
  source_url: string,
  mapper: "generic" | "gemini" | "xai" | "together" | "cerebras" | "fireworks" | "openrouter",
  terms_notes: string,
  source_owner?: "provider" | "aggregator",
  requires_key?: bool,
  confidence?: "high" | "medium" | "low",
  extra_headers?: dict<string, string>,
}

pub type ModelIndexSources = {
  schema: "harn.provider_catalog_refresh_sources.v1",
  egress_hosts: list<string>,
  sources: list<ModelIndexSource>,
}

pub type PreparedModelSources = {specs: list<dict>, egress_hosts: list<string>}

fn __install_fixture_mocks(harness: Harness) -> Harness {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://www.anthropic.com/pricing",
    {
      status: 200,
      headers: {
        "content-type": "text/html; charset=utf-8",
        etag: "\"fixture\"",
        "last-modified": "Mon, 11 May 2026 00:00:00 GMT",
      },
      body: harness.fs.read_text(path_join(FIXTURE_DIR, "anthropic_pricing.html")),
    },
  )
  harness.testing.http_mock(
    "GET",
    "https://platform.openai.com/docs/pricing",
    {
      status: 200,
      headers: {
        "content-type": "text/html; charset=utf-8",
        etag: "\"fixture\"",
        "last-modified": "Mon, 11 May 2026 00:00:00 GMT",
      },
      body: harness.fs.read_text(path_join(FIXTURE_DIR, "openai_pricing.html")),
    },
  )
  harness.testing.http_mock(
    "GET",
    "https://openrouter.ai/api/v1/models",
    {
      status: 200,
      headers: {
        "content-type": "application/json",
        etag: "\"fixture\"",
        "last-modified": "Mon, 11 May 2026 00:00:00 GMT",
      },
      body: harness.fs.read_text(path_join(FIXTURE_DIR, "openrouter_models.json")),
    },
  )
  harness.net.egress_policy(
    {allow: ["www.anthropic.com", "platform.openai.com", "openrouter.ai"], default: "deny"},
  )
  return harness
}

fn __install_live_egress_policy(harness: Harness, hosts: list<string>) -> Harness {
  harness.net.egress_policy({allow: hosts, default: "deny"})
  return harness
}

fn __rate_per_mtok_from_per_token(value: any) {
  if value == nil {
    return nil
  }
  // OpenRouter quotes pricing as USD per token in a string; multiply
  // to per-million-tokens and round to a stable 6-digit precision so
  // float artifacts don't show up in committed candidate diffs.
  return round(to_float(value) * 1000000.0 * 1000000.0) / 1000000.0
}

fn __openrouter_mapper(payload: dict) {
  let entries = []
  for record in payload?.data ?? [] {
    const id = record?.id
    if id == nil || id == "" {
      continue
    }
    const pricing = record?.pricing
    let pricing_dict = {}
    const input_rate = __rate_per_mtok_from_per_token(pricing?.prompt)
    const output_rate = __rate_per_mtok_from_per_token(pricing?.completion)
    const cache_read = __rate_per_mtok_from_per_token(pricing?.input_cache_read)
    const cache_write = __rate_per_mtok_from_per_token(pricing?.input_cache_write)
    if input_rate != nil {
      pricing_dict = pricing_dict + {input_per_mtok: input_rate}
    }
    if output_rate != nil {
      pricing_dict = pricing_dict + {output_per_mtok: output_rate}
    }
    if cache_read != nil {
      pricing_dict = pricing_dict + {cache_read_per_mtok: cache_read}
    }
    if cache_write != nil {
      pricing_dict = pricing_dict + {cache_write_per_mtok: cache_write}
    }
    const pricing_value = if len(pricing_dict) == 0 {
      nil
    } else {
      openrouter_scheduled_pricing(pricing ?? {}, pricing_dict)
    }
    const entry = {
      provider: record?.provider ?? "openrouter",
      model_id: id,
      name: record?.name,
      context_window: record?.context_length,
      pricing: pricing_value,
    }
    entries = entries + [entry]
  }
  return entries
}

/**
 * `dict?`, not `dict`: every caller passes `record?.pricing`, and a provider
 * record without a rate card yields nil. A non-nullable parameter is refused
 * at the call boundary before the body runs, so the guard below was dead code
 * and the whole live run died on the first priceless record.
 */
fn __pricing_from_per_token_record(pricing: dict?) {
  if pricing == nil {
    return nil
  }
  let pricing_dict = {}
  const input_rate = __rate_per_mtok_from_per_token(pricing?.prompt ?? pricing?.input)
  const output_rate = __rate_per_mtok_from_per_token(pricing?.completion ?? pricing?.output)
  const cache_read = __rate_per_mtok_from_per_token(
    pricing?.input_cache_read ?? pricing?.cache_read,
  )
  const cache_write = __rate_per_mtok_from_per_token(
    pricing?.input_cache_write ?? pricing?.cache_write,
  )
  if input_rate != nil {
    pricing_dict = pricing_dict + {input_per_mtok: input_rate}
  }
  if output_rate != nil {
    pricing_dict = pricing_dict + {output_per_mtok: output_rate}
  }
  if cache_read != nil {
    pricing_dict = pricing_dict + {cache_read_per_mtok: cache_read}
  }
  if cache_write != nil {
    pricing_dict = pricing_dict + {cache_write_per_mtok: cache_write}
  }
  if len(pricing_dict) == 0 {
    return nil
  }
  return pricing_dict
}

/** `dict?` for the same reason as `__pricing_from_per_token_record` above. */
fn __pricing_from_mtok_record(record: dict?) {
  if record == nil {
    return nil
  }
  let pricing_dict = {}
  const input_rate = record?.input_per_mtok ?? record?.input_per_million_tokens
  const output_rate = record?.output_per_mtok ?? record?.output_per_million_tokens
  const cache_read = record?.cache_read_per_mtok ?? record?.cached_input_per_mtok
  const cache_write = record?.cache_write_per_mtok
  if input_rate != nil {
    pricing_dict = pricing_dict + {input_per_mtok: to_float(input_rate)}
  }
  if output_rate != nil {
    pricing_dict = pricing_dict + {output_per_mtok: to_float(output_rate)}
  }
  if cache_read != nil {
    pricing_dict = pricing_dict + {cache_read_per_mtok: to_float(cache_read)}
  }
  if cache_write != nil {
    pricing_dict = pricing_dict + {cache_write_per_mtok: to_float(cache_write)}
  }
  if len(pricing_dict) == 0 {
    return nil
  }
  return pricing_dict
}

fn __generic_models_mapper(payload: dict) {
  let entries = []
  const records = if type_of(payload) == "list" {
    payload
  } else {
    payload?.data ?? payload?.models ?? []
  }
  for record in records {
    const id = record?.id ?? record?.slug ?? record?.model_name ?? record?.name
    if id == nil || id == "" {
      continue
    }
    const context = record?.context_length
      ?? record?.context_window
      ?? record?.max_context_length
      ?? record?.max_model_len
      ?? record?.max_input_tokens
    let pricing_value = __pricing_from_per_token_record(record?.pricing)
    if pricing_value == nil {
      pricing_value = __pricing_from_mtok_record(record)
    }
    const entry = {
      model_id: id,
      name: record?.display_name ?? record?.name ?? record?.id,
      context_window: context,
      pricing: pricing_value,
    }
    entries = entries + [entry]
  }
  return entries
}

fn __gemini_models_mapper(payload: dict) {
  let entries = []
  for record in payload?.models ?? [] {
    const resource = record?.name ?? ""
    const id = if starts_with(resource, "models/") {
      resource.slice(7)
    } else {
      resource
    }
    if id != "" {
      entries = entries
        + [{model_id: id, name: record?.displayName ?? id, context_window: record?.inputTokenLimit}]
    }
  }
  return entries
}

/**
 * Cerebras publishes a richer keyless index at `/public/v1/models` than the
 * key-scoped `/v1/models`, which returns bare ids. The public record carries
 * per-token pricing, capabilities, a `deprecated` flag, and the context
 * window — but nested under `limits.max_context_length`, which the generic
 * mapper does not reach.
 */
fn __cerebras_models_mapper(payload: dict) {
  let entries = []
  for record in payload?.data ?? [] {
    const id = record?.id
    if id == nil || id == "" {
      continue
    }
    entries = entries
      + [
        {
          model_id: id,
          name: record?.name ?? id,
          context_window: record?.limits?.max_context_length,
          pricing: __pricing_from_per_token_record(record?.pricing),
        },
      ]
  }
  return entries
}

/**
 * xAI reports per-token rates as integers in units of 1e-10 USD per token,
 * which is 1e-4 USD per million tokens: `prompt_text_token_price: 12500`
 * is $1.25/MTok. The generic mapper reads neither that scale nor the field
 * names, so an xAI run without this mapper observes ids and context windows
 * with every rate missing — and a missing rate is not a drift, so the report
 * reads clean.
 */
fn __xai_models_mapper(payload: dict) {
  let entries = []
  for record in payload?.data ?? [] {
    const id = record?.id
    if id == nil || id == "" {
      continue
    }
    let pricing_dict = {}
    if record?.prompt_text_token_price != nil {
      pricing_dict = pricing_dict
        + {input_per_mtok: to_float(record.prompt_text_token_price) / 10000.0}
    }
    if record?.completion_text_token_price != nil {
      pricing_dict = pricing_dict
        + {output_per_mtok: to_float(record.completion_text_token_price) / 10000.0}
    }
    if record?.cached_prompt_text_token_price != nil {
      pricing_dict = pricing_dict
        + {cache_read_per_mtok: to_float(record.cached_prompt_text_token_price) / 10000.0}
    }
    entries = entries
      + [
        {
          model_id: id,
          name: record?.id,
          context_window: record?.context_length,
          pricing: if len(pricing_dict) == 0 {
            nil
          } else {
            pricing_dict
          },
        },
      ]
  }
  return entries
}

fn __together_models_mapper(payload: list?) {
  let entries = []
  for record in payload ?? [] {
    const id = record?.id
    if id != nil && id != "" {
      entries = entries
        + [
          {
            model_id: id,
            name: record?.display_name ?? id,
            context_window: record?.context_length,
            pricing: __pricing_from_mtok_record(record?.pricing),
          },
        ]
    }
  }
  return entries
}

fn __fireworks_mapper(payload: dict) {
  let entries = []
  for record in payload?.data ?? [] {
    if record?.id != nil {
      entries = entries + [{model_id: record.id, name: record?.name}]
    }
  }
  return entries
}

fn __fireworks_adapter(harness: Harness, env: dict) {
  const config = {
    id: "fireworks-models-api",
    provider: "fireworks",
    source_url: "https://api.fireworks.ai/inference/v1/models",
    source_owner: "provider",
    confidence: "high",
    terms_notes: "Requires FIREWORKS_API_KEY; uses the standard /models endpoint.",
    mapper: __fireworks_mapper,
  }
  return json_api_adapter(harness, env, config)
}

fn __models_spec(
  id: string,
  provider: string,
  source_url: string,
  key_envs: list<string>,
  options: dict,
) -> dict {
  const config = {
    id: id,
    kind: "json",
    provider: provider,
    source_owner: options?.source_owner ?? "provider",
    source_url: source_url,
    key_envs: key_envs,
    confidence: options?.confidence ?? "high",
    terms_notes: options?.terms_notes ?? "Provider-owned /models endpoint.",
    auth_header: options?.auth_header,
    auth_prefix: options?.auth_prefix,
    extra_headers: options?.extra_headers,
    mapper: options?.mapper ?? __generic_models_mapper,
  }
  const adapter = { harness, env ->
    json_api_adapter(
      harness,
      env,
      pick(
        config,
        ["id", "provider", "source_url", "source_owner", "confidence", "terms_notes", "mapper"],
      ),
    )
  }
  if options?.requires_key == false {
    return {key_envs: [], run_fn: adapter}
  }
  return {
    key_envs: config.key_envs,
    run_fn: { harness, env -> key_required_adapter(harness, env, config + {adapter: adapter}) },
  }
}

