fn __openrouter_spec() {
  const config = {
    id: "openrouter-models-api",
    provider: "openrouter",
    source_url: "https://openrouter.ai/api/v1/models",
    source_owner: "aggregator",
    confidence: "medium",
    terms_notes: "OpenRouter public /models index; secondary triangulation source.",
    mapper: __openrouter_mapper,
