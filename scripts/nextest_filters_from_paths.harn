import { help_requested, parse, parser } from "std/cli/argparse"

type TestTarget = {name: string, path: string}

type WorkspacePackage = {dir: string, name: string, tests: list<TestTarget>}

fn command_stdout(
  process: HarnessProcess,
  command: {program: string, args: list<string>, env: dict?},
) -> string {
  const result = process.run(command)
  if result.exit_code != 0 {
    throw command.program + " " + command.args.join(" ") + " failed:\n" + result.stderr
  }
  return result.stdout
}

fn repo_root(process: HarnessProcess) -> string {
  return command_stdout(process, {program: "git", args: ["rev-parse", "--show-toplevel"], env: {}})
    .trim()
}

fn rel_path(path: string, root: string) -> string {
  const normalized = replace(path_normalize(path), "\\", "/")
  const normalized_root = replace(path_normalize(root), "\\", "/")
  const prefix = normalized_root + "/"
  if normalized == normalized_root {
    return "."
  }
  if normalized.starts_with(prefix) {
    return normalized[len(prefix):]
  }
  return normalized
}

fn normalize_input_path(path: string) -> string {
  let normalized = replace(path_normalize(path), "\\", "/")
  while normalized.starts_with("./") {
    normalized = normalized[2:]
  }
  return normalized
}

pub fn workspace_packages_from_metadata(meta: dict, root: string) -> list<WorkspacePackage> {
  const members = meta?.workspace_members ?? []
  let member_ids: list<string> = []
  for member in members {
    member_ids = member_ids + [to_string(member)]
  }
  let packages: list<WorkspacePackage> = []
  for package in meta?.packages ?? [] {
    const id = to_string(package.id)
    if !member_ids.contains(id) {
      continue
    }
    const name = to_string(package.name)
    const manifest_path = to_string(package.manifest_path)
    if name == "" || manifest_path == "" {
      continue
    }
    let tests: list<TestTarget> = []
    for target in package?.targets ?? [] {
      if (target?.kind ?? []).contains("test") {
        tests.push({name: to_string(target.name), path: rel_path(to_string(target.src_path), root)})
      }
    }
    packages.push({dir: rel_path(dirname(manifest_path) ?? ".", root), name: name, tests: tests})
  }
  if len(packages) == 0 {
    throw "Cargo metadata contains no workspace packages"
  }
  return packages.sorted_by({ package -> package.dir })
}

fn load_workspace_packages(process: HarnessProcess, root: string) -> list<WorkspacePackage> {
  const raw = command_stdout(
    process,
    {
      program: "cargo",
      args: [
        "metadata",
        "--locked",
        "--no-deps",
        "--format-version",
        "1",
        "--manifest-path",
        path_join(root, "Cargo.toml"),
      ],
      // This metadata-only path intentionally avoids the repository toolchain:
      // the audit lane consumes a prebuilt Harn CLI and grants process writes
      // only inside the checkout. Letting rustup select rust-toolchain.toml can
      // otherwise attempt a networked install under ~/.rustup, which is both
      // unnecessary for manifest inspection and correctly denied by the
      // process sandbox.
      env: {RUSTUP_TOOLCHAIN: "stable"},
    },
  )
  return workspace_packages_from_metadata(json_parse(raw), root)
}

fn add_filter(filters: list<string>, filter: string) -> list<string> {
  if filters.contains(filter) {
    return filters
  }
  return filters + [filter]
}

pub fn filter_for_path(raw_path: string, packages: list<WorkspacePackage>) -> string? {
  const path = normalize_input_path(raw_path)
  if path == "" || !path.ends_with(".rs") {
    return nil
  }
  for package in packages.sorted_by({ package -> -len(package.dir) }) {
    if !path.starts_with("${package.dir}/") {
      continue
    }
    for target in package.tests {
      const modules = if basename(target.path) == "main.rs" {
        dirname(target.path)
      } else {
        target.path[:-3]
      }
      if path == target.path || path.starts_with("${modules}/") {
        return "binary(${target.name})"
      }
    }
    // Deleted and consolidated targets still select their current owning package.
    return "package(${package.name})"
  }
  return nil
}

pub fn nextest_filter_for_paths(paths: list<string>, packages: list<WorkspacePackage>) -> string {
  let filters: list<string> = []
  for path in paths {
    const filter = filter_for_path(path, packages)
    if filter != nil {
      filters = add_filter(filters, filter)
    }
  }
  return filters.join(" or ")
}

fn arg_spec() {
  return parser(
    {
      name: "nextest_filters_from_paths",
      args: [
        {kind: "flag", name: "root", long: "--root", parse: "string", default: ""},
        {
          kind: "positional",
          name: "paths",
          parse: "string",
          required: false,
          variadic: true,
          default: [],
        },
      ],
    },
  )
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/nextest_filters_from_paths.harn -- [--root PATH] [file ...]",
    )
    return nil
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    harness.runtime.exit(2)
  }
  const invocation = unwrap(parsed_result)
  const parsed = invocation.options
  const paths = parsed.paths + invocation.rest
  if paths.count == 0 {
    return nil
  }
  const root = if to_string(parsed?.root ?? "") == "" {
    repo_root(harness.process)
  } else {
    path_normalize(to_string(parsed?.root ?? ""))
  }
  const filter = nextest_filter_for_paths(
    paths.map({ path -> to_string(path) }).to_list(),
    load_workspace_packages(harness.process, root),
  )
  if filter != "" {
    harness.stdio.println(filter)
  }
  return nil
}
