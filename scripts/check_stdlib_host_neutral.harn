import { baseline_delta, baseline_lines } from "./lib/text_baseline.harn"

pub fn host_specific_lines(path: string, source: string) -> list<string> {
  let found: list<string> = []
  for line in source.split("\n") {
    if regex_match(r"(^|[^a-z0-9_])burin(-code)?([^a-z0-9_]|$)|\.burin|burin_", line, "i") {
      found = found + ["./${path}:${line}"]
    }
  }
  return found
}

fn main(harness: Harness) {
  const root = harness.fs.workspace_canonicalize_existing(
    harness.env.get("HARN_EXT_STDLIB_HOST_NEUTRAL_ROOT") ?? "crates/harn-stdlib/src/stdlib",
  )
  if root == nil {
    throw "embedded stdlib root is missing or inaccessible"
  }
  const baseline = harness.env.get("HARN_EXT_STDLIB_HOST_NEUTRAL_BASELINE")
    ?? "scripts/stdlib-host-specific-compatibility.txt"
  const expected = baseline_lines(harness.fs.read_text(baseline))
  let actual: list<string> = []
  let scanned = 0
  // scan-refused: the filtered source-file census below refuses zero.
  for path in harness.fs.glob("**/*", {base: root}) {
    if !(path.ends_with(".harn") || path.ends_with(".rs") || path.ends_with(".md")) {
      continue
    }
    if !harness.fs.stat(path).is_file {
      continue
    }
    scanned = scanned + 1
    const canonical = harness.fs.workspace_canonicalize_existing(path)
    if canonical == nil {
      throw "scanned source disappeared: ${path}"
    }
    const relative = canonical.substring(root.len() + 1)
    actual = actual + host_specific_lines(relative, harness.fs.read_text(path))
  }
  if scanned == 0 {
    throw "embedded stdlib host-neutral scan refused: no source files scanned"
  }
  const delta = baseline_delta(expected, actual)
  if delta.added.count + delta.removed.count > 0 {
    for line in delta.added {
      harness.stdio.eprintln("unreviewed: " + line)
    }
    for line in delta.removed {
      harness.stdio.eprintln("stale baseline: " + line)
    }
    throw "embedded stdlib contains an unreviewed host-specific name or stale baseline"
  }
  harness.stdio.println(
    "embedded stdlib host-neutral scan passed (${scanned} files scanned, ${actual.count} reviewed lines)",
  )
}
