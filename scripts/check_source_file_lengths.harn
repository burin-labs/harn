import { help_requested, parse, parser } from "std/cli/argparse"

const MAX_LINES = 1500

const LEGACY_INVENTORY_PATH = "scripts/source-file-length-legacy.json"

const LEGACY_INVENTORY_VERSION = 1

const HISTORICAL_BASELINE_DIR = "scripts/source-file-length-baseline"

const SKIP_DIR_NAMES = [
  ".burin",
  ".git",
  ".harn",
  ".harn-runs",
  ".harn-toolchain-cache",
  "node_modules",
]

const CARGO_TARGET_DIR_NAMES = [".target", "target"]

const CARGO_TARGET_DIR_PREFIXES = [".target-"]

const WORKTREE_CARGO_TARGET_DIR_PREFIX = "target-"

const CARGO_TARGET_ARTIFACT_DIR_NAMES = ["debug", "release"]

const GENERATED_SOURCE_PREFIXES = ["spec/protocol-artifacts/"]

/** The only tree whose `.harn` sources the ratchet governs. */
pub const STDLIB_SOURCE_DIR = "crates/harn-stdlib/src/stdlib"

pub type SourceCount = {path: string, lines: int}

pub type BaseSourceCount = {path: string, approved: bool, lines?: int, error?: string}

pub type SourceLengthFindingKind = "invalid_legacy_inventory" \
  | "legacy_path_missing" \
  | "base_source_missing" \
  | "obsolete_legacy_path" \
  | "new_oversized_source" \
  | "growth" \
  | "unscanned_source" \
  | "base_unavailable" \
  | "reconciliation_unavailable"

pub type SourceLengthFinding = {
  kind: SourceLengthFindingKind,
  path: string,
  actual?: int,
  ceiling?: int,
  message: string,
}

pub type SourceLengthReport = {
  root: string,
  max_lines: int,
  source_count: int,
  legacy_count: int,
  oversized_count: int,
  comparison: string,
  base_revision?: string,
  findings: list<SourceLengthFinding>,
}

fn repo_root(fs: HarnessFs) -> string {
  return path_normalize(path_join(fs.source_dir(), ".."))
}

/** Count logical lines, including a final line without a trailing newline. */
pub fn logical_line_count(text: string) -> int {
  if text == "" {
    return 0
  }
  const parts = text.split("\n")
  if text.ends_with("\n") {
    return parts.count - 1
  }
  return parts.count
}

/** Canonicalize an inventory path independently of the host path separator. */
pub fn normalize_source_path(path: string) -> string {
  return replace(path_normalize(path), "\\", "/")
}

/** Identify generated Cargo target directories without hiding similarly named source trees. */
fn standard_cargo_target_dir_name(name: string) -> bool {
  if CARGO_TARGET_DIR_NAMES.contains(name) {
    return true
  }
  for prefix in CARGO_TARGET_DIR_PREFIXES {
    if name.starts_with(prefix) {
      return true
    }
  }
  return false
}

fn root_worktree_cargo_target_dir(
  fs: HarnessFs,
  root: string,
  rel_dir: string,
  name: string,
) -> bool {
  if rel_dir != "" || !name.starts_with(WORKTREE_CARGO_TARGET_DIR_PREFIX) {
    return false
  }
  const dir = path_join(root, name)
  for artifact_dir in CARGO_TARGET_ARTIFACT_DIR_NAMES {
    if fs.exists(path_join(dir, artifact_dir)) {
      return true
    }
  }
  return false
}

fn skip_dir(fs: HarnessFs, root: string, rel_dir: string, name: string) -> bool {
  return SKIP_DIR_NAMES.contains(name)
    || standard_cargo_target_dir_name(name)
    || root_worktree_cargo_target_dir(fs, root, rel_dir, name)
}

/**
 * Recursively collect `suffix` files under `rel_dir`, skipping the directories
 * this script owns rules for.
 *
 * Those rules are not the whole story: `walk_dir` refuses on its own to descend
 * into `target`, `build`, `dist`, `node_modules`, `coverage`, `venv`, and
 * `__pycache__`, so the inventory's real reach is narrower than the constants
 * above suggest, and a source tree under one of those names would escape the
 * ratchet with no diagnostic.
 * The tracked-source reconciliation below makes such a hole loud by comparing
 * the inventory walk with git rather than trusting fixtures alone.
 */
fn files_below(harness: Harness, root: string, rel_dir: string, suffix: string) -> list<string> {
  const dir = if rel_dir == "" {
    root
  } else {
    path_join(root, rel_dir)
  }
  if !harness.fs.exists(dir) {
    return []
  }
  let paths: list<string> = []
  const entries = harness.fs.walk(dir, {max_depth: 1, follow_symlinks: false}).filter(
    { entry -> entry.depth == 1 },
  )
    .to_list()
    .sorted_by({ entry -> entry.path })
  for entry in entries {
    const name = basename(entry.path)
    if skip_dir(harness.fs, root, rel_dir, name) {
      continue
    }
    const rel = normalize_source_path(
      if rel_dir == "" {
        name
      } else {
        path_join(rel_dir, name)
      },
    )
    if entry.is_file && rel.ends_with(suffix) {
      paths = paths.appending(rel)
    } else if entry.is_dir {
      for child in files_below(harness, root, rel, suffix) {
        paths = paths.appending(child)
      }
    }
  }
  return paths
}

/** Whether `path` is a generated source the ratchet must not govern. */
pub fn is_generated_source(path: string) -> bool {
  for prefix in GENERATED_SOURCE_PREFIXES {
    if path.starts_with(prefix) {
      return true
    }
  }
  return false
}

/** Inventory all repo Rust plus the canonical stdlib Harn source. */
pub fn source_files(harness: Harness, root: string = "") -> list<string> {
  const resolved_root = if root == "" {
    repo_root(harness.fs)
  } else {
    path_normalize(root)
  }
  let paths = files_below(harness, resolved_root, "", ".rs").filter(
    { path -> !is_generated_source(path) },
  )
    .to_list()
  for path in files_below(harness, resolved_root, STDLIB_SOURCE_DIR, ".harn") {
    paths = paths.appending(path)
  }
  return paths.sorted()
}

pub fn source_inventory(harness: Harness, root: string = "") -> list<SourceCount> {
  const resolved_root = if root == "" {
    repo_root(harness.fs)
  } else {
    path_normalize(root)
  }
  let sources: list<SourceCount> = []
  for path in source_files(harness, resolved_root) {
    sources = sources.appending(
      {path: path, lines: logical_line_count(harness.fs.read_text(path_join(resolved_root, path)))},
    )
  }
  return sources
}

fn source_index(sources: list<SourceCount>) -> dict<string, SourceCount> {
  let index: dict<string, SourceCount> = {}
  for source in sources {
    if index[source.path] == nil {
      index[source.path] = source
    }
  }
  return index
}

fn base_source_index(sources: list<BaseSourceCount>) -> dict<string, BaseSourceCount> {
  let index: dict<string, BaseSourceCount> = {}
  for source in sources {
    if index[source.path] == nil {
      index[source.path] = source
    }
  }
  return index
}

fn legacy_path_shape_valid(path: string) -> bool {
  if path == ""
    || path.starts_with("/")
    || path.contains("../")
    || path == ".."
    || path.contains("\n")
    || path.contains("\r")
    || path.contains("\t") {
    return false
  }
  if normalize_source_path(path) != path {
    return false
  }
  return path.ends_with(".rs")
    || (path.starts_with(STDLIB_SOURCE_DIR + "/") && path.ends_with(".harn"))
}

/** Parse the stable policy inventory; it deliberately contains no measurements. */
pub fn parse_legacy_inventory(text: string) -> dict {
  const parsed = try {
    json_parse(text)
  }
  if is_err(parsed) {
    return {
      ok: false,
      paths: [],
      error: "legacy inventory is not valid JSON: " + to_string(unwrap_err(parsed)),
    }
  }
  const checked = schema_report(
    unwrap(parsed),
    {
      type: "object",
      additionalProperties: false,
      required: ["version", "legacy_oversized_paths"],
      properties: {
        version: {type: "integer"},
        legacy_oversized_paths: {type: "array", items: {type: "string"}},
      },
    },
  )
  if !checked.ok {
    return {ok: false, paths: [], error: "legacy inventory schema is invalid: " + checked.message}
  }
  const inventory = checked.value
  if inventory.version != LEGACY_INVENTORY_VERSION {
    return {
      ok: false,
      paths: [],
      error: "legacy inventory version must be ${LEGACY_INVENTORY_VERSION}",
    }
  }
  const paths = inventory.legacy_oversized_paths
  if paths != paths.sorted() {
    return {ok: false, paths: [], error: "legacy inventory paths must be sorted"}
  }
  let seen: dict<string, bool> = {}
  for path in paths {
    if !legacy_path_shape_valid(path) {
      return {ok: false, paths: [], error: "invalid legacy source path: " + path}
    }
    if seen[path] ?? false {
      return {ok: false, paths: [], error: "duplicate legacy source path: " + path}
    }
    seen[path] = true
  }
  return {ok: true, paths: paths, error: ""}
}

fn legacy_inventory(fs: HarnessFs, root: string) -> dict {
  const path = path_join(root, LEGACY_INVENTORY_PATH)
  if !fs.exists(path) {
    return {ok: false, paths: [], error: LEGACY_INVENTORY_PATH + " is missing"}
  }
  return parse_legacy_inventory(fs.read_text(path))
}

/** Evaluate strict no-growth against immutable merge-base/first-parent counts. */
pub fn evaluate_inventory(
  sources: list<SourceCount>,
  legacy_paths: list<string>,
  base_sources: list<BaseSourceCount>,
  max_lines: int = MAX_LINES,
) -> list<SourceLengthFinding> {
  const sources_by_path = source_index(sources)
  const base_by_path = base_source_index(base_sources)
  let findings: list<SourceLengthFinding> = []
  for path in legacy_paths {
    const source = sources_by_path[path]
    if source == nil {
      findings = findings.appending(
        {
          kind: "legacy_path_missing",
          path: path,
          message:
            "legacy source is missing at HEAD; remove it from the inventory after deletion or update the path after a rename",
        },
      )
      continue
    }
    const base = base_by_path[path]
    if base != nil && !base.approved {
      findings = findings.appending(
        {
          kind: "invalid_legacy_inventory",
          path: path,
          actual: source.lines,
          ceiling: max_lines,
          message: to_string(base.error ?? "source was not approved legacy debt at the base"),
        },
      )
      continue
    }
    if base == nil || base.lines == nil {
      findings = findings.appending(
        {
          kind: "base_source_missing",
          path: path,
          actual: source.lines,
          message: to_string(base?.error ?? "legacy source did not exist at the comparison base"),
        },
      )
      continue
    }
    if source.lines <= max_lines {
      findings = findings.appending(
        {
          kind: "obsolete_legacy_path",
          path: path,
          actual: source.lines,
          ceiling: base.lines,
          message: "source reached the ${max_lines}-line cap; remove it from the legacy inventory",
        },
      )
      continue
    }
    if base.lines <= max_lines {
      findings = findings.appending(
        {
          kind: "invalid_legacy_inventory",
          path: path,
          actual: source.lines,
          ceiling: max_lines,
          message:
            "legacy inventory cannot exempt a source that was within the cap at the comparison base",
        },
      )
      continue
    }
    if source.lines > base.lines {
      findings = findings.appending(
        {
          kind: "growth",
          path: path,
          actual: source.lines,
          ceiling: base.lines,
          message: "legacy source grew beyond its comparison-base line count",
        },
      )
    }
  }
  for source in sources {
    if source.lines > max_lines && !legacy_paths.contains(source.path) {
      findings = findings.appending(
        {
          kind: "new_oversized_source",
          path: source.path,
          actual: source.lines,
          ceiling: max_lines,
          message:
            "source exceeds the ${max_lines}-line cap and was not legacy debt at the comparison base",
        },
      )
    }
  }
  return findings.sorted_by({ finding -> finding.path + ":" + finding.kind })
}

fn git_failure(result: dict, operation: string) -> string {
  const detail = result.stderr.trim()
  if detail != "" {
    return operation + ": " + detail
  }
  return operation + " exited " + to_string(result.exit_code)
}

fn git_revision(
  process: HarnessProcess,
  root: string,
  args: list<string>,
  operation: string,
) -> dict {
  const result = process.run({program: "git", args: ["-C", root] + args})
  if !result.success || result.stdout.trim() == "" {
    return {ok: false, revision: "", error: git_failure(result, operation)}
  }
  return {ok: true, revision: result.stdout.trim(), error: ""}
}

/** Resolve one immutable comparison commit without fetching from the network. */
pub fn resolve_base_revision(
  process: HarnessProcess,
  root: string,
  comparison: string = "auto",
  base_ref: string = "",
) -> dict {
  const head = git_revision(
    process,
    root,
    ["rev-parse", "--verify", "HEAD^{commit}"],
    "resolve HEAD",
  )
  if !head.ok {
    return {ok: false, comparison: comparison, revision: "", error: head.error}
  }
  if comparison == "first-parent" {
    const parent = git_revision(
      process,
      root,
      ["rev-parse", "--verify", "HEAD^1"],
      "resolve HEAD first parent",
    )
    return {
      ok: parent.ok,
      comparison: "first-parent",
      revision: parent.revision,
      error: parent.error,
    }
  }
  if comparison == "merge-base" {
    if base_ref == "" {
      return {
        ok: false,
        comparison: comparison,
        revision: "",
        error: "merge-base comparison requires --base-ref or HARN_EXT_SOURCE_LENGTH_BASE_REF",
      }
    }
    const base = git_revision(
      process,
      root,
      ["merge-base", "HEAD", base_ref],
      "resolve merge base against " + base_ref,
    )
    return {ok: base.ok, comparison: "merge-base", revision: base.revision, error: base.error}
  }
  if comparison != "auto" {
    return {
      ok: false,
      comparison: comparison,
      revision: "",
      error: "comparison must be auto, merge-base, or first-parent",
    }
  }
  const main = git_revision(
    process,
    root,
    [
      "rev-parse",
      "--verify",
      if base_ref == "" {
        "origin/main^{commit}"
      } else {
        base_ref
      },
    ],
    "resolve local main reference",
  )
  if main.ok {
    const base = git_revision(
      process,
      root,
      ["merge-base", "HEAD", main.revision],
      "resolve local merge base",
    )
    if !base.ok {
      return {ok: false, comparison: "merge-base", revision: "", error: base.error}
    }
    if base.revision != head.revision {
      return {ok: true, comparison: "merge-base", revision: base.revision, error: ""}
    }
  }
  const parent = git_revision(
    process,
    root,
    ["rev-parse", "--verify", "HEAD^1"],
    "resolve HEAD first parent",
  )
  return {ok: parent.ok, comparison: "first-parent", revision: parent.revision, error: parent.error}
}

fn base_source_inventory(
  process: HarnessProcess,
  root: string,
  revision: string,
  legacy_paths: list<string>,
  base_legacy_paths: list<string>,
) -> list<BaseSourceCount> {
  const renamed: dict<string, string> = renamed_base_paths(process, root, revision)
  let sources: list<BaseSourceCount> = []
  for path in legacy_paths {
    const base_path = to_string(renamed[path] ?? path)
    if !base_legacy_paths.contains(base_path) {
      sources = sources.appending(
        {
          path: path,
          approved: false,
          error: "comparison-base policy did not approve legacy source " + base_path,
        },
      )
      continue
    }
    const result = process.run(
      {program: "git", args: ["-C", root, "cat-file", "blob", revision + ":" + base_path]},
    )
    if result.success {
      sources = sources.appending(
        {path: path, approved: true, lines: logical_line_count(result.stdout)},
      )
    } else {
      sources = sources.appending(
        {
          path: path,
          approved: true,
          error: git_failure(result, "read " + base_path + " at " + revision),
        },
      )
    }
  }
  return sources
}

/** Read the policy format owned by the comparison revision. */
fn base_legacy_inventory(process: HarnessProcess, root: string, revision: string) -> dict {
  const current = process.run(
    {
      program: "git",
      args: ["-C", root, "cat-file", "blob", revision + ":" + LEGACY_INVENTORY_PATH],
    },
  )
  if current.success {
    return parse_legacy_inventory(current.stdout)
  }
  // The first cutover must compare against the historical shard layout. This
  // decodes base history only; current policy has one owner above.
  const historical = process.run(
    {
      program: "git",
      args: ["-C", root, "ls-tree", "-r", "--name-only", revision, "--", HISTORICAL_BASELINE_DIR],
    },
  )
  if !historical.success {
    return {
      ok: false,
      paths: [],
      error: git_failure(historical, "read comparison-base legacy policy"),
    }
  }
  const prefix = HISTORICAL_BASELINE_DIR + "/"
  const suffix = ".lines"
  let paths: list<string> = []
  for line in historical.stdout.lines() {
    const shard = normalize_source_path(line.trim())
    if shard.starts_with(prefix) && shard.ends_with(suffix) {
      const path = shard.substring(prefix.len(), shard.len() - suffix.len())
      if !legacy_path_shape_valid(path) {
        return {ok: false, paths: [], error: "invalid historical legacy source path: " + path}
      }
      paths = paths.appending(path)
    }
  }
  if paths.count == 0 {
    return {
      ok: false,
      paths: [],
      error: "comparison base has neither the legacy inventory nor historical count shards",
    }
  }
  return {ok: true, paths: paths.sorted(), error: ""}
}

/** Map a current renamed path to its comparison-base path. */
fn renamed_base_paths(
  process: HarnessProcess,
  root: string,
  revision: string,
) -> dict<string, string> {
  const result = process.run(
    {
      program: "git",
      args: [
        "-C",
        root,
        "-c",
        "core.quotepath=false",
        "diff",
        "--find-renames",
        "--name-status",
        revision,
        "--",
      ],
    },
  )
  if !result.success {
    return {}
  }
  let paths: dict<string, string> = {}
  for line in result.stdout.lines() {
    const fields = line.split("\t")
    if fields.count == 3 && fields[0]?.starts_with("R") {
      const old_path = normalize_source_path(fields[1] ?? "")
      const new_path = normalize_source_path(fields[2] ?? "")
      if legacy_path_shape_valid(old_path) && legacy_path_shape_valid(new_path) {
        paths[new_path] = old_path
      }
    }
  }
  return paths
}

/**
 * In-scope, present source paths git tracks under `root`, plus whether git
 * could answer.
 *
 * Returning a bare empty list on failure made the reconciliation vanish: no
 * tracked paths means nothing can be reported unreachable, which is exactly the
 * output a fully-covered repository produces. That is not academic — the audit
 * lane ran with an unreadable git config for weeks and this cross-check was
 * silently off the whole time.
 */
fn git_tracked_sources(fs: HarnessFs, process: HarnessProcess, root: string) -> dict {
  const res = process.run(
    {program: "git", args: ["-C", root, "ls-files", "*.rs", STDLIB_SOURCE_DIR + "/*.harn"]},
  )
  if !res.success {
    const detail = res.stderr.trim()
    return {
      ok: false,
      paths: [],
      error: if detail == "" {
        "git ls-files exited " + to_string(res.exit_code)
      } else {
        detail
      },
    }
  }
  let out: list<string> = []
  for line in res.stdout.lines() {
    const path = line.trim()
    if path != "" && fs.exists(path_join(root, path)) {
      out = out.appending(normalize_source_path(path))
    }
  }
  return {ok: true, paths: out, error: ""}
}

/**
 * Tracked sources the inventory walk never returned.
 *
 * Every entry is a file whose length this ratchet has silently stopped
 * governing. Fixture-based tests cannot detect that class at all — they can
 * only assert about paths the walk already reaches — so the inventory is
 * reconciled against git, the one authority on what source this repo has.
 */
pub fn unscanned_sources(scanned: list<string>, tracked: list<string>) -> list<string> {
  let missing: list<string> = []
  for path in tracked {
    if is_generated_source(path) {
      continue
    }
    if !scanned.contains(path) {
      missing = missing.appending(path)
    }
  }
  return missing.sorted()
}

pub fn check_source_file_lengths(
  harness: Harness,
  root: string = "",
  comparison: string = "",
  base_ref: string = "",
) -> SourceLengthReport {
  const resolved_root = if root == "" {
    repo_root(harness.fs)
  } else {
    path_normalize(root)
  }
  const sources = source_inventory(harness, resolved_root)
  const inventory = legacy_inventory(harness.fs, resolved_root)
  const requested_comparison = if comparison != "" {
    comparison
  } else {
    to_string(harness.env.get("HARN_EXT_SOURCE_LENGTH_COMPARISON") ?? "auto")
  }
  const requested_base_ref = if base_ref != "" {
    base_ref
  } else {
    to_string(harness.env.get("HARN_EXT_SOURCE_LENGTH_BASE_REF") ?? "")
  }
  const base = resolve_base_revision(
    harness.process,
    resolved_root,
    requested_comparison,
    requested_base_ref,
  )
  const base_inventory = if base.ok {
    base_legacy_inventory(harness.process, resolved_root, base.revision)
  } else {
    {ok: false, paths: [], error: base.error}
  }
  let findings: list<SourceLengthFinding> = []
  if !inventory.ok {
    findings = findings.appending(
      {kind: "invalid_legacy_inventory", path: LEGACY_INVENTORY_PATH, message: inventory.error},
    )
  }
  if !base.ok {
    findings = findings.appending(
      {
        kind: "base_unavailable",
        path: resolved_root,
        message: base.error
          + "; the comparison commit must already exist locally (this check never fetches)",
      },
    )
  }
  if base.ok && !base_inventory.ok {
    findings = findings.appending(
      {kind: "base_unavailable", path: LEGACY_INVENTORY_PATH, message: base_inventory.error},
    )
  }
  if inventory.ok && base.ok && base_inventory.ok {
    findings = findings
      + evaluate_inventory(
        sources,
        inventory.paths,
        base_source_inventory(
          harness.process,
          resolved_root,
          base.revision,
          inventory.paths,
          base_inventory.paths,
        ),
      )
  }
  // Reuses the inventory walk that just ran, so the reconciliation costs one
  // `git ls-files`. Under a synthetic root nothing is tracked, so this is a
  // no-op for fixture tests rather than something they have to opt out of.
  const tracked = git_tracked_sources(harness.fs, harness.process, resolved_root)
  for path in unscanned_sources(sources.map({ source -> source.path }).to_list(), tracked.paths) {
    findings = findings.appending(
      {
        kind: "unscanned_source",
        path: path,
        message: "tracked source is unreachable by the inventory walk, so its length is ungoverned",
      },
    )
  }
  if !tracked.ok {
    findings = findings.appending(
      {
        kind: "reconciliation_unavailable",
        path: resolved_root,
        message: "git could not list tracked sources, so the walk was not reconciled against it: "
          + to_string(tracked?.error ?? ""),
      },
    )
  }
  return {
    root: resolved_root,
    max_lines: MAX_LINES,
    source_count: sources.count,
    legacy_count: inventory.paths.count,
    oversized_count: sources.filter({ source -> source.lines > MAX_LINES }).count,
    comparison: base.comparison,
    base_revision: if base.ok {
      base.revision
    } else {
      nil
    },
    findings: findings.sorted_by({ finding -> finding.path + ":" + finding.kind }),
  }
}

fn render_report(report: SourceLengthReport) -> string {
  if report.findings.count == 0 {
    return "source file-length ratchet passed: ${report.source_count} source file(s), "
      + "${report.legacy_count} legacy path(s), ${report.max_lines}-line cap, "
      + "${report.comparison} ${report.base_revision}"
  }
  let lines = ["source file-length ratchet failed: ${report.findings.count} violation(s)", ""]
  for finding in report.findings {
    let detail = finding.path + ": " + finding.kind
    if finding.actual != nil {
      detail = detail + " actual=" + to_string(finding.actual)
    }
    if finding.ceiling != nil {
      detail = detail + " ceiling=" + to_string(finding.ceiling)
    }
    lines = lines + [detail + " — " + finding.message]
  }
  lines = lines
    + [
      "",
      "Split oversized files. Shrinkage automatically becomes the next merge-base ceiling.",
      "Remove a path from the stable legacy inventory only after it reaches the 1,500-line cap.",
    ]
  return join(lines, "\n")
}

fn arg_spec() {
  return parser(
    {
      name: "check_source_file_lengths",
      args: [
        {kind: "flag", name: "root", long: "--root", parse: "string", default: ""},
        {kind: "switch", name: "json", long: "--json", default: false},
        {kind: "flag", name: "comparison", long: "--comparison", parse: "string", default: ""},
        {kind: "flag", name: "base_ref", long: "--base-ref", parse: "string", default: ""},
      ],
    },
  )
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/check_source_file_lengths.harn -- [--json] [--root PATH] [--comparison auto|merge-base|first-parent] [--base-ref REF]",
    )
    return nil
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    harness.runtime.exit(2)
  }
  const parsed = unwrap(parsed_result).options
  const resolved_root = if to_string(parsed?.root ?? "") == "" {
    repo_root(harness.fs)
  } else {
    path_normalize(to_string(parsed.root))
  }
  const report = check_source_file_lengths(
    harness,
    resolved_root,
    to_string(parsed?.comparison ?? ""),
    to_string(parsed?.base_ref ?? ""),
  )
  if parsed?.json ?? false {
    harness.stdio.println(json_stringify_pretty(report))
  } else {
    const rendered = render_report(report)
    if report.findings.count == 0 {
      harness.stdio.println(rendered)
    } else {
      harness.stdio.eprintln(rendered)
    }
  }
  if report.findings.count > 0 {
    harness.runtime.exit(1)
  }
  return nil
}
