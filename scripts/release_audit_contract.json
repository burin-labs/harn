{
  "schema_version": "harn.release_audit_contract.v1",
  "lanes": [
    {"name": "rust-audit", "runner": "run_rust_audit", "proof": "merge_group"},
    {"name": "harn-audit", "runner": "run_harn_audit", "proof": "merge_group"},
    {"name": "generated-audit", "runner": "run_generated_audit", "proof": "residual"},
    {"name": "docs-audit", "runner": "run_docs_audit", "proof": "residual"},
    {"name": "grammar-audit", "runner": "run_grammar_audit", "proof": "residual"},
    {"name": "security-audit", "runner": "run_security_audit", "proof": "residual"},
    {"name": "package-audit", "runner": "run_package_audit", "proof": "merge_group"},
    {"name": "smoke-audit", "runner": "run_smoke_audit", "proof": "residual"}
  ],
  "merge_group_jobs": [
    {
      "name": "Format check",
      "job_id": "fmt",
      "matrix_kind": "",
      "proofs": ["rust-audit"],
      "steps": [
        {"id": "release-audit-format", "condition": "", "run": "make fmt-check"}
      ]
    },
    {
      "name": "Package audit",
      "job_id": "package-audit",
      "matrix_kind": "",
      "proofs": ["package-audit"],
      "steps": [
        {"id": "release-audit-package", "condition": "", "run": "./scripts/verify_crate_packages.sh"}
      ]
    },
    {
      "name": "Rust lint",
      "job_id": "rust-builds",
      "matrix_kind": "lint",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-rust-lint",
          "condition": "matrix.kind == 'lint'",
          "run": "./scripts/ci/run_rust_lint_lane.sh"
        }
      ]
    },
    {
      "name": "Behavior build",
      "job_id": "rust-builds",
      "matrix_kind": "behavior",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-behavior-build",
          "condition": "matrix.kind == 'behavior'",
          "run": "./scripts/ci/behavior_artifact.sh build \"$RUNNER_TEMP/harn-behavior.tar.zst\" \"$GITHUB_SHA\""
        },
        {
          "id": "release-audit-rust-test-fallback",
          "condition": "matrix.kind == 'behavior' && vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'",
          "required_env": {"HARN_LLM_CALLS_DISABLED": "1"},
          "run": "scripts/ci/run_rust_test_lane.sh cargo nextest run --workspace --profile ci -E 'not test(test_linux_process_sandbox_catches_ten_process_escapes)'"
        }
      ]
    },
    {
      "name": "Rust test",
      "job_id": "rust-test",
      "matrix_kind": "",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-rust-test",
          "condition": "",
          "required_env": {"HARN_LLM_CALLS_DISABLED": "1"},
          "run": "scripts/ci/run_rust_test_lane.sh cargo nextest run --profile ci --archive-file \"$RUNNER_TEMP/harn-behavior/harn-tests.tar.zst\" --workspace-remap \"$GITHUB_WORKSPACE\" -E 'not test(test_linux_process_sandbox_catches_ten_process_escapes)'"
        }
      ]
    },
    {
      "name": "Rust security proof",
      "job_id": "rust-security",
      "matrix_kind": "",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-rust-security",
          "condition": "",
          "run": "cargo nextest run --profile ci --archive-file \"$RUNNER_TEMP/harn-behavior/harn-tests.tar.zst\" --workspace-remap \"$GITHUB_WORKSPACE\" -E 'test(test_linux_process_sandbox_catches_ten_process_escapes)'"
        }
      ]
    },
    {
      "name": "Harn conformance + audit",
      "job_id": "harn-audit",
      "matrix_kind": "",
      "proofs": ["harn-audit"],
      "steps": [
        {
          "id": "release-audit-harn",
          "condition": "",
          "run": "./scripts/audit_gates.sh"
        }
      ]
    }
  ]
}
