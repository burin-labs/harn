    {
      "name": "Run Linux sandbox tests",
      "job_id": "rust-security",
      "matrix_kind": "",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-rust-security",
          "condition": "",
          "run": "set -euo pipefail; host_bound_filter=\"$(scripts/ci/host_bound_rust_test_filter.sh)\"; scripts/ci/run_rust_test_lane.sh cargo-nextest nextest run --profile ci --success-output immediate --no-tests fail --archive-file \"$RUNNER_TEMP/harn-security/harn-security-tests.tar.zst\" --workspace-remap \"$GITHUB_WORKSPACE\" -E \"${host_bound_filter}\""
        }
      ]
    },
    {
      "name": "Run Harn conformance tests (1/4)",
      "job_id": "harn-audit",
      "matrix_kind": "conformance-1",
      "proofs": ["harn-audit"],
      "steps": [
        {
          "id": "release-audit-harn",
          "condition": "",
          "run": "args=(--phase \"${{ matrix.phase }}\" \"${{ matrix.selector }}\")\nif [ \"$TREE_SITTER_PARSER_PREFLIGHTED\" = true ]; then\n  args+=(--tree-sitter-parser-preflighted)\nfi\n./scripts/audit_gates.sh \"${args[@]}\"\n"
        }
      ]
    },
