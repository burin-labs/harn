{
  "schema_version": "harn.release_audit_contract.v1",
  "platforms": [
    {
      "name": "macos",
      "required": true,
      "workflow_path": ".github/workflows/macos-nightly.yml",
      "required_job": "Workspace nextest (macos-latest)",
      "required_steps": [
        "Admit reviewed qualification source",
        "Prove process confinement",
        "Select admitted qualification source",
        "Run workspace nextest",
        "Smoke test harn run",
        "Verify release test-case performance",
        "Record native qualification receipt",
        "Upload native qualification receipt"
      ]
    },
    {
      "name": "windows",
      "required": false,
      "workflow_path": ".github/workflows/windows-nightly.yml",
      "required_job": "Workspace nextest (windows-latest)",
      "required_steps": ["Run workspace nextest"]
    }
  ],
  "lanes": [
    {
      "name": "rust-audit",
      "runner": "run_rust_audit",
      "proof": "merge_group"
    },
    {
      "name": "harn-audit",
      "runner": "run_harn_audit",
      "proof": "merge_group"
    },
    {
      "name": "generated-audit",
      "runner": "run_generated_audit",
      "proof": "residual"
    },
    { "name": "docs-audit", "runner": "run_docs_audit", "proof": "residual" },
    {
      "name": "grammar-audit",
      "runner": "run_grammar_audit",
      "proof": "residual"
    },
    {
      "name": "package-audit",
      "runner": "run_package_audit",
      "proof": "merge_group"
    },
    { "name": "smoke-audit", "runner": "run_smoke_audit", "proof": "residual" }
  ],
  "merge_group_jobs": [
    {
      "name": "Format check",
      "job_id": "fmt",
      "matrix_kind": "",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-format",
          "condition": "",
          "run": "make fmt-check"
        }
      ]
    },
    {
      "name": "Verify publishable crates",
      "job_id": "package-audit",
      "matrix_kind": "",
      "proofs": ["package-audit"],
      "steps": [
        {
          "id": "release-audit-package",
          "condition": "",
          "run": "./scripts/verify_crate_packages.sh"
        }
      ]
    },
    {
      "name": "Check Rust code",
      "job_id": "rust-checks",
      "matrix_kind": "workspace",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-rust-lint",
          "condition": "",
          "run": "./scripts/ci/run_rust_lint_lane.sh --leg \"${{ matrix.kind }}\""
        }
      ]
    },
    {
      "name": "Check Rust code (lean LSP features)",
      "job_id": "rust-checks",
      "matrix_kind": "lean-lsp",
