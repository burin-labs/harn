      "job_id": "rust-test-partitions",
      "matrix_kind": "partition-1",
      "proofs": ["rust-audit"],
      "steps": [
        {
          "id": "release-audit-rust-test",
          "condition": "",
          "required_env": { "HARN_LLM_CALLS_DISABLED": "1" },
          "run": "scripts/ci/run_rust_test_lane.sh bash scripts/ci/run_workspace_tests.sh \"$HARN_EXT_TEST_PARTITION\""
