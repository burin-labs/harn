/**
 * Data-only policy consumed by the shared Codex and Claude shell guard.
 * Keep platform spellings here so the evaluator and its downstream projections
 * stay code-identical.
 */
pub type DisposablePathPolicy = {
  generated_relative_roots: list<string>,
  posix_temp_roots: list<string>,
  posix_temp_variables: list<string>,
  windows_temp_variables: list<string>,
  windows_temp_markers: list<string>,
  macos_temp_prefixes: list<string>,
  macos_temp_component: string,
}

pub const DISPOSABLE_PATH_POLICY: DisposablePathPolicy = {
  generated_relative_roots: [".build", "target", ".harn-runs", ".burin-evals", ".burin-live-evals"],
  posix_temp_roots: ["/tmp", "/private/tmp", "/var/tmp", "/private/var/tmp"],
  posix_temp_variables: ["$TMPDIR", "\${TMPDIR}", "$TMP", "\${TMP}", "$TEMP", "\${TEMP}"],
  windows_temp_variables: [
    "%TEMP%",
    "%TMP%",
    "$env:TEMP",
    "\${env:TEMP}",
    "$env:TMP",
    "\${env:TMP}",
  ],
  windows_temp_markers: ["/appdata/local/temp", "/windows/temp"],
  macos_temp_prefixes: ["/var/folders/", "/private/var/folders/"],
  macos_temp_component: "/T",
}

/**
 * Where a repository declares that it owns Fleet worktree admission.
 *
 * The worktree rule is pure argv analysis and therefore fires in every
 * repository that wires this guard, including one that has no admission
 * command to offer. The guard looks for one of these paths under the
 * repository root.
 *
 * A repository that owns none is not thereby exempt. An admission command
 * takes the repository it acts on as an argument, so one measured repository
 * can admit a repository that owns no command of its own, and the refusal
 * names that command with `borrowed_root_argument` pointing it at the target.
 * The argument is configured here rather than written into the rule, because
 * a guard that hard-codes one consumer's command line is a guard that names
 * the wrong remedy in the next repository that wires it.
 */
pub type WorktreeAdmissionPolicy = {
  admission_command_paths: list<string>,
  repository_markers: list<string>,
  max_root_walk: int,
  borrowed_root_argument: string,
}

pub const WORKTREE_ADMISSION_POLICY: WorktreeAdmissionPolicy = {
  admission_command_paths: ["scripts/fleet-worktree-admit.ts"],
  repository_markers: [".git"],
  max_root_walk: 12,
  borrowed_root_argument: "--repository-root",
}

/**
 * A build command whose setup a repository's root Makefile may own.
 *
 * `cargo` is handled separately and unconditionally, because every repository
 * that wires this guard is a Cargo workspace with those targets. Other build
 * tools are not universal: a repository with no `swift-build` target cannot be
 * told to run one. So these rules only fire when the wrapper has measured that
 * the root Makefile really declares the target, which keeps the guard from
 * naming a command the operator does not have.
 *
 * `program` is the executable basename, `verb` its first non-option argument,
 * `target` the Make target that owns the same work, and `escape` the
 * assignment that releases one command from the rule. The escape is spelled
 * out rather than derived from `program`: the guard runs in a standalone hook
 * host that permits no string-case builtin, and a rule whose escape hatch can
 * only be computed is a rule that faults instead of deciding.
 */
pub type MakeOwnedCommandRule = {program: string, verb: string, target: string, escape: string}

pub const MAKE_OWNED_COMMAND_RULES: list<MakeOwnedCommandRule> = [
  {program: "swift", verb: "build", target: "swift-build", escape: "HARN_ALLOW_RAW_SWIFT=1"},
  {program: "swift", verb: "test", target: "swift-test", escape: "HARN_ALLOW_RAW_SWIFT=1"},
]
