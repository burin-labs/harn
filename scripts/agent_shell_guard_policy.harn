/**
 * Data-only policy consumed by the shared Codex and Claude shell guard.
 * Keep platform spellings here so the evaluator and its downstream projections
 * stay code-identical.
 */
pub type DisposablePathPolicy = {
  generated_relative_roots: list<string>,
  posix_temp_roots: list<string>,
  posix_temp_variables: list<string>,
  windows_temp_variables: list<string>,
  windows_temp_markers: list<string>,
  macos_temp_prefixes: list<string>,
  macos_temp_component: string,
}

pub const DISPOSABLE_PATH_POLICY: DisposablePathPolicy = {
  generated_relative_roots: [".build", "target", ".harn-runs", ".burin-evals", ".burin-live-evals"],
  posix_temp_roots: ["/tmp", "/private/tmp", "/var/tmp", "/private/var/tmp"],
  posix_temp_variables: ["$TMPDIR", "\${TMPDIR}", "$TMP", "\${TMP}", "$TEMP", "\${TEMP}"],
  windows_temp_variables: [
    "%TEMP%",
    "%TMP%",
    "$env:TEMP",
    "\${env:TEMP}",
    "$env:TMP",
    "\${env:TMP}",
  ],
  windows_temp_markers: ["/appdata/local/temp", "/windows/temp"],
  macos_temp_prefixes: ["/var/folders/", "/private/var/folders/"],
  macos_temp_component: "/T",
}

/**
 * Where a repository declares that it owns Fleet worktree admission.
 *
 * The worktree rule is pure argv analysis and therefore fires in every
 * repository that wires this guard, including one that has no admission
 * command to offer. Refusing there names a command the operator cannot run.
 * The guard looks for one of these paths under the repository root and only
 * refuses when it finds one.
 */
pub type WorktreeAdmissionPolicy = {
  admission_command_paths: list<string>,
  repository_markers: list<string>,
  max_root_walk: int,
}

pub const WORKTREE_ADMISSION_POLICY: WorktreeAdmissionPolicy = {
  admission_command_paths: ["scripts/fleet-worktree-admit.ts"],
  repository_markers: [".git"],
  max_root_walk: 12,
}
