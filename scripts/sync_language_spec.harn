// Assemble the language spec from its per-chapter sources and keep the
// generated single-file copies in sync:
//
//   spec/chapters/*.md   (the canonical, hand-edited source — one file per
//                         top-level section, ordered by their `NN-` prefix)
//        |
//        +--> spec/HARN_SPEC.md           (generated single-file assembly;
//        |                                 consumed by verify_language_spec,
//        |                                 the release tooling, and ctrl-F)
//        +--> docs/src/language-spec.md    (generated docs mirror, with a
//                                          "do not edit" header)
//
// Edit the chapter files, never the generated copies. The pre-commit hook
// re-runs this so the generated copies never go stale.
//
// Usage:
//   harn run scripts/sync_language_spec.harn               (rewrite both)
//   harn run scripts/sync_language_spec.harn -- --check    (fail if stale)
import "./compare_generated_text.harn"

let CHAPTERS_GLOB = "spec/chapters/*.md"

let SPEC = "spec/HARN_SPEC.md"

let MIRROR = "docs/src/language-spec.md"

let HEADER = "<!-- Generated from spec/chapters/*.md by scripts/sync_language_spec.harn -->\n\n"

/**
 * Assemble the canonical single-file spec text by concatenating every chapter
 * in `NN-` order. The chapter files carry their own trailing newlines, so a
 * plain join reproduces the historical `HARN_SPEC.md` byte-for-byte.
 */
pub fn assemble_spec() -> string {
  let chapters = harness.fs.glob(CHAPTERS_GLOB).sort()
  var out = ""
  for path in chapters {
    out = out + harness.fs.read_text(path)
  }
  return out
}

/** Render the docs mirror (spec text plus the "do not edit" header). */
pub fn render_mirror_from(spec_text: string) -> string {
  return HEADER + spec_text
}

pipeline main(task) {
  let chapters = harness.fs.glob(CHAPTERS_GLOB).sort()
  if chapters.count == 0 {
    __io_eprintln("error: no chapter files found at ${CHAPTERS_GLOB}")
    return 1
  }
  let spec_text = assemble_spec()
  let mirror_text = render_mirror_from(spec_text)
  let mode = if argv.count == 0 {
    "write"
  } else {
    argv[0]
  }
  if mode == "write" {
    harness.fs.write_text(SPEC, spec_text)
    harness.fs.write_text(MIRROR, mirror_text)
    return 0
  }
  if mode == "--check" {
    let spec_disk = if harness.fs.exists(SPEC) {
      harness.fs.read_text(SPEC)
    } else {
      ""
    }
    let mirror_disk = if harness.fs.exists(MIRROR) {
      harness.fs.read_text(MIRROR)
    } else {
      ""
    }
    if normalize(spec_text) != normalize(spec_disk) {
      __io_eprintln("error: ${SPEC} is stale relative to ${CHAPTERS_GLOB}")
      __io_eprintln("hint: run 'make sync-language-spec' and commit the result")
      return 1
    }
    if normalize(mirror_text) != normalize(mirror_disk) {
      __io_eprintln("error: ${MIRROR} is stale relative to ${CHAPTERS_GLOB}")
      __io_eprintln("hint: run 'make sync-language-spec' and commit the result")
      return 1
    }
    return 0
  }
  __io_eprintln("usage: sync_language_spec.harn [--check]")
  return 2
}
