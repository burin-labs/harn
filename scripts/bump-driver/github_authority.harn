/** Repository automation retains the bootstrap workflow's permission ceiling. */
pub const GITHUB_BUMP_PERMISSIONS = {contents: "write", pull_requests: "write"}

pub type GithubBumpRefreshState = {
  head_oid: string,
  auto_merge_armed: bool,
  queued: bool,
  labels: {total_count: int, has_next_page: bool, names: list<string>},
  reviews: {total_count: int, has_next_page: bool, nodes: list<{state: string, head_oid: string?}>},
}

/** Delivery and review own an admitted head until their controls are withdrawn. */
pub fn bump_refresh_admission(state: GithubBumpRefreshState) -> {allowed: bool, reason: string} {
  if state.labels.has_next_page || state.reviews.has_next_page
    || state.labels.total_count != len(state.labels.names)
    || state.reviews.total_count != len(state.reviews.nodes) {
    return {
      allowed: false,
      reason:
        "incomplete admission census: labels ${len(state.labels.names)}/${state.labels.total_count} more=${state.labels.has_next_page}, writer reviews ${len(state.reviews.nodes)}/${state.reviews.total_count} more=${state.reviews.has_next_page}",
    }
  }
  if state.auto_merge_armed || state.queued
    || state.labels.names.any({ name -> lowercase(name) == "ship" }) {
    return {allowed: false, reason: "delivery is armed"}
  }
  if state.reviews.nodes.any({ review -> review.state == "APPROVED" && review.head_oid == nil }) {
    return {allowed: false, reason: "writer approval has no measured head"}
  }
  if state.reviews.nodes.any(
    { review -> review.state == "APPROVED" && review.head_oid == state.head_oid },
  ) {
    return {allowed: false, reason: "the current head has a writer's approval"}
  }
  return {allowed: true, reason: "unarmed and unreviewed head"}
}

/**
 * The headline std/bump/runtime gives every refresh publication. The App
 * identity and GitHub signature alone do not mark a commit as refresh output:
 * a repair tool holding the same App credentials produces identical evidence
 * through `createCommitOnBranch`, and its repair would be discarded as ours.
 */
const REFRESH_HEADLINE = "^chore: bump Harn runtime to v?[0-9]+\\.[0-9]+\\.[0-9]+$"

/**
 * True for the headline that marks a bump refresh publication.
 *
 * @effects: []
 * @errors: []
 */
pub fn bump_refresh_headline(headline: string) -> bool {
  return regex_match(REFRESH_HEADLINE, headline) != nil
}
