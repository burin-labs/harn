import { assert_eq } from "std/testing"
import { github_bump_remote } from "../github_remote"

const API = "https://api.github.com"

fn remote(harness: Harness, repo_dir: string = ".") {
  return github_bump_remote(
    harness,
    {
      repo: "octo-org/octo-repo",
      release_repo: "burin-labs/harn",
      token: "github-app-installation-token",
      branch: "automation/bump-harn-runtime",
      base: "main",
      repo_dir: repo_dir,
    },
  )
}

fn run_ok(process: HarnessProcess, spec: dict) -> dict {
  const result = process.run(spec)
  if !result.success {
    throw "fixture command failed with exit " + to_string(result.exit_code) + ": "
      + to_string(result.stderr)
  }
  return result
}

fn git_ok(process: HarnessProcess, dir: string, args: list<string>) -> dict {
  return run_ok(
    process,
    {program: "git", args: args, cwd: dir, env: {}, stdin: "", timeout_ms: 120000},
  )
}

fn publication_repo(capabilities: {fs: HarnessFs, process: HarnessProcess}) -> dict {
  const dir = capabilities.fs.mkdtemp_in_workspace("harn-bump-publication-")
  git_ok(capabilities.process, dir, ["init", "-q", "-b", "main", "."])
  git_ok(capabilities.process, dir, ["config", "user.email", "harn-bump-test@example.test"])
  git_ok(capabilities.process, dir, ["config", "user.name", "Harn Bump Test"])
  git_ok(capabilities.process, dir, ["config", "commit.gpgsign", "false"])
  git_ok(capabilities.process, dir, ["config", "core.hooksPath", ".git/harn-absent-hooks"])
  capabilities.fs.write_text(dir + "/runtime.lock", "version = 0.10.113\n")
  git_ok(capabilities.process, dir, ["add", "runtime.lock"])
  git_ok(capabilities.process, dir, ["commit", "-q", "--no-verify", "-m", "base"])
  const base = trim(to_string(git_ok(capabilities.process, dir, ["rev-parse", "HEAD"]).stdout))
  capabilities.fs.write_text(dir + "/runtime.lock", "version = 0.10.114\n")
  return {dir: dir, base: base}
}

fn signed_commit_body(oid: string) -> string {
  return json_stringify(
    {
      data: {
        createCommitOnBranch: {
          commit: {
            oid: oid,
            url: "https://github.com/octo-org/octo-repo/commit/" + oid,
            signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
          },
          ref: {name: "automation/bump-harn-runtime", target: {oid: oid}},
        },
      },
    },
  )
}

fn pull(head_oid: string) {
  return {
    number: 42,
    title: "Bump Harn runtime",
    state: "open",
    html_url: "https://github.com/octo-org/octo-repo/pull/42",
    base: {
      ref: "main",
      sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      repo: {full_name: "octo-org/octo-repo", owner: {login: "octo-org"}},
    },
    head: {
      ref: "automation/bump-harn-runtime",
      sha: head_oid,
      repo: {full_name: "octo-org/octo-repo", owner: {login: "octo-org"}},
    },
    auto_merge: {merge_method: "squash"},
  }
}

pipeline test_release_projection_is_closed_and_exact(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  const tag = "v0.10.53"
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/releases/tags/" + tag,
    {
      status: 200,
      body: json_stringify(
        {
          id: 701,
          tag_name: tag,
          name: "Harn " + tag,
          draft: false,
          prerelease: false,
          html_url: "https://github.com/burin-labs/harn/releases/tag/" + tag,
          target_commitish: "main",
          body: "Release notes",
          published_at: "2026-08-02T00:00:00Z",
          assets: [
            {id: 11, name: "SHA256SUMS", size: 100, state: "uploaded"},
            {id: 12, name: "release-assets.json", size: 200, state: "uploaded"},
          ],
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/git/ref/tags/" + tag,
    {
      status: 200,
      body: json_stringify(
        {
          ref: "refs/tags/" + tag,
          object: {type: "commit", sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
        },
      ),
    },
  )
  assert_eq(
    remote(harness).release_view(tag),
    {
      found: true,
      draft: false,
      prerelease: false,
      asset_names: ["SHA256SUMS", "release-assets.json"],
    },
  )
  const calls = harness.testing.http_mock_calls()
  assert_eq(
    calls.map({ call -> {method: call.method, url: call.url} }).to_list(),
    [
      {method: "GET", url: API + "/repos/burin-labs/harn/releases/tags/" + tag},
      {method: "GET", url: API + "/repos/burin-labs/harn/git/ref/tags/" + tag},
    ],
  )
  harness.testing.http_mock_clear()
}

pipeline test_open_pull_projection_retains_publication_leases(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  const url = API
    + "/repos/octo-org/octo-repo/pulls?state=open&head=octo-org%3Aautomation%2Fbump-harn-runtime&base=main"
  harness.testing.http_mock(
    "GET",
    url,
    {status: 200, body: json_stringify([pull("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")])},
  )
  assert_eq(
    remote(harness).find_bump_pr(),
    {
      number: 42,
      head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      base_ref: "main",
      base_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      auto_merge_enabled: true,
      auto_merge_method: "SQUASH",
      url: "https://github.com/octo-org/octo-repo/pull/42",
      state: "open",
    },
  )
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [{method: "GET", url: url}],
  )
  harness.testing.http_mock_clear()
}

pipeline test_pull_upsert_waits_for_published_head_before_mutation(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const previous_head_oid = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const expected_head_oid = "cccccccccccccccccccccccccccccccccccccccc"
  const list_url = API
    + "/repos/octo-org/octo-repo/pulls?state=open&head=octo-org%3Aautomation%2Fbump-harn-runtime&base=main&per_page=2"
  const pull_url = API + "/repos/octo-org/octo-repo/pulls/42"
  harness.testing.http_mock(
    "GET",
    list_url,
    {
      responses: [
        {status: 200, body: json_stringify([pull(previous_head_oid)])},
        {status: 200, body: json_stringify([pull(expected_head_oid)])},
      ],
    },
  )
  harness.testing.http_mock(
    "PATCH",
    pull_url,
    {status: 200, body: json_stringify(pull(expected_head_oid))},
  )
  const existing = {
    number: 42,
    head_oid: previous_head_oid,
    base_ref: "main",
    base_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    auto_merge_enabled: true,
    auto_merge_method: "SQUASH",
    url: "https://github.com/octo-org/octo-repo/pull/42",
    state: "open",
  }
  assert_eq(
    remote(harness).upsert_pr(existing, expected_head_oid),
    {
      number: 42,
      head_oid: expected_head_oid,
      url: "https://github.com/octo-org/octo-repo/pull/42",
      created: false,
    },
  )
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [
      {method: "GET", url: list_url},
      {method: "GET", url: list_url},
      {method: "PATCH", url: pull_url},
    ],
  )
  harness.testing.http_mock_clear()
}

pipeline test_signed_worktree_publication_retries_one_github_502_in_place(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const fixture = publication_repo({fs: harness.fs, process: harness.process})
  const ref_url = API
    + "/repos/octo-org/octo-repo/git/ref/heads/automation/bump-harn-runtime"
  const reference = {
    status: 200,
    body: json_stringify(
      {ref: "refs/heads/automation/bump-harn-runtime", object: {sha: fixture.base, type: "commit"}},
    ),
  }
  harness.testing.http_mock("GET", ref_url, {responses: [reference, reference]})
  const commit_oid = "cccccccccccccccccccccccccccccccccccccccc"
  harness.testing.http_mock(
    "POST",
    API + "/graphql",
    {
      responses: [
        {status: 502, body: json_stringify({message: "Bad Gateway"})},
        {status: 200, body: signed_commit_body(commit_oid)},
      ],
    },
  )
  const receipt = remote(harness, fixture.dir).publish_commit(
    {branch: "automation/bump-harn-runtime", headline: "Bump Harn runtime", base_sha: fixture.base},
  )
  assert_eq(receipt.oid, commit_oid)
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [
      {method: "GET", url: ref_url},
      {method: "POST", url: API + "/graphql"},
      {method: "GET", url: ref_url},
      {method: "POST", url: API + "/graphql"},
    ],
  )
  harness.testing.http_mock_clear()
}
