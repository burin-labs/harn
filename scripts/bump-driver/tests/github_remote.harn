import { assert_eq, assert_throws } from "std/testing"
import { github_bump_auth_options, github_bump_live_adapter } from "../authentication"
import { bump_pull_request_body, github_bump_remote } from "../github_remote"
import { reset_token_cache } from "harn-github-connector/default"

const API = "https://api.github.com"

pipeline test_each_refresh_callback_receives_a_current_scoped_token(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("bump-refresh-token-")
  const log = root + "/observed-token"
  const options = github_bump_auth_options(
    {
      app_id: "12345",
      installation_id: "77",
      private_key_pem: harness.fs.read_text(
        path_join(harness.fs.source_dir(), "fixtures/github_app_test_key.pem"),
      ),
    },
    "octo-org/octo-repo",
  )
  const remote = github_bump_remote(
    harness,
    {
      repo: "octo-org/octo-repo",
      release_repo: "burin-labs/harn",
      options: options,
      branch: "automation/bump-harn-runtime",
      base: "main",
    },
  )
  const adapter = github_bump_live_adapter(
    harness,
    {
      remote: remote,
      authentication: options,
      config: {
        repo_dir: root,
        version_file: root + "/.harn-version",
        revision_file: root + "/.harn-revision",
        refresh_command: "printf '%s\\n' \"$GH_TOKEN\" >> \"$TOKEN_LOG\"",
        refresh_environment: {TOKEN_LOG: log},
      },
    },
  )
  reset_token_cache(harness.runtime)
  harness.testing.http_mock_clear()
  harness.testing.clock_set(1700000000000)
  try {
    harness.testing.http_mock(
      "POST",
      API + "/app/installations/77/access_tokens",
      {
        responses: [
          {
            status: 201,
            body: "{\"token\":\"first-synthetic-token\",\"expires_at\":\"2023-11-14T23:13:20Z\"}",
          },
          {
            status: 201,
            body: "{\"token\":\"renewed-synthetic-token\",\"expires_at\":\"2023-11-15T00:13:20Z\"}",
          },
        ],
      },
    )
    assert(adapter.apply_version("v0.10.2", "").ok)
    harness.testing.clock_advance(3700000)
    assert(adapter.apply_version("v0.10.3", "").ok)
    assert_eq(
      harness.fs.read_text(log),
      "first-synthetic-token\nrenewed-synthetic-token\n",
      "each actual child must observe its callback's current token",
    )
    const calls = harness.testing.http_mock_calls()
    assert_eq(len(calls), 2, "both callbacks must reach token issuance")
    assert_eq(json_parse(calls[0].body), json_parse(calls[1].body), "renewal retains scope")
  } finally {
    harness.testing.clock_reset()
    harness.testing.http_mock_clear()
    reset_token_cache(harness.runtime)
    harness.fs.delete(root)
  }
}

pipeline test_long_build_renews_before_base_read_and_git_fetch(harness: Harness) {
  const fixture = publication_repo(pick(harness, ["fs", "process"]))
  git_ok(harness.process, fixture.dir, ["remote", "add", "origin", fixture.dir])
  const options = github_bump_auth_options(
    {
      app_id: "12345",
      installation_id: "77",
      private_key_pem: harness.fs.read_text(
        path_join(harness.fs.source_dir(), "fixtures/github_app_test_key.pem"),
      ),
    },
    "octo-org/octo-repo",
  )
  const driver = github_bump_remote(
    harness,
    {
      repo: "octo-org/octo-repo",
      release_repo: "burin-labs/harn",
      options: options,
      branch: "automation/bump-harn-runtime",
      base: "main",
      repo_dir: fixture.dir,
    },
  )
  reset_token_cache(harness.runtime)
  harness.testing.http_mock_clear()
  harness.testing.clock_set(1700000000000)
  try {
    harness.testing.http_mock(
      "POST",
      API + "/app/installations/77/access_tokens",
      {
        responses: [
          {
            status: 201,
            body: "{\"token\":\"initial-token\",\"expires_at\":\"2023-11-14T23:13:20Z\"}",
          },
          {
            status: 201,
            body: "{\"token\":\"read-renewed-token\",\"expires_at\":\"2023-11-15T00:13:20Z\"}",
          },
          {
            status: 201,
            body: "{\"token\":\"fetch-renewed-token\",\"expires_at\":\"2023-11-15T01:13:20Z\"}",
          },
        ],
      },
    )
    harness.testing.http_mock(
      "GET",
      API + "/repos/octo-org/octo-repo/branches/main",
      {status: 200, body: json_stringify({name: "main", commit: {sha: fixture.base}})},
    )
    assert_eq(driver.base_head().oid, fixture.base)
    harness.testing.clock_advance(3700000)
    assert_eq(driver.base_head().oid, fixture.base, "base read after a long build must renew")
    harness.testing.clock_advance(3700000)
    assert(driver.fetch_base(fixture.base).ok, "fresh token issuance must reach a real Git fetch")
    assert_eq(
      trim(
        to_string(
          git_ok(harness.process, fixture.dir, ["rev-parse", "refs/remotes/origin/main"]).stdout,
        ),
      ),
      fixture.base,
    )
    const calls = harness.testing.http_mock_calls()
    assert_eq(len(calls), 5, "three token exchanges and two base reads must fire")
    for index in [0, 2, 4] {
      assert_eq(
        json_parse(calls[index].body),
        {repositories: ["octo-repo"], permissions: {contents: "write", pull_requests: "write"}},
      )
    }
  } finally {
    harness.testing.clock_reset()
    harness.testing.http_mock_clear()
    reset_token_cache(harness.runtime)
    harness.fs.delete(fixture.dir)
  }
}

pipeline test_signed_publication_refuses_a_repair_added_after_inspection(harness: Harness) {
  harness.testing.http_mock_clear()
  const publication = mock_publication_branch(harness, 1)
  const fixture = publication.fixture
  assert_throws(
    { ->
      remote(harness, fixture.dir).publish_commit(
        {
          branch: "automation/bump-harn-runtime",
          headline: "Bump Harn runtime",
          base_sha: fixture.base,
          expected_branch_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          repair_commits: ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
        },
      )
    },
  )
  assert_eq(harness.testing.http_mock_calls().map({ call -> call.method }).to_list(), ["GET"])
  harness.testing.http_mock_clear()
}

fn remote(harness: Harness, repo_dir: string = ".") {
  return github_bump_remote(
    harness,
    {
      repo: "octo-org/octo-repo",
      release_repo: "burin-labs/harn",
      token: "github-app-installation-token",
      branch: "automation/bump-harn-runtime",
      base: "main",
      repo_dir: repo_dir,
    },
  )
}

fn run_ok(process: HarnessProcess, spec: dict) -> dict {
  const result = process.run(spec)
  if !result.success {
    throw "fixture command failed with exit " + to_string(result.exit_code) + ": "
      + to_string(result.stderr)
  }
  return result
}

fn git_ok(process: HarnessProcess, dir: string, args: list<string>) -> dict {
  return run_ok(
    process,
    {program: "git", args: args, cwd: dir, env: {}, stdin: "", timeout_ms: 120000},
  )
}

fn publication_repo(capabilities: {fs: HarnessFs, process: HarnessProcess}) -> dict {
  const dir = capabilities.fs.mkdtemp_in_workspace("harn-bump-publication-")
  git_ok(capabilities.process, dir, ["init", "-q", "-b", "main", "."])
  git_ok(capabilities.process, dir, ["config", "user.email", "harn-bump-test@example.test"])
  git_ok(capabilities.process, dir, ["config", "user.name", "Harn Bump Test"])
  git_ok(capabilities.process, dir, ["config", "commit.gpgsign", "false"])
  git_ok(capabilities.process, dir, ["config", "core.hooksPath", ".git/harn-absent-hooks"])
  capabilities.fs.write_text(dir + "/runtime.lock", "version = 0.10.113\n")
  git_ok(capabilities.process, dir, ["add", "runtime.lock"])
  git_ok(capabilities.process, dir, ["commit", "-q", "--no-verify", "-m", "base"])
  const base = trim(to_string(git_ok(capabilities.process, dir, ["rev-parse", "HEAD"]).stdout))
  capabilities.fs.write_text(dir + "/runtime.lock", "version = 0.10.114\n")
  return {dir: dir, base: base}
}

fn signed_commit_body(oid: string) -> string {
  return json_stringify(
    {
      data: {
        createCommitOnBranch: {
          commit: {
            oid: oid,
            url: "https://github.com/octo-org/octo-repo/commit/" + oid,
            signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
          },
          ref: {name: "automation/bump-harn-runtime", target: {oid: oid}},
        },
      },
    },
  )
}

fn mock_publication_branch(harness: Harness, attempts: int) -> dict {
  if attempts != 1 && attempts != 2 {
    throw "publication fixture supports one or two attempts"
  }
  const fixture = publication_repo(pick(harness, ["fs", "process"]))
  const ref_url = API
    + "/repos/octo-org/octo-repo/git/ref/heads/automation/bump-harn-runtime"
  const reference = {
    status: 200,
    body: json_stringify(
      {ref: "refs/heads/automation/bump-harn-runtime", object: {sha: fixture.base, type: "commit"}},
    ),
  }
  harness.testing.http_mock(
    "GET",
    ref_url,
    {
      responses: if attempts == 2 {
        [reference, reference]
      } else {
        [reference]
      },
    },
  )
  return {fixture: fixture, ref_url: ref_url}
}

fn pull(head_oid: string) {
  return {
    number: 42,
    title: "Bump Harn runtime",
    state: "open",
    html_url: "https://github.com/octo-org/octo-repo/pull/42",
    base: {
      ref: "main",
      sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      repo: {full_name: "octo-org/octo-repo", owner: {login: "octo-org"}},
    },
    head: {
      ref: "automation/bump-harn-runtime",
      sha: head_oid,
      repo: {full_name: "octo-org/octo-repo", owner: {login: "octo-org"}},
    },
    auto_merge: {merge_method: "squash"},
  }
}

pipeline test_base_head_projects_exact_identity_and_unavailable_state(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const url = API + "/repos/octo-org/octo-repo/branches/main"
  harness.testing.http_mock(
    "GET",
    url,
    {
      responses: [
        {
          status: 200,
          body: json_stringify(
            {name: "main", commit: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}},
          ),
        },
        {status: 503, body: json_stringify({message: "temporarily unavailable"})},
      ],
    },
  )
  assert_eq(
    remote(harness).base_head(),
    {available: true, oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", detail: ""},
  )
  const unavailable = remote(harness).base_head()
  assert_eq(unavailable.available, false)
  assert_eq(unavailable.oid, nil)
  assert(trim(unavailable.detail) != "")
  harness.testing.http_mock_clear()
}

pipeline test_bump_pr_body_attaches_exact_package_test_receipt(task: unknown) {
  const receipt = "{\"schemaVersion\":1,\"ok\":false}"
  const body = bump_pull_request_body(receipt)
  assert(contains(body, "sha256:" + sha256(receipt)))
  assert(contains(body, base64_encode(receipt)))
  assert_eq(base64_decode(base64_encode(receipt)), receipt)
}

pipeline test_bump_pr_body_names_exact_source_commit(task: unknown) {
  const revision = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const body = bump_pull_request_body(nil, revision)
  assert(contains(body, "Target Harn source revision: `${revision}`."))
  assert(!contains(bump_pull_request_body(), "Target Harn source revision"))
}

pipeline test_release_projection_is_closed_and_exact(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  const tag = "v0.10.53"
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/releases/tags/" + tag,
    {
      status: 200,
      body: json_stringify(
        {
          id: 701,
          tag_name: tag,
          name: "Harn " + tag,
          draft: false,
          prerelease: false,
          html_url: "https://github.com/burin-labs/harn/releases/tag/" + tag,
          target_commitish: "main",
          body: "Release notes",
          published_at: "2026-08-02T00:00:00Z",
          assets: [
            {id: 11, name: "SHA256SUMS", size: 100, state: "uploaded"},
            {id: 12, name: "release-assets.json", size: 200, state: "uploaded"},
          ],
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/git/ref/tags/" + tag,
    {
      status: 200,
      body: json_stringify(
        {
          ref: "refs/tags/" + tag,
          object: {type: "commit", sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
        },
      ),
    },
  )
  assert_eq(
    remote(harness).release_view(tag),
    {
      found: true,
      draft: false,
      prerelease: false,
      asset_names: ["SHA256SUMS", "release-assets.json"],
    },
  )
  const calls = harness.testing.http_mock_calls()
  assert_eq(
    calls.map({ call -> {method: call.method, url: call.url} }).to_list(),
    [
      {method: "GET", url: API + "/repos/burin-labs/harn/releases/tags/" + tag},
      {method: "GET", url: API + "/repos/burin-labs/harn/git/ref/tags/" + tag},
    ],
  )
  harness.testing.http_mock_clear()
}

pipeline test_open_pull_projection_retains_publication_leases(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  const url = API
    + "/repos/octo-org/octo-repo/pulls?state=open&head=octo-org%3Aautomation%2Fbump-harn-runtime&base=main"
  harness.testing.http_mock(
    "GET",
    url,
    {status: 200, body: json_stringify([pull("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")])},
  )
  assert_eq(
    remote(harness).find_bump_pr(),
    {
      number: 42,
      head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      base_ref: "main",
      base_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      auto_merge_enabled: true,
      auto_merge_method: "SQUASH",
      url: "https://github.com/octo-org/octo-repo/pull/42",
      state: "open",
    },
  )
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [{method: "GET", url: url}],
  )
  harness.testing.http_mock_clear()
}

pipeline test_pull_upsert_waits_for_published_head_before_mutation(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const previous_head_oid = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const expected_head_oid = "cccccccccccccccccccccccccccccccccccccccc"
  const list_url = API
    + "/repos/octo-org/octo-repo/pulls?state=open&head=octo-org%3Aautomation%2Fbump-harn-runtime&base=main&per_page=2"
  const pull_url = API + "/repos/octo-org/octo-repo/pulls/42"
  harness.testing.http_mock(
    "GET",
    list_url,
    {
      responses: [
        {status: 200, body: json_stringify([pull(previous_head_oid)])},
        {status: 200, body: json_stringify([pull(expected_head_oid)])},
      ],
    },
  )
  harness.testing.http_mock(
    "PATCH",
    pull_url,
    {status: 200, body: json_stringify(pull(expected_head_oid))},
  )
  const existing = {
    number: 42,
    head_oid: previous_head_oid,
    base_ref: "main",
    base_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    auto_merge_enabled: true,
    auto_merge_method: "SQUASH",
    url: "https://github.com/octo-org/octo-repo/pull/42",
    state: "open",
  }
  assert_eq(
    remote(harness).upsert_pr(existing, expected_head_oid),
    {
      number: 42,
      head_oid: expected_head_oid,
      url: "https://github.com/octo-org/octo-repo/pull/42",
      created: false,
    },
  )
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [
      {method: "GET", url: list_url},
      {method: "GET", url: list_url},
      {method: "PATCH", url: pull_url},
    ],
  )
  harness.testing.http_mock_clear()
}

pipeline test_signed_worktree_publication_retries_one_github_502_in_place(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const publication = mock_publication_branch(harness, 2)
  const fixture = publication.fixture
  const ref_url = publication.ref_url
  const commit_oid = "cccccccccccccccccccccccccccccccccccccccc"
  harness.testing.http_mock(
    "POST",
    API + "/graphql",
    {
      responses: [
        {status: 502, body: json_stringify({message: "Bad Gateway"})},
        {status: 200, body: signed_commit_body(commit_oid)},
      ],
    },
  )
  const receipt = remote(harness, fixture.dir).publish_commit(
    {branch: "automation/bump-harn-runtime", headline: "Bump Harn runtime", base_sha: fixture.base},
  )
  assert_eq(receipt.oid, commit_oid)
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [
      {method: "GET", url: ref_url},
      {method: "POST", url: API + "/graphql"},
      {method: "GET", url: ref_url},
      {method: "POST", url: API + "/graphql"},
    ],
  )
  harness.testing.http_mock_clear()
}

pipeline test_signed_worktree_publication_retries_graphql_server_failure_in_place(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const publication = mock_publication_branch(harness, 2)
  const fixture = publication.fixture
  const ref_url = publication.ref_url
  const commit_oid = "dddddddddddddddddddddddddddddddddddddddd"
  harness.testing.http_mock(
    "POST",
    API + "/graphql",
    {
      responses: [
        {
          status: 200,
          body: json_stringify(
            {
              errors: [
                {type: "INTERNAL", message: "GitHub could not complete this GraphQL operation"},
              ],
            },
          ),
        },
        {status: 200, body: signed_commit_body(commit_oid)},
      ],
    },
  )
  const receipt = remote(harness, fixture.dir).publish_commit(
    {branch: "automation/bump-harn-runtime", headline: "Bump Harn runtime", base_sha: fixture.base},
  )
  assert_eq(receipt.oid, commit_oid)
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [
      {method: "GET", url: ref_url},
      {method: "POST", url: API + "/graphql"},
      {method: "GET", url: ref_url},
      {method: "POST", url: API + "/graphql"},
    ],
  )
  harness.testing.http_mock_clear()
}

pipeline test_signed_worktree_publication_does_not_retry_semantic_graphql_failure(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  const publication = mock_publication_branch(harness, 1)
  const fixture = publication.fixture
  const ref_url = publication.ref_url
  harness.testing.http_mock(
    "POST",
    API + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {errors: [{type: "FORBIDDEN", message: "Resource not accessible by integration"}]},
      ),
    },
  )
  const outcome = try {
    remote(harness, fixture.dir).publish_commit(
      {
        branch: "automation/bump-harn-runtime",
        headline: "Bump Harn runtime",
        base_sha: fixture.base,
      },
    )
  }
  assert(is_err(outcome), "semantic GraphQL publication failure remains terminal")
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> {method: call.method, url: call.url} })
      .to_list(),
    [{method: "GET", url: ref_url}, {method: "POST", url: API + "/graphql"}],
  )
  harness.testing.http_mock_clear()
}
