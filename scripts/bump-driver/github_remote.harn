import { LiveBumpFetch, LiveBumpRemote } from "std/bump/live"
import { BumpAutoMerge } from "std/bump/runtime"
import { command_run } from "std/command"
/** GitHub package implementation of std/bump/live's remote capability. */
import {
  GithubBranchHeadRequest,
  GithubBranchTreeCompareRequest,
  GithubClientOptions,
  GithubPullRequestUpsertRequest,
  github_branch_head,
  github_close_pr,
  github_compare_branch_trees,
  github_find_open_pr,
  github_latest_release,
  github_merge_queue_enqueue,
  github_merge_queue_entries,
  github_release,
  github_resolve_mergeable,
  github_upsert_pull_request,
  pulls_disable_auto_merge,
  pulls_enable_auto_merge,
  pulls_merge_safe,
} from "harn-github-connector/default"
import {
  GithubConnectorError,
  GithubWorktreeCommitRequest,
  github_commit_worktree,
} from "harn-github-connector/worktree"

/** A publication replay reuses the same exact worktree and base lease. */
const WORKTREE_PUBLICATION_MAX_ATTEMPTS = 3

/** Short bounded delays keep a transient GitHub outage from rerunning the bump. */
const WORKTREE_PUBLICATION_RETRY_DELAYS_MS = [250, 1000]

/** Closed configuration for one repository-bound GitHub bump driver. */
pub type GithubBumpRemoteConfig = {
  repo: string,
  release_repo: string,
  token: string,
  branch: string,
  base: string,
  repo_dir?: string,
  package_test_receipt?: string,
}

type GithubRepo = {owner: string, name: string}

fn __repo(value: string) -> GithubRepo {
  const parts = split(trim(value), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    throw "bump-driver: expected owner/repo, got '" + value + "'"
  }
  return {owner: parts[0], name: parts[1]}
}

fn __must(result: any, operation: string) {
  if is_err(result) {
    throw "bump-driver: " + operation + " failed: " + json_stringify(unwrap_err(result))
  }
  return unwrap(result)
}

/** Render the exact pre-mutation package-test receipt into the bump PR. */
pub fn bump_pull_request_body(package_test_receipt: string? = nil) -> string {
  const base =
    "Automated Harn runtime bump. Regenerated the lockfile and ran the declared validation entrypoint. Merges through the normal queue.\n\nProduced by the reusable `bump-harn` workflow."
  const receipt = trim(package_test_receipt ?? "")
  if receipt == "" {
    return base
  }
  return base
    + "\n\n<details><summary>Pre-mutation package test discovery receipt (sha256:"
    + sha256(receipt)
    + ")</summary>\n\n```base64\n"
    + base64_encode(receipt)
    + "\n```\n\n</details>"
}

fn __retryable_publication_failure(failure: GithubConnectorError) -> bool {
  const status = failure.http_status ?? 0
  if failure.category == "network" && status >= 500 && status < 600 {
    return true
  }
  return failure.category == "graphql" && failure.graphql_error_kind == "server"
    && (failure.retryable ?? false)
}

/**
 * Replay only the leased worktree publication after a classified transient GitHub failure.
 *
 * Refresh, formatting, validation, and signed-worktree assembly all precede
 * this adapter. Re-entering the connector derives the same delta from the same
 * worktree and reconciles it under the same base lease; it never reruns those
 * expensive or mutating preparation stages.
 */
fn __publish_worktree(harness: Harness, publication: GithubWorktreeCommitRequest) {
  let attempt = 1
  let result = github_commit_worktree(harness, publication)
  while is_err(result) && attempt < WORKTREE_PUBLICATION_MAX_ATTEMPTS {
    const failure: GithubConnectorError = unwrap_err(result)
    if !__retryable_publication_failure(failure) {
      return result
    }
    harness.clock.sleep_ms(WORKTREE_PUBLICATION_RETRY_DELAYS_MS[attempt - 1] ?? 0)
    attempt = attempt + 1
    result = github_commit_worktree(harness, publication)
  }
  return result
}

/** Bind the GitHub connector package to std/bump/live's provider boundary. */
pub fn github_bump_remote(harness: Harness, config: GithubBumpRemoteConfig) -> LiveBumpRemote {
  const repo = __repo(config.repo)
  const release_repo = __repo(config.release_repo)
  const options = {installation_token: config.token}
  return {
    latest_release_tag: fn() {
      const latest = __must(
        github_latest_release(
          harness,
          {owner: release_repo.owner, repo: release_repo.name, options: options},
        ),
        "latest release lookup",
      )
      if !(latest.ok ?? false) {
        throw "bump-driver: latest release lookup returned an unsuccessful envelope"
      }
      return trim(to_string(latest.tag_name ?? ""))
    },
    release_view: fn(tag) {
      const lookup = __must(
        github_release(
          harness,
          {owner: release_repo.owner, repo: release_repo.name, tag: tag, options: options},
        ),
        "release lookup",
      )
      if !lookup.found {
        return {found: false, draft: true, prerelease: true, asset_names: []}
      }
      const release = lookup.release
      if release == nil {
        throw "bump-driver: found release lookup omitted its typed release"
      }
      return {
        found: true,
        draft: release.draft,
        prerelease: release.prerelease,
        asset_names: release.assets.map({ asset -> asset.name }).to_list(),
      }
    },
    base_head: fn() {
      const request: GithubBranchHeadRequest = {
        owner: repo.owner,
        repo: repo.name,
        branch: config.base,
        options: options,
      }
      const result = github_branch_head(harness, request)
      if is_err(result) {
        return {available: false, oid: nil, detail: json_stringify(unwrap_err(result))}
      }
      const head = unwrap(result)
      return {available: true, oid: head.oid, detail: ""}
    },
    fetch_base: fn(oid) {
      // The runner checks the package repo out with `persist-credentials:
      // false`, so `origin` carries no authentication. Supply the installation
      // token through a credential helper reading one environment variable:
      // the secret never reaches argv, the process table, or a log line.
      const helper = "!f() { echo username=x-access-token; "
        + "echo \"password=$HARN_BUMP_FETCH_TOKEN\"; }; f"
      const result = command_run(
        harness.tools,
        {
          mode: "argv",
          argv: [
            "git",
            "-c",
            "credential.helper=",
            "-c",
            "credential.helper=" + helper,
            "fetch",
            "--no-tags",
            "--force",
            "origin",
            config.base,
          ],
          cwd: config.repo_dir ?? ".",
          env: {HARN_BUMP_FETCH_TOKEN: config.token},
        },
      )
      const ok: bool = result.success ?? false
      const outcome: LiveBumpFetch = {
        ok: ok,
        detail: if ok {
          "fetched ${config.base} while adopting ${oid}"
        } else {
          trim(to_string(result.stderr ?? ""))
        },
      }
      return outcome
    },
    find_bump_pr: fn() {
      const found = github_find_open_pr(
        harness,
        {
          owner: repo.owner,
          repo: repo.name,
          head_ref: config.branch,
          base_ref: config.base,
          head_owner: repo.owner,
          options: options,
        },
      )
      if !found.ok {
        throw "bump-driver: pull request lookup failed: " + json_stringify(found.error)
      }
      if found.total_matches > 1 {
        throw "bump-driver: pull request lookup found "
          + to_string(found.total_matches)
          + " exact head/base matches"
      }
      if !found.found {
        return nil
      }
      const pull = found.pull_request
      if pull == nil {
        throw "bump-driver: found pull request lookup omitted its typed pull request"
      }
      return {
        number: pull.number,
        head_oid: pull.head.sha,
        base_ref: pull.base.ref,
        base_oid: pull.base.sha,
        auto_merge_enabled: pull.auto_merge_armed,
        auto_merge_method: pull.auto_merge_method,
        url: pull.url,
        state: pull.github_state,
      }
    },
    disable_auto_merge: fn(pull, base_oid) {
      __must(
        pulls_disable_auto_merge(
          harness,
          {
            owner: repo.owner,
            repo: repo.name,
            pull_number: pull.number,
            expected_head_oid: pull.head_oid,
            base_branch: pull.base_ref,
            expected_base_oid: base_oid,
            restore_merge_method: (pull.auto_merge_method ?? "squash").lower(),
            options: options,
          },
        ),
        "leased auto-merge disable",
      )
      return true
    },
    publish_commit: fn(request) {
      const publication: GithubWorktreeCommitRequest = {
        owner: repo.owner,
        repo: repo.name,
        branch: request.branch,
        headline: request.headline,
        repo_dir: config.repo_dir ?? ".",
        source: "worktree",
        base_oid: request.base_sha,
        create_branch: true,
        reset_branch: true,
        options: options,
      }
      const receipt = __must(
        __publish_worktree(harness, publication),
        "leased signed worktree publication",
      )
      if !receipt.committed {
        throw "bump-driver: non-empty runtime changes produced no signed commit"
      }
      return {
        oid: receipt.commit_oid,
        url: receipt.commit_url,
        branch_action: receipt.branch_action,
      }
    },
    branch_matches_base: fn() {
      const request: GithubBranchTreeCompareRequest = {
        owner: repo.owner,
        repo: repo.name,
        left_ref: config.branch,
        right_ref: config.base,
        options: options,
      }
      return __must(github_compare_branch_trees(harness, request), "branch tree comparison").equal
    },
    upsert_pr: fn(existing, expected_head_oid) {
      const request: GithubPullRequestUpsertRequest = {
        owner: repo.owner,
        repo: repo.name,
        head: config.branch,
        base: config.base,
        title: "Bump Harn runtime",
        body: bump_pull_request_body(config.package_test_receipt),
        expected_head_oid: expected_head_oid,
        previous_head_oid: existing?.head_oid,
        options: options,
      }
      const receipt = __must(
        github_upsert_pull_request(harness, request),
        "leased pull request upsert",
      )
      return {
        number: receipt.number,
        head_oid: receipt.head.sha,
        url: receipt.url,
        created: receipt.action == "created",
      }
    },
    close_pr: fn(number, comment) {
      const receipt = github_close_pr(
        harness,
        {
          owner: repo.owner,
          repo: repo.name,
          pull_number: number,
          comment: comment,
          options: options,
        },
      )
      if !receipt.ok {
        throw "bump-driver: pull request close failed: " + json_stringify(receipt.error)
      }
      return true
    },
    enable_auto_merge: fn(number, expected_head_oid) { return __land(
      harness,
      {repo: repo, options: options, base: config.base},
      number,
      expected_head_oid,
    ) },
  }
}

/**
 * What the driver reads back after arming. `mergeable_state` is GitHub's
 * resolved REST value; `queue` is whether the base branch has a merge queue.
 */
pub type LandingObservation = {
  expected_head_oid: string,
  observed_head_oid: string,
  armed: bool,
  mergeable_state: string,
  queue: bool,
  queued: bool,
}

/** The one next step that leaves the pull request merged, queued, or waiting on an event. */
pub type LandingDecision = "stale_head" \
  | "unresolved" \
  | "queued" \
  | "enqueue" \
  | "merge" \
  | "armed" \
  | "arm"

/**
 * Decide how an armed or refused repin pull request lands.
 *
 * GitHub fires auto-merge on the next state change. A pull request that is
 * already clean produces none, and GitHub refuses to arm one at all, so an
 * off/on toggle cannot recover it. A clean pull request is therefore landed
 * explicitly: enqueued when the base branch requires a merge queue, merged
 * otherwise. Anything not yet clean stays armed; its checks still owe GitHub
 * the event that fires the merge.
 */
pub fn landing_decision(seen: LandingObservation) -> LandingDecision {
  if seen.observed_head_oid != seen.expected_head_oid {
    return "stale_head"
  }
  if seen.mergeable_state == "unknown" {
    return "unresolved"
  }
  if seen.mergeable_state == "clean" || seen.mergeable_state == "has_hooks" {
    if !seen.queue {
      return "merge"
    }
    return if seen.queued {
      "queued"
    } else {
      "enqueue"
    }
  }
  return if seen.armed {
    "armed"
  } else {
    "arm"
  }
}

type LandingTarget = {repo: GithubRepo, options: GithubClientOptions, base: string}

/** The fields of GitHub's pull document the landing decision reads. */
type PullLandingEvidence = {head: {sha: string}, auto_merge: dict?}

fn __landing(state: string, enabled: bool, seen: LandingObservation?, detail: string = "") {
  const observed = if seen == nil {
    ""
  } else {
    "mergeable_state=${seen.mergeable_state} queue=${seen.queue} head=${seen.observed_head_oid}"
  }
  const receipt: BumpAutoMerge = {
    enabled: enabled,
    state: state,
    detail: trim(observed + " " + detail),
  }
  return receipt
}

/** Arm under the head lease. `nil` means GitHub reported nothing left to wait on. */
fn __arm(harness: Harness, target: LandingTarget, number: int, head: string) -> bool? {
  const armed = pulls_enable_auto_merge(
    harness,
    {
      owner: target.repo.owner,
      repo: target.repo.name,
      pull_number: number,
      expected_head_oid: head,
      method: "squash",
      options: target.options,
    },
  )
  if is_ok(armed) {
    return true
  }
  const failure: GithubConnectorError = unwrap_err(armed)
  if failure.code == "pull_request_clean" {
    return nil
  }
  if failure.code == "stale_head" {
    return false
  }
  throw "bump-driver: leased auto-merge enable failed: " + json_stringify(failure)
}

fn __observe(
  harness: Harness,
  target: LandingTarget,
  number: int,
  head: string,
) -> LandingObservation {
  const mergeability = __must(
    github_resolve_mergeable(
      harness,
      {
        owner: target.repo.owner,
        repo: target.repo.name,
        pull_number: number,
        options: target.options,
      },
    ),
    "pull request mergeability read",
  )
  const raw = mergeability.raw
  if !schema_is(raw, schema_of(PullLandingEvidence)) {
    throw "bump-driver: mergeability read omitted the pull request head"
  }
  const queue = __must(
    github_merge_queue_entries(
      harness,
      {
        owner: target.repo.owner,
        repo: target.repo.name,
        branch: target.base,
        options: target.options,
      },
    ),
    "merge queue read",
  )
  return {
    expected_head_oid: head,
    observed_head_oid: raw.head.sha,
    armed: raw.auto_merge != nil,
    mergeable_state: if mergeability.resolved {
      mergeability.mergeable_state
    } else {
      "unknown"
    },
    queue: queue.configured,
    queued: queue.entries.any({ entry -> entry.pull_number == number }),
  }
}

/**
 * Arm, read the pull request back, and carry out `landing_decision`. Every
 * outcome is returned as the receipt's `auto_merge`; `enabled` is true only
 * when the pull request is merged, queued, or armed with checks still pending.
 */
fn __land(harness: Harness, target: LandingTarget, number: int, head: string) -> BumpAutoMerge {
  const first = __arm(harness, target, number, head)
  if first == false {
    return __landing("stale_head", false, nil, "arming refused: head moved off ${head}")
  }
  let rearmed = false
  while true {
    const seen = __observe(harness, target, number, head)
    const decision = landing_decision(seen)
    if decision == "armed" || decision == "queued" {
      return __landing(decision, true, seen)
    }
    if decision == "stale_head" || decision == "unresolved" {
      return __landing(decision, false, seen)
    }
    if decision == "enqueue" {
      const enqueued = github_merge_queue_enqueue(
        harness,
        {
          owner: target.repo.owner,
          repo: target.repo.name,
          pull_number: number,
          expected_head_oid: head,
          options: target.options,
        },
      )
      if is_err(enqueued) && unwrap_err(enqueued).code == "stale_head" {
        return __landing("stale_head", false, seen, "enqueue refused")
      }
      const entry = __must(enqueued, "leased merge queue enqueue").entry
      return __landing("enqueued", true, seen, "position=${entry.position}")
    }
    if decision == "merge" {
      const merged = pulls_merge_safe(
        harness,
        {
          owner: target.repo.owner,
          repo: target.repo.name,
          pull_number: number,
          expected_head_oid: head,
          method: "squash",
          options: target.options,
        },
      )
      if is_err(merged) && unwrap_err(merged).code == "stale_head" {
        return __landing("stale_head", false, seen, "merge refused")
      }
      __must(merged, "leased pull request merge")
      return __landing("merged", true, seen)
    }
    // "arm": GitHub refused to arm a clean pull request that is no longer
    // clean. Arm it once more; a second refusal is reported, not looped on.
    if rearmed {
      return __landing("unresolved", false, seen, "arming refused twice")
    }
    rearmed = true
    if __arm(harness, target, number, head) == false {
      return __landing("stale_head", false, seen, "re-arming refused")
    }
  }
}
