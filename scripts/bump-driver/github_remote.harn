import { LiveBumpRemote } from "std/bump/live"
/** GitHub package implementation of std/bump/live's remote capability. */
import {
  GithubBranchTreeCompareRequest,
  GithubPullRequestUpsertRequest,
  github_close_pr,
  github_compare_branch_trees,
  github_find_open_pr,
  github_latest_release,
  github_release,
  github_upsert_pull_request,
  pulls_disable_auto_merge,
  pulls_enable_auto_merge,
} from "harn-github-connector/default"
import {
  GithubConnectorError,
  GithubWorktreeCommitRequest,
  github_commit_worktree,
} from "harn-github-connector/worktree"

/** A publication replay reuses the same exact worktree and base lease. */
const WORKTREE_PUBLICATION_MAX_ATTEMPTS = 3

/** Short bounded delays keep a transient GitHub outage from rerunning the bump. */
const WORKTREE_PUBLICATION_RETRY_DELAYS_MS = [250, 1000]

/** Closed configuration for one repository-bound GitHub bump driver. */
pub type GithubBumpRemoteConfig = {
  repo: string,
  release_repo: string,
  token: string,
  branch: string,
  base: string,
  repo_dir?: string,
}

type GithubRepo = {owner: string, name: string}

fn __repo(value: string) -> GithubRepo {
  const parts = split(trim(value), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    throw "bump-driver: expected owner/repo, got '" + value + "'"
  }
  return {owner: parts[0], name: parts[1]}
}

fn __must(result: any, operation: string) {
  if is_err(result) {
    throw "bump-driver: " + operation + " failed: " + json_stringify(unwrap_err(result))
  }
  return unwrap(result)
}

fn __retryable_publication_failure(failure: GithubConnectorError) -> bool {
  const status = failure.http_status ?? 0
  if failure.category == "network" && status >= 500 && status < 600 {
    return true
  }
  return failure.category == "graphql" && failure.graphql_error_kind == "server"
    && (failure.retryable ?? false)
}

/**
 * Replay only the leased worktree publication after a classified transient GitHub failure.
 *
 * Refresh, formatting, validation, and signed-worktree assembly all precede
 * this adapter. Re-entering the connector derives the same delta from the same
 * worktree and reconciles it under the same base lease; it never reruns those
 * expensive or mutating preparation stages.
 */
fn __publish_worktree(harness: Harness, publication: GithubWorktreeCommitRequest) {
  let attempt = 1
  let result = github_commit_worktree(harness, publication)
  while is_err(result) && attempt < WORKTREE_PUBLICATION_MAX_ATTEMPTS {
    const failure: GithubConnectorError = unwrap_err(result)
    if !__retryable_publication_failure(failure) {
      return result
    }
    harness.clock.sleep_ms(WORKTREE_PUBLICATION_RETRY_DELAYS_MS[attempt - 1] ?? 0)
    attempt = attempt + 1
    result = github_commit_worktree(harness, publication)
  }
  return result
}

/** Bind the GitHub connector package to std/bump/live's provider boundary. */
pub fn github_bump_remote(harness: Harness, config: GithubBumpRemoteConfig) -> LiveBumpRemote {
  const repo = __repo(config.repo)
  const release_repo = __repo(config.release_repo)
  const options = {installation_token: config.token}
  return {
    latest_release_tag: fn() {
      const latest = __must(
        github_latest_release(
          harness,
          {owner: release_repo.owner, repo: release_repo.name, options: options},
        ),
        "latest release lookup",
      )
      if !(latest.ok ?? false) {
        throw "bump-driver: latest release lookup returned an unsuccessful envelope"
      }
      return trim(to_string(latest.tag_name ?? ""))
    },
    release_view: fn(tag) {
      const lookup = __must(
        github_release(
          harness,
          {owner: release_repo.owner, repo: release_repo.name, tag: tag, options: options},
        ),
        "release lookup",
      )
      if !lookup.found {
        return {found: false, draft: true, prerelease: true, asset_names: []}
      }
      const release = lookup.release
      if release == nil {
        throw "bump-driver: found release lookup omitted its typed release"
      }
      return {
        found: true,
        draft: release.draft,
        prerelease: release.prerelease,
        asset_names: release.assets.map({ asset -> asset.name }).to_list(),
      }
    },
    find_bump_pr: fn() {
      const found = github_find_open_pr(
        harness,
        {
          owner: repo.owner,
          repo: repo.name,
          head_ref: config.branch,
          base_ref: config.base,
          head_owner: repo.owner,
          options: options,
        },
      )
      if !found.ok {
        throw "bump-driver: pull request lookup failed: " + json_stringify(found.error)
      }
      if found.total_matches > 1 {
        throw "bump-driver: pull request lookup found "
          + to_string(found.total_matches)
          + " exact head/base matches"
      }
      if !found.found {
        return nil
      }
      const pull = found.pull_request
      if pull == nil {
        throw "bump-driver: found pull request lookup omitted its typed pull request"
      }
      return {
        number: pull.number,
        head_oid: pull.head.sha,
        base_ref: pull.base.ref,
        base_oid: pull.base.sha,
        auto_merge_enabled: pull.auto_merge_armed,
        auto_merge_method: pull.auto_merge_method,
        url: pull.url,
        state: pull.github_state,
      }
    },
    disable_auto_merge: fn(pull, base_oid) {
      __must(
        pulls_disable_auto_merge(
          harness,
          {
            owner: repo.owner,
            repo: repo.name,
            pull_number: pull.number,
            expected_head_oid: pull.head_oid,
            base_branch: pull.base_ref,
            expected_base_oid: base_oid,
            restore_merge_method: (pull.auto_merge_method ?? "squash").lower(),
            options: options,
          },
        ),
        "leased auto-merge disable",
      )
      return true
    },
    publish_commit: fn(request) {
      const publication: GithubWorktreeCommitRequest = {
        owner: repo.owner,
        repo: repo.name,
        branch: request.branch,
        headline: request.headline,
        repo_dir: config.repo_dir ?? ".",
        source: "worktree",
        base_oid: request.base_sha,
        create_branch: true,
        reset_branch: true,
        options: options,
      }
      const receipt = __must(
        __publish_worktree(harness, publication),
        "leased signed worktree publication",
      )
      if !receipt.committed {
        throw "bump-driver: non-empty runtime changes produced no signed commit"
      }
      return {
        oid: receipt.commit_oid,
        url: receipt.commit_url,
        branch_action: receipt.branch_action,
      }
    },
    branch_matches_base: fn() {
      const request: GithubBranchTreeCompareRequest = {
        owner: repo.owner,
        repo: repo.name,
        left_ref: config.branch,
        right_ref: config.base,
        options: options,
      }
      return __must(github_compare_branch_trees(harness, request), "branch tree comparison").equal
    },
    upsert_pr: fn(existing, expected_head_oid) {
      const request: GithubPullRequestUpsertRequest = {
        owner: repo.owner,
        repo: repo.name,
        head: config.branch,
        base: config.base,
        title: "Bump Harn runtime",
        body:
          "Automated Harn runtime bump. Regenerated the lockfile and ran the declared validation entrypoint. Merges through the normal queue.\n\nProduced by the reusable `bump-harn` workflow.",
        expected_head_oid: expected_head_oid,
        previous_head_oid: existing?.head_oid,
        options: options,
      }
      const receipt = __must(
        github_upsert_pull_request(harness, request),
        "leased pull request upsert",
      )
      return {
        number: receipt.number,
        head_oid: receipt.head.sha,
        url: receipt.url,
        created: receipt.action == "created",
      }
    },
    close_pr: fn(number, comment) {
      const receipt = github_close_pr(
        harness,
        {
          owner: repo.owner,
          repo: repo.name,
          pull_number: number,
          comment: comment,
          options: options,
        },
      )
      if !receipt.ok {
        throw "bump-driver: pull request close failed: " + json_stringify(receipt.error)
      }
      return true
    },
    enable_auto_merge: fn(number, expected_head_oid) {
      const receipt = __must(
        pulls_enable_auto_merge(
          harness,
          {
            owner: repo.owner,
            repo: repo.name,
            pull_number: number,
            expected_head_oid: expected_head_oid,
            method: "squash",
            options: options,
          },
        ),
        "leased auto-merge enable",
      )
      return {enabled: true, state: receipt.state, detail: ""}
    },
  }
}
