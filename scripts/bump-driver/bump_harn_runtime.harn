#!/usr/bin/env harn
import { bump_options, run_bump } from "std/bump/runtime"
import { gha_append_summary, gha_write_output } from "std/gha"
import {
  github_bump_auth_options,
  github_bump_live_adapter,
  github_bump_read_private_key,
} from "./authentication"
/** Thin GitHub Actions entry point for the package-backed Harn bump driver. */
import { github_bump_remote } from "./github_remote"
import { gha_bool_output, gha_int_output } from "./wire_outputs"

fn env_or(env: HarnessEnv, name: string, fallback: string) -> string {
  const value = trim(env.get_or(name, ""))
  return if value == "" {
    fallback
  } else {
    value
  }
}

fn env_int(env: HarnessEnv, name: string, fallback: int) -> int {
  return to_int(env_or(env, name, to_string(fallback))) ?? fallback
}

fn package_test_receipt(fs: HarnessFs, env: HarnessEnv) -> string? {
  const path = trim(env.get_or("HARN_BUMP_PACKAGE_TEST_RECEIPT", ""))
  if path == "" {
    return nil
  }
  // `fs.exists` renders a sandbox scope denial as absence, so a receipt the
  // run was forbidden to read would be reported as one nobody wrote. Ask for
  // the status instead and name what was actually observed.
  const status = to_string(fs.status(path, "read")?.status ?? "stat_error")
  if status != "present_file" {
    throw "bump_harn_runtime: package test receipt at ${path} is not a readable file: ${status}"
  }
  const receipt = trim(fs.read_text(path))
  if receipt == "" {
    throw "bump_harn_runtime: package test receipt is empty: " + path
  }
  return receipt
}

pipeline main(harness: Harness) {
  const repo = env_or(harness.env, "GITHUB_REPOSITORY", "")
  if trim(repo) == "" {
    harness.stdio.eprintln("bump_harn_runtime: GITHUB_REPOSITORY is required")
    return 2
  }
  const key_file = harness.env.get_or("GITHUB_APP_PRIVATE_KEY_FILE", "")
  const private_key = if key_file == "" {
    ""
  } else {
    github_bump_read_private_key(
      harness.fs,
      {path: key_file, temporary_root: harness.env.get_or("RUNNER_TEMP", "")},
    )
  }
  const auth_options = github_bump_auth_options(
    {
      app_id: harness.env.get_or("GITHUB_APP_ID", ""),
      installation_id: harness.env.get_or("GITHUB_INSTALLATION_ID", ""),
      private_key_pem: private_key,
      token: harness.env.get_or("HARN_BUMP_TOKEN", ""),
    },
    repo,
  )
  const release_repo = env_or(harness.env, "HARN_BUMP_RELEASE_REPO", "burin-labs/harn")
  const branch = env_or(harness.env, "HARN_BUMP_BRANCH", "automation/bump-harn-runtime")
  const base = env_or(harness.env, "HARN_BUMP_BASE", "main")
  const enable_auto_merge = env_or(harness.env, "HARN_BUMP_ENABLE_AUTOMERGE", "true") != "false"
  const publish_failure_for_repair = env_or(
    harness.env,
    "HARN_BUMP_PUBLISH_FAILURE_FOR_REPAIR",
    "false",
  )
    == "true"
  const remote = github_bump_remote(
    harness,
    {
      repo: repo,
      release_repo: release_repo,
      options: auth_options,
      branch: branch,
      base: base,
      bot_login: env_or(harness.env, "HARN_EXT_BUMP_BOT_LOGIN", "harn-release-bot[bot]"),
      source_revision: env_or(harness.env, "HARN_BUMP_SOURCE_REVISION", ""),
      package_test_receipt: package_test_receipt(harness.fs, harness.env) ?? "",
    },
  )
  const adapter = github_bump_live_adapter(
    harness,
    {
      remote: remote,
      authentication: auth_options,
      config: {
        release_repo: release_repo,
        validation_command: env_or(harness.env, "HARN_BUMP_VALIDATE", ""),
        refresh_command: env_or(
          harness.env,
          "HARN_BUMP_REFRESH",
          "harn install --locked || harn install",
        ),
        // The adapter mints a current scoped token when each refresh begins.
        readiness_max_attempts: env_int(harness.env, "HARN_BUMP_READINESS_ATTEMPTS", 1),
        readiness_interval_ms: env_int(harness.env, "HARN_BUMP_READINESS_INTERVAL_MS", 20000),
        readiness_timeout_ms: env_int(harness.env, "HARN_BUMP_READINESS_TIMEOUT_MS", 20000),
        source_repo_dir: "../.harn-runtime",
      },
    },
  )
  const receipt = run_bump(
    bump_options(
      {
        repo: repo,
        branch: branch,
        base: base,
        tag: env_or(harness.env, "HARN_BUMP_TARGET_TAG", ""),
        source_revision: env_or(harness.env, "HARN_BUMP_SOURCE_REVISION", ""),
        enable_auto_merge: enable_auto_merge,
        publish_failure_for_repair: publish_failure_for_repair,
      },
    ),
    adapter,
  )
  harness.stdio.println(json_stringify_pretty(receipt))
  gha_write_output(harness, "outcome", receipt.outcome)
  gha_write_output(harness, "ok", gha_bool_output(receipt.ok))
  gha_write_output(harness, "target_tag", receipt.target_tag)
  gha_write_output(harness, "target_revision", receipt.target_revision)
  gha_write_output(harness, "ready", gha_bool_output(receipt.ready))
  if receipt.pr_number != nil {
    gha_write_output(harness, "pr_number", gha_int_output(receipt.pr_number))
    gha_write_output(harness, "pr_url", receipt.pr_url ?? "")
  }
  gha_append_summary(
    harness.env,
    harness.fs,
    "### bump-harn: ${receipt.outcome}\n\n"
      + "- target: `${receipt.target_tag}` (was `${receipt.previous_version}`)\n"
      + "- ready: ${receipt.ready}\n"
      + join(receipt.notes.map({ note -> "- ${note}" }), "\n"),
  )
  return if receipt.ok {
    0
  } else {
    1
  }
}
