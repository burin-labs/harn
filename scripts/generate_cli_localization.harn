import {
  Catalog,
  MessagePlan,
  MessageTemplate,
  Registry,
  measured_calls,
  message_plan,
} from "./cli_localization/model"
import { path_visibility } from "./path_visibility"

const CATALOG_ROOT = "crates/harn-cli/src/localization"

const OUTPUT_ROOT = "crates/harn-stdlib/src/stdlib/cli/localization"

const CLI_ROOT = "crates/harn-stdlib/src/stdlib/cli/"

const CATALOG_PATH = "crates/harn-stdlib/src/catalog_entries.rs"

const MARKER = "/** Generated by make gen-cli-localization. Do not edit. */\n"

type Projection = {
  outputs: dict<string, string>,
  messages: int,
  sources: int,
  expected_calls: int,
  measured_calls: int,
}

type ModulePath = string

type Names = list<string>

fn visible_exists(fs: HarnessFs, path: string) -> bool {
  const visibility = path_visibility(fs, "CLI localization", path)
  require visibility.visible, visibility.denial
  return visibility.exists
}

fn directory_names(fs: HarnessFs, path: string) -> Names {
  return schema_expect(fs.list_dir(path), schema_of(Names))
}

fn projection_files(fs: HarnessFs, root: string) -> list<string> {
  let paths: list<string> = []
  for name in directory_names(fs, root) {
    const path = path_join(root, name)
    const info = fs.stat(path, {follow_symlinks: false})
    require !info.is_symlink, "CLI localization output must not contain symlinks"
    if info.is_dir {
      paths.extend(projection_files(fs, path))
    } else if info.is_file {
      paths.push(path)
    }
  }
  return paths
}

fn checked(process: HarnessProcess, binary: string, root: string, args: list<string>) -> string {
  const result = process.run({program: binary, args: args, cwd: root})
  require result.success && result.exit_code == 0,
    "${binary} ${join(args, " ")} failed: ${result.stderr}"
  return result.stdout
}

fn load_registry(fs: HarnessFs, root: string) -> Registry {
  const registry = schema_expect(
    json_parse(fs.read_text(path_join(root, "crates/harn-cli/src/localization_scripts.json"))),
    schema_of(Registry),
  )
  require registry.schema_version == 1 && len(registry.messages) > 0,
    "missing script message registry"
  require regex_match("^HARN_[A-Z_]+$", registry.locale_env) != nil,
    "invalid normalized-locale input contract"
  const names = fs.read_text(path_join(root, "crates/harn-vm/src/environment_registry_names.txt"))
    .split("\n")
    .map({ line -> line.trim() })
  require names.contains(registry.locale_env),
    "normalized locale port is absent from the owning environment registry"
  return registry
}

fn load_catalogs(fs: HarnessFs, root: string) -> dict<string, Catalog> {
  let catalogs: dict<string, Catalog> = {}
  const directory = path_join(root, CATALOG_ROOT)
  for name in directory_names(fs, directory) {
    if name.ends_with(".json") {
      const locale = name.substring(0, len(name) - 5)
      catalogs[locale] = schema_expect(
        json_parse(fs.read_text(path_join(directory, name))),
        schema_of(Catalog),
      )
    }
  }
  require catalogs.keys().contains("en") && len(catalogs) > 1,
    "missing canonical or translated catalogs"
  return catalogs
}

fn namespace(relative: string) -> string {
  require relative.starts_with(CLI_ROOT) && relative.ends_with(".harn") && !relative.contains(".."),
    "invalid script path: ${relative}"
  return relative.substring(len(CLI_ROOT), len(relative) - 5)
}

fn template(catalogs: dict<string, Catalog>, key: string, arity: int) -> MessageTemplate {
  require arity >= 0 && arity <= 100, "invalid argument contract: ${key}"
  const english = catalogs["en"]
  require english != nil, "missing canonical catalog"
  const canonical = english[key]
  require canonical != nil, "missing script translation: ${key}"
  const fallback = message_plan(canonical, arity)
  let translations: dict<string, MessagePlan> = {}
  for (locale, catalog) in catalogs.iter() {
    if locale != "en" {
      const text = catalog[key]
      require text != nil, "missing script translation: ${locale}:${key}"
      const localized = message_plan(text, arity)
      if localized != fallback {
        translations[locale] = localized
      }
    }
  }
  return {arity: arity, fallback: fallback, translations: translations}
}

fn projections(
  harness: {fs: HarnessFs, process: HarnessProcess},
  root: string,
  binary: string,
  check: bool,
) -> Projection {
  const registry = load_registry(harness.fs, root)
  const catalogs = load_catalogs(harness.fs, root)
  const message_keys = registry.messages.keys().sorted()
  let indexes: dict<string, int> = {}
  let outputs: dict<string, string> = {}
  outputs["${OUTPUT_ROOT}.harn"] = """/**
 * Generated by make gen-cli-localization. Do not edit.
 * Read the normalized locale selected by the CLI host.
 * @effects: [env.read]
 * @errors: []
 */
pub fn cli_locale(env: HarnessEnv) -> string {
  return env.get_or(${json_stringify(registry.locale_env)}, "en")
}
"""
  for key in message_keys {
    indexes[key] = len(indexes)
  }
  for part in range(0, (len(message_keys) + 4) / 5) {
    const start = part * 5
    let lines = [MARKER.trim_end(), "import { MessageTemplate } from \"std/cli/message_template\""]
    for index in range(start, min(start + 5, len(message_keys))) {
      const key = message_keys[index]
      require key != nil, "missing canonical message index"
      const arity = registry.messages[key]
      require arity != nil, "missing canonical message arity"
      const plan = template(catalogs, key, arity)
      lines.push("\npub const MESSAGE_${index}: MessageTemplate = ${json_stringify(plan)}")
    }
    outputs["${OUTPUT_ROOT}/messages/part_${part}.harn"] = "${join(lines, "\n")}\n"
  }
  let referenced: dict<string, bool> = {}
  let expected_calls = 0
  let measured = 0
  for (relative, surface) in registry.sources.iter() {
    const name = namespace(relative)
    const keys = surface.calls.keys().sorted()
    require len(keys) > 0, "empty localized surface: ${relative}"
    let imports: dict<string, list<string>> = {}
    let lines = ["import { MessageTemplate, render_message } from \"std/cli/message_template\""]
    for key in keys {
      const index = indexes[key]
      require index != nil, "unregistered message: ${key}"
      require surface.calls[key] > 0, "invalid call count: ${key}"
      referenced[key] = true
      const part = to_string(index / 5)
      imports[part] = (imports[part] ?? []) + ["MESSAGE_${index}"]
      expected_calls += surface.calls[key]
    }
    for part in range(0, (len(message_keys) + 4) / 5) {
      const names = imports[to_string(part)]
      if names != nil {
        lines.push(
          "import { ${join(names, ", ")} } from \"std/cli/localization/messages/part_${part}\"",
        )
      }
    }
    lines.extend(["", "const MESSAGES: dict<string, MessageTemplate> = {"])
    for key in keys {
      lines.push("  ${json_stringify(key)}: MESSAGE_${indexes[key]},")
    }
    lines.extend(
      [
        "}",
        "",
        "/**",
        " * Select a registered CLI template without interpreting argument text.",
        " * @effects: []",
        " * @errors: [\"Unregistered CLI localization message\", \"CLI localization argument count does not match its registered template\"]",
        " */",
        "pub fn cli_message(locale: string, source: string, values: list<string>) -> string {",
        "  const template = MESSAGES[source]",
        "  guard template != nil else {",
        "    throw \"Unregistered CLI localization message\"",
        "  }",
        "  return render_message(template, locale, values)",
        "}",
      ],
    )
    outputs["${OUTPUT_ROOT}/${name}.harn"] = "${MARKER}${join(lines, "\n")}\n"
    if check {
      const parsed = checked(
        harness.process,
        binary,
        root,
        ["parse", path_join(root, relative), "--json"],
      )
      const counts = measured_calls(parsed, relative, name, registry.messages)
      require counts == surface.calls,
        "unreported or missing localized calls in ${relative}: expected ${json_stringify(surface.calls)}, observed ${json_stringify(counts)}"
      for (_, count) in counts.iter() {
        measured += count
      }
    }
  }
  require len(referenced) == len(registry.messages) && expected_calls > 0,
    "incomplete message census"
  require !check || measured == expected_calls, "partial call census: ${measured}/${expected_calls}"
  return {
    outputs: outputs,
    messages: len(referenced),
    sources: len(registry.sources),
    expected_calls: expected_calls,
    measured_calls: measured,
  }
}

fn registered_modules(source: string) -> list<string> {
  const begin = "    // BEGIN GENERATED CLI LOCALIZATION MODULES\n"
  const end = "    // END GENERATED CLI LOCALIZATION MODULES\n"
  require source.contains(begin) == source.contains(end), "partial generated stdlib registration"
  if !source.contains(begin) {
    return []
  }
  const previous = source.substring(source.index_of(begin) + len(begin), source.index_of(end))
  let paths: list<string> = []
  for found in regex_captures(
    "^    \"cli/localization/[^\"\\n]+\" => (\"stdlib/cli/localization/[^\"\\n]+\\.harn\"),$",
    previous,
    "m",
  ) {
    const path = found.groups[0]
    require path != nil, "missing registered localization path"
    const module_path: ModulePath = schema_expect(json_parse(path), schema_of(ModulePath))
    paths.push("crates/harn-stdlib/src/${module_path}")
  }
  return paths
}

fn catalog_projection(source: string, outputs: dict<string, string>) -> string {
  const begin = "    // BEGIN GENERATED CLI LOCALIZATION MODULES\n"
  const end = "    // END GENERATED CLI LOCALIZATION MODULES\n"
  const anchor = "    \"cli/render\" => \"stdlib/cli/render.harn\",\n"
  require source.contains(anchor), "missing owning stdlib catalog anchor"
  let lines: list<string> = []
  for relative in outputs.keys().sorted() {
    const module_path = relative.substring(len("crates/harn-stdlib/src/"))
    const module_name = module_path.substring(len("stdlib/"), len(module_path) - 5)
    lines.push("    ${json_stringify(module_name)} => ${json_stringify(module_path)},\n")
  }
  const block = "${begin}${join(lines, "")}${end}"
  if source.contains(begin) {
    return "${source.substring(0, source.index_of(begin))}${block}${source.substring(source.index_of(end) + len(end))}"
  }
  return source.replace(anchor, "${anchor}${block}")
}

fn check_output_paths(fs: HarnessFs, root: string, outputs: dict<string, string>) -> nil {
  let path = root
  for segment in OUTPUT_ROOT.split("/") {
    path = path_join(path, segment)
    if visible_exists(fs, path) {
      require !fs.stat(path, {follow_symlinks: false}).is_symlink,
        "CLI localization output must not traverse symlinks: ${path}"
    }
  }
  for relative in outputs.keys().sorted() {
    const target = path_join(root, relative)
    if visible_exists(fs, target) {
      require !fs.stat(target, {follow_symlinks: false}).is_symlink,
        "CLI localization output must not be a symlink: ${relative}"
    }
  }
}

fn publish(
  harness: {fs: HarnessFs, process: HarnessProcess},
  root: string,
  binary: string,
  outputs: dict<string, string>,
  previous: list<string>,
  check: bool,
) -> nil {
  check_output_paths(harness.fs, root, outputs)
  const temporary = harness.fs.mkdtemp_in_workspace("harn-cli-localization-")
  try {
    for (relative, contents) in outputs.iter() {
      const target = path_join(temporary, relative)
      harness.fs.mkdir(dirname(target), true)
      harness.fs.write_text(target, contents)
    }
    checked(harness.process, binary, root, ["fmt", temporary, "--json"])
    let mismatches: list<string> = []
    const projection_root = path_join(root, OUTPUT_ROOT)
    if visible_exists(harness.fs, projection_root) {
      for path in projection_files(harness.fs, projection_root) {
        const relative = "${OUTPUT_ROOT}/${path.substring(len(projection_root) + 1)}"
        if !outputs.keys().contains(relative) {
          if check {
            mismatches.push(relative)
          } else {
            require previous.contains(relative), "unregistered CLI localization output: ${relative}"
            const contents = harness.fs.read_text(path)
            require contents.starts_with(MARKER)
              || regex_match(
                "^/\\*\\*\\s*\\*?\\s*Generated by scripts/generate_cli_localization\\.mjs\\.",
                contents,
              )
                != nil,
              "previous CLI localization projection has unknown contents"
            harness.fs.delete(path)
          }
        }
      }
    }
    for relative in outputs.keys().sorted() {
      const formatted = harness.fs.read_text(path_join(temporary, relative))
      const target = path_join(root, relative)
      if check {
        if !visible_exists(harness.fs, target) || harness.fs.read_text(target) != formatted {
          mismatches.push(relative)
        }
      } else {
        harness.fs.mkdir(dirname(target), true)
        harness.fs.write_text(target, formatted)
      }
    }
    require len(mismatches) == 0,
      "stale CLI localization projections (${len(mismatches)}):\n${join(mismatches, "\n")}"
  } finally {
    harness.fs.delete(temporary)
  }
}

fn main(harness: Harness) {
  let check = false
  let binary = harness.env.get_or("HARN_BIN", "harn")
  let index = 0
  while index < len(argv) {
    if argv[index] == "--check" {
      check = true
    } else if argv[index] == "--harn-bin" && index + 1 < len(argv) {
      index += 1
      binary = argv[index]
    } else {
      throw "usage: generate_cli_localization.harn [--check] [--harn-bin PATH]"
    }
    index += 1
  }
  const root = dirname(harness.fs.source_dir())
  const projection = projections(pick(harness, ["fs", "process"]), root, binary, check)
  const source = harness.fs.read_text(path_join(root, CATALOG_PATH))
  const previous = registered_modules(source)
  let outputs = projection.outputs
  outputs[CATALOG_PATH] = catalog_projection(source, outputs)
  publish(pick(harness, ["fs", "process"]), root, binary, outputs, previous, check)
  harness.stdio.println(
    json_stringify(
      {
        messages: projection.messages,
        sources: projection.sources,
        expectedCalls: projection.expected_calls,
        measuredCalls: if check {
          projection.measured_calls
        } else {
          nil
        },
        generated: len(outputs),
        pending: 0,
        failed: [],
      },
    ),
  )
}
