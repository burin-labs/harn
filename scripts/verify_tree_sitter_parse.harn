import { find_files } from "std/fs"
import { path_visibility, visibility_failure } from "./path_visibility.harn"

/** This gate's own name, quoted back into any denial it reports. */
const CHECK_NAME = "verify-tree-sitter-parse"

const GENERATED_PARSER_SOURCES = ["grammar.js", "grammar/keywords.js"]

const SCAN_ROOTS = ["conformance/tests", "examples", "tests/bridge"]

pub fn usage_text() -> string {
  return """
Usage: harn run scripts/verify_tree_sitter_parse.harn -- [--strict]

Verify that the tree-sitter grammar parses the positive Harn source sweep.

Options:
  --strict   Fail on any tree-sitter parse divergence
  -h, --help Show this help
"""
    .trim()
}

pub fn parse_cli_args(args: list<string>) {
  let strict = false
  let help = false
  for arg in args {
    if arg == "--strict" {
      strict = true
      continue
    }
    if arg == "-h" || arg == "--help" {
      help = true
      continue
    }
    return {ok: false, strict: false, help: false, error: "error: unknown argument: ${arg}"}
  }
  return {ok: true, strict: strict, help: help, error: ""}
}

fn repo_root(fs: HarnessFs) -> string {
  return path_normalize(path_join(fs.source_dir(), ".."))
}

fn grammar_dir(root: string) -> string {
  return path_join(root, "tree-sitter-harn")
}

pub fn native_lib_filename(system_name: string) -> string {
  if system_name == "Darwin" {
    return "harn.dylib"
  }
  return "harn.so"
}

fn host_system_name(process: HarnessProcess) -> string {
  const res = process.run({program: "uname", args: ["-s"]})
  if res.success {
    return res.stdout.trim()
  }
  return ""
}

fn native_lib_path(process: HarnessProcess, scratch_dir: string) -> string {
  return path_join(scratch_dir, native_lib_filename(host_system_name(process)))
}

fn max_mtime(fs: HarnessFs, paths: list<string>) -> float {
  let out = 0.0
  for path in paths {
    if !fs.exists(path) {
      continue
    }
    const modified = to_float(fs.stat(path).modified) ?? 0.0
    if modified > out {
      out = modified
    }
  }
  return out
}

pub fn target_is_stale(target_exists: bool, target_mtime: float, source_mtime: float) -> bool {
  if !target_exists {
    return true
  }
  return target_mtime < source_mtime
}

fn paths_under(base: string, rels: list<string>) -> list<string> {
  let out: list<string> = []
  for rel in rels {
    out = out + [path_join(base, rel)]
  }
  return out
}

fn emit_failure(stdio: HarnessStdio, label: string, result: dict) -> nil {
  stdio.eprintln(label)
  if result.stdout != "" {
    stdio.eprint(result.stdout)
  }
  if result.stderr != "" {
    stdio.eprint(result.stderr)
  }
  return nil
}

fn ensure_compiled_library(harness: Harness, root: string, scratch_dir: string) {
  const dir = grammar_dir(root)
  const cli = path_join(dir, "scripts/tree-sitter-cli.sh")
  const native = native_lib_path(harness.process, scratch_dir)
  if !harness.fs.exists(cli) {
    harness.stdio.eprintln("error: missing tree-sitter CLI wrapper at ${cli}")
    return {ok: false, code: 1, lib_path: native}
  }
  const parser_c = path_join(dir, "src/parser.c")
  const parser_source_mtime = max_mtime(harness.fs, paths_under(dir, GENERATED_PARSER_SOURCES))
  const parser_c_mtime = if harness.fs.exists(parser_c) {
    to_float(harness.fs.stat(parser_c).modified) ?? 0.0
  } else {
    0.0
  }
  if target_is_stale(harness.fs.exists(parser_c), parser_c_mtime, parser_source_mtime) {
    const generate = harness.process.run({program: cli, args: ["generate"], cwd: dir})
    if !generate.success {
      emit_failure(harness.stdio, "error: failed to regenerate tree-sitter parser", generate)
      return {ok: false, code: generate.exit_code, lib_path: native}
    }
  }
  const build = harness.process.run({program: cli, args: ["build", "--output", native], cwd: dir})
  if !build.success {
    emit_failure(harness.stdio, "error: failed to rebuild tree-sitter shared library", build)
    return {ok: false, code: build.exit_code, lib_path: native}
  }
  return {ok: true, code: 0, lib_path: native}
}

pub fn with_error_suffix(path: string) -> string {
  if path.ends_with(".harn") {
    return path.substring(0, path.len() - 5) + ".error"
  }
  return path + ".error"
}

pub fn positive_harn_files(fs: HarnessFs, root: string) -> list<string> {
  let paths: list<string> = []
  for rel_root in SCAN_ROOTS {
    const scan_root = path_join(root, rel_root)
    // Dropping a scan root shrinks the sweep silently. The empty-paths guard
    // downstream only fires when every root drops, so a single denied root
    // still reads as a full sweep.
    const seen = path_visibility(fs, CHECK_NAME, scan_root)
    if seen.denial != "" {
      throw seen.denial
    }
    if !seen.exists {
      continue
    }
    for candidate in find_files(fs, scan_root, "**/*.harn") {
      if !fs.stat(candidate).is_file {
        continue
      }
      if fs.exists(with_error_suffix(candidate)) {
        continue
      }
      paths = paths + [path_normalize(candidate)]
    }
  }
  return paths.sorted()
}

fn emit_parse_failure(stdio: HarnessStdio, strict: bool, result: dict) -> int {
  const label = if strict {
    "tree-sitter parse sweep failed"
  } else {
    "warning: tree-sitter parse sweep found grammar drift"
  }
  if strict {
    stdio.eprintln(label)
    if result.stdout != "" {
      stdio.eprint(result.stdout)
    }
    if result.stderr != "" {
      stdio.eprint(result.stderr)
    }
    return result.exit_code
  }
  stdio.println(label)
  if result.stdout != "" {
    stdio.print(result.stdout)
  }
  if result.stderr != "" {
    stdio.print(result.stderr)
  }
  return 0
}

pub fn verify_tree_sitter_parse(harness: Harness, root: string, strict: bool) -> int {
  const dir = grammar_dir(root)
  const grammar = path_visibility(harness.fs, CHECK_NAME, dir)
  if grammar.denial != "" {
    // Skipping the whole sweep and returning 0 is the strongest form of this
    // defect: a denial there proves nothing and reports success.
    harness.stdio.eprintln(visibility_failure(CHECK_NAME, [grammar.denial]))
    return 1
  }
  if !grammar.exists {
    harness.stdio.println("warning: tree-sitter-harn not present; skipping parse sweep")
    return 0
  }
  const scratch_dir = harness.fs.mkdtemp_in_workspace("harn-tree-sitter-parse-")
  const paths_file = path_join(scratch_dir, "paths.txt")
  defer {
    harness.fs.delete(scratch_dir)
  }
  const compiled = ensure_compiled_library(harness, root, scratch_dir)
  if !compiled.ok {
    return compiled.code
  }
  const lib_path = compiled.lib_path
  if !harness.fs.exists(lib_path) {
    harness.stdio.eprintln("error: missing compiled tree-sitter library at ${lib_path}")
    return 1
  }
  const paths = positive_harn_files(harness.fs, root)
  if paths.count == 0 {
    harness.stdio.eprintln("error: no positive .harn files found for tree-sitter parse sweep")
    return 1
  }
  harness.fs.write_text(paths_file, paths.join("\n") + "\n")
  const result = harness.process.run(
    {
      program: path_join(dir, "scripts/tree-sitter-cli.sh"),
      args: [
        "parse",
        "--quiet",
        "--lib-path",
        lib_path,
        "--lang-name",
        "harn",
        "--paths",
        paths_file,
      ],
      cwd: dir,
    },
  )
  if !result.success {
    return emit_parse_failure(harness.stdio, strict, result)
  }
  harness.stdio.println(
    "verified tree-sitter parse coverage across ${paths.count} positive .harn files",
  )
  return 0
}

fn main(harness: Harness) -> int {
  const parsed = parse_cli_args(argv)
  if parsed.help {
    harness.stdio.println(usage_text())
    return 0
  }
  if !parsed.ok {
    harness.stdio.eprintln(parsed.error)
    harness.stdio.eprintln(usage_text())
    return 2
  }
  return verify_tree_sitter_parse(harness, repo_root(harness.fs), parsed.strict)
}
