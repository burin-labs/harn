import { DiagnosticFile, collect_stdlib_diagnostics } from "./lib/stdlib_diagnostics.harn"
import { baseline_delta, baseline_lines } from "./lib/text_baseline.harn"

const BASELINE = "scripts/stdlib-public-return-type-baseline.txt"

pub fn public_return_keys(files: list<DiagnosticFile>) -> list<string> {
  let keys: list<string> = []
  for file in files {
    if file.status == "error" {
      throw "public return-type ratchet refused checker error: ${file.path}"
    }
    for diagnostic in file.diagnostics {
      if diagnostic.code != "HARN-STD-102" {
        continue
      }
      const names = regex_captures(r"`([^`]+)`", diagnostic.message)
      if names.count == 0 {
        throw "public-return diagnostic has no function name: ${file.path}"
      }
      const key = file.path + "::" + names[0].groups[0]
      if !keys.contains(key) {
        keys = keys + [key]
      }
    }
  }
  return keys.sorted()
}

pub fn render_return_baseline(keys: list<string>) -> string {
  let paths: list<string> = []
  for key in keys {
    const path = key.split("::")[0]
    if !paths.contains(path) {
      paths = paths + [path]
    }
  }
  let text =
    "# Public stdlib functions without explicit return annotations.\n# Generated by scripts/check_stdlib_public_return_types.sh --update-baseline.\n# Source of truth: Harn AST diagnostics (HARN-STD-102) from harn lint --json.\n# Entries are repo-relative path::public_function_name; comments below give per-module counts.\n# Split-module note: selected internal helpers are public because Harn currently\n# crosses module boundaries through public exports; keep their contracts in this\n# ratchet until private cross-module imports or explicit return types are available.\n#\n"
  for path in paths.sorted() {
    let count = 0
    for key in keys {
      if key.starts_with(path + "::") {
        count = count + 1
      }
    }
    text = text + "# count " + to_string(count).pad_left(4, " ") + "  " + path + "\n"
  }
  return text + "\n" + keys.join("\n") + if keys.count > 0 {
    "\n"
  } else {
    ""
  }
}

fn main(harness: Harness) {
  if argv != [] && argv != ["--update-baseline"] {
    throw "usage: check_stdlib_public_return_types [--update-baseline]"
  }
  const files = collect_stdlib_diagnostics(
    pick(harness, ["fs", "process"]),
    harness.env.get("HARN_BIN") ?? "harn",
    "lint",
  )
  const actual = public_return_keys(files)
  if argv == ["--update-baseline"] {
    harness.fs.write_text(BASELINE, render_return_baseline(actual))
    harness.stdio.println("updated ${BASELINE} with ${actual.count} baseline entries")
    return
  }
  const expected = baseline_lines(harness.fs.read_text(BASELINE))
  const delta = baseline_delta(expected, actual)
  if delta.added.count + delta.removed.count > 0 {
    for key in delta.added {
      harness.stdio.eprintln("new unannotated export: " + key)
    }
    for key in delta.removed {
      harness.stdio.eprintln("resolved baseline entry: " + key)
    }
    throw "stdlib public return-type baseline changed; add honest annotations or review --update-baseline"
  }
  harness.stdio.println(
    "stdlib public return-type ratchet passed: ${actual.count} entries, ${files.count} files scanned.",
  )
}
