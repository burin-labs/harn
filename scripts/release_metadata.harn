import { help_requested, parse, parser } from "std/cli/argparse"
import "std/schema"
import * as semver from "std/semver"
import { BumpKind } from "std/semver"
import { load_release_withdrawals, release_distribution_version } from "./release_withdrawals.harn"

const RELEASE_WITHDRAWALS_PATH = ".github/release-withdrawals.json"

pub type ReleaseMetadataPlan = {
  current_version: string,
  next_version: string,
  manifests: list<string>,
  package_names: list<string>,
}

const DEVELOPMENT_PRERELEASE = "dev"

type PackageManifestProjection = {package: {name: string}}

type AgentArchiveProjection = {archive: string}

type AgentManifestProjection = {
  version: string,
  distribution: {binary: dict<string, AgentArchiveProjection>},
}

fn package_manifest_projection_schema() -> Schema<PackageManifestProjection> {
  return schema_refine(
    schema_of(PackageManifestProjection),
    schema_object(
      {
        package: schema_field(
          schema_object({name: schema_field(schema_string())}, {additional_properties: true}),
        ),
      },
      {additional_properties: true},
    ),
  )
}

fn agent_manifest_projection_schema() -> Schema<AgentManifestProjection> {
  const archive = schema_object(
    {archive: schema_field(schema_string())},
    {additional_properties: true},
  )
  return schema_refine(
    schema_of(AgentManifestProjection),
    schema_object(
      {
        version: schema_field(schema_string()),
        distribution: schema_field(
          schema_object(
            {binary: schema_field(schema_dict(archive))},
            {additional_properties: true},
          ),
        ),
      },
      {additional_properties: true},
    ),
  )
}

fn default_root(fs: HarnessFs) -> string {
  return path_normalize(path_join(fs.source_dir(), ".."))
}

fn cargo_path(root: string) -> string {
  return path_join(root, "Cargo.toml")
}

fn normalized_rel(path: string, root: string) -> string {
  const normalized = replace(path_normalize(path), "\\", "/")
  const normalized_root = replace(path_normalize(root), "\\", "/")
  const prefix = normalized_root + "/"
  if normalized.starts_with(prefix) {
    return normalized[len(prefix):]
  }
  return normalized
}

fn distribution_version(fs: HarnessFs, root: string, version: string) -> string {
  const path = path_join(root, RELEASE_WITHDRAWALS_PATH)
  return release_distribution_version(load_release_withdrawals(fs, path), version)
}

pub fn workspace_version_from_doc(doc: dict) -> string {
  const value = doc?.workspace?.package?.version ?? doc?.workspace?.version
  if type_of(value) != "string" || to_string(value) == "" {
    throw "missing workspace version"
  }
  const version = to_string(value)
  if semver.parse_release(version) == nil {
    throw "workspace version is not release SemVer: " + version
  }
  return version
}

pub fn current_version(fs: HarnessFs, root: string) -> string {
  const path = cargo_path(root)
  if !fs.exists(path) {
    throw "missing workspace manifest: " + path
  }
  return workspace_version_from_doc(toml_parse(fs.read_text(path)))
}

/** Project a stable release into the next patch's development identity. */
pub fn development_version_from_stable(version: string) -> string {
  const parsed = semver.parse(version)
  if parsed == nil {
    throw "development version requires stable release SemVer: " + version
  }
  return to_string(parsed.major)
    + "."
    + to_string(parsed.minor)
    + "."
    + to_string(parsed.patch + 1)
    + "-"
    + DEVELOPMENT_PRERELEASE
}

/** Strip the one prerelease identity admitted at the stable-release boundary. */
pub fn stable_version_from_development(version: string) -> string {
  const parsed = semver.parse_release(version)
  if parsed == nil || parsed.prerelease != DEVELOPMENT_PRERELEASE {
    throw "release requires an exact X.Y.Z-dev workspace version: " + version
  }
  return to_string(parsed.major)
    + "."
    + to_string(parsed.minor)
    + "."
    + to_string(parsed.patch)
}

fn workspace_entries(doc: dict, key: string) -> list<string> {
  const raw = doc?.workspace?.get(key)
  if raw == nil && key == "exclude" {
    return []
  }
  if type_of(raw) != "list" {
    throw "workspace." + key + " must be a list"
  }
  let entries: list<string> = []
  for value in raw {
    if type_of(value) != "string" || to_string(value) == "" {
      throw "workspace." + key + " contains a non-string or empty entry"
    }
    entries = entries + [to_string(value)]
  }
  return entries
}

fn manifests_for_entry(fs: HarnessFs, root: string, entry: string, owner: string) -> list<string> {
  const manifest_pattern = if entry.ends_with("Cargo.toml") {
    entry
  } else {
    entry + "/Cargo.toml"
  }
  const matches = fs.glob(manifest_pattern, {base: root}).sort()
  if matches.count == 0 {
    throw owner + " entry matched no package manifest: " + entry
  }
  return matches
}

pub fn workspace_package_manifests(fs: HarnessFs, root: string) -> list<string> {
  const doc = toml_parse(fs.read_text(cargo_path(root)))
  let manifests: list<string> = []
  for key in ["members", "exclude"] {
    for entry in workspace_entries(doc, key) {
      manifests = manifests + manifests_for_entry(fs, root, entry, "workspace." + key)
    }
  }
  return manifests.unique().sort()
}

pub fn package_names_for_manifests(fs: HarnessFs, manifests: list<string>) -> list<string> {
  let names: list<string> = []
  for manifest in manifests {
    const doc: PackageManifestProjection = schema_expect(
      toml_parse(fs.read_text(manifest)),
      package_manifest_projection_schema(),
    )
    const raw = doc.package.name
    if raw == "" {
      throw "missing package.name in " + manifest
    }
    const name = raw
    if names.contains(name) {
      throw "duplicate workspace package name: " + name
    }
    names = names + [name]
  }
  return names.sort()
}

fn dependency_name(line: string) -> string? {
  const matches = regex_captures(r"^\s*([A-Za-z0-9_-]+)\s*=\s*\{", line)
  if matches.count == 0 {
    return nil
  }
  return matches[0].groups[0]
}

pub fn rewrite_local_dependency_versions(
  text: string,
  package_names: list<string>,
  version: string,
) -> string {
  let lines: list<string> = []
  for line in text.split("\n") {
    const name = dependency_name(line)
    if name == nil || !package_names.contains(name) || !line.contains("path") {
      lines = lines + [line]
      continue
    }
    const versions = regex_captures(r#"version\s*=\s*"[^"]+""#, line)
    if versions.count == 0 {
      lines = lines + [line]
      continue
    }
    if versions.count > 1 {
      throw "local path dependency " + name + " contains multiple version fields"
    }
    lines = lines
      + [regex_replace(r#"(version\s*=\s*")[^"]+(")"#, "$1=" + version + "$2", line)]
  }
  return join(lines, "\n")
}

fn replace_workspace_version(text: string, current: string, next: string) -> string {
  const pattern = "(?m)^version\\s*=\\s*\"" + replace(current, ".", "\\.") + "\"\\s*$"
  if regex_captures(pattern, text).count != 1 {
    throw "workspace version literal must occur exactly once"
  }
  return regex_replace(pattern, "version = \"" + next + "\"", text)
}

fn rewrite_agent_manifest(
  fs: HarnessFs,
  root: string,
  expected_current: string?,
  next: string,
) -> nil {
  const path = path_join(root, "spec/acp-registry/harn/agent.json")
  if !fs.exists(path) {
    return nil
  }
  const original = fs.read_text(path)
  const doc: AgentManifestProjection = schema_expect(
    json_parse(original),
    agent_manifest_projection_schema(),
  )
  if expected_current != nil && doc.version != expected_current {
    throw "agent manifest version does not match workspace version"
  }
  const current = doc.version
  if semver.parse(current) == nil {
    throw "agent manifest distribution version must be stable SemVer"
  }
  const binary = doc.distribution.binary
  if binary.entries().count == 0 {
    throw "agent manifest is missing distribution.binary entries"
  }
  for {key, value} in binary.entries() {
    const archive_key = to_string(key ?? "")
    const archive = to_string(value?.archive ?? "")
    if archive == "" || !archive.contains("/v" + current + "/") {
      throw "agent manifest archive for " + archive_key + " does not target v" + current
    }
  }
  if regex_captures("\"version\": \"" + replace(current, ".", "\\.") + "\"", original).count
    != 1 {
    throw "agent manifest version literal must occur exactly once"
  }
  let updated = replace(
    original,
    "\"version\": \"" + current + "\"",
    "\"version\": \"" + next + "\"",
  )
  updated = replace(updated, "/v" + current + "/", "/v" + next + "/")
  const check: AgentManifestProjection = schema_expect(
    json_parse(updated),
    agent_manifest_projection_schema(),
  )
  if check.version != next {
    throw "failed to update agent manifest version"
  }
  for {key, value} in check.distribution.binary.entries() {
    const archive_key = to_string(key ?? "")
    if !to_string(value.archive).contains("/v" + next + "/") {
      throw "failed to update agent manifest archive for " + archive_key
    }
  }
  fs.write_text(path, updated)
  return nil
}

fn rewrite_embedding_tags(fs: HarnessFs, root: string, next: string) -> nil {
  const path = path_join(root, "docs/src/embedding-rust.md")
  if !fs.exists(path) {
    return nil
  }
  const text = fs.read_text(path)
  const updated = regex_replace(
    r#"tag = "v\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?""#,
    "tag = \"v" + next + "\"",
    text,
  )
  if updated != text {
    fs.write_text(path, updated)
  }
  return nil
}

pub fn release_metadata_plan(
  fs: HarnessFs,
  root: string,
  bump: BumpKind,
  prerelease_identifier: string = "",
) -> ReleaseMetadataPlan {
  const current = current_version(fs, root)
  const manifests = workspace_package_manifests(fs, root)
  const names = package_names_for_manifests(fs, manifests)
  const next = if current.ends_with("-" + DEVELOPMENT_PRERELEASE) {
    if bump != "patch" || prerelease_identifier != "" {
      throw "development release can only strip -dev with a patch bump"
    }
    stable_version_from_development(current)
  } else {
    semver.next(current, bump, prerelease_identifier)
  }
  return {
    current_version: current,
    next_version: next,
    manifests: manifests.map({ path -> normalized_rel(path, root) }).to_list(),
    package_names: names,
  }
}

/** Advance a just-released stable workspace to its next patch development identity. */
pub fn apply_development_metadata(fs: HarnessFs, root: string) -> ReleaseMetadataPlan {
  const current = current_version(fs, root)
  const next = development_version_from_stable(current)
  const manifests = workspace_package_manifests(fs, root)
  const names = package_names_for_manifests(fs, manifests)
  const plan: ReleaseMetadataPlan = {
    current_version: current,
    next_version: next,
    manifests: manifests.map({ path -> normalized_rel(path, root) }).to_list(),
    package_names: names,
  }
  const root_manifest = cargo_path(root)
  const all_manifests = [root_manifest] + manifests
  for manifest in all_manifests.unique() {
    let text = fs.read_text(manifest)
    if path_normalize(manifest) == path_normalize(root_manifest) {
      text = replace_workspace_version(text, current, next)
    }
    text = rewrite_local_dependency_versions(text, names, next)
    fs.write_text(manifest, text)
  }
  return plan
}

pub fn apply_release_metadata(
  fs: HarnessFs,
  root: string,
  version: string,
  bump: BumpKind? = nil,
  prerelease_identifier: string = "",
) -> ReleaseMetadataPlan {
  const current = current_version(fs, root)
  const plan = release_metadata_plan(fs, root, bump ?? "patch", prerelease_identifier)
    + {next_version: version}
  if semver.parse_release(version) == nil {
    throw "release version is not release SemVer: " + version
  }
  const matches_requested_bump = if bump == nil {
    ["major", "minor", "patch"].any({ stable -> semver.next(current, stable) == version })
  } else {
    semver.next(current, bump, prerelease_identifier) == version
  }
  if !matches_requested_bump {
    const requested = bump ?? "single stable"
    throw "release version does not match the requested ${requested} bump from " + current
  }
  const root_manifest = cargo_path(root)
  const all_manifests = [root_manifest]
    + plan.manifests.map({ path -> path_join(root, path) }).to_list()
  for manifest in all_manifests.unique() {
    let text = fs.read_text(manifest)
    if path_normalize(manifest) == path_normalize(root_manifest) {
      text = replace_workspace_version(text, current, version)
    }
    text = rewrite_local_dependency_versions(text, plan.package_names, version)
    fs.write_text(manifest, text)
  }
  const current_distribution = if current.ends_with("-" + DEVELOPMENT_PRERELEASE) {
    nil
  } else {
    distribution_version(fs, root, current)
  }
  const next_distribution = distribution_version(fs, root, version)
  rewrite_agent_manifest(fs, root, current_distribution, next_distribution)
  rewrite_embedding_tags(fs, root, next_distribution)
  return plan
}

pub fn verify_changelog_top(text: string, expected: string) -> nil {
  const headings = regex_captures(r"(?m)^## ([^\r\n]+)\r?$", text)
  if headings.count == 0 {
    throw "CHANGELOG.md has no '## vX.Y.Z' heading"
  }
  const top = headings[0].groups[0].trim()
  if top == "v" + expected {
    return nil
  }
  if semver.is_v_release_semver(top) {
    throw "CHANGELOG.md top heading is "
      + top
      + " but --bump implies v"
      + expected
      + "\nhint: edit CHANGELOG.md to add '## v"
      + expected
      + "' as the new top entry, then re-run"
  }
  throw "CHANGELOG.md top heading '"
    + top
    + "' is not '## v"
    + expected
    + "'\nhint: edit CHANGELOG.md to add '## v"
    + expected
    + "' as the new top entry, then re-run"
}

fn arg_spec() {
  return parser(
    {
      name: "release_metadata",
      args: [
        {kind: "positional", name: "action", required: true},
        {kind: "flag", name: "root", long: "--root", parse: "string", default: ""},
        {kind: "flag", name: "bump", long: "--bump", parse: "string", default: ""},
        {kind: "flag", name: "preid", long: "--preid", parse: "string", default: ""},
        {kind: "flag", name: "version", long: "--version", parse: "string", default: ""},
      ],
    },
  )
}

fn main(harness: Harness) -> int {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/release_metadata.harn -- ACTION [--root PATH] [--bump KIND] [--preid ID] [--version VERSION]",
    )
    return 0
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    return 2
  }
  const parsed = unwrap(parsed_result)
  const action = to_string(parsed.options?.action ?? "")
  const root_value = to_string(parsed.options?.root ?? "")
  const root = path_normalize(root_value == "" ? default_root(harness.fs) : root_value)
  try {
    if action == "current" {
      harness.stdio.println(current_version(harness.fs, root))
    } else if action == "development-target" {
      harness.stdio.println(development_version_from_stable(current_version(harness.fs, root)))
    } else if action == "release-target" {
      harness.stdio.println(stable_version_from_development(current_version(harness.fs, root)))
    } else if action == "next" {
      const bump = to_string(parsed.options?.bump ?? "")
      const preid = to_string(parsed.options?.preid ?? "")
      if !["major", "minor", "patch", "premajor", "preminor", "prepatch", "prerelease"].contains(
        bump,
      ) {
        throw "--bump must be major, minor, patch, premajor, preminor, prepatch, or prerelease"
      }
      harness.stdio.println(semver.next(current_version(harness.fs, root), bump, preid))
    } else if action == "manifests" {
      for path in workspace_package_manifests(harness.fs, root) {
        harness.stdio.println(normalized_rel(path, root))
      }
    } else if action == "apply" {
      const version = to_string(parsed.options?.version ?? "")
      const bump = to_string(parsed.options?.bump ?? "")
      const preid = to_string(parsed.options?.preid ?? "")
      if bump != ""
        && !["major", "minor", "patch", "premajor", "preminor", "prepatch", "prerelease"].contains(
          bump,
        ) {
        throw "--bump must name a supported release bump"
      }
      if bump == "" {
        apply_release_metadata(harness.fs, root, version)
      } else {
        apply_release_metadata(harness.fs, root, version, bump, preid)
      }
    } else if action == "develop" {
      apply_development_metadata(harness.fs, root)
    } else if action == "verify-changelog" {
      const version = to_string(parsed.options?.version ?? "")
      verify_changelog_top(harness.fs.read_text(path_join(root, "CHANGELOG.md")), version)
    } else {
      throw "unknown action: " + action
    }
    return 0
  } catch (e) {
    harness.stdio.eprintln("error: " + to_string(e))
    return 1
  }
}
