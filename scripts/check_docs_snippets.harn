// Verify every fenced code block in active documentation that claims to be Harn
// source or a Harn prompt template is valid, by handing it to the real
// binary rather than approximating either grammar here.
//
// ```harn        parses via `harn parse`. Most docs snippets are intentionally
//                partial fragments: the guard keeps them syntactically valid
//                without requiring each fragment to declare every surrounding
//                variable from the prose.
// ```harn,check  opts into full `harn check` for complete copy/paste examples.
// ```harn,diagnostic-check expects one `harn check --json` diagnostic and
//                projects its real span, severity, code, message, help, and
//                registry-owned repair into docs/diagnostic-examples.json.
// ```harn,diagnostic-lint does the same through `harn lint --json`.
// ```harn-prompt lints via `harn lint` on a `.harn.prompt` file, which runs the
//                prompt-template engine's own parser. Catches the traps a
//                reader cannot see, notably that `{{ endif }}` is not a closing
//                tag — it parses as a variable lookup and leaves the `{{ if }}`
//                unclosed. Both `if` and `for` close with `{{ end }}`.
//
// A docs example only has to be *valid*, so this gate runs `harn lint` without
// `--strict`: a template that does not parse is an error and fails, while the
// style rules (vendor-identity branching, branch explosion) stay advisory. Doc
// prose often illustrates exactly the shape a style rule discourages.
//
// Every ```harn / ```harn,check block is additionally scanned for a call whose
// first two positional arguments are the same bare identifier. Harn accepts
// extra positional arguments, so `agent_loop(harness, harness, message, ...)`
// parses and type-checks and then dies at run time deep inside the stdlib. A
// reader pasting a docs snippet has no way to see that coming, so the gate
// rejects the shape outright.
//
// Blocks tagged ```harn,ignore or ```harn-prompt,ignore are skipped — use those
// for intentionally non-syntactic fragments (grammar demos in
// language-spec.md, etc.).
//
// A fence may be indented — blocks nested under a list item are checked
// like any other, with the opening fence's indent stripped from the body.
// The info string itself is still matched exactly: a trailing word or space
// does not open a checked block. A fence may also use more than three
// backticks, which is how a block whose body contains ``` is written; the
// closing fence must then be at least as long as the opening one.
//
// Ported from scripts/check_docs_snippets.sh — same unclosed-fence
// detection, same FAIL output shape, same summary line and exit codes.
//
// Usage:
//   harn run scripts/check_docs_snippets.harn
const DOCS_GLOBS = [
  "docs/src/**/*.md",
  "docs/llm/*.md",
  "README.md",
  "CONTRIBUTING.md",
  "website/*.md",
]

const DIAGNOSTIC_EXAMPLES_PATH = "docs/diagnostic-examples.json"

// The reading budget for published Harn code, in columns. Measured on the
// rendered page rather than derived from taste — and specifically not from
// the prose measure: `website/src/index.css` deliberately leaves code,
// tables, and diagrams uncapped by `--prose-measure`, so a code block is
// sized by the article column instead. `website/src/pages/DocPage.tsx`
// renders the article at `lg:max-w-3xl lg:px-10`: 768px - 80px of article
// padding - 32px of `pre` padding - 2px of border = 654px of code text. Docs
// code sets JetBrains Mono at 13.6px, whose character advance is 8.734px, so
// 654 / 8.734 = 74 columns fit. That is the best case, not a typical one: the
// article is width-capped, so it never gets wider, and a narrower window
// still scrolls. A line past 74 columns scrolls even on a wide desktop.
pub const MAX_SNIPPET_COLUMNS: int = 74

/** Count of leading space/tab characters in `line`. */
pub fn leading_ws_len(line: string) -> int {
  let i = 0
  const n = line.len()
  while i < n {
    const c = line.char_at(i)
    if c != " " && c != "\t" {
      break
    }
    i = i + 1
  }
  return i
}

/**
 * Drop up to `n` leading space/tab characters from `line`, so a block
 * nested under a list item is reproduced at column 0. Lines indented
 * less than the opening fence (blank lines, most commonly) lose only the
 * whitespace they have.
 */
pub fn strip_indent(line: string, n: int) -> string {
  const ws = leading_ws_len(line)
  const take = if ws < n {
    ws
  } else {
    n
  }
  return line.substring(take, line.len())
}

/**
 * Count of leading backtick characters in `s`. A markdown fence needs at
 * least three; anything less is ordinary text.
 */
pub fn backtick_run_len(s: string) -> int {
  let i = 0
  const n = s.len()
  while i < n {
    if s.char_at(i) != "`" {
      break
    }
    i = i + 1
  }
  return i
}

/**
 * How a block with this info string is validated, or "" when the fence is
 * not one this checker owns (```bash, ```text, ...). The mode decides both
 * the temp-file extension and the `harn` subcommand, so teaching the checker
 * a new language means adding one arm here plus its `mode_*` arms below.
 */
pub fn fence_mode(info: string) -> string {
  const bare = fence_strip_title(info)
  if bare == "harn" {
    return "parse"
  }
  if bare == "harn,check" {
    return "check"
  }
  if bare == "harn,diagnostic-check" {
    return "diagnostic-check"
  }
  if bare == "harn,diagnostic-lint" {
    return "diagnostic-lint"
  }
  if bare == "harn-prompt" {
    return "prompt"
  }
  return ""
}

/**
 * The info string with a `title="..."` segment removed.
 *
 * The site renders `title="example.harn"` as a filename header on the block.
 * Without this, adding one would push the info string past the exact matches
 * above and silently drop the block from this gate. Only `title` is stripped:
 * any other trailing content still fails to match, which is what keeps an
 * unrecognized fence variant from being validated by accident.
 */
pub fn fence_strip_title(info: string) -> string {
  const marker = " title=\""
  const start = info.index_of(marker)
  if start < 0 {
    return info
  }
  const rest = info.substring(start + marker.len(), info.len())
  const close = rest.index_of("\"")
  if close < 0 {
    return info
  }
  return info.substring(0, start) + rest.substring(close + 1, rest.len())
}

/** Whether this info string opens a block the author asked to skip. */
pub fn fence_is_ignored(info: string) -> bool {
  const bare = fence_strip_title(info)
  return bare == "harn,ignore" || bare == "harn-prompt,ignore"
}

/** Whether this info string opens a block this checker tracks at all. */
pub fn fence_is_owned(info: string) -> bool {
  return fence_mode(info) != "" || fence_is_ignored(info)
}

/** Temp-file suffix a block of `mode` must be written to. */
pub fn mode_extension(mode: string) -> string {
  if mode == "prompt" {
    return ".harn.prompt"
  }
  return ".harn"
}

/** The `harn` argv that validates a block of `mode` written to `path`. */
pub fn mode_argv(mode: string, path: string) -> list<string> {
  if mode == "check" {
    return ["check", path]
  }
  if mode == "diagnostic-check" {
    return ["check", "--json", path]
  }
  if mode == "diagnostic-lint" {
    return ["lint", "--json", path]
  }
  if mode == "prompt" {
    return ["lint", path]
  }
  return ["parse", "--json", path]
}

/** Human label for a block of `mode`, used in FAIL output. */
pub fn mode_label(mode: string) -> string {
  if mode == "prompt" {
    return "harn-prompt"
  }
  return "harn"
}

/** Whether `mode` expects a diagnostic rather than a successful source file. */
pub fn mode_is_diagnostic(mode: string) -> bool {
  return mode == "diagnostic-check" || mode == "diagnostic-lint"
}

/** Stable command label stored in the generated website projection. */
pub fn diagnostic_command(mode: string) -> string {
  if mode == "diagnostic-lint" {
    return "lint"
  }
  return "check"
}

/**
 * Decode the single diagnostic required by a diagnostic example. This is
 * deliberately fail-closed: publishing a cascade would make the highlighted
 * span ambiguous, while accepting zero findings would let a repaired example
 * keep displaying a stale error.
 */
pub fn decode_example_diagnostic(stdout: string, content: string) -> dict {
  const envelope = try {
    json_parse(stdout)
  } catch (err) {
    return {ok: false, error: "command did not emit valid JSON: ${err}"}
  }
  const files = envelope?.data?.files
  if files == nil || files.count() != 1 {
    return {ok: false, error: "expected one file report"}
  }
  const diagnostics = files[0]?.diagnostics
  if diagnostics == nil || diagnostics.count() != 1 {
    const count = diagnostics?.count() ?? 0
    return {ok: false, error: "expected exactly one diagnostic, found ${count}"}
  }
  const diagnostic = diagnostics[0]
  const code = diagnostic?.code
  const severity = diagnostic?.severity
  const message = diagnostic?.message
  const span = diagnostic?.span
  if code == nil || !code.starts_with("HARN-") {
    return {ok: false, error: "diagnostic is missing a stable HARN-* code"}
  }
  if severity != "error" && severity != "warning" {
    return {ok: false, error: "diagnostic has unsupported severity ${severity}"}
  }
  if message == nil || message == "" {
    return {ok: false, error: "diagnostic message is empty"}
  }
  const content_bytes = bytes_len(bytes_from_string(content))
  if span == nil || span.start < 0 || span.end <= span.start || span.end > content_bytes {
    return {ok: false, error: "diagnostic span is missing or outside the fixture"}
  }
  return {
    ok: true,
    diagnostic: {
      source: diagnostic.source,
      severity: severity,
      code: code,
      message: message,
      span: {start: span.start, end: span.end},
      help: diagnostic?.help,
    },
  }
}

/** Resolve repair prose from `harn explain`, the diagnostic registry projection. */
pub fn decode_example_repairs(stdout: string) -> dict {
  const explanation = try {
    json_parse(stdout)
  } catch (err) {
    return {ok: false, error: "harn explain did not emit valid JSON: ${err}"}
  }
  const repairs = explanation?.repairs
  if repairs == nil || repairs.count() == 0 {
    return {ok: false, error: "diagnostic registry exposes no repair"}
  }
  let projected: list = []
  for repair in repairs {
    if repair?.id == nil || repair?.safety == nil || repair?.summary == nil {
      return {ok: false, error: "diagnostic registry repair is incomplete"}
    }
    projected = projected
      + [{id: repair.id, safety: repair.safety, summary: repair.summary}]
  }
  return {ok: true, repairs: projected}
}

// A call whose first two positional arguments are the same bare identifier —
// the `agent_loop(harness,\n  harness, ...)` shape a reader gets by pasting a
// receiver twice. Harn accepts extra positional arguments, so this is
// arity-legal: neither `harn parse` nor `harn check` rejects it, and the
// snippet only fails when someone actually runs it. Group 1 is the callee,
// groups 2 and 3 the two leading arguments.
const DUPLICATE_LEADING_ARG_RE =
  r"([A-Za-z_][A-Za-z0-9_]*)\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*,\s*([A-Za-z_][A-Za-z0-9_]*)\s*,"

/**
 * `{callee, name, line}` records for every call in `content` that passes the
 * same bare identifier as both its first and second argument. `line` is
 * 1-based within the snippet body. Pure so the tests can drive it.
 */
pub fn duplicate_leading_args(content: string) -> list {
  let out: list = []
  for m in regex_captures(DUPLICATE_LEADING_ARG_RE, content) {
    if m.groups[1] == m.groups[2] {
      out = out + [{callee: m.groups[0], name: m.groups[1], line: m.line}]
    }
  }
  return out
}

/**
 * Return every line in `content` wider than `limit` columns, as
 * `[{line, width, text}]` in source order. `text` is the trimmed line, so the
 * failure can show the offender instead of only naming its coordinates.
 *
 * The published column is narrower than the editor one. Docs render inside a
 * reading measure, so a line the formatter is happy with at its own 100-column
 * budget can still force a reader to drag a scrollbar. This is a *reading*
 * budget, not a second formatter: it says a line is too wide and leaves where
 * to break it to whoever wrote the example.
 *
 * That distinction is deliberate and was measured. `harn fmt` at its default
 * width collapses readable multi-line calls onto single long lines; at
 * `--line-width 72` it expands them to one argument per line. Across docs/src
 * neither shape beat the hand-authored original for a reader, so the gate
 * constrains the outcome and not the form.
 */
pub fn overlong_lines(content: string, limit: int) -> list {
  let out: list = []
  let line_no = 0
  for line in content.split("\n") {
    line_no = line_no + 1
    const trimmed = line.trim_end()
    if trimmed.len() > limit {
      out = out + [{line: line_no, width: trimmed.len(), text: trimmed}]
    }
  }
  return out
}

/**
 * Walk `text` with the fence state machine and return the block events in
 * source order:
 *   {kind: "unclosed", open_line}      — a ```harn fence that never closed
 *                                        before the next fence / EOF;
 *   {kind: "skip", idx, mode, content} — a ```harn,ignore block. Its body is
 *                                        carried anyway: it is not checked,
 *                                        but it is still rendered, so the
 *                                        reading-width budget still applies;
 *   {kind: "block", idx, mode, content}
 *                                      — a parseable/checkable Harn block
 *                                        body (lines joined, trailing
 *                                        newline). `mode` is "parse" for
 *                                        ```harn and "check" for
 *                                        ```harn,check.
 * `idx` counts harn fences per file, 1-based. Pure so tests can drive it.
 */
pub fn extract_blocks(text: string) -> list {
  let events: list = []
  let in_block = false
  let skip = false
  let block_mode = "parse"
  let idx = 0
  let open_line = 0
  let indent = 0
  let open_ticks = 0
  let body: list<string> = []
  let line_no = 0
  for line in text.lines() {
    line_no = line_no + 1
    const ws = leading_ws_len(line)
    const rest = line.substring(ws, line.len())
    const ticks = backtick_run_len(rest)
    const is_fence = ticks >= 3
    const info = if is_fence {
      rest.substring(ticks, rest.len())
    } else {
      ""
    }
    if is_fence && fence_is_owned(info) {
      if in_block {
        // Nested or unclosed fence — markdown is malformed. Surface the
        // line where the previous fence opened so the author can find it.
        events = events + [{kind: "unclosed", open_line: open_line}]
      }
      in_block = true
      skip = fence_is_ignored(info)
      block_mode = fence_mode(info)
      idx = idx + 1
      open_line = line_no
      indent = ws
      open_ticks = ticks
      body = []
      continue
    }
    // A fence closes the open block only when it is at least as long as the
    // one that opened it, so a ```` block may contain ``` lines verbatim.
    if is_fence && in_block && ticks >= open_ticks {
      in_block = false
      const kind = if skip {
        "skip"
      } else {
        "block"
      }
      events = events
        + [{kind: kind, idx: idx, mode: block_mode, content: body.join("\n") + "\n"}]
      continue
    }
    if in_block {
      body = body + [strip_indent(line, indent)]
    }
  }
  if in_block {
    events = events + [{kind: "unclosed", open_line: open_line}]
  }
  return events
}

/** Repo-relative form of a glob result (strip the `/./` marker). */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/** The trailing path component of `p` without a final `.md` suffix. */
pub fn md_base_name(p: string) -> string {
  let slash = -1
  let i = 0
  const n = p.len()
  while i < n {
    if p.char_at(i) == "/" {
      slash = i
    }
    i = i + 1
  }
  let name = p.substring(slash + 1, n)
  if name.ends_with(".md") {
    name = name.substring(0, name.len() - 3)
  }
  return name
}

/** Prefix every line of `output` with `      | ` (the failure indent). */
pub fn indent_output(output: string) -> list<string> {
  let out: list<string> = []
  for line in output.lines() {
    out = out + ["      | " + line]
  }
  return out
}

/**
 * Resolve the harn binary used to validate snippets: $HARN_BIN wins,
 * else the workspace target dir's debug build (building it quietly when
 * missing) — the same ladder as the bash original.
 */
fn resolve_harn_bin(harness: Harness) -> string {
  const env_bin = harness.env.get("HARN_BIN")
  if env_bin != nil && env_bin != "" {
    return env_bin
  }
  let target_dir = ""
  const meta = harness.process.run(
    {program: "cargo", args: ["metadata", "--no-deps", "--format-version", "1"]},
  )
  if meta.success {
    const parsed = try {
      json_parse(meta.stdout)
    } catch (err) {
      nil
    }
    target_dir = parsed?.target_directory ?? ""
  }
  if target_dir == "" {
    target_dir = harness.env.get("CARGO_TARGET_DIR") ?? ""
  }
  if target_dir == "" {
    target_dir = "target"
  }
  const bin = "${target_dir}/debug/harn"
  if !harness.fs.exists(bin) {
    harness.stdio.eprintln("building harn-cli (set HARN_BIN to skip)...")
    const build = harness.process.run({program: "cargo", args: ["build", "-q", "-p", "harn-cli"]})
    if !build.success {
      harness.stdio.eprint(build.stderr)
      throw "cargo build -p harn-cli failed"
    }
  }
  return bin
}

pipeline main(harness: Harness, task) {
  const harn_bin = resolve_harn_bin(harness)
  let md_files: list<string> = []
  for docs_glob in DOCS_GLOBS {
    for g in harness.fs.glob(docs_glob) {
      md_files = md_files + [rel_path(g)]
    }
  }
  md_files = md_files.sorted()
  /* The runtime sandbox only permits writes inside the workspace, so the
   * snippet scratch directory lives there rather than under the system temp
   * dir the bash version used. `mkdtemp_in_workspace` puts it under the
   * runtime-owned `.harn-tmp/`, which `.gitignore` already covers.
   *
   * `mktemp -d` in the repository root was the earlier spelling. It is
   * removed on both success and failure by the defer below, but a SIGINT
   * while a snippet waits on the Harn build lock skips that, and what it
   * left behind was untracked state at the top of the working tree. The
   * same interruption now leaves it somewhere `git status` and the
   * repository scanners already ignore. */
  const tmp_dir = harness.fs.mkdtemp_in_workspace("harn-docs-snippets-")
  defer {
    harness.process.run({program: "rm", args: ["-rf", tmp_dir]})
  }
  let checked = 0
  let skipped = 0
  let failures = 0
  let width_counts: dict = {}
  let diagnostic_examples: list = []
  let file_no = 0
  for md_file in md_files {
    file_no = file_no + 1
    // Unlike the bash version, the temp prefix carries a per-file counter
    // so same-named docs (index.md, README.md) cannot collide.
    const prefix = "${tmp_dir}/${file_no}_${md_base_name(md_file)}"
    for event in extract_blocks(harness.fs.read_text(md_file)) {
      if event.kind == "unclosed" {
        failures = failures + 1
        harness.stdio.println("")
        harness.stdio.println(
          "FAIL: ${md_file} (unclosed ```harn fence opened at line ${event.open_line})",
        )
        harness.stdio.println("      hint: the next fenced block opens before this one closes.")
        continue
      }
      // Width is a property of the rendered page, not of the type checker,
      // so an ignored block is measured like any other.
      for wide in overlong_lines(event.content, MAX_SNIPPET_COLUMNS) {
        width_counts[md_file] = (width_counts[md_file] ?? 0) + 1
        harness.stdio.println(
          "WIDE: ${md_file} (${mode_label(event.mode)} block #${event.idx}, line ${wide.line}) ${wide.width} cols",
        )
        harness.stdio.println("      ${wide.text}")
      }
      if event.kind == "skip" {
        skipped = skipped + 1
        continue
      }
      checked = checked + 1
      if event.mode != "prompt" {
        for dup in duplicate_leading_args(event.content) {
          failures = failures + 1
          harness.stdio.println("")
          harness.stdio.println(
            "FAIL: ${md_file} (${mode_label(event.mode)} block #${event.idx}, line ${dup.line})",
          )
          harness.stdio.println(
            "      `${dup.callee}` receives `${dup.name}` as both its first and second argument.",
          )
        }
      }
      const block_path = "${prefix}_${event.idx}${mode_extension(event.mode)}"
      harness.fs.write_text(block_path, event.content)
      const res = harness.process.run({program: harn_bin, args: mode_argv(event.mode, block_path)})
      if mode_is_diagnostic(event.mode) {
        const decoded = decode_example_diagnostic(res.stdout, event.content)
        if !decoded.ok {
          failures = failures + 1
          harness.stdio.println("")
          harness.stdio.println(
            "FAIL: ${md_file} (${mode_label(event.mode)} diagnostic block #${event.idx})",
          )
          harness.stdio.println("      ${decoded.error}")
          for line in indent_output(res.stdout + res.stderr) {
            harness.stdio.println(line)
          }
          continue
        }
        const explain = harness.process.run(
          {program: harn_bin, args: ["explain", decoded.diagnostic.code, "--json"]},
        )
        const repairs = if explain.success {
          decode_example_repairs(explain.stdout)
        } else {
          {ok: false, error: "harn explain failed for ${decoded.diagnostic.code}"}
        }
        if !repairs.ok {
          failures = failures + 1
          harness.stdio.println("")
          harness.stdio.println(
            "FAIL: ${md_file} (${mode_label(event.mode)} diagnostic block #${event.idx})",
          )
          harness.stdio.println("      ${repairs.error}")
          continue
        }
        diagnostic_examples = diagnostic_examples
          + [
            {
              sourcePath: md_file,
              blockIndex: event.idx,
              command: diagnostic_command(event.mode),
              source: event.content,
              diagnostic: decoded.diagnostic + {repairs: repairs.repairs},
            },
          ]
      } else if !res.success {
        failures = failures + 1
        harness.stdio.println("")
        harness.stdio.println("FAIL: ${md_file} (${mode_label(event.mode)} block #${event.idx})")
        harness.stdio.println("      temp file: ${block_path}")
        for line in indent_output(res.stdout + res.stderr) {
          harness.stdio.println(line)
        }
      }
    }
  }
  const diagnostic_projection = json_stringify_pretty(
    {schemaVersion: 1, examples: diagnostic_examples},
  )
    + "\n"
  if failures == 0 {
    if argv.contains("--write-diagnostics") {
      harness.fs.write_text(DIAGNOSTIC_EXAMPLES_PATH, diagnostic_projection)
      harness.stdio.println(
        "updated ${DIAGNOSTIC_EXAMPLES_PATH} (${diagnostic_examples.count()} examples)",
      )
    } else {
      const committed = if harness.fs.exists(DIAGNOSTIC_EXAMPLES_PATH) {
        harness.fs.read_text(DIAGNOSTIC_EXAMPLES_PATH)
      } else {
        ""
      }
      if committed != diagnostic_projection {
        failures = failures + 1
        harness.stdio.println("")
        harness.stdio.println(
          "FAIL: ${DIAGNOSTIC_EXAMPLES_PATH} is stale relative to diagnostic fences",
        )
        harness.stdio.println("      hint: run `make sync-docs-diagnostics`")
      }
    }
  }
  // Every over-budget line was reported above as WIDE. The tree is at zero, so
  // the budget is a plain limit with no allowance list to keep in sync.
  for path in width_counts.keys().sorted() {
    failures = failures + 1
    harness.stdio.println("")
    harness.stdio.println(
      "FAIL: ${path} has ${width_counts[path]} line(s) over ${MAX_SNIPPET_COLUMNS} columns",
    )
    harness.stdio.println(
      "      Docs render in a reading measure, so a longer line costs a horizontal scroll.",
    )
    harness.stdio.println(
      "      Break the arguments across lines, or move a trailing comment above the code.",
    )
  }
  harness.stdio.println("")
  harness.stdio.println(
    "docs snippets: ${checked} checked, ${skipped} skipped (,ignore), ${failures} failed",
  )
  if failures > 0 {
    harness.stdio.println("")
    harness.stdio.println("hint: ```harn snippets must parse under `harn parse` — wrap bare")
    harness.stdio.println("      statements in `pipeline default() { ... }` or fix syntax")
    harness.stdio.println("      placeholders. ```harn-prompt blocks must parse under the prompt")
    harness.stdio.println("      engine: `if` and `for` both close with `{{ end }}`, and")
    harness.stdio.println("      `{{ endif }}` is a variable lookup, not a closing tag.")
    harness.stdio.println("      Tag a block ```harn,ignore / ```harn-prompt,ignore if it is an")
    harness.stdio.println("      intentional fragment.")
    harness.stdio.println("")
    harness.stdio.println("      A duplicated leading argument is arity-legal, so `harn check`")
    harness.stdio.println("      cannot see it — drop the repeated receiver (`agent_loop(harness,")
    harness.stdio.println(
      "      message, ...)`, not `agent_loop(harness, harness, message, ...)`).",
    )
    // harness.runtime.exit() bypasses defer, so remove the scratch directory before reporting
    // failure to the calling shell.
    harness.process.run({program: "rm", args: ["-rf", tmp_dir]})
    harness.runtime.exit(1)
  }
}
