/** Required native proof and explicit advisory platforms share this policy. */
pub type ReleasePlatform = {
  name: "macos" | "windows",
  required: bool,
  workflow_path: string,
  required_job: string,
  required_steps: list<string>,
}

pub type ReleasePlatforms = list<ReleasePlatform>

