// Fail when documentation still tells a reader to call a runtime API the
// compiler has removed.
//
// `make check-docs-snippets` type-checks fenced ```harn blocks, so a
// removed builtin inside one already fails. That leaves two surfaces
// nothing checks, and they are where stale API names actually survive:
//
//   1. prose — a backticked `llm_call(...)` inside a sentence, a row in
//      a reference table, a bullet in an LLM quickref;
//   2. ```harn,ignore bodies — deliberately exempt from type checking
//      because they are intentional fragments, which also exempts them
//      from noticing that the function they call no longer exists.
//
// THE ORACLE
// ----------
// There is no rename table in this file, because a hand-maintained one
// goes stale the moment somebody migrates a builtin without updating it.
// The compiler already owns the mapping: `harness_migration_for_builtin`
// in harn-vm, projected into
// `crates/harn-parser/src/diagnostic/harness_migrations_generated.rs` and
// kept honest by `make check-harness-migrations`. Calling a migrated
// global produces
//
//   error[HARN-NAM-002]: call target `llm_call` is not defined or
//   imported — did you mean `harness.llm.call`?
//
// So this gate collects every call-shaped identifier the docs mention,
// hands the whole set to one `harn check --json`, and reads the answer
// back. A symbol is flagged only when the suggested replacement starts
// with `harness.` — every entry in that generated table maps a legacy
// global to a typed `harness.<capability>.<method>` path, and nothing
// else produces a dotted suggestion.
//
// The `harness.` test is doing real work. HARN-NAM-002 also emits plain
// edit-distance suggestions for names that are merely undefined, and on
// this corpus those are pure noise: `add -> abs`, `run -> len`,
// `sql -> jq`, `_close -> clone`. Treating a bare suggestion as a rename
// would flag 57 non-issues. Treating a `harness.`-prefixed one as a
// rename flags exactly the migration table.
//
// ONLY CALL SHAPES COUNT
// ----------------------
// A mention is read only when the identifier is immediately followed by
// `(`. A bare backticked name is a name, and several removed builtins
// are still live *as names*: `llm_call` is the `AgentTraceEvent::LlmCall`
// serialization and the `llm_call` tape-event kind, which
// `docs/src/dev/tape-format.md` documents correctly in a table row.
// Flagging that row would order a factually wrong edit, so the call
// shape is the discriminator rather than a list of exceptions — a list
// would need maintaining every time a variant is added.
//
// The same rule covers two neighbours for free: `receipts.llm_call(x)`
// is rejected because the character before the name is `.`, and
// `safe_llm_call(p)` reads as `safe_llm_call` because the pattern takes
// the whole identifier. The cost is that a genuinely stale bare mention
// is not caught. That is the right side to err on: under-flagging leaves
// a defect, over-flagging manufactures one.
//
// THE KEYWORD FILTER IS LOAD-BEARING
// ----------------------------------
// The probe is one file with one statement per candidate. Docs mention
// `fn(`, `match(`, `mutex(`, `retry(`, `select(` and `tool(` in prose,
// and those are reserved words: emitting `fn()` makes the probe fail to
// *parse*, `harn check` reports one HARN-PAR-001 and no name resolution
// happens at all, and the gate silently finds nothing. The reserved set
// comes from `spec/language-vocabulary.json` (generated by
// `make gen-highlight` from the live lexer), never from a list typed
// here, and `probe_parse_error` fails loudly if a parse error slips
// through anyway.
//
// GENERATED PAGES RESOLVE TO THEIR OWNER
// --------------------------------------
// Generated pages are scanned because a stale projection is still a
// broken page. Ownership comes only from `scripts/generated_artifacts.toml`.
// When the registered source and its projection contain the same stale
// call, the source finding wins and the projection is folded into it. When
// only the projection is stale, the failure names the registered generator
// and its sources instead of asking a contributor to edit generated output.
// DOCS_GLOBS still names markdown sources such as `spec/chapters/*.md` and
// diagnostic explanations so a contributor gets the exact source line.
//
// THE ALLOWLIST IS A SHRINKING BASELINE
// -------------------------------------
// `scripts/docs-removed-symbols-allowlist.txt` seeds the current tree so
// this lands green, plus the pages that legitimately name old APIs
// (migration guides, ADRs). A baseline is not the default choice here —
// the sibling snippet-width gate deleted its baseline because that tree
// could be cleared to zero in the same change. This one cannot: the
// content fixes touch ~70 documentation pages that other work is editing
// right now, and a gate that has to wait for a 400-site burn-down is a
// gate that does not exist yet. So the baseline buys the ratchet
// immediately and the burn-down happens behind it. Entries may be
// removed freely; adding one is a reviewed act. `allowlist_stale` fails
// the build for any entry whose symbol is no longer referenced on that
// page, or is no longer removed at all, so the file cannot rot into a
// permanent exemption list.
//
// Usage:
//   harn run scripts/check_docs_symbols.harn
import {
  backtick_run_len,
  fence_is_ignored,
  leading_ws_len,
  rel_path,
  resolve_harn_bin,
} from "./check_docs_snippets.harn"
import { path_under } from "./warn_generated_artifact_drift.harn"

const DOCS_GLOBS = [
  "docs/src/**/*.md",
  "docs/llm/*.md",
  "spec/chapters/*.md",
  "crates/harn-parser/src/diagnostic_codes/explanations/*.md",
]

const VOCABULARY = "spec/language-vocabulary.json"

const REGISTRY = "scripts/generated_artifacts.toml"

const ALLOWLIST = "scripts/docs-removed-symbols-allowlist.txt"

// A migrated global the probe must always classify as removed. If the
// oracle stops answering — the message shape changes, the probe stops
// parsing, `harn check --json` starts reporting differently — every
// lookup returns "not removed" and the gate passes while checking
// nothing. Asserting one known answer turns that silent pass into a
// loud failure. `llm_call -> harness.llm.call` is the canonical entry
// in the migration table; if it ever legitimately leaves, this constant
// moves to another entry rather than being deleted.
const ORACLE_SENTINEL = "llm_call"

// Longest offending line reproduced in a failure, in columns.
const MAX_QUOTE_COLUMNS = 96

// Most failures a single run prints before summarising the rest.
const MAX_REPORTED = 60

// A call-shaped identifier: the callee immediately followed by `(`. The
// preceding character decides whether it counts, and that check lives in
// `line_call_targets` rather than in the pattern because Rust's regex
// engine has no lookbehind, and a consuming prefix group would drop the
// inner call of `outer(inner(x))`.
const CALL_RE = r"([a-z_][a-z0-9_]*)\("

const ALLOWLIST_ENTRY_RE = r"^(\S+)\s+(\S+)$"

/** Text between the first pair of backticks in `s`, or "". */
pub fn first_backtick(s: string) -> string {
  const open = s.index_of("`")
  if open < 0 {
    return ""
  }
  const rest = s.substring(open + 1, s.len())
  const close = rest.index_of("`")
  if close < 0 {
    return ""
  }
  return rest.substring(0, close)
}

/**
 * Where the fence state machine is, plus the surface the line it just
 * consumed should be read as.
 */
pub type FenceState = {in_block: bool, ticks: int, surface: string, scan: string}

/** The state a markdown file starts in: outside every fenced block. */
pub const FENCE_START: FenceState = {in_block: false, ticks: 0, surface: "prose", scan: ""}

/**
 * Advance the markdown fence state machine by one line.
 *
 * `state` carries `{in_block, ticks, surface}`; the result sets `scan`,
 * the surface this line's content should be read as:
 *
 *   "prose"  — outside any fenced block: only backticked calls count;
 *   "ignore" — inside a ```harn,ignore body: bare calls count;
 *   ""       — a fence line, or a block this gate does not read (a
 *              checked ```harn block, ```bash, ```text).
 *
 * A fence may be indented and may use more than three backticks; the
 * closing fence must be at least as long as the opening one, which is
 * how a block containing ``` is written. Pure so the tests can drive it.
 */
pub fn advance_surface(state: FenceState, line: string) -> FenceState {
  const ws = leading_ws_len(line)
  const rest = line.substring(ws, line.len())
  const ticks = backtick_run_len(rest)
  if ticks >= 3 {
    if state.in_block {
      if ticks >= state.ticks {
        return {in_block: false, ticks: 0, surface: "prose", scan: ""}
      }
    } else {
      const info = rest.substring(ticks, rest.len()).trim()
      const surface = if fence_is_ignored(info) {
        "ignore"
      } else {
        "other"
      }
      return {in_block: true, ticks: ticks, surface: surface, scan: ""}
    }
  }
  const scan = if state.in_block {
    state.surface
  } else {
    "prose"
  }
  return {in_block: state.in_block, ticks: state.ticks, surface: state.surface, scan: scan}
}

/**
 * Distinct call-target identifiers named on `line`, read as `surface`.
 *
 * In prose the callee must be introduced by a backtick, so `llm_call(`
 * inside a code span counts and the English word "handoff (see below)"
 * does not. In an ignored block the callee is bare code, so anything
 * counts except a method call: the character before the name must not be
 * `.`, which is what keeps `harness.llm.call(...)` — the *correct*
 * spelling — from being read as a call to `call`. Pure.
 */
pub fn line_call_targets(line: string, surface: string) -> list<string> {
  if line.index_of("(") < 0 {
    return []
  }
  if surface == "prose" && line.index_of("`") < 0 {
    return []
  }
  let out: list<string> = []
  for m in regex_captures(CALL_RE, line) {
    const prev = if m.start == 0 {
      ""
    } else {
      line.char_at(m.start - 1)
    }
    const wanted = if surface == "prose" {
      prev == "`"
    } else {
      prev != "." && prev != "`"
    }
    if wanted && !out.contains(m.groups[0]) {
      out = out + [m.groups[0]]
    }
  }
  return out
}

/**
 * Every call-target mention in `text` that this gate reads, as
 * `{line, symbol, text}` in source order. `line` is 1-based and `text`
 * is the trimmed source line, so a failure can show the offender rather
 * than only naming its coordinates. Pure.
 */
pub fn scan_mentions(text: string) -> list {
  let out: list = []
  let state: FenceState = FENCE_START
  let line_no = 0
  for line in text.lines() {
    line_no = line_no + 1
    state = advance_surface(state, line)
    const scan = state.scan
    if scan == "prose" || scan == "ignore" {
      for name in line_call_targets(line, scan) {
        out = out + [{line: line_no, symbol: name, text: line.trim()}]
      }
    }
  }
  return out
}

/**
 * The probe source: one bare call per candidate inside one `fn main`,
 * so a single `harn check` classifies every name at once. The sentinel
 * is appended so the run proves the oracle answered; the trailing
 * `harness` use keeps the parameter live.
 */
pub fn probe_source(names: list<string>) -> string {
  let lines: list<string> = ["fn main(harness: Harness) {"]
  for name in names {
    lines = lines + ["  ${name}()"]
  }
  return lines.join("\n")
    + "\n  ${ORACLE_SENTINEL}()\n  harness.stdio.println(\"probe\")\n}\n"
}

/**
 * The first message from a diagnostic list that says the probe itself
 * did not parse or lex, or "" when it parsed.
 *
 * This is the gate's own silent-failure mode. One unfiltered reserved
 * word turns the probe into a syntax error, name resolution never runs,
 * and every lookup below reports "not a removed symbol". Pure.
 */
pub fn probe_parse_error(diagnostics: list) -> string {
  for d in diagnostics {
    const code = d?.code ?? ""
    if code.starts_with("HARN-PAR-") || code.starts_with("HARN-LEX-") {
      return "${code}: ${d?.message ?? ""}"
    }
  }
  return ""
}

/**
 * `{legacy: replacement}` for every call target the compiler recognises
 * as migrated onto the typed harness, read out of one `harn check
 * --json` diagnostic list.
 *
 * Only a `harness.`-prefixed suggestion counts. HARN-NAM-002 also
 * offers edit-distance guesses for names that are simply undefined
 * (`run -> len`), and an internal `__`-prefixed twin for an importable
 * stdlib symbol (`pool_create -> __pool_create`); neither is a rename,
 * and neither survives this test. Pure.
 */
pub fn migrated_targets(diagnostics: list) -> dict {
  let out: dict = {}
  for d in diagnostics {
    if d?.code == "HARN-NAM-002" {
      const legacy = first_backtick(d?.message ?? "")
      const replacement = first_backtick(d?.help ?? "")
      if legacy != "" && replacement.starts_with("harness.") {
        out[legacy] = replacement
      }
    }
  }
  return out
}

/**
 * Parse the allowlist into `{pages, pairs, errors}`.
 *
 * Entry forms, one per line, `#` starting a comment anywhere:
 *   page <path>        — the whole page may name removed APIs
 *   <path> <symbol>    — one symbol on one page
 * Pure.
 */
pub fn parse_allowlist(text: string) -> dict {
  let pages: list<string> = []
  let pairs: list = []
  let errors: list<string> = []
  let line_no = 0
  for raw in text.lines() {
    line_no = line_no + 1
    const hash = raw.index_of("#")
    const body = if hash < 0 {
      raw
    } else {
      raw.substring(0, hash)
    }
    const entry = body.trim()
    if entry == "" {
      continue
    }
    const parsed = regex_captures(ALLOWLIST_ENTRY_RE, entry)
    if parsed.count() != 1 {
      errors = errors
        + [
          "${ALLOWLIST}:${line_no}: expected `page <path>` or "
            + "`<path> <symbol>`, got `${entry}`",
        ]
      continue
    }
    const first = parsed[0].groups[0]
    const second = parsed[0].groups[1]
    if first == "page" {
      pages = pages + [second]
    } else {
      pairs = pairs + [{path: first, symbol: second}]
    }
  }
  return {pages: pages, pairs: pairs, errors: errors}
}

/**
 * What `allowlist_stale` needs to rule on an entry: the parsed
 * allowlist, `hits` mapping "<path>\t<symbol>" to a mention count,
 * `page_hits` mapping a path to its total — both counted before any
 * allowlisting — and `removed`, the compiler's migration answer.
 */
pub type StalenessInput = {allow: dict, hits: dict, page_hits: dict, removed: dict}

/**
 * Reasons the allowlist has gone stale, as human-readable strings.
 *
 * An entry earns its place only while the thing it excuses is still both
 * present and still removed, so a fixed page or an un-migrated symbol
 * has to be pruned rather than left to accumulate. Pure.
 */
pub fn allowlist_stale(input: StalenessInput) -> list<string> {
  const allow = input.allow
  const hits = input.hits
  const page_hits = input.page_hits
  const removed = input.removed
  let out: list<string> = []
  for page in allow.pages {
    if (page_hits[page] ?? 0) == 0 {
      out = out
        + [
          "${ALLOWLIST}: `page ${page}` is stale — that page no longer "
            + "mentions any removed symbol. Delete the line.",
        ]
    }
  }
  for pair in allow.pairs {
    const key = "${pair.path}\t${pair.symbol}"
    if (hits[key] ?? 0) == 0 {
      const why = if removed[pair.symbol] == nil {
        "`${pair.symbol}` is not a removed symbol any more"
      } else {
        "${pair.path} no longer mentions `${pair.symbol}`"
      }
      out = out
        + [
          "${ALLOWLIST}: `${pair.path} ${pair.symbol}` is stale — "
            + "${why}. Delete the line.",
        ]
    }
  }
  return out
}

/**
 * Repository paths whose contents are generated from somewhere else,
 * read out of the generated-artifact registry so this gate never keeps
 * its own copy of that list. A directory output covers everything under
 * it.
 */
pub fn generated_paths(registry: dict) -> list<string> {
  let out: list<string> = []
  for art in registry?.artifact ?? [] {
    for output in art?.outputs ?? [] {
      if !out.contains(output) {
        out = out + [output]
      }
    }
  }
  return out
}

/** Whether `path` is, or lives under, one of `generated`. */
pub fn is_generated(path: string, generated: list<string>) -> bool {
  for entry in generated {
    if path == entry || path.starts_with(entry + "/") {
      return true
    }
  }
  return false
}

/** Registered ownership records for generated outputs. */
pub fn generated_owners(registry: dict) -> list {
  let out: list = []
  for art in registry?.artifact ?? [] {
    const outputs = art?.outputs ?? []
    if outputs.count() > 0 {
      out = out
        + [
          {
            id: art?.id ?? "",
            gen: art?.gen ?? "",
            check: art?.check ?? "",
            outputs: outputs,
            sources: art?.sources ?? [],
          },
        ]
    }
  }
  return out
}

/** The registry owner of `path`, or `nil` when it is not an output. */
pub fn generated_owner(path: string, owners: list) {
  let best = nil
  let best_len = -1
  for owner in owners {
    for output in owner.outputs {
      if path_under(path, output) && output.len() > best_len {
        best = owner
        best_len = output.len()
      }
    }
  }
  return best
}

/** Whether a finding is in one of an artifact's registered sources. */
pub fn finding_belongs_to_source(finding: dict, owner: dict) -> bool {
  for source in owner.sources {
    if path_under(finding.path, source) {
      return true
    }
  }
  return false
}

/**
 * Resolve raw documentation findings through generated-artifact ownership.
 *
 * Direct source findings stay unchanged. A generated duplicate disappears
 * only when the same removed symbol is present in a registered source. A
 * projection-only defect stays visible once per artifact and symbol, with
 * its owner attached for the diagnostic. Missing ownership is an explicit
 * error and never drops the finding. Pure.
 */
pub fn resolve_generated_findings(findings: list, generated: list<string>, owners: list) -> dict {
  let out: list = []
  let errors: list<string> = []
  let projection_keys: dict = {}
  for finding in findings {
    if !is_generated(finding.path, generated) {
      out = out + [finding]
      continue
    }
    const owner = generated_owner(finding.path, owners)
    if owner == nil {
      errors = errors
        + [
          "${finding.path}:${finding.line}: generated output has no "
            + "owner in ${REGISTRY}",
        ]
      out = out + [finding]
      continue
    }
    let source_duplicate = false
    for candidate in findings {
      if candidate.symbol == finding.symbol
        && !is_generated(candidate.path, generated)
        && finding_belongs_to_source(candidate, owner) {
        source_duplicate = true
      }
    }
    if source_duplicate {
      continue
    }
    const key = "${owner.id}\t${finding.symbol}"
    if projection_keys[key] == nil {
      projection_keys[key] = true
      out = out
        + [
          finding
            + {
              generated_owner: owner.id,
              generator: owner.gen,
              owner_check: owner.check,
              owner_sources: owner.sources,
            },
        ]
    }
  }
  return {findings: out, errors: errors}
}

/**
 * Failures from scanning a fixture whose answer is already known, so a
 * run that reports nothing has to prove it looked.
 *
 * A gate whose whole job is catching a silent regression must not be
 * able to regress silently itself, and the two ways this one can are
 * opposite. Under-reading: one unfiltered reserved word turns the probe
 * into a syntax error, name resolution never runs, and a broken checker
 * reports a clean tree. Over-reading: `llm_call` is *also* a live
 * serialized name — the `AgentTraceEvent::LlmCall` variant and the
 * `llm_call` tape-event kind — so a checker keyed on the bare
 * identifier rather than the call shape would demand a factually wrong
 * edit to `docs/src/dev/tape-format.md`.
 *
 * The fixture names ORACLE_SENTINEL twice: once call-shaped, which must
 * be reported, and once as a bare backticked name in a table cell,
 * which must not. Both directions fail loudly.
 */
pub fn self_test_failures(removed: dict) -> list<string> {
  const page = "# fixture\n\nCall `${ORACLE_SENTINEL}(req)` here.\n\n"
    + "| `${ORACLE_SENTINEL}` | a tape event kind, not a call |\n"
  let found: list = []
  for mention in scan_mentions(page) {
    if mention.symbol == ORACLE_SENTINEL && removed[mention.symbol] != nil {
      found = found + [mention]
    }
  }
  if found.count() != 1 {
    return [
      "self-test: a fixture that calls `${ORACLE_SENTINEL}(...)` once and "
        + "names it once without a call produced ${found.count()} "
        + "finding(s), expected 1. This run cannot report a clean tree "
        + "it never actually inspected.",
    ]
  }
  const line = found[0]?.line ?? 0
  if line != 3 {
    return [
      "self-test: the one finding is on line ${line}, expected line 3 — "
        + "the bare `${ORACLE_SENTINEL}` in the table row on line 5 is a "
        + "serialized event name, not a call, and must not be flagged.",
    ]
  }
  return []
}

/** `line` shortened to the failure quote budget. */
pub fn quote(line: string) -> string {
  if line.len() <= MAX_QUOTE_COLUMNS {
    return line
  }
  return line.substring(0, MAX_QUOTE_COLUMNS - 1) + "…"
}

pipeline main(harness: Harness, task: unknown) {
  const harn_bin = resolve_harn_bin(harness)
  const registry = try {
    toml_parse(harness.fs.read_text(REGISTRY))
  } catch (err) {
    harness.stdio.eprintln("error: cannot parse ${REGISTRY}: ${err}")
    return 1
  }
  const generated = generated_paths(registry)
  const owners = generated_owners(registry)
  const vocabulary = try {
    json_parse(harness.fs.read_text(VOCABULARY))
  } catch (err) {
    harness.stdio.eprintln("error: cannot parse ${VOCABULARY}: ${err}")
    return 1
  }
  // Reserved words come from the generated language vocabulary, never
  // from a list typed here — see the header.
  let reserved: dict = {}
  for word in vocabulary?.keywords ?? [] {
    reserved[word] = true
  }
  for word in vocabulary?.literals ?? [] {
    reserved[word] = true
  }
  if reserved.keys().count() == 0 {
    harness.stdio.eprintln("error: ${VOCABULARY} lists no keywords; the probe would not parse")
    return 1
  }
  let md_files: list<string> = []
  for docs_glob in DOCS_GLOBS {
    for g in harness.fs.glob(docs_glob) {
      const rel = rel_path(g)
      if !md_files.contains(rel) {
        md_files = md_files + [rel]
      }
    }
  }
  md_files = md_files.sorted()
  if md_files.count() == 0 {
    harness.stdio.eprintln("error: no documentation pages matched")
    return 1
  }
  // Pass 1: every distinct call target the docs name, minus reserved
  // words, becomes one line of the probe.
  let candidates: dict = {}
  for md_file in md_files {
    for mention in scan_mentions(harness.fs.read_text(md_file)) {
      if reserved[mention.symbol] == nil {
        candidates[mention.symbol] = true
      }
    }
  }
  const names = candidates.keys().sorted()
  const tmp_dir = harness.fs.mkdtemp_in_workspace("harn-docs-symbols-")
  defer {
    harness.process.run({program: "rm", args: ["-rf", tmp_dir]})
  }
  const probe_path = "${tmp_dir}/probe.harn"
  harness.fs.write_text(probe_path, probe_source(names))
  const res = harness.process.run({program: harn_bin, args: ["check", "--json", probe_path]})
  const report = try {
    json_parse(res.stdout)
  } catch (err) {
    harness.stdio.eprintln("error: `harn check --json` on the probe emitted no JSON: ${err}")
    harness.stdio.eprintln(res.stderr)
    return 1
  }
  let diagnostics: list = []
  for file_report in report?.data?.files ?? [] {
    diagnostics = diagnostics + (file_report?.diagnostics ?? [])
  }
  const parse_error = probe_parse_error(diagnostics)
  if parse_error != "" {
    harness.stdio.eprintln("error: the generated probe did not parse: ${parse_error}")
    harness.stdio.eprintln(
      "hint: a candidate is probably a reserved word that "
        + "${VOCABULARY} does not list. Without this guard the run "
        + "would report zero findings instead of failing.",
    )
    return 1
  }
  const removed = migrated_targets(diagnostics)
  if removed[ORACLE_SENTINEL] == nil {
    harness.stdio.eprintln(
      "error: the compiler no longer reports `${ORACLE_SENTINEL}` as a "
        + "removed builtin, so this gate cannot tell a stale API "
        + "reference from a live one.",
    )
    harness.stdio.eprintln(
      "hint: if that migration really was retired, point "
        + "ORACLE_SENTINEL at another entry of "
        + "crates/harn-parser/src/diagnostic/"
        + "harness_migrations_generated.rs.",
    )
    return 1
  }
  // Prove the scanner still reads what it claims to before believing a
  // clean verdict from it, in both directions.
  const self_test = self_test_failures(removed)
  if self_test.count() > 0 {
    for problem in self_test {
      harness.stdio.eprintln("error: ${problem}")
    }
    return 1
  }
  // Pass 2: locate every mention of a symbol the compiler just told us
  // is gone, with the file and line that has to change.
  let findings: list = []
  let hits: dict = {}
  let page_hits: dict = {}
  for md_file in md_files {
    for mention in scan_mentions(harness.fs.read_text(md_file)) {
      const replacement = removed[mention.symbol]
      if replacement != nil {
        const key = "${md_file}\t${mention.symbol}"
        hits[key] = (hits[key] ?? 0) + 1
        page_hits[md_file] = (page_hits[md_file] ?? 0) + 1
        findings = findings
          + [
            {
              path: md_file,
              line: mention.line,
              symbol: mention.symbol,
              replacement: replacement,
              text: mention.text,
            },
          ]
      }
    }
  }
  const resolved = resolve_generated_findings(findings, generated, owners)
  for problem in resolved.errors {
    harness.stdio.println("FAIL: ${problem}")
  }
  const allow = parse_allowlist(harness.fs.read_text(ALLOWLIST))
  for problem in allow.errors {
    harness.stdio.println("FAIL: ${problem}")
  }
  let allowed_pairs: dict = {}
  for pair in allow.pairs {
    allowed_pairs["${pair.path}\t${pair.symbol}"] = true
  }
  let reported = 0
  let generated_reported = 0
  let suppressed = 0
  for finding in resolved.findings {
    if allow.pages.contains(finding.path) {
      continue
    }
    if allowed_pairs["${finding.path}\t${finding.symbol}"] != nil {
      continue
    }
    reported = reported + 1
    if reported <= MAX_REPORTED {
      harness.stdio.println("")
      if finding?.generated_owner != nil {
        generated_reported = generated_reported + 1
        const target = if finding.generator != "" {
          "make ${finding.generator}"
        } else if finding.owner_check != "" {
          "make ${finding.owner_check}"
        } else {
          finding.generated_owner
        }
        harness.stdio.println(
          "FAIL: ${target} projects removed `${finding.symbol}` into "
            + "${finding.path}:${finding.line} — use `${finding.replacement}`",
        )
        harness.stdio.println("      registered sources: ${finding.owner_sources.join(", ")}")
      } else {
        harness.stdio.println(
          "FAIL: ${finding.path}:${finding.line} references removed "
            + "`${finding.symbol}` — use `${finding.replacement}`",
        )
      }
      harness.stdio.println("      ${quote(finding.text)}")
    } else {
      suppressed = suppressed + 1
    }
  }
  const stale = allowlist_stale({allow: allow, hits: hits, page_hits: page_hits, removed: removed})
  for problem in stale {
    harness.stdio.println("")
    harness.stdio.println("FAIL: ${problem}")
  }
  const failures = reported + stale.count() + allow.errors.count() + resolved.errors.count()
  if suppressed > 0 {
    harness.stdio.println("")
    harness.stdio.println("      ... and ${suppressed} more.")
  }
  harness.stdio.println("")
  harness.stdio.println(
    "docs symbols: ${md_files.count()} pages, ${names.count()} call "
      + "targets probed, ${removed.keys().count()} removed APIs known, "
      + "${findings.count()} mention(s), ${failures} failed",
  )
  if failures > 0 {
    harness.stdio.println("")
    harness.stdio.println(
      "hint: the replacement above comes from the compiler's own "
        + "migration table, not from a list in this repository's "
        + "scripts.",
    )
    if generated_reported > 0 {
      harness.stdio.println(
        "      For a generated page, edit its registered source and run "
          + "the named generator; do not edit the projection.",
      )
    }
    harness.stdio.println(
      "      For a hand-written page, update the prose or the "
        + "```harn,ignore body to the typed harness path.",
    )
    harness.stdio.println(
      "      A page that legitimately names an old API — a migration "
        + "guide, an ADR, a history section — belongs in "
        + "${ALLOWLIST} with a one-line reason.",
    )
    return 1
  }
  return 0
}
