/** CHANGELOG.md version headings: the leaf the fold and the notes renderer share. */
import { parse_release } from "std/semver"

pub type ChangelogEntry = {version: string, never_published: bool}

/** One parser owns version headings, including an explicitly retired candidate. */
pub fn changelog_entry_heading(line: string) -> ChangelogEntry? {
  if !line.starts_with("## v") {
    return nil
  }
  const suffix = " (never published)"
  const retired = line.ends_with(suffix)
  const version = line.substring(4, retired ? line.len() - suffix.len() : line.len())
  if parse_release(version) == nil {
    return nil
  }
  return {version: version, never_published: retired}
}

pub fn changelog_entries(text: string) -> list<ChangelogEntry> {
  let entries: list<ChangelogEntry> = []
  for line in text.lines() {
    const entry = changelog_entry_heading(line)
    if entry != nil {
      entries = entries + [entry]
    }
  }
  return entries
}

/** Install and comparison bases exclude identities that never shipped. */
pub fn published_changelog_versions(text: string) -> list<string> {
  return changelog_entries(text).filter({ entry -> !entry.never_published }).map(
    { entry -> entry.version },
  )
    .to_list()
}
