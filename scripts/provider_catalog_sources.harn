// Source adapters for the provider catalog refresh workflow.
//
// Each adapter is a function with the signature:
//   adapter(env: dict) -> {run: dict, observations: list<dict>}
//
// `env` is supplied by the entry script and carries:
//   - observed_at, fetched_at: deterministic timestamps the workflow stamps onto every observation.
//   - secrets: dict of env var name -> string, populated only when --live runs.
//   - http_options: optional dict forwarded to `web_fetch` so callers can swap timeouts/proxy in tests.
//
// The `run` dict is the per-source row the markdown report renders.
// `observations` is a list of records built via `observation(...)`
// (defined in `scripts/provider_catalog_refresh.harn`).
//
// The HTML / JSON / key-required helpers below are the canonical "happy
// path" adapter shapes; project repos can supply their own adapters
// using the same contract.
import { web_fetch, web_parse_html } from "std/web"
import "./provider_catalog_refresh.harn"

fn __row_value(row, index) {
  if index == nil {
    return nil
  }
  return row[index]
}

fn __mtok_from_string(text) {
  if text == nil {
    return nil
  }
  const stripped = regex_replace("[^0-9.]", "", to_string(text))
  if stripped == "" {
    return nil
  }
  return to_float(stripped)
}

fn __context_window_from_string(text) {
  if text == nil {
    return nil
  }
  const stripped = regex_replace("[^0-9]", "", to_string(text))
  if stripped == "" {
    return nil
  }
  return to_int(stripped)
}

fn __build_run(
  id: string,
  kind: string,
  source_owner: string,
  url: string?,
  status: string,
  options: dict,
) -> dict {
  return {
    id: id,
    kind: kind,
    source_owner: source_owner,
    url: url,
    status: status,
    reason: options?.reason,
    requires_key: options?.requires_key ?? false,
    key_envs: options?.key_envs ?? [],
    fetched_at: options?.fetched_at,
    not_modified: options?.not_modified ?? false,
  }
}

fn __fetch_failure_run(id: string, kind: string, source_owner: string, url: string, response: dict) -> dict {
  return __build_run(
    id,
    kind,
    source_owner,
    url,
    "error",
    {reason: "fetch failed with status " + to_string(response?.status ?? 0)},
  )
}

fn __first_available_secret(env: dict, key_envs: list<string>) -> dict? {
  const secrets = env?.secrets ?? {}
  for name in key_envs ?? [] {
    const value = secrets[name]
    if value != nil && value != "" {
      return {name: name, value: value}
    }
  }
  return nil
}

fn __env_with_auth_header(env: dict, config: dict, secret: dict) -> dict {
  const base_options = env?.http_options ?? {}
  const base_headers = base_options?.headers ?? {}
  const auth_header = config?.auth_header ?? "Authorization"
  const auth_prefix = config?.auth_prefix ?? "Bearer "
  const auth_value = auth_prefix + secret.value
  const headers = base_headers + (config?.extra_headers ?? {})
    + {Accept: "application/json", [auth_header]: auth_value}
  return env + {http_options: base_options + {headers: headers}}
}

/**
 * Adapter: HTML pricing/capability table.
 *
 * Walks the first table on the page, mapping columns by `column_map`
 * to observation fields. Provider-owned by default. `env.http_options`
 * is forwarded to `web_fetch` so callers can supply custom headers,
 * timeouts, or `previous` envelopes for conditional re-fetches.
 *
 * config keys:
 *   id, provider, source_url, table_index?, column_map (dict),
 *   header_match?, confidence (default "high"), terms_notes?.
 */
pub fn html_pricing_table_adapter(env: dict, config: dict) -> dict {
  const url = config.source_url
  const response = web_fetch(url, env?.http_options ?? {})
  if !response.ok {
    return {run: __fetch_failure_run(config.id, "html", "provider", url, response), observations: []}
  }
  const parsed = web_parse_html(response.body, response.final_url)
  const tables = parsed?.tables ?? []
  const table_index = config?.table_index ?? 0
  const table = tables[table_index]
  if table == nil {
    return {
      run: __build_run(
        config.id,
        "html",
        "provider",
        url,
        "error",
        {reason: "no table at index " + to_string(table_index)},
      ),
      observations: [],
    }
  }
  const column_map = config.column_map
  const headers = table?.headers ?? []
  let indices = {}
  let idx = 0
  while idx < len(headers) {
    const header = lowercase(trim(to_string(headers[idx])))
    for entry in column_map {
      const target = trim(lowercase(to_string(entry.header)))
      if header == target {
        indices = indices + {[entry.field]: idx}
      }
    }
    idx = idx + 1
  }
  const model_idx = indices?.model_id
  if model_idx == nil {
    return {
      run: __build_run(config.id, "html", "provider", url, "error", {reason: "table missing model_id column"}),
      observations: [],
    }
  }
  let observations = []
  for row in table?.rows ?? [] {
    const model_id = trim(to_string(row[model_idx] ?? ""))
    if model_id == "" {
      continue
    }
    const pricing_input = __mtok_from_string(__row_value(row, indices?.input_per_mtok))
    const pricing_output = __mtok_from_string(__row_value(row, indices?.output_per_mtok))
    const cache_read = __mtok_from_string(__row_value(row, indices?.cache_read_per_mtok))
    const cache_write = __mtok_from_string(__row_value(row, indices?.cache_write_per_mtok))
    const context = __context_window_from_string(__row_value(row, indices?.context_window))
    let pricing = {}
    if pricing_input != nil {
      pricing = pricing + {input_per_mtok: pricing_input}
    }
    if pricing_output != nil {
      pricing = pricing + {output_per_mtok: pricing_output}
    }
    if cache_read != nil {
      pricing = pricing + {cache_read_per_mtok: cache_read}
    }
    if cache_write != nil {
      pricing = pricing + {cache_write_per_mtok: cache_write}
    }
    const pricing_value = if len(pricing) == 0 {
      nil
    } else {
      pricing
    }
    const provenance = {
      source_url: url,
      source_kind: "html",
      source_owner: "provider",
      observed_at: env.observed_at,
      fetched_at: response.fetched_at,
      confidence: config?.confidence ?? "high",
      requires_key: false,
      terms_notes: config?.terms_notes,
    }
    const obs = observation(
      config.provider,
      model_id,
      {context_window: context, pricing: pricing_value},
      provenance,
    )
    observations = observations + [obs]
  }
  return {
    run: __build_run(
      config.id,
      "html",
      "provider",
      url,
      "ok",
      {fetched_at: response.fetched_at, not_modified: response?.not_modified ?? false},
    ),
    observations: observations,
  }
}

/**
 * Adapter: JSON API (public). Reads a list of model records from
 * `response.body` (assumed JSON) and maps each entry through `mapper`
 * to a normalized observation.
 *
 * config keys:
 *   id, provider, source_url, mapper, source_owner ("aggregator" or
 *   "provider"), confidence (default "high"), terms_notes?.
 */
pub fn json_api_adapter(env: dict, config: dict) -> dict {
  const url = config.source_url
  const response = web_fetch(url, env?.http_options ?? {})
  if !response.ok {
    return {
      run: __fetch_failure_run(config.id, "json", config?.source_owner ?? "aggregator", url, response),
      observations: [],
    }
  }
  const payload = json_parse(response.body ?? "")
  const entries = config.mapper(payload)
  const provenance_base = {
    source_url: url,
    source_kind: "json",
    source_owner: config?.source_owner ?? "aggregator",
    observed_at: env.observed_at,
    fetched_at: response.fetched_at,
    confidence: config?.confidence ?? "high",
    requires_key: false,
    terms_notes: config?.terms_notes,
  }
  let observations = []
  for entry in entries {
    if entry?.model_id == nil || entry.model_id == "" {
      continue
    }
    const provider = entry?.provider ?? config.provider
    const obs = observation(
      provider,
      entry.model_id,
      {
        name: entry?.name,
        context_window: entry?.context_window,
        pricing: entry?.pricing,
        capabilities: entry?.capabilities,
      },
      provenance_base + {notes: entry?.notes},
    )
    observations = observations + [obs]
  }
  return {
    run: __build_run(
      config.id,
      "json",
      config?.source_owner ?? "aggregator",
      url,
      "ok",
      {fetched_at: response.fetched_at, not_modified: response?.not_modified ?? false},
    ),
    observations: observations,
  }
}

/**
 * Adapter wrapper: gate a key-required source on the presence of an
 * env var. When the var is missing the adapter returns `status:
 * "skipped"` with the env name(s) recorded so the markdown report
 * surfaces the gap instead of silently treating the source as a
 * removal.
 */
pub fn key_required_adapter(env: dict, config: dict) -> dict {
  const key_envs = config.key_envs ?? []
  const secret = __first_available_secret(env, key_envs)
  if secret == nil {
    return {
      run: __build_run(
        config.id,
        config?.kind ?? "json",
        config?.source_owner ?? "provider",
        config?.source_url,
        "skipped",
        {requires_key: true, key_envs: key_envs, reason: "no API key in env (" + join(key_envs, ", ") + ")"},
      ),
      observations: [],
    }
  }
  const adapter_env = __env_with_auth_header(env, config, secret)
  const result = config.adapter(adapter_env)
  const augmented = result.run + {requires_key: true, key_envs: key_envs}
  return {run: augmented, observations: result.observations}
}

/**
 * Adapter: artificialanalysis.ai per-model benchmark page.
 *
 * Pulls AA's "intelligence" / SWE-bench Verified / SWE-bench Pro
 * scores when `--live` runs. The page renders the numbers via
 * `data-aa-intelligence-index` / `data-aa-swe-bench-verified` /
 * `data-aa-swe-bench-pro` attributes that the HTML scraper extracts.
 *
 * config keys:
 *   id          — `aa-<model_slug>` identifier for the run row
 *   provider    — provider whose row this benchmark belongs to
 *   model_id    — catalog model id to attribute the benchmark to
 *   source_url  — full https://artificialanalysis.ai/models/<slug> URL
 *
 * Output: one observation with `benchmarks: {aa_intelligence_index?,
 * swe_bench_verified?, swe_bench_pro?}` populated from whichever
 * numeric attributes the page exposed at fetch time. Pricing and
 * context window are deliberately NOT touched — the AA page is a
 * secondary source for those (provider pricing pages are
 * authoritative), so this adapter restricts itself to the benchmark
 * surface to avoid spurious drift.
 */
pub fn artificialanalysis_adapter(env: dict, config: dict) -> dict {
  const url = config.source_url
  const response = web_fetch(url, env?.http_options ?? {})
  if !response.ok {
    return {run: __fetch_failure_run(config.id, "html", "aggregator", url, response), observations: []}
  }
  const doc = web_parse_html(response.body ?? "")
  const benchmarks = __aa_extract_benchmarks(doc)
  if len(benchmarks) == 0 {
    return {
      run: __build_run(
        config.id,
        "html",
        "aggregator",
        url,
        "ok",
        {
          fetched_at: response.fetched_at,
          not_modified: response?.not_modified ?? false,
          reason: "no benchmark attributes found",
        },
      ),
      observations: [],
    }
  }
  const provenance = {
    source_url: url,
    source_kind: "html",
    source_owner: "aggregator",
    observed_at: env.observed_at,
    fetched_at: response.fetched_at,
    confidence: "medium",
    requires_key: false,
    terms_notes: "Benchmarks are published-snapshot at fetch time; AA refreshes monthly.",
  }
  const obs = observation(config.provider, config.model_id, {benchmarks: benchmarks}, provenance)
  return {
    run: __build_run(
      config.id,
      "html",
      "aggregator",
      url,
      "ok",
      {fetched_at: response.fetched_at, not_modified: response?.not_modified ?? false},
    ),
    observations: [obs],
  }
}

fn __aa_extract_benchmarks(doc) {
  // The AA page uses data-* attributes on the model overview block.
  // We accept partial matches (any single numeric attribute is enough)
  // so the adapter still produces observations when only one of the
  // three benchmark surfaces is published for a given model.
  let out = {}
  const intel_text = doc.attr("[data-aa-intelligence-index]", "data-aa-intelligence-index")
  const intel = __aa_to_float(intel_text)
  if intel != nil {
    out = out + {aa_intelligence_index: intel}
  }
  const verified_text = doc.attr("[data-aa-swe-bench-verified]", "data-aa-swe-bench-verified")
  const verified = __aa_to_float(verified_text)
  if verified != nil {
    out = out + {swe_bench_verified: verified}
  }
  const pro_text = doc.attr("[data-aa-swe-bench-pro]", "data-aa-swe-bench-pro")
  const pro = __aa_to_float(pro_text)
  if pro != nil {
    out = out + {swe_bench_pro: pro}
  }
  return out
}

fn __aa_to_float(text) {
  if text == nil {
    return nil
  }
  const stripped = regex_replace("[^0-9.\\-]", "", to_string(text))
  if stripped == "" || stripped == "-" {
    return nil
  }
  return to_float(stripped)
}
