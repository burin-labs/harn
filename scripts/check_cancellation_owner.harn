/**
 * Keep the host-cancellation error to one constructor.
 *
 * A cancellation that is thrown without dispatching `on_interrupt` handlers is
 * a cleanup hook that silently does not run. That drifted to eleven sites
 * because nothing said they had to agree: three modules each grew their own
 * constructor for the identical string, two of them sharing a function name,
 * and three more wrote it inline.
 *
 * The invariant this gate makes structural: the cancellation string is written
 * in exactly one location. Everything else calls that constructor and states,
 * in the constructor's own signature, whether it dispatched handlers or why it
 * could not. Test code is included in the rule rather than exempted from it,
 * so a matcher compares against the constructor instead of re-typing the text.
 *
 * A twelfth site then cannot compile past this gate.
 */
import { iter_literals_text } from "./check_rust_prompt_prose.harn"
import { scan_files } from "./path_visibility.harn"

const CHECK_NAME = "check-cancellation-owner"

/**
 * The exact thrown payload. Two consumers match this text, one by prefix and
 * one by full equality, so the string is a wire contract and may not change
 * shape here without changing them. Narrowing those two to a typed match is
 * tracked separately.
 */
const CANCELLATION_PAYLOAD = "kind:cancelled:VM cancelled by host"

/**
 * The one location allowed to write the payload, and the roots scanned for
 * violations. The allowed location is a path, not a pattern: a second owner is
 * the defect this gate exists to prevent.
 */
const OWNER_PATH = "crates/harn-vm-core/src/cancellation.rs"

const SCAN_ROOT = "crates"

type SourceInspection = {owner: bool, payloads: int, findings: list<string>}

fn inspect_source(path: string, source: string) -> SourceInspection {
  const normalized = path.replace("\\", "/")
  const owner = normalized == OWNER_PATH || normalized.ends_with("/${OWNER_PATH}")
  let payloads = 0
  let findings: list<string> = []
  for lit in iter_literals_text(source) {
    if lit.text == CANCELLATION_PAYLOAD {
      payloads = payloads + 1
      if !owner {
        findings = findings + ["${path}:${lit.line}"]
      }
    }
  }
  return {owner: owner, payloads: payloads, findings: findings}
}

fn owner_measured(files: int, payloads: int) -> bool {
  return files == 1 && payloads > 0
}

pipeline main(harness: Harness, task: unknown) {
  if argv.contains("--self-test") {
    return run_self_test(harness.stdio)
  }
  // scan-refused: scan_files is the refusal; it throws on an empty result.
  const files = scan_files(harness.fs, CHECK_NAME, SCAN_ROOT, "**/*.rs")
  let findings: list<string> = []
  let owner_files = 0
  let owner_payloads = 0
  for rel in files {
    const inspected = inspect_source(rel, harness.fs.read_text(rel))
    findings = findings + inspected.findings
    if inspected.owner {
      owner_files = owner_files + 1
      owner_payloads = owner_payloads + inspected.payloads
    }
  }
  harness.stdio.println(
    "${CHECK_NAME}: scanned ${files.count} Rust sources; owner_files=${owner_files}, owner_payloads=${owner_payloads}, findings=${findings.count}",
  )
  if !owner_measured(owner_files, owner_payloads) {
    harness.stdio.eprintln("${CHECK_NAME}: canonical owner was not measured: ${OWNER_PATH}")
    return 1
  }
  if findings.count > 0 {
    harness.stdio.eprintln(
      "${CHECK_NAME}: the host-cancellation payload is written outside its one owner.",
    )
    harness.stdio.eprintln("")
    harness.stdio.eprintln("Owner: ${OWNER_PATH}")
    harness.stdio.eprintln(
      "Call the constructor there and state whether the cancellation dispatched",
    )
    harness.stdio.eprintln(
      "interrupt handlers, or the reason it could not. This applies to tests too:",
    )
    harness.stdio.eprintln("compare against the constructor rather than re-typing the text.")
    harness.stdio.eprintln("")
    for f in findings {
      harness.stdio.eprintln("  - ${f}")
    }
    return 1
  }
  harness.stdio.println("${CHECK_NAME}: OK (${files.count} Rust sources, one owner)")
  return 0
}

/**
 * Deterministic fixture self-test. A gate that only ever sees a clean tree
 * cannot tell "no violations" from "scanned nothing", so this proves both
 * directions on fixed input: a body carrying the payload is found at its line,
 * and a body that merely mentions cancellation in prose is not.
 */
fn run_self_test(stdio: HarnessStdio) -> int {
  const bad = "fn f() -> E { E::Thrown(\"${CANCELLATION_PAYLOAD}\".into()) }"
  const good = "// the host cancellation payload lives in cancellation.rs\nfn f() {}"
  let bad_hits = 0
  for lit in iter_literals_text(bad) {
    if lit.text == CANCELLATION_PAYLOAD {
      bad_hits = bad_hits + 1
    }
  }
  let good_hits = 0
  for lit in iter_literals_text(good) {
    if lit.text == CANCELLATION_PAYLOAD {
      good_hits = good_hits + 1
    }
  }
  if bad_hits != 1 {
    stdio.eprintln("self-test failed: payload in a literal was not found (${bad_hits})")
    return 1
  }
  if good_hits != 0 {
    stdio.eprintln("self-test failed: payload named in a comment was flagged (${good_hits})")
    return 1
  }
  const owned = inspect_source(OWNER_PATH, bad)
  const copied = inspect_source("crates/harn-vm/src/cancellation.rs", bad)
  const windows_owned = inspect_source(OWNER_PATH.replace("/", "\\"), bad)
  const lookalike = inspect_source("else${OWNER_PATH}", bad)
  if !owned.owner || owned.payloads != 1 || owned.findings.count != 0 {
    stdio.eprintln("self-test failed: canonical Core owner was not measured")
    return 1
  }
  if copied.owner || copied.payloads != 1 || copied.findings.count != 1 {
    stdio.eprintln("self-test failed: payload copied into the native adapter was accepted")
    return 1
  }
  if !windows_owned.owner || windows_owned.payloads != 1 || windows_owned.findings.count != 0 {
    stdio.eprintln("self-test failed: Windows separators hid the canonical owner")
    return 1
  }
  if lookalike.owner || lookalike.findings.count != 1 {
    stdio.eprintln("self-test failed: an owner path without a directory boundary was accepted")
    return 1
  }
  if !owner_measured(1, owned.payloads) {
    stdio.eprintln("self-test failed: a measured canonical owner was refused")
    return 1
  }
  for absent in [{files: 0, payloads: 0}, {files: 1, payloads: 0}, {files: 2, payloads: 1}] {
    if owner_measured(absent.files, absent.payloads) {
      stdio.eprintln("self-test failed: an absent, empty, or duplicated owner was accepted")
      return 1
    }
  }
  stdio.println("${CHECK_NAME} self-test OK")
  return 0
}
