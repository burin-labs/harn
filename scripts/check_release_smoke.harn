import { help_requested, parse, parser } from "std/cli/argparse"
import "std/schema"
import { is_v_release_semver } from "std/semver"

/**
 * What this script requires of `gh repo view --json nameWithOwner`.
 *
 * `gh` is a boundary like any other: it can return an error document, an empty
 * object, or a field of the wrong type, and the failure then surfaces as an
 * empty repo name several calls later. Validating here names the requirement
 * once, where the payload arrives.
 */
fn repo_schema() {
  return schema_object(
    {nameWithOwner: schema_field(schema_string())},
    {additional_properties: true},
  )
}

/** The run fields this script reads, matching the `--json` list it asks for. */
fn runs_schema() {
  return schema_list(
    schema_object(
      {
        databaseId: schema_field(schema_int()),
        conclusion: schema_field(schema_string(), false),
        event: schema_field(schema_string(), false),
        displayTitle: schema_field(schema_string(), false),
        headBranch: schema_field(schema_string(), false),
        url: schema_field(schema_string(), false),
        createdAt: schema_field(schema_string(), false),
      },
      {additional_properties: true},
    ),
  )
}

pub fn release_smoke_run_covers(run: dict, tag: string) -> bool {
  if to_string(run?.conclusion ?? "") != "success" {
    return false
  }
  const title = to_string(run?.displayTitle ?? "")
  const branch = to_string(run?.headBranch ?? "")
  const event = to_string(run?.event ?? "")
  if title.contains("(" + tag + ")") || branch == tag {
    return true
  }
  if branch == "release/" + tag || branch.starts_with("release-attempt/" + tag + "/") {
    return ["workflow_run", "workflow_dispatch", "release"].contains(event)
  }
  return false
}

pub fn release_smoke_log_covers(log: string, tag: string) -> bool {
  for marker in [
    "All release assets for " + tag + " are available",
    "TAG: " + tag,
    "ref: " + tag,
    "refs/tags/" + tag,
  ] {
    if log.contains(marker) {
      return true
    }
  }
  return false
}

pub fn select_release_smoke_run(runs: list, tag: string, log_loader: unknown) {
  let matches = runs.filter({ run -> release_smoke_run_covers(run, tag) })
  if matches.count == 0 {
    const candidates = runs.filter(
      { run ->
        to_string(run?.conclusion ?? "") == "success"
          && ["workflow_run", "workflow_dispatch", "release"].contains(to_string(run?.event ?? ""))
      },
    )
      .sort_by({ run -> to_string(run?.createdAt ?? "") })
      .reverse()
      .take(40)
    for run in candidates {
      const log = log_loader(to_int(run?.databaseId) ?? 0)
      if log != nil && release_smoke_log_covers(to_string(log), tag) {
        matches = matches + [run]
        break
      }
    }
  }
  if matches.count == 0 {
    return nil
  }
  return matches.sort_by({ run -> to_string(run?.createdAt ?? "") }).reverse()[0]
}

fn gh(process: HarnessProcess, program: string, args: list<string>) -> string {
  const result = process.run({program: program, args: args})
  if result.exit_code != 0 {
    throw "gh " + args.join(" ") + " failed: " + result.stderr.trim()
  }
  return result.stdout
}

fn missing_message(tag: string) -> string {
  return "error: no successful Release smoke run found for "
    + tag
    + "\n  checklist: a published release is not declarable-ready until\n"
    + "  Release smoke has passed against its artifacts (harn#5034).\n"
    + "  Dispatch manually with:\n"
    + "    gh workflow run 'Release smoke' -f tag="
    + tag
}

fn arg_spec() {
  return parser(
    {
      name: "check_release_smoke",
      args: [
        {kind: "positional", name: "tag", parse: "string", required: true},
        {kind: "flag", name: "gh_bin", long: "--gh-bin", parse: "string", default: "gh"},
      ],
    },
  )
}

fn main(harness: Harness) -> int {
  if help_requested(argv) {
    harness.stdio.eprintln("usage: scripts/check_release_smoke.sh vVERSION")
    return 2
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln("usage: scripts/check_release_smoke.sh vVERSION")
    return 2
  }
  const tag = to_string(unwrap(parsed_result).options?.tag ?? "")
  const gh_bin = to_string(unwrap(parsed_result).options?.gh_bin ?? "gh")
  if !is_v_release_semver(tag) {
    harness.stdio.eprintln("usage: scripts/check_release_smoke.sh vVERSION")
    return 2
  }
  try {
    let repo = to_string(harness.env.get("GITHUB_REPOSITORY") ?? "")
    if repo == "" {
      const repo_result = schema_check(
        json_parse(gh(harness.process, gh_bin, ["repo", "view", "--json", "nameWithOwner"])),
        repo_schema(),
      )
      if is_err(repo_result) {
        throw "gh repo view returned no usable nameWithOwner: "
          + to_string(unwrap_err(repo_result).message)
      }
      repo = unwrap(repo_result).nameWithOwner
      if repo == "" {
        throw "gh repo view returned no nameWithOwner"
      }
    }
    const runs_result = schema_check(
      json_parse(
        gh(
          harness.process,
          gh_bin,
          [
            "run",
            "list",
            "--repo",
            repo,
            "--workflow",
            "Release smoke",
            "--limit",
            "100",
            "--json",
            "databaseId,conclusion,event,displayTitle,headBranch,url,createdAt",
          ],
        ),
      ),
      runs_schema(),
    )
    if is_err(runs_result) {
      throw "gh run list returned an unusable payload: "
        + to_string(unwrap_err(runs_result).message)
    }
    const best = select_release_smoke_run(
      unwrap(runs_result),
      tag,
      { run_id ->
        const result = harness.process.run(
          {program: gh_bin, args: ["run", "view", to_string(run_id), "--repo", repo, "--log"]},
        )
        return result.exit_code == 0 ? result.stdout : nil
      },
    )
    if best == nil {
      harness.stdio.eprintln(missing_message(tag))
      return 1
    }
    harness.stdio.println(
      "check_release_smoke: "
        + tag
        + " covered by run "
        + to_string(best.databaseId)
        + " ("
        + to_string(best.event)
        + ", "
        + to_string(best.createdAt)
        + ")",
    )
    harness.stdio.println(to_string(best?.url ?? ""))
    return 0
  } catch (e) {
    harness.stdio.eprintln("error: " + to_string(e))
    return 1
  }
}
