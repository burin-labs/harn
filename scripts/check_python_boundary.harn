import { parse_args } from "std/cli"
import { find_files } from "std/fs"

const SKIP_SEGMENTS = [
  "/.burin/",
  "/.claude/",
  "/.git/",
  "/.harn/",
  "/.harn-runs/",
  "/.venv/",
  "/dist/",
  "/node_modules/",
  "/target/",
]

const HARN_MCP_HELPER_DEBT_REASON = "Tracked by harn#4219: Harn owns MCP fixture serving; Python remains only as a cutover shim."

const HARN_PROXY_HELPER_DEBT_REASON = "Tracked by harn#4219: Harn owns deterministic proxy fixture serving and capture; Python remains only as a cutover shim."

const PYTHON_ALLOWLIST = [
  {
    kind: "exact",
    pattern: "tests/bridge_mock_host.py",
    category: "test-harness-adapter",
    reason: "Out-of-process bridge test host intentionally runs as a foreign subprocess.",
  },
  {
    kind: "exact",
    pattern: "conformance/helpers/mcp_stdio_tool.py",
    category: "harn-cutover-debt",
    reason: HARN_MCP_HELPER_DEBT_REASON,
  },
  {
    kind: "exact",
    pattern: "conformance/helpers/mcp_stdio_progress.py",
    category: "harn-cutover-debt",
    reason: HARN_MCP_HELPER_DEBT_REASON,
  },
  {
    kind: "exact",
    pattern: "conformance/helpers/mcp_http_echo_server.py",
    category: "harn-cutover-debt",
    reason: HARN_MCP_HELPER_DEBT_REASON,
  },
  {
    kind: "exact",
    pattern: "conformance/helpers/mcp_http_elicit_server.py",
    category: "harn-cutover-debt",
    reason: HARN_MCP_HELPER_DEBT_REASON,
  },
  {
    kind: "exact",
    pattern: "conformance/helpers/mcp_roots_server.py",
    category: "harn-cutover-debt",
    reason: HARN_MCP_HELPER_DEBT_REASON,
  },
  {
    kind: "exact",
    pattern: "conformance/helpers/http_proxy_server.py",
    category: "harn-cutover-debt",
    reason: HARN_PROXY_HELPER_DEBT_REASON,
  },
  {
    kind: "prefix",
    pattern: "crates/harn-cli/assets/demo/",
    category: "fixture",
    reason: "Demo assets intentionally include foreign-language projects.",
  },
  {
    kind: "prefix",
    pattern: "crates/harn-hostlib/tests/fixtures/",
    category: "fixture",
    reason: "Hostlib AST/parser fixtures intentionally include foreign-language source.",
  },
  {
    kind: "prefix",
    pattern: "opentrustgraph-spec/examples/python/",
    category: "external-example",
    reason: "External spec examples intentionally include Python.",
  },
  {
    kind: "prefix",
    pattern: "spec/protocol-artifacts/python/",
    category: "generated-foreign-binding",
    reason: "Generated Python SDK binding for external consumers.",
  },
]

fn repo_root() -> string {
  return path_normalize(path_join(source_dir(), ".."))
}

fn rel_path(path: string, root: string) -> string {
  const normalized = replace(path_normalize(path), "\\", "/")
  const normalized_root = replace(path_normalize(root), "\\", "/")
  const prefix = normalized_root + "/"
  if normalized == normalized_root {
    return "."
  }
  if normalized.starts_with(prefix) {
    return normalized[len(prefix):]
  }
  return normalized
}

fn is_skipped(path: string) -> bool {
  const wrapped = "/" + replace(path, "\\", "/")
  for segment in SKIP_SEGMENTS {
    if wrapped.contains(segment) {
      return true
    }
  }
  return false
}

pub fn python_boundary_rule_for(path: string) -> dict {
  const normalized = replace(path_normalize(path), "\\", "/")
  for rule in PYTHON_ALLOWLIST {
    const pattern = to_string(rule.pattern)
    if rule.kind == "exact" && normalized == pattern {
      return rule + {allowed: true}
    }
    if rule.kind == "prefix" && normalized.starts_with(pattern) {
      return rule + {allowed: true}
    }
  }
  return {
    allowed: false,
    category: "forbidden",
    reason: "Repo orchestration should be Harn unless bootstrap, foreign artifact validation, or a subprocess fixture requires Python.",
  }
}

pub fn python_files(root: string = "") -> list<string> {
  const resolved_root = if root == "" {
    repo_root()
  } else {
    path_normalize(root)
  }
  let out: list<string> = []
  for path in find_files(resolved_root, "**/*.py") {
    const rel = rel_path(path, resolved_root)
    if is_skipped(rel) {
      continue
    }
    out = out + [rel]
  }
  return out.sort()
}

pub fn check_python_boundary(root: string = "") -> dict {
  const resolved_root = if root == "" {
    repo_root()
  } else {
    path_normalize(root)
  }
  let allowed = []
  let violations = []
  for path in python_files(resolved_root) {
    const rule = python_boundary_rule_for(path)
    const row = {path: path, category: rule.category, reason: rule.reason}
    if rule.allowed ?? false {
      allowed = allowed + [row]
    } else {
      violations = violations + [row]
    }
  }
  return {
    root: resolved_root,
    allowed: allowed,
    violations: violations,
    allowed_count: len(allowed),
    violation_count: len(violations),
  }
}

fn render_report(report: dict) -> string {
  if report.violation_count == 0 {
    return "python boundary check passed: "
      + to_string(report.allowed_count)
      + " classified Python file(s); no unclassified Python scripts remain."
  }
  let lines = [
    "python boundary check failed: " + to_string(report.violation_count)
      + " unclassified Python file(s)",
    "",
    "Port repo orchestration to Harn, delete dead Python, or add a narrow bootstrap/platform/fixture allowlist entry.",
  ]
  for violation in report.violations {
    lines = lines + ["- " + to_string(violation.path) + " (" + to_string(violation.reason) + ")"]
  }
  return join(lines, "\n")
}

fn arg_spec() -> list {
  return [
    {kind: "option", name: "root", flags: ["--root"], parse: "string", default: ""},
    {kind: "flag", name: "json", flags: ["--json"], default: false},
  ]
}

fn main(harness: Harness) {
  const parsed = parse_args(argv, arg_spec())
  if parsed?._help ?? false {
    harness.stdio
      .println("usage: harn run scripts/check_python_boundary.harn -- [--json] [--root PATH]")
    return nil
  }
  if len(parsed?._errors ?? []) > 0 || len(parsed?._extras ?? []) > 0 {
    const errors = (parsed?._errors ?? []) + (parsed?._extras ?? [])
    harness.stdio.eprintln(join(errors, "\n"))
    exit(2)
  }
  const report = check_python_boundary(to_string(parsed?.root ?? ""))
  if parsed?.json ?? false {
    harness.stdio.println(json_stringify_pretty(report))
  } else {
    const out = render_report(report)
    if report.violation_count == 0 {
      harness.stdio.println(out)
    } else {
      harness.stdio.eprintln(out)
    }
  }
  if report.violation_count > 0 {
    exit(1)
  }
  return nil
}
