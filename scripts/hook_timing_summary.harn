import { help_requested, parse, parser } from "std/cli/argparse"

type HookTimingEvent = {
  ts: string?,
  repository: string,
  repo: string,
  hook: string,
  profile: string,
  duration_ms: int,
  phases: dict<string, int>,
  exit_code: int?,
  commit_sha: string?,
  host: string?,
}

type HookTimingPhaseGroup = {
  repository: string,
  hook: string,
  profile: string,
  phase: string,
  count: int,
  total_ms: int,
  max_ms: int,
  avg_ms: int,
  p50_ms: int,
  p95_ms: int,
}

type HookTimingGroup = {
  repository: string,
  repo: string?,
  hook: string,
  profile: string,
  count: int,
  failures: int,
  total_ms: int,
  max_ms: int,
  avg_ms: int,
  p50_ms: int,
  p95_ms: int,
}

type DurationStats = {count: int, total_ms: int, max_ms: int, avg_ms: int, p50_ms: int, p95_ms: int}

type HookTimingObserved = {p50: int, p95: int, max: int, n: int, window: string}

type HookTimingBudget = {
  intent: string,
  valueMs: int,
  source: string,
  rule: string,
  observed: HookTimingObserved,
}

type HookTimingBudgetReport = {schemaVersion: int, limits: dict<string, HookTimingBudget>}

type HookTimingParseReport = {events: list<HookTimingEvent>, invalid_lines: int}

type HookTimingFilters = {repo: string, hook: string, min_ms: int}

type HookTimingReport = {
  input: string,
  filters: HookTimingFilters,
  events: list<HookTimingEvent>,
  groups: list<HookTimingGroup>,
  phase_groups: list<HookTimingPhaseGroup>,
  worktree_groups: list<HookTimingGroup>,
  invalid_lines: int,
}

fn usage() -> string {
  return join(
    [
      "usage: harn run scripts/hook_timing_summary.harn -- [--input PATH] [--limit N] [--repo TEXT] [--hook NAME] [--min-ms N] [--worktrees] [--json|--budgets]",
      "",
      "Summarizes ~/.burin/hook-timings.ndjson so slow local hook/build paths are visible.",
      "Use harn run --no-sandbox when reading the default ~/.burin log from outside the repo sandbox.",
    ],
    "\n",
  )
}

pub fn default_hook_timing_path(home: string) -> string {
  if home == "" {
    return ".burin/hook-timings.ndjson"
  }
  return path_join(home, ".burin/hook-timings.ndjson")
}

fn normalize_hook_phases(value) -> dict<string, int>? {
  if value == nil {
    return {}
  }
  if type_of(value) != "dict" {
    return nil
  }
  let phases: dict<string, int> = {}
  for entry in value {
    const name = to_string(entry.key)
    const duration_ms = to_int(entry.value)
    if name == "" || duration_ms == nil || duration_ms < 0 {
      return nil
    }
    phases = phases + {[name]: duration_ms}
  }
  return phases
}

fn hook_phase_total(phases: dict<string, int>) -> int {
  return phases.values().to_list().sum()
}

pub fn hook_timing_event_from_json(value) -> HookTimingEvent? {
  const repo = to_string(value?.repo ?? "")
  const repository = to_string(value?.repository ?? repo)
  const hook = to_string(value?.hook ?? "")
  const profile = to_string(value?.profile ?? "legacy")
  const duration_ms = to_int(value?.duration_ms)
  const phases = normalize_hook_phases(value?.phases)
  if repository == ""
    || hook == ""
    || !["fast", "full", "legacy"].contains(profile)
    || duration_ms == nil
    || duration_ms < 0
    || phases == nil
    || hook_phase_total(phases ?? {}) > duration_ms {
    return nil
  }
  const ts = if value?.ts == nil {
    nil
  } else {
    to_string(value?.ts)
  }
  const commit_sha = if value?.commit_sha == nil {
    nil
  } else {
    to_string(value?.commit_sha)
  }
  const host = if value?.host == nil {
    nil
  } else {
    to_string(value?.host)
  }
  const event: HookTimingEvent = {
    repository: repository,
    repo: repo,
    hook: hook,
    profile: profile,
    duration_ms: duration_ms,
    phases: phases,
    ts: ts,
    exit_code: to_int(value?.exit_code),
    commit_sha: commit_sha,
    host: host,
  }
  return event
}

pub fn parse_hook_timing_text(text: string) -> HookTimingParseReport {
  let events: list<HookTimingEvent> = []
  let invalid_lines = 0
  for line in text.lines() {
    const trimmed = line.trim()
    if trimmed == "" {
      continue
    }
    const parsed = try {
      json_parse(trimmed)
    } catch (_) {
      nil
    }
    const event = if parsed == nil {
      nil
    } else {
      hook_timing_event_from_json(parsed)
    }
    if event == nil {
      invalid_lines = invalid_lines + 1
    } else {
      events = events + [event]
    }
  }
  return {events: events, invalid_lines: invalid_lines}
}

fn rounded_average(total: int, count: int) -> int {
  if count <= 0 {
    return 0
  }
  return to_int(round((to_float(total) ?? 0.0) / (to_float(count) ?? 1.0))) ?? 0
}

fn nearest_rank(values: list<int>, percentile: int) -> int {
  if values.count == 0 {
    return 0
  }
  const sorted = values.sort_by({ value -> value })
  const rank = to_int(floor(((to_float(values.count * percentile) ?? 0.0) + 99.0) / 100.0)) ?? 1
  return sorted[rank - 1] ?? 0
}

fn duration_stats(durations: list<int>) -> DurationStats {
  const total_ms = durations.sum()
  return {
    count: durations.count,
    total_ms: total_ms,
    max_ms: durations.max() ?? 0,
    avg_ms: rounded_average(total_ms, durations.count),
    p50_ms: nearest_rank(durations, 50),
    p95_ms: nearest_rank(durations, 95),
  }
}

fn summarize_hook_timing_groups(
  events: list<HookTimingEvent>,
  by_worktree: bool,
) -> list<HookTimingGroup> {
  let by_key = {}
  for event in events {
    const repo = if by_worktree {
      event.repo
    } else {
      nil
    }
    const key = json_stringify([event.repository, repo, event.profile, event.hook])
    const previous = by_key[key]
    if previous == nil {
      by_key = by_key
        + {
        [key]: {
          repository: event.repository,
          repo: repo,
          hook: event.hook,
          profile: event.profile,
          count: 1,
          failures: if (event.exit_code ?? 0) == 0 {
            0
          } else {
            1
          },
          total_ms: event.duration_ms,
          max_ms: event.duration_ms,
          durations: [event.duration_ms],
        },
      }
    } else {
      by_key = by_key
        + {
        [key]: {
          repository: previous.repository,
          repo: previous.repo,
          hook: previous.hook,
          profile: previous.profile,
          count: previous.count + 1,
          failures: previous.failures
            + if (event.exit_code ?? 0) == 0 {
            0
          } else {
            1
          },
          total_ms: previous.total_ms + event.duration_ms,
          durations: previous.durations + [event.duration_ms],
          max_ms: if event.duration_ms > previous.max_ms {
            event.duration_ms
          } else {
            previous.max_ms
          },
        },
      }
    }
  }
  let groups: list<HookTimingGroup> = []
  for entry in by_key {
    const value = entry.value
    const stats = duration_stats(value.durations)
    groups = groups
      + [
      {
        repository: value.repository,
        repo: value.repo,
        hook: value.hook,
        profile: value.profile,
        count: stats.count,
        failures: value.failures,
        total_ms: stats.total_ms,
        max_ms: stats.max_ms,
        avg_ms: stats.avg_ms,
        p50_ms: stats.p50_ms,
        p95_ms: stats.p95_ms,
      },
    ]
  }
  return groups.sort_by({ group -> 0 - group.total_ms })
}

pub fn summarize_hook_timings(events: list<HookTimingEvent>) -> list<HookTimingGroup> {
  return summarize_hook_timing_groups(events, false)
}

pub fn summarize_hook_timing_phases(events: list<HookTimingEvent>) -> list<HookTimingPhaseGroup> {
  let by_key = {}
  for event in events {
    for phase in event.phases {
      const key = json_stringify([event.repository, event.profile, event.hook, phase.key])
      const previous = by_key[key]
      if previous == nil {
        by_key = by_key
          + {
          [key]: {
            repository: event.repository,
            hook: event.hook,
            profile: event.profile,
            phase: phase.key,
            durations: [phase.value],
          },
        }
      } else {
        by_key = by_key + {[key]: previous + {durations: previous.durations + [phase.value]}}
      }
    }
    if event.phases.keys().to_list().count > 0 {
      const unattributed_ms = event.duration_ms - hook_phase_total(event.phases)
      if unattributed_ms > 0 {
        const key = json_stringify([event.repository, event.profile, event.hook, "unattributed"])
        const previous = by_key[key]
        if previous == nil {
          by_key = by_key
            + {
            [key]: {
              repository: event.repository,
              hook: event.hook,
              profile: event.profile,
              phase: "unattributed",
              durations: [unattributed_ms],
            },
          }
        } else {
          by_key = by_key + {[key]: previous + {durations: previous.durations + [unattributed_ms]}}
        }
      }
    }
  }
  let groups: list<HookTimingPhaseGroup> = []
  for entry in by_key {
    const value = entry.value
    const stats = duration_stats(value.durations)
    groups = groups
      + [
      {
        repository: value.repository,
        hook: value.hook,
        profile: value.profile,
        phase: value.phase,
        count: stats.count,
        total_ms: stats.total_ms,
        max_ms: stats.max_ms,
        avg_ms: stats.avg_ms,
        p50_ms: stats.p50_ms,
        p95_ms: stats.p95_ms,
      },
    ]
  }
  return groups.sort_by({ group -> 0 - group.total_ms })
}

pub fn summarize_hook_timing_worktrees(events: list<HookTimingEvent>) -> list<HookTimingGroup> {
  return summarize_hook_timing_groups(events, true)
}

fn observation_window(events: list<HookTimingEvent>) -> string {
  const timestamps = events.filter({ event -> event.ts != nil }).map({ event -> event.ts ?? "" })
    .to_list()
    .sort_by({ value -> value })
  if timestamps.count == 0 {
    return "unknown"
  }
  return timestamps[0] + "/" + timestamps[timestamps.count - 1]
}

pub fn derive_hook_timing_budgets(events: list<HookTimingEvent>) -> HookTimingBudgetReport {
  const successful = events.filter(
    { event -> (event.exit_code ?? 0) == 0 && event.profile != "legacy" },
  )
    .to_list()
  let limits: dict<string, HookTimingBudget> = {}
  for group in summarize_hook_timings(successful) {
    if group.count < 4 {
      continue
    }
    const samples = successful.filter(
      { event ->
        event.repository == group.repository && event.profile == group.profile
          && event.hook
          == group.hook
      },
    )
      .to_list()
    const surface = "hook/" + group.repository + "/" + group.profile + "/" + group.hook
    limits = limits
      + {
      [surface]: {
        intent: "budget",
        valueMs: to_int(ceil((to_float(group.p95_ms) ?? 0.0) * 1.2)) ?? group.p95_ms,
        source: "derived",
        rule: "p95*1.2",
        observed: {
          p50: group.p50_ms,
          p95: group.p95_ms,
          max: group.max_ms,
          n: group.count,
          window: observation_window(samples),
        },
      },
    }
  }
  return {schemaVersion: 1, limits: limits}
}

pub fn slowest_hook_timings(events: list<HookTimingEvent>, limit: int) -> list<HookTimingEvent> {
  const sorted = events.sort_by({ event -> 0 - event.duration_ms })
  if limit <= 0 || sorted.count <= limit {
    return sorted
  }
  return sorted.slice(0, limit)
}

pub fn filter_hook_timings(
  events: list<HookTimingEvent>,
  filters: HookTimingFilters,
) -> list<HookTimingEvent> {
  let out: list<HookTimingEvent> = []
  for event in events {
    if filters.repo != ""
      && !event.repo.contains(filters.repo)
      && !event.repository.contains(filters.repo) {
      continue
    }
    if filters.hook != "" && event.hook != filters.hook {
      continue
    }
    if filters.min_ms > 0 && event.duration_ms < filters.min_ms {
      continue
    }
    out = out + [event]
  }
  return out
}

fn render_group(group: HookTimingGroup) -> string {
  return "- " + group.repository + " " + group.profile + " " + group.hook + ": total="
    + to_string(
    group.total_ms,
  )
    + "ms"
    + " count="
    + to_string(group.count)
    + " max="
    + to_string(group.max_ms)
    + "ms"
    + " avg="
    + to_string(group.avg_ms)
    + "ms"
    + " p50="
    + to_string(group.p50_ms)
    + "ms p95="
    + to_string(group.p95_ms)
    + "ms failures="
    + to_string(group.failures)
}

fn render_phase_group(group: HookTimingPhaseGroup) -> string {
  return "- " + group.repository + " " + group.profile + " " + group.hook + "/" + group.phase
    + ": total="
    + to_string(group.total_ms)
    + "ms count="
    + to_string(group.count)
    + " p50="
    + to_string(group.p50_ms)
    + "ms p95="
    + to_string(group.p95_ms)
    + "ms max="
    + to_string(group.max_ms)
    + "ms"
}

fn render_worktree_group(group: HookTimingGroup) -> string {
  return "- " + group.repository + " " + (group.repo ?? "unknown") + " " + group.profile + " "
    + group
    .hook
    + ": total="
    + to_string(group.total_ms)
    + "ms count="
    + to_string(group.count)
    + " p50="
    + to_string(group.p50_ms)
    + "ms p95="
    + to_string(group.p95_ms)
    + "ms failures="
    + to_string(group.failures)
}

fn render_event(event: HookTimingEvent) -> string {
  let line = "- " + event.repository + " " + event.profile + " " + event.hook + ": "
    + to_string(
    event.duration_ms,
  )
    + "ms"
  if event.exit_code != nil {
    line = line + " exit=" + to_string(event.exit_code)
  }
  if event.ts != nil {
    line = line + " ts=" + event.ts
  }
  return line
}

pub fn render_hook_timing_report(report: HookTimingReport, limit: int) -> string {
  let lines = [
    "hook timing summary",
    "===================",
    "input: " + report.input,
    "events: " + to_string(report.events.count),
    "invalid_lines: " + to_string(report.invalid_lines),
    "filters: repo="
      + if report.filters.repo == "" {
      "*"
    } else {
      report.filters.repo
    }
      + " hook="
      + if report.filters.hook == "" {
      "*"
    } else {
      report.filters.hook
    }
      + " min_ms="
      + to_string(report.filters.min_ms),
    "",
    "slowest invocations:",
  ]
  const slowest = slowest_hook_timings(report.events, limit)
  if slowest.count == 0 {
    lines = lines + ["- none"]
  } else {
    for event in slowest {
      lines = lines + [render_event(event)]
    }
  }
  lines = lines + ["", "aggregate by repository/profile/hook:"]
  const groups = if limit <= 0 || report.groups.count <= limit {
    report.groups
  } else {
    report.groups.slice(0, limit)
  }
  if groups.count == 0 {
    lines = lines + ["- none"]
  } else {
    for group in groups {
      lines = lines + [render_group(group)]
    }
  }
  lines = lines + ["", "aggregate phases by repository/profile/hook:"]
  const phase_groups = if limit <= 0 || report.phase_groups.count <= limit {
    report.phase_groups
  } else {
    report.phase_groups.slice(0, limit)
  }
  if phase_groups.count == 0 {
    lines = lines + ["- none"]
  } else {
    for group in phase_groups {
      lines = lines + [render_phase_group(group)]
    }
  }
  if report.worktree_groups.count > 0 {
    lines = lines + ["", "worktree drilldown:"]
    const worktree_groups = if limit <= 0 || report.worktree_groups.count <= limit {
      report.worktree_groups
    } else {
      report.worktree_groups.slice(0, limit)
    }
    for group in worktree_groups {
      lines = lines + [render_worktree_group(group)]
    }
  }
  return join(lines, "\n")
}

fn arg_spec() {
  return parser(
    {
      name: "hook_timing_summary",
      args: [
        {kind: "flag", name: "input", long: "--input", parse: "string", default: ""},
        {kind: "flag", name: "limit", long: "--limit", parse: "int", default: 10},
        {kind: "flag", name: "repo", long: "--repo", parse: "string", default: ""},
        {kind: "flag", name: "hook", long: "--hook", parse: "string", default: ""},
        {kind: "flag", name: "min_ms", long: "--min-ms", parse: "int", default: 0},
        {kind: "switch", name: "json", long: "--json", default: false},
        {kind: "switch", name: "budgets", long: "--budgets", default: false},
        {kind: "switch", name: "worktrees", long: "--worktrees", default: false},
      ],
    },
  )
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return nil
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    harness.stdio.eprintln("")
    harness.stdio.eprintln(usage())
    exit(2)
  }
  const parsed = unwrap(parsed_result).options
  const input = if to_string(parsed?.input ?? "") == "" {
    default_hook_timing_path(harness.env.get("HOME") ?? "")
  } else {
    to_string(parsed?.input)
  }
  const limit = to_int(parsed?.limit) ?? 10
  if !harness.fs.exists(input) {
    harness.stdio.eprintln("hook timing log not found: " + input)
    exit(1)
  }
  const parsed_log = parse_hook_timing_text(harness.fs.read_text(input))
  const filters: HookTimingFilters = {
    repo: to_string(parsed?.repo ?? ""),
    hook: to_string(parsed?.hook ?? ""),
    min_ms: to_int(parsed?.min_ms) ?? 0,
  }
  const events = filter_hook_timings(parsed_log.events, filters)
  const report: HookTimingReport = {
    input: input,
    filters: filters,
    events: events,
    groups: summarize_hook_timings(events),
    phase_groups: summarize_hook_timing_phases(events),
    worktree_groups: if parsed?.worktrees ?? false {
      summarize_hook_timing_worktrees(events)
    } else {
      []
    },
    invalid_lines: parsed_log.invalid_lines,
  }
  if (parsed?.json ?? false) && (parsed?.budgets ?? false) {
    harness.stdio.eprintln("--json and --budgets are mutually exclusive")
    exit(2)
  }
  if parsed?.budgets ?? false {
    harness.stdio.println(json_stringify_pretty(derive_hook_timing_budgets(events)))
  } else if parsed?.json ?? false {
    harness.stdio.println(json_stringify_pretty(report))
  } else {
    harness.stdio.println(render_hook_timing_report(report, limit))
  }
  return nil
}
