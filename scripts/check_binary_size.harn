// Build or check the shipped harn release binary against a size budget and,
// unless disabled, write a cargo-bloat report for follow-up analysis.
//
// Explicit CLI and environment overrides remain available for recovery, while
// normal checks read the same exact-byte policy as the hosted release gate.
// Exit codes are 2 for usage/tooling errors and 1 for a missing binary or a
// budget breach.
//
// Usage:
//   harn run scripts/check_binary_size.harn -- [options]
//
// Note: the `harn run` sandbox scopes filesystem access to the workspace
// root. When HARN_BIN / CARGO_TARGET_DIR / --report-dir point outside the
// repo, run with `harn run --no-sandbox` (CI keeps everything in-tree).
import { TypedReadResult, read_json_typed_result } from "std/fs"
import "std/schema"

pub type ReleaseBinarySizeBaseline = {
  version: string,
  source_sha: string,
  bytes: int,
  observed_at: string,
}

pub type ReleaseBinarySizeTargetPolicy = {
  target: string,
  budget_bytes: int,
  baseline: ReleaseBinarySizeBaseline,
}

pub type ReleaseBinarySizePolicy = {
  schema_version: int,
  default_target: string,
  targets: list<ReleaseBinarySizeTargetPolicy>,
}

pub type BinarySizeBudgetOverrides = {
  budget_mb: string,
  budget_mb_explicit: bool,
  budget_bytes: string,
}

const RELEASE_BINARY_SIZE_POLICY: string = ".github/release-binary-size-policy.json"

const MIN_BINARY_SIZE_HEADROOM_BYTES: int = 1048576

const MAX_BINARY_SIZE_HEADROOM_BYTES: int = 4194304

fn release_binary_size_baseline_schema() -> any {
  return schema_closed_object(
    {
      version: schema_string(),
      source_sha: schema_string(),
      bytes: schema_int(),
      observed_at: schema_string(),
    },
  )
}

fn release_binary_size_policy_schema() -> any {
  return schema_closed_object(
    {
      schema_version: schema_int(),
      default_target: schema_string(),
      targets: schema_list(
        schema_closed_object(
          {
            target: schema_string(),
            budget_bytes: schema_int(),
            baseline: release_binary_size_baseline_schema(),
          },
        ),
      ),
    },
  )
}

pub fn read_release_binary_size_policy_result(
  fs: HarnessFs,
  path: string,
) -> TypedReadResult<ReleaseBinarySizePolicy> {
  return read_json_typed_result<ReleaseBinarySizePolicy>(
    fs,
    path,
    release_binary_size_policy_schema(),
  )
}

pub fn release_binary_size_policy_errors(policy: ReleaseBinarySizePolicy) -> list<string> {
  let errors = []
  if policy.schema_version != 1 {
    errors = errors + ["schema_version must be 1"]
  }
  if policy.targets.count == 0 {
    errors = errors + ["targets must not be empty"]
  }
  let seen_targets = []
  for entry in policy.targets {
    if entry.target == "" {
      errors = errors + ["target must not be empty"]
    } else if seen_targets.contains(entry.target) {
      errors = errors + ["target must be unique: ${entry.target}"]
    }
    seen_targets = seen_targets + [entry.target]
    if entry.budget_bytes <= 0 {
      errors = errors + ["${entry.target}: budget_bytes must be positive"]
    }
    if entry.baseline.bytes <= 0 {
      errors = errors + ["${entry.target}: baseline.bytes must be positive"]
    }
    const headroom = entry.budget_bytes - entry.baseline.bytes
    if headroom < MIN_BINARY_SIZE_HEADROOM_BYTES {
      errors = errors + ["${entry.target}: binary-size headroom must be at least 1048576 bytes"]
    }
    if headroom > MAX_BINARY_SIZE_HEADROOM_BYTES {
      errors = errors + ["${entry.target}: binary-size headroom must be at most 4194304 bytes"]
    }
    if len(regex_captures("^[0-9]+[.][0-9]+[.][0-9]+$", entry.baseline.version)) == 0 {
      errors = errors + ["${entry.target}: baseline.version must be a semantic release version"]
    }
    if len(regex_captures("^[0-9a-f]{40}$", entry.baseline.source_sha)) == 0 {
      errors = errors + ["${entry.target}: baseline.source_sha must be a full lowercase Git commit"]
    }
    if len(
      regex_captures(
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
        entry.baseline.observed_at,
      ),
    )
      == 0 {
      errors = errors
        + [
        "${entry.target}: baseline.observed_at must be a UTC second-resolution timestamp",
      ]
    }
  }
  if !seen_targets.contains(policy.default_target) {
    errors = errors + ["default_target must name one target policy"]
  }
  return errors
}

pub fn release_binary_size_target_policy(
  policy: ReleaseBinarySizePolicy,
  target: string,
) -> ReleaseBinarySizeTargetPolicy? {
  for entry in policy.targets {
    if entry.target == target {
      return entry
    }
  }
  return nil
}

/** The --help text (bash `usage()` heredoc, invocation line updated). */
pub fn usage_text() -> string {
  return """
Usage: harn run scripts/check_binary_size.harn -- [options]

Build the release harn binary with symbol stripping enabled, assert it stays
below the configured size budget, and emit a cargo-bloat top-crates report.

Options:
  --no-build           Check an already-built release binary
  --target TARGET      Cargo target triple to build/check
  --bin PATH           Override the harn binary path
  --budget-mb MB       Override the policy budget in MiB
  --report-dir DIR     Directory for binary-size and cargo-bloat reports
  --skip-bloat         Only write binary-size.txt; do not run cargo-bloat
  -h, --help           Show this help

Environment:
  BINARY_SIZE_BUDGET_MB    MiB budget override
  BINARY_SIZE_BUDGET_BYTES Exact-byte budget override
  BINARY_SIZE_REPORT_DIR   Default report directory
  CARGO_TARGET_DIR         Cargo target directory
  HARN_BIN                 Default harn binary path
  HARN_RELEASE_TARGET      Default Cargo target triple
"""
    .trim()
}

/**
 * Parse CLI options over env-supplied defaults. Returns
 * `{ok: true, opts}` or `{ok: false, message, show_usage}` (unknown
 * arguments also print the usage, missing values do not — matching the
 * bash argument loop). `opts.help` short-circuits to the usage text.
 */
pub fn parse_args(args: list<string>, defaults) {
  let opts = {
    build_release: true,
    emit_bloat: true,
    target: defaults.target,
    harn_bin: defaults.harn_bin,
    budget_mb: defaults.budget_mb,
    budget_mb_explicit: false,
    budget_bytes: defaults.budget_bytes,
    report_dir: defaults.report_dir,
    help: false,
  }
  let i = 0
  while i < args.count {
    const a = args[i]
    if a == "--no-build" {
      opts = {...opts, build_release: false}
      i = i + 1
      continue
    }
    if a == "--skip-bloat" {
      opts = {...opts, emit_bloat: false}
      i = i + 1
      continue
    }
    if a == "-h" || a == "--help" {
      opts = {...opts, help: true}
      i = i + 1
      continue
    }
    if a == "--target" || a == "--bin" || a == "--budget-mb" || a == "--report-dir" {
      if i + 1 >= args.count {
        const noun = if a == "--bin" || a == "--report-dir" {
          "path"
        } else {
          "value"
        }
        return {ok: false, message: "error: ${a} requires a ${noun}", show_usage: false}
      }
      const value = args[i + 1]
      if a == "--target" {
        opts = {...opts, target: value}
      } else if a == "--bin" {
        opts = {...opts, harn_bin: value}
      } else if a == "--budget-mb" {
        opts = {...opts, budget_mb: value, budget_mb_explicit: true}
      } else {
        opts = {...opts, report_dir: value}
      }
      i = i + 2
      continue
    }
    return {ok: false, message: "error: unknown argument: ${a}", show_usage: true}
  }
  return {ok: true, opts: opts}
}

/**
 * Parse and validate the MiB budget: must be a number > 0. Returns the
 * float or nil (the awk `mb > 0` gate, minus awk's tolerance for
 * trailing garbage).
 */
pub fn parse_budget_mb(raw: string) -> float? {
  const mb = to_float(raw)
  if mb == nil || !(mb > 0.0) {
    return nil
  }
  return mb
}

/** Parse a positive decimal integer without accepting fractional or signed values. */
pub fn parse_positive_int(raw: string) -> int? {
  if len(regex_captures("^[0-9]+$", raw)) == 0 {
    return nil
  }
  const value = to_int(raw)
  return if value != nil && value > 0 {
    value
  } else {
    nil
  }
}

/** MiB budget to bytes: awk `printf "%.0f", mb * 1024 * 1024`. */
pub fn budget_bytes_of(mb: float) -> int {
  return to_int(round(mb * 1024.0 * 1024.0)) ?? 0
}

/** Resolve explicit overrides before the exact-byte policy default. */
pub fn resolve_binary_size_budget_bytes(
  policy: ReleaseBinarySizePolicy,
  target: string,
  overrides: BinarySizeBudgetOverrides,
) -> Result<int, string> {
  if overrides.budget_mb_explicit {
    const budget_mb = parse_budget_mb(overrides.budget_mb)
    return if budget_mb == nil {
      Err("--budget-mb must be a positive number, got '${overrides.budget_mb}'")
    } else {
      Ok(budget_bytes_of(budget_mb))
    }
  }
  if overrides.budget_bytes != "" {
    const budget_bytes = parse_positive_int(overrides.budget_bytes)
    return if budget_bytes == nil {
      Err("BINARY_SIZE_BUDGET_BYTES must be a positive integer, got '${overrides.budget_bytes}'")
    } else {
      Ok(budget_bytes)
    }
  }
  if overrides.budget_mb != "" {
    const budget_mb = parse_budget_mb(overrides.budget_mb)
    return if budget_mb == nil {
      Err("BINARY_SIZE_BUDGET_MB must be a positive number, got '${overrides.budget_mb}'")
    } else {
      Ok(budget_bytes_of(budget_mb))
    }
  }
  const policy_target = if target != "" {
    target
  } else {
    policy.default_target
  }
  const target_policy = release_binary_size_target_policy(policy, policy_target)
  return if target_policy == nil {
    Err(
      "release binary-size policy has no target '${policy_target}'; add a target entry or pass an explicit budget override",
    )
  } else {
    Ok(target_policy.budget_bytes)
  }
}

/** Bytes to MiB with two decimals: awk `printf "%.2f", bytes / 1024 / 1024`. */
pub fn format_mib(bytes: int) -> string {
  const cents = to_int(round(bytes * 100.0 / 1024.0 / 1024.0)) ?? 0
  const whole = cents / 100
  const frac = cents % 100
  const frac_str = if frac < 10 {
    "0${frac}"
  } else {
    "${frac}"
  }
  return "${whole}.${frac_str}"
}

/** Default binary path for a target triple (`.exe` for windows/msvc). */
pub fn default_bin_path(target_dir: string, target: string) -> string {
  const exe_suffix = if target.contains("windows") || target.contains("msvc") {
    ".exe"
  } else {
    ""
  }
  const target_component = if target != "" {
    "${target}/"
  } else {
    ""
  }
  return "${target_dir}/${target_component}release/harn${exe_suffix}"
}

/** The size-report block (printed to stdout and written to binary-size.txt). */
pub fn report_lines(
  harn_bin: string,
  target: string,
  actual_bytes: int,
  budget_bytes: int,
) -> list<string> {
  return [
    "harn binary size",
    "================",
    "binary: ${harn_bin}",
    "target: ${if target != "" { target } else { "host" }}",
    "bytes: ${actual_bytes}",
    "mib: ${format_mib(actual_bytes)}",
    "budget_bytes: ${budget_bytes}",
    "budget_mib: ${format_mib(budget_bytes)}",
  ]
}

/** Env var value or `fallback` when unset/empty. */
fn binary_size_env_or(env: HarnessEnv, name: string, fallback: string) -> string {
  const v = env.get(name)
  if v == nil || v == "" {
    return fallback
  }
  return v
}

/** Absolute repo root (the glob search root marker). */
fn repo_root(fs: HarnessFs) -> string {
  for g in fs.glob("Cargo.toml") {
    const idx = g.index_of("/./")
    if idx >= 0 {
      return g.substring(0, idx)
    }
  }
  return "."
}

/** True when `cmd` resolves on PATH (bash `command -v`). */
fn command_exists(process: HarnessProcess, cmd: string) -> bool {
  const res = try {
    process.run({program: "sh", args: ["-c", "command -v ${cmd}"]})
  } catch (err) {
    return false
  }
  return res.success
}

@complexity(allow)
pipeline main(harness: Harness, task) {
  const defaults = {
    target: binary_size_env_or(harness.env, "HARN_RELEASE_TARGET", ""),
    harn_bin: binary_size_env_or(harness.env, "HARN_BIN", ""),
    budget_mb: binary_size_env_or(harness.env, "BINARY_SIZE_BUDGET_MB", ""),
    budget_bytes: binary_size_env_or(harness.env, "BINARY_SIZE_BUDGET_BYTES", ""),
    report_dir: binary_size_env_or(harness.env, "BINARY_SIZE_REPORT_DIR", ""),
  }
  const parsed = parse_args(argv, defaults)
  if !parsed.ok {
    harness.stdio.eprintln(parsed.message)
    if parsed.show_usage {
      harness.stdio.eprintln(usage_text())
    }
    return 2
  }
  const opts = parsed.opts
  if opts.help {
    harness.stdio.println(usage_text())
    return 0
  }
  const policy_path = path_join(repo_root(harness.fs), RELEASE_BINARY_SIZE_POLICY)
  const policy_result = read_release_binary_size_policy_result(harness.fs, policy_path)
  if !is_ok(policy_result) {
    harness.stdio.eprintln(
      "error: invalid release binary-size policy: " + json_stringify(unwrap_err(policy_result)),
    )
    return 2
  }
  const policy = unwrap(policy_result)
  const policy_errors = release_binary_size_policy_errors(policy)
  if policy_errors.count > 0 {
    harness.stdio.eprintln("error: invalid release binary-size policy: " + policy_errors.join("; "))
    return 2
  }
  const budget_result = resolve_binary_size_budget_bytes(
    policy,
    opts.target,
    {
      budget_mb: opts.budget_mb,
      budget_mb_explicit: opts.budget_mb_explicit,
      budget_bytes: opts.budget_bytes,
    },
  )
  if !is_ok(budget_result) {
    harness.stdio.eprintln("error: " + unwrap_err(budget_result))
    return 2
  }
  const budget_bytes = unwrap(budget_result)
  const cargo_target_dir = binary_size_env_or(harness.env, "CARGO_TARGET_DIR", "")
  const target_dir = if cargo_target_dir != "" {
    cargo_target_dir
  } else {
    "${repo_root(harness.fs)}/target"
  }
  const target: string = opts.target
  let target_args: list<string> = []
  if target != "" {
    target_args = ["--target", target]
  }
  let harn_bin: string = opts.harn_bin
  if harn_bin == "" {
    harn_bin = default_bin_path(target_dir, target)
  }
  let report_dir: string = opts.report_dir
  if report_dir == "" {
    report_dir = "${target_dir}/binary-size/${if target != "" { target } else { "host" }}"
  }
  if opts.build_release {
    const strip = binary_size_env_or(harness.env, "CARGO_PROFILE_RELEASE_STRIP", "symbols")
    const build = harness.process.run(
      {
        program: "cargo",
        args: ["build", "--release", "-p", "harn-cli", "--bin", "harn"] + target_args,
        env: {CARGO_PROFILE_RELEASE_STRIP: strip},
      },
    )
    harness.stdio.print(build.stdout)
    harness.stdio.eprint(build.stderr)
    if !build.success {
      return build.exit_code
    }
  }
  if !harness.fs.exists(harn_bin) {
    harness.stdio.eprintln("error: harn binary not found at ${harn_bin}")
    return 1
  }
  const actual_bytes: int = harness.fs.stat(harn_bin).size
  const size_report = "${report_dir}/binary-size.txt"
  const bloat_report = "${report_dir}/cargo-bloat-crates.txt"
  harness.fs.mkdir(report_dir)
  const report = report_lines(harn_bin, target, actual_bytes, budget_bytes).join("\n") + "\n"
  harness.stdio.print(report)
  harness.fs.write_text(size_report, report)
  let size_ok = true
  if actual_bytes > budget_bytes {
    size_ok = false
    harness.stdio.eprintln(
      "error: harn binary is ${format_mib(actual_bytes)} MiB, above budget ${format_mib(budget_bytes)} MiB",
    )
  }
  if opts.emit_bloat {
    if !command_exists(harness.process, "cargo-bloat") {
      harness.stdio.eprintln("error: cargo-bloat is required to produce ${bloat_report}")
      return 2
    }
    /* `cargo bloat` performs its own analysis build and can relink the
     * target binary with different metadata. Preserve the exact stripped
     * binary whose size we checked so the script is safe to run before a
     * packaging step. The scratch dir lives in the workspace (the runtime
     * sandbox only permits writes inside the workspace root). */
    const mk = harness.process.run({program: "mktemp", args: ["-d", "harn-binary-size.XXXXXX"]})
    if !mk.success {
      harness.stdio.eprintln("error: could not create temp directory")
      return 1
    }
    const restore_dir = mk.stdout.trim()
    const checked_binary = "${restore_dir}/harn"
    harness.process.run({program: "cp", args: ["-p", harn_bin, checked_binary]})
    defer {
      if harness.fs.exists(checked_binary) {
        harness.process.run({program: "cp", args: ["-p", checked_binary, harn_bin]})
      }
      harness.process.run({program: "rm", args: ["-rf", restore_dir]})
    }
    let bloat_args = ["bloat", "--release", "--crates", "-p", "harn-cli", "--bin", "harn"]
      + target_args
    if cargo_target_dir != "" {
      bloat_args = bloat_args + ["--target-dir", cargo_target_dir]
    }
    bloat_args = bloat_args + ["-n", "40"]
    const bloat = harness.process.run({program: "cargo", args: bloat_args})
    harness.stdio.eprint(bloat.stderr)
    if !bloat.success {
      return bloat.exit_code
    }
    harness.fs.write_text(bloat_report, bloat.stdout)
    const tail = "\ncargo-bloat report: ${bloat_report}\n"
    harness.stdio.print(tail)
    harness.fs.write_text(size_report, report + tail)
  } else {
    const tail = "\ncargo-bloat report: skipped\n"
    harness.stdio.print(tail)
    harness.fs.write_text(size_report, report + tail)
  }
  if !size_ok {
    return 1
  }
  return 0
}
