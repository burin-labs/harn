// Build or check the shipped harn release binary against the two-level release
// size policy and, unless disabled, write a cargo-bloat report for follow-up
// analysis.
//
// The distribution fuse fails closed. The growth signal is reported alongside
// it and fails only when this build is comparable to the recorded baseline,
// crosses both growth thresholds, and no accepted_growth entry covers it — see
// `scripts/release_binary_size_policy.harn` for why those are different
// questions.
//
// Explicit CLI and environment overrides remain available for recovery, while
// normal checks read the same policy file as the hosted release gate. Exit
// codes are 2 for usage/tooling errors and 1 for a missing binary, a fuse
// breach, or an unaccepted growth crossing.
//
// Usage:
//   harn run scripts/check_binary_size.harn -- [options]
//
// Note: the `harn run` sandbox scopes filesystem access to the workspace
// root. When HARN_BIN / CARGO_TARGET_DIR / --report-dir point outside the
// repo, run with `harn run --no-sandbox` (CI keeps everything in-tree).
import "./release_binary_size_policy.harn"

pub type BinarySizeFuseOverrides = {fuse_mb: string, fuse_mb_explicit: bool, fuse_bytes: string}

/** The --help text (bash `usage()` heredoc, invocation line updated). */
pub fn usage_text() -> string {
  return """
Usage: harn run scripts/check_binary_size.harn -- [options]

Build the release harn binary with symbol stripping enabled, assert it stays
below the distribution fuse, report the growth signal against the recorded
baseline, and emit a cargo-bloat top-crates report.

Options:
  --no-build           Check an already-built release binary
  --target TARGET      Cargo target triple to build/check
  --bin PATH           Override the harn binary path
  --fuse-mb MB       Override the distribution fuse in MiB
  --report-dir DIR     Directory for binary-size and cargo-bloat reports
  --baseline-sections PATH  `size -A -d` table to attribute growth against
  --skip-bloat         Only write binary-size.txt; do not run cargo-bloat
  -h, --help           Show this help

Environment:
  BINARY_SIZE_FUSE_MB    MiB distribution-fuse override
  BINARY_SIZE_FUSE_BYTES Exact-byte distribution-fuse override
  BINARY_SIZE_REPORT_DIR   Default report directory
  BINARY_SIZE_BASELINE_SECTIONS  Default baseline `size -A -d` table
  BINARY_SIZE_SOURCE_SHA   Commit identifying the measured build
  CARGO_PROFILE_RELEASE_CODEGEN_UNITS, CARGO_PROFILE_RELEASE_LTO,
  CARGO_PROFILE_RELEASE_STRIP    Observed build identity (else read from Cargo.toml)
  HARN_REQUIRE_CLI_AOT     `1` when the AOT payload is embedded
  CARGO_TARGET_DIR         Cargo target directory
  HARN_BIN                 Default harn binary path
  HARN_RELEASE_TARGET      Default Cargo target triple
"""
    .trim()
}

/**
 * Parse CLI options over env-supplied defaults. Returns
 * `{ok: true, opts}` or `{ok: false, message, show_usage}` (unknown
 * arguments also print the usage, missing values do not — matching the
 * bash argument loop). `opts.help` short-circuits to the usage text.
 */
pub fn parse_args(args: list<string>, defaults) {
  let opts = {
    build_release: true,
    emit_bloat: true,
    target: defaults.target,
    harn_bin: defaults.harn_bin,
    fuse_mb: defaults.fuse_mb,
    fuse_mb_explicit: false,
    fuse_bytes: defaults.fuse_bytes,
    report_dir: defaults.report_dir,
    baseline_sections: defaults.baseline_sections,
    help: false,
  }
  let i = 0
  while i < args.count {
    const a = args[i]
    if a == "--no-build" {
      opts = {...opts, build_release: false}
      i = i + 1
      continue
    }
    if a == "--skip-bloat" {
      opts = {...opts, emit_bloat: false}
      i = i + 1
      continue
    }
    if a == "-h" || a == "--help" {
      opts = {...opts, help: true}
      i = i + 1
      continue
    }
    if a == "--target" || a == "--bin" || a == "--fuse-mb" || a == "--report-dir"
      || a
        == "--baseline-sections" {
      if i + 1 >= args.count {
        const noun = if a == "--bin" || a == "--report-dir" || a == "--baseline-sections" {
          "path"
        } else {
          "value"
        }
        return {ok: false, message: "error: ${a} requires a ${noun}", show_usage: false}
      }
      const value = args[i + 1]
      if a == "--target" {
        opts = {...opts, target: value}
      } else if a == "--bin" {
        opts = {...opts, harn_bin: value}
      } else if a == "--fuse-mb" {
        opts = {...opts, fuse_mb: value, fuse_mb_explicit: true}
      } else if a == "--baseline-sections" {
        opts = {...opts, baseline_sections: value}
      } else {
        opts = {...opts, report_dir: value}
      }
      i = i + 2
      continue
    }
    return {ok: false, message: "error: unknown argument: ${a}", show_usage: true}
  }
  return {ok: true, opts: opts}
}

/**
 * Parse and validate the MiB fuse: must be a number > 0. Returns the
 * float or nil (the awk `mb > 0` gate, minus awk's tolerance for
 * trailing garbage).
 */
pub fn parse_fuse_mb(raw: string) -> float? {
  const mb = to_float(raw)
  if mb == nil || !(mb > 0.0) {
    return nil
  }
  return mb
}

/** Parse a positive decimal integer without accepting fractional or signed values. */
pub fn parse_positive_int(raw: string) -> int? {
  if len(regex_captures("^[0-9]+$", raw)) == 0 {
    return nil
  }
  const value = to_int(raw)
  return if value != nil && value > 0 {
    value
  } else {
    nil
  }
}

/** MiB fuse to bytes: awk `printf "%.0f", mb * 1024 * 1024`. */
pub fn fuse_bytes_of(mb: float) -> int {
  return to_int(round(mb * 1024.0 * 1024.0)) ?? 0
}

/**
 * Resolve explicit overrides before the policy's distribution fuse.
 *
 * The overrides exist for recovery, and they move the fuse only. The growth
 * signal always compares against the recorded baseline, so overriding the
 * ceiling cannot silently retire the early signal too.
 */
pub fn resolve_distribution_fuse_bytes(
  policy: ReleaseBinarySizePolicy,
  target: string,
  overrides: BinarySizeFuseOverrides,
) -> Result<int, string> {
  if overrides.fuse_mb_explicit {
    const fuse_mb = parse_fuse_mb(overrides.fuse_mb)
    return if fuse_mb == nil {
      Err("--fuse-mb must be a positive number, got '${overrides.fuse_mb}'")
    } else {
      Ok(fuse_bytes_of(fuse_mb))
    }
  }
  if overrides.fuse_bytes != "" {
    const fuse_bytes = parse_positive_int(overrides.fuse_bytes)
    return if fuse_bytes == nil {
      Err("BINARY_SIZE_FUSE_BYTES must be a positive integer, got '${overrides.fuse_bytes}'")
    } else {
      Ok(fuse_bytes)
    }
  }
  if overrides.fuse_mb != "" {
    const fuse_mb = parse_fuse_mb(overrides.fuse_mb)
    return if fuse_mb == nil {
      Err("BINARY_SIZE_FUSE_MB must be a positive number, got '${overrides.fuse_mb}'")
    } else {
      Ok(fuse_bytes_of(fuse_mb))
    }
  }
  const policy_target = if target != "" {
    target
  } else {
    policy.default_target
  }
  const target_policy = release_binary_size_target_policy(policy, policy_target)
  return if target_policy == nil {
    Err(
      "release binary-size policy has no target '${policy_target}'; add a target entry or pass an explicit fuse override",
    )
  } else {
    Ok(target_policy.distribution_fuse_bytes)
  }
}

/** Bytes to MiB with two decimals: awk `printf "%.2f", bytes / 1024 / 1024`. */
pub fn format_mib(bytes: int) -> string {
  const cents = to_int(round(bytes * 100.0 / 1024.0 / 1024.0)) ?? 0
  const whole = cents / 100
  const frac = cents % 100
  const frac_str = if frac < 10 {
    "0${frac}"
  } else {
    "${frac}"
  }
  return "${whole}.${frac_str}"
}

/** Default binary path for a target triple (`.exe` for windows/msvc). */
pub fn default_bin_path(target_dir: string, target: string) -> string {
  const exe_suffix = if target.contains("windows") || target.contains("msvc") {
    ".exe"
  } else {
    ""
  }
  const target_component = if target != "" {
    "${target}/"
  } else {
    ""
  }
  return "${target_dir}/${target_component}release/harn${exe_suffix}"
}

/** The size-report block (printed to stdout and written to binary-size.txt). */
pub fn report_lines(
  harn_bin: string,
  target: string,
  actual_bytes: int,
  fuse_bytes: int,
) -> list<string> {
  return [
    "harn binary size",
    "================",
    "binary: ${harn_bin}",
    "target: ${if target != "" { target } else { "host" }}",
    "bytes: ${actual_bytes}",
    "mib: ${format_mib(actual_bytes)}",
    "distribution_fuse_bytes: ${fuse_bytes}",
    "distribution_fuse_mib: ${format_mib(fuse_bytes)}",
  ]
}

/** Env var value or `fallback` when unset/empty. */
fn binary_size_env_or(env: HarnessEnv, name: string, fallback: string) -> string {
  const v = env.get(name)
  if v == nil || v == "" {
    return fallback
  }
  return v
}

/** Absolute repo root (the glob search root marker). */
fn repo_root(fs: HarnessFs) -> string {
  for g in fs.glob("Cargo.toml") {
    const idx = g.index_of("/./")
    if idx >= 0 {
      return g.substring(0, idx)
    }
  }
  return "."
}

/** True when `cmd` resolves on PATH (bash `command -v`). */
fn command_exists(process: HarnessProcess, cmd: string) -> bool {
  const res = try {
    process.run({program: "sh", args: ["-c", "command -v ${cmd}"]})
  } catch (err) {
    return false
  }
  return res.success
}

/** The `release: X.Y.Z` line from `rustc -vV`, or "" when rustc is absent. */
fn observed_rustc(process: HarnessProcess) -> string {
  const result = try {
    process.run({program: "rustc", args: ["-vV"]})
  } catch (err) {
    return ""
  }
  if !result.success {
    return ""
  }
  for line in result.stdout.split("\n") {
    const captures = regex_captures("^release:\\s*(\\S+)", line)
    if captures.count > 0 {
      return (captures[0]?.groups ?? [])[0] ?? ""
    }
  }
  return ""
}

/**
 * One `[profile.release]` key from the workspace manifest.
 *
 * The release job exports these as `CARGO_PROFILE_RELEASE_*`, which wins. The
 * manifest is the fallback so a local run observes its real settings rather
 * than reporting a comparability it did not check.
 */
fn cargo_release_profile_value(fs: HarnessFs, root: string, key: string) -> string {
  const text = try {
    fs.read_text(path_join(root, "Cargo.toml"))
  } catch (err) {
    return ""
  }
  const start = text.index_of("[profile.release]")
  if start < 0 {
    return ""
  }
  const rest = text.substring(start + 17)
  const next_section = rest.index_of("\n[")
  const section = if next_section >= 0 {
    rest.substring(0, next_section)
  } else {
    rest
  }
  for line in section.split("\n") {
    const captures = regex_captures("^\\s*" + key + "\\s*=\\s*\"?([A-Za-z0-9_.-]+)\"?", line)
    if captures.count > 0 {
      return (captures[0]?.groups ?? [])[0] ?? ""
    }
  }
  return ""
}

/** What this build actually is, so the baseline delta can mean something. */
fn observed_build_identity(harness: Harness, root: string) -> ReleaseBuildIdentity {
  const codegen_units = binary_size_env_or(
    harness.env,
    "CARGO_PROFILE_RELEASE_CODEGEN_UNITS",
    cargo_release_profile_value(harness.fs, root, "codegen-units"),
  )
  return {
    profile: "release",
    codegen_units: to_int(codegen_units) ?? 0,
    lto: binary_size_env_or(
      harness.env,
      "CARGO_PROFILE_RELEASE_LTO",
      cargo_release_profile_value(harness.fs, root, "lto"),
    ),
    strip: binary_size_env_or(
      harness.env,
      "CARGO_PROFILE_RELEASE_STRIP",
      cargo_release_profile_value(harness.fs, root, "strip"),
    ),
    rustc: observed_rustc(harness.process),
    aot_embedded: binary_size_env_or(harness.env, "HARN_REQUIRE_CLI_AOT", "0") == "1",
  }
}

/** The checked binary's own `size -A -d` table, or [] when `size` is absent. */
fn observed_sections(process: HarnessProcess, harn_bin: string) -> list<ElfSection> {
  const result = try {
    process.run({program: "size", args: ["-A", "-d", harn_bin]})
  } catch (err) {
    return []
  }
  if !result.success {
    return []
  }
  return parse_elf_sections(result.stdout)
}

/** The baseline `size -A -d` table, when one was supplied and can be read. */
fn baseline_sections(fs: HarnessFs, path: string) -> list<ElfSection> {
  if path == "" || !fs.exists(path) {
    return []
  }
  return parse_elf_sections(fs.read_text(path))
}

@complexity(allow)
pipeline main(harness: Harness, task) {
  const defaults = {
    target: binary_size_env_or(harness.env, "HARN_RELEASE_TARGET", ""),
    harn_bin: binary_size_env_or(harness.env, "HARN_BIN", ""),
    fuse_mb: binary_size_env_or(harness.env, "BINARY_SIZE_FUSE_MB", ""),
    fuse_bytes: binary_size_env_or(harness.env, "BINARY_SIZE_FUSE_BYTES", ""),
    report_dir: binary_size_env_or(harness.env, "BINARY_SIZE_REPORT_DIR", ""),
    baseline_sections: binary_size_env_or(harness.env, "BINARY_SIZE_BASELINE_SECTIONS", ""),
  }
  const parsed = parse_args(argv, defaults)
  if !parsed.ok {
    harness.stdio.eprintln(parsed.message)
    if parsed.show_usage {
      harness.stdio.eprintln(usage_text())
    }
    return 2
  }
  const opts = parsed.opts
  if opts.help {
    harness.stdio.println(usage_text())
    return 0
  }
  const repo = repo_root(harness.fs)
  const policy_path = path_join(repo, RELEASE_BINARY_SIZE_POLICY_PATH)
  const policy_result = read_release_binary_size_policy_result(harness.fs, policy_path)
  if !is_ok(policy_result) {
    harness.stdio.eprintln(
      "error: invalid release binary-size policy: " + json_stringify(unwrap_err(policy_result)),
    )
    return 2
  }
  const policy = unwrap(policy_result)
  const policy_errors = release_binary_size_policy_errors(policy)
  if policy_errors.count > 0 {
    harness.stdio.eprintln("error: invalid release binary-size policy: " + policy_errors.join("; "))
    return 2
  }
  const fuse_result = resolve_distribution_fuse_bytes(
    policy,
    opts.target,
    {fuse_mb: opts.fuse_mb, fuse_mb_explicit: opts.fuse_mb_explicit, fuse_bytes: opts.fuse_bytes},
  )
  if !is_ok(fuse_result) {
    harness.stdio.eprintln("error: " + unwrap_err(fuse_result))
    return 2
  }
  const fuse_bytes = unwrap(fuse_result)
  const cargo_target_dir = binary_size_env_or(harness.env, "CARGO_TARGET_DIR", "")
  const target_dir = if cargo_target_dir != "" {
    cargo_target_dir
  } else {
    "${repo}/target"
  }
  const target: string = opts.target
  let target_args: list<string> = []
  if target != "" {
    target_args = ["--target", target]
  }
  let harn_bin: string = opts.harn_bin
  if harn_bin == "" {
    harn_bin = default_bin_path(target_dir, target)
  }
  let report_dir: string = opts.report_dir
  if report_dir == "" {
    report_dir = "${target_dir}/binary-size/${if target != "" { target } else { "host" }}"
  }
  if opts.build_release {
    const strip = binary_size_env_or(harness.env, "CARGO_PROFILE_RELEASE_STRIP", "symbols")
    const build = harness.process.run(
      {
        program: "cargo",
        args: ["build", "--release", "-p", "harn-cli", "--bin", "harn"] + target_args,
        env: {CARGO_PROFILE_RELEASE_STRIP: strip},
      },
    )
    harness.stdio.print(build.stdout)
    harness.stdio.eprint(build.stderr)
    if !build.success {
      return build.exit_code
    }
  }
  if !harness.fs.exists(harn_bin) {
    harness.stdio.eprintln("error: harn binary not found at ${harn_bin}")
    return 1
  }
  const actual_bytes: int = harness.fs.stat(harn_bin).size
  const size_report = "${report_dir}/binary-size.txt"
  const bloat_report = "${report_dir}/cargo-bloat-crates.txt"
  harness.fs.mkdir(report_dir)
  let lines = report_lines(harn_bin, target, actual_bytes, fuse_bytes)
  let size_ok = true
  const policy_target_name = if target != "" {
    target
  } else {
    policy.default_target
  }
  const entry = release_binary_size_target_policy(policy, policy_target_name)
  if entry == nil {
    // Only reachable through an explicit override naming a target the policy
    // does not carry. The fuse still applies; there is no baseline to compare
    // against, and inventing one would be worse than saying so.
    lines = lines + ["growth: no-policy-entry"]
    if actual_bytes > fuse_bytes {
      size_ok = false
      harness.stdio.eprintln(
        "error: harn binary is ${format_mib(actual_bytes)} MiB, above the ${format_mib(fuse_bytes)} MiB distribution fuse",
      )
    }
  } else {
    const measurement = {
      target: policy_target_name,
      source_sha: binary_size_env_or(harness.env, "BINARY_SIZE_SOURCE_SHA", "the measured build"),
      bytes: actual_bytes,
      build_identity: observed_build_identity(harness, repo),
    }
    // The override, when one was given, moves the fuse the verdict applies.
    const effective = entry + {distribution_fuse_bytes: fuse_bytes}
    const verdict = evaluate_release_binary_size(effective, measurement)
    lines = lines + verdict_report_lines(verdict, effective, measurement)
    const before = baseline_sections(harness.fs, opts.baseline_sections)
    if before.count > 0 {
      lines = lines
        + section_report_lines(
          elf_section_deltas(before, observed_sections(harness.process, harn_bin)),
        )
    }
    for failure in verdict.failures {
      size_ok = false
      harness.stdio.eprintln("error: ${failure}")
    }
  }
  const report = lines.join("\n") + "\n"
  harness.stdio.print(report)
  harness.fs.write_text(size_report, report)
  if opts.emit_bloat {
    if !command_exists(harness.process, "cargo-bloat") {
      harness.stdio.eprintln("error: cargo-bloat is required to produce ${bloat_report}")
      return 2
    }
    /* `cargo bloat` performs its own analysis build and can relink the
     * target binary with different metadata. Preserve the exact stripped
     * binary whose size we checked so the script is safe to run before a
     * packaging step. The scratch dir lives in the workspace (the runtime
     * sandbox only permits writes inside the workspace root). */
    const mk = harness.process.run({program: "mktemp", args: ["-d", "harn-binary-size.XXXXXX"]})
    if !mk.success {
      harness.stdio.eprintln("error: could not create temp directory")
      return 1
    }
    const restore_dir = mk.stdout.trim()
    const checked_binary = "${restore_dir}/harn"
    harness.process.run({program: "cp", args: ["-p", harn_bin, checked_binary]})
    defer {
      if harness.fs.exists(checked_binary) {
        harness.process.run({program: "cp", args: ["-p", checked_binary, harn_bin]})
      }
      harness.process.run({program: "rm", args: ["-rf", restore_dir]})
    }
    let bloat_args = ["bloat", "--release", "--crates", "-p", "harn-cli", "--bin", "harn"]
      + target_args
    if cargo_target_dir != "" {
      bloat_args = bloat_args + ["--target-dir", cargo_target_dir]
    }
    bloat_args = bloat_args + ["-n", "40"]
    const bloat = harness.process.run({program: "cargo", args: bloat_args})
    harness.stdio.eprint(bloat.stderr)
    if !bloat.success {
      return bloat.exit_code
    }
    harness.fs.write_text(bloat_report, bloat.stdout)
    const tail = "\ncargo-bloat report: ${bloat_report}\n"
    harness.stdio.print(tail)
    harness.fs.write_text(size_report, report + tail)
  } else {
    const tail = "\ncargo-bloat report: skipped\n"
    harness.stdio.print(tail)
    harness.fs.write_text(size_report, report + tail)
  }
  if !size_ok {
    return 1
  }
  return 0
}
