/**
 * Latency-floor smoke test for the Cerebras provider.
 *
 * Issues `iterations` single-tool-call binder-style llm_call invocations
 * against `cerebras/gpt-oss-120b`, then reports p50, p99, and mean
 * wall-clock round-trip in milliseconds. Keep the output tiny so the
 * result reflects the provider + network floor before a binder prompt
 * adds work.
 *
 * Run with `CEREBRAS_API_KEY` exported (e.g. via burin-code/.env):
 *
 *   set -a && source ~/projects/burin-code/.env && set +a
 *   cargo run --quiet --bin harn -- run scripts/smoke_cerebras.harn
 */
pipeline default(args) {
  let model = "cerebras/gpt-oss-120b"
  let iterations = 20
  // First call eats DNS/TLS/connection setup; drop it from the
  // percentile so reported numbers reflect steady-state.
  let warmup = 1
  let prompt = "Reply with only the word ok."
  var samples = []
  for i in range(iterations) {
    let start = monotonic_ms()
    let r = llm_call(
      prompt,
      nil,
      {provider: "cerebras", model: model, max_tokens: 8, temperature: 0.0, stream: false},
    )
    let elapsed = monotonic_ms() - start
    samples = samples + [elapsed]
    log("[${i + 1}/${iterations}] ${elapsed}ms — ${r.text}")
  }
  let measured = samples[warmup:iterations]
  let measured_count = iterations - warmup
  let sorted = measured.sort_by({ ms -> ms })
  let p50_index = measured_count / 2
  let p99_index = measured_count - 1
  let p50 = sorted[p50_index]
  let p99 = sorted[p99_index]
  let mean = sorted.reduce(0, { acc, ms -> acc + ms }) / measured_count
  log("")
  log("Cerebras latency baseline — model=${model} iterations=${iterations} warmup=${warmup}")
  log("  p50  : ${p50}ms")
  log("  p99  : ${p99}ms")
  log("  mean : ${mean}ms")
}
