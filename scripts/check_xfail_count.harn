// CI ratchet: fail if the number of `@xfail:` markers across the
// conformance suite exceeds the threshold checked into
// scripts/xfail_threshold.txt. Catches "fix one, regress one" drift
// without forcing a clean-up sprint every time a flake is muted.
/** Count occurrences of `needle` in `haystack`. */
pub fn count_substring(haystack: string, needle: string) -> int {
  if needle == "" {
    return 0
  }
  return haystack.split(needle).count - 1
}

/**
 * Sum `@xfail:` occurrences across every `.harn` file under `root`.
 * Only `.harn` files are counted: the marker is only meaningful inside
 * conformance test source, and docs/fixtures may legitimately reference
 * the literal `@xfail:` string when describing the convention.
 */
pub fn count_xfail_markers(root: string) -> int {
  const entries = harness.fs.walk(root)
  let total = 0
  for entry in entries {
    if entry.is_file && entry.path.ends_with(".harn") {
      const text = try {
        harness.fs.read_text(entry.path)
      } catch (_) {
        ""
      }
      total = total + count_substring(text, "@xfail:")
    }
  }
  return total
}

pipeline main(task) {
  const threshold_file = "scripts/xfail_threshold.txt"
  if !harness.fs.exists(threshold_file) {
    __io_eprintln("missing ${threshold_file}")
    return 1
  }
  const raw = harness.fs.read_text(threshold_file).trim()
  const threshold = to_int(raw)
  if threshold == nil || threshold < 0 {
    __io_eprintln("${threshold_file} must contain a non-negative integer")
    return 1
  }
  const count = count_xfail_markers("conformance")
  if count > threshold {
    __io_eprintln("::error::xfail count went up: ${count} > ${threshold}")
    return 1
  }
  __io_println("xfail regression ratchet OK (${count} <= ${threshold})")
}
