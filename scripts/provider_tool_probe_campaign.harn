import { CliParseResult, help_requested, parse, parser } from "std/cli/argparse"

const SCHEMA_VERSION = "harn.provider_tool_probe_campaign.v8"

const RUNTIME_RECEIPT_SCHEMA = "harn.provider_tool_probe_runtime.v1"

const CATALOG_RECEIPT_SCHEMA = "harn.provider_tool_probe_catalog.v1"

const DEFAULT_OUTPUT_DIR = ".harn-runs/provider-tool-probe-campaign"

pub type ProviderToolProbeRoute = {
  id: string,
  provider: string,
  model: string,
  env_keys: list<string>,
  local: bool,
  cheap: bool,
  metadata: dict,
}

pub type ProviderToolProbeBehavior = {
  id: string,
  category: string,
  description: string,
  runner: string,
  probe_case?: string,
  modes: list<string>,
  tool_formats: list<string>,
  cheap: bool,
}

pub type ProviderToolProbeRuntimeStatus = "verified" | "unavailable" | "invalid"

pub type ProviderToolProbeRuntimeReceipt = {
  schema_version: "harn.provider_tool_probe_runtime.v1",
  command: list<string>,
  status: ProviderToolProbeRuntimeStatus,
  exit_code: int,
  version: string,
  reason: string,
}

pub type ProviderToolProbeCatalogStatus = "verified" | "unavailable" | "invalid"

pub type ProviderToolProbeCatalogReceipt = {
  schema_version: "harn.provider_tool_probe_catalog.v1",
  command: list<string>,
  command_env: dict,
  status: ProviderToolProbeCatalogStatus,
  exit_code: int,
  providers_config: string,
  catalog_sha256: string,
  provider_count: int,
  model_count: int,
  route_count: int,
  reason: string,
}

pub type ProviderToolProbeCell = {
  id: string,
  provider: string,
  model: string,
  route_id: string,
  behavior: string,
  category: string,
  mode: string,
  tool_format: string,
  runner: string,
  status: string,
  reason: string,
  command?: list<string>,
  artifact_path?: string,
  observed: dict,
  catalog: dict,
}

pub type ProviderToolProbeCampaignReport = {
  schema_version: "harn.provider_tool_probe_campaign.v8",
  runtime: ProviderToolProbeRuntimeReceipt,
  catalog: ProviderToolProbeCatalogReceipt,
  live: bool,
  include_expensive: bool,
  route_count: int,
  behavior_count: int,
  cell_count: int,
  summary: dict,
  runner_summary: dict,
  executable_gap: dict,
  auth_readiness: dict,
  spend: dict,
  campaign_slice: dict,
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  cells: list<ProviderToolProbeCell>,
  artifacts: dict,
}

pub fn provider_tool_probe_campaign_providers_config(
  explicit: string,
  configured: string,
  inherited: string,
) -> string {
  const requested = trim(explicit)
  if requested != "" {
    return requested
  }
  const campaign_config = trim(configured)
  if campaign_config != "" {
    return campaign_config
  }
  return trim(inherited)
}

pub fn provider_tool_probe_campaign_command_env(providers_config: string) -> dict {
  const path = trim(providers_config)
  if path == "" {
    return {}
  }
  return {HARN_PROVIDERS_CONFIG: path}
}

fn __catalog_receipt(
  command: list<string>,
  command_env: dict,
  status: ProviderToolProbeCatalogStatus,
  exit_code: int,
  providers_config: string,
  catalog_sha256: string,
  provider_count: int,
  model_count: int,
  route_count: int,
  reason: string,
) -> ProviderToolProbeCatalogReceipt {
  return {
    schema_version: CATALOG_RECEIPT_SCHEMA,
    command: command,
    command_env: command_env,
    status: status,
    exit_code: exit_code,
    providers_config: providers_config,
    catalog_sha256: catalog_sha256,
    provider_count: provider_count,
    model_count: model_count,
    route_count: route_count,
    reason: reason,
  }
}

/** Normalize `provider catalog show` from the exact CLI used by probe children. */
pub fn provider_tool_probe_campaign_catalog_snapshot(
  harn_bin: string,
  providers_config: string,
  child: dict,
) -> dict {
  const command = [harn_bin, "provider", "catalog", "show"]
  const command_env = provider_tool_probe_campaign_command_env(providers_config)
  const exit_code = to_int(child?.exit_code) ?? -1
  if exit_code != 0 {
    const stderr = trim(to_string(child?.stderr ?? ""))
    return {
      receipt: __catalog_receipt(
        command,
        command_env,
        "unavailable",
        exit_code,
        trim(providers_config),
        "",
        0,
        0,
        0,
        if stderr != "" {
          stderr
        } else {
          "target Harn catalog command exited unsuccessfully"
        },
      ),
      catalog: {},
    }
  }
  const parsed = try {
    json_parse(to_string(child?.stdout ?? ""))
  } catch (_) {
    nil
  }
  if type_of(parsed) != "dict" || type_of(parsed?.providers) != "list"
    || type_of(parsed?.models)
    != "list"
    || type_of(parsed?.routing_routes) != "list" {
    return {
      receipt: __catalog_receipt(
        command,
        command_env,
        "invalid",
        exit_code,
        trim(providers_config),
        "",
        0,
        0,
        0,
        "target Harn runtime produced invalid provider catalog JSON",
      ),
      catalog: {},
    }
  }
  const canonical = json_stringify(parsed)
  return {
    receipt: __catalog_receipt(
      command,
      command_env,
      "verified",
      exit_code,
      trim(providers_config),
      "sha256:" + sha256(canonical),
      len(parsed.providers),
      len(parsed.models),
      len(parsed.routing_routes),
      "target Harn provider catalog identified",
    ),
    catalog: parsed,
  }
}

/** Normalize the target CLI's `version --json` result into campaign provenance. */
pub fn provider_tool_probe_campaign_runtime_receipt(
  harn_bin: string,
  child: dict,
) -> ProviderToolProbeRuntimeReceipt {
  const command = [harn_bin, "version", "--json"]
  const exit_code = to_int(child?.exit_code) ?? -1
  if exit_code != 0 {
    const stderr = trim(to_string(child?.stderr ?? ""))
    return {
      schema_version: RUNTIME_RECEIPT_SCHEMA,
      command: command,
      status: "unavailable",
      exit_code: exit_code,
      version: "",
      reason: if stderr != "" {
        stderr
      } else {
        "target Harn runtime exited unsuccessfully"
      },
    }
  }
  const parsed = try {
    json_parse(to_string(child?.stdout ?? ""))
  } catch (_) {
    nil
  }
  if type_of(parsed) != "dict" {
    return {
      schema_version: RUNTIME_RECEIPT_SCHEMA,
      command: command,
      status: "invalid",
      exit_code: exit_code,
      version: "",
      reason: "target Harn runtime produced invalid version JSON",
    }
  }
  const name = trim(to_string(parsed?.data?.name ?? ""))
  const version = trim(to_string(parsed?.data?.version ?? ""))
  if parsed?.schemaVersion != 1 || parsed?.ok != true || name != "harn-cli" || version == "" {
    return {
      schema_version: RUNTIME_RECEIPT_SCHEMA,
      command: command,
      status: "invalid",
      exit_code: exit_code,
      version: "",
      reason: "target Harn runtime version JSON did not match the harn-cli contract",
    }
  }
  return {
    schema_version: RUNTIME_RECEIPT_SCHEMA,
    command: command,
    status: "verified",
    exit_code: exit_code,
    version: version,
    reason: "target Harn runtime identified",
  }
}

pub fn provider_tool_probe_campaign_runtime_allows_live(
  runtime: ProviderToolProbeRuntimeReceipt,
) -> bool {
  return runtime.status == "verified" && runtime.version != ""
}

fn __provider_tool_probe_campaign_runtime(
  harness: Harness,
  harn_bin: string,
) -> ProviderToolProbeRuntimeReceipt {
  const child = try {
    harness.process.spawn_captured({cmd: harn_bin, args: ["version", "--json"]})
  } catch (e) {
    {exit_code: -1, stdout: "", stderr: to_string(e)}
  }
  return provider_tool_probe_campaign_runtime_receipt(harn_bin, child)
}

pub fn provider_tool_probe_campaign_providers_config_text_error(text: string) -> string? {
  const parsed = try {
    toml_parse(text)
  } catch (error) {
    return "providers config is invalid TOML: " + to_string(error)
  }
  if type_of(parsed) != "dict" {
    return "providers config must decode to a TOML document"
  }
  return nil
}

fn __providers_config_error(harness: Harness, path: string) -> string? {
  if path == "" {
    return nil
  }
  if !harness.fs.exists(path) {
    return "providers config does not exist: " + path
  }
  const text = try {
    harness.fs.read_text(path)
  } catch (error) {
    return "providers config is unreadable: " + path + ": " + to_string(error)
  }
  return provider_tool_probe_campaign_providers_config_text_error(text)
}

fn __provider_tool_probe_campaign_catalog(
  harness: Harness,
  harn_bin: string,
  providers_config: string,
) -> dict {
  const command = ["provider", "catalog", "show"]
  const child = try {
    harness.process.spawn_captured(
      {
        cmd: harn_bin,
        args: command,
        env: provider_tool_probe_campaign_command_env(providers_config),
      },
    )
  } catch (error) {
    {exit_code: -1, stdout: "", stderr: to_string(error)}
  }
  return provider_tool_probe_campaign_catalog_snapshot(harn_bin, providers_config, child)
}

fn __split_once(text: string, sep: string) -> dict? {
  const parts = split(text, sep)
  if len(parts) < 2 {
    return nil
  }
  return {left: parts[0], right: join(parts[1:len(parts)], sep)}
}

fn __slug(text: string) -> string {
  return replace(replace(replace(replace(text, "/", "-"), ":", "-"), ".", "-"), "_", "-")
}

fn __route_from_spec(spec: string) -> ProviderToolProbeRoute? {
  const pair = __split_once(trim(spec), ":")
  if pair == nil {
    return nil
  }
  const provider = trim(pair.left)
  const model = trim(pair.right)
  if provider == "" || model == "" {
    return nil
  }
  return {
    id: __slug(provider + "-" + model),
    provider: provider,
    model: model,
    env_keys: [],
    local: false,
    cheap: true,
    metadata: {source: "explicit"},
  }
}

pub fn provider_tool_probe_campaign_routes(specs: list<string>) -> list<ProviderToolProbeRoute> {
  let routes: list<ProviderToolProbeRoute> = []
  for spec in specs {
    const route = __route_from_spec(spec)
    if route != nil {
      routes = routes + [route]
    }
  }
  return routes
}

