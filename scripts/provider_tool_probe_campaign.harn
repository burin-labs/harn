fn __behavior_matches(behavior: ProviderToolProbeBehavior, filters: list<string>) -> bool {
  if len(filters) == 0 {
    return true
  }
  for raw in filters {
    const filter = trim(raw)
    if filter == "" {
      continue
    }
    if filter == behavior.id || filter == behavior.category || filter == behavior.runner {
      return true
    }
  }
  return false
}

pub fn provider_tool_probe_campaign_select_behaviors(
  filters: list<string>,
) -> list<ProviderToolProbeBehavior> {
  let selected: list<ProviderToolProbeBehavior> = []
  for behavior in provider_tool_probe_campaign_behaviors() {
    if __behavior_matches(behavior, filters) {
      selected = selected + [behavior]
    }
  }
  return selected
}

fn __mode_allowed(mode: string, allowed: list<string>) -> bool {
  for item in allowed {
    if item == mode {
      return true
    }
  }
  return false
}

pub fn provider_tool_probe_campaign_filter_behavior_modes(
  behaviors: list<ProviderToolProbeBehavior>,
  mode: string,
) -> list<ProviderToolProbeBehavior> {
  if mode == "both" {
    return behaviors
  }
  let selected: list<ProviderToolProbeBehavior> = []
  for behavior in behaviors {
    if __mode_allowed(mode, behavior.modes) {
      selected = selected + [behavior + {modes: [mode]}]
    }
  }
  return selected
}

fn __provider_catalog_claim(route: ProviderToolProbeRoute) -> dict {
  const caps = provider_capabilities(route.provider, route.model)
  return {
    tools: caps?.tools,
    native_tools: caps?.native_tools,
    text_tool_wire_format_supported: caps?.text_tool_wire_format_supported,
    preferred_tool_format: caps?.preferred_tool_format,
    tool_mode_parity: caps?.tool_mode_parity,
    message_wire_format: caps?.message_wire_format,
    native_tool_wire_format: caps?.native_tool_wire_format,
    requires_tool_result_adjacency: caps?.requires_tool_result_adjacency,
    stop_supported: caps?.stop_supported,
    presence_penalty_supported: caps?.presence_penalty_supported,
    frequency_penalty_supported: caps?.frequency_penalty_supported,
    temperature_supported: caps?.temperature_supported,
    top_p_supported: caps?.top_p_supported,
  }
}

fn __tool_probe_command(
  harn_bin: string,
  route: ProviderToolProbeRoute,
  mode: string,
  probe_case: string,
  repeat: int,
  timeout_secs: int,
) -> list<string> {
  return [
    harn_bin,
    "provider",
    "tool-probe",
    route.provider,
    "--model",
    route.model,
    "--mode",
    mode,
    "--case",
    probe_case,
    "--repeat",
    to_string(repeat),
    "--timeout-secs",
    to_string(timeout_secs),
    "--json",
  ]
}

fn __cell_id(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  format: string,
) -> string {
  return route.id + "/" + behavior.id + "/" + mode + "/" + format
}

fn __base_cell(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  format: string,
  status: string,
  reason: string,
  observed: dict,
) -> ProviderToolProbeCell {
  return {
    id: __cell_id(route, behavior, mode, format),
    provider: route.provider,
    model: route.model,
    route_id: route.id,
    behavior: behavior.id,
    category: behavior.category,
    mode: mode,
    tool_format: format,
    runner: behavior.runner,
    status: status,
    reason: reason,
    observed: observed,
    catalog: __provider_catalog_claim(route) + {route_metadata: route.metadata},
  }
}

fn __planned_cell(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  format: string,
  harn_bin: string,
  repeat: int,
  timeout_secs: int,
) -> ProviderToolProbeCell {
  const cell = __base_cell(
    route,
    behavior,
    mode,
    format,
    "planned",
    if behavior.runner == "provider_tool_probe" {
      "dry run; pass --live to execute harn provider tool-probe for the executable transport cells"
    } else {
      "behavior case is declared in the campaign matrix but does not yet have an executable runner"
    },
    {},
  )
  if behavior.runner == "provider_tool_probe" {
    return cell
      + {
      command: __tool_probe_command(
        harn_bin,
        route,
        mode,
        to_string(behavior.probe_case ?? "single_tool_call"),
        repeat,
        timeout_secs,
      ),
    }
  }
  return cell
}

pub fn provider_tool_probe_campaign_planned_cells(
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
) -> list<ProviderToolProbeCell> {
  return provider_tool_probe_campaign_planned_cells_with_options(routes, behaviors, "harn", 1, 60)
}

pub fn provider_tool_probe_campaign_planned_cells_with_options(
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  harn_bin: string,
  repeat: int,
  timeout_secs: int,
) -> list<ProviderToolProbeCell> {
  return provider_tool_probe_campaign_planned_cells_sliced_with_options(
    routes,
    behaviors,
    harn_bin,
    repeat,
    timeout_secs,
    1,
    0,
    0,
  ).cells
}

pub fn provider_tool_probe_campaign_planned_cells_sliced_with_options(
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  harn_bin: string,
  repeat: int,
  timeout_secs: int,
  shard_count: int,
  shard_index: int,
  max_probes: int,
) -> dict {
  let cells: list<ProviderToolProbeCell> = []
  let probe_units_total = 0
  let probe_units_selected = 0
  let probe_units_excluded_by_shard = 0
  let probe_units_excluded_by_cap = 0
  let executable_units_selected = 0
  for route in routes {
    for behavior in behaviors {
      for mode in behavior.modes {
        const ordinal = probe_units_total
        probe_units_total = probe_units_total + 1
        if !__campaign_slice_selects_unit(ordinal, shard_count, shard_index) {
          probe_units_excluded_by_shard = probe_units_excluded_by_shard + 1
          continue
        }
        if behavior.runner == "provider_tool_probe" && max_probes > 0
          && executable_units_selected
          >= max_probes {
          probe_units_excluded_by_cap = probe_units_excluded_by_cap + 1
          continue
        }
        probe_units_selected = probe_units_selected + 1
        if behavior.runner == "provider_tool_probe" {
          executable_units_selected = executable_units_selected + 1
        }
        for format in behavior.tool_formats {
          cells = cells
            + [
            __planned_cell(route, behavior, mode, format, harn_bin, repeat, timeout_secs),
          ]
        }
      }
    }
  }
  return {
    cells: cells,
    slice: __campaign_slice_receipt(
      shard_count,
      shard_index,
      max_probes,
      probe_units_total,
      probe_units_selected,
      executable_units_selected,
      probe_units_excluded_by_shard,
      probe_units_excluded_by_cap,
    ),
  }
}

fn __safe_status(value) -> string {
  if type_of(value) == "string" {
    return value
  }
  return "unknown"
}

fn __status_from_probe(value) -> string {
  const status = __safe_status(value)
  if status == "pass" {
    return "pass"
  }
  if status == "fail" {
    return "fail"
  }
  return "skip"
}

fn __probe_status_for_format(report: dict, mode: string, format: string) -> string {
  const tool_calling = report?.tool_calling ?? {}
  if format == "native" && mode == "streaming" {
    return __safe_status(tool_calling?.streaming_native)
  }
  if format == "native" {
    return __safe_status(tool_calling?.native)
  }
  if format == "json" && mode == "non-streaming" {
    return __safe_status(tool_calling?.text)
  }
  return "unknown"
}

fn __probe_cell(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  format: string,
  report: dict,
  artifact_path: string,
  command: list<string>,
) -> ProviderToolProbeCell {
  const status_value = __probe_status_for_format(report, mode, format)
  const status = __status_from_probe(status_value)
  const reason = if format == "text/tagged" {
    "legacy tagged text runner is declared but not yet separated from the current JSON text-channel probe"
  } else if format == "json" && mode == "streaming" {
    "provider tool-probe does not currently produce a streaming JSON text-channel verdict"
  } else if status == "pass" {
    "provider tool-probe reported pass at the Harn parse/dispatch boundary"
  } else if status == "fail" {
    report?.tool_calling?.failure_reason ?? "provider tool-probe reported fail"
  } else {
    "provider tool-probe did not produce a verdict for this format/mode"
  }
  return __base_cell(
    route,
    behavior,
    mode,
    format,
    if format == "text/tagged" || (format == "json" && mode == "streaming") {
      "planned"
    } else {
      status
    },
    reason,
    {
      tool_calling: report?.tool_calling ?? {},
      case_count: len(report?.cases ?? []),
      schema_version: report?.schema_version,
    },
  )
    + {artifact_path: artifact_path, command: command}
}

fn __missing_env_keys(route: ProviderToolProbeRoute, env: dict) -> list<string> {
  if len(route.env_keys) == 0 {
    return []
  }
  for key in route.env_keys {
    if trim(to_string(env[key] ?? "")) != "" {
      return []
    }
  }
  return route.env_keys
}

pub fn provider_tool_probe_campaign_missing_env_keys(
  route: ProviderToolProbeRoute,
  env: dict,
) -> list<string> {
  return __missing_env_keys(route, env)
}

fn __merge_unique_strings(left: list<string>, right: list<string>) -> list<string> {
  let out = left
  for value in right {
    out = __append_unique_string(out, value)
  }
  return out
}

fn __auth_readiness(routes: list<ProviderToolProbeRoute>, env: dict, env_source: dict) -> dict {
  let ready_routes = 0
  let missing_auth_routes = 0
  let local_routes = 0
  let hosted_routes = 0
  let ready_by_provider: dict = {}
  let missing_by_provider: dict = {}
  let missing_env_candidates_by_provider: dict = {}
  for route in routes {
    if route.local {
      local_routes = local_routes + 1
    } else {
      hosted_routes = hosted_routes + 1
    }
    const missing = __missing_env_keys(route, env)
    if len(missing) == 0 {
      ready_routes = ready_routes + 1
      ready_by_provider = __increment_key(ready_by_provider, route.provider)
    } else {
      missing_auth_routes = missing_auth_routes + 1
      missing_by_provider = __increment_key(missing_by_provider, route.provider)
      missing_env_candidates_by_provider = missing_env_candidates_by_provider
        + {
        [route.provider]: __merge_unique_strings(
          missing_env_candidates_by_provider[route.provider] ?? [],
          missing,
        ),
      }
    }
  }
  return {
    env_checked: env_source.checked ?? false,
    env_source: env_source,
    route_count: len(routes),
    ready_routes: ready_routes,
    missing_auth_routes: missing_auth_routes,
    local_routes: local_routes,
    hosted_routes: hosted_routes,
    ready_by_provider: ready_by_provider,
    missing_by_provider: missing_by_provider,
    missing_env_candidates_by_provider: missing_env_candidates_by_provider,
  }
}

fn __skipped_cells_for_missing_env(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  missing: list<string>,
) -> list<ProviderToolProbeCell> {
  let cells: list<ProviderToolProbeCell> = []
  for format in behavior.tool_formats {
    cells = cells
      + [
      __base_cell(
        route,
        behavior,
        mode,
        format,
        "skip",
        "missing provider environment key; set one of: " + join(missing, ", "),
        {missing_env_keys: missing, any_env_key_satisfies_route: true},
      ),
    ]
  }
  return cells
}

fn __run_tool_probe(
  harness: Harness,
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  harn_bin: string,
  env: dict,
  repeat: int,
  timeout_secs: int,
  output_dir: string,
) -> list<ProviderToolProbeCell> {
  const missing = __missing_env_keys(route, env)
  if len(missing) > 0 {
    return __skipped_cells_for_missing_env(route, behavior, mode, missing)
  }
  const command = __tool_probe_command(
    harn_bin,
    route,
    mode,
    to_string(behavior.probe_case ?? "single_tool_call"),
    repeat,
    timeout_secs,
  )
  const artifact_path = provider_tool_probe_campaign_artifact_path(
    route,
    behavior,
    mode,
    output_dir,
  )
  const child = harness.process.spawn_captured(
    {cmd: harn_bin, args: command[1:len(command)], env: env},
  )
  const stdout = child.stdout ?? ""
  if trim(stdout) != "" {
    harness.fs.write_text(artifact_path, stdout)
  }
  const parsed = try {
    json_parse(stdout)
  } catch (_) {
    nil
  }
  if parsed == nil {
    let cells: list<ProviderToolProbeCell> = []
    for format in behavior.tool_formats {
      cells = cells
        + [
        __base_cell(
          route,
          behavior,
          mode,
          format,
          "error",
          if trim(stdout) == "" {
            trim(child.stderr ?? "provider tool-probe failed before producing JSON")
          } else {
            "provider tool-probe produced non-JSON stdout"
          },
          {exit_code: child.exit_code, stderr: trim(child.stderr ?? "")},
        )
          + {command: command},
      ]
    }
    return cells
  }
  let cells: list<ProviderToolProbeCell> = []
  for format in behavior.tool_formats {
    cells = cells + [__probe_cell(route, behavior, mode, format, parsed, artifact_path, command)]
  }
  return cells
}

pub fn provider_tool_probe_campaign_artifact_path(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  output_dir: string,
) -> string {
  const probe_case = __slug(to_string(behavior.probe_case ?? "single_tool_call"))
  return path_join(
    output_dir,
    "tool-probe-" + route.id + "-" + __slug(behavior.id) + "-" + probe_case + "-" + __slug(mode)
      + ".json",
  )
}

fn __live_cells(
  harness: Harness,
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  harn_bin: string,
  env: dict,
  repeat: int,
  timeout_secs: int,
  output_dir: string,
  shard_count: int,
  shard_index: int,
  max_probes: int,
) -> dict {
  let cells: list<ProviderToolProbeCell> = []
  let probe_units_total = 0
  let probe_units_selected = 0
  let probe_units_excluded_by_shard = 0
  let probe_units_excluded_by_cap = 0
  let executable_units_selected = 0
  for route in routes {
    for behavior in behaviors {
      for mode in behavior.modes {
        const ordinal = probe_units_total
        probe_units_total = probe_units_total + 1
        if !__campaign_slice_selects_unit(ordinal, shard_count, shard_index) {
          probe_units_excluded_by_shard = probe_units_excluded_by_shard + 1
          continue
        }
        const ready_provider_probe = behavior.runner == "provider_tool_probe"
          && len(
          __missing_env_keys(route, env),
        )
          == 0
        if ready_provider_probe && max_probes > 0 && executable_units_selected >= max_probes {
          probe_units_excluded_by_cap = probe_units_excluded_by_cap + 1
          continue
        }
        probe_units_selected = probe_units_selected + 1
        if behavior.runner != "provider_tool_probe" {
          for format in behavior.tool_formats {
            cells = cells
              + [
              __planned_cell(route, behavior, mode, format, harn_bin, repeat, timeout_secs),
            ]
          }
          continue
        }
        if ready_provider_probe {
          executable_units_selected = executable_units_selected + 1
        }
        cells = cells
          + __run_tool_probe(
          harness,
          route,
          behavior,
          mode,
          harn_bin,
          env,
          repeat,
          timeout_secs,
          output_dir,
        )
      }
    }
  }
  return {
    cells: cells,
    slice: __campaign_slice_receipt(
      shard_count,
      shard_index,
      max_probes,
      probe_units_total,
      probe_units_selected,
      executable_units_selected,
      probe_units_excluded_by_shard,
      probe_units_excluded_by_cap,
    ),
  }
}

fn __campaign_slice_selects_unit(ordinal: int, shard_count: int, shard_index: int) -> bool {
  if shard_count <= 1 {
    return true
  }
  return ordinal % shard_count == shard_index
}

fn __campaign_slice_receipt(
  shard_count: int,
  shard_index: int,
  max_probes: int,
  probe_units_total: int,
  probe_units_selected: int,
  executable_units_selected: int,
  probe_units_excluded_by_shard: int,
  probe_units_excluded_by_cap: int,
) -> dict {
  return {
    shard_count: shard_count,
    shard_index: shard_index,
    max_probes: max_probes,
    probe_units_total: probe_units_total,
    probe_units_selected: probe_units_selected,
    executable_units_selected: executable_units_selected,
    probe_units_excluded_by_shard: probe_units_excluded_by_shard,
    probe_units_excluded_by_cap: probe_units_excluded_by_cap,
  }
}

fn __summary(cells: list<ProviderToolProbeCell>) -> dict {
  let summary: dict = {pass: 0, fail: 0, error: 0, skip: 0, planned: 0}
  for cell in cells {
    summary = summary + {[cell.status]: (summary[cell.status] ?? 0) + 1}
  }
  return summary
}

fn __runner_summary(cells: list<ProviderToolProbeCell>) -> dict {
  let summary: dict = {}
  for cell in cells {
    const current = summary[cell.runner]
      ?? {total: 0, pass: 0, fail: 0, error: 0, skip: 0, planned: 0}
    summary = summary
      + {
      [cell.runner]: current
        + {
        total: (current.total ?? 0) + 1,
        [cell.status]: (current[cell.status] ?? 0) + 1,
      },
    }
  }
  return summary
}

fn __increment_key(counts: dict, key: string) -> dict {
  return counts + {[key]: (counts[key] ?? 0) + 1}
}

fn __executable_gap(cells: list<ProviderToolProbeCell>) -> dict {
  let executable_cells = 0
  let executable_commands = 0
  let missing_runner = 0
  let missing_runner_by_behavior: dict = {}
  let executable_cells_by_provider: dict = {}
  let executable_commands_by_provider: dict = {}
  for cell in cells {
    if cell.status != "planned" {
      continue
    }
    if cell.runner == "provider_tool_probe" {
      executable_cells = executable_cells + 1
      executable_cells_by_provider = __increment_key(executable_cells_by_provider, cell.provider)
      if cell.tool_format == "native" {
        executable_commands = executable_commands + 1
        executable_commands_by_provider = __increment_key(
          executable_commands_by_provider,
          cell.provider,
        )
      }
    } else {
      missing_runner = missing_runner + 1
      missing_runner_by_behavior = __increment_key(missing_runner_by_behavior, cell.behavior)
    }
  }
  return {
    executable_cells: executable_cells,
    executable_commands: executable_commands,
    missing_runner: missing_runner,
    missing_runner_by_behavior: missing_runner_by_behavior,
    executable_cells_by_provider: executable_cells_by_provider,
    executable_commands_by_provider: executable_commands_by_provider,
  }
}

fn __estimated_spend(live: bool, cells: list<ProviderToolProbeCell>, repeat: int) -> dict {
  let executable_probe_count = 0
  for cell in cells {
    if cell.runner != "provider_tool_probe" || cell.tool_format != "native" {
      continue
    }
    if !live && cell.status == "planned" {
      executable_probe_count = executable_probe_count + repeat
    } else if live && (cell.status == "pass" || cell.status == "fail" || cell.status == "error") {
      executable_probe_count = executable_probe_count + repeat
    }
  }
  const base = {
    cap_usd: 10.0,
    estimated_usd_known: false,
    actual_usd_known: !live,
    accounting: if live {
      "live campaign spend is unknown until per-probe usage receipts are priced and aggregated"
    } else {
      "dry run; no provider calls"
    },
    executable_probe_count: executable_probe_count,
  }
  if live {
    return base + {unpriced_probe_count: executable_probe_count}
  }
  return base + {estimated_usd: 0.0, actual_usd: 0.0, estimated_usd_known: true}
}

pub fn provider_tool_probe_campaign_report(
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  cells: list<ProviderToolProbeCell>,
  live: bool,
  include_expensive: bool,
  output_dir: string,
  repeat: int,
  env: dict,
  env_source: dict,
  runtime: ProviderToolProbeRuntimeReceipt,
  catalog: ProviderToolProbeCatalogReceipt,
  campaign_slice: dict = {},
) -> ProviderToolProbeCampaignReport {
  return {
    schema_version: SCHEMA_VERSION,
    runtime: runtime,
    catalog: catalog,
    live: live,
    include_expensive: include_expensive,
    route_count: len(routes),
    behavior_count: len(behaviors),
    cell_count: len(cells),
    summary: __summary(cells),
    runner_summary: __runner_summary(cells),
    executable_gap: __executable_gap(cells),
    auth_readiness: __auth_readiness(routes, env, env_source),
    spend: __estimated_spend(live, cells, repeat),
    campaign_slice: campaign_slice,
    routes: routes,
    behaviors: behaviors,
    cells: cells,
    artifacts: {
      report_json: path_join(output_dir, "report.json"),
      report_markdown: path_join(output_dir, "report.md"),
    },
  }
}

fn __markdown_escape(text: string) -> string {
  return replace(text, "|", "\\|")
}

fn __markdown_status(status: string) -> string {
  if status == "pass" {
    return "PASS"
  }
  if status == "fail" {
    return "FAIL"
  }
  if status == "error" {
    return "ERROR"
  }
  if status == "skip" {
    return "SKIP"
  }
  return "PLANNED"
}

pub fn provider_tool_probe_campaign_markdown(report: ProviderToolProbeCampaignReport) -> string {
  let out = "# Provider Tool-Probe Campaign\n\n"
  out = out + "- Schema: `" + report.schema_version + "`\n"
  out = out + "- Target runtime: `" + json_stringify(report.runtime) + "`\n"
  out = out + "- Target catalog: `" + json_stringify(report.catalog) + "`\n"
  out = out + "- Live: " + to_string(report.live) + "\n"
  out = out + "- Include expensive defaults: " + to_string(report.include_expensive) + "\n"
  out = out + "- Routes: " + to_string(report.route_count) + "\n"
  out = out + "- Behaviors: " + to_string(report.behavior_count) + "\n"
  out = out + "- Cells: " + to_string(report.cell_count) + "\n"
  out = out + "- Summary: `" + json_stringify(report.summary) + "`\n"
  out = out + "- Runner summary: `" + json_stringify(report.runner_summary) + "`\n"
  out = out + "- Executable gap: `" + json_stringify(report.executable_gap) + "`\n"
  out = out + "- Auth readiness: `" + json_stringify(report.auth_readiness) + "`\n"
  out = out + "- Campaign slice: `" + json_stringify(report.campaign_slice) + "`\n"
  out = out + "- Spend: `" + json_stringify(report.spend) + "`\n\n"
  out = out + "| Status | Provider | Model | Behavior | Mode | Tool format | Reason |\n"
  out = out + "| --- | --- | --- | --- | --- | --- | --- |\n"
  for cell in report.cells {
    out = out + "| "
      + __markdown_status(cell.status)
      + " | "
      + cell.provider
      + " | `"
      + cell.model
      + "` | "
      + cell.behavior
      + " | "
      + cell.mode
      + " | "
      + cell.tool_format
      + " | "
      + __markdown_escape(cell.reason)
      + " |\n"
  }
  return out
}

fn __as_string_list(value) -> list<string> {
  if value == nil {
    return []
  }
  if type_of(value) == "list" {
    let out: list<string> = []
    for item in value {
      out = out + [to_string(item)]
    }
    return out
  }
  return [to_string(value)]
}

fn __unquote_env_value(value: string) -> string {
  const trimmed = trim(value)
  if len(trimmed) >= 2 && trimmed[0] == "\"" && trimmed[len(trimmed) - 1] == "\"" {
    return trimmed[1:len(trimmed) - 1]
  }
  if len(trimmed) >= 2 && trimmed[0] == "'" && trimmed[len(trimmed) - 1] == "'" {
    return trimmed[1:len(trimmed) - 1]
  }
  return trimmed
}

pub fn provider_tool_probe_campaign_env_from_dotenv_text(text: string) -> dict {
  let env = {}
  for raw_line in split(text, "\n") {
    const line = trim(raw_line)
    if line == "" || starts_with(line, "#") {
      continue
    }
    const clean = if starts_with(line, "export ") {
      trim(line[7:len(line)])
    } else {
      line
    }
    const pair = __split_once(clean, "=")
    if pair == nil {
      continue
    }
    const key = trim(pair.left)
    if key == "" || contains(key, " ") {
      continue
    }
    env = env + {[key]: __unquote_env_value(pair.right)}
  }
  return env
}

fn __env_load_receipt(
  path: string,
  checked: bool,
  loaded: bool,
  key_count: int,
  reason: string,
) -> dict {
  return {path: path, checked: checked, loaded: loaded, parsed_key_count: key_count, reason: reason}
}

fn __load_env_file(harness: Harness, env_file: string) -> dict {
  if env_file == "" {
    return {env: {}, source: __env_load_receipt("", false, false, 0, "no env file requested")}
  }
  if !harness.fs.exists(env_file) {
    return {
      env: {},
      source: __env_load_receipt(
        env_file,
        true,
        false,
        0,
        "env file is not readable in this Harn run; use a worktree-local env snapshot or --no-sandbox for local-only dry-run readiness",
      ),
    }
  }
  const env = provider_tool_probe_campaign_env_from_dotenv_text(harness.fs.read_text(env_file))
  return {env: env, source: __env_load_receipt(env_file, true, true, len(env.keys()), "loaded")}
}

pub fn provider_tool_probe_campaign_env_file(explicit: string, configured: string) -> string {
  const requested = trim(explicit)
  if requested != "" {
    return requested
  }
  return trim(configured)
}

fn __ensure_dir(harness: Harness, path: string) {
  if !harness.fs.exists(path) {
    harness.fs.mkdir(path)
  }
}

fn __arg_spec() {
  return parser(
    {
      name: "provider_tool_probe_campaign",
      args: [
        {kind: "flag", name: "route", long: "--route", multi: true, default: []},
        {kind: "flag", name: "behavior", long: "--behavior", multi: true, default: []},
        {kind: "flag", name: "mode", long: "--mode", default: "both"},
        {kind: "flag", name: "repeat", long: "--repeat", parse: "int", default: 1},
        {kind: "flag", name: "timeout_secs", long: "--timeout-secs", parse: "int", default: 60},
        {kind: "flag", name: "shard_count", long: "--shard-count", parse: "int", default: 1},
        {kind: "flag", name: "shard_index", long: "--shard-index", parse: "int", default: 0},
        {kind: "flag", name: "max_probes", long: "--max-probes", parse: "int", default: 0},
        {kind: "flag", name: "harn_bin", long: "--harn-bin", default: "harn"},
        {kind: "flag", name: "providers_config", long: "--providers-config", default: ""},
        {kind: "flag", name: "env_file", long: "--env-file", default: ""},
        {kind: "flag", name: "output_dir", long: "--output-dir", default: DEFAULT_OUTPUT_DIR},
        {kind: "switch", name: "include_expensive", long: "--include-expensive"},
        {kind: "switch", name: "catalog_routes", long: "--catalog-routes"},
        {kind: "switch", name: "live", long: "--live"},
        {kind: "switch", name: "markdown", long: "--markdown"},
      ],
    },
  )
}

pub fn provider_tool_probe_campaign_parse_args(args: list<string>) -> CliParseResult<dict> {
  return parse(__arg_spec(), args)
}

fn __target_runtime_context(
  harness: Harness,
  parsed: dict,
  live: bool,
  catalog_routes: bool,
) -> dict {
  const harn_bin = to_string(parsed?.harn_bin ?? "harn")
  const providers_config = provider_tool_probe_campaign_providers_config(
    to_string(parsed?.providers_config ?? ""),
    harness.env.get_or("HARN_PROVIDER_TOOL_PROBE_PROVIDERS_CONFIG", ""),
    harness.env.get_or("HARN_PROVIDERS_CONFIG", ""),
  )
  const providers_config_error = __providers_config_error(harness, providers_config)
  if providers_config_error != nil {
    harness.stdio.eprintln(providers_config_error)
    exit(2)
  }
  const runtime: ProviderToolProbeRuntimeReceipt = __provider_tool_probe_campaign_runtime(
    harness,
    harn_bin,
  )
  if live && !provider_tool_probe_campaign_runtime_allows_live(runtime) {
    harness.stdio.eprintln(
      "target Harn runtime is not identifiable; refusing live provider probes: " + runtime.reason,
    )
    exit(2)
  }
  const catalog_snapshot = __provider_tool_probe_campaign_catalog(
    harness,
    harn_bin,
    providers_config,
  )
  const catalog: ProviderToolProbeCatalogReceipt = catalog_snapshot.receipt
  if catalog.status != "verified" && (live || catalog_routes || providers_config != "") {
    harness.stdio.eprintln(
      "target Harn provider catalog is not identifiable; refusing catalog-bound probes: "
        + catalog
        .reason,
    )
    exit(2)
  }
  return {
    harn_bin: harn_bin,
    providers_config: providers_config,
    runtime: runtime,
    catalog: catalog,
    catalog_payload: catalog_snapshot.catalog,
  }
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/provider_tool_probe_campaign.harn -- [--route provider:model | --catalog-routes] [--providers-config PATH] [--behavior ID|CATEGORY|RUNNER] [--mode both|non-streaming|streaming] [--shard-count N --shard-index I] [--max-probes N] [--include-expensive] [--live] [--markdown]",
    )
    return nil
  }
  const parsed_result = provider_tool_probe_campaign_parse_args(argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    exit(2)
  }
  const parsed = unwrap(parsed_result).options
  const include_expensive = parsed?.include_expensive ?? false
  const catalog_routes = parsed?.catalog_routes ?? false
  const route_specs = __as_string_list(parsed?.route)
  if catalog_routes && len(route_specs) > 0 {
    harness.stdio.eprintln("--catalog-routes cannot be combined with --route")
    exit(2)
  }
  const requested_mode = to_string(parsed?.mode ?? "both")
  if len(provider_tool_probe_campaign_modes(requested_mode)) == 0 {
    harness.stdio.eprintln("--mode must be one of: both, non-streaming, streaming")
    exit(2)
  }
  const behaviors = provider_tool_probe_campaign_filter_behavior_modes(
    provider_tool_probe_campaign_select_behaviors(__as_string_list(parsed?.behavior)),
    requested_mode,
  )
  if len(behaviors) == 0 {
    harness.stdio.eprintln("no provider behaviors selected")
    exit(2)
  }
  const live = parsed?.live ?? false
  const repeat = parsed?.repeat ?? 1
  const timeout_secs = parsed?.timeout_secs ?? 60
  const shard_count = parsed?.shard_count ?? 1
  const shard_index = parsed?.shard_index ?? 0
  const max_probes = parsed?.max_probes ?? 0
  if shard_count <= 0 {
    harness.stdio.eprintln("--shard-count must be >= 1")
    exit(2)
  }
  if shard_index < 0 || shard_index >= shard_count {
    harness.stdio.eprintln("--shard-index must be >= 0 and < --shard-count")
    exit(2)
  }
  if max_probes < 0 {
    harness.stdio.eprintln("--max-probes must be >= 0")
    exit(2)
  }
  const target = __target_runtime_context(harness, parsed, live, catalog_routes)
  const harn_bin = target.harn_bin
  const providers_config = target.providers_config
  const runtime = target.runtime
  const catalog_receipt = target.catalog
  const routes = if catalog_routes {
    provider_tool_probe_campaign_catalog_routes(target.catalog_payload, include_expensive)
  } else if len(route_specs) == 0 {
    provider_tool_probe_campaign_default_routes(include_expensive)
  } else {
    provider_tool_probe_campaign_routes(route_specs)
  }
  if len(routes) == 0 {
    harness.stdio.eprintln("no provider routes selected")
    exit(2)
  }
  const output_dir = to_string(parsed?.output_dir ?? DEFAULT_OUTPUT_DIR)
  __ensure_dir(harness, ".harn-runs")
  __ensure_dir(harness, output_dir)
  const env_file_arg = trim(to_string(parsed?.env_file ?? ""))
  const env_file_path = provider_tool_probe_campaign_env_file(
    env_file_arg,
    harness.env.get_or("HARN_PROVIDER_TOOL_PROBE_ENV_FILE", ""),
  )
  const env_load = __load_env_file(harness, env_file_path)
  const auth_env = env_load.env ?? {}
  const command_env = provider_tool_probe_campaign_command_env(providers_config)
  const env = auth_env + command_env
  const cell_plan = if live {
    __live_cells(
      harness,
      routes,
      behaviors,
      harn_bin,
      env,
      repeat,
      timeout_secs,
      output_dir,
      shard_count,
      shard_index,
      max_probes,
    )
  } else {
    provider_tool_probe_campaign_planned_cells_sliced_with_options(
      routes,
      behaviors,
      harn_bin,
      repeat,
      timeout_secs,
      shard_count,
      shard_index,
      max_probes,
    )
  }
  const cells = cell_plan.cells ?? []
  const report = provider_tool_probe_campaign_report(
    routes,
    behaviors,
    cells,
    live,
    include_expensive,
    output_dir,
    repeat,
    auth_env,
    env_load.source ?? {},
    runtime,
    catalog_receipt,
    cell_plan.slice ?? {},
  )
  harness.fs.write_text(report.artifacts.report_json, json_stringify_pretty(report) + "\n")
  harness.fs.write_text(
    report.artifacts.report_markdown,
    provider_tool_probe_campaign_markdown(report),
  )
  if parsed?.markdown ?? false {
    harness.stdio.println(provider_tool_probe_campaign_markdown(report))
  } else {
    harness.stdio.println(json_stringify_pretty(report))
  }
  const summary = report.summary
  if live && ((summary.fail ?? 0) > 0 || (summary.error ?? 0) > 0) {
    exit(1)
  }
  return nil
}
