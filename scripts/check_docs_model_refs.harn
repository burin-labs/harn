// Verify docs model references track the provider alias catalog.
//
// Ported from scripts/check_docs_model_refs.sh: every `claude-sonnet-4-*`
// model id mentioned in docs/src or docs/llm must match the current
// `aliases.sonnet` id in crates/harn-vm/src/llm/providers.toml, unless the
// line carries an inline `harn-doc-model-ref: allow-stale` marker or the
// file is generated (a GENERATED marker in its first five lines).
//
// Usage:
//   harn run scripts/check_docs_model_refs.harn   # exit 1 on stale refs
const PROVIDERS_TOML = "crates/harn-vm/src/llm/providers.toml"

const SONNET_REF_RE = r"claude-sonnet-4(-[0-9][0-9A-Za-z]*)+"

const ALLOW_STALE = "harn-doc-model-ref: allow-stale"

/** Characters a provider id may contain, for walking back from a `/`. */
const PROVIDER_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"

/**
 * True when a file's first five lines carry a GENERATED marker — such
 * files mirror another source of truth and are skipped (the bash
 * `head -n 5 | grep -q GENERATED`).
 */
pub fn is_generated(text: string) -> bool {
  let i = 0
  for line in text.lines() {
    if i >= 5 {
      break
    }
    if line.contains("GENERATED") {
      return true
    }
    i = i + 1
  }
  return false
}

/**
 * The provider that namespaces a match, or "" when the reference is bare.
 *
 * `aliases.sonnet` is an ANTHROPIC alias, so it is only the right thing to
 * compare against for a bare or `anthropic/`-namespaced reference. Another
 * provider's route resolves its own default model and can legitimately name a
 * different one.
 */
pub fn ref_provider(line: string, model: string) -> string {
  const idx = line.index_of(model)
  if idx <= 0 || line.substring(idx - 1, idx) != "/" {
    return ""
  }
  let start = idx - 1
  while start > 0 && PROVIDER_CHARS.contains(line.substring(start - 1, start)) {
    start = start - 1
  }
  return line.substring(start, idx - 1)
}

/**
 * All stale sonnet references in `text`: `{model, line_no, line}` records
 * for every `claude-sonnet-4-*` match that differs from `sonnet_model`
 * and whose line lacks the allow-stale marker. Pure so tests can drive it.
 *
 * A match namespaced to a provider other than `anthropic` is skipped: it names
 * that provider's own route, not the anthropic alias, so comparing the two is a
 * category error. `vertex/claude-sonnet-4-6` is a live route while
 * `aliases.sonnet` is `claude-sonnet-5`, and flagging it pushed a correct doc
 * example into contradicting a passing `models recommend` assertion.
 */
pub fn stale_refs(text: string, sonnet_model: string) -> list {
  const ms = regex_captures(SONNET_REF_RE, text)
  if ms.count == 0 {
    return []
  }
  const lines = text.lines()
  let out: list = []
  for m in ms {
    if m.match == sonnet_model {
      continue
    }
    const line = lines[m.line - 1]
    if line.contains(ALLOW_STALE) {
      continue
    }
    const provider = ref_provider(line, m.match)
    if provider != "" && provider != "anthropic" {
      continue
    }
    out = out + [{model: m.match, line_no: m.line, line: line}]
  }
  return out
}

/** Repo-relative form of a glob result (strip the `/./` marker). */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

pipeline main(harness: Harness, task: unknown) {
  const parsed = try {
    toml_parse(harness.fs.read_text(PROVIDERS_TOML))
  } catch (err) {
    nil
  }
  const sonnet_model = parsed?.aliases?.sonnet?.id ?? ""
  if sonnet_model == "" {
    harness.stdio.eprintln("error: could not resolve aliases.sonnet from ${PROVIDERS_TOML}")
    return 1
  }
  let files: list<string> = []
  for g in harness.fs.glob("docs/src/**/*.md") {
    files = files + [rel_path(g)]
  }
  for g in harness.fs.glob("docs/llm/**/*.md") {
    files = files + [rel_path(g)]
  }
  let failures = 0
  for file in files.sorted() {
    const text = harness.fs.read_text(file)
    if is_generated(text) {
      continue
    }
    for ref in stale_refs(text, sonnet_model) {
      harness.stdio.eprintln(
        "error: ${file}:${ref.line_no} references ${ref.model}, but aliases.sonnet is ${sonnet_model}",
      )
      harness.stdio.eprintln(
        "       update the docs example or add harn-doc-model-ref: allow-stale if this is intentionally historical.",
      )
      failures = failures + 1
    }
  }
  if failures > 0 {
    return 1
  }
  harness.stdio.println("docs model refs OK: aliases.sonnet = ${sonnet_model}")
  return 0
}
