// Check the Harn Agents OpenAPI path/schema surface snapshot. Walks the
// YAML line-by-line (cheaper than a full parse, and mirrors the original
// Python logic), reduces it to a flat list of `METHOD /path` entries
// plus component-schema names, and diffs that against the committed
// `spec/openapi.snapshot` text. Run with `--update` after intentional
// surface changes; the gate runs without flags from `make check-openapi-snapshot`.
let SPEC_PATH = "spec/openapi.yaml"

let EMBEDDED_SPEC_PATH = "crates/harn-serve/openapi.yaml"

let SNAPSHOT_PATH = "spec/openapi.snapshot"

let HTTP_METHODS = ["get", "put", "post", "delete", "patch", "options", "head", "trace"]

/**
 * Reduce the YAML at `spec_text` to the canonical surface text format
 * the snapshot file uses. Tracks whether we are inside the top-level
 * `paths:` or `components.schemas:` blocks via simple two-space and
 * four-space indent prefixes.
 */
pub fn collect_surface(spec_text: string) -> string {
  var paths: list<string> = []
  var schemas: list<string> = []
  var section: string? = nil
  var current_path: string? = nil
  for line in spec_text.split("\n") {
    let top_match = regex_captures(r"^([A-Za-z][A-Za-z0-9_-]*):", line)
    if top_match.count > 0 {
      section = top_match[0].groups[0]
      current_path = nil
      continue
    }
    if section == "paths" {
      let path_match = regex_captures(r"^  (/[^\s]+):$", line)
      if path_match.count > 0 {
        current_path = path_match[0].groups[0]
        continue
      }
      let method_match = regex_captures(r"^    ([a-z]+):$", line)
      if current_path != nil && method_match.count > 0
        && HTTP_METHODS.contains(method_match[0].groups[0]) {
        paths = paths + ["${method_match[0].groups[0].uppercase()} ${current_path}"]
        continue
      }
    }
    if section == "components" && line == "  schemas:" {
      section = "schemas"
      continue
    }
    if section == "schemas" {
      let schema_match = regex_captures(r"^    ([A-Za-z][A-Za-z0-9_]*):$", line)
      if schema_match.count > 0 {
        schemas = schemas + [schema_match[0].groups[0]]
      }
    }
  }
  var lines: list<string> = ["# Generated by scripts/check_openapi_snapshot.harn --update", "", "## Paths"]
  lines = lines + paths
  lines = lines + ["", "## Schemas"]
  lines = lines + schemas
  lines = lines + [""]
  return lines.join("\n")
}

pipeline main(task) {
  let spec_text = harness.fs.read_text(SPEC_PATH)
  let actual = collect_surface(spec_text)
  let update = argv.contains("--update")
  if update {
    harness.fs.write_text(SNAPSHOT_PATH, actual)
    harness.fs.write_text(EMBEDDED_SPEC_PATH, spec_text)
    return 0
  }
  if !harness.fs.exists(EMBEDDED_SPEC_PATH) || harness.fs.read_text(EMBEDDED_SPEC_PATH) != spec_text {
    __io_eprintln(
      "crates/harn-serve/openapi.yaml is stale. Run `harn run scripts/check_openapi_snapshot.harn -- --update` after reviewing the OpenAPI surface.",
    )
    return 1
  }
  let expected = if harness.fs.exists(SNAPSHOT_PATH) {
    harness.fs.read_text(SNAPSHOT_PATH)
  } else {
    ""
  }
  if actual == expected {
    return 0
  }
  __io_eprintln(
    "spec/openapi.snapshot is stale. Run `harn run scripts/check_openapi_snapshot.harn -- --update` after reviewing the OpenAPI surface.",
  )
  return 1
}
