import { parse, parser } from "std/cli/argparse"
import { SelectedInventory, selected_inventory } from "./nextest_inventory"

pub type Receipt = {
  reason: string,
  selected: int,
  run: int,
  passed: int,
  skipped: int,
  failed: int,
  missing: list<string>,
  started: int,
  pending: list<string>,
  failed_names: list<string>,
}

pub type ReceiptResult = {
  receipt: Receipt,
  status: int,
  threads: int,
  stress_count: int?,
  format: string,
}

type NextestEvent = {type?: string, event?: string, name?: string}

fn finished_receipt(
  inventory: SelectedInventory,
  events: string,
  runner_status: int,
  stress_count: int?,
) -> Receipt {
  let selected: dict<string, bool> = {}
  for name in inventory.selected {
    if stress_count == nil {
      selected[name] = true
    } else {
      const identity = name.split("$")
      if len(identity) != 2 {
        throw "inventory test identity has no unique binary separator: ${name}"
      }
      for iteration in range(0, unwrap(stress_count)) {
        selected["${identity[0]}@stress-${iteration}$${identity[1]}"] = true
      }
    }
  }
  let finished: dict<string, string> = {}
  let started: dict<string, bool> = {}
  let line_number = 0
  let passed = 0
  const event_schema = schema_of(NextestEvent) + {additional_properties: true}
  for line in events.split("\n") {
    line_number += 1
    if trim(line) == "" {
      continue
    }
    const event = schema_expect<NextestEvent>(json_parse(line), event_schema)
    const kind = event.event ?? ""
    if event.type != "test" || !["started", "ok", "failed"].contains(kind) {
      continue
    }
    if event.name == nil {
      throw "events line ${line_number} has no test name"
    }
    const name = unwrap(event.name)
    if !(selected[name] ?? false) {
      throw "test is absent from inventory: ${name}"
    }
    started[name] = true
    if kind == "started" {
      continue
    }
    if finished[name] != nil {
      throw "test has multiple terminal events: ${name}"
    }
    finished[name] = kind
    if kind == "ok" {
      passed += 1
    }
  }
  const missing = selected.keys().filter({ name -> finished[name] == nil }).sorted()
  const failed = len(finished) - passed
  const pending = started.keys().filter({ name -> finished[name] == nil }).sorted()
  const failed_names = finished.keys().filter({ name -> finished[name] == "failed" }).sorted()
  const reason = if len(missing) > 0 {
    "tests-not-run"
  } else if failed > 0 {
    "test-failure"
  } else if runner_status != 0 {
    "runner-error"
  } else {
    "complete"
  }
  return {
    reason: reason,
    selected: len(selected),
    run: len(finished),
    passed: passed,
    skipped: inventory.skipped,
    failed: failed,
    missing: missing,
    started: len(started),
    pending: pending,
    failed_names: failed_names,
  }
}

fn main(harness: Harness) {
  const spec = parser(
    {
      name: "summarize_nextest_receipt",
      args: [
        {kind: "flag", name: "inventory", long: "--inventory", required: true},
        {kind: "flag", name: "events", long: "--events", required: true},
        {kind: "flag", name: "runner_status", long: "--runner-status", required: true},
        {kind: "flag", name: "threads", long: "--threads", required: true},
        {kind: "flag", name: "stress_count", long: "--stress-count"},
        {kind: "flag", name: "format", long: "--format"},
        {kind: "flag", name: "receipt", long: "--receipt"},
      ],
    },
  )
  let receipt_path: string? = nil
  const outcome = try {
    const options = unwrap(parse(spec, argv)).options
    receipt_path = if options.receipt == nil {
      nil
    } else {
      to_string(options.receipt)
    }
    const status_text = to_string(options.runner_status)
    const threads_text = to_string(options.threads)
    if regex_match(r"^[0-9]+$", status_text) == nil
      || regex_match(r"^[1-9][0-9]*$", threads_text) == nil {
      throw "runner status or thread count is invalid"
    }
    const status = unwrap(to_int(status_text))
    const threads = unwrap(to_int(threads_text))
    const stress_text = options.stress_count
    const stress_count = if stress_text == nil {
      nil
    } else {
      if regex_match(r"^[1-9][0-9]*$", to_string(stress_text)) == nil {
        throw "stress count is invalid"
      }
      unwrap(to_int(to_string(stress_text)))
    }
    const format = options.format ?? "human"
    if !["human", "json"].contains(format) {
      throw "receipt format is invalid"
    }
    const inventory = selected_inventory(json_parse(harness.fs.read_text(options.inventory)))
    const receipt = finished_receipt(
      inventory,
      harness.fs.read_text(options.events),
      status,
      stress_count,
    )
    {receipt: receipt, status: status, threads: threads, stress_count: stress_count, format: format}
  }
  if is_err(outcome) {
    harness.stdio.eprintln(
      "thread_parity_receipt reason=receipt-invalid detail=${json_stringify(to_string(unwrap_err(outcome)))}",
    )
    harness.runtime.exit(2)
  }
  const result = schema_expect<ReceiptResult>(unwrap(outcome), schema_of(ReceiptResult))
  const receipt = result.receipt
  if receipt_path != nil {
    harness.fs.write_text(unwrap(receipt_path), json_stringify(result))
  }
  if result.format == "json" {
    harness.stdio.println(json_stringify(result))
  } else {
    harness.stdio.println(
      [
        "thread_parity_receipt reason=${receipt.reason} threads=${result.threads} selected=${receipt.selected}",
        "run=${receipt.run} passed=${receipt.passed} skipped=${receipt.skipped}",
        "not_run=${len(receipt.missing)} failed=${receipt.failed} runner_status=${result.status}",
        "started=${receipt.started} pending=${len(receipt.pending)}",
      ]
        .join(" "),
    )
  }
  for name in receipt.missing {
    harness.stdio.eprintln("thread_parity_missing_test ${name}")
  }
  for name in receipt.pending {
    harness.stdio.eprintln("thread_parity_pending_test ${name}")
  }
  for name in receipt.failed_names {
    harness.stdio.eprintln("thread_parity_failed_test ${name}")
  }
  if receipt.reason != "complete" {
    harness.runtime.exit(1)
  }
}
