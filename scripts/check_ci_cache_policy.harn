pub type CiCacheWriter = {workflow: string, job: string, shared_key: string}

pub type WindowsWorkspaceWarmPolicy = {
  artifact_name: string,
  manifest_schema: string,
  workflow: string,
  job: string,
  retention_days: int,
  max_bytes: int,
  dev_drive_size_default: string,
  dev_drive_size_release_certify: string,
}

pub type CiCachePolicy = {
  schema_version: 4,
  rust_cache_action: "./.github/actions/rust-cache",
  node_cache_action: "./.github/actions/node-cache",
  persistent_ref: "refs/heads/main",
  storage_limit_bytes: int,
  remote_sccache: bool,
  nextest_version: string,
  windows_workspace_warm: WindowsWorkspaceWarmPolicy,
  writers: list<CiCacheWriter>,
}

