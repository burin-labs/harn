import { read_json_result, read_yaml } from "std/fs"
import {
  schema_closed_object,
  schema_int,
  schema_list,
  schema_literal,
  schema_string,
  schema_validator,
} from "std/schema"

pub type CiCacheWriter = {workflow: string, job: string, shared_key: string}

pub type CiCachePolicy = {
  schema_version: 2,
  rust_cache_action: "./.github/actions/rust-cache",
  node_cache_action: "./.github/actions/node-cache",
  persistent_ref: "refs/heads/main",
  storage_limit_bytes: int,
  remote_sccache: bool,
  writers: list<CiCacheWriter>,
}

const POLICY_PATH = ".github/cache-policy.json"

const ACTION_PATH = ".github/actions/rust-cache/action.yml"

const NODE_ACTION_PATH = ".github/actions/node-cache/action.yml"

const SCCACHE_ACTION_PATH = ".github/actions/sccache/action.yml"

const SCCACHE_ACTION = "./.github/actions/sccache"

const STICKY_DISK_PREFIX = "useblacksmith/stickydisk@"

const STICKY_DISK_PIN = "useblacksmith/stickydisk@6d373c96a74cbde0c99fedc5ea5d3a7ba66ba494"

const BLACKSMITH_DISABLE_VAR = "HARN_CI_DISABLE_BLACKSMITH_LINUX"

const PERSISTENT_SCCACHE_SIZE = "15G"

const WORKFLOW_GLOB = ".github/workflows/*.yml"

const UPSTREAM_CACHE_PREFIX = "Swatinem/rust-cache@"

const UPSTREAM_CACHE_RESTORE_PREFIX = "actions/cache/restore@"

const UPSTREAM_NODE_PREFIX = "actions/setup-node@"

const UPSTREAM_GENERIC_CACHE_PREFIX = "actions/cache@"

const UPSTREAM_CACHE_SAVE_PREFIX = "actions/cache/save@"

const DOCKER_BUILD_PREFIX = "docker/build-push-action@"

const CACHE_BUDGET_WORKFLOW = "build-release-binaries.yml"

const CACHE_BUDGET_JOB = "cache_budget"

const CACHE_BUDGET_SCRIPT = "./scripts/report_ci_cache_budget.sh"

const CLI_COLD_START_WORKFLOW = "cli-cold-start-budget.yml"

const CLI_COLD_START_JOB = "cold-start-budget"

const CLI_COLD_START_BUILD_STEP = "Build release harn"

const CLI_COLD_START_JOB_IF =
  "(github.event_name != 'workflow_dispatch' || !startsWith(github.ref_name, 'release/v'))"

const WINDOWS_CACHE_KEY = "workspace-windows"

const WINDOWS_SOURCE_FINGERPRINT_BODY =
  "hashFiles('Cargo.lock', 'Cargo.toml', 'crates/**', 'spec/**', 'tree-sitter-harn/**')"

const WINDOWS_CACHE_INPUTS = ["CARGO_INCREMENTAL", "CARGO_TERM_COLOR", "RUSTC_WRAPPER", "RUSTFLAGS"]

const WINDOWS_SCCACHE_ACTION_PREFIX = "mozilla-actions/sccache-action@"

fn policy_schema() {
  return schema_closed_object(
    {
      schema_version: schema_literal(2),
      rust_cache_action: schema_literal("./.github/actions/rust-cache"),
      node_cache_action: schema_literal("./.github/actions/node-cache"),
      persistent_ref: schema_literal("refs/heads/main"),
      storage_limit_bytes: schema_int() + {minimum: 1073741824},
      remote_sccache: schema_literal(false),
      writers: schema_list(
        schema_closed_object(
          {
            workflow: schema_string() + {pattern: "^[a-z0-9-]+[.]yml$"},
            job: schema_string() + {pattern: "^[a-z0-9-]+$"},
            shared_key: schema_string() + {min_length: 1},
          },
        ),
      ),
    },
  )
}

fn policy_from_validated(value) -> CiCachePolicy {
  return {
    schema_version: 2,
    rust_cache_action: "./.github/actions/rust-cache",
    node_cache_action: "./.github/actions/node-cache",
    persistent_ref: "refs/heads/main",
    storage_limit_bytes: value.storage_limit_bytes,
    remote_sccache: false,
    writers: value.writers.map(
      { writer ->
        return {workflow: writer.workflow, job: writer.job, shared_key: writer.shared_key}
      },
    )
      .to_list(),
  }
}

fn writer_key(workflow: string, job: string, shared_key: string) -> string {
  return workflow + ":" + job + ":" + shared_key
}

/** Validate the closed cache-policy document at its owning boundary. */
pub fn ci_cache_policy_parse(value) -> CiCachePolicy? {
  const report = schema_validator(policy_schema()).report(value)
  if !report.ok {
    return nil
  }
  const policy = policy_from_validated(report.value)
  const writer_keys = policy.writers.map(
    { writer -> writer_key(writer.workflow, writer.job, writer.shared_key) },
  )
    .to_list()
  if len(writer_keys) == 0 || len(writer_keys) != len(writer_keys.unique()) {
    return nil
  }
  return policy
}

fn workflow_name(path: string) -> string {
  return basename(path)
}

fn step_uses(step) -> string {
  return trim(step?.uses ?? "")
}

fn save_requested(step) -> bool {
  const value = step?.with?.save
  return value != nil && lowercase(trim(to_string(value))) != "false"
}

fn writer_allowed(
  policy: CiCachePolicy,
  workflow: string,
  job: string,
  shared_key: string,
) -> bool {
  return policy.writers.any(
    { writer ->
      return writer.workflow == workflow && writer.job == job && writer.shared_key == shared_key
    },
  )
}

fn remote_sccache_errors(value, path: string = "") -> list<string> {
  if type_of(value) == "list" {
    let errors: list<string> = []
    for {index, value: item} in value.enumerate() {
      errors = errors + remote_sccache_errors(item, path + "[${index}]")
    }
    return errors
  }
  if type_of(value) != "dict" {
    return []
  }
  let errors: list<string> = []
  for key in value.keys().sort() {
    const child_path = if path == "" {
      key
    } else {
      path + "." + key
    }
    if key == "SCCACHE_GHA_ENABLED" && lowercase(trim(to_string(value[key]))) != "false" {
      errors = errors + [child_path + " enables the per-object GHA sccache backend"]
    }
    errors = errors + remote_sccache_errors(value[key], child_path)
  }
  return errors
}

fn cache_action_errors(policy: CiCachePolicy, action) -> list<string> {
  let errors: list<string> = []
  const steps = action?.runs?.steps ?? []
  const upstream = steps.filter({ step -> step_uses(step).starts_with(UPSTREAM_CACHE_PREFIX) })
    .to_list()
  const broad_restore = steps.filter(
    { step -> step_uses(step).starts_with(UPSTREAM_CACHE_RESTORE_PREFIX) },
  )
    .to_list()
  if len(upstream) != 1 {
    return ["${ACTION_PATH} must contain exactly one pinned upstream Rust cache step"]
  }
  if len(broad_restore) != 1 {
    errors = errors
      + [
      "${ACTION_PATH} must contain one pinned restore-only broad Rust cache fallback step",
    ]
  } else {
    const restore_if = trim(broad_restore[0]?.if ?? "")
    if !contains(restore_if, "inputs.broad-restore-prefix != ''") {
      errors = errors + ["${ACTION_PATH} broad fallback must be opt-in per caller"]
    }
    const restore_keys = trim(broad_restore[0]?.with?.["restore-keys"] ?? "")
    const restore_key = trim(broad_restore[0]?.with?.key ?? "")
    if !contains(restore_keys, "inputs.broad-restore-prefix")
      || !contains(
      restore_key,
      "inputs.broad-restore-prefix",
    )
      || !contains(restore_key, "github.sha") {
      errors = errors
        + [
        "${ACTION_PATH} broad fallback must restore by prefix without becoming a writer",
      ]
    }
    if !(broad_restore[0]?.["continue-on-error"] ?? false) {
      errors = errors + ["${ACTION_PATH} broad fallback must keep cache-service failures non-fatal"]
    }
  }
  const step = upstream[0]
  const expected_shared_key = "$"
    + "{{ inputs.source-key != '' && format('{0}-{1}', inputs.shared-key, inputs.source-key) || inputs.shared-key }}"
  if trim(step?.with?.["shared-key"] ?? "") != expected_shared_key
    || trim(step?.with?.key ?? "")
    != "" {
    errors = errors
      + ["${ACTION_PATH} must compose source-key into the effective upstream shared-key"]
  }
  const save_if = trim(step?.with?.["save-if"] ?? "")
  if !contains(save_if, "inputs.save == 'true'")
    || !contains(
    save_if,
    "github.ref == 'refs/heads/main'",
  ) {
    errors = errors
      + [
      "${ACTION_PATH} must hard-gate saves on explicit authorization and refs/heads/main",
    ]
  }
  if !(step?.["continue-on-error"] ?? false) {
    errors = errors + ["${ACTION_PATH} must keep cache-service failures non-fatal"]
  }
  return errors
}

fn node_cache_action_errors(action) -> list<string> {
  const steps = action?.runs?.steps ?? []
  const setup =
    steps.filter({ step -> step_uses(step).starts_with(UPSTREAM_NODE_PREFIX) }).to_list()
  const restores = steps.filter(
    { step -> step_uses(step).starts_with(UPSTREAM_CACHE_RESTORE_PREFIX) },
  )
    .to_list()
  const caches = steps.filter(
    { step -> step_uses(step).starts_with(UPSTREAM_GENERIC_CACHE_PREFIX) },
  )
    .to_list()
  if len(setup) != 1 || len(restores) != 1 || len(caches) != 1 {
    return [
      "${NODE_ACTION_PATH} must contain one pinned setup, restore-only cache, and main cache step",
    ]
  }
  let errors: list<string> = []
  if trim(setup[0]?.with?.cache ?? "") != "" {
    errors = errors + ["${NODE_ACTION_PATH} setup-node step must not register its own cache writer"]
  }
  const restore_if = trim(restores[0]?.if ?? "")
  const save_if = trim(caches[0]?.if ?? "")
  if !contains(restore_if, "github.ref != 'refs/heads/main'") {
    errors = errors
      + ["${NODE_ACTION_PATH} must use restore-only caching away from refs/heads/main"]
  }
  if !contains(save_if, "github.ref == 'refs/heads/main'") {
    errors = errors + ["${NODE_ACTION_PATH} must hard-gate npm cache saves on refs/heads/main"]
  }
  if !(restores[0]?.["continue-on-error"] ?? false)
    || !(caches[0]?.["continue-on-error"] ?? false) {
    errors = errors + ["${NODE_ACTION_PATH} must keep cache-service failures non-fatal"]
  }
  return errors
}

fn ephemeral_cache_writer_error(
  workflow: string,
  job: string,
  step,
  policy: CiCachePolicy,
) -> string? {
  const uses = step_uses(step)
  if uses.starts_with(UPSTREAM_NODE_PREFIX) && trim(step?.with?.cache ?? "") != "" {
    return "${workflow}:${job} bypasses ${policy.node_cache_action} with setup-node caching"
  }
  if uses.starts_with(UPSTREAM_GENERIC_CACHE_PREFIX)
    || uses.starts_with(UPSTREAM_CACHE_SAVE_PREFIX) {
    return "${workflow}:${job} bypasses Harn-owned cache actions with ${uses}"
  }
  if uses.starts_with(DOCKER_BUILD_PREFIX) {
    const cache_to = trim(step?.with?.["cache-to"] ?? "")
    if cache_to != "" && !contains(cache_to, "github.ref == 'refs/heads/main'") {
      return "${workflow}:${job} enables an ungated BuildKit cache writer"
    }
  }
  return nil
}

fn cache_budget_reporter_errors(workflows: dict) -> list<string> {
  const job = workflows[CACHE_BUDGET_WORKFLOW]?.jobs?.[CACHE_BUDGET_JOB]
  if job == nil {
    return ["${CACHE_BUDGET_WORKFLOW}:${CACHE_BUDGET_JOB} must define the cache-budget reporter"]
  }
  let errors: list<string> = []
  if trim(job?.permissions?.actions ?? "") != "write" {
    errors = errors + ["${CACHE_BUDGET_WORKFLOW}:${CACHE_BUDGET_JOB} must grant actions: write"]
  }
  const reporters = (job?.steps ?? []).filter(
    { step -> trim(step?.run ?? "") == CACHE_BUDGET_SCRIPT },
  )
    .to_list()
  if len(reporters) != 1 {
    return errors
      + [
      "${CACHE_BUDGET_WORKFLOW}:${CACHE_BUDGET_JOB} must run ${CACHE_BUDGET_SCRIPT} exactly once",
    ]
  }
  if reporters[0]?.["continue-on-error"] ?? false {
    errors = errors
      + [
      "${CACHE_BUDGET_WORKFLOW}:${CACHE_BUDGET_JOB} must fail when cache telemetry fails",
    ]
  }
  if trim(reporters[0]?.env?.HARN_PRUNE_SUPERSEDED_RELEASE_CACHES ?? "") != "1" {
    errors = errors
      + [
      "${CACHE_BUDGET_WORKFLOW}:${CACHE_BUDGET_JOB} must prune superseded release caches",
    ]
  }
  return errors
}

fn step_by_name(steps: list, name: string) {
  const matches = steps.filter({ step -> trim(step?.name ?? "") == name }).to_list()
  if len(matches) == 0 {
    return nil
  }
  return matches[0]
}

fn cli_cold_start_budget_errors(workflows: dict) -> list<string> {
  const workflow = workflows[CLI_COLD_START_WORKFLOW]
  if workflow == nil {
    return ["${CLI_COLD_START_WORKFLOW} must define the advisory CLI cold-start budget"]
  }
  let errors: list<string> = []
  if workflow?.["on"]?.pull_request != nil {
    errors = errors
      + [
      "${CLI_COLD_START_WORKFLOW} must not run release-build cold-start benchmarks on pull_request",
    ]
  }
  if len(workflow?.["on"]?.schedule ?? []) == 0 {
    errors = errors + ["${CLI_COLD_START_WORKFLOW} must keep a scheduled main-branch advisory run"]
  }
  const job = workflow?.jobs?.[CLI_COLD_START_JOB]
  if job == nil {
    return errors
      + ["${CLI_COLD_START_WORKFLOW}:${CLI_COLD_START_JOB} must define the cold-start job"]
  }
  if trim(job?.if ?? "") != CLI_COLD_START_JOB_IF {
    errors = errors
      + [
      "${CLI_COLD_START_WORKFLOW}:${CLI_COLD_START_JOB} must skip release manual refs",
    ]
  }
  if job?.["timeout-minutes"] != 25 {
    errors = errors
      + [
      "${CLI_COLD_START_WORKFLOW}:${CLI_COLD_START_JOB} must cap total runtime at 25 minutes",
    ]
  }
  const build_step = step_by_name(job?.steps ?? [], CLI_COLD_START_BUILD_STEP)
  if build_step == nil {
    errors = errors
      + [
      "${CLI_COLD_START_WORKFLOW}:${CLI_COLD_START_JOB} must build the release harn binary explicitly",
    ]
  } else if build_step?.["timeout-minutes"] != 20 {
    errors = errors
      + [
      "${CLI_COLD_START_WORKFLOW}:${CLI_COLD_START_JOB} release build step must cap runtime at 20 minutes",
    ]
  }
  return errors
}

fn matching_steps(job, uses: string) -> list {
  return (job?.steps ?? []).filter({ step -> step_uses(step) == uses }).to_list()
}

fn effective_job_env(workflow, job, key: string) -> string {
  const value = job?.env?.[key] ?? workflow?.env?.[key]
  if value == nil {
    return "<unset>"
  }
  return trim(to_string(value))
}

fn cache_key_inputs(workflow, job) -> list<string> {
  let inputs = WINDOWS_CACHE_INPUTS.map(
    { key -> return key + "=" + effective_job_env(workflow, job, key) },
  )
    .to_list()
  for step in job?.steps ?? [] {
    if step_uses(step) == "./.github/actions/rust-cache" {
      inputs = inputs + ["rust-cache-source-key=" + trim(step?.with?.["source-key"] ?? "")]
      break
    }
    const uses = step_uses(step)
    inputs = inputs
      + [
      if uses == "" {
        "pre-cache-run=" + trim(step?.name ?? "<unnamed>")
      } else {
        "pre-cache-uses=" + uses
      },
    ]
  }
  return inputs
}

/** Keep the sole native-Windows cache writer byte-compatible with its restore-only PR consumer. */
pub fn windows_shared_cache_errors(ci_workflow, nightly_workflow) -> list<string> {
  const consumer = ci_workflow?.jobs?.windows
  const producer = nightly_workflow?.jobs?.nextest
  if consumer == nil || producer == nil {
    return ["workspace-windows must pair ci.yml:windows with windows-nightly.yml:nextest"]
  }
  let errors: list<string> = []
  const consumer_caches = matching_steps(consumer, "./.github/actions/rust-cache")
  const producer_caches = matching_steps(producer, "./.github/actions/rust-cache")
  const wrapper_steps = ((consumer?.steps ?? []) + (producer?.steps ?? [])).map(
    { step -> return step_uses(step) },
  )
    .filter({ uses -> return uses.starts_with(WINDOWS_SCCACHE_ACTION_PREFIX) })
    .to_list()
  if len(wrapper_steps) > 0 {
    errors = errors
      + [
      "workspace-windows producer and consumer must use plain rustc: "
        + json_stringify(wrapper_steps),
    ]
  }
  if len(consumer_caches) != 1
    || trim(consumer_caches[0]?.with?.["shared-key"] ?? "")
    != WINDOWS_CACHE_KEY
    || save_requested(consumer_caches[0]) {
    errors = errors + ["ci.yml:windows must restore workspace-windows exactly once without saving"]
  }
  if len(producer_caches) != 1
    || trim(producer_caches[0]?.with?.["shared-key"] ?? "")
    != WINDOWS_CACHE_KEY
    || !save_requested(producer_caches[0]) {
    errors = errors + ["windows-nightly.yml:nextest must write workspace-windows exactly once"]
  }
  const consumer_source_key = trim(consumer_caches[0]?.with?.["source-key"] ?? "")
  const producer_source_key = trim(producer_caches[0]?.with?.["source-key"] ?? "")
  const expected_source_key = "$" + "{{ " + WINDOWS_SOURCE_FINGERPRINT_BODY + " }}"
  if consumer_source_key != expected_source_key || producer_source_key != expected_source_key {
    errors = errors
      + [
      "workspace-windows producer and consumer must use the canonical source fingerprint",
    ]
  }
  const consumer_inputs = cache_key_inputs(ci_workflow, consumer)
  const producer_inputs = cache_key_inputs(nightly_workflow, producer)
  if consumer_inputs != producer_inputs {
    errors = errors
      + [
      "workspace-windows cache-key inputs drift: consumer="
        + json_stringify(consumer_inputs)
        + " producer="
        + json_stringify(producer_inputs),
    ]
  }
  return errors
}

fn persistent_sccache_job_errors(
  workflow,
  job_name: string,
  expected_runner: string,
  fallback_condition: string,
) -> list<string> {
  const job = workflow?.jobs?.[job_name]
  if job == nil {
    return ["ci.yml:${job_name} must define the persistent sccache lane"]
  }
  let errors: list<string> = []
  const runner = trim(job?.["runs-on"] ?? "")
  if !contains(runner, BLACKSMITH_DISABLE_VAR) || !contains(runner, expected_runner) {
    errors = errors
      + [
      "ci.yml:${job_name} must use ${expected_runner} behind ${BLACKSMITH_DISABLE_VAR}",
    ]
  }
  if trim(job?.env?.SCCACHE_CACHE_SIZE ?? "") != PERSISTENT_SCCACHE_SIZE {
    errors = errors
      + ["ci.yml:${job_name} must cap persistent sccache at ${PERSISTENT_SCCACHE_SIZE}"]
  }
  if !contains(trim(job?.env?.SCCACHE_BASEDIRS ?? ""), "github.workspace") {
    errors = errors + ["ci.yml:${job_name} must normalize sccache paths to github.workspace"]
  }
  const caches = matching_steps(job, SCCACHE_ACTION)
  if len(caches) != 1 {
    errors = errors + ["ci.yml:${job_name} must configure ${SCCACHE_ACTION} exactly once"]
  } else if !contains(trim(caches[0]?.with?.sticky ?? ""), BLACKSMITH_DISABLE_VAR) {
    errors = errors + ["ci.yml:${job_name} sticky cache must follow ${BLACKSMITH_DISABLE_VAR}"]
  }
  const fallback = matching_steps(job, "./.github/actions/rust-cache")
  if len(fallback) != 1 || trim(fallback[0]?.if ?? "") != fallback_condition {
    errors = errors
      + ["ci.yml:${job_name} must retain rust-cache only on the GitHub-hosted fallback"]
  }
  const finalizers = (job?.steps ?? []).filter(
    { step -> trim(step?.run ?? "") == "./scripts/ci/finalize_sccache.sh" },
  )
    .to_list()
  if len(finalizers) != 1 || trim(finalizers[0]?.if ?? "") != "always()" {
    errors = errors + ["ci.yml:${job_name} must summarize live sccache stats before shutdown"]
  }
  return errors
}

fn archived_behavior_consumer_errors(workflow, job_name: string) -> list<string> {
  const producer = workflow?.jobs?.["rust-builds"]
  const consumer = workflow?.jobs?.[job_name]
  if consumer == nil {
    return ["ci.yml:${job_name} must define the archived behavior consumer"]
  }
  if producer == nil {
    return []
  }
  let errors: list<string> = []
  const runner = trim(consumer?.["runs-on"] ?? "")
  if !contains(runner, BLACKSMITH_DISABLE_VAR)
    || !contains(runner, "blacksmith-8vcpu-ubuntu-2404") {
    errors = errors
      + ["ci.yml:${job_name} must retain the policy-sized execution runner"]
  }
  const needs = consumer?.needs ?? []
  if !needs.contains("rust-builds") {
    errors = errors + ["ci.yml:${job_name} must wait for the behavior artifact producer"]
  }
  if trim(consumer?.env?.RUSTFLAGS ?? "") != trim(producer?.env?.RUSTFLAGS ?? "") {
    errors = errors + ["ci.yml:${job_name} must match rust-builds RUSTFLAGS"]
  }
  if trim(to_string(consumer?.["timeout-minutes"] ?? "")) != "12" {
    errors = errors + ["ci.yml:${job_name} must keep the execution-only 12-minute timeout"]
  }
  if len(matching_steps(consumer, SCCACHE_ACTION)) > 0
    || len(
    matching_steps(consumer, "./.github/actions/rust-cache"),
  )
    > 0
    || len(matching_steps(consumer, "./.github/actions/free-disk-space"))
    > 0 {
    errors = errors + ["ci.yml:${job_name} must not restore compiler caches or build-disk setup"]
  }
  const restore_step = step_by_name(consumer?.steps ?? [], "Verify portable behavior payload")
  if trim(restore_step?.env?.HARN_VERIFY_RUST_RUNTIME ?? "") != "1"
    || !contains(
    trim(restore_step?.run ?? ""),
    "behavior_artifact.sh restore",
  ) {
    errors = errors + ["ci.yml:${job_name} must verify the archived Rust runtime contract"]
  }
  const test_step = step_by_name(consumer?.steps ?? [], "Run full environment-neutral test suite")
  const test_command = trim(test_step?.run ?? "")
  if !contains(test_command, "--archive-file")
    || !contains(test_command, "harn-tests.tar.zst")
    || !contains(test_command, "--workspace-remap")
    || regex_match(
    "(^|[ ])--workspace([ ]|$)",
    test_command,
  )
    != nil {
    errors = errors + ["ci.yml:${job_name} must execute only the remapped nextest archive"]
  }
  if trim(test_step?.env?.CARGO_BUILD_JOBS ?? "") != "" {
    errors = errors + ["ci.yml:${job_name} must not configure compile fan-out"]
  }
  return errors
}

/** Validate the persistent local sccache action and every authorized heavy CI consumer. */
pub fn ci_sccache_policy_errors(action, workflow) -> list<string> {
  let errors: list<string> = []
  const action_steps = action?.runs?.steps ?? []
  const sticky = action_steps.filter({ step -> step_uses(step).starts_with(STICKY_DISK_PREFIX) })
    .to_list()
  if len(sticky) != 1 || step_uses(sticky[0]) != STICKY_DISK_PIN {
    errors = errors + ["${SCCACHE_ACTION_PATH} must use exactly one pinned sticky-disk action"]
  } else {
    if trim(sticky[0]?.if ?? "") != "inputs.sticky == 'true'"
      || !(sticky[0]?.["continue-on-error"]
      ?? false) {
      errors = errors + ["${SCCACHE_ACTION_PATH} sticky storage must be optional and non-fatal"]
    }
    if trim(sticky[0]?.with?.path ?? "") != "~/.cache/sccache"
      || !contains(
      trim(sticky[0]?.with?.key ?? ""),
      "inputs.cache-key",
    ) {
      errors = errors
        + ["${SCCACHE_ACTION_PATH} must persist the lane-keyed local sccache directory"]
    }
  }
  const upstream = matching_steps(
    action?.runs,
    "mozilla-actions/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696",
  )
  if len(upstream) != 1
    || !(upstream[0]?.["continue-on-error"] ?? false)
    || len(
    matching_steps(action?.runs, "./.github/actions/configure-cargo-sccache"),
  )
    != 1 {
    errors = errors
      + [
      "${SCCACHE_ACTION_PATH} must own pinned sccache setup and wrapper configuration",
    ]
  }
  errors = errors
    + persistent_sccache_job_errors(
    workflow,
    "package-audit",
    "blacksmith-4vcpu-ubuntu-2404",
    "vars.${BLACKSMITH_DISABLE_VAR} == 'true'",
  )
    + persistent_sccache_job_errors(
    workflow,
    "rust-builds",
    "matrix.runner",
    "vars.${BLACKSMITH_DISABLE_VAR} == 'true'",
  )
  const rust_job = workflow?.jobs?.["rust-builds"]
  const rust_sccache = matching_steps(rust_job, SCCACHE_ACTION)
  if len(rust_sccache) == 1 {
    const sticky_condition = trim(rust_sccache[0]?.with?.sticky ?? "")
    if !contains(sticky_condition, BLACKSMITH_DISABLE_VAR) {
      errors = errors
        + ["ci.yml:rust-builds sticky storage must follow the Blacksmith kill switch"]
    }
  }
  const matrix = rust_job?.strategy?.matrix?.include ?? []
  const kinds = matrix.map({ row -> trim(row?.kind ?? "") }).to_list()
  const runners = matrix.map({ row -> trim(row?.runner ?? "") }).to_list()
  const cache_keys = matrix.map({ row -> trim(row?.cache_key ?? "") }).to_list()
  if kinds != ["lint", "behavior"]
    || runners
    != [
    "blacksmith-4vcpu-ubuntu-2404",
    "blacksmith-8vcpu-ubuntu-2404",
  ]
    || cache_keys != ["workspace-lint", "workspace-behavior"] {
    errors = errors
      + [
      "ci.yml:rust-builds must keep compile lanes on distinct policy-sized persistent caches",
    ]
  }
  const build_step = step_by_name(rust_job?.steps ?? [], "Build portable behavior payload")
  if trim(build_step?.if ?? "") != "matrix.kind == 'behavior'"
    || trim(
    build_step?.env?.CARGO_BUILD_JOBS ?? "",
  )
    != "4" {
    errors = errors
      + ["ci.yml:rust-builds behavior build must keep four-way fan-out on the producer"]
  }
  errors = errors + archived_behavior_consumer_errors(workflow, "rust-test")
  const allowed = ["package-audit", "rust-builds"]
  for {key: job_name, value: job} in workflow?.jobs ?? {} {
    if len(matching_steps(job, SCCACHE_ACTION)) > 0 && !allowed.contains(job_name) {
      errors = errors + ["ci.yml:${job_name} uses persistent sccache without a lane policy"]
    }
  }
  return errors
}

/** Return every policy violation without stopping at the first workflow. */
pub fn ci_cache_policy_errors(
  policy: CiCachePolicy,
  action,
  node_action,
  workflows: dict,
) -> list<string> {
  let errors = cache_action_errors(policy, action)
    + node_cache_action_errors(node_action)
    + cache_budget_reporter_errors(workflows)
    + cli_cold_start_budget_errors(workflows)
  let observed_writers: list<string> = []
  for workflow in workflows.keys().sort() {
    const document = workflows[workflow]
    errors = errors + remote_sccache_errors(document, workflow)
    const jobs = document?.jobs ?? {}
    for job in jobs.keys().sort() {
      for step in jobs[job]?.steps ?? [] {
        const uses = step_uses(step)
        if uses.starts_with(UPSTREAM_CACHE_PREFIX) {
          errors = errors + ["${workflow}:${job} bypasses ${policy.rust_cache_action}"]
        }
        const ephemeral_error = ephemeral_cache_writer_error(workflow, job, step, policy)
        if ephemeral_error != nil {
          errors = errors + [ephemeral_error]
        }
        if uses == policy.rust_cache_action && save_requested(step) {
          const shared_key = trim(step?.with?.["shared-key"] ?? "")
          const writer = writer_key(workflow, job, shared_key)
          observed_writers = observed_writers + [writer]
          if !writer_allowed(policy, workflow, job, shared_key) {
            errors = errors + ["${writer} is not an authorized persistent cache writer"]
          }
        }
      }
    }
  }
  for writer in policy.writers {
    const key = writer_key(writer.workflow, writer.job, writer.shared_key)
    if !observed_writers.contains(key) {
      errors = errors + ["authorized persistent cache writer is not active: " + key]
    }
  }
  return errors
}

fn main(harness: Harness) {
  const loaded = read_json_result(POLICY_PATH)
  guard is_ok(loaded) else {
    harness.stdio.eprintln(json_stringify(unwrap_err(loaded)))
    exit(1)
  }
  const policy = ci_cache_policy_parse(unwrap(loaded))
  guard policy != nil else {
    harness.stdio.eprintln("invalid CI cache policy: " + POLICY_PATH)
    exit(1)
  }
  const action = read_yaml(ACTION_PATH, nil)
  const node_action = read_yaml(NODE_ACTION_PATH, nil)
  const sccache_action = read_yaml(SCCACHE_ACTION_PATH, nil)
  let workflows = {}
  for path in harness.fs.glob(WORKFLOW_GLOB).sort() {
    workflows[workflow_name(path)] = read_yaml(path, nil)
  }
  const errors = ci_cache_policy_errors(policy, action, node_action, workflows)
    + ci_sccache_policy_errors(
    sccache_action,
    workflows["ci.yml"],
  )
    + windows_shared_cache_errors(workflows["ci.yml"], workflows["windows-nightly.yml"])
  if len(errors) > 0 {
    harness.stdio.eprintln("CI cache policy violations:")
    for error in errors {
      harness.stdio.eprintln("  - " + error)
    }
    exit(1)
  }
  harness.stdio.println(
    "CI cache policy: OK (${len(workflows.keys())} workflows, ${len(policy.writers)} Rust writer)",
  )
}
