// Static checks for stable Harn diagnostic codes.
//
// Ported from scripts/check_diagnostic_codes.py. Behavior-identical: same
// registry-entry regex + duplicate/category/identifier validation, same
// struct-literal `code:` requirement (with the same impl / return-type /
// definition prefix exclusions), same `self.<helper>(` and `FormatError::new(`
// "must pass Code::* first" rule, and the same unknown-`Code::Variant` scan.
// On success prints `diagnostic codes: OK` to stdout and exits 0; on any
// failure prints the failure header + bullet list to stderr and exits 1.
//
// Pure logic lives in `pub fn`s that take source text directly so the paired
// test can drive them with no filesystem. `main` does the globbing/reads.
let REGISTRY = "crates/harn-parser/src/diagnostic_codes.rs"

// Ordered so `missing` reporting matches Python's `sorted(...)`.
let CATEGORIES = [
  "Cap",
  "Cmp",
  "Cst",
  "Fmt",
  "Imp",
  "Llm",
  "Lnt",
  "Mat",
  "Met",
  "Mod",
  "Nam",
  "Orc",
  "Own",
  "Par",
  "Pol",
  "Prm",
  "Rcv",
  "Rmd",
  "Std",
  "Sus",
  "Typ",
]

let HELPERS = [
  "error_at_with_help",
  "error_at_with_fix",
  "error_at",
  "type_mismatch_at",
  "exhaustiveness_error_with_missing",
  "exhaustiveness_error_at",
  "warning_at_with_help",
  "warning_at",
  "lint_warning_at_with_fix",
]

/**
 * 1-based line number of char offset `offset` in `text` — mirrors Python's
 * `text.count("\n", 0, offset) + 1`.
 */
pub fn line_of(text: string, offset: int) -> int {
  let prefix = text.substring(0, offset)
  return prefix.split("\n").count
}

/**
 * Repo-relative path for a recursive-glob result. Glob yields absolute paths
 * with a `/./` marker between the search root and the matched suffix; the
 * suffix is exactly the Python `relative_to(ROOT)` form.
 */
pub fn rel_path(path: string) -> string {
  let idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/**
 * Find `needle` in `text` at or after char offset `start`; returns the char
 * offset or -1. Mirrors Python `text.find(needle, start)`.
 */
pub fn find_from(text: string, needle: string, start: int) -> int {
  if start >= text.len() {
    return -1
  }
  let tail = text.substring(start, text.len())
  let rel = tail.index_of(needle)
  if rel < 0 {
    return -1
  }
  return start + rel
}

/**
 * True when `text` has `needle` starting exactly at char offset `offset` —
 * mirrors Python `text.startswith(needle, offset)`.
 */
pub fn starts_with_at(text: string, needle: string, offset: int) -> bool {
  let nlen = needle.len()
  if offset < 0 {
    return false
  }
  if offset + nlen > text.len() {
    return false
  }
  return text.substring(offset, offset + nlen) == needle
}

/**
 * First non-whitespace char offset at or after `offset` — mirrors Python
 * `first_non_ws` (`str.isspace`: space, tab, CR, LF, form-feed, vtab). A char
 * is whitespace iff trimming it yields the empty string; Rust's `char::trim`
 * (== `char::is_whitespace`) covers the same ASCII set plus form-feed/vtab,
 * so this matches Python for every byte that can appear in Rust source.
 */
pub fn first_non_ws(text: string, offset: int) -> int {
  let n = text.len()
  var i = offset
  while i < n {
    let ch = text.char_at(i)
    if ch.trim() != "" {
      return i
    }
    i = i + 1
  }
  return i
}

/**
 * Map a registry category enum variant (`Typ`) to its 3-letter code (`TYP`).
 * Returns nil for an unknown variant (never hit because callers gate on
 * CATEGORIES first, matching the Python dict-lookup contract).
 */
pub fn category_code(category: string) -> string? {
  if CATEGORIES.contains(category) {
    return category.upper()
  }
  return nil
}

/**
 * Validate the diagnostic-code registry text. Returns
 * `{variants: list<string>, errors: list<string>}` where `variants` is the
 * set of registered enum-variant names (used later to flag unknown
 * `Code::*`). `errors` is appended in the same order as the Python loop.
 */
pub fn check_registry_text(text: string) -> any {
  var errors: list<string> = []
  let entries = regex_captures(r#"^\s*([A-Za-z][A-Za-z0-9_]*),\s+"([^"]+)",\s+([A-Za-z]+),"#, text, "m")
  if entries.count < 40 {
    errors = errors
      + ["${REGISTRY}: expected at least 40 registered codes, found ${entries.count}"]
  }
  var seen_ids: list<string> = []
  var seen_variants: list<string> = []
  var seen_categories: list<string> = []
  for entry in entries {
    let variant = entry.groups[0]
    let identifier = entry.groups[1]
    let category = entry.groups[2]
    if seen_ids.contains(identifier) {
      errors = errors + ["${REGISTRY}: duplicate diagnostic identifier ${identifier}"]
    }
    if !seen_ids.contains(identifier) {
      seen_ids = seen_ids + [identifier]
    }
    if seen_variants.contains(variant) {
      errors = errors + ["${REGISTRY}: duplicate diagnostic variant ${variant}"]
    }
    if !seen_variants.contains(variant) {
      seen_variants = seen_variants + [variant]
    }
    if !CATEGORIES.contains(category) {
      errors = errors + ["${REGISTRY}: unknown category enum variant ${category}"]
      continue
    }
    let m = regex_captures(r"^HARN-([A-Z]{3})-\d{3}$", identifier, "")
    if m.count == 0 {
      errors = errors + ["${REGISTRY}: malformed diagnostic identifier ${identifier}"]
      continue
    }
    let category_text = m[0].groups[0]
    if category_text != category_code(category) {
      errors = errors
        + ["${REGISTRY}: identifier ${identifier} does not match category ${category}"]
    }
    if !seen_categories.contains(category) {
      seen_categories = seen_categories + [category]
    }
  }
  var missing: list<string> = []
  for category in CATEGORIES {
    if !seen_categories.contains(category) {
      missing = missing + [category]
    }
  }
  if missing.count > 0 {
    errors = errors + ["${REGISTRY}: missing populated categories ${format_str_list(missing)}"]
  }
  return {variants: seen_variants, errors: errors}
}

/**
 * Render a list of strings the way Python's `f"{sorted(missing)}"` does:
 * `['a', 'b']`. `CATEGORIES` is already sorted, so the caller's `missing`
 * preserves sorted order.
 */
pub fn format_str_list(items: list<string>) -> string {
  var parts: list<string> = []
  for item in items {
    parts = parts + ["'${item}'"]
  }
  return "[" + parts.join(", ") + "]"
}

/**
 * Locate `needle` ("Foo {") occurrences in `text` and brace-match each to its
 * closing `}`. Returns `{start, end}` char-offset records (end exclusive).
 * Mirrors Python `find_struct_literals`: when a brace never closes, the final
 * span runs to end-of-text.
 */
pub fn find_struct_literals(text: string, needle: string) -> list {
  var out: list = []
  let n = text.len()
  var start = 0
  while true {
    let idx = find_from(text, needle, start)
    if idx < 0 {
      return out
    }
    let brace = find_from(text, "{", idx)
    var depth = 0
    var end = -1
    var pos = brace
    while pos < n {
      let ch = text.char_at(pos)
      if ch == "{" {
        depth = depth + 1
      } else if ch == "}" {
        depth = depth - 1
        if depth == 0 {
          end = pos + 1
          pos = n
        }
      }
      pos = pos + 1
    }
    if end < 0 {
      out = out + [{start: idx, end: n}]
      return out
    }
    out = out + [{start: idx, end: end}]
    start = end
  }
}

/**
 * Check one file's `text` for `<name> { ... }` struct literals missing a
 * `code:`/`code,` field. Returns violation strings `rel:line: <name> literal
 * missing code`. Skips the struct definition, impl blocks, and return-type
 * openings exactly as the Python `check_struct_literals` does.
 */
pub fn check_struct_literals_text(rel: string, name: string, text: string) -> list<string> {
  var out: list<string> = []
  let needle = "${name} {"
  let def_marker = "pub struct ${name}"
  let prefix_pat = r"(?:\bimpl(?:\s*<[^>]*>)?\s+(?:[\w:]+::)?|->\s*(?:[\w:]+::)?)$"
  for lit in find_struct_literals(text, needle) {
    let start = lit.start
    let end = lit.end
    var pstart = start - 80
    if pstart < 0 {
      pstart = 0
    }
    let prefix = text.substring(pstart, start)
    if prefix.contains(def_marker) {
      continue
    }
    if regex_captures(prefix_pat, prefix, "").count > 0 {
      continue
    }
    let block = text.substring(start, end)
    if regex_captures(r"\bcode\s*[:,]", block, "").count == 0 {
      out = out + ["${rel}:${line_of(text, start)}: ${name} literal missing code"]
    }
  }
  return out
}

/**
 * Check that every `self.<helper>(` call in `text` passes `Code::*` as its
 * first argument. Returns violation strings. Mirrors
 * `check_typechecker_helper_calls` (per-file body; mod.rs skipping happens in
 * the caller).
 */
pub fn check_helper_calls_text(rel: string, text: string) -> list<string> {
  var out: list<string> = []
  for helper in HELPERS {
    let needle = "self.${helper}("
    let nlen = needle.len()
    var start = 0
    while true {
      let idx = find_from(text, needle, start)
      if idx < 0 {
        start = -1
      } else {
        let arg = first_non_ws(text, idx + nlen)
        if !starts_with_at(text, "Code::", arg) {
          out = out
            + ["${rel}:${line_of(text, idx)}: self.${helper} must pass Code::* first"]
        }
        start = idx + nlen
      }
      if start < 0 {
        break
      }
    }
  }
  return out
}

/**
 * Check that every `<needle>(` call (e.g. `FormatError::new(`) passes `Code::*`
 * first. Returns violation strings. Mirrors `check_code_constructor_calls`.
 */
pub fn check_constructor_calls_text(rel: string, needle: string, text: string) -> list<string> {
  var out: list<string> = []
  let call = "${needle}("
  let clen = call.len()
  var start = 0
  while true {
    let idx = find_from(text, call, start)
    if idx < 0 {
      start = -1
    } else {
      let arg = first_non_ws(text, idx + clen)
      if !starts_with_at(text, "Code::", arg) {
        out = out + ["${rel}:${line_of(text, idx)}: ${needle} must pass Code::* first"]
      }
      start = idx + clen
    }
    if start < 0 {
      break
    }
  }
  return out
}

/**
 * Flag `Code::Variant` references whose UpperCamelCase variant name is not in
 * `code_names`. Snake_case inherent methods (`Code::repair_template()`) are
 * intentionally ignored. Mirrors `check_unknown_code_variants`'s per-file body.
 */
pub fn check_unknown_variants_text(rel: string, text: string, code_names: list<string>) -> list<string> {
  var out: list<string> = []
  for m in regex_captures(r"\bCode::([A-Z][A-Za-z0-9_]*)", text, "") {
    let variant = m.groups[0]
    if !code_names.contains(variant) {
      out = out + ["${rel}:${line_of(text, m.start)}: unknown Code::${variant}"]
    }
  }
  return out
}

pipeline main(task) {
  var errors: list<string> = []
  let registry_text = harness.fs.read_text(REGISTRY)
  let reg = check_registry_text(registry_text)
  let code_names: list<string> = reg.variants
  errors = errors + reg.errors
  errors = errors + scan_struct_literals("LintDiagnostic", "crates/harn-lint/src")
  errors = errors + scan_struct_literals("TypeDiagnostic", "crates/harn-parser/src")
  errors = errors
    + scan_struct_literals("PreflightDiagnostic", "crates/harn-cli/src/commands/check")
  errors = errors + scan_helper_calls("crates/harn-parser/src/typechecker")
  errors = errors + scan_constructor_calls("crates/harn-fmt/src", "FormatError::new")
  errors = errors + scan_unknown_variants(code_names)
  if errors.count > 0 {
    __io_eprintln("diagnostic code check failed:")
    for error in errors {
      __io_eprintln("  - ${error}")
    }
    return 1
  }
  __io_println("diagnostic codes: OK")
  return 0
}

/**
 * Filesystem-backed scan wrappers (kept out of the pure helpers).
 *
 * Recursively glob every `.rs` file beneath `root` and return them sorted, so
 * the scan order matches Python's `sorted(root.rglob("*.rs"))`.
 */
fn sorted_rs_files(root: string) -> list<string> {
  var paths: list<string> = []
  for path in harness.fs.glob("${root}/**/*.rs") {
    paths = paths + [path]
  }
  return paths.sort()
}

fn scan_struct_literals(name: string, root: string) -> list<string> {
  var out: list<string> = []
  for path in sorted_rs_files(root) {
    let rel = rel_path(path)
    let text = harness.fs.read_text(path)
    out = out + check_struct_literals_text(rel, name, text)
  }
  return out
}

fn scan_helper_calls(root: string) -> list<string> {
  var out: list<string> = []
  for path in sorted_rs_files(root) {
    let rel = rel_path(path)
    if rel.ends_with("/mod.rs") || rel == "mod.rs" {
      continue
    }
    let text = harness.fs.read_text(path)
    out = out + check_helper_calls_text(rel, text)
  }
  return out
}

fn scan_constructor_calls(root: string, needle: string) -> list<string> {
  var out: list<string> = []
  for path in sorted_rs_files(root) {
    let rel = rel_path(path)
    let text = harness.fs.read_text(path)
    out = out + check_constructor_calls_text(rel, needle, text)
  }
  return out
}

fn scan_unknown_variants(code_names: list<string>) -> list<string> {
  var out: list<string> = []
  let roots = [
    "crates/harn-parser/src",
    "crates/harn-lint/src",
    "crates/harn-fmt/src",
    "crates/harn-cli/src/commands/check",
    "crates/harn-lsp/src",
  ]
  for root in roots {
    for path in sorted_rs_files(root) {
      let rel = rel_path(path)
      if rel == REGISTRY {
        continue
      }
      let text = harness.fs.read_text(path)
      out = out + check_unknown_variants_text(rel, text, code_names)
    }
  }
  return out
}
