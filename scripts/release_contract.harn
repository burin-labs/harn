import { read_json_result } from "std/fs"
import "std/schema"
import { path_visibility } from "./path_visibility.harn"

const DEVELOPMENT_PRERELEASE = "dev"

pub type ReleaseVersionContract = {
  development_prerelease: "dev",
  workspace_after_release: "next_patch_development",
  prior_fold_workspace_shapes: list<"released_version" | "next_patch_development">,
}

pub type ReleaseTagContract = {
  anchor: "certified_candidate_commit",
  release_subject_template: "Release v{version}",
  candidate_trailer: "Harn-Release-Candidate",
}

pub type ReleaseContract = {
  schema_version: "harn.release_contract.v1",
  versions: ReleaseVersionContract,
  changelog: {published_heading: "top_version_heading", candidate_fragments: "must_be_folded"},
  tag: ReleaseTagContract,
}

/** Harn's release semantics, projected for orchestrators and recovery tools. */
pub fn release_contract() -> ReleaseContract {
  return {
    schema_version: "harn.release_contract.v1",
    versions: {
      development_prerelease: DEVELOPMENT_PRERELEASE,
      workspace_after_release: "next_patch_development",
      prior_fold_workspace_shapes: ["released_version", "next_patch_development"],
    },
    changelog: {published_heading: "top_version_heading", candidate_fragments: "must_be_folded"},
    tag: {
      anchor: "certified_candidate_commit",
      release_subject_template: "Release v{version}",
      candidate_trailer: "Harn-Release-Candidate",
    },
  }
}

/** The suffix used by Harn's release metadata implementation. */
pub fn release_development_prerelease() -> string {
  return DEVELOPMENT_PRERELEASE
}

pub fn release_contract_schema() {
  return schema_closed_object(
    {
      schema_version: schema_literal("harn.release_contract.v1"),
      versions: schema_closed_object(
        {
          development_prerelease: schema_literal("dev"),
          workspace_after_release: schema_literal("next_patch_development"),
          prior_fold_workspace_shapes: schema_list(
            schema_enum(["released_version", "next_patch_development"]),
          ),
        },
      ),
      changelog: schema_closed_object(
        {
          published_heading: schema_literal("top_version_heading"),
          candidate_fragments: schema_literal("must_be_folded"),
        },
      ),
      tag: schema_closed_object(
        {
          anchor: schema_literal("certified_candidate_commit"),
          release_subject_template: schema_literal("Release v{version}"),
          candidate_trailer: schema_literal("Harn-Release-Candidate"),
        },
      ),
    },
  )
}

pub fn release_contract_parse(value: unknown) -> ReleaseContract? {
  const report = schema_validator(release_contract_schema()).report(value)
  if !report.ok {
    return nil
  }
  return report.value
}

/** Owning sources that must consume the generated contract instead of restating it. */
pub fn release_contract_source_errors(fs: HarnessFs, root: string) -> list<string> {
  let errors: list<string> = []
  const version_source = fs.read_text(path_join(root, "scripts/release_metadata.harn"))
  if !version_source.contains("release_development_prerelease()") {
    errors = errors + ["release_metadata.harn bypasses the typed development-prerelease owner"]
  }
  const version_source_shell = fs.read_text(path_join(root, "scripts/lib/release_version.sh"))
  if !version_source_shell.contains("release_contract.env") {
    errors = errors + ["release_version.sh bypasses the generated shell projection"]
  }
  if !version_source_shell.contains("^Release\\ v\"$version\"") {
    errors = errors + ["release_version.sh no longer enforces the declared release commit subject"]
  }
  return errors
}

fn flag_value(args: list<string>, name: string, fallback: string) -> string {
  let index = 0
  for arg in args {
    if arg == name && index + 1 < len(args) {
      return args[index + 1] ?? fallback
    }
    index = index + 1
  }
  return fallback
}

fn main(harness: Harness) {
  const root = flag_value(argv, "--root", ".")
  const output = flag_value(argv, "--output", "scripts/release_contract.json")
  const shell_output = flag_value(argv, "--shell-output", "scripts/release_contract.env")
  const check = argv.contains("--check")
  const contract = release_contract()
  const rendered = json_stringify(contract) + "\n"
  const errors = release_contract_source_errors(harness.fs, root)
  if len(errors) > 0 {
    for error in errors {
      harness.stdio.eprintln("release contract: " + error)
    }
    harness.runtime.exit(1)
  }
  const path = path_join(root, output)
  const shell_path = path_join(root, shell_output)
  const shell_rendered = "HARN_RELEASE_DEVELOPMENT_PRERELEASE="
    + contract.versions.development_prerelease
    + "\n"
  if check {
    const loaded = read_json_result(harness.fs, path)
    if is_err(loaded) || release_contract_parse(unwrap(loaded)) == nil
      || harness.fs.read_text(path) != rendered {
      harness.stdio.eprintln("release contract projection is stale; run make gen-release-contract")
      harness.runtime.exit(1)
    }
    const shell_seen = path_visibility(harness.fs, "release-contract", shell_path)
    if shell_seen.denial != "" {
      harness.stdio.eprintln(shell_seen.denial)
      harness.runtime.exit(1)
    }
    if !shell_seen.exists || harness.fs.read_text(shell_path) != shell_rendered {
      harness.stdio.eprintln(
        "release contract shell projection is stale; run make gen-release-contract",
      )
      harness.runtime.exit(1)
    }
    harness.stdio.println("release contract projection and owning sources agree")
    return
  }
  harness.fs.write_text(path, rendered)
  harness.fs.write_text(shell_path, shell_rendered)
  harness.stdio.println("wrote " + path + " and " + shell_path)
}
