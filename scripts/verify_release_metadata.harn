// Port of scripts/verify_release_metadata.py.
//
// Validates that Cargo.toml's workspace version is consistent with
// CHANGELOG.md (canonical `## vX.Y.Z` headings, descending semver order,
// non-empty top section), renders the release notes for the effective
// version, and rejects git tag states that would silently re-release or
// rewrite history.
//
// Exits 0 on success (prints a `verified release metadata ...` line);
// exits non-zero with an `error: ...` message on any failed check.
import { compare_release, next, parse, parse_release } from "std/semver"
import { git_error_detail, resolve_commit } from "./git_base.harn"
import { development_version_from_stable } from "./release_metadata.harn"
import {
  ReleaseWithdrawal,
  load_release_withdrawals,
  release_distribution_version,
  release_withdrawal_for_tag,
} from "./release_withdrawals.harn"
import {
  extract_section,
  normalize_version,
  previous_version,
  render_notes,
} from "./render_release_notes.harn"

const CARGO_PATH = "Cargo.toml"

const CHANGELOG_PATH = "CHANGELOG.md"

const MANIFEST_PATH = "spec/protocol-artifacts/manifest.json"

const ACP_AGENT_MANIFEST_PATH = "spec/acp-registry/harn/agent.json"

const RELEASE_WITHDRAWALS_PATH = ".github/release-withdrawals.json"

type AcpArchiveVersion = {archive: string, version: string}

/**
 * Pull the workspace `version = "X.Y.Z"` literal from Cargo.toml text.
 * Throws the canonical error when the line is missing.
 */
pub fn current_version(cargo_text: string) -> string {
  const caps = regex_captures(r#"(?m)^version = "([^"]+)""#, cargo_text)
  if caps.count == 0 {
    throw "error: missing workspace version in Cargo.toml"
  }
  return caps[0].groups[0]
}

/**
 * Pull `artifactVersion` from the protocol-artifact manifest JSON text.
 * `make gen-protocol-artifacts` regenerates this from the crate version, so a
 * version bump that forgets to regenerate leaves it stale. Throws the canonical
 * error when the field is missing.
 */
pub fn protocol_artifact_version(manifest_text: string) -> string {
  const caps = regex_captures(r#""artifactVersion"\s*:\s*"([^"]+)""#, manifest_text)
  if caps.count == 0 {
    throw "error: missing artifactVersion in " + MANIFEST_PATH
  }
  return caps[0].groups[0]
}

/**
 * Pull the top-level ACP Agent Registry manifest version from JSON text.
 * The manifest is the editor-installable binary distribution entry, so it
 * must track the Cargo package version that produced the release assets.
 */
pub fn acp_agent_manifest_version(manifest_text: string) -> string {
  const manifest = json_parse(manifest_text)
  const version = json_pointer(manifest, "/version")
  if type_of(version) != "string" {
    throw "error: missing version in " + ACP_AGENT_MANIFEST_PATH
  }
  return version
}

/**
 * Return every release version embedded in the ACP manifest's binary archive
 * URLs, paired with the source URL for precise failure messages.
 */
pub fn acp_agent_manifest_archive_versions(manifest_text: string) -> list<AcpArchiveVersion> {
  const manifest = json_parse(manifest_text)
  const archives = jq(manifest, ".distribution.binary[] | .archive")
  if archives.count == 0 {
    throw "error: missing binary archive URLs in " + ACP_AGENT_MANIFEST_PATH
  }
  let versions = []
  for archive in archives {
    if type_of(archive) != "string" {
      throw "error: non-string binary archive URL in " + ACP_AGENT_MANIFEST_PATH
    }
    const caps = regex_captures(r"/releases/download/v([^/]+)/", archive)
    if caps.count == 0 {
      throw "error: binary archive URL in " + ACP_AGENT_MANIFEST_PATH
        + " does not include a GitHub release version: "
        + archive
    }
    versions = versions + [{archive: archive, version: caps[0].groups[0]}]
  }
  return versions
}

/** Ensure the ACP Agent Registry manifest points at the install-facing release. */
pub fn check_acp_agent_manifest(manifest_text: string, version: string) {
  const manifest_version = acp_agent_manifest_version(manifest_text)
  if manifest_version != version {
    throw "error: " + ACP_AGENT_MANIFEST_PATH + " version " + manifest_version
      + " does not match expected release projection version "
      + version
  }
  for item in acp_agent_manifest_archive_versions(manifest_text) {
    if item.version != version {
      throw "error: " + ACP_AGENT_MANIFEST_PATH + " archive " + item.archive
        + " points at v"
        + item.version
        + " instead of expected release projection v"
        + version
    }
  }
}

/** Return every canonical stable or prerelease heading version, in file order. */
pub fn changelog_versions(text: string) -> list<string> {
  let out = []
  for line in text.lines() {
    if !line.starts_with("## v") {
      continue
    }
    const version = line.substring(4, line.len())
    if parse_release(version) != nil {
      out = out + [version]
    }
  }
  return out
}

/**
 * Return the body content under `## vX.Y.Z` up to the next heading
 * (any `## ` line) or end of file, with surrounding whitespace trimmed.
 * Returns the empty string when the section is absent.
 */
pub fn changelog_section_body(text: string, version: string) -> string {
  const heading = "## v" + version
  const lines = text.lines()
  let collecting = false
  let body = []
  for line in lines {
    if collecting {
      if line.starts_with("## ") {
        break
      }
      body = body + [line]
    } else if line == heading {
      collecting = true
    }
  }
  if !collecting {
    return ""
  }
  return body.join("\n").trim()
}

/**
 * Catch headings that look like version markers but won't parse. Flags
 * lines that start with a full 3-component `## vX.Y.Z` prefix followed by
 * extra characters (trailing whitespace or a suffix). Two-component
 * historical headings like `## v0.5 series (...)` are ignored.
 */
pub fn detect_misformatted_headings(text: string) -> list<string> {
  let suspicious = []
  for line in text.lines() {
    const m = regex_captures(r"^## v\d+\.\d+\.\d+", line)
    if m.count == 0 {
      continue
    }
    const candidate = line.substring(4, line.len())
    if parse_release(candidate) == nil {
      suspicious = suspicious + [line]
    }
  }
  return suspicious
}

/**
 * True when the top CHANGELOG entry is exactly one patch/minor/major step
 * ahead of the Cargo.toml version — the intermediate "release content
 * committed, version bump not yet applied" state the workflow produces.
 */
pub fn is_bump_ahead(cargo_version: string, changelog_version: string) -> bool {
  const cur = parse_release(cargo_version)
  const target = parse_release(changelog_version)
  if cur == nil || target == nil {
    return false
  }
  for bump in ["patch", "minor", "major"] {
    if next(cargo_version, bump) == changelog_version {
      return true
    }
  }
  if target.prerelease == nil {
    return false
  }
  const parts = target.prerelease.split(".")
  const last = parts[parts.count - 1]
  const preid = if regex_match("^[0-9]+$", last) != nil && parts.count > 1 {
    parts.slice(0, parts.count - 1).join(".")
  } else {
    target.prerelease
  }
  for bump in ["prepatch", "preminor", "premajor", "prerelease"] {
    if next(cargo_version, bump, preid) == changelog_version {
      return true
    }
  }
  return false
}

/** True for the one valid mid-cycle relationship to the latest release. */
pub fn is_development_after_release(workspace_version: string, released_version: string) -> bool {
  if parse(released_version) == nil {
    return false
  }
  return development_version_from_stable(released_version) == workspace_version
}

/** True when `versions` is already in strictly/weakly descending semver order. */
pub fn is_descending(versions: list<string>) -> bool {
  let i = 1
  while i < versions.count {
    if compare_release(versions[i - 1] ?? "", versions[i] ?? "") < 0 {
      return false
    }
    i = i + 1
  }
  return true
}

/** True when any version appears more than once in the list. */
pub fn has_duplicates(versions: list<string>) -> bool {
  let seen = []
  for v in versions {
    if seen.contains(v) {
      return true
    }
    seen = seen + [v]
  }
  return false
}

/**
 * Run the pure content checks against Cargo.toml and CHANGELOG.md text.
 * Returns the effective version (the version subsequent git/render checks
 * should validate against). Throws the canonical `error: ...` string on
 * any failed check.
 */
pub fn check_metadata(cargo_text: string, changelog_text: string) -> string {
  const version = current_version(cargo_text)
  const misformatted = detect_misformatted_headings(changelog_text)
  if misformatted.count > 0 {
    const joined = misformatted.join("\n  ")
    throw "error: CHANGELOG.md has heading(s) that look like version markers but "
      + "don't match canonical stable or prerelease SemVer (no trailing whitespace "
      + "or build metadata):\n  "
      + joined
  }
  const versions = changelog_versions(changelog_text)
  if versions.count == 0 {
    throw "error: CHANGELOG.md does not contain any version headings"
  }
  // `versions` is non-empty (guarded above), so `versions[0]` is present; the
  // `?? ""` satisfies index soundness without changing behavior.
  const top = versions[0] ?? ""
  const body = changelog_section_body(changelog_text, top)
  if body == "" {
    throw "error: CHANGELOG.md '## v" + top + "' section has no body content; release "
      + "notes would be empty. Add bullet points describing the release."
  }
  let effective_version = version
  if top != version {
    if is_development_after_release(version, top) {
      effective_version = top
    } else if is_bump_ahead(version, top) {
      effective_version = top
    } else {
      throw "error: Cargo.toml version " + version + " does not match top changelog entry "
        + top
        + " (and the delta is not one requested release bump)"
    }
  }
  if has_duplicates(versions) {
    throw "error: CHANGELOG.md contains duplicate version headings"
  }
  if !is_descending(versions) {
    throw "error: CHANGELOG.md versions are not in descending semver order"
  }
  return effective_version
}

/** Build the success message for the given Cargo.toml + effective version. */
pub fn success_message(version: string, effective_version: string) -> string {
  if effective_version == version {
    return "verified release metadata for v" + version
  }
  if is_development_after_release(version, effective_version) {
    return "verified development metadata for v" + version
      + " (latest release v"
      + effective_version
      + ")"
  }
  return "verified release metadata for v" + effective_version
    + " (Cargo.toml still at v"
    + version
    + "; bump pending)"
}

/**
 * Smoke-check that the release notes render for `version`, calling the
 * render_release_notes module in-process (the Python spawned the script as
 * a subprocess; both are Harn now, so we dogfood the module directly). The
 * only failure mode is a missing/empty `## v<version>` section, which
 * `extract_section` throws on — mirroring the non-zero subprocess exit.
 */
fn verify_release_notes(fs: HarnessFs, stdio: HarnessStdio, version: string) {
  const changelog = fs.read_text(CHANGELOG_PATH)
  const normalized = normalize_version(version)
  const section = try {
    extract_section(changelog, normalized)
  } catch (err) {
    stdio.eprintln("error: failed to render release notes for current version")
    stdio.eprintln("${err}")
    throw "release-notes-failed"
  }
  // render_notes is total given a valid section; exercising it confirms the
  // full render path the Python subprocess covered.
  const prev = previous_version(changelog_versions(changelog), normalized)
  const _ = render_notes(section, nil, prev, normalized)
}

/**
 * Reject git tag states that would silently re-release or rewrite history.
 * Passes when the tag is absent, HEAD is at/descends from the tagged
 * commit, HEAD carries an equivalent `Release vX.Y.Z` commit, or the closed
 * withdrawal registry binds the immutable tag to this version exactly.
 */
fn head_contains_release_commit(process: HarnessProcess, version: string) -> bool {
  const release = process.run(
    {
      program: "git",
      args: [
        "log",
        "--format=%H",
        "--grep=^Release v" + version + "( |$|\\()",
        "--extended-regexp",
        "-n",
        "1",
        "HEAD",
      ],
    },
  )
  return release.success && release.stdout.trim() != ""
}

fn verify_tag_state(
  process: HarnessProcess,
  withdrawals: list<ReleaseWithdrawal>,
  version: string,
) -> nil {
  const tag = "v" + version
  // Establish that git works before reading anything from it. Every check
  // below treats a failed command as "no tag" and returns clean, so an
  // unusable git turned the whole tag-state gate into a no-op that still
  // reported success.
  const head_commit = resolve_commit(process, "HEAD")
  if head_commit.error != "" {
    throw "error: cannot verify release tag state — git could not resolve HEAD: "
      + head_commit.error
  }
  const tag_lookup = process.run(
    {program: "git", args: ["rev-parse", "-q", "--verify", "refs/tags/" + tag]},
  )
  if !tag_lookup.success {
    // With HEAD resolvable, `rev-parse -q --verify` failing means the tag is
    // genuinely absent: nothing has been released at this version yet.
    return
  }
  const head = head_commit.sha
  const tag_rev = process.run({program: "git", args: ["rev-list", "-n", "1", tag]})
  if !tag_rev.success {
    throw "error: cannot verify release tag state — " + tag
      + " resolves but git could not read its commit: "
      + git_error_detail(tag_rev.stderr, tag_rev.exit_code)
  }
  const tag_commit = tag_rev.stdout.trim()
  if head == tag_commit {
    return
  }
  const is_descendant = process.run(
    {program: "git", args: ["merge-base", "--is-ancestor", tag_commit, head]},
  )
  if is_descendant.success {
    return
  }
  if head_contains_release_commit(process, version) {
    return
  }
  const withdrawal = release_withdrawal_for_tag(withdrawals, version, tag_commit)
  if withdrawal != nil {
    if head_contains_release_commit(process, withdrawal.distribution_version) {
      return
    }
    throw "error: withdrawal for v" + version
      + " matches immutable tag commit "
      + tag_commit
      + ", but HEAD has no `Release v"
      + withdrawal.distribution_version
      + "` lineage commit"
  }
  throw "error: current version " + version + " is already tagged at " + tag_commit
    + ", but HEAD ("
    + head
    + ") does not include that commit and has no "
    + "`Release "
    + tag
    + "` commit of its own; either bump the version or "
    + "rebase onto the tagged commit before continuing"
}

pipeline main(harness: Harness, task: unknown) {
  try {
    const cargo_text = harness.fs.read_text(CARGO_PATH)
    const changelog_text = harness.fs.read_text(CHANGELOG_PATH)
    const version = current_version(cargo_text)
    const effective_version = check_metadata(cargo_text, changelog_text)
    // Fast staleness guard: `make gen-protocol-artifacts` stamps the crate
    // version into the manifest, so a version bump that skipped the regen is
    // caught here instead of by the slow `check-protocol-artifacts` audit.
    const manifest_text = harness.fs.read_text(MANIFEST_PATH)
    const artifact_version = protocol_artifact_version(manifest_text)
    if artifact_version != version {
      throw "error: " + MANIFEST_PATH + " artifactVersion " + artifact_version
        + " does not match Cargo.toml version "
        + version
        + "; run `make gen-protocol-artifacts` (and "
        + "scripts/sync_protocol_fixture_runtime_versions.harn) after bumping the version"
    }
    const withdrawals = load_release_withdrawals(harness.fs, RELEASE_WITHDRAWALS_PATH)
    const distribution_source = if is_development_after_release(version, effective_version) {
      effective_version
    } else {
      version
    }
    const distribution_version = release_distribution_version(withdrawals, distribution_source)
    const acp_manifest_text = harness.fs.read_text(ACP_AGENT_MANIFEST_PATH)
    check_acp_agent_manifest(acp_manifest_text, distribution_version)
    verify_release_notes(harness.fs, harness.stdio, effective_version)
    verify_tag_state(harness.process, withdrawals, effective_version)
    harness.stdio.println(success_message(version, effective_version))
    return 0
  } catch (e) {
    if e == "release-notes-failed" {
      return 1
    }
    const message = to_string(e)
    harness.stdio.eprintln(message.starts_with("error: ") ? message : "error: " + message)
    return 1
  }
}
