// Lint script that fails if forbidden patterns appear in test files outside an
// explicit per-pattern allowlist or count baseline.
//
// The wall-clock patterns cause flaky tests because they race against scheduler
// behavior and system load. Their approved replacements use injected time
// (tokio::time::pause/advance), event subscriptions, or deterministic
// harnesses. Direct shell spawns also drop platform-independent coverage on
// Windows, so new process probes use the Cargo-built cross-platform helper.
//
// Ported from scripts/lint_test_patterns.sh — same file selection, same
// per-pattern allowlists, same `  <line>:<content>` + hint output, same
// FAIL/OK summary and exit codes.
//
// Usage: harn run scripts/lint_test_patterns.harn
//   Exits 0 if no violations found, 1 otherwise.
//
// To suppress a false-positive, add the file to the appropriate per-pattern
// allowlist below with a brief comment explaining why. All suppressions are
// pre-existing technical debt tracked under the deflake epic; new entries
// require explicit reviewer justification.

// -------------------------------------------------------------------------------------------------

// Per-pattern allowlists — pre-existing violations from before the deflake
// epic. Remove entries as each tier of #1057 completes.

// -------------------------------------------------------------------------------------------------

// std::thread::sleep in test files
// Legitimate uses: waiting on real subprocess I/O that cannot be time-paused.
const THREAD_SLEEP_ALLOWLIST: list<string> = [
  "crates/harn-hostlib/tests/harn_hostlib/process_tools.rs",
  // Real subprocess lifecycle e2e: probes OS process-group death and
  // `background: true` survival, so the waits observe host process state.
  "crates/harn-hostlib/tests/harn_hostlib/process_tools_e2e.rs",
  // Physical lease-ownership e2e: waits for an orphaned Cargo PID to become
  // observable/dead across exact SIGKILL boundaries.
  "crates/harn-cli/tests/harn_cli_e2e/host_lease_crash_cli.rs",
  // Pre-existing interrupt-preemption test for a real subprocess: a spawned
  // thread sleeps briefly to stage a delayed cancel-token flip (the shape a
  // scope cancellation / deadline expiry takes mid-wait), proving the wait
  // loop terminates the child and its grandchild. Extracted from process.rs's
  // inline test mod, which was previously below this lint's file filter.
  "crates/harn-vm/src/stdlib/process_tests.rs",
]

// tokio::time::sleep in test files (outside start_paused = true tests).
// Legitimate uses:
//   - `orchestration/tests.rs`: paired with `start_paused = true`,
//     drives advanced timers explicitly.
//   - `orchestrator_http/support.rs`: `wait_for_path` polls a real
//     filesystem marker written by handler-side code where no
//     event signal is available; bounded with `tokio::time::timeout`.
//   - `agent_sessions_tests.rs`: pre-existing real-time delivery test
//     for the event-log sink (extracted from agent_sessions.rs's inline
//     test mod, which was previously below this lint's file filter).
const TOKIO_SLEEP_ALLOWLIST: list<string> = [
  "crates/harn-vm/src/orchestration/tests.rs",
  "crates/harn-vm/src/agent_sessions_tests.rs",
  "crates/harn-cli/tests/harn_cli_fast/orchestrator_http/support.rs",
]

// Wall-clock `Instant::now() < deadline` comparisons inside any loop or
// guard.
const INSTANT_NOW_DEADLINE_ALLOWLIST: list<string> = [
  // Real subprocess lifecycle e2e: bounded probes wait on OS process-group
  // disappearance after SIGTERM/SIGKILL and cannot run on a virtual clock.
  "crates/harn-hostlib/tests/harn_hostlib/process_tools_e2e.rs",
  "crates/harn-cli/tests/harn_cli_e2e/host_lease_crash_cli.rs",
]

// SystemTime::now() in test files — use injected clock / MockClock instead.
// Remaining entries: legitimate fixture-setup uses against real OS time
// (httpdate Retry-After parsing, real-mtime touch fixtures).
const SYSTEM_TIME_ALLOWLIST: list<string> = [
  "crates/harn-vm/src/http/tests.rs",
  "crates/harn-hostlib/tests/harn_hostlib/scanner_e2e.rs",
]

// recv_timeout with an explicit sub-second Duration literal.
// Named-constant variants are not caught here because the constant value
// cannot be resolved by a static text search.
const RECV_TIMEOUT_MILLIS_ALLOWLIST: list<string> = []

// Conformance tests that exercise real subprocesses should share the bounded
// polling helpers from `conformance/tests/_common.harn` instead of copying
// ad hoc loops into each fixture.
const CONFORMANCE_HELPER_ALLOWLIST: list<string> = ["conformance/tests/_common.harn"]

// Conformance fixtures that are allowed to call `sleep(<literal>)` /
// `time.sleep(<literal>)` because they exercise real subprocess I/O,
// real socket-bound servers, or genuine wall-clock-driven scheduler
// behavior that cannot be expressed under `mock_time(...)`. New
// fixtures should drive timing through `mock_time(...)` /
// `advance_time(...)` and `yield_now()` from the unified test clock
// (see docs/src/dev/testing.md). Add an entry here only when there is
// no deterministic alternative — and prefer shrinking this list over
// growing it.
const CONFORMANCE_REAL_TIME_ALLOWLIST: list<string> = [
