// Runtime files allowed to read host time directly (#1439). Each entry is a
// runtime site where the host wall clock is the *source of truth* —
// observability timestamps, OAuth/JWT claim issuance, retry-after parsing,
// real-time logging, etc. — or where Clock injection is tracked as gradual
// cleanup under the testbench epic (#1438). Drop entries as call sites
// migrate to `Arc<dyn Clock>`.
const NON_TEST_WALL_CLOCK_ALLOWLIST: list<string> = [
  "crates/harn-cli/src/commands/agents_conformance.rs",
  "crates/harn-cli/src/commands/agents_conformance/wire.rs",
  "crates/harn-cli/src/commands/bench.rs",
  "crates/harn-cli/src/commands/connect.rs",
  // `harn connect` waits for real browser OAuth callbacks and stamps
  // persisted connector credential metadata with host Unix time; those
  // values are user-facing wall-clock state, not VM-scheduled time.
  "crates/harn-cli/src/commands/connect/callback.rs",
  "crates/harn-cli/src/commands/connect/store.rs",
  "crates/harn-cli/src/commands/connector.rs",
  // `harn demo` measures and renders wall-clock elapsed time in the
  // terminal output ("--- demo complete in 180 ms ---") and stamps the
  // demo's run record with the actual host wall-clock instant so users
  // can correlate the run against their own activity. Same shape as the
  // existing allowlisted `run.rs` entry.
  "crates/harn-cli/src/commands/demo.rs",
  // `harn doctor --check-providers` reports observed HTTP latency per
  // provider — host wall clock is the source of truth, same shape as
  // the allowlisted `run.rs` / `bench.rs` / `time.rs` entries.
  "crates/harn-cli/src/commands/doctor.rs",
  "crates/harn-cli/src/commands/explain.rs",
  "crates/harn-cli/src/commands/flow.rs",
  // `harn local switch` stamps the selection record with the actual host
  // wall clock so `harn local status` can show "selection age" to users
  // debugging a long-running session.
  // `harn local launch` stamps process metadata and log filenames with the
  // actual host wall clock so users can correlate local model lifecycle events
  // against their terminal, OS process table, and provider logs.
  "crates/harn-cli/src/commands/local/launch.rs",
  "crates/harn-cli/src/commands/local/state.rs",
  "crates/harn-cli/src/commands/mcp/mod.rs",
  "crates/harn-cli/src/commands/mcp/oauth_resource.rs",
  "crates/harn-cli/src/commands/mcp/serve/util.rs",
  "crates/harn-cli/src/commands/orchestrator/common.rs",
  "crates/harn-cli/src/commands/orchestrator/harness/audit.rs",
  "crates/harn-cli/src/commands/orchestrator/harness/pumps.rs",
  "crates/harn-cli/src/commands/orchestrator/harness/shutdown.rs",
  "crates/harn-cli/src/commands/orchestrator/inspect_data.rs",
  "crates/harn-cli/src/commands/orchestrator/listener/acp_hub.rs",
  "crates/harn-cli/src/commands/orchestrator/listener/routes.rs",
  "crates/harn-cli/src/commands/orchestrator/listener/routes/ingest.rs",
  "crates/harn-cli/src/commands/orchestrator/queue.rs",
  "crates/harn-cli/src/commands/orchestrator/reload.rs",
  "crates/harn-cli/src/commands/orchestrator/stats.rs",
  "crates/harn-cli/src/commands/orchestrator/supervisor_state.rs",
  "crates/harn-cli/src/commands/portal/dlq.rs",
  "crates/harn-cli/src/commands/portal/run_analysis.rs",
  "crates/harn-cli/src/commands/portal/util.rs",
  "crates/harn-cli/src/commands/run/mod.rs",
  // The script MCP HTTP server bounds how long a queued server-to-client
  // request may wait for a real network client to open its event stream
  // (`SESSION_STREAM_GRACE`); the external client's arrival time is host
  // wall-clock state, same shape as the allowlisted `connect/callback.rs`
  // browser-callback wait.
  "crates/harn-cli/src/commands/serve.rs",
  "crates/harn-cli/src/commands/supervisor.rs",
  "crates/harn-cli/src/commands/test/mod.rs",
  "crates/harn-cli/src/commands/test/conformance.rs",
  // `harn time run` measures real wall-clock + per-phase elapsed time
  // for cost/perf debugging — host time is the source of truth, same
  // shape as the allowlisted `run.rs`, `demo.rs`, and `bench.rs`
  // entries. Wall/CPU readings are reported in the structured envelope.
  "crates/harn-cli/src/commands/time.rs",
  "crates/harn-cli/src/commands/trigger/ops.rs",
  "crates/harn-cli/src/commands/trigger/replay.rs",
  "crates/harn-cli/src/package/registry.rs",
  "crates/harn-cli/src/skill_provenance.rs",
  // User-test phase timings report real host wall time; the extracted execution
  // module preserves the existing `test_runner.rs` observability contract.
  "crates/harn-cli/src/test_runner/execution.rs",
  "crates/harn-cli/src/test_runner.rs",
  "crates/harn-vm/src/a2a/mod.rs",
  "crates/harn-vm/src/agent_events/sinks.rs",
  "crates/harn-vm/src/agent_sessions.rs",
  // Per-builtin profiling reports how long a builtin really took; elapsed host
  // time IS the observation, and an injected clock would report logical time
  // instead of the ten seconds the operator is trying to find. Same shape as
  // the `module_phase_timing.rs` entry below.
  "crates/harn-vm/src/builtin_profile.rs",
  // Module phase attribution measures real compile/load work for CLI timing
  // reports; host monotonic time is the observation being recorded.
  "crates/harn-vm/src/vm/module_phase_timing.rs",
  // Durable rate limiting retries real SQLite writer-lock contention and bounds
  // wall-clock backoff with host monotonic time; VM clock injection would not
  // model the blocking rusqlite calls it is defending.
  "crates/harn-vm/src/durable_rate_limit.rs",
  "crates/harn-vm/src/connectors/a2a_push/mod.rs",
  "crates/harn-vm/src/connectors/harn_module.rs",
  "crates/harn-vm/src/connectors/shared.rs",
  "crates/harn-vm/src/corrections/mod.rs",
  "crates/harn-vm/src/event_log/mod.rs",
  "crates/harn-vm/src/event_log/util.rs",
  "crates/harn-vm/src/flow/atom.rs",
  "crates/harn-vm/src/flow/fixer.rs",
  "crates/harn-vm/src/flow/predicates/executor.rs",
  "crates/harn-vm/src/http/client.rs",
  "crates/harn-vm/src/http/streaming/websocket.rs",
  "crates/harn-vm/src/llm/agent_observe.rs",
  // Split children preserve the parent observability contracts: transcript
  // timestamps and streamed tool-call coalescing use host time as the source
  // of truth, rather than VM-scheduled time.
  "crates/harn-vm/src/llm/agent_observe/transcript_observability.rs",
  "crates/harn-vm/src/llm/api/transport/sse.rs",
  // Agent host primitive tool dispatch records actual host monotonic
  // elapsed time for transcript / portal execution telemetry.
  "crates/harn-vm/src/llm/agent_host_primitives.rs",
  // MCP OAuth stamps and compares token expiry against the host wall clock:
  // the authorization server's `expires_in` is real-world time, so a
  // VM-scheduled clock cannot decide when a stored token must be refreshed.
  "crates/harn-vm/src/mcp_oauth.rs",
  "crates/harn-vm/src/llm/agent_runtime.rs",
  // `agent_inbox::wait_sync` is a sync blocking primitive for sync
  // builtins that already block the runtime thread (e.g.
  // `run_command`'s wait-briefly-for-initial-output helper). The
  // paired `agent_inbox::wait_async` is the clock-aware variant used
  // by everything else.
  "crates/harn-vm/src/orchestration/agent_inbox.rs",
  // `op_interrupt` is the sync-builtin interrupt bridge: it observes host
  // cancellation/deadline while a real child process blocks the VM thread.
  // Virtual time cannot decide whether an OS subprocess has exited or whether
  // SIGTERM grace has elapsed.
  "crates/harn-vm/src/op_interrupt.rs",
  "crates/harn-vm/src/llm/api/partial_tool_args.rs",
  "crates/harn-vm/src/llm/api/transport.rs",
  "crates/harn-vm/src/llm/autonomy_budget.rs",
  "crates/harn-vm/src/llm/cache.rs",
  // `first_token.rs` records host-observed elapsed time from LLM dispatch
  // to the first streamed delta as RunProfile telemetry; real provider
  // latency is the source of truth.
  "crates/harn-vm/src/llm/first_token.rs",
  "crates/harn-vm/src/llm/mod.rs",
  "crates/harn-vm/src/llm/model_test.rs",
  // Ollama raw `/api/generate` bypasses the shared transport wrapper, so it
  // records actual host monotonic elapsed time for provider telemetry.
  "crates/harn-vm/src/llm/providers/ollama.rs",
  "crates/harn-vm/src/llm/providers/vertex.rs",
  "crates/harn-vm/src/llm/rate_limit.rs",
  // `routing_policy` records actual per-link wall-clock elapsed so the
  // routing trace + `<dispatch>.attempt` tape events accurately
  // attribute provider latency.
  "crates/harn-vm/src/llm/routing/execution/mod.rs",
  "crates/harn-vm/src/llm/routing/execution/race.rs",
  "crates/harn-vm/src/llm/stream.rs",
  "crates/harn-vm/src/mcp_card.rs",
  // mcp_host.rs supervises external MCP servers: cache TTLs and
  // circuit-breaker reset windows are inherently wall-clock concerns
  // (the cache hint is server-issued in real time, the breaker decay is
  // a real-world cool-off period). Mirrors the sibling mcp_registry.rs
  // exemption and the broader supervision pattern in personas/.
  "crates/harn-vm/src/mcp_host.rs",
  "crates/harn-vm/src/mcp_registry.rs",
  "crates/harn-vm/src/metadata.rs",
  "crates/harn-vm/src/orchestration/command_policy.rs",
  "crates/harn-vm/src/orchestration/merge_captain_iteration.rs",
  "crates/harn-vm/src/orchestration/mod.rs",
  "crates/harn-vm/src/orchestration/playground/fake_server.rs",
  "crates/harn-vm/src/orchestration/playground/step.rs",
  "crates/harn-vm/src/personas/mod.rs",
  "crates/harn-vm/src/provenance/mod.rs",
  "crates/harn-vm/src/sessions/mod.rs",
  "crates/harn-vm/src/stdlib/agent_state.rs",
  // stdlib/clock.rs is itself the canonical wall-clock reader for Harn
  // scripts; the SystemTime::now reads are the fallback when no mock is
  // active. Routing through Clock would create a cycle.
  "crates/harn-vm/src/stdlib/clock.rs",
  // `compaction.run` records actual host monotonic elapsed time in the
  // `latency_ms` field of the result dict — the #2505 spec lists
  // compaction latency as required telemetry, so the host wall clock is
  // the source of truth (same shape as the allowlisted routing.rs).
  "crates/harn-vm/src/stdlib/compaction.rs",
  // testbench/wasi_process.rs's #[cfg(test)] module compares real wall
  // time vs virtual time to prove that WASM-side `poll_oneoff` sleeps
  // don't actually block the host thread — the wall-clock read is the
  // signal under test, not a flake source.
  "crates/harn-vm/src/testbench/wasi_process.rs",
  "crates/harn-vm/src/stdlib/agent_state/backend.rs",
  "crates/harn-vm/src/stdlib/agents_daemon.rs",
  "crates/harn-vm/src/stdlib/agents_workers/execution.rs",
  "crates/harn-vm/src/stdlib/concurrency.rs",
  "crates/harn-vm/src/stdlib/cookies.rs",
  "crates/harn-vm/src/stdlib/fs.rs",
  "crates/harn-vm/src/stdlib/hitl.rs",
  "crates/harn-vm/src/stdlib/host.rs",
  // stdlib/io.rs uses host monotonic time to enforce real terminal input
  // deadlines; VM virtual time cannot decide whether stdin became readable.
  "crates/harn-vm/src/stdlib/io.rs",
  "crates/harn-vm/src/stdlib/logging.rs",
  "crates/harn-vm/src/stdlib/long_running.rs",
  "crates/harn-vm/src/stdlib/memory.rs",
  "crates/harn-vm/src/stdlib/monitors.rs",
  // `pg_partition_retain` / `pg_partition_create_for_window` (#2580) read the
  // host wall clock to anchor a retention cutoff ("now − keep_days") and the
  // default maintenance window start. Real current time IS the source of
  // truth here — the same shape as the `date_now` builtin. The cutoff/window
  // math lives in pure helpers that take an injected `now` and are unit-tested
  // deterministically; only the thin builtin boundary reads the real clock.
  "crates/harn-vm/src/stdlib/postgres/introspect.rs",
  // `pg_execute` and `pg_migrate` time the host wall-clock duration of the
  // Postgres round-trip and surface it as `duration_ms` in the result dict
  // (issue #2500). The measurement IS the observability source of truth
  // — same shape as the existing `process.rs` allowlist entry.
  "crates/harn-vm/src/stdlib/postgres/migrate.rs",
  "crates/harn-vm/src/stdlib/postgres/mod.rs",
  // `pg_pool`'s circuit breaker (#2512) stamps the open-at instant + tests
  // cooldown elapsed against the host wall clock. The "is the cooldown
  // over yet" decision IS the observability source of truth — same shape
  // as supervisor/triggers entries above.
  "crates/harn-vm/src/stdlib/postgres/circuit.rs",
  "crates/harn-vm/src/stdlib/process.rs",
  "crates/harn-vm/src/stdlib/supervisor.rs",
  "crates/harn-vm/src/stdlib/tracing.rs",
  "crates/harn-vm/src/stdlib/triggers_stdlib.rs",
  "crates/harn-vm/src/stdlib/waitpoint.rs",
  "crates/harn-vm/src/stdlib/waitpoints.rs",
  "crates/harn-vm/src/stdlib/workflow_messages.rs",
  "crates/harn-vm/src/synchronization.rs",
  "crates/harn-vm/src/tenant.rs",
  "crates/harn-vm/src/tracing.rs",
  "crates/harn-vm/src/triggers/dispatcher/circuits.rs",
  "crates/harn-vm/src/triggers/dispatcher/mod.rs",
  "crates/harn-vm/src/triggers/dispatcher/predicate_eval.rs",
  "crates/harn-vm/src/triggers/event.rs",
  "crates/harn-vm/src/triggers/inbox.rs",
  "crates/harn-vm/src/triggers/registry.rs",
  "crates/harn-vm/src/triggers/scheduler.rs",
  "crates/harn-vm/src/triggers/test_util/clock.rs",
  // leak_audit IS the runtime audit shim — it intentionally reads the
  // host wall/monotonic clock and records the call when a mock is
  // installed. Routing through Clock would defeat the audit's purpose.
  "crates/harn-vm/src/triggers/test_util/clock_leak.rs",
  "crates/harn-vm/src/triggers/test_util/mod.rs",
  "crates/harn-vm/src/triggers/webhook_intake.rs",
  "crates/harn-vm/src/triggers/worker_queue.rs",
  "crates/harn-vm/src/trust_graph.rs",
  "crates/harn-vm/src/vm/execution.rs",
  // std/signal interrupt handler deadlines share the VM's existing monotonic
  // deadline mechanism until the broader Clock-injection cleanup reaches vm/.
  "crates/harn-vm/src/vm/interrupts.rs",
  "crates/harn-vm/src/vm/iter.rs",
  "crates/harn-vm/src/vm/ops/parallel.rs",
  "crates/harn-vm/src/waitpoints.rs",
]

// -------------------------------------------------------------------------------------------------

// Pure helpers (pub so scripts/tests/lint_test_patterns_test.harn can drive
// them without touching the filesystem).

// -------------------------------------------------------------------------------------------------

/** Repo-relative form of a glob result (strip the `/./` search-root marker). */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/** The trailing path component of `p` (after the last `/`). */
pub fn base_name(p: string) -> string {
  let found = -1
  let i = 0
  const n = p.len()
  while i < n {
    if p.char_at(i) == "/" {
      found = i
    }
    i = i + 1
  }
  return p.substring(found + 1, n)
}

/**
 * True when a repo-relative `.rs` path under the crates tree counts as a
 * test file:
 * any `.rs` under a `tests/` directory, or an inline/sibling test module
 * (`tests.rs`, `tests_*.rs`, `*_tests.rs`) under a `src/` directory.
 * Mirrors the bash `find` pair feeding TEST_FILES_TMP.
 */
pub fn is_test_rs_path(rel: string) -> bool {
  if !rel.ends_with(".rs") {
    return false
  }
  if rel.contains("/tests/") {
    return true
  }
  if !rel.contains("/src/") {
    return false
  }
  const name = base_name(rel)
  return name == "tests.rs" || name.starts_with("tests_") || name.ends_with("_tests.rs")
}

/**
 * True when a repo-relative path is a non-test runtime `.rs` file under
 * `crates/harn-vm/src/` or `crates/harn-cli/src/` — the scan set for the
 * #1439 non-test wall-clock check.
 */
pub fn is_runtime_rs_path(rel: string) -> bool {
  if !rel.ends_with(".rs") {
    return false
  }
  if !rel.starts_with("crates/harn-vm/src/") && !rel.starts_with("crates/harn-cli/src/") {
    return false
  }
  if rel.contains("/tests/") {
    return false
  }
  const name = base_name(rel)
  if name == "tests.rs" || name.starts_with("tests_") || name.ends_with("_tests.rs") {
    return false
  }
  return true
}

/** True when `rel` is one of the sanctioned E2E subprocess test files. */
pub fn is_e2e_subprocess_path(rel: string) -> bool {
  if rel.starts_with("crates/harn-cli/tests/harn_cli_fast/orchestrator_http/") {
    return true
  }
  return E2E_SUBPROCESS_PATHS.contains(rel)
}

/**
 * All `{line_no, text}` hits for `pattern` over a whole file `text` —
 * the port of `grep -n <pattern> <file>` inside the check loops. Each
 * matching line is reported once (grep prints a line once no matter how
 * many matches it holds). Uses one Rust-side `regex_captures` scan per
 * file so multi-hundred-kLOC corpora stay fast; per-line VM loops were
 * ~50x slower.
 */
pub fn find_hits(text: string, pattern: string) -> list {
  const ms = regex_captures(pattern, text, "m")
  if ms.count == 0 {
    return []
  }
  const lines = text.lines()
  let hits: list = []
  let last_line = -1
  for m in ms {
    if m.line == last_line {
      continue
    }
    last_line = m.line
    hits = hits + [{line_no: m.line, text: lines[m.line - 1]}]
  }
  return hits
}

/** grep pattern: `std::thread::sleep` variants in test files. */
pub fn thread_sleep_pattern() -> string {
  return r"std::thread::sleep|thread::sleep\(Duration|thread::sleep\(std::time"
}

pub fn tokio_sleep_pattern() -> string {
  return r"tokio::time::sleep\("
}

/** `Instant::now()` followed by optional spaces and `<` or `>`. */
pub fn instant_deadline_pattern() -> string {
  return r"Instant::now\(\) *[<>]"
}

pub fn system_time_pattern() -> string {
  return r"SystemTime::now\(\)"
}

pub fn recv_timeout_pattern() -> string {
  return r"recv_timeout\(Duration::from_(millis|nanos|micros)"
}

pub fn harn_command_pattern() -> string {
  return r"harn_command\("
}

pub fn harn_e2e_command_pattern() -> string {
  return r"(harn_e2e_command|run_harn_e2e)\("
}

pub fn direct_harn_binary_pattern() -> string {
  return "CARGO_BIN_EXE_harn"
}

pub fn direct_harn_binary_baseline(rel: string) -> int {
  for item in DIRECT_HARN_BINARY_BASELINE {
    if item.path == rel {
      return item.count
    }
  }
  return 0
}

/** Return duplicate path keys from a file/count baseline. */
pub fn duplicate_baseline_paths(items: list) -> list<string> {
  let seen = {}
  let duplicates = []
  for item in items {
    if seen[item.path] ?? false {
      if !duplicates.contains(item.path) {
        duplicates = duplicates + [item.path]
      }
    } else {
      seen[item.path] = true
    }
  }
  return duplicates
}

pub fn direct_harn_binary_baseline_duplicates() -> list<string> {
  return duplicate_baseline_paths(DIRECT_HARN_BINARY_BASELINE)
}

/** Direct Rust process spawns whose executable is sh, /bin/sh, or cmd. */
pub fn shell_spawn_literal_pattern() -> string {
  return "([A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_]*Command::new[ \\t\\r\\n]*\\([ \\t\\r\\n]*\"(sh|/bin/sh|cmd)\""
}

pub fn shell_spawn_literal_baseline(rel: string) -> int {
  for item in SHELL_SPAWN_LITERAL_BASELINE {
    if item.path == rel {
      return item.count
    }
  }
  return 0
}

pub fn shell_spawn_literal_baseline_duplicates() -> list<string> {
  return duplicate_baseline_paths(SHELL_SPAWN_LITERAL_BASELINE)
}

pub fn spawn_orchestrator_pattern() -> string {
  return r"spawn_orchestrator\("
}

pub fn ignore_attr_pattern() -> string {
  return r"#\[ignore"
}

/** Copied conformance wait helper definitions (line-anchored). */
pub fn wait_helper_pattern() -> string {
  return r"^fn (wait_for_listener_url|wait_for_a2a_server_url|wait_for_log_line|wait_for_exit)"
}

pub fn random_fixed_port_pattern() -> string {
  return r"random_int\(20000, 45000\)"
}

/**
 * `sleep(<digit>` / `time.sleep(<digit>` at the start of a line or after
 * a non-identifier character — the ERE
 * `(^|[^_a-zA-Z])(sleep|time\.sleep)\([0-9]` from the bash lint.
 */
pub fn literal_sleep_pattern() -> string {
  // `\n` excluded from the negated class: the whole-file scan would
  // otherwise anchor a match on the previous line's trailing newline and
  // misattribute the line number (grep tests each line standalone).
  return r"(^|[^_a-zA-Z\n])(sleep|time\.sleep)\([0-9]"
}

/** Direct host wall-clock reads forbidden in runtime code (#1439). */
pub fn wall_clock_pattern() -> string {
  return r"SystemTime::now\(\)|chrono::Utc::now\(\)|chrono::Local::now\(\)|Instant::now\(\)|OffsetDateTime::now_utc\(\)"
}

/**
 * True when a fixture installs a clock mock: some line's leading
 * whitespace is followed by `mock_time(` (grep `^[[:space:]]*mock_time(`).
 */
pub fn has_mock_time(text: string) -> bool {
  return regex_match(r"^[ \t\r]*mock_time\(", text, "m") != nil
}

// -------------------------------------------------------------------------------------------------
// Reporting driver
// -------------------------------------------------------------------------------------------------

/**
 * Run one pattern check over `files` ({rel, text} records), skipping any
 * file for which `skip(rel)` is true. Prints each hit as `  <n>:<line>`
 * followed by the pre-formatted `hint_lines`; returns the violation count.
 */
fn report_pattern(
  files: list,
  skip: fn(string) -> bool,
  pattern: string,
  hint_lines: list<string>,
) -> int {
  let count = 0
  for f in files {
    if skip(f.rel) {
      continue
    }
    for hit in find_hits(f.text, pattern) {
      __io_println("  ${hit.line_no}:${hit.text}")
      for h in hint_lines {
        __io_println(h)
      }
      count = count + 1
    }
  }
  return count
}

/** Load `{rel, text}` records for each repo-relative path, sorted. */
fn load_files(rels: list<string>) -> list {
  let out: list = []
  for rel in rels.sorted() {
    out = out + [{rel: rel, text: harness.fs.read_text(rel)}]
  }
  return out
}

pipeline main(task) {
  let test_rels: list<string> = []
  let runtime_rels: list<string> = []
  for g in harness.fs.glob("crates/**/*.rs") {
    const rel = rel_path(g)
    if !harness.fs.stat(rel).is_file {
      // Mirror `find -type f`: a directory can match the glob (e.g. a
      // state dir literally named `.harn` matching `*.harn`).
      continue
    }
    if is_test_rs_path(rel) {
      test_rels = test_rels + [rel]
    }
    if is_runtime_rs_path(rel) {
      runtime_rels = runtime_rels + [rel]
    }
  }
  let harn_rels: list<string> = []
  for g in harness.fs.glob("conformance/tests/**/*.harn") {
    const rel = rel_path(g)
    if harness.fs.stat(rel).is_file {
      harn_rels = harn_rels + [rel]
    }
  }
  const test_files = load_files(test_rels)
  const harn_files = load_files(harn_rels)
  const runtime_files = load_files(runtime_rels)
  let violations = 0
  __io_println("=== Checking test files for forbidden patterns ===")
  __io_println("--- std::thread::sleep ---")
  violations = violations
    + report_pattern(
    test_files,
    { rel -> THREAD_SLEEP_ALLOWLIST.contains(rel) },
    thread_sleep_pattern(),
    ["    hint: Use tokio::time::pause() + advance(), or wait on an event/channel instead."],
  )
  __io_println("--- tokio::time::sleep ---")
  violations = violations
    + report_pattern(
    test_files,
    { rel -> TOKIO_SLEEP_ALLOWLIST.contains(rel) },
    tokio_sleep_pattern(),
    [
      "    hint: Use tokio::time::pause() + advance() in a #[tokio::test(start_paused = true)] context.",
    ],
  )
  __io_println("--- Instant::now() deadline comparison (wall-clock poll) ---")
  // Catches `Instant::now() < deadline`, `>= deadline`, etc. — the smell is
  // the comparison itself, regardless of whether it sits inside a `while`,
  // a `loop`, or an `assert!` macro inside a loop body.
  violations = violations
    + report_pattern(
    test_files,
    { rel -> INSTANT_NOW_DEADLINE_ALLOWLIST.contains(rel) },
    instant_deadline_pattern(),
    [
      "    hint: Subscribe to an EventLog channel, use OrchestratorHarness, or wrap a poll in tokio::time::timeout instead.",
    ],
  )
  __io_println("--- SystemTime::now() in tests ---")
  violations = violations
    + report_pattern(
    test_files,
    { rel -> SYSTEM_TIME_ALLOWLIST.contains(rel) },
    system_time_pattern(),
    ["    hint: Inject a MockClock or use the stdlib clock() builtin via a test harness."],
  )
  __io_println("--- recv_timeout with explicit sub-second Duration ---")
  violations = violations
    + report_pattern(
    test_files,
    { rel -> RECV_TIMEOUT_MILLIS_ALLOWLIST.contains(rel) },
    recv_timeout_pattern(),
    [
      "    hint: Use an event-driven wait (channel recv with tokio::time::timeout) instead of busy-polling.",
    ],
  )
  __io_println("--- obsolete harn_command helper ---")
  violations = violations
    + report_pattern(
    test_files,
    { rel -> false },
    harn_command_pattern(),
    [
      "    hint: harn_command was retired; use in-process APIs in fast tests or harn_e2e_command in the E2E suite.",
    ],
  )
  __io_println("--- direct Cargo harn binary access (file-level ratchet) ---")
  for path in direct_harn_binary_baseline_duplicates() {
    __io_println("  duplicate baseline path: " + path)
    __io_println("    hint: keep exactly one canonical expected-count row per file")
    violations = violations + 1
  }
  for f in test_files {
    if !f.rel.starts_with("crates/harn-cli/tests/")
      || f.rel
      == "crates/harn-cli/tests/test_util/process.rs" {
      continue
    }
    const actual = find_hits(f.text, direct_harn_binary_pattern()).count
    const expected = direct_harn_binary_baseline(f.rel)
    if actual != expected {
      __io_println(
        "  " + f.rel + ": expected " + to_string(expected) + ", found " + to_string(actual),
      )
      __io_println(
        "    hint: route real CLI subprocesses through crates/harn-cli/tests/test_util/process.rs",
      )
      violations = violations + 1
    }
  }
  __io_println("--- direct shell process spawns (file-level ratchet) ---")
  for path in shell_spawn_literal_baseline_duplicates() {
    __io_println("  duplicate baseline path: " + path)
    __io_println("    hint: keep exactly one canonical expected-count row per file")
    violations = violations + 1
  }
  for f in test_files {
    const hits = find_hits(f.text, shell_spawn_literal_pattern())
    const actual = hits.count
    const expected = shell_spawn_literal_baseline(f.rel)
    if actual != expected {
      __io_println(
        "  " + f.rel + ": expected " + to_string(expected) + ", found " + to_string(actual),
      )
      if actual > expected {
        for hit in hits {
          __io_println("    ${hit.line_no}:${hit.text}")
        }
      }
      __io_println(
        "    hint: use the hermetic harn-test-echo-env helper instead of spawning sh, /bin/sh, or cmd",
      )
      __io_println(
        "          or lower SHELL_SPAWN_LITERAL_BASELINE after removing a grandfathered spawn",
      )
      violations = violations + 1
    }
  }
  __io_println("--- Harn E2E subprocess helper outside E2E tests ---")
  violations = violations
    + report_pattern(
    test_files,
    is_e2e_subprocess_path,
    harn_e2e_command_pattern(),
    ["    hint: Harn E2E helpers are E2E-only; use in-process command/library APIs in fast tests."],
  )
  __io_println("--- spawn_orchestrator outside E2E subprocess tests ---")
  violations = violations
    + report_pattern(
    test_files,
    is_e2e_subprocess_path,
    spawn_orchestrator_pattern(),
    ["    hint: spawn_orchestrator is E2E-only; use OrchestratorHarness in fast tests."],
  )
  __io_println("--- #[ignore] outside slow harn-cli integration tests ---")
  violations = violations
    + report_pattern(
    test_files,
    { rel -> rel.starts_with("crates/harn-cli/tests/") },
    ignore_attr_pattern(),
    [
      "    hint: Default-suite Rust tests must run by default. Move slow subprocess coverage to the harn-cli E2E profile instead of using #[ignore].",
    ],
  )
  __io_println("--- copied conformance subprocess wait helpers ---")
  violations = violations
    + report_pattern(
    harn_files,
    { rel -> CONFORMANCE_HELPER_ALLOWLIST.contains(rel) },
    wait_helper_pattern(),
    [
      "    hint: Import the shared helper from conformance/tests/_common.harn so retry ceilings stay consistent.",
    ],
  )
  __io_println("--- random fixed-port conformance server allocation ---")
  violations = violations
    + report_pattern(
    harn_files,
    { rel -> false },
    random_fixed_port_pattern(),
    ["    hint: Bind test servers to port 0 and read the selected port from the readiness log."],
  )
  __io_println("--- conformance sleep with fixed literal duration ---")
  // Fixtures that drive timing via `mock_time(...)` / `advance_time(...)`
  // auto-deflake their `sleep(...)` calls (the unified test clock advances
  // instantly). Anything else relies on wall-clock and should either move
  // to that pattern or be added to CONFORMANCE_REAL_TIME_ALLOWLIST with
  // justification.
  for f in harn_files {
    if CONFORMANCE_REAL_TIME_ALLOWLIST.contains(f.rel) {
      continue
    }
    // Files that install a clock mock are exempt because `sleep(...)` and
    // `sleep_ms(...)` advance the mock instead of suspending the runtime.
    if has_mock_time(f.text) {
      continue
    }
    for hit in find_hits(f.text, literal_sleep_pattern()) {
      __io_println("  ${hit.line_no}:${hit.text}")
      __io_println("    hint: Wrap timing-sensitive logic in mock_time(...)/unmock_time(),")
      __io_println("          or add the fixture to CONFORMANCE_REAL_TIME_ALLOWLIST in")
      __io_println("          scripts/lint_test_patterns.harn with reviewer justification.")
      violations = violations + 1
    }
  }
  // -------------------------------------------------------------------------
  // Non-test wall-clock reads (#1439)
  //
  // Runtime code that reads `SystemTime::now()`, `OffsetDateTime::now_utc()`,
  // `Instant::now()`, or `chrono::Utc::now()` directly cannot be virtualised
  // by the testbench `Clock` substrate (`harn_clock::Clock`). New runtime code
  // should accept an `Arc<dyn Clock>` and read time through it, leaving the
  // direct host-clock APIs to `RealClock` impls and known-good logging /
  // observability sites.
  //
  // NON_TEST_WALL_CLOCK_ALLOWLIST (above) freezes the file inventory as of
  // #1439. Existing files may keep their direct reads (tracked as gradual
  // cleanup), but adding new files with direct reads requires either (a)
  // routing time through a `Clock` or (b) appending the file to the allowlist
  // with a one-line justification.
  // -------------------------------------------------------------------------
  __io_println("--- Non-test wall-clock reads (harn-vm/harn-cli runtime) ---")
  violations = violations
    + report_pattern(
    runtime_files,
    { rel -> NON_TEST_WALL_CLOCK_ALLOWLIST.contains(rel) },
    wall_clock_pattern(),
    [
      "    hint: route time reads through an injected harn_clock::Clock; if the host wall clock is the source of truth (observability, JWT claim, retry-after, etc.), append this file to NON_TEST_WALL_CLOCK_ALLOWLIST in scripts/lint_test_patterns.harn with a one-line justification.",
    ],
  )
  __io_println("")
  if violations > 0 {
    __io_println("FAIL: ${violations} forbidden test pattern violation(s) found.")
    __io_println("")
    __io_println("Forbidden patterns cause flaky tests. See docs/src/dev/testing.md for")
    __io_println("approved alternatives and how to opt out with reviewer justification.")
    return 1
  }
  __io_println("OK: no forbidden test pattern violations found.")
  return 0
}
