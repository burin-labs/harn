import * as semver from "std/semver"

pub type ReleaseWithdrawal = {
  version: string,
  tag_commit: string,
  distribution_version: string,
  replacement: string,
  reason: "invalid_tagged_candidate",
}

fn require_exact_keys(value, allowed: list<string>, context: string) {
  for key in value.keys() {
    if !allowed.contains(key) {
      throw context + " contains unsupported field: " + key
    }
  }
}

/** Parse and validate the closed registry of immutable release withdrawals. */
pub fn parse_release_withdrawals(text: string) -> list<ReleaseWithdrawal> {
  const doc = json_parse(text)
  if type_of(doc) != "dict" {
    throw "release withdrawal registry must be an object"
  }
  require_exact_keys(doc, ["schema_version", "releases"], "release withdrawal registry")
  if doc?.schema_version != 1 {
    throw "release withdrawal registry schema_version must be 1"
  }
  const raw_releases = doc?.releases
  if type_of(raw_releases) != "list" {
    throw "release withdrawal registry releases must be a list"
  }
  let releases: list<ReleaseWithdrawal> = []
  let seen: list<string> = []
  for raw in raw_releases {
    if type_of(raw) != "dict" {
      throw "release withdrawal registry entries must be objects"
    }
    require_exact_keys(
      raw,
      ["version", "tag_commit", "distribution_version", "replacement", "reason"],
      "release withdrawal entry",
    )
    const version = to_string(raw?.version ?? "")
    const tag_commit = to_string(raw?.tag_commit ?? "")
    const distribution_version = to_string(raw?.distribution_version ?? "")
    const replacement = to_string(raw?.replacement ?? "")
    const reason = to_string(raw?.reason ?? "")
    if semver.parse(version) == nil {
      throw "release withdrawal has invalid version: " + version
    }
    if regex_captures(r"^[0-9a-f]{40}$", tag_commit).count != 1 {
      throw "release withdrawal v" + version + " has invalid tag_commit"
    }
    if semver.next(distribution_version, "patch") != version {
      throw "release withdrawal v" + version
        + " distribution_version must be the prior patch version"
    }
    if replacement != semver.next(version, "patch") {
      throw "release withdrawal v" + version + " replacement must be the next patch version"
    }
    if reason != "invalid_tagged_candidate" {
      throw "release withdrawal v" + version + " has unsupported reason: " + reason
    }
    if seen.contains(version) {
      throw "release withdrawal registry contains duplicate version: " + version
    }
    seen = seen + [version]
    releases = releases
      + [
      {
        version: version,
        tag_commit: tag_commit,
        distribution_version: distribution_version,
        replacement: replacement,
        reason: "invalid_tagged_candidate",
      },
    ]
  }
  return releases
}

/** Keep install-facing projections on the last published release while withdrawn. */
pub fn release_distribution_version(registry_text: string, version: string) -> string {
  return release_withdrawal_for_version(registry_text, version)?.distribution_version ?? version
}

/** Return the withdrawal for one version, if the registry names it. */
pub fn release_withdrawal_for_version(
  registry_text: string,
  version: string,
) -> ReleaseWithdrawal? {
  for withdrawal in parse_release_withdrawals(registry_text) {
    if withdrawal.version == version {
      return withdrawal
    }
  }
  return nil
}

/** Authorize divergence only for the exact commit of a recorded immutable tag. */
pub fn release_withdrawal_matches_tag(
  registry_text: string,
  version: string,
  tag_commit: string,
) -> bool {
  const withdrawal = release_withdrawal_for_version(registry_text, version)
  return withdrawal != nil && withdrawal.tag_commit == lowercase(trim(tag_commit))
}
