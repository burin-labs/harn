import { agent_loop } from "std/agent/loop"
import { read_jsonl } from "std/jsonl"
import {
  compose_tool_callers,
  tools_use_middleware,
  with_audit_log,
  with_required_reason,
} from "std/llm/tool_middleware"

fn smoke_tools() {
  const registry = tool_registry()
  return tool_define(
    registry,
    "receipt_echo",
    "Echo receipt smoke input",
    {
      handler: { args -> return {echoed: to_string(args?.message ?? "")} },
      parameters: {message: {type: "string"}, token: {type: "string"}},
    },
  )
}

pipeline default(harness: Harness) {
  const session = "smoke-tool-receipts-" + harness.random.uuid()
  const receipt_path = path_join(
    harness.fs.runtime_paths().state_root,
    "receipts",
    session + ".jsonl",
  )
  if harness.fs.exists(receipt_path) {
    harness.fs.delete(receipt_path)
  }
  harness.llm.mock_clear()
  harness.llm.mock_enqueue(
    {
      tool_calls: [
        {
          id: "smoke-receipt-1",
          name: "receipt_echo",
          arguments: {message: "hello", token: "redacted", reason: "Verify receipt smoke path"},
        },
      ],
    },
  )
  harness.llm.mock_enqueue({text: "Done. ##DONE##"})
  const reason = with_required_reason({schema_required: false})
  const tools = tools_use_middleware(smoke_tools(), reason.schema_transform)
  const caller = compose_tool_callers(
    harness.clock,
    [with_audit_log(harness.clock, harness.fs, {sink: "local", redact: ["token"]}), reason.caller],
  )
  const agent_options = {
    provider: "mock",
    model: "mock",
    session_id: session,
    tools: tools,
    tool_format: "native",
    loop_until_done: true,
    max_iterations: 3,
    tool_caller: caller,
  }
  const result = agent_loop(harness, "smoke tool receipts", nil, agent_options)
  const records = read_jsonl(harness.fs, receipt_path, {strict: true})
  harness.stdio.println("status=" + result.status)
  harness.stdio.println("receipt_path=" + receipt_path)
  harness.stdio.println("records=" + to_string(len(records)))
  harness.stdio.println("reason=" + records[0].reason)
  harness.stdio.println("receipt_uri=" + to_string(records[0]?.audit?.receipt_uri ?? ""))
}
