// Verify checked-in Harn snippets used by the marketing site parse cleanly.
//
// Ported from scripts/check_site_snippets.sh: `harn check` every
// website/src/examples/*.harn.txt snippet plus the demo gallery scenarios,
// stream each check's output through, and fail on any broken snippet (or
// when no site snippets are found at all).
//
// Usage:
//   harn run scripts/check_site_snippets.harn
const SITE_SNIPPET_GLOB = "website/src/examples/*.harn.txt"

const GALLERY_SCENARIOS: list<string> = [
  "crates/harn-cli/assets/demo/mcp-host/scenario.harn",
  "crates/harn-cli/assets/demo/merge-captain/scenario.harn",
  "crates/harn-cli/assets/demo/stdlib-toolkit/scenario.harn",
]

/** Repo-relative form of a glob result (strip the `/./` marker). */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/** The summary line printed after all snippets are checked. */
pub fn summary_line(checked: int, failures: int) -> string {
  return "site snippets: ${checked} checked, ${failures} failed"
}

/**
 * Resolve the harn binary used to type-check snippets: $HARN_BIN wins,
 * else the workspace target dir's debug build (building it quietly when
 * missing) — the same ladder as the bash original.
 */
fn resolve_harn_bin() -> string {
  const env_bin = harness.env.get("HARN_BIN")
  if env_bin != nil && env_bin != "" {
    return env_bin
  }
  let target_dir = ""
  const meta = harness.process.spawn_captured(
    {cmd: "cargo", args: ["metadata", "--no-deps", "--format-version", "1"]},
  )
  if meta.success {
    const parsed = try {
      json_parse(meta.stdout)
    } catch (err) {
      nil
    }
    target_dir = parsed?.target_directory ?? ""
  }
  if target_dir == "" {
    target_dir = harness.env.get("CARGO_TARGET_DIR") ?? ""
  }
  if target_dir == "" {
    target_dir = "target"
  }
  const bin = "${target_dir}/debug/harn"
  if !harness.fs.exists(bin) {
    __io_eprintln("building harn-cli (set HARN_BIN to skip)...")
    const build = harness.process.spawn_captured(
      {cmd: "cargo", args: ["build", "-q", "-p", "harn-cli"]},
    )
    if !build.success {
      __io_eprint(build.stderr)
      throw "cargo build -p harn-cli failed"
    }
  }
  return bin
}

pipeline main(task) {
  const harn_bin = resolve_harn_bin()
  let site_snippets: list<string> = []
  for g in harness.fs.glob(SITE_SNIPPET_GLOB) {
    site_snippets = site_snippets + [rel_path(g)]
  }
  site_snippets = site_snippets.sorted()
  let checked = 0
  let failures = 0
  for snippet in site_snippets + GALLERY_SCENARIOS {
    checked = checked + 1
    const res = harness.process.spawn_captured({cmd: harn_bin, args: ["check", snippet]})
    __io_print(res.stdout)
    __io_eprint(res.stderr)
    if !res.success {
      failures = failures + 1
    }
  }
  __io_println("")
  __io_println(summary_line(checked, failures))
  if site_snippets.count == 0 {
    __io_println("FAIL: no ${SITE_SNIPPET_GLOB} snippets found")
    return 1
  }
  if failures > 0 {
    return 1
  }
  return 0
}
