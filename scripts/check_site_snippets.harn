// Verify the Harn a visitor reads on harnlang.com stays clean.
//
// Two globbed sets, never a hand-maintained list:
//
//   - website/src/examples/*.harn.txt — the homepage hero and friends;
//   - crates/harn-cli/assets/demo/*/*.harn — every Harn file the bundled demo
//     scenarios ship, which website/src/examples/gallery.ts imports directly
//     out of the CLI assets to render the "Examples" tabs.
//
// The gallery used to be an enumerated list of three scenario paths while the
// homepage rendered four tabs, so review-captain — the "Code review agent" tab
// — was displayed and checked by nothing. Globbing the demo directory removes
// that failure mode: adding a scenario adds it to this gate, and adding a
// gallery tab cannot outrun it. The glob takes every `.harn` in a scenario
// directory rather than just `scenario.harn`, because the gallery already
// renders sibling files (review-captain's two `.harn.prompt` templates) and a
// scenario's imported modules are showcase code too.
//
// Each snippet must pass `harn check` and a strict `harn lint`. `check` owns
// mandatory parameter annotations; strict lint holds the rest of the showcase
// to the style the docs teach.
//
// One gap this does not close: HARN-LNT-016 never fires on a *pipeline*
// parameter, because the linter inserts every pipeline parameter into its
// reference set before linting the body (crates/harn-lint/src/linter/walk.rs).
// An unused `pipeline` parameter is invisible to every command here.
//
// Usage:
//   harn run scripts/check_site_snippets.harn
const SITE_SNIPPET_GLOB = "website/src/examples/*.harn.txt"

const DEMO_SCENARIO_GLOB = "crates/harn-cli/assets/demo/*/*.harn"

/**
 * The argv tail of every command a snippet must survive, in order; the
 * snippet's path is appended to each. `check` requires parameter annotations,
 * and `--strict` makes every remaining lint warning fatal, so showcase code is
 * held to the bar its readers will be held to.
 */
const SNIPPET_CHECKS: list<list<string>> = [
  ["check"],
  ["lint", "--strict"],
]

/** Repo-relative form of a glob result (strip the `/./` marker). */
pub fn rel_path(path: string) -> string {
  const idx = path.index_of("/./")
  if idx >= 0 {
    return path.substring(idx + 3, path.len())
  }
  return path
}

/** The summary line printed after all snippets are checked. */
pub fn summary_line(checked: int, failures: int) -> string {
  return "site snippets: ${checked} checked, ${failures} failed"
}

/** Sorted, repo-relative matches for one glob pattern. */
fn glob_rel(fs: HarnessFs, pattern: string) -> list<string> {
  let matches: list<string> = []
  for g in fs.glob(pattern) {
    matches = matches + [rel_path(g)]
  }
  return matches.sorted()
}

/**
 * Resolve the harn binary used to check snippets: $HARN_BIN wins,
 * else the workspace target dir's debug build (building it quietly when
 * missing) — the same ladder as the bash original.
 */
fn resolve_harn_bin(harness: Harness) -> string {
  const env_bin = harness.env.get("HARN_BIN")
  if env_bin != nil && env_bin != "" {
    return env_bin
  }
  let target_dir = ""
  const meta = harness.process.run(
    {program: "cargo", args: ["metadata", "--no-deps", "--format-version", "1"]},
  )
  if meta.success {
    const parsed = try {
      json_parse(meta.stdout)
    } catch (err) {
      nil
    }
    target_dir = parsed?.target_directory ?? ""
  }
  if target_dir == "" {
    target_dir = harness.env.get("CARGO_TARGET_DIR") ?? ""
  }
  if target_dir == "" {
    target_dir = "target"
  }
  const bin = "${target_dir}/debug/harn"
  if !harness.fs.exists(bin) {
    harness.stdio.eprintln("building harn-cli (set HARN_BIN to skip)...")
    const build = harness.process.run({program: "cargo", args: ["build", "-q", "-p", "harn-cli"]})
    if !build.success {
      harness.stdio.eprint(build.stderr)
      throw "cargo build -p harn-cli failed"
    }
  }
  return bin
}

pipeline main(harness: Harness) {
  const harn_bin = resolve_harn_bin(harness)
  const site_snippets = glob_rel(harness.fs, SITE_SNIPPET_GLOB)
  const demo_scenarios = glob_rel(harness.fs, DEMO_SCENARIO_GLOB)
  let checked = 0
  let failures = 0
  for snippet in site_snippets + demo_scenarios {
    checked = checked + 1
    let failed = false
    for argv in SNIPPET_CHECKS {
      const res = harness.process.run({program: harn_bin, args: argv + [snippet]})
      harness.stdio.print(res.stdout)
      harness.stdio.eprint(res.stderr)
      if !res.success {
        failed = true
      }
    }
    if failed {
      failures = failures + 1
    }
  }
  harness.stdio.println("")
  harness.stdio.println(summary_line(checked, failures))
  if site_snippets.count == 0 {
    harness.stdio.println("FAIL: no ${SITE_SNIPPET_GLOB} snippets found")
    return 1
  }
  if demo_scenarios.count == 0 {
    harness.stdio.println("FAIL: no ${DEMO_SCENARIO_GLOB} scenarios found")
    return 1
  }
  if failures > 0 {
    return 1
  }
  return 0
}
