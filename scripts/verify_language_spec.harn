// Extract every Harn fenced code block from spec/HARN_SPEC.md and verify it.
// Bare ```harn blocks are parse-checked because the language spec includes
// schematic fragments; ```harn,check blocks opt into full `harn check`, and
// ```harn,ignore blocks are skipped. This matches the docs snippet checker.
//
// Usage:
//   harn run scripts/verify_language_spec.harn
//
// The pure fence-extraction / normalization logic lives in `pub fn`s so
// it is testable without touching the filesystem; only `main` reads the
// spec, writes temp files, and shells out to the harn binary.
const SPEC_PATH = "spec/HARN_SPEC.md"

/** True if `c` is an ASCII word character ([A-Za-z0-9_]). */
pub fn is_word_char(c: string) -> bool {
  if c == "_" {
    return true
  }
  return (c >= "0" && c <= "9")
    || (c >= "a" && c <= "z")
    || (c >= "A" && c <= "Z")
}

/** True if `c` is a word character or a literal dot. */
fn is_word_or_dot(c: string) -> bool {
  return c == "." || is_word_char(c)
}

/**
 * Slugify a heading the same way the Python script does: lowercase,
 * collapse any run of non-[a-z0-9] characters to a single dash, then
 * strip leading/trailing dashes. Empty results become "section".
 */
pub fn slugify(value: string) -> string {
  const lowered = value.trim().to_lower()
  const dashed = regex_replace(r"[^a-z0-9]+", "-", lowered)
  let start = 0
  let end = dashed.len()
  while start < end && dashed.char_at(start) == "-" {
    start = start + 1
  }
  while end > start && dashed.char_at(end - 1) == "-" {
    end = end - 1
  }
  const stripped = dashed.substring(start, end)
  if stripped == "" {
    return "section"
  }
  return stripped
}

/**
 * Strip a leading run of `#` characters and following whitespace from a
 * markdown heading line, mirroring Python's `re.sub(r"^#+\s*", "", line)`.
 */
pub fn heading_text(line: string) -> string {
  let i = 0
  const n = line.len()
  while i < n && line.char_at(i) == "#" {
    i = i + 1
  }
  while i < n {
    const c = line.char_at(i)
    if c == " " || c == "\t" || c == "\r" {
      i = i + 1
    } else {
      break
    }
  }
  return line.substring(i, n).trim()
}

/**
 * Replace standalone `...` omission markers with `nil`, but leave spread
 * syntax like `...rest` and dot runs like `....` untouched. Equivalent to
 * Python's `re.sub(r"(?<![\w.])\.\.\.(?![\w.])", "nil", snippet)`.
 */
pub fn normalize_snippet(snippet: string) -> string {
  let out = ""
  let i = 0
  const n = snippet.len()
  while i < n {
    if i + 3 <= n && snippet.substring(i, i + 3) == "..." {
      const before_ok = if i == 0 {
        true
      } else {
        !is_word_or_dot(snippet.char_at(i - 1))
      }
      const after_ok = if i + 3 >= n {
        true
      } else {
        !is_word_or_dot(snippet.char_at(i + 3))
      }
      if before_ok && after_ok {
        out = out + "nil"
        i = i + 3
        continue
      }
    }
    out = out + snippet.char_at(i)
    i = i + 1
  }
  return out
}

/**
 * True if a snippet is intentionally non-compiling (it documents an
 * error). Matches Python's case-insensitive check for `// error:` or
 * `# error:`.
 */
pub fn should_skip_snippet(snippet: string) -> bool {
  const lowered = snippet.to_lower()
  return lowered.contains("// error:") || lowered.contains("# error:")
}

/**
 * A CommonMark fence info-string line is exactly ``` followed by any run
 * of non-backtick characters and nothing else. Returns the trimmed,
 * lowercased info string when `line` is such a boundary, otherwise nil.
 */
pub fn fence_info(line: string) -> string? {
  if !line.starts_with("```") {
    return nil
  }
  const rest = line.substring(3, line.len())
  if rest.contains("`") {
    return nil
  }
  return rest.trim().to_lower()
}

/**
 * Trim a trailing run of blank/whitespace-only handling is not needed;
 * we mirror Python's `str.strip()` for the joined snippet body. Strips
 * leading and trailing ASCII whitespace.
 */
pub fn strip_ws(s: string) -> string {
  return s.trim()
}

/**
 * Extract every Harn fenced block from `markdown`. Returns a list
 * of {heading, line, mode, snippet} records where `line` is the 1-based source
 * line of the first content line of the fence and `snippet` is the
 * stripped block body with a trailing newline appended.
 */
pub fn extract_harn_fences(markdown: string) -> list {
  let fences = []
  let current_heading = "spec"
  let in_fence = false
  let fence_lang = ""
  let fence_start = 0
  let fence_lines = []
  const lines = markdown.split("\n")
  let line_no = 0
  for line in lines {
    line_no = line_no + 1
    if !in_fence && line.starts_with("#") {
      const h = heading_text(line)
      if h != "" {
        current_heading = h
      }
      continue
    }
    const info = fence_info(line)
    if info != nil {
      if !in_fence {
        in_fence = true
        fence_lang = info
        fence_start = line_no + 1
        fence_lines = []
      } else {
        const mode = if fence_lang == "harn,check" {
          "check"
        } else if fence_lang == "harn" {
          "parse"
        } else {
          ""
        }
        if mode != "" {
          const snippet = strip_ws(fence_lines.join("\n"))
          if snippet != "" {
            fences = fences
              + [
              {heading: current_heading, line: fence_start, mode: mode, snippet: snippet + "\n"},
            ]
          }
        }
        in_fence = false
        fence_lang = ""
        fence_lines = []
      }
      continue
    }
    if in_fence {
      fence_lines = fence_lines + [line]
    }
  }
  return fences
}

/**
 * Build the per-snippet temp filename stem (without directory), matching
 * Python's `f"{idx:03d}_{slug}_L{line_no}.harn"`.
 */
pub fn snippet_filename(idx: int, heading: string, line_no: int) -> string {
  return pad3(idx) + "_" + slugify(heading) + "_L" + "${line_no}" + ".harn"
}

/** Zero-pad a non-negative int to at least 3 digits. */
pub fn pad3(n: int) -> string {
  const s = "${n}"
  if s.len() >= 3 {
    return s
  }
  if s.len() == 2 {
    return "0" + s
  }
  return "00" + s
}

/**
 * Resolve the argv prefix (command + leading args, ending in the subcommand)
 * used to type-check each extracted fence. Mirrors the Python
 * `harn_check_command`: honor HARN_CHECK_BIN, else ask `cargo metadata`
 * for the workspace `target_directory` (so a redirected `CARGO_TARGET_DIR`
 * is respected) and use its `debug/harn`, else fall back to
 * `cargo run --bin harn` which builds on demand.
 */
fn harn_command_argv(subcommand: string) -> list<string> {
  const bin_override = harness.env.get("HARN_CHECK_BIN")
  if bin_override != nil && bin_override != "" {
    return [bin_override, subcommand]
  }
  const harn_bin = harness.env.get("HARN_BIN")
  if harn_bin != nil && harn_bin != "" {
    return [harn_bin, subcommand]
  }
  const meta = harness.process.spawn_captured(
    {cmd: "cargo", args: ["metadata", "--format-version=1", "--no-deps"]},
  )
  if meta.success {
    const parsed = try {
      json_parse(meta.stdout)
    } catch (err) {
      nil
    }
    const target_dir = parsed?.target_directory
    if target_dir != nil && target_dir != "" {
      const bin = target_dir + "/debug/harn"
      if harness.fs.exists(bin) {
        return [bin, subcommand]
      }
    }
  }
  return ["cargo", "run", "--quiet", "--bin", "harn", "--", subcommand]
}

pipeline main(task) {
  if !harness.fs.exists(SPEC_PATH) {
    __io_eprintln("error: missing ${SPEC_PATH}")
    return 1
  }
  const fences = extract_harn_fences(harness.fs.read_text(SPEC_PATH))
  if fences.count == 0 {
    __io_eprintln("error: no ```harn fences found in ${SPEC_PATH}")
    return 1
  }
  /* The runtime sandbox only permits writes inside the workspace root,
   * so the scratch directory lives there (and is removed afterward)
   * rather than under the system temp dir the Python version used. */
  const mk = harness.process.spawn_captured(
    {cmd: "mktemp", args: ["-d", "harn-spec-verify-XXXXXX"]},
  )
  if !mk.success {
    __io_eprintln("error: could not create temp directory")
    return 1
  }
  const tmpbase = mk.stdout.trim()
  /* Remove the scratch directory on every exit path — including an early
   * return or a throw from `write_text`/`spawn_captured` below. Without this
   * an interrupted run leaks a `harn-spec-verify-*` directory into the
   * workspace root, where it shows up as a confusing untracked entry. */
  defer {
    harness.process.spawn_captured({cmd: "rm", args: ["-rf", tmpbase]})
  }
  let manifest_lines = []
  let failures = []
  let idx = 0
  for fence in fences {
    idx = idx + 1
    if should_skip_snippet(fence.snippet) {
      continue
    }
    const name = snippet_filename(idx, fence.heading, fence.line)
    const path = tmpbase + "/" + name
    harness.fs.write_text(path, normalize_snippet(fence.snippet))
    manifest_lines = manifest_lines
      + [
      "${name}: ${fence.heading} (${fence.mode}, spec line ${fence.line})",
    ]
    const argv_prefix = harn_command_argv(fence.mode)
    const bin = argv_prefix[0]
    const args = if fence.mode == "parse" {
      argv_prefix.slice(1, argv_prefix.count) + ["--json", path]
    } else {
      argv_prefix.slice(1, argv_prefix.count) + [path]
    }
    const result = harness.process.spawn_captured({cmd: bin, args: args})
    if result.exit_code != 0 {
      failures = failures + [{name: name, result: result}]
    }
  }
  if failures.count > 0 {
    __io_eprintln("language spec verification failed")
    __io_eprintln("")
    __io_eprintln("Extracted examples:")
    __io_eprintln(manifest_lines.join("\n"))
    for failure in failures {
      __io_eprintln("")
      __io_eprintln("FAIL: ${failure.name}")
      if failure.result.stdout != "" {
        __io_eprintln(failure.result.stdout)
      }
      if failure.result.stderr != "" {
        __io_eprintln(failure.result.stderr)
      }
    }
    return 1
  }
  __io_println("verified ${fences.count} Harn code fences from spec/HARN_SPEC.md")
  return 0
}
