pub type ProviderToolProbeRoute = {
  id: string,
  provider: string,
  model: string,
  env_keys: list<string>,
  local: bool,
  cheap: bool,
  metadata: dict,
}

pub type ProviderToolProbeBehavior = {
  id: string,
  category: string,
  description: string,
  runner: string,
  probe_case?: string,
  modes: list<string>,
  tool_formats: list<string>,
  cheap: bool,
}

pub type ProviderToolProbeRuntimeStatus = "verified" | "unavailable" | "invalid"

pub type ProviderToolProbeRuntimeBuildFeatures = {
  default: bool,
  full: bool,
  llm_bench_internals: bool,
  vm_bench_internals: bool,
  content: bool,
  compression: bool,
  http_compression: bool,
  cloud_aws: bool,
  native_keyring: bool,
  postgres: bool,
  sqlite: bool,
  otel: bool,
  testbench_wasi: bool,
}

pub type ProviderToolProbeRuntimeCompatibilityFingerprint = {
  codegen_fingerprint: string,
  bytecode_schema_version: int,
  linked_program_schema_version: int,
  linker_algorithm_version: int,
  build_features: ProviderToolProbeRuntimeBuildFeatures,
}

pub type ProviderToolProbeRuntimeContentFingerprint = {
  schema: "harn.runtime_content_fingerprint.v1",
  content_sha256: string,
  harn_version: string,
  embedded_stdlib_sha256: string,
  compatibility: ProviderToolProbeRuntimeCompatibilityFingerprint,
  source_revision: string?,
}

pub type ProviderToolProbeRuntimeReceipt = {
  schema_version: "harn.provider_tool_probe_runtime.v1",
  command: list<string>,
  status: ProviderToolProbeRuntimeStatus,
  exit_code: int,
  version: string,
  source_revision: string?,
  runtime_content_fingerprint: ProviderToolProbeRuntimeContentFingerprint?,
  reason: string,
}

pub type ProviderToolProbeCatalogStatus = "verified" | "unavailable" | "invalid"

pub type ProviderToolProbeCatalogReceipt = {
  schema_version: "harn.provider_tool_probe_catalog.v1",
  command: list<string>,
  command_env: dict,
  status: ProviderToolProbeCatalogStatus,
  exit_code: int,
  providers_config: string,
  catalog_sha256: string,
  provider_count: int,
  model_count: int,
  route_count: int,
  reason: string,
}

pub type ProviderToolProbeCell = {
  id: string,
  provider: string,
  model: string,
  route_id: string,
  behavior: string,
  category: string,
  mode: string,
  tool_format: string,
  runner: string,
  status: string,
  reason: string,
  command?: list<string>,
  artifact_path?: string,
  observed: dict,
  catalog: dict,
}

pub type ProviderToolProbeCampaignReport = {
  schema_version: "harn.provider_tool_probe_campaign.v9",
  runtime: ProviderToolProbeRuntimeReceipt,
  catalog: ProviderToolProbeCatalogReceipt,
  live: bool,
  include_expensive: bool,
  route_count: int,
  behavior_count: int,
  cell_count: int,
  summary: dict,
  runner_summary: dict,
  executable_gap: dict,
  auth_readiness: dict,
  spend: dict,
  campaign_slice: dict,
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  cells: list<ProviderToolProbeCell>,
  artifacts: dict,
}

pub fn provider_tool_probe_campaign_providers_config(
  explicit: string,
  configured: string,
  inherited: string,
) -> string {
  const requested = trim(explicit)
  if requested != "" {
    return requested
  }
  const campaign_config = trim(configured)
  if campaign_config != "" {
    return campaign_config
  }
  return trim(inherited)
}

pub fn provider_tool_probe_campaign_command_env(providers_config: string) -> dict {
  const path = trim(providers_config)
  if path == "" {
    return {}
  }
  return {HARN_PROVIDERS_CONFIG: path}
}
