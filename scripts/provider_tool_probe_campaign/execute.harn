import "./catalog"
import "./plan"
import "./support"
import "./types"

pub fn provider_tool_probe_campaign_case_status(report: dict) -> string {
  const cases = report?.cases ?? []
  if len(cases) == 0 {
    return "skip"
  }
  for probe_case in cases {
    if !(probe_case?.ok ?? false) {
      return "fail"
    }
  }
  return "pass"
}

pub fn provider_tool_probe_campaign_probe_telemetry(report: dict) -> dict {
  let case_count = 0
  let successful_case_count = 0
  let empty_completion_count = 0
  let rate_limited_count = 0
  let observed_latency_count = 0
  let latency_ms_total = 0
  let observed_usage_count = 0
  let observed_cost_count = 0
  let input_tokens = 0
  let output_tokens = 0
  let actual_usd = 0.0
  for probe_case in report?.cases ?? [] {
    case_count = case_count + 1
    if probe_case?.ok ?? false {
      successful_case_count = successful_case_count + 1
    }
    if probe_case?.classification == "empty_silent" {
      empty_completion_count = empty_completion_count + 1
    }
    if probe_case?.http_status == 429 {
      rate_limited_count = rate_limited_count + 1
    }
    if probe_case?.elapsed_ms != nil {
      observed_latency_count = observed_latency_count + 1
      latency_ms_total = latency_ms_total + (probe_case.elapsed_ms ?? 0)
    }
    const usage = probe_case?.usage
    if type_of(usage) != "dict" {
      continue
    }
    observed_usage_count = observed_usage_count + 1
    input_tokens = input_tokens + (usage?.input_tokens ?? 0)
    output_tokens = output_tokens + (usage?.output_tokens ?? 0)
    if usage?.cost_usd != nil {
      observed_cost_count = observed_cost_count + 1
      actual_usd = actual_usd + (usage.cost_usd ?? 0.0)
    }
  }
  return {
    case_count: case_count,
    successful_case_count: successful_case_count,
    empty_completion_count: empty_completion_count,
    request_attempt_count: case_count,
    retry_count: 0,
    retry_accounting: "provider tool-probe makes one physical request per case and does not retry",
    rate_limited_count: rate_limited_count,
    observed_latency_count: observed_latency_count,
    latency_ms_total: latency_ms_total,
    observed_usage_count: observed_usage_count,
    observed_cost_count: observed_cost_count,
    unpriced_case_count: case_count - observed_cost_count,
    input_tokens: input_tokens,
    output_tokens: output_tokens,
    actual_usd: actual_usd,
  }
}

pub fn __probe_cell(
  llm: HarnessLlm,
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  format: string,
  report: dict,
  artifact_path: string,
  command: list<string>,
) -> ProviderToolProbeCell {
  const status = provider_tool_probe_campaign_case_status(report)
  const reason = if status == "pass" {
    "every saved provider tool-probe case passed at the Harn parse/dispatch boundary"
  } else if status == "fail" {
    let failure_reason = ""
    for probe_case in report?.cases ?? [] {
      if !(probe_case?.ok ?? false) && failure_reason == "" {
        failure_reason = trim(to_string(probe_case?.failure_reason ?? ""))
      }
    }
    if failure_reason != "" {
      failure_reason
    } else {
      report?.tool_calling?.failure_reason ?? "provider tool-probe reported fail"
    }
  } else {
    "provider tool-probe did not produce a case verdict"
  }
  return __base_cell(
    {
      llm: llm,
      route: route,
      behavior: behavior,
      mode: mode,
      format: format,
      status: status,
      reason: reason,
      observed: {
        tool_calling: report?.tool_calling ?? {},
        telemetry: provider_tool_probe_campaign_probe_telemetry(report),
        schema_version: report?.schema_version,
      },
    },
  )
    + {artifact_path: artifact_path, command: command}
}

pub fn __missing_env_keys(route: ProviderToolProbeRoute, env: dict) -> list<string> {
  if len(route.env_keys) == 0 {
    return []
  }
  for key in route.env_keys {
    if trim(to_string(env[key] ?? "")) != "" {
      return []
    }
  }
  return route.env_keys
}

pub fn provider_tool_probe_campaign_missing_env_keys(
  route: ProviderToolProbeRoute,
  env: dict,
) -> list<string> {
  return __missing_env_keys(route, env)
}

pub fn __merge_unique_strings(left: list<string>, right: list<string>) -> list<string> {
  let out = left
  for value in right {
    out = __append_unique_string(out, value)
  }
  return out
}

pub fn __auth_readiness(routes: list<ProviderToolProbeRoute>, env: dict, env_source: dict) -> dict {
  let ready_routes = 0
  let missing_auth_routes = 0
  let local_routes = 0
  let hosted_routes = 0
  let ready_by_provider: dict = {}
  let missing_by_provider: dict = {}
  let missing_env_candidates_by_provider: dict = {}
  for route in routes {
    if route.local {
      local_routes = local_routes + 1
    } else {
      hosted_routes = hosted_routes + 1
    }
    const missing = __missing_env_keys(route, env)
    if len(missing) == 0 {
      ready_routes = ready_routes + 1
      ready_by_provider = __increment_key(ready_by_provider, route.provider)
    } else {
      missing_auth_routes = missing_auth_routes + 1
      missing_by_provider = __increment_key(missing_by_provider, route.provider)
      missing_env_candidates_by_provider = missing_env_candidates_by_provider
        + {
        [route.provider]: __merge_unique_strings(
          missing_env_candidates_by_provider[route.provider] ?? [],
          missing,
        ),
      }
    }
  }
  return {
    env_checked: env_source.checked ?? false,
    env_source: env_source,
    route_count: len(routes),
    ready_routes: ready_routes,
    missing_auth_routes: missing_auth_routes,
    local_routes: local_routes,
    hosted_routes: hosted_routes,
    ready_by_provider: ready_by_provider,
    missing_by_provider: missing_by_provider,
    missing_env_candidates_by_provider: missing_env_candidates_by_provider,
  }
}

pub fn __skipped_cells_for_missing_env(
  llm: HarnessLlm,
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  missing: list<string>,
) -> list<ProviderToolProbeCell> {
  let cells: list<ProviderToolProbeCell> = []
  for format in behavior.tool_formats {
    cells = cells
      + [
      __base_cell(
        {
          llm: llm,
          route: route,
          behavior: behavior,
          mode: mode,
          format: format,
          status: "skip",
          reason: "missing provider environment key; set one of: " + join(missing, ", "),
          observed: {missing_env_keys: missing, any_env_key_satisfies_route: true},
        },
      ),
    ]
  }
  return cells
}

pub fn __run_tool_probe(
  llm: HarnessLlm,
  fs: HarnessFs,
  process: HarnessProcess,
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  harn_bin: string,
  env: dict,
  repeat: int,
  timeout_secs: int,
  output_dir: string,
  trial: int = 1,
) -> list<ProviderToolProbeCell> {
  const missing = __missing_env_keys(route, env)
  if len(missing) > 0 {
    return __skipped_cells_for_missing_env(llm, route, behavior, mode, missing)
  }
  let cells: list<ProviderToolProbeCell> = []
  for format in behavior.tool_formats {
    const command = __tool_probe_command(
      {
        harn_bin: harn_bin,
        route: route,
        mode: mode,
        probe_case: to_string(behavior.probe_case ?? "single_tool_call"),
        format: format,
        repeat: repeat,
        timeout_secs: timeout_secs,
      },
    )
    const artifact_path = provider_tool_probe_campaign_artifact_path(
      route,
      behavior,
      mode,
      format,
      output_dir,
      trial,
    )
    const child = process.run({program: harn_bin, args: command[1:len(command)], env: env})
    const stdout = child.stdout ?? ""
    if trim(stdout) != "" {
      fs.write_text(artifact_path, stdout)
    }
    const parsed = try {
      json_parse(stdout)
    } catch (_) {
      nil
    }
    if parsed == nil {
      cells = cells
        + [
        __base_cell(
          {
            llm: llm,
            route: route,
            behavior: behavior,
            mode: mode,
            format: format,
            status: "error",
            reason: if trim(stdout) == "" {
              trim(child.stderr ?? "provider tool-probe failed before producing JSON")
            } else {
              "provider tool-probe produced non-JSON stdout"
            },
            observed: {
              exit_code: child.exit_code,
              stderr: trim(child.stderr ?? ""),
              telemetry: {
                actual_usd: 0.0,
                observed_cost_count: 0,
                unpriced_case_count: 1,
                request_attempt_count: 1,
                retry_count: 0,
                retry_accounting:
                  "the child process produced no parseable receipt; the campaign conservatively counts one unpriced attempt",
              },
            },
          },
        )
          + {command: command},
      ]
      continue
    }
    cells = cells
      + [__probe_cell(llm, route, behavior, mode, format, parsed, artifact_path, command)]
  }
  return cells
}

pub fn provider_tool_probe_campaign_artifact_path(
  route: ProviderToolProbeRoute,
  behavior: ProviderToolProbeBehavior,
  mode: string,
  format: string,
  output_dir: string,
  trial: int = 1,
) -> string {
  const probe_case = __slug(to_string(behavior.probe_case ?? "single_tool_call"))
  return path_join(
    output_dir,
    "tool-probe-" + route.id + "-" + __slug(behavior.id) + "-" + probe_case + "-" + __slug(mode)
      + "-"
      + __slug(format)
      + "-trial-"
      + to_string(trial)
      + ".json",
  )
}

pub fn provider_tool_probe_campaign_scorecard_inputs(
  fs: HarnessFs,
  cells: list<ProviderToolProbeCell>,
  runtime: ProviderToolProbeRuntimeReceipt,
  catalog: ProviderToolProbeCatalogReceipt,
) -> dict {
  let reports: list<dict> = []
  for cell in cells {
    const path = trim(to_string(cell?.artifact_path ?? ""))
    if path == "" || !fs.exists(path) {
      continue
    }
    let already_present = false
    for report in reports {
      if report.path == path {
        already_present = true
      }
    }
    if already_present {
      continue
    }
    reports = reports
      + [{path: path, sha256: "sha256:" + sha256(fs.read_bytes(path))}]
  }
  const identity = {
    schema_version: "harn.provider_tool_probe_scorecard_inputs.v1",
    runtime: runtime,
    catalog: catalog,
    campaign_source: provider_tool_probe_campaign_source_receipt(fs),
    reports: reports,
  }
  return identity
    + {input_sha256: "sha256:" + sha256(json_stringify(identity))}
}

pub fn provider_tool_probe_campaign_source_receipt(fs: HarnessFs) -> dict {
  const paths = [
    "scripts/provider_tool_probe_campaign.harn",
    "scripts/provider_tool_probe_campaign/catalog.harn",
    "scripts/provider_tool_probe_campaign/env.harn",
    "scripts/provider_tool_probe_campaign/execute.harn",
    "scripts/provider_tool_probe_campaign/plan.harn",
    "scripts/provider_tool_probe_campaign/report.harn",
    "scripts/provider_tool_probe_campaign/support.harn",
    "scripts/provider_tool_probe_campaign/types.harn",
  ]
  let files: list<dict> = []
  for path in paths {
    if fs.exists(path) {
      files = files
        + [{path: path, sha256: "sha256:" + sha256(fs.read_bytes(path))}]
    }
  }
  return {files: files, source_sha256: "sha256:" + sha256(json_stringify(files))}
}

pub fn provider_tool_probe_campaign_write_scorecard(
  fs: HarnessFs,
  process: HarnessProcess,
  harn_bin: string,
  cells: list<ProviderToolProbeCell>,
  output_dir: string,
  runtime: ProviderToolProbeRuntimeReceipt,
  catalog: ProviderToolProbeCatalogReceipt,
  env: dict,
) -> dict {
  const inputs = provider_tool_probe_campaign_scorecard_inputs(fs, cells, runtime, catalog)
  const input_manifest = path_join(output_dir, "scorecard-inputs.json")
  const scorecard_json = path_join(output_dir, "scorecard.json")
  const scorecard_markdown = path_join(output_dir, "scorecard.md")
  const scorecard_receipt = path_join(output_dir, "scorecard-receipt.json")
  fs.write_text(input_manifest, json_stringify_pretty(inputs) + "\n")
  if len(inputs.reports) == 0 {
    const receipt = {
      schema_version: "harn.provider_tool_probe_scorecard_receipt.v1",
      status: "unavailable",
      reason: "no saved live tool-probe reports were produced",
      input_manifest: input_manifest,
      input_sha256: inputs.input_sha256,
    }
    fs.write_text(scorecard_receipt, json_stringify_pretty(receipt) + "\n")
    return {
      scorecard_inputs_json: input_manifest,
      scorecard_receipt_json: scorecard_receipt,
      scorecard_status: receipt.status,
    }
  }
  let args = ["provider", "tool-scorecard"]
  for report in inputs.reports {
    args = args + ["--tool-probe-report", report.path]
  }
  const json_child = process.run({program: harn_bin, args: args + ["--json"], env: env})
  if json_child.exit_code != 0 || trim(json_child.stdout ?? "") == "" {
    const receipt = {
      schema_version: "harn.provider_tool_probe_scorecard_receipt.v1",
      status: "error",
      reason: trim(json_child.stderr ?? "tool-scorecard did not produce JSON"),
      input_manifest: input_manifest,
      input_sha256: inputs.input_sha256,
      command: [harn_bin] + args + ["--json"],
      exit_code: json_child.exit_code,
    }
    fs.write_text(scorecard_receipt, json_stringify_pretty(receipt) + "\n")
    return {
      scorecard_inputs_json: input_manifest,
      scorecard_receipt_json: scorecard_receipt,
      scorecard_status: receipt.status,
    }
  }
  fs.write_text(scorecard_json, json_child.stdout)
  const markdown_child = process.run({program: harn_bin, args: args + ["--markdown"], env: env})
  if markdown_child.exit_code == 0 && trim(markdown_child.stdout ?? "") != "" {
    fs.write_text(scorecard_markdown, markdown_child.stdout)
  }
  const receipt = {
    schema_version: "harn.provider_tool_probe_scorecard_receipt.v1",
    status: if markdown_child.exit_code == 0 {
      "complete"
    } else {
      "partial"
    },
    reason: if markdown_child.exit_code == 0 {
      "deterministic JSON and Markdown scorecards generated from the hashed saved reports"
    } else {
      trim(markdown_child.stderr ?? "Markdown scorecard generation failed")
    },
    input_manifest: input_manifest,
    input_sha256: inputs.input_sha256,
    scorecard_json: scorecard_json,
    scorecard_json_sha256: "sha256:" + sha256(fs.read_bytes(scorecard_json)),
    scorecard_markdown: if markdown_child.exit_code == 0 {
      scorecard_markdown
    } else {
      ""
    },
    scorecard_markdown_sha256: if markdown_child.exit_code == 0 {
      "sha256:" + sha256(fs.read_bytes(scorecard_markdown))
    } else {
      ""
    },
  }
  fs.write_text(scorecard_receipt, json_stringify_pretty(receipt) + "\n")
  return {
    scorecard_inputs_json: input_manifest,
    scorecard_json: scorecard_json,
    scorecard_markdown: receipt.scorecard_markdown,
    scorecard_receipt_json: scorecard_receipt,
    scorecard_status: receipt.status,
  }
}
