pub fn __provider_meta_by_id(catalog: dict) -> dict {
  let providers = {}
  for provider in catalog.providers ?? [] {
    const id = trim(to_string(provider.id ?? provider.name ?? ""))
    if id != "" {
      providers = providers + {[id]: provider}
    }
  }
  return providers
}

pub fn __route_is_local(provider: string, meta: dict) -> bool {
  const classification = to_string(meta.classification ?? "")
  if classification == "local" {
    return true
  }
  return provider == "local" || provider == "ollama" || provider == "llamacpp" || provider == "mlx"
}

pub fn __has_string(values, target: string) -> bool {
  if type_of(values) != "list" {
    return false
  }
  for value in values {
    if to_string(value) == target {
      return true
    }
  }
  return false
}

pub fn __append_unique_string(values: list<string>, value: string) -> list<string> {
  const key = trim(value)
  if key == "" || values.contains(key) {
    return values
  }
  return values + [key]
}

pub fn __unique_string_list(values: list<string>) -> list<string> {
  let out: list<string> = []
  for value in values {
    out = __append_unique_string(out, value)
  }
  return out
}

pub fn __catalog_model_is_cheap(model: dict, local: bool) -> bool {
  if local {
    return true
  }
  if __has_string(model.strengths, "cheap") || __has_string(model.quality_tags, "cheap") {
    return true
  }
  const input = to_float(model.pricing?.input_per_mtok) ?? 999999.0
  const output = to_float(model.pricing?.output_per_mtok) ?? 999999.0
  return input <= 1.0 && output <= 5.0
}

pub fn __route_key(provider: string, model: string) -> string {
  return provider + "\n" + model
}

pub fn __catalog_models_by_route(catalog: dict) -> dict {
  let models = {}
  for model in catalog.models ?? [] {
    const provider = trim(to_string(model.provider ?? ""))
    const model_id = trim(to_string(model.id ?? ""))
    if provider == "" || model_id == "" {
      continue
    }
    models = models + {[__route_key(provider, model_id)]: model}
    const wire_model = trim(to_string(model.wire_model ?? ""))
    if wire_model != "" {
      models = models + {[__route_key(provider, wire_model)]: model}
    }
  }
  return models
}

pub fn __route_env_keys(route: dict, meta: dict) -> list<string> {
  let keys: list<string> = []
  const route_secret = trim(to_string(route.secret_env ?? ""))
  if route_secret != "" {
    keys = keys + [route_secret]
  }
  return __unique_string_list(keys + __as_string_list(meta.auth?.env ?? meta.auth_envs))
}

pub fn __catalog_route_from_routing_row(
  route: dict,
  providers: dict,
  models: dict,
  include_expensive: bool,
) -> ProviderToolProbeRoute? {
  const provider = trim(to_string(route.provider ?? ""))
  const model_id = trim(to_string(route.model ?? ""))
  if provider == "" || model_id == "" {
    return nil
  }
  const meta = providers[provider] ?? {}
  const model = models[__route_key(provider, model_id)] ?? {}
  const local = __route_is_local(provider, meta)
  const cheap = __catalog_model_is_cheap(model, local)
  if !include_expensive && !cheap {
    return nil
  }
  return {
    id: __slug(provider + "-" + model_id),
    provider: provider,
    model: model_id,
    env_keys: __route_env_keys(route, meta),
    local: local,
    cheap: cheap,
    metadata: {
      source: "routing_route",
      catalog_model_id: model.id,
      catalog_wire_model: model.wire_model,
      route_model: model_id,
      route_family: route.family,
      route_label: route.label,
      route_timeout_ms: route.timeout_ms,
      route_capabilities: route.capabilities ?? [],
      route_has_base_url: trim(to_string(route.base_url ?? "")) != "",
      route_secret_env: route.secret_env,
    },
  }
}

pub fn __catalog_routes_from_routing_table(
  catalog: dict,
  include_expensive: bool,
) -> list<ProviderToolProbeRoute> {
  const providers = __provider_meta_by_id(catalog)
  const models = __catalog_models_by_route(catalog)
  let routes: list<ProviderToolProbeRoute> = []
  for row in catalog.routing_routes ?? [] {
    const route = __catalog_route_from_routing_row(row, providers, models, include_expensive)
    if route != nil {
      routes = routes + [route]
    }
  }
  return routes
}

pub fn __catalog_routes_from_models(
  catalog: dict,
  include_expensive: bool,
) -> list<ProviderToolProbeRoute> {
  const providers = __provider_meta_by_id(catalog)
  let routes: list<ProviderToolProbeRoute> = []
  for model in catalog.models ?? [] {
    const provider = trim(to_string(model.provider ?? ""))
    const model_id = trim(to_string(model.id ?? ""))
    if provider == "" || model_id == "" {
      continue
    }
    const meta = providers[provider] ?? {}
    const local = __route_is_local(provider, meta)
    const cheap = __catalog_model_is_cheap(model, local)
    if !include_expensive && !cheap {
      continue
    }
    routes = routes
      + [
      {
        id: __slug(provider + "-" + model_id),
        provider: provider,
        model: model_id,
        env_keys: __as_string_list(meta.auth?.env ?? meta.auth_envs),
        local: local,
        cheap: cheap,
        metadata: {
          source: "catalog_model",
          catalog_model_id: model_id,
          catalog_wire_model: model.wire_model,
        },
      },
    ]
  }
  return routes
}

pub fn provider_tool_probe_campaign_catalog_routes(
  catalog: dict,
  include_expensive: bool,
) -> list<ProviderToolProbeRoute> {
  if len(catalog.routing_routes ?? []) > 0 {
    return __catalog_routes_from_routing_table(catalog, include_expensive)
  }
  return __catalog_routes_from_models(catalog, include_expensive)
}

pub fn provider_tool_probe_campaign_modes(mode: string) -> list<string> {
  if mode == "both" {
    return ["non-streaming", "streaming"]
  }
  if mode == "non-streaming" {
    return ["non-streaming"]
  }
  if mode == "streaming" {
    return ["streaming"]
  }
  return []
}

