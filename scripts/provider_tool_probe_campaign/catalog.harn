      runner: "planned_agent_loop",
      modes: ["non-streaming"],
      tool_formats: ["native", "json", "text/tagged"],
      cheap: true,
    },
    {
      id: "tool_choice_forcing",
      category: "options",
      description:
        "Forced tool_choice either reaches the provider correctly or is rejected before dispatch.",
      runner: "planned_agent_loop",
      modes: ["non-streaming"],
      tool_formats: ["native", "json", "text/tagged"],
