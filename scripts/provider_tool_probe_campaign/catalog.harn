pub fn __behavior_matches(behavior: ProviderToolProbeBehavior, filters: list<string>) -> bool {
  if len(filters) == 0 {
    return true
  }
  for raw in filters {
    const filter = trim(raw)
    if filter == "" {
      continue
    }
    if filter == behavior.id || filter == behavior.category || filter == behavior.runner {
      return true
    }
  }
  return false
}

pub fn provider_tool_probe_campaign_select_behaviors(
  filters: list<string>,
) -> list<ProviderToolProbeBehavior> {
  let selected: list<ProviderToolProbeBehavior> = []
  for behavior in provider_tool_probe_campaign_behaviors() {
    if __behavior_matches(behavior, filters) {
      selected = selected + [behavior]
    }
  }
  return selected
}

pub fn __mode_allowed(mode: string, allowed: list<string>) -> bool {
  for item in allowed {
    if item == mode {
      return true
    }
  }
  return false
}

pub fn provider_tool_probe_campaign_filter_behavior_modes(
  behaviors: list<ProviderToolProbeBehavior>,
  mode: string,
) -> list<ProviderToolProbeBehavior> {
  if mode == "both" {
    return behaviors
  }
  let selected: list<ProviderToolProbeBehavior> = []
  for behavior in behaviors {
    if __mode_allowed(mode, behavior.modes) {
      selected = selected + [behavior + {modes: [mode]}]
    }
  }
  return selected
}
