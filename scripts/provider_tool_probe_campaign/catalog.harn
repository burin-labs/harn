      runner: "provider_tool_probe",
      probe_case: "parallel_tool_calls",
      modes: ["non-streaming"],
      tool_formats: ["native", "json", "text/tagged"],
      cheap: true,
    },
    {
      id: "multi_turn_tool_results",
      category: "dispatch",
      description:
        "Tool result consumed in a follow-up turn without provider-side message-order rejection.",
      runner: "provider_tool_probe",
      probe_case: "tool_result_followup",
      modes: ["non-streaming"],
      tool_formats: ["native", "json", "text/tagged"],
      cheap: true,
    },
    {
      id: "stop_sequences",
      category: "options",
      description:
        "Stop sequence option is either accepted by the route or catalog-gated before dispatch.",
      runner: "planned_llm_call",
      modes: ["non-streaming"],
      tool_formats: ["none"],
      cheap: true,
    },
    {
      id: "presence_frequency_penalties",
      category: "options",
      description:
        "Presence/frequency penalties are provider-gated so unsupported routes fail before live API 400s.",
      runner: "planned_llm_call",
      modes: ["non-streaming"],
      tool_formats: ["none"],
      cheap: true,
    },
    {
      id: "temperature_top_p_policy",
      category: "options",
      description:
        "Route-specific temperature/top_p policy is catalog-owned, including Kimi-style constraints.",
      runner: "planned_llm_call",
      modes: ["non-streaming"],
      tool_formats: ["none"],
      cheap: true,
    },
    {
      id: "long_heredoc_unicode_args",
      category: "parser",
      description:
        "Long heredoc and Unicode tool arguments survive provider parsing and dispatch byte-identically.",
      runner: "provider_tool_probe",
      probe_case: "large_string_argument",
      modes: ["non-streaming"],
      tool_formats: ["native", "json", "text/tagged"],
      cheap: true,
    },
    {
      id: "harmony_control_tokens_in_content",
      category: "parser",
      description:
