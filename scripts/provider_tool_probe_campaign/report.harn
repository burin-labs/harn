import "./catalog"
import "./execute"
import "./plan"
import "./support"
import "./types"

const SCHEMA_VERSION = "harn.provider_tool_probe_campaign.v10"

pub fn provider_tool_probe_campaign_observed_spend(cells: list<ProviderToolProbeCell>) -> dict {
  let actual_usd = 0.0
  let observed_cost_count = 0
  let unpriced_case_count = 0
  let request_attempt_count = 0
  let retry_count = 0
  for cell in cells {
    const telemetry = cell.observed?.telemetry ?? {}
    actual_usd = actual_usd + (telemetry?.actual_usd ?? 0.0)
    observed_cost_count = observed_cost_count + (telemetry?.observed_cost_count ?? 0)
    unpriced_case_count = unpriced_case_count + (telemetry?.unpriced_case_count ?? 0)
    request_attempt_count = request_attempt_count + (telemetry?.request_attempt_count ?? 0)
    retry_count = retry_count + (telemetry?.retry_count ?? 0)
  }
  return {
    actual_usd: actual_usd,
    observed_cost_count: observed_cost_count,
    unpriced_case_count: unpriced_case_count,
    request_attempt_count: request_attempt_count,
    retry_count: retry_count,
  }
}

pub type ProviderToolProbeLiveCellsRequest = {
  llm: HarnessLlm,
  fs: HarnessFs,
  process: HarnessProcess,
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  harn_bin: string,
  env: dict,
  repeat: int,
  timeout_secs: int,
  output_dir: string,
  shard_count: int,
  shard_index: int,
  max_probes: int,
  max_cost_usd?: float,
}

pub fn __live_cells(request: ProviderToolProbeLiveCellsRequest) -> dict {
  const llm = request.llm
  const fs = request.fs
  const process = request.process
  const routes = request.routes
  const behaviors = request.behaviors
  const harn_bin = request.harn_bin
  const env = request.env
  const repeat = request.repeat
  const timeout_secs = request.timeout_secs
  const output_dir = request.output_dir
  const shard_count = request.shard_count
  const shard_index = request.shard_index
  const max_probes = request.max_probes
  const max_cost_usd = request.max_cost_usd ?? 10.0
  let cells: list<ProviderToolProbeCell> = []
  let probe_units_total = 0
  let probe_units_selected = 0
  let probe_units_excluded_by_shard = 0
  let probe_units_excluded_by_cap = 0
  let executable_units_selected = 0
  let probe_executions_selected = 0
  let probe_executions_excluded_by_budget = 0
  let budget_stopped = false
  for route in routes {
    for behavior in behaviors {
      for mode in behavior.modes {
        const ordinal = probe_units_total
        probe_units_total = probe_units_total + 1
        if !__campaign_slice_selects_unit(ordinal, shard_count, shard_index) {
          probe_units_excluded_by_shard = probe_units_excluded_by_shard + 1
          continue
        }
        const ready_provider_probe = __campaign_runner_is_executable(behavior.runner)
          && len(__missing_env_keys(route, env))
            == 0
        if ready_provider_probe && max_probes > 0 && executable_units_selected >= max_probes {
          probe_units_excluded_by_cap = probe_units_excluded_by_cap + 1
          continue
        }
        probe_units_selected = probe_units_selected + 1
        if !__campaign_runner_is_executable(behavior.runner) {
          for format in behavior.tool_formats {
            cells = cells
              + [__planned_cell(llm, route, behavior, mode, format, harn_bin, repeat, timeout_secs)]
          }
          continue
        }
        if ready_provider_probe {
          executable_units_selected = executable_units_selected + 1
        }
        for trial in range(1, repeat + 1) {
          for format in behavior.tool_formats {
            const spend = provider_tool_probe_campaign_observed_spend(cells)
            if budget_stopped || spend.unpriced_case_count > 0 || spend.actual_usd >= max_cost_usd {
              budget_stopped = true
              probe_executions_excluded_by_budget = probe_executions_excluded_by_budget + 1
              continue
            }
            const one_format_behavior: ProviderToolProbeBehavior = behavior
              + {tool_formats: [format]}
            cells = cells
              + if behavior.runner == "provider_tool_probe" {
                __run_tool_probe(
                  llm,
                  fs,
                  process,
                  route,
                  one_format_behavior,
                  mode,
                  harn_bin,
                  env,
                  1,
                  timeout_secs,
                  output_dir,
                  trial,
                )
              } else {
                __run_option_probe(
                  llm,
                  fs,
                  process,
                  route,
                  one_format_behavior,
                  harn_bin,
                  env,
                  output_dir,
                  trial,
                )
              }
            probe_executions_selected = probe_executions_selected + 1
          }
        }
      }
    }
  }
  return {
    cells: cells,
    slice: __campaign_slice_receipt(
      {
        shard_count: shard_count,
        shard_index: shard_index,
        max_probes: max_probes,
        probe_units_total: probe_units_total,
        probe_units_selected: probe_units_selected,
        executable_units_selected: executable_units_selected,
        probe_units_excluded_by_shard: probe_units_excluded_by_shard,
        probe_units_excluded_by_cap: probe_units_excluded_by_cap,
      },
    )
      + {
        probe_executions_selected: probe_executions_selected,
        probe_executions_excluded_by_budget: probe_executions_excluded_by_budget,
        budget_stopped: budget_stopped,
      },
  }
}

pub fn __summary(cells: list<ProviderToolProbeCell>) -> dict {
  let summary: dict = {pass: 0, fail: 0, error: 0, skip: 0, planned: 0}
  for cell in cells {
    summary = summary + {[cell.status]: (summary[cell.status] ?? 0) + 1}
  }
  return summary
}

pub fn __runner_summary(cells: list<ProviderToolProbeCell>) -> dict {
  let summary: dict = {}
  for cell in cells {
    const current = summary[cell.runner]
      ?? {total: 0, pass: 0, fail: 0, error: 0, skip: 0, planned: 0}
    summary = summary
      + {
        [cell.runner]: current
          + {total: (current.total ?? 0) + 1, [cell.status]: (current[cell.status] ?? 0) + 1},
      }
  }
  return summary
}

pub fn __executable_gap(cells: list<ProviderToolProbeCell>) -> dict {
  let executable_cells = 0
  let executable_commands = 0
  let missing_runner = 0
  let missing_runner_by_behavior: dict = {}
  let executable_cells_by_provider: dict = {}
  let executable_commands_by_provider: dict = {}
  for cell in cells {
    if cell.status != "planned" {
      continue
    }
    if __campaign_runner_is_executable(cell.runner) {
      executable_cells = executable_cells + 1
      executable_cells_by_provider = __increment_key(executable_cells_by_provider, cell.provider)
      executable_commands = executable_commands + 1
      executable_commands_by_provider = __increment_key(
        executable_commands_by_provider,
        cell.provider,
      )
    } else {
      missing_runner = missing_runner + 1
      missing_runner_by_behavior = __increment_key(missing_runner_by_behavior, cell.behavior)
    }
  }
  return {
    executable_cells: executable_cells,
    executable_commands: executable_commands,
    missing_runner: missing_runner,
    missing_runner_by_behavior: missing_runner_by_behavior,
    executable_cells_by_provider: executable_cells_by_provider,
    executable_commands_by_provider: executable_commands_by_provider,
  }
}

pub fn __claim_controls(
  live: bool,
  cells: list<ProviderToolProbeCell>,
) -> ProviderOptionClaimControls {
  let selected = 0
  let measured_supported = 0
  let measured_unsupported = 0
  let unmeasured = 0
  for cell in cells {
    if cell.runner != "provider_option_probe" {
      continue
    }
    selected = selected + 1
    const observed = cell.observed?.option_probe?.diff?.observed_supported
    if observed == true {
      measured_supported = measured_supported + 1
    } else if observed == false {
      measured_unsupported = measured_unsupported + 1
    } else if live {
      unmeasured = unmeasured + 1
    }
  }
  const status = if selected == 0 {
    "not_selected"
  } else if !live {
    "dry_run"
  } else if measured_supported > 0 && measured_unsupported > 0
    && unmeasured == 0 {
    "complete"
  } else {
    "incomplete"
  }
  return {
    status: status,
    selected_count: selected,
    measured_supported_count: measured_supported,
    measured_unsupported_count: measured_unsupported,
    unmeasured_count: unmeasured,
    requires_both_directions: selected > 0,
  }
}

pub fn __estimated_spend(
  live: bool,
  cells: list<ProviderToolProbeCell>,
  repeat: int,
  max_cost_usd: float = 10.0,
) -> dict {
  let executable_probe_count = 0
  for cell in cells {
    if !__campaign_runner_is_executable(cell.runner) {
      continue
    }
    if !live && cell.status == "planned" {
      executable_probe_count = executable_probe_count + repeat
    } else if live && (cell.status == "pass" || cell.status == "fail" || cell.status == "error") {
      const observed_attempts = cell.observed?.telemetry?.request_attempt_count ?? 0
      executable_probe_count = executable_probe_count
        + if observed_attempts > 0 {
          observed_attempts
        } else {
          1
        }
    }
  }
  const base = {
    cap_usd: max_cost_usd,
    estimated_usd_known: false,
    actual_usd_known: !live,
    accounting: if live {
      "live campaign spend is unknown until per-probe usage receipts are priced and aggregated"
    } else {
      "dry run; no provider calls"
    },
    executable_probe_count: executable_probe_count,
  }
  if live {
    const observed = provider_tool_probe_campaign_observed_spend(cells)
    const unaccounted_probe_count = executable_probe_count - observed.request_attempt_count
    const accounting_complete = observed.unpriced_case_count == 0 && unaccounted_probe_count == 0
    return base
      + observed
      + {
        unaccounted_probe_count: unaccounted_probe_count,
        actual_usd_known: accounting_complete,
        accounting: if accounting_complete {
          "summed from runtime-priced per-case usage receipts"
        } else {
          "stopped after a live case without runtime-priced usage; no further provider calls were made"
        },
        budget_status: if !accounting_complete {
          "stopped_unpriced"
        } else if observed.actual_usd >= max_cost_usd {
          "exhausted"
        } else {
          "within_cap"
        },
      }
  }
  return base + {estimated_usd: 0.0, actual_usd: 0.0, estimated_usd_known: true}
}

pub type ProviderToolProbeCampaignReportContext = {
  env: dict,
  env_source: dict,
  campaign_slice?: dict,
  scorecard_artifacts?: dict,
}

pub fn provider_tool_probe_campaign_report(
  routes: list<ProviderToolProbeRoute>,
  behaviors: list<ProviderToolProbeBehavior>,
  cells: list<ProviderToolProbeCell>,
  live: bool,
  include_expensive: bool,
  output_dir: string,
  repeat: int,
  context: ProviderToolProbeCampaignReportContext,
  runtime: ProviderToolProbeRuntimeReceipt,
  catalog: ProviderToolProbeCatalogReceipt,
  max_cost_usd: float = 10.0,
) -> ProviderToolProbeCampaignReport {
  const campaign_slice = context.campaign_slice ?? {}
  return {
    schema_version: SCHEMA_VERSION,
    runtime: runtime,
    catalog: catalog,
    live: live,
    include_expensive: include_expensive,
    route_count: len(routes),
    behavior_count: len(behaviors),
    cell_count: len(cells),
    summary: __summary(cells),
    runner_summary: __runner_summary(cells),
    executable_gap: __executable_gap(cells),
    claim_controls: __claim_controls(live, cells),
    auth_readiness: __auth_readiness(routes, context.env, context.env_source),
    spend: __estimated_spend(live, cells, repeat, max_cost_usd),
    campaign_slice: campaign_slice,
    routes: routes,
    behaviors: behaviors,
    cells: cells,
    artifacts: {
      report_json: path_join(output_dir, "report.json"),
      report_markdown: path_join(output_dir, "report.md"),
    }
      + (context.scorecard_artifacts ?? {}),
  }
}

pub fn __markdown_escape(text: string) -> string {
  return replace(text, "|", "\\|")
}

pub fn __markdown_status(status: string) -> string {
  if status == "pass" {
    return "PASS"
  }
  if status == "fail" {
    return "FAIL"
  }
  if status == "error" {
    return "ERROR"
  }
  if status == "skip" {
    return "SKIP"
  }
  return "PLANNED"
}

pub fn provider_tool_probe_campaign_markdown(report: ProviderToolProbeCampaignReport) -> string {
  let out = "# Provider Contract Probe Campaign\n\n"
  out = out + "- Schema: `" + report.schema_version + "`\n"
  out = out + "- Target runtime: `" + json_stringify(report.runtime) + "`\n"
  out = out + "- Target catalog: `" + json_stringify(report.catalog) + "`\n"
  out = out + "- Live: " + to_string(report.live) + "\n"
  out = out + "- Include expensive defaults: " + to_string(report.include_expensive) + "\n"
  out = out + "- Routes: " + to_string(report.route_count) + "\n"
  out = out + "- Behaviors: " + to_string(report.behavior_count) + "\n"
  out = out + "- Cells: " + to_string(report.cell_count) + "\n"
  out = out + "- Summary: `" + json_stringify(report.summary) + "`\n"
  out = out + "- Runner summary: `" + json_stringify(report.runner_summary) + "`\n"
  out = out + "- Executable gap: `" + json_stringify(report.executable_gap) + "`\n"
  out = out + "- Claim controls: `" + json_stringify(report.claim_controls) + "`\n"
  out = out + "- Auth readiness: `" + json_stringify(report.auth_readiness) + "`\n"
  out = out + "- Campaign slice: `" + json_stringify(report.campaign_slice) + "`\n"
  out = out + "- Spend: `" + json_stringify(report.spend) + "`\n\n"
  out = out + "| Status | Provider | Model | Behavior | Mode | Tool format | Reason |\n"
  out = out + "| --- | --- | --- | --- | --- | --- | --- |\n"
  for cell in report.cells {
    out = out + "| "
      + __markdown_status(cell.status)
      + " | "
      + cell.provider
      + " | `"
      + cell.model
      + "` | "
      + cell.behavior
      + " | "
      + cell.mode
      + " | "
      + cell.tool_format
      + " | "
      + __markdown_escape(cell.reason)
      + " |\n"
  }
  return out
}
