import { help_requested, parse, parser } from "std/cli/argparse"

const ARTIFACTS_REL = "spec/protocol-artifacts"

const TARGETS = [
  {source: "HarnProtocol.swift", destination: "Sources/BurinCore/ACP/HarnProtocol.generated.swift"},
  {
    source: "harn-protocol.rs",
    destination: "crates/burin-tui/protocol/src/harn_protocol_generated.rs",
  },
  {source: "harn-protocol.ts", destination: "server/src/generated/harn-protocol.ts"},
  {source: "harn-protocol.ts", destination: "burin-portal/src/generated/harn-protocol.ts"},
]

fn repo_root(fs: HarnessFs) -> string {
  return path_normalize(path_join(fs.source_dir(), ".."))
}

fn effective_repo_root(fs: HarnessFs, root: string = "") -> string {
  if root != "" {
    return path_normalize(root)
  }
  return repo_root(fs)
}

fn artifact_root(fs: HarnessFs, root: string = "") -> string {
  return path_join(effective_repo_root(fs, root), ARTIFACTS_REL)
}

pub fn normalize_protocol_text(text: string) -> string {
  return text.replace("\r\n", "\n").replace("\r", "\n")
}

/** Apply the same canonicalization the downstream host uses when vendoring each target. */
pub fn normalize_protocol_target(
  process: HarnessProcess,
  source: string,
  source_path: string,
  text: string,
) -> string {
  const normalized = normalize_protocol_text(text)
  if !source.ends_with(".rs") {
    return normalized
  }
  const formatted = process.run(
    {program: "rustfmt", args: ["--emit", "stdout", "--quiet", source_path]},
  )
  if !formatted.success {
    throw "rustfmt failed while normalizing " + source + ": " + trim(formatted.stderr)
  }
  return normalize_protocol_text(formatted.stdout)
}

fn expand_user(env: HarnessEnv, path: string) -> string {
  if path == "~" {
    return env.get("HOME") ?? path
  }
  if path.starts_with("~/") {
    const home = env.get("HOME") ?? ""
    if home != "" {
      return path_join(home, path.substring(2, path.len()))
    }
  }
  return path
}

fn is_dir(fs: HarnessFs, path: string) -> bool {
  if path == "" || !fs.exists(path) {
    return false
  }
  return fs.stat(path).is_dir
}

fn is_file(fs: HarnessFs, path: string) -> bool {
  if path == "" || !fs.exists(path) {
    return false
  }
  return fs.stat(path).is_file
}

pub fn discover_downstream_root(
  env: HarnessEnv,
  fs: HarnessFs,
  explicit_root: string = "",
) -> string {
  if explicit_root != "" {
    return path_normalize(expand_user(env, explicit_root))
  }
  const env_root = env.get("DOWNSTREAM_HOST_ROOT") ?? ""
  if env_root != "" {
    return path_normalize(expand_user(env, env_root))
  }
  return ""
}

pub fn stale_downstream_protocol_bindings(
  process: HarnessProcess,
  fs: HarnessFs,
  downstream_root: string,
  harn_root: string = "",
) -> list<string> {
  let stale: list<string> = []
  const source_root = artifact_root(fs, harn_root)
  for target in TARGETS {
    const source = path_join(source_root, to_string(target.source))
    const destination_rel = to_string(target.destination)
    const destination = path_join(downstream_root, destination_rel)
    if !is_file(fs, destination) {
      stale = stale + [destination_rel + " (missing)"]
      continue
    }
    const source_text = normalize_protocol_target(
      process,
      to_string(target.source),
      source,
      fs.read_text(source),
    )
    const destination_text = normalize_protocol_text(fs.read_text(destination))
    if source_text != destination_text {
      stale = stale + [destination_rel]
    }
  }
  return stale
}

pub fn check_downstream_protocol_bindings(
  env: HarnessEnv,
  process: HarnessProcess,
  fs: HarnessFs,
  downstream_root_arg: string = "",
  required: bool = false,
  harn_root: string = "",
) -> dict {
  const downstream_root = discover_downstream_root(env, fs, downstream_root_arg)
  const artifacts = artifact_root(fs, harn_root)
  if !is_dir(fs, downstream_root) {
    return {
      ok: !required,
      skipped: !required,
      status: "missing_root",
      downstream_root: downstream_root,
      artifacts: artifacts,
      stale: [],
      stale_count: 0,
    }
  }
  const stale = stale_downstream_protocol_bindings(process, fs, downstream_root, harn_root)
  return {
    ok: len(stale) == 0,
    skipped: false,
    status: if len(stale) == 0 {
      "ok"
    } else {
      "stale"
    },
    downstream_root: downstream_root,
    artifacts: artifacts,
    stale: stale,
    stale_count: len(stale),
  }
}

fn arg_spec() {
  return parser(
    {
      name: "check_downstream_protocol_bindings",
      args: [
        {kind: "flag", name: "host_root", long: "--host-root", parse: "string", default: ""},
        {kind: "switch", name: "required", long: "--required", default: false},
      ],
    },
  )
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/check_downstream_protocol_bindings.harn -- [--host-root PATH] [--required]",
    )
    return nil
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    harness.runtime.exit(2)
  }
  const parsed = unwrap(parsed_result).options
  const report = check_downstream_protocol_bindings(
    harness.env,
    harness.process,
    harness.fs,
    to_string(parsed?.host_root ?? ""),
    parsed?.required ?? false,
  )
  if report.status == "missing_root" {
    if parsed?.required ?? false {
      harness.stdio.eprintln("error: downstream host checkout not found")
      harness.runtime.exit(1)
    }
    harness.stdio.println(
      "skipping downstream protocol binding drift check (no host checkout found)",
    )
    return nil
  }
  if report.stale_count > 0 {
    harness.stdio.eprintln(
      "error: downstream protocol bindings diverge from " + to_string(report.artifacts) + ":",
    )
    for path in report.stale {
      harness.stdio.eprintln("  " + to_string(path))
    }
    harness.stdio.eprintln(
      "hint: regenerate the host's vendored bindings from this Harn checkout or its matching release.",
    )
    harness.runtime.exit(1)
  }
  harness.stdio.println("downstream protocol bindings match " + to_string(report.artifacts))
  return nil
}
