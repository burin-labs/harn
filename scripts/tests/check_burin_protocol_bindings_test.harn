import { with_temp_dir } from "std/testing"
import "../check_burin_protocol_bindings.harn"

fn mkdirs(path: string) -> nil {
  let parts = split(path_normalize(path), "/")
  var current = if path.starts_with("/") {
    "/"
  } else {
    ""
  }
  for part in parts {
    if part == "" {
      continue
    }
    current = if current == "" || current == "/" {
      current + part
    } else {
      path_join(current, part)
    }
    if !harness.fs.exists(current) {
      harness.fs.mkdir(current)
    }
  }
  return nil
}

fn write_text(root: string, rel: string, text: string) -> nil {
  let path = path_join(root, rel)
  mkdirs(dirname(path) ?? root)
  harness.fs.write_text(path, text)
  return nil
}

fn write_sources(root: string, swift: string, ts: string) -> nil {
  write_text(root, "spec/protocol-artifacts/HarnProtocol.swift", swift)
  write_text(root, "spec/protocol-artifacts/harn-protocol.ts", ts)
  return nil
}

fn write_burin(root: string, swift: string, ts: string) -> nil {
  write_text(root, "Sources/BurinCore/ACP/HarnProtocol.generated.swift", swift)
  write_text(root, "server/src/generated/harn-protocol.ts", ts)
  return nil
}

@test
pipeline test_normalize_protocol_text_line_endings(task) {
  assert_eq(normalize_protocol_text("a\r\nb\rc\n"), "a\nb\nc\n")
}

@test
pipeline test_matching_bindings_pass_with_line_ending_normalization(task) {
  with_temp_dir(
    { root ->
      let harn_root = path_join(root, "harn")
      let burin_root = path_join(root, "burin-code")
      write_sources(harn_root, "swift\n", "type Foo = string\n")
      write_burin(burin_root, "swift\r\n", "type Foo = string\r\n")
      let report = check_burin_protocol_bindings(burin_root, true, harn_root)
      assert_eq(report.ok, true)
      assert_eq(report.status, "ok")
      assert_eq(report.stale_count, 0)
      assert_eq(report.skipped, false)
    },
  )
}

@test
pipeline test_stale_and_missing_bindings_are_reported_in_target_order(task) {
  with_temp_dir(
    { root ->
      let harn_root = path_join(root, "harn")
      let burin_root = path_join(root, "burin-code")
      write_sources(harn_root, "swift source\n", "ts source\n")
      write_text(burin_root, "Sources/BurinCore/ACP/HarnProtocol.generated.swift", "swift stale\n")
      mkdirs(path_join(burin_root, "server/src/generated"))
      let report = check_burin_protocol_bindings(burin_root, true, harn_root)
      assert_eq(report.ok, false)
      assert_eq(report.status, "stale")
      assert_eq(report.stale_count, 2)
      assert_eq(report.stale[0], "Sources/BurinCore/ACP/HarnProtocol.generated.swift")
      assert_eq(report.stale[1], "server/src/generated/harn-protocol.ts (missing)")
    },
  )
}

@test
pipeline test_missing_root_respects_required_flag(task) {
  with_temp_dir(
    { root ->
      let missing = path_join(root, "missing-burin")
      let optional = check_burin_protocol_bindings(missing, false, root)
      assert_eq(optional.ok, true)
      assert_eq(optional.skipped, true)
      assert_eq(optional.status, "missing_root")
      let required = check_burin_protocol_bindings(missing, true, root)
      assert_eq(required.ok, false)
      assert_eq(required.skipped, false)
      assert_eq(required.status, "missing_root")
    },
  )
}
