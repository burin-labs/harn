import "../nextest_filters_from_paths.harn"

const PACKAGES = [
  {
    dir: "crates/harn-cli",
    name: "harn-cli",
    tests: [
      {name: "orchestrator_http", path: "crates/harn-cli/tests/orchestrator_http.rs"},
      {name: "harn_cli_fast", path: "crates/harn-cli/tests/harn_cli_fast/main.rs"},
      {name: "declared_name", path: "crates/harn-cli/tests/different_name.rs"},
    ],
  },
  {dir: "crates/harn-vm", name: "harn-vm", tests: []},
]

pipeline test_workspace_packages_from_metadata_uses_declared_workspace_test_targets() {
  const meta = {
    workspace_members: ["id-cli", "id-vm"],
    packages: [
      {
        id: "id-cli",
        name: "harn-cli",
        manifest_path: "/repo/crates/harn-cli/Cargo.toml",
        targets: [
          {name: "declared", src_path: "/repo/crates/harn-cli/tests/source.rs", kind: ["test"]},
          {name: "harn", src_path: "/repo/crates/harn-cli/src/main.rs", kind: ["bin"]},
        ],
      },
      {id: "id-vm", name: "harn-vm", manifest_path: "/repo/crates/harn-vm/Cargo.toml"},
      {id: "id-excluded", name: "xtask", manifest_path: "/repo/xtask/Cargo.toml"},
    ],
  }
  assert_eq(
    workspace_packages_from_metadata(meta, "/repo"),
    [
      {
        dir: "crates/harn-cli",
        name: "harn-cli",
        tests: [{name: "declared", path: "crates/harn-cli/tests/source.rs"}],
      },
      {dir: "crates/harn-vm", name: "harn-vm", tests: []},
    ],
  )
  assert(
    is_err(
      try {
        workspace_packages_from_metadata({workspace_members: [], packages: []}, "/repo")
      },
    ),
  )
}

pipeline test_filter_for_paths_preserves_binary_and_package_mapping() {
  for row in [
    {
      path: "crates/harn-cli/tests/orchestrator_http/admin.rs",
      expected: "binary(orchestrator_http)",
    },
    {path: "crates/harn-cli/tests/orchestrator_http.rs", expected: "binary(orchestrator_http)"},
    {path: "crates/harn-cli/tests/test_util/process.rs", expected: "package(harn-cli)"},
    {path: "./crates/harn-vm/src/lib.rs", expected: "package(harn-vm)"},
    {path: "crates/harn-cli/tests/deleted_binary.rs", expected: "package(harn-cli)"},
    {path: "crates/harn-cli/tests/different_name.rs", expected: "binary(declared_name)"},
  ] {
    assert_eq(filter_for_path(row.path, PACKAGES), row.expected)
  }
  assert_eq(filter_for_path("README.md", PACKAGES), nil)
  assert_eq(filter_for_path("crates/excluded/src/lib.rs", PACKAGES), nil)
  assert_eq(filter_for_path("crates/harn-cli-extra/src/lib.rs", PACKAGES), nil)
}

pipeline test_filter_for_consolidated_main_rs_binary() {
  for path in [
    "crates/harn-cli/tests/harn_cli_fast/check_cli.rs",
    "crates/harn-cli/tests/harn_cli_fast/orchestrator_http/slack.rs",
  ] {
    assert_eq(filter_for_path(path, PACKAGES), "binary(harn_cli_fast)")
  }
  assert_eq(
    filter_for_path("crates/harn-cli/tests/test_util/process.rs", PACKAGES),
    "package(harn-cli)",
  )
}

pipeline test_nextest_filter_for_paths_dedupes_in_order() {
  assert_eq(
    nextest_filter_for_paths(
      [
        "crates/harn-cli/tests/orchestrator_http/admin.rs",
        "crates/harn-cli/tests/test_util/process.rs",
        "crates/harn-vm/src/flow/slice.rs",
        "./crates/harn-vm/src/lib.rs",
        "crates/harn-vm/tests/deleted_binary.rs",
      ],
      PACKAGES,
    ),
    "binary(orchestrator_http) or package(harn-cli) or package(harn-vm)",
  )
}
