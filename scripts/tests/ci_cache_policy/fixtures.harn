import { read_json_typed, read_yaml_typed } from "std/fs"
import { CiCachePolicy, ReleaseWarmCachePathPolicy } from "../../check_ci_cache_policy.harn"
import { E2E_WORKFLOW_CONCURRENCY_GROUP } from "../../ci_cache_policy/policy_core.harn"
import { CiJob, CiStep, CiWorkflow } from "../../ci_cache_policy/workflow_model.harn"

type PolicyWorkflow = CiWorkflow & {jobs: dict<string, CiJob>}

pub fn workflow_job(workflow: CiWorkflow, name: string) -> CiJob {
  const job = workflow.jobs?.[name]
  if job == nil {
    throw "Fixture workflow must contain job ${name}"
  }
  return job
}

pub fn workflow_job_steps(workflow: CiWorkflow, name: string) -> list<CiStep> {
  const steps = workflow_job(workflow, name).steps
  if steps == nil {
    throw "Fixture workflow job ${name} must contain steps"
  }
  return steps
}

fn read_workflow(fs: HarnessFs, name: string) -> PolicyWorkflow {
  return read_yaml_typed(
    fs,
    path_join(fs.source_dir(), "../../../.github/workflows/${name}"),
    schema_of(PolicyWorkflow),
  )
}

pub fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

pub fn windows_runner_expression() -> string {
  return gha_expression(
    "vars.HARN_CI_ENABLE_BLACKSMITH_WINDOWS == 'true' && 'blacksmith-8vcpu-windows-2025' || 'windows-latest'",
  )
}

pub fn ci_concurrency() {
  return {
    group: gha_expression("github.workflow")
      + "-"
      + gha_expression(
        "github.event.pull_request.number || github.event.merge_group.head_sha || (github.ref == 'refs/heads/main' && github.sha) || github.ref",
      ),
    "cancel-in-progress": gha_expression("github.event_name == 'pull_request'"),
  }
}

pub fn e2e_concurrency() {
  return {
    group: E2E_WORKFLOW_CONCURRENCY_GROUP,
    "cancel-in-progress": gha_expression(
      "github.event_name == 'pull_request' && github.event.action == 'synchronize'",
    ),
  }
}

pub fn cache_refresh_generation_steps(miss_guard: string) {
  return {
    steps: [
      {
        name: "Prepare Linux cache generation save",
        if: "github.ref == 'refs/heads/main' && " + miss_guard,
      },
      {name: "Install cargo-nextest", if: "matrix.install_nextest && " + miss_guard},
      {name: "Warm Cargo graph", if: miss_guard, run: gha_expression("matrix.warm_script")},
    ],
  }
}

pub fn native_source_key() -> string {
  return gha_expression(
    "hashFiles('Cargo.lock', 'Cargo.toml', 'crates/**', 'spec/**', 'tree-sitter-harn/**')",
  )
}

pub fn windows_cache_inputs(save: bool = false) {
  return {
    "shared-key": "workspace-windows",
    "target-dir": gha_expression("env.CARGO_TARGET_DIR"),
    ...if save {
      {save: true}
    } else {
      {}
    },
  }
}

pub fn policy(fs: HarnessFs) -> CiCachePolicy {
  return read_json_typed(
    fs,
    path_join(fs.source_dir(), "../../../.github/cache-policy.json"),
    schema_of(CiCachePolicy),
  )
}

pub fn release_warm_cache_path_policy() -> ReleaseWarmCachePathPolicy {
  return {
    release_build_inputs: [
      ".github/actions/rust-cache/**",
      ".github/actions/rust-toolchain/**",
      ".github/actions/sccache/**",
      ".github/actions/sccache-install/**",
      ".github/actions/sccache-save-local/**",
      ".github/release-runner-policy.json",
      ".github/release-warm-build-budget.json",
      ".github/release-warm-cache-paths.yml",
      ".github/workflows/build-release-binaries.yml",
      "**/Cargo.toml",
      "Cargo.lock",
      "Cargo.toml",
      "rust-toolchain.toml",
      "scripts/check_release_warm_build_budget.sh",
      "scripts/prune_ci_cache_generations.sh",
      "scripts/release_runner_matrix.sh",
    ],
  }
}

/** Address setup steps by id so inserting one cannot silently shift a fixture. */
pub fn setup_step_by_id(workflow: dict, id: string) {
  return (workflow.jobs.setup.steps ?? []).filter({ step -> step.id == id }).to_list()[0]
}

/**
 * The release setup checkout, unshallowed.
 *
 * `fetch-depth: 0` is load-bearing rather than cosmetic: the job pins a
 * detached `ref`, so the path filter has to fetch its comparison branch, and
 * stacking that second `--depth=1` fetch on a shallow clone is what produced
 * `shallow file has changed since we read it`.
 */
pub fn release_setup_checkout() {
  return {
    uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
    with: {"fetch-depth": 0},
  }
}

pub fn release_binary_workflow(fs: HarnessFs) -> PolicyWorkflow {
  return read_workflow(fs, "build-release-binaries.yml")
}

pub fn release_binary_workflow_with_filter_uses(fs: HarnessFs, uses: string) -> dict {
  const workflow = release_binary_workflow(fs)
  return {
    ...workflow,
    jobs: {
      ...workflow.jobs,
      setup: {
        ...workflow.jobs.setup,
        steps: workflow.jobs.setup.steps.map(
          { step ->
            if step?.id == "release-build-inputs" {
              return {...step, uses: uses}
            }
            return step
          },
        ),
      },
    },
  }
}

type PolicyAction = {runs: {steps: list<dict>}, inputs?: dict, outputs?: dict}

fn read_action(fs: HarnessFs, name: string) -> PolicyAction {
  return read_yaml_typed(
    fs,
    path_join(fs.source_dir(), "../../../.github/actions/${name}/action.yml"),
    schema_of(PolicyAction),
  )
}

pub fn node_action(fs: HarnessFs) -> PolicyAction {
  return read_action(fs, "node-cache")
}

pub fn setup_harn_action(fs: HarnessFs) -> PolicyAction {
  return read_action(fs, "setup-harn")
}

pub fn action(fs: HarnessFs) -> PolicyAction {
  return read_action(fs, "rust-cache")
}

pub fn action_step_by_id(action: dict, id: string) -> dict {
  const selected = action.runs.steps.filter(fn(step: dict) -> bool { return step?.id == id })
    .to_list()
  assert_eq(len(selected), 1, "the action must declare exactly one ${id} step")
  return selected[0]
}

pub fn cache_step(job: dict) -> dict {
  const selected = job.steps.filter(
    fn(step: dict) -> bool { return step?.uses == "./.github/actions/rust-cache" },
  )
    .to_list()
  assert_eq(len(selected), 1, "the job must declare exactly one Rust cache step")
  return selected[0]
}

pub fn workflows(fs: HarnessFs) -> dict<string, PolicyWorkflow> {
  let documents: dict<string, PolicyWorkflow> = {}
  for name in [
    "build-release-binaries.yml",
    "ci.yml",
    "cli-cold-start-budget.yml",
    "windows-nightly.yml",
    "macos-nightly.yml",
    "rust-cache-refresh.yml",
  ] {
    documents[name] = read_workflow(fs, name)
  }
  return documents
}

pub fn workflow_for(documents: dict<string, PolicyWorkflow>, name: string) -> PolicyWorkflow {
  const document = documents[name]
  if document == nil {
    throw "the canonical fixture must include ${name}"
  }
  return document
}
