import { read_yaml_typed } from "std/fs"
import { assert_error_contains } from "std/testing"
import { make_target_path_gate_errors } from "../../ci_cache_policy/make_target_paths.harn"
import {
  CiAction,
  CiWorkflow,
  action_post_condition,
  ci_text,
  concurrency_cancel,
  job_continue_on_error,
  job_needs,
  job_runner,
  job_timeout,
  matrix_include_rows,
  step_continue_on_error,
  step_timeout,
  strategy_fail_fast,
  strategy_max_parallel,
  trigger_ignored_paths,
} from "../../ci_cache_policy/workflow_model.harn"

pipeline test_current_workflow_decodes_once(harness: Harness) {
  const path = path_join(harness.fs.source_dir(), "../../../.github/workflows/ci.yml")
  const workflow = read_yaml_typed(harness.fs, path, schema_of(CiWorkflow))
  const jobs = workflow.jobs ?? {}
  assert(len(jobs) > 10, "the canonical workflow must be reached")
  const producer = jobs["rust-cli"]
  assert(producer != nil, "the canonical producer must exist")
  assert(len(producer.steps ?? []) > 0, "decoded producer steps must be retained")
}

pipeline test_workflow_decode_preserves_unowned_fields_and_expression_branches() {
  const source = {
    on: {push: nil, schedule: [{cron: "0 * * * *"}]},
    jobs: {
      build: {
        steps: [{uses: "example/action", with: {enabled: true, count: 2}}],
        strategy: {matrix: {include: "$" + "{{ fromJSON(inputs.matrix) }}"}},
        extra: {retained: true},
      },
    },
    extra: {retained: true},
  }
  assert(unwrap(schema_parse(source, schema_of(CiWorkflow))) == source)
  assert(is_ok(schema_parse({on: "push", jobs: {}}, schema_of(CiWorkflow))))
  assert(is_ok(schema_parse({on: ["push", "pull_request"], jobs: {}}, schema_of(CiWorkflow))))
}

pipeline test_workflow_decode_rejects_wrong_owned_shapes() {
  for source in [
    {jobs: "not jobs"},
    {jobs: {build: {steps: "not steps"}}},
    {jobs: {build: {steps: [{with: {value: {unexpected: "object"}}}]}}},
    {jobs: {build: {strategy: {matrix: {include: [nil]}}}}},
    {jobs: {build: {strategy: {matrix: {include: [{kind: {unexpected: "object"}}]}}}}},
  ] {
    assert(is_err(schema_parse(source, schema_of(CiWorkflow))), "wrong owned shapes must refuse")
  }
  assert(is_err(schema_parse({runs: {steps: "not steps"}}, schema_of(CiAction))))
  assert(is_err(schema_parse({runs: {main: {unexpected: "object"}}}, schema_of(CiAction))))
  assert(is_err(schema_parse({runs: {post: ["not a path"]}}, schema_of(CiAction))))
}

pipeline test_hyphenated_workflow_fields_preserve_typed_values() {
  for runner in ["ubuntu-24.04", ["self-hosted", "Linux"], {group: "build", labels: "Linux"}] {
    assert_eq(job_runner({"runs-on": runner}), runner)
  }
  assert_eq(job_runner(nil), nil)
  assert_eq(job_timeout({"timeout-minutes": 5}), 5)
  const timeout_expression = "$" + "{{ inputs.timeout }}"
  assert_eq(step_timeout({"timeout-minutes": timeout_expression}), timeout_expression)
  assert_eq(step_continue_on_error({"continue-on-error": false}), false)
  const optional_expression = "$" + "{{ matrix.optional }}"
  assert_eq(job_continue_on_error({"continue-on-error": optional_expression}), optional_expression)
  assert_eq(strategy_fail_fast({strategy: {"fail-fast": false}}), false)
  assert_eq(strategy_max_parallel({strategy: {"max-parallel": 2}}), 2)
  assert_eq(concurrency_cancel({"cancel-in-progress": true}), true)
  assert_eq(concurrency_cancel("group shorthand"), nil)
  assert_eq(trigger_ignored_paths({"paths-ignore": ["docs/**"]}), ["docs/**"])
  assert_eq(action_post_condition({runs: {"post-if": "success()"}}), "success()")
}

pipeline test_hyphenated_workflow_fields_refuse_malformed_owned_values() {
  assert_error_contains(fn() { return job_runner({"runs-on": 12}) }, "at root")
  assert_error_contains(fn() { return job_timeout({"timeout-minutes": false}) }, "at root")
  assert_error_contains(fn() { return step_timeout({"timeout-minutes": []}) }, "at root")
  assert_error_contains(
    fn() { return step_continue_on_error({"continue-on-error": {}}) },
    "at root",
  )
  assert_error_contains(fn() { return job_continue_on_error({"continue-on-error": 1}) }, "at root")
  assert_error_contains(
    fn() { return strategy_fail_fast({strategy: {"fail-fast": []}}) },
    "at root",
  )
  assert_error_contains(
    fn() { return strategy_max_parallel({strategy: {"max-parallel": false}}) },
    "at root",
  )
  assert_error_contains(fn() { return concurrency_cancel({"cancel-in-progress": 1}) }, "at root")
  assert_error_contains(
    fn() { return trigger_ignored_paths({"paths-ignore": "docs/**"}) },
    "at root",
  )
  assert_error_contains(fn() { return action_post_condition({runs: {"post-if": true}}) }, "at root")
}

pipeline test_path_filter_decode_refuses_scalar_coercion() {
  const gates = [{job: "proof", filter: "proof", target: "proof"}]
  const makefile = "proof:\n\tbash scripts/tool.sh\n"
  const steps = [{run: "make proof"}]
  const filters = "proof: [.github/workflows/ci.yml, Makefile, scripts/tool.sh]"
  assert_eq(
    make_target_path_gate_errors(
      {
        jobs: {
          changes: {steps: [{id: "surface_filter", with: {filters: filters}}]},
          proof: {steps: steps},
        },
      },
      makefile,
      gates,
    ),
    [],
  )
  assert_error_contains(
    fn() { return make_target_path_gate_errors(
      {
        jobs: {
          changes: {steps: [{id: "surface_filter", with: {filters: "proof: [12]"}}]},
          proof: {steps: steps},
        },
      },
      makefile,
      gates,
    ) },
    "must declare string-list path filters",
  )
}

pipeline test_job_needs_preserves_names_and_missing_jobs() {
  assert(job_needs(nil) == [])
  assert(job_needs({}) == [])
  assert(job_needs({needs: " build "}) == [" build "])
  assert(job_needs({needs: ["first", "second"]}) == ["first", "second"])
}

pipeline test_yaml_scalar_text_preserves_native_scalar_spellings() {
  for value in [nil, "  text  ", "", true, false, 0, -2, 0.5] {
    assert_eq(ci_text(value), trim(to_string(value ?? "")))
  }
  assert_eq(ci_text(false), "false")
  assert_eq(ci_text(0), "0")
}

pipeline test_static_matrix_rows_preserve_rows_and_refuse_dynamic_expressions() {
  const rows = [{kind: "first", enabled: true}, {kind: "second", count: 2}]
  assert_eq(matrix_include_rows({strategy: {matrix: {include: rows}}}), rows)
  assert_eq(matrix_include_rows(nil), [])
  assert_eq(matrix_include_rows({}), [])
  assert_error_contains(
    fn() { return matrix_include_rows({strategy: {matrix: "$" + "{{ fromJSON(inputs.matrix) }}"}}) },
    "requires a static include matrix",
  )
  assert_error_contains(
    fn() { return matrix_include_rows({strategy: {matrix: {include: "$" + "{{ inputs.rows }}"}}}) },
    "requires static include rows",
  )
}
