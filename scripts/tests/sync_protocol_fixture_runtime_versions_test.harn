// Tests for scripts/sync_protocol_fixture_runtime_versions.harn — exercise the
// pure helpers on synthetic inputs (no filesystem dependency).
import "../sync_protocol_fixture_runtime_versions.harn"

@test
pipeline test_is_semver(task) {
  assert_eq(is_semver("0.8.71"), true)
  assert_eq(is_semver("10.20.30"), true)
  assert_eq(is_semver("0.8"), false)
  assert_eq(is_semver("0.8.71.2"), false)
  assert_eq(is_semver("v0.8.71"), false)
  assert_eq(is_semver(""), false)
}

@test
pipeline test_py_repr(task) {
  assert_eq(py_repr("0.8"), "'0.8'")
  assert_eq(py_repr(""), "''")
}

@test
pipeline test_json_literal(task) {
  assert_eq(json_literal("0.8.71"), "\"0.8.71\"")
}

@test
pipeline test_count_old_values_string_leaf(task) {
  const data = json_parse(r#"{"version":"0.8.71"}"#)
  assert_eq(count_old_values(data, "0.8.71"), 1)
  assert_eq(count_old_values(data, "0.8.72"), 0)
}

@test
pipeline test_count_old_values_nested(task) {
  // Two matching string leaves (a list element and a nested dict value); the
  // dict key "k0.8.71" and the integer must NOT count.
  const data = json_parse(r#"{"a":"0.8.71","b":["0.8.71",1,{"c":"x"}],"k0.8.71":"y"}"#)
  assert_eq(count_old_values(data, "0.8.71"), 2)
}

@test
pipeline test_count_old_values_no_match(task) {
  const data = json_parse(r#"{"version":"0.9.0","items":[1,2,true,null]}"#)
  assert_eq(count_old_values(data, "0.8.71"), 0)
}

@test
pipeline test_replace_literals_only_string_literals(task) {
  // Quoted occurrences are rewritten; a bare substring inside a longer token
  // (the key "k0.8.71") is not, because the replacement carries the quotes.
  const text = r#"{"version": "0.8.71", "k0.8.71": "z"}"#
  const out = replace_literals(text, "0.8.71", "0.8.72")
  assert_eq(out, r#"{"version": "0.8.72", "k0.8.71": "z"}"#)
}

@test
pipeline test_replace_literals_preserves_formatting(task) {
  // Newlines, indentation, and array spacing are untouched.
  const text = "{\n  \"version\": \"0.8.71\",\n  \"modes\": [\"a\", \"b\"]\n}\n"
  const out = replace_literals(text, "0.8.71", "0.8.72")
  assert_eq(out, "{\n  \"version\": \"0.8.72\",\n  \"modes\": [\"a\", \"b\"]\n}\n")
}

@test
pipeline test_replace_then_recount_is_zero(task) {
  // End-to-end of the write path's invariant: after replacing literals, the
  // re-parsed value has zero remaining old string leaves.
  const text = r#"{"a":"0.8.71","b":["0.8.71"]}"#
  const updated = replace_literals(text, "0.8.71", "0.8.72")
  const reparsed = json_parse(updated)
  assert_eq(count_old_values(reparsed, "0.8.71"), 0)
  assert_eq(count_old_values(reparsed, "0.8.72"), 2)
}
