import { with_temp_dir } from "std/testing"
import "../check_python_boundary.harn"

fn mkdirs(path: string) -> nil {
  const parts = split(path_normalize(path), "/")
  let current = if path.starts_with("/") {
    "/"
  } else {
    ""
  }
  for part in parts {
    if part == "" {
      continue
    }
    current = if current == "" || current == "/" {
      current + part
    } else {
      path_join(current, part)
    }
    if !harness.fs.exists(current) {
      harness.fs.mkdir(current)
    }
  }
  return nil
}

fn write_file(root: string, rel: string) -> nil {
  const path = path_join(root, rel)
  mkdirs(dirname(path) ?? root)
  harness.fs.write_text(path, "print('fixture')\n")
  return nil
}

fn write_text(root: string, rel: string, text: string) -> nil {
  const path = path_join(root, rel)
  mkdirs(dirname(path) ?? root)
  harness.fs.write_text(path, text)
  return nil
}

@test
pipeline test_current_repo_python_boundary_is_explicit(task) {
  const report = check_python_boundary()
  assert_eq(report.violation_count, 0)
  const paths = report.allowed.map({ row -> row.path }).to_list()
  assert_eq(paths.contains("scripts/affected-crates.py"), false)
  assert_eq(paths.contains("scripts/check_protocol_bindings.py"), false)
  assert_eq(paths.contains("scripts/check_burin_protocol_bindings.py"), false)
  assert_eq(paths.contains("spec/protocol-artifacts/python/harn_protocol.py"), true)
}

@test
pipeline test_allowlist_exact_and_prefix_rules(task) {
  assert_eq(python_boundary_rule_for("scripts/affected-crates.py").allowed, false)
  const mcp_rule = python_boundary_rule_for("conformance/helpers/mcp_stdio_tool.py")
  assert_eq(mcp_rule.allowed, false)
  assert_eq(python_boundary_rule_for("conformance/helpers/http_proxy_server.py").allowed, false)
  assert_eq(python_boundary_rule_for("conformance/helpers/github_mock_server.py").allowed, false)
  assert_eq(python_boundary_rule_for("conformance/helpers/new_mock_server.py").allowed, false)
  assert_eq(python_boundary_rule_for("scripts/_bench_cli_cold_start.py").allowed, false)
  assert_eq(python_boundary_rule_for("scripts/verify_tree_sitter_parse.py").allowed, false)
  assert_eq(python_boundary_rule_for("scripts/new_orchestration.py").allowed, false)
}

@test
pipeline test_temp_tree_reports_only_unclassified_python(task) {
  with_temp_dir(
    { root ->
      write_file(root, "scripts/affected-crates.py")
      write_file(root, "conformance/helpers/http_proxy_server.py")
      write_file(root, "conformance/helpers/new_mock_server.py")
      write_file(root, "scripts/new_orchestration.py")
      write_file(root, ".harn/tmp/ignored.py")
      write_file(root, ".harn-tmp/parallel-test/ignored.py")
      write_file(root, "target/generated.py")
      const files = python_files(root)
      assert_eq(files.contains("scripts/affected-crates.py"), true)
      assert_eq(files.contains("scripts/new_orchestration.py"), true)
      assert_eq(files.contains("conformance/helpers/new_mock_server.py"), true)
      assert_eq(files.contains(".harn/tmp/ignored.py"), false)
      assert_eq(files.contains(".harn-tmp/parallel-test/ignored.py"), false)
      assert_eq(files.contains("target/generated.py"), false)
      const report = check_python_boundary(root)
      assert_eq(report.violation_count, 4)
      assert_eq(
        report.violations.map({ row -> row.path }).to_list().sort(),
        [
          "conformance/helpers/http_proxy_server.py",
          "conformance/helpers/new_mock_server.py",
          "scripts/affected-crates.py",
          "scripts/new_orchestration.py",
        ],
      )
    },
  )
}

@test
pipeline test_embedded_python_audit_rejects_control_plane_and_classifies_venv(task) {
  with_temp_dir(
    { root ->
      write_text(root, "scripts/bad.sh", "#!/bin/sh\npython3 - <<'PY'\nPY\n")
      write_text(root, "Makefile", "bad:\n\tpython -c 'print(1)'\n")
      write_text(root, ".github/workflows/bad.yml", "steps:\n  - run: python3 -c 'print(1)'\n")
      write_text(
        root,
        "scripts/generate_sdk_clients.sh",
        "#!/bin/sh\n    python3 -m venv \"$venv\"\n",
      )
      write_text(
        root,
        "scripts/fake_guard.sh",
        "cat > \"$fake_bin/python3\" <<'SH'\necho \"python3 must not run\" >&2\nSH\n",
      )
      const embedded = embedded_python_findings(root)
      assert_eq(
        embedded.violations.map({ row -> row.path }).to_list().sort(),
        [".github/workflows/bad.yml", "Makefile", "scripts/bad.sh"],
      )
      assert_eq(embedded.allowed.count, 1)
      assert_eq(embedded.allowed[0]?.owner, "Python SDK generator")
      assert_eq(embedded.allowed[0]?.reason.contains("Python SDK artifact"), true)
    },
  )
}

@test
pipeline test_python_invocation_pattern_ignores_mentions_but_catches_shell_commands(task) {
  assert_eq(line_invokes_python("echo \"python3 must not run\""), false)
  assert_eq(line_invokes_python("cat > \"$fake_bin/python3\" <<'SH'"), false)
  assert_eq(line_invokes_python("python3 -c 'print(1)'"), true)
  assert_eq(line_invokes_python("value | python -"), true)
  assert_eq(line_invokes_python("run && python3.12 tool.py"), true)
  assert_eq(line_invokes_python("if ! env MODE=x python3 tool.py; then"), true)
  assert_eq(line_invokes_python("\t@python3 tool.py"), true)
}
