// Tests for scripts/drift_preflight_members.harn — exercise the pure
// `members_for_tier` selector on synthetic dispatch tables (no filesystem).
import "../drift_preflight_members.harn"

@test
pipeline test_members_source_tier_sorted(task) {
  const dispatch = {"check-b": "source", "check-a": "source", "check-c": "binary"}
  assert_eq(members_for_tier(dispatch, "source"), ["check-a", "check-b"])
}

@test
pipeline test_members_binary_tier(task) {
  const dispatch = {"check-a": "source", "check-c": "binary", "check-d": "binary"}
  assert_eq(members_for_tier(dispatch, "binary"), ["check-c", "check-d"])
}

@test
pipeline test_members_excluded_never_selected(task) {
  const dispatch = {"check-a": "excluded", "check-b": "source"}
  assert_eq(members_for_tier(dispatch, "source"), ["check-b"])
  assert_eq(members_for_tier(dispatch, "binary"), [])
}

@test
pipeline test_members_empty_dispatch(task) {
  assert_eq(members_for_tier({}, "source"), [])
}

@test
pipeline test_members_unknown_tier(task) {
  const dispatch = {"check-a": "source"}
  assert_eq(members_for_tier(dispatch, "nope"), [])
}

@test
pipeline test_real_registry_pins_binary_semantics_boundaries(task) {
  const registry = toml_parse(harness.fs.read_text("../generated_artifacts.toml"))
  const dispatch = registry?.preflight?.dispatch ?? {}
  assert_eq(
    {
      "check-trigger-examples": dispatch?.["check-trigger-examples"],
      "check-docs-snippets": dispatch?.["check-docs-snippets"],
      "check-site-snippets": dispatch?.["check-site-snippets"],
      "check-stdlib-strict-types": dispatch?.["check-stdlib-strict-types"],
      "check-stdlib-public-return-types": dispatch?.["check-stdlib-public-return-types"],
    },
    {
      "check-trigger-examples": "binary",
      "check-docs-snippets": "binary",
      "check-site-snippets": "binary",
      "check-stdlib-strict-types": "binary",
      "check-stdlib-public-return-types": "binary",
    },
  )
}
