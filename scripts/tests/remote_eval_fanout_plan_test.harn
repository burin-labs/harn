import "../remote_eval_fanout_plan.harn"

fn catalog() {
  return {
    evals: {"cpp-test": {}, "swift-feat": {}, "zig-test": {}},
    groups: {
      "meter-mini": ["cpp-test", "zig-test"],
      duplicates: ["cpp-test", "cpp-test", "swift-feat"],
    },
  }
}

@test
pipeline test_expand_cells_expands_groups_and_deduplicates(task) {
  const cells = expand_cells("meter-mini,cpp-test,swift-feat", catalog())
  assert_eq(cells, ["cpp-test", "zig-test", "swift-feat"])
}

@test
pipeline test_build_shards_have_stable_ids_and_run_eval_args(task) {
  const shards = build_shards(
    ["cpp-test", "swift feat"],
    2,
    "scripts/run-eval.sh",
    "fw-gpt-oss-120b",
    ["agent.x=on"],
  )
  assert_eq(len(shards), 4)
  assert_eq(shards[0].id, "cpp-test-t1")
  assert_eq(shards[1].id, "cpp-test-t2")
  assert_eq(shards[2].id, "swift-feat-t1")
  assert_eq(
    shards[0].run_eval_args[0:7],
    ["bash", "scripts/run-eval.sh", "cpp-test", "--model", "fw-gpt-oss-120b", "--trials", "1"],
  )
  assert_eq(shards[0].run_eval_args[7:11], ["--meter", "--flag", "agent.x=on"])
}

@test
pipeline test_remote_eval_fanout_plan_records_concurrency_and_receipts(task) {
  const plan = remote_eval_fanout_plan(
    {
      cells: "duplicates",
      trials: 3,
      k: 1,
      max_concurrency: 4,
      max_escalating: 2,
      model: "fw-gpt-oss-120b",
      split: "meter-holdout",
      runner: "scripts/run-eval.sh",
      backend: "modal",
      flags: ["agent.stop_policy=escalate_single"],
    },
    catalog(),
  )
  assert_eq(plan.producer, "harn_remote_eval_fanout_plan_v1")
  assert_eq(plan.cells, ["cpp-test", "swift-feat"])
  assert_eq(plan.shard_count, 6)
  assert_eq(plan.concurrency.max_concurrency, 4)
  assert_eq(plan.concurrency.max_escalating, 2)
  assert_eq(plan.ledger.serialized_ingest, true)
  assert(plan.artifacts.required_receipts.contains("rejoin_summary"), "rejoin receipt required")
}

@test
pipeline test_remote_eval_fanout_plan_rejects_bad_concurrency(task) {
  const result = try {
    remote_eval_fanout_plan(
      {cells: "cpp-test", trials: 1, max_concurrency: 2, max_escalating: 3},
      catalog(),
    )
    "ok"
  } catch (err) {
    to_string(err)
  }
  assert_eq(result, "--max-escalating cannot exceed --max-concurrency")
}

fn small_plan() {
  return remote_eval_fanout_plan(
    {
      cells: "meter-mini",
      trials: 1,
      max_concurrency: 2,
      max_escalating: 1,
      model: "fw-gpt-oss-120b",
      split: "meter-holdout",
    },
    catalog(),
  )
}

@test
pipeline test_remote_eval_fanout_trial_receipt_pins_shard_contract(task) {
  const receipt = remote_eval_fanout_trial_receipt(
    small_plan(),
    "cpp-test-t1",
    {status: "passed", passed: true, artifact_dir: "remote/cpp-test-t1"},
    {bundle_manifest_path: "remote/cpp-test-t1/manifest.json"},
  )
  assert_eq(receipt.producer, "harn_remote_eval_fanout_trial_receipt_v1")
  assert_eq(receipt.shard_id, "cpp-test-t1")
  assert_eq(receipt.cell, "cpp-test")
  assert_eq(receipt.trial_index, 1)
  assert_eq(receipt.ok, true)
  assert_eq(receipt.artifacts.bundle_manifest_path, "remote/cpp-test-t1/manifest.json")
}

@test
pipeline test_remote_eval_fanout_artifact_manifest_rewrites_paths(task) {
  const manifest = remote_eval_fanout_artifact_manifest(
    small_plan(),
    {remote_root: "modal/run-1", local_root: ".harn/evals/run-1"},
  )
  assert_eq(manifest.producer, "harn_remote_eval_fanout_artifact_manifest_v1")
  assert_eq(manifest.shard_count, 2)
  assert_eq(manifest.path_rewrite_map[0].shard_id, "cpp-test-t1")
  assert_eq(manifest.path_rewrite_map[0].remote_prefix, "modal/run-1/cpp-test-t1")
  assert_eq(manifest.path_rewrite_map[0].local_prefix, ".harn/evals/run-1/cpp-test-t1")
}

@test
pipeline test_remote_eval_fanout_rejoin_blocks_missing_duplicate_failed_and_unknown(task) {
  const plan = small_plan()
  const good = remote_eval_fanout_trial_receipt(
    plan,
    "cpp-test-t1",
    {status: "passed", passed: true},
  )
  const duplicate = remote_eval_fanout_trial_receipt(
    plan,
    "cpp-test-t1",
    {status: "passed", passed: true},
  )
  const failed = remote_eval_fanout_trial_receipt(
    plan,
    "zig-test-t1",
    {status: "failed", passed: false},
  )
  const receipt = remote_eval_fanout_rejoin_receipt(
    plan,
    [good, duplicate, failed, {shard_id: "swift-feat-t1", status: "passed", ok: true}],
  )
  assert_eq(receipt.status, "blocked")
  assert_eq(receipt.ledger.ingest_ready, false)
  assert_eq(receipt.duplicate_shard_ids, ["cpp-test-t1"])
  assert_eq(receipt.unknown_shard_ids, ["swift-feat-t1"])
  assert_eq(receipt.failed_shards[0].shard_id, "zig-test-t1")
  assert_eq(receipt.missing_shard_ids, [])
}

@test
pipeline test_remote_eval_fanout_rejoin_allows_complete_success(task) {
  const plan = small_plan()
  const receipt = remote_eval_fanout_rejoin_receipt(
    plan,
    [
      remote_eval_fanout_trial_receipt(plan, "cpp-test-t1", {status: "passed", passed: true}),
      remote_eval_fanout_trial_receipt(plan, "zig-test-t1", {status: "passed", passed: true}),
    ],
  )
  assert_eq(receipt.status, "complete")
  assert_eq(receipt.ledger.ingest_ready, true)
  assert_eq(receipt.accepted_shard_count, 2)
  assert_eq(receipt.missing_shard_ids, [])
  assert_eq(receipt.duplicate_shard_ids, [])
  assert_eq(receipt.failed_shards, [])
}
