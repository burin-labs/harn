import { with_temp_dir } from "std/testing"
import "../verify_tree_sitter_parse.harn"

fn mkdirs(fs: HarnessFs, path: string) -> nil {
  const parts = split(path_normalize(path), "/")
  let current = if path.starts_with("/") {
    "/"
  } else {
    ""
  }
  for part in parts {
    if part == "" {
      continue
    }
    current = if current == "" || current == "/" {
      current + part
    } else {
      path_join(current, part)
    }
    if !fs.exists(current) {
      fs.mkdir(current)
    }
  }
  return nil
}

fn write_file(fs: HarnessFs, root: string, rel: string, text: string = "") -> nil {
  const path = path_join(root, rel)
  mkdirs(fs, dirname(path) ?? root)
  fs.write_text(path, text)
  return nil
}

@test
pipeline test_parse_cli_args(harness: Harness, task: unknown) {
  assert_eq(parse_cli_args([]).strict, false)
  assert_eq(parse_cli_args(["--strict"]).strict, true)
  assert_eq(parse_cli_args(["--help"]).help, true)
  const bad = parse_cli_args(["--wat"])
  assert_eq(bad.ok, false)
  assert_eq(bad.error, "error: unknown argument: --wat")
}

@test
pipeline test_native_lib_filename(harness: Harness, task: unknown) {
  assert_eq(native_lib_filename("Darwin"), "harn.dylib")
  assert_eq(native_lib_filename("Linux"), "harn.so")
}

@test
pipeline test_target_is_stale(harness: Harness, task: unknown) {
  assert_eq(target_is_stale(false, 10.0, 1.0), true)
  assert_eq(target_is_stale(true, 9.0, 10.0), true)
  assert_eq(target_is_stale(true, 10.0, 9.0), false)
}

@test
pipeline test_with_error_suffix(harness: Harness, task: unknown) {
  assert_eq(with_error_suffix("/tmp/a.harn"), "/tmp/a.error")
  assert_eq(with_error_suffix("/tmp/a.txt"), "/tmp/a.txt.error")
}

@test
pipeline test_positive_harn_files_skips_error_fixtures_and_other_roots(
  harness: Harness,
  task: unknown,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      write_file(harness.fs, root, "conformance/tests/good.harn", "let x = 1\n")
      write_file(harness.fs, root, "conformance/tests/bad.harn", "let x =\n")
      write_file(harness.fs, root, "conformance/tests/bad.error", "expected\n")
      write_file(harness.fs, root, "examples/demo/main.harn", "let y = 2\n")
      write_file(harness.fs, root, "tests/bridge/bridge.harn", "let z = 3\n")
      write_file(harness.fs, root, "other/ignored.harn", "let q = 4\n")
      const files = positive_harn_files(harness.fs, root).map({ path -> path_normalize(path) })
        .to_list()
      assert_eq(
        files.contains(path_normalize(path_join(root, "conformance/tests/good.harn"))),
        true,
      )
      assert_eq(
        files.contains(path_normalize(path_join(root, "conformance/tests/bad.harn"))),
        false,
      )
      assert_eq(files.contains(path_normalize(path_join(root, "examples/demo/main.harn"))), true)
      assert_eq(files.contains(path_normalize(path_join(root, "tests/bridge/bridge.harn"))), true)
      assert_eq(files.contains(path_normalize(path_join(root, "other/ignored.harn"))), false)
    },
  )
}

@test
pipeline test_parse_gate_builds_and_consumes_library_only_in_owned_temp(
  harness: Harness,
  task: unknown,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      const grammar = path_join(root, "tree-sitter-harn")
      const wrapper = path_join(grammar, "scripts/tree-sitter-cli.sh")
      write_file(harness.fs, root, "tree-sitter-harn/grammar.js", "module.exports = {}\n")
      write_file(harness.fs, root, "tree-sitter-harn/grammar/keywords.js", "module.exports = []\n")
      write_file(harness.fs, root, "tree-sitter-harn/src/parser.c", "/* generated */\n")
      write_file(harness.fs, root, "tree-sitter-harn/src/scanner.c", "/* scanner */\n")
      write_file(harness.fs, root, "conformance/tests/good.harn", "let x = 1\n")
      write_file(
        harness.fs,
        root,
        "tree-sitter-harn/scripts/tree-sitter-cli.sh",
        """
#!/usr/bin/env bash
set -euo pipefail
command="$1"
shift
case "$command" in
  generate)
    printf '/* regenerated */\n' > src/parser.c
    ;;
  build)
    output=""
    while [ "$#" -gt 0 ]; do
      if [ "$1" = "--output" ]; then
        shift
        output="$1"
      fi
      shift
    done
    [ -n "$output" ]
    mkdir -p "$(dirname "$output")"
    printf 'compiled\n' > "$output"
    printf '%s\n' "$output" > build-output.txt
    ;;
  parse)
    library=""
    while [ "$#" -gt 0 ]; do
      if [ "$1" = "--lib-path" ]; then
        shift
        library="$1"
      fi
      shift
    done
    test -f "$library"
    printf '%s\n' "$library" > parse-library.txt
    ;;
  *)
    exit 97
    ;;
esac
""",
      )
      const chmod = harness.process.run({program: "chmod", args: ["+x", wrapper]})
      assert_eq(chmod.success, true)
      assert_eq(verify_tree_sitter_parse(harness, root, true), 0)
      const built = harness.fs.read_text(path_join(grammar, "build-output.txt")).trim()
      const parsed = harness.fs.read_text(path_join(grammar, "parse-library.txt")).trim()
      assert_eq(parsed, built)
      assert_eq(built.starts_with(grammar), false)
      assert_eq(harness.fs.exists(built), false)
    },
  )
}
