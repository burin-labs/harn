import { with_temp_dir } from "std/testing"
import "../verify_tree_sitter_parse.harn"

fn mkdirs(path: string) -> nil {
  const parts = split(path_normalize(path), "/")
  let current = if path.starts_with("/") {
    "/"
  } else {
    ""
  }
  for part in parts {
    if part == "" {
      continue
    }
    current = if current == "" || current == "/" {
      current + part
    } else {
      path_join(current, part)
    }
    if !harness.fs.exists(current) {
      harness.fs.mkdir(current)
    }
  }
  return nil
}

fn write_file(root: string, rel: string, text: string = "") -> nil {
  const path = path_join(root, rel)
  mkdirs(dirname(path) ?? root)
  harness.fs.write_text(path, text)
  return nil
}

@test
pipeline test_parse_cli_args(task) {
  assert_eq(parse_cli_args([]).strict, false)
  assert_eq(parse_cli_args(["--strict"]).strict, true)
  assert_eq(parse_cli_args(["--help"]).help, true)
  const bad = parse_cli_args(["--wat"])
  assert_eq(bad.ok, false)
  assert_eq(bad.error, "error: unknown argument: --wat")
}

@test
pipeline test_native_lib_filename(task) {
  assert_eq(native_lib_filename("Darwin"), "harn.dylib")
  assert_eq(native_lib_filename("Linux"), "harn.so")
}

@test
pipeline test_target_is_stale(task) {
  assert_eq(target_is_stale(false, 10.0, 1.0), true)
  assert_eq(target_is_stale(true, 9.0, 10.0), true)
  assert_eq(target_is_stale(true, 10.0, 9.0), false)
}

@test
pipeline test_with_error_suffix(task) {
  assert_eq(with_error_suffix("/tmp/a.harn"), "/tmp/a.error")
  assert_eq(with_error_suffix("/tmp/a.txt"), "/tmp/a.txt.error")
}

@test
pipeline test_positive_harn_files_skips_error_fixtures_and_other_roots(task) {
  with_temp_dir(
    { root ->
      write_file(root, "conformance/tests/good.harn", "let x = 1\n")
      write_file(root, "conformance/tests/bad.harn", "let x =\n")
      write_file(root, "conformance/tests/bad.error", "expected\n")
      write_file(root, "examples/demo/main.harn", "let y = 2\n")
      write_file(root, "tests/bridge/bridge.harn", "let z = 3\n")
      write_file(root, "other/ignored.harn", "let q = 4\n")
      const files = positive_harn_files(root).map({ path -> path_normalize(path) }).to_list()
      assert_eq(files.contains(path_normalize(path_join(root, "conformance/tests/good.harn"))), true)
      assert_eq(files.contains(path_normalize(path_join(root, "conformance/tests/bad.harn"))), false)
      assert_eq(files.contains(path_normalize(path_join(root, "examples/demo/main.harn"))), true)
      assert_eq(files.contains(path_normalize(path_join(root, "tests/bridge/bridge.harn"))), true)
      assert_eq(files.contains(path_normalize(path_join(root, "other/ignored.harn"))), false)
    },
  )
}
