// Tests for scripts/check_crate_sibling_versions.harn.
import "../check_crate_sibling_versions.harn"

@test
pipeline test_workspace_version_from_text(harness: Harness, task: unknown) {
  const text = "[workspace]\n\n[workspace.package]\nversion = \"0.9.18\"\n"
  assert_eq(workspace_version_from_text(text), "0.9.18")
  assert_eq(expected_dependency_version("0.9.18"), "=0.9.18")
}

@test
pipeline test_manifest_metadata_helpers(harness: Harness, task: unknown) {
  const published = "[package]\nname = \"harn-vm\"\n"
  const private = "[package]\nname = \"harn-mcp-compat\"\npublish = false\n"
  assert_eq(manifest_package_name_from_text(published), "harn-vm")
  assert_eq(manifest_is_publishable_from_text(published), true)
  assert_eq(manifest_package_name_from_text(private), "harn-mcp-compat")
  assert_eq(manifest_is_publishable_from_text(private), false)
}

@test
pipeline test_accepts_exact_path_dependency(harness: Harness, task: unknown) {
  const text = "harn-vm = { path = \"../harn-vm\", version = \"=0.9.18\" }\n"
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", text, "0.9.18"), [])
}

@test
pipeline test_renamed_workspace_dependency_checks_package_identity(
  harness: Harness,
  task: unknown,
) {
  const exact =
    "aws-config = { package = \"harn-aws-config\", path = \"../harn-aws-config\", version = \"=0.9.18\" }\n"
  const loose =
    "aws-config = { package = \"harn-aws-config\", path = \"../harn-aws-config\", version = \"0.9.18\" }\n"
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", exact, "0.9.18"), [])
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", loose, "0.9.18").count, 1)
}

@test
pipeline test_dependency_package_and_path_are_structural(harness: Harness, task: unknown) {
  const outside =
    "harn-alias = { package = \"third-party\", path = \"../third-party\", version = \"0.9\" }\n"
  const registry = "harn-vm = { version = \"0.9\", features = [\"path\"] }\n"
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", outside, "0.9.18"), [])
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", registry, "0.9.18"), [])
  const private = "alias = { package = \"harn-private\", path = \"../harn-private\" }\n"
  assert_eq(
    sibling_dep_errors_from_text_with_context(
      "Cargo.toml",
      "[dependencies]\n" + private,
      "0.9.18",
      ["harn-private"],
      true,
    ).count,
    1,
  )
  assert_eq(
    sibling_dep_errors_from_text_with_context(
      "Cargo.toml",
      "[dev-dependencies]\n" + private,
      "0.9.18",
      ["harn-private"],
      true,
    ),
    [],
  )
}

@test
pipeline test_multiline_renamed_target_dependency_is_checked(harness: Harness, task: unknown) {
  const text =
    "[target.'cfg(windows)'.dependencies]\nsdk = { package = \"harn-aws-config\", path = \"../harn-aws-config\", version = \"0.9.18\", features = [\n  \"default\",\n] }\n"
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", text, "0.9.18").count, 1)
}

@test
pipeline test_rejects_loose_path_dependency(harness: Harness, task: unknown) {
  const text = "harn-modules = { path = \"../harn-modules\", version = \"0.9\" }\n"
  const errors = sibling_dep_errors_from_text("crates/harn-vm/Cargo.toml", text, "0.9.18")
  assert_eq(errors.count, 1)
  assert_eq(errors[0]?.contains("harn-modules path dependency version is \"0.9\""), true)
}

@test
pipeline test_rejects_missing_version(harness: Harness, task: unknown) {
  const text = "harn-parser = { path = \"../harn-parser\" }\n"
  const errors = sibling_dep_errors_from_text("crates/harn-fmt/Cargo.toml", text, "0.9.18")
  assert_eq(errors.count, 1)
  assert_eq(errors[0]?.contains("must set version = \"=0.9.18\""), true)
}

@test
pipeline test_checks_tree_sitter_workspace_sibling(harness: Harness, task: unknown) {
  const text = "tree-sitter-harn = { path = \"../../tree-sitter-harn\", version = \"0.9\" }\n"
  const errors = sibling_dep_errors_from_text("crates/harn-hostlib/Cargo.toml", text, "0.9.18")
  assert_eq(errors.count, 1)
  assert_eq(errors[0]?.contains("tree-sitter-harn"), true)
}

@test
pipeline test_ignores_registry_and_third_party_dependencies(harness: Harness, task: unknown) {
  const text = "harn-vm = { version = \"0.9\" }\nsqlx-core = { version = \"0.9\" }\n"
  assert_eq(sibling_dep_errors_from_text("Cargo.toml", text, "0.9.18"), [])
}

@test
pipeline test_allows_private_harness_crate_as_dev_dependency(harness: Harness, task: unknown) {
  const text = "[dev-dependencies]\nharn-mcp-compat = { path = \"../harn-mcp-compat\" }\n"
  const errors = sibling_dep_errors_from_text_with_context(
    "crates/harn-cli/Cargo.toml",
    text,
    "0.9.18",
    ["harn-mcp-compat"],
    true,
  )
  assert_eq(errors, [])
}

@test
pipeline test_rejects_private_harness_crate_as_publish_dependency(harness: Harness, task: unknown) {
  const text = "[dependencies]\nharn-mcp-compat = { path = \"../harn-mcp-compat\" }\n"
  const errors = sibling_dep_errors_from_text_with_context(
    "crates/harn-cli/Cargo.toml",
    text,
    "0.9.18",
    ["harn-mcp-compat"],
    true,
  )
  assert_eq(errors.count, 1)
  assert_eq(errors[0]?.contains("publish = false"), true)
}

@test
pipeline test_manifest_globs_cover_workspace_crates(harness: Harness, task: unknown) {
  assert_eq(manifest_globs().contains("crates/*/Cargo.toml"), true)
  assert_eq(manifest_globs().contains("tree-sitter-harn/Cargo.toml"), true)
}
