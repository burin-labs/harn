import { read_yaml } from "std/fs"

fn step_named(job: dict, name: string) -> dict? {
  return (job?.steps ?? []).find({ step -> step?.name == name })
}

/**
 * Release smoke runs inside the release candidate's own run, on archives it
 * verifies against the candidate manifest, and on a schedule from source.
 * Nothing smokes a release after publication, because publication no longer
 * builds or changes bytes.
 */
@complexity(allow)
fn release_smoke_workflow_errors(workflow: dict, caller: dict) -> list<string> {
  let errors: list<string> = []
  const triggers = workflow?.on ?? {}
  if triggers?.push != nil {
    errors = errors + ["release-smoke must not run on pushes"]
  }
  if triggers?.workflow_run != nil {
    errors = errors
      + ["release-smoke must not trigger after publication; the candidate run calls it"]
  }
  if triggers?.schedule == nil {
    errors = errors + ["release-smoke must keep its scheduled source-health mode"]
  }
  const call_input = triggers?.workflow_call?.inputs?.get("candidate-commit")
  if call_input?.required != true || call_input?.type != "string" {
    errors = errors + ["release-smoke must be callable with a required candidate-commit input"]
  }
  const smoke = workflow?.jobs?.smoke ?? {}
  const checkout = (smoke?.steps ?? []).find(
    { step -> to_string(step?.uses ?? "").starts_with("actions/checkout@") },
  )
  if to_string(checkout?.with?.ref ?? "") != "$" + "{{ inputs.candidate-commit || github.sha }}" {
    errors = errors
      + ["candidate smoke must check out the candidate commit, while source smoke keeps github.sha"]
  }
  const verify = step_named(smoke, "Verify and extract candidate archive")
  const verify_run = to_string(verify?.run ?? "")
  if verify == nil || !verify_run.contains("./scripts/ci/rust_artifact.sh restore-candidate")
    || !verify_run.contains("candidate-manifest.json") {
    errors = errors
      + [
        "candidate smoke must verify each archive against the candidate manifest before running it",
      ]
  }
  const manifest_download = step_named(smoke, "Download candidate manifest")
  if to_string(manifest_download?.with?.name ?? "")
    != "candidate-manifest-" + "$" + "{{ inputs.candidate-commit }}" {
    errors = errors + ["candidate smoke must read the manifest the calling run wrote"]
  }
  const run_smoke = step_named(smoke, "Run release smoke")
  if run_smoke == nil {
    errors = errors + ["smoke matrix must keep an attributable Run release smoke step"]
  } else {
    const run = to_string(run_smoke?.run ?? "")
    for required in [
      "\"$HARN_BINARY\" run --no-sandbox scripts/release_smoke.harn",
      "--candidate \"$HARN_BINARY\"",
      "--step-timeout-ms 120000",
    ] {
      if !run.contains(required) {
        errors = errors
          + ["release smoke must invoke the exact candidate through Harn: " + required]
      }
    }
    for forbidden in ["release_smoke.sh", "cargo build", "sleep ", "while ", "kill ", "taskkill"] {
      if run.contains(forbidden) {
        errors = errors
          + ["post-bootstrap release smoke must not own shell lifecycle: " + forbidden]
      }
    }
  }
  const call = caller?.jobs?.get("release-smoke") ?? {}
  if call?.uses != "./.github/workflows/release-smoke.yml"
    || to_string(call?.with?.get("candidate-commit") ?? "")
      != "$" + "{{ needs.setup.outputs.candidate_source_sha }}" {
    errors = errors
      + ["build-release-binaries must call release-smoke on its own candidate commit"]
  }
  if !(call?.needs ?? []).contains("collect_candidate_manifest") {
    errors = errors + ["the candidate smoke must wait for the candidate manifest"]
  }
  return errors
}

fn load(fs: HarnessFs, name: string) -> dict {
  return read_yaml(fs, path_join(fs.source_dir(), "../../.github/workflows/" + name))
}

@test
pipeline test_release_smoke_runs_on_the_candidate_archives(harness: Harness, task: unknown) {
  const workflow = load(harness.fs, "release-smoke.yml")
  const caller = load(harness.fs, "build-release-binaries.yml")
  assert_eq(release_smoke_workflow_errors(workflow, caller), [])
  let post_publication = json_parse(json_stringify(workflow))
  post_publication.on.workflow_run = {workflows: ["Build release binaries"], types: ["completed"]}
  assert(len(release_smoke_workflow_errors(post_publication, caller)) == 1)
  let unverified = json_parse(json_stringify(workflow))
  unverified.jobs.smoke.steps = unverified.jobs.smoke.steps.filter(
    { step -> step?.name != "Verify and extract candidate archive" },
  )
    .to_list()
  assert(
    join(release_smoke_workflow_errors(unverified, caller), "\n").contains(
      "verify each archive against the candidate manifest",
    ),
  )
  let uncalled = json_parse(json_stringify(caller))
  uncalled.jobs["release-smoke"] = {}
  assert(
    join(release_smoke_workflow_errors(workflow, uncalled), "\n").contains(
      "call release-smoke on its own candidate commit",
    ),
  )
}
