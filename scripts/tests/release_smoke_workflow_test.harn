import { read_yaml } from "std/fs"

fn step_named(job: dict, name: string) -> dict? {
  return (job?.steps ?? []).find({ step -> step?.name == name })
}

fn dist_preparation_precedes_build(job: dict, build_name: string) -> bool {
  let prepared = false
  for step in job?.steps ?? [] {
    if step?.name == "Prepare dist build environment" {
      prepared = true
    }
    if step?.name == build_name {
      return prepared
    }
  }
  return false
}

/**
 * Release smoke runs inside the release candidate's own run, on archives it
 * verifies against the candidate manifest, and on a schedule from source.
 * Nothing smokes a release after publication, because publication no longer
 * builds or changes bytes.
 */
@complexity(allow)
fn release_smoke_workflow_errors(workflow: dict, caller: dict) -> list<string> {
  let errors: list<string> = []
  const triggers = workflow?.on ?? {}
  if triggers?.push != nil {
    errors = errors + ["release-smoke must not run on pushes"]
  }
  if triggers?.workflow_run != nil {
    errors = errors
      + ["release-smoke must not trigger after publication; the candidate run calls it"]
  }
  if triggers?.schedule == nil {
    errors = errors + ["release-smoke must keep its scheduled source-health mode"]
  }
  const call_input = triggers?.workflow_call?.inputs?.get("candidate-commit")
  if call_input?.required != true || call_input?.type != "string" {
    errors = errors + ["release-smoke must be callable with a required candidate-commit input"]
  }
  const smoke = workflow?.jobs?.smoke ?? {}
  const prepare = step_named(smoke, "Prepare dist build environment")
  if prepare?.if != "steps.runtime.outputs.mode == 'source'"
    || prepare?.run != "bash scripts/ci/prepare_dist_build.sh"
    || !dist_preparation_precedes_build(smoke, "Build release harn binary") {
    errors = errors + ["source smoke must use the shared dist build environment"]
  }
  const release_prepare = step_named(caller?.jobs?.build ?? {}, "Prepare dist build environment")
  if release_prepare?.run != "bash scripts/ci/prepare_dist_build.sh \"$HARN_RELEASE_TARGET\""
    || release_prepare?.env?.HARN_RELEASE_TARGET != "$" + "{{ matrix.target }}"
    || !dist_preparation_precedes_build(caller?.jobs?.build ?? {}, "Build") {
    errors = errors + ["release builds must configure their matrix target through the shared owner"]
  }
  const source_build = step_named(smoke, "Build release harn binary")
  if source_build?.if != "steps.runtime.outputs.mode == 'source'"
    || source_build?.run
      != "bash scripts/ci/run_with_host_telemetry.sh source-smoke-build cargo build --locked --profile dist -p harn-cli --bin harn --features embedded-stdlib" {
    errors = errors + ["source smoke must stream telemetry around the actual dist compilation"]
  }
  const trusted_macos_runner = "$"
    + "{{ matrix.platform == 'macos' && github.event_name != 'pull_request' && github.ref == 'refs/heads/main' && fromJSON('[\"self-hosted\",\"harn-trusted-macos\"]') || matrix.runner }}"
  if smoke?.get("runs-on") != trusted_macos_runner {
    errors = errors
      + [
        "trusted macOS execution must use the protected native host while public pull requests retain hosted runners",
      ]
  }
  const checkout = (smoke?.steps ?? []).find(
    { step -> to_string(step?.uses ?? "").starts_with("actions/checkout@") },
  )
  if to_string(checkout?.with?.ref ?? "") != "$" + "{{ inputs.candidate-commit || github.sha }}" {
    errors = errors
      + ["candidate smoke must check out the candidate commit, while source smoke keeps github.sha"]
  }
  const verify = step_named(smoke, "Verify and extract candidate archive")
  const verify_run = to_string(verify?.run ?? "")
  if verify == nil || !verify_run.contains("./scripts/ci/rust_artifact.sh restore-candidate")
    || !verify_run.contains("candidate-manifest.json") {
    errors = errors
      + [
        "candidate smoke must verify each archive against the candidate manifest before running it",
      ]
  }
  const manifest_download = step_named(smoke, "Download candidate manifest")
  if to_string(manifest_download?.with?.name ?? "")
    != "candidate-manifest-" + "$" + "{{ inputs.candidate-commit }}" {
    errors = errors + ["candidate smoke must read the manifest the calling run wrote"]
  }
  const run_smoke = step_named(smoke, "Run release smoke")
  if run_smoke == nil {
    errors = errors + ["smoke matrix must keep an attributable Run release smoke step"]
  } else {
    const run = to_string(run_smoke?.run ?? "")
    for required in [
      "\"$HARN_BINARY\" run --no-sandbox scripts/release_smoke.harn",
      "--candidate \"$HARN_BINARY\"",
      "--step-timeout-ms 120000",
    ] {
      if !run.contains(required) {
        errors = errors
          + ["release smoke must invoke the exact candidate through Harn: " + required]
      }
    }
    for forbidden in ["release_smoke.sh", "cargo build", "sleep ", "while ", "kill ", "taskkill"] {
      if run.contains(forbidden) {
        errors = errors
          + ["post-bootstrap release smoke must not own shell lifecycle: " + forbidden]
      }
    }
  }
  const call = caller?.jobs?.get("release-smoke") ?? {}
  if call?.uses != "./.github/workflows/release-smoke.yml"
    || to_string(call?.with?.get("candidate-commit") ?? "")
      != "$" + "{{ needs.setup.outputs.candidate_source_sha }}" {
    errors = errors
      + ["build-release-binaries must call release-smoke on its own candidate commit"]
  }
  if !(call?.needs ?? []).contains("collect_candidate_manifest") {
    errors = errors + ["the candidate smoke must wait for the candidate manifest"]
  }
  return errors
}

fn load(fs: HarnessFs, name: string) -> dict {
  return read_yaml(fs, path_join(fs.source_dir(), "../../.github/workflows/" + name))
}

@test
pipeline test_release_smoke_runs_on_the_candidate_archives(harness: Harness) {
  const workflow = load(harness.fs, "release-smoke.yml")
  const caller = load(harness.fs, "build-release-binaries.yml")
  assert_eq(release_smoke_workflow_errors(workflow, caller), [])
  const unguarded_native = workflow
    + {jobs: workflow.jobs + {smoke: workflow.jobs.smoke + {"runs-on": "macos-arm64"}}}
  assert(
    join(release_smoke_workflow_errors(unguarded_native, caller), "\n").contains(
      "public pull requests retain hosted runners",
    ),
  )
  const event_only = workflow
    + {
      jobs: workflow.jobs
        + {
          smoke: workflow.jobs.smoke
            + {
              "runs-on": "$"
                + "{{ matrix.platform == 'macos' && github.event_name != 'pull_request' && 'macos-arm64' || matrix.runner }}",
            },
        },
    }
  assert(
    len(release_smoke_workflow_errors(event_only, caller)) > 0,
    "manual runs on public PR branches must retain hosted runners",
  )
  // The trusted host's group admits only refs/heads/main, so a merge-group
  // alternative queues the release's macOS smoke forever.
  const merge_group_alternative = workflow
    + {
      jobs: workflow.jobs
        + {
          smoke: workflow.jobs.smoke
            + {
              "runs-on": "$"
                + "{{ matrix.platform == 'macos' && github.event_name != 'pull_request' && (github.ref == 'refs/heads/main' || github.event_name == 'merge_group') && fromJSON('[\"self-hosted\",\"harn-trusted-macos\"]') || matrix.runner }}",
            },
        },
    }
  assert(
    len(release_smoke_workflow_errors(merge_group_alternative, caller)) > 0,
    "a merge group must not route to the main-only trusted host",
  )
  const post_publication = workflow
    + {
      on: workflow.on
        + {workflow_run: {workflows: ["Build release binaries"], types: ["completed"]}},
    }
  assert(len(release_smoke_workflow_errors(post_publication, caller)) == 1)
  const smoke = workflow.jobs.smoke
  const unprepared = workflow
    + {
      jobs: workflow.jobs
        + {
          smoke: smoke
            + {
              steps: smoke.steps.filter({ step -> step?.name != "Prepare dist build environment" })
                .to_list(),
            },
        },
    }
  assert(
    join(release_smoke_workflow_errors(unprepared, caller), "\n").contains(
      "source smoke must use the shared dist build environment",
    ),
  )
  const late_preparation = workflow
    + {
      jobs: workflow.jobs
        + {
          smoke: smoke
            + {
              steps: unprepared.jobs.smoke.steps
                + [step_named(smoke, "Prepare dist build environment")],
            },
        },
    }
  assert(
    join(release_smoke_workflow_errors(late_preparation, caller), "\n").contains(
      "source smoke must use the shared dist build environment",
    ),
  )
  const unverified = workflow
    + {
      jobs: workflow.jobs
        + {
          smoke: smoke
            + {
              steps: smoke.steps.filter(
                { step -> step?.name != "Verify and extract candidate archive" },
              )
                .to_list(),
            },
        },
    }
  assert(
    join(release_smoke_workflow_errors(unverified, caller), "\n").contains(
      "verify each archive against the candidate manifest",
    ),
  )
  const uncalled = caller + {jobs: caller.jobs + {"release-smoke": {}}}
  assert(
    join(release_smoke_workflow_errors(workflow, uncalled), "\n").contains(
      "call release-smoke on its own candidate commit",
    ),
  )
}
