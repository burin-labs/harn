// Tests for the shared Codex and Claude shell guard.
import {
  ADMISSION_CHECKED_ENV,
  GIT_ALIASES_UNREADABLE,
  NO_CONFIG_ALIASES,
  ShellGuardDecision,
  WorktreeAdmissionCensus,
  cargo_violation,
  discarded_output_violation,
  disposable_trash_violation,
  git_config_aliases,
  is_disposable_path,
  make_target_census,
  program_of,
  raw_worktree_add_attempt,
  raw_worktree_add_violation,
  segments_of,
  worktree_admission_census,
  worktree_admission_for,
} from "../agent_shell_guard.harn"
import { WORKTREE_ADMISSION_POLICY } from "../agent_shell_guard_policy"
import {
  ADMITTED,
  NO_MAKE_TARGETS,
  claude_payload,
  decision,
} from "./agent_shell_guard_test_fixtures"

// A repository that owns the admission command, and one that does not. The
// worktree rule must answer differently in the two, so every other case in
// this file states which repository it is standing in rather than inheriting a
// default.
const UNADMITTED: WorktreeAdmissionCensus = {
  rows: [{root: "/repo/unadmitted", command: ""}],
  denial: "",
}

fn verdict(payload: string) -> ShellGuardDecision {
  return decision(payload, ADMITTED, NO_MAKE_TARGETS)
}

fn codex_payload(command: string) -> string {
  return json_stringify(
    {
      session_id: "thread-1",
      turn_id: "turn-1",
      cwd: "/workspace",
      hook_event_name: "PreToolUse",
      tool_name: "Bash",
      tool_use_id: "call-1",
      tool_input: {command: command},
    },
  )
}

@test
pipeline test_program_of_sees_through_env_prefixes(harness: Harness, task: unknown) {
  assert_eq(program_of("cargo test"), "cargo")
  assert_eq(program_of("  cargo   test  "), "cargo")
  assert_eq(program_of("env -u HARN_EGRESS_BLOCK_PRIVATE cargo test"), "cargo")
  assert_eq(program_of("env -i -- cargo test"), "cargo")
  assert_eq(program_of("RUST_MIN_STACK=16777216 cargo build"), "cargo")
  assert_eq(program_of("command cargo test"), "cargo")
  assert_eq(program_of("exec cargo test"), "cargo")
  assert_eq(program_of("./target/release/harn run x.harn"), "harn")
  assert_eq(program_of("/usr/bin/make test"), "make")
  assert_eq(program_of(""), "")
}

@test
pipeline test_cargo_verbs_with_a_makefile_owner_are_denied(harness: Harness, task: unknown) {
  for verb in ["build", "check", "clippy", "fmt", "test", "nextest", "bench"] {
    assert(
      cargo_violation("cargo " + verb + " -p harn-vm") != "",
      "cargo " + verb + " should be denied",
    )
  }
  // The message names the replacement so the caller does not have to guess.
  assert(cargo_violation("cargo test -p harn-vm").contains("make test"))
  assert(cargo_violation("cargo +nightly test -p harn-vm").contains("make test"))
  assert(cargo_violation("cargo clippy").contains("make lint"))
  assert(cargo_violation("cargo bench").contains("make bench"))
}

@test
pipeline test_one_off_cargo_verbs_pass_through(harness: Harness, task: unknown) {
  // No Makefile owner: these are inspection commands, not build/test lanes.
  for command in ["cargo tree -p harn-vm", "cargo add serde", "cargo --version"] {
    assert_eq(cargo_violation(command), "")
  }
}

@test
pipeline test_cargo_is_caught_anywhere_in_a_pipeline(harness: Harness, task: unknown) {
  assert(cargo_violation("cd /repo && cargo test") != "")
  assert(cargo_violation("make build; cargo test | tail") != "")
  // A `cargo` substring inside another word is not a cargo call.
  assert_eq(cargo_violation("grep cargo-test README.md"), "")
}

@test
pipeline test_raw_git_worktree_add_is_denied_across_parser_shapes(harness: Harness, task: unknown) {
  for command in [
    "git worktree add ../lane origin/main",
    "/usr/bin/git worktree add -b lane ../lane origin/main",
    "env -u GIT_DIR git worktree add ../lane",
    "git -C /workspace worktree add ../lane origin/main",
    "git --no-pager -c advice.detachedHead=false worktree add --detach ../lane HEAD",
    "echo preparing && git worktree add ../lane && make setup",
    "bash -lc 'git worktree add ../lane origin/main'",
    "bash --norc -c 'git worktree add ../lane origin/main'",
    "sh -c \"git -C /workspace worktree add ../lane\"",
    "/usr/bin/env -u GIT_DIR command git --no-pager worktree add ../lane origin/main",
    "nohup /usr/bin/git worktree add ../lane origin/main",
    "sudo -u builder git worktree add ../lane origin/main",
    "timeout -k 5 60 git worktree add ../lane origin/main",
    "HARN_ALLOW_RAW_CARGO=1 git worktree add ../lane",
  ] {
    const violation = raw_worktree_add_violation(command)
    assert(violation != "", command + " should require Fleet admission")
    assert(violation.contains("fleet-worktree-admit"))
    assert(!verdict(codex_payload(command)).allow)
    assert(!verdict(claude_payload(command)).allow)
  }
}

@test
pipeline test_worktree_guard_does_not_match_text_or_non_creation_operations(
  harness: Harness,
  task: unknown,
) {
  for command in [
    "git worktree list --porcelain",
    "git worktree remove ../retired-lane",
    "git worktree prune",
    "rg 'git worktree add' docs",
    "echo 'git worktree add ../example'",
    "./scripts/fleet-worktree-admit --issue-url https://github.com/acme/repo/issues/1",
  ] {
    assert_eq(raw_worktree_add_violation(command), "", command + " is not raw creation")
    assert(verdict(codex_payload(command)).allow)
    assert(verdict(claude_payload(command)).allow)
  }
}

@test
pipeline test_quoted_shell_separators_stay_inside_arguments(harness: Harness, task: unknown) {
  const diagnostic = "ps -axo command | rg 'rustc .*harn_vm|cargo build --locked' | head -n 20"
  assert_eq(cargo_violation(diagnostic), "")
  assert_eq(len(segments_of(diagnostic)), 3)
  assert(verdict(codex_payload(diagnostic)).allow)
}

@test
pipeline test_piping_a_slow_command_into_a_filter_is_denied(harness: Harness, task: unknown) {
  for command in [
    "cargo test -p harn-vm | grep FAILED",
    "make test | tail -20",
    "pnpm run test | head",
    "swift build 2>&1 | grep error",
  ] {
    assert(
      discarded_output_violation(command) != "",
      command + " discards output that only a rerun could recover",
    )
  }
}

@test
pipeline test_redirecting_first_is_allowed(harness: Harness, task: unknown) {
  for command in [
    "make test > /tmp/out.log 2>&1; grep FAILED /tmp/out.log",
    "cargo test 2>&1 | tee /tmp/out.log | tail",
    "make check-drift > .harn-runs/cmd.log 2>&1",
  ] {
    assert_eq(discarded_output_violation(command), "", command + " keeps the full output")
  }
  assert(
    discarded_output_violation("cargo test | grep FAILED > /tmp/filtered.log") != "",
    "redirecting a filter does not preserve the full test run",
  )
  assert(
    discarded_output_violation("cargo test 2>&1 | tee -a | grep FAILED") != "",
    "tee options without a destination do not preserve the test run",
  )
  assert_eq(discarded_output_violation("cargo test 2>&1 | tee /tmp/full.log | grep FAILED"), "")
  assert_eq(discarded_output_violation("cargo test 2>&1 | tee -a /tmp/full.log | grep FAILED"), "")
}

@test
pipeline test_fast_commands_may_pipe_freely(harness: Harness, task: unknown) {
  for command in ["git status --short | head", "ls -la | grep harn", "echo hi | wc -l"] {
    assert_eq(discarded_output_violation(command), "")
  }
}

@test
pipeline test_disposable_paths_never_enter_user_trash(harness: Harness, task: unknown) {
  // Exact commands recovered from the two sessions that produced the leaked
  // Trash entries in burin-labs/harn#6418.
  for command in [
    "trash /tmp/burin-bench-baseline.out /tmp/burin-bench-check.out /tmp/burin-bench-measure.out",
    "trash /private/tmp/burin-bench-probe.iM1F3P",
    "trash '/tmp/burin bench output'",
    "trash /tmp/burin\\ bench\\ output",
    "/usr/bin/trash .build/arm64-apple-macosx/debug/ModuleCache",
  ] {
    const violation = disposable_trash_violation(command)
    assert(violation != "", command + " should keep generated data out of Trash")
    assert(violation.contains("exact, validated permanent cleanup"))
  }
}

@test
pipeline test_disposable_path_policy_covers_temp_and_generated_roots(
  harness: Harness,
  task: unknown,
) {
  for path in [
    "/tmp/output.log",
    "/private/tmp/probe",
    "/var/tmp/output.log",
    "/private/var/tmp/output.log",
    "$TMPDIR/output.log",
    "\${TMPDIR}/output.log",
    "$TMP/output.log",
    "\${TEMP}/output.log",
    "%TEMP%/output.log",
    "%tmp%/output.log",
    "$env:TEMP/output.log",
    "\${env:TMP}/output.log",
    "C:/Users/Alice/AppData/Local/Temp/output.log",
    "c:\\users\\alice\\appdata\\local\\temp\\output.log",
    "C:/Windows/Temp/output.log",
    "/var/folders/ab/cd/T/output.log",
    "/private/var/folders/ab/cd/T/output.log",
    ".build/debug/ModuleCache",
    "./target/debug",
    "/workspace/.harn-runs/check.log",
    ".burin-evals/trial.json",
    ".burin-live-evals/trial.json",
  ] {
    assert(is_disposable_path(path), path + " should be classified as disposable")
  }
  for path in [
    "/Users/alice/Documents/report.txt",
    "notes/target-audience.md",
    "/var/folders/ab/cd/not-temp/output.log",
    "C:/Users/Alice/Documents/Temp Notes/report.txt",
  ] {
    assert(!is_disposable_path(path), path + " should remain recoverable through Trash")
  }
}

@test
pipeline test_user_files_keep_recoverable_trash_path(harness: Harness, task: unknown) {
  for command in [
    "trash /Users/alice/Documents/report.txt",
    "/usr/bin/trash './draft notes.txt'",
    "echo 'trash /tmp/example'",
  ] {
    assert_eq(disposable_trash_violation(command), "", command + " should not be denied")
  }
}

@test
pipeline test_codex_and_claude_share_one_decision(harness: Harness, task: unknown) {
  for encode in [claude_payload, codex_payload] {
    assert(!verdict(encode("cargo test")).allow)
    assert(verdict(encode("HARN_ALLOW_RAW_CARGO=1 cargo test")).allow)
    assert(verdict(encode("make test")).allow)
    assert(verdict(encode("cargo tree -p harn-vm")).allow)
    assert(!verdict(encode("trash /tmp/generated.log")).allow)
    assert(!verdict(encode("git worktree add ../unowned origin/main")).allow)
    assert(!verdict(encode("/usr/bin/trash .build/debug/ModuleCache")).allow)
    assert(verdict(encode("trash /Users/alice/Documents/report.txt")).allow)
    // The Cargo-only escape must not bypass unrelated command policy.
    assert(!verdict(encode("HARN_ALLOW_RAW_CARGO=1 trash /tmp/generated.log")).allow)
  }
  // Non-Bash tools and unparseable payloads never deny — a broken guard must
  // not read as a rejection.
  assert(verdict(json_stringify({tool_name: "Read", tool_input: {}})).allow)
  assert(verdict("not json at all").allow)
  assert(verdict("").allow)
}

@test
pipeline test_worktree_refusal_requires_the_repository_to_own_admission(
  harness: Harness,
  task: unknown,
) {
  // The rule is pure argv analysis, so it fires in every repository that wires
  // this guard. Refusing in one with no admission command names a command the
  // operator cannot run, which is what this pair exists to prevent.
  const creation = "git worktree add ../lane origin/main"
  const admitted = decision(codex_payload(creation), ADMITTED, NO_MAKE_TARGETS)
  assert(!admitted.allow, "a repository that owns admission must refuse raw creation")
  assert(admitted.reason.contains("fleet-worktree-admit"))
  assert(
    admitted.reason.contains("scripts/fleet-worktree-admit.ts"),
    "the refusal must name where this repository provides the command: " + admitted.reason,
  )
  assert(
    admitted.reason.contains("--branch <branch>"),
    "the refusal must name the branch-only invocation: " + admitted.reason,
  )
  const unadmitted = decision(codex_payload(creation), UNADMITTED, NO_MAKE_TARGETS)
  assert(
    unadmitted.allow,
    "a repository with no admission command must allow raw creation: " + unadmitted.reason,
  )
  // Everything else the guard refuses is unaffected by admission.
  assert(!decision(codex_payload("cargo test"), UNADMITTED, NO_MAKE_TARGETS).allow)
}

@test
pipeline test_unreadable_admission_census_refuses_rather_than_reading_as_absent(
  harness: Harness,
  task: unknown,
) {
  // A denied look is not the same answer as an absent file. If it were allowed
  // to read as one, a sandbox that hides the repository would silently turn the
  // rule off in the one place it is wired.
  const blind: WorktreeAdmissionCensus = {
    rows: [],
    denial: "worktree admission: read denied for `/workspace/scripts/fleet-worktree-admit.ts`",
  }
  const verdict_blind = decision(codex_payload("git worktree add ../lane"), blind, NO_MAKE_TARGETS)
  assert(!verdict_blind.allow, "an unreadable census must refuse, not allow")
  assert(verdict_blind.reason.contains("could not tell"))
  assert(verdict_blind.reason.contains("read denied"))
}

@test
pipeline test_admission_is_read_from_the_wrappers_measurement(harness: Harness, task: unknown) {
  // The guard runs in a hook host with no filesystem builtin, so the wrapper
  // measures and reports. "Nobody measured" must never read as "no admission
  // command here", which is the only way this rule could switch itself off.
  const unmeasured = worktree_admission_census("", "")
  assert(unmeasured.denial != "", "an unset checked flag must be a denial")
  assert(unmeasured.denial.contains(ADMISSION_CHECKED_ENV))
  assert(!worktree_admission_for(unmeasured, "").available)
  const none_here = worktree_admission_census("1", "/repo/plain\t")
  assert_eq(none_here.denial, "", "a measured absence is an answer, not a denial")
  assert(!worktree_admission_for(none_here, "").available)
  assert_eq(worktree_admission_for(none_here, "").denial, "")
  const owned = worktree_admission_census("1", "/repo/owner\tscripts/fleet-worktree-admit.ts")
  assert(worktree_admission_for(owned, "").available)
  assert_eq(worktree_admission_for(owned, "").command, "scripts/fleet-worktree-admit.ts")
  // A wrapper naming a path this policy does not know has drifted from it.
  // Refusing by name beats silently treating the rename as "no command here".
  const drifted = worktree_admission_census("1", "/repo/owner\tscripts/renamed-admit.ts")
  assert(drifted.denial.contains("does not know"))
  // A REPOSITORY ADMITTED FROM OUTSIDE ITSELF. One repository owns the script
  // and admits others by naming them, which the row could not express while
  // the whole invocation had to be one allowlisted string. The program is
  // still pinned to the allowlist, by its tail when it is absolute.
  const pointed = worktree_admission_census(
    "1",
    "/repo/plain\t/repo/owner/scripts/fleet-worktree-admit.ts --repository-root /repo/plain",
  )
  assert_eq(pointed.denial, "", "a command pointed at the row's own root is a known shape")
  assert(worktree_admission_for(pointed, "").available)
  assert_eq(
    worktree_admission_for(pointed, "").command,
    "/repo/owner/scripts/fleet-worktree-admit.ts --repository-root /repo/plain",
  )
  // AND EVERY WAY THAT ROW COULD LIE. Each of these is a census refusal, not
  // an allow: widening the shape must not become a hole that a wrapper can
  // walk arbitrary arguments, or another repository's root, through.
  const elsewhere = worktree_admission_census(
    "1",
    "/repo/plain\t/repo/owner/scripts/fleet-worktree-admit.ts --repository-root /repo/other",
  )
  assert(
    elsewhere.denial.contains("does not know"),
    "a root the row is not about must be refused: " + elsewhere.denial,
  )
  // A PATH BOUNDARY, not a suffix. `.../notscripts/fleet-worktree-admit.ts`
  // ends with the known path as TEXT while naming a different directory, and
  // a tail match with no separator in front of it is the substring bug this
  // guard keeps having to not make.
  const unbounded_tail = worktree_admission_census(
    "1",
    "/repo/plain\t/repo/owner/notscripts/fleet-worktree-admit.ts --repository-root /repo/plain",
  )
  assert(
    unbounded_tail.denial.contains("does not know"),
    "the known path must end a directory, not just the string: " + unbounded_tail.denial,
  )
  const renamed_absolute = worktree_admission_census(
    "1",
    "/repo/plain\t/repo/owner/scripts/renamed-admit.ts --repository-root /repo/plain",
  )
  assert(
    renamed_absolute.denial.contains("does not know"),
    "a renamed program is refused wherever it lives: " + renamed_absolute.denial,
  )
  const extra_argument = worktree_admission_census(
    "1",
    "/repo/plain\tscripts/fleet-worktree-admit.ts --force --repository-root /repo/plain",
  )
  assert(
    extra_argument.denial.contains("does not know"),
    "an argument this policy never heard of is refused: " + extra_argument.denial,
  )
  // AFTER the valid pair, not before it. A trailing argument is the only shape
  // that tests the count rather than the flag: put the unknown word first and
  // the flag check refuses it and the count is never reached, which is a
  // control that passes without measuring what it names.
  const trailing_argument = worktree_admission_census(
    "1",
    "/repo/plain\tscripts/fleet-worktree-admit.ts --repository-root /repo/plain --force",
  )
  assert(
    trailing_argument.denial.contains("does not know"),
    "nothing may follow the one admitted pair: " + trailing_argument.denial,
  )
  const unknown_flag = worktree_admission_census(
    "1",
    "/repo/plain\tscripts/fleet-worktree-admit.ts --repo-root /repo/plain",
  )
  assert(
    unknown_flag.denial.contains("does not know"),
    "only the policy's own flag is admitted: " + unknown_flag.denial,
  )
  const relative_root = worktree_admission_census(
    "1",
    "/repo/plain\tscripts/fleet-worktree-admit.ts --repository-root plain",
  )
  assert(
    relative_root.denial.contains("does not know"),
    "a relative root cannot be checked against the row: " + relative_root.denial,
  )
  const bare_flag = worktree_admission_census(
    "1",
    "/repo/plain\tscripts/fleet-worktree-admit.ts --repository-root",
  )
  assert(
    bare_flag.denial.contains("does not know"),
    "a flag with no value is refused: " + bare_flag.denial,
  )
  // An empty census is nobody having looked, which is also a denial. Without
  // this the rule switches itself off the moment the wrapper reports nothing.
  assert(worktree_admission_census("1", "").denial != "")
}

@test
pipeline test_worktree_rule_answers_for_the_repository_the_command_targets(
  harness: Harness,
  task: unknown,
) {
  // The census used to be one answer for the guard's own installation, so a
  // command pointing at another repository was judged by this one and told to
  // run an admission command that does not exist where it pointed. The rows
  // below are the two repositories: one owns the command, one does not.
  const census = worktree_admission_census(
    "1",
    "/repo/owner\tscripts/fleet-worktree-admit.ts\n/repo/plain\t",
  )
  assert_eq(census.denial, "")
  // A target that owns no admission command is not policed by this rule, even
  // when another measured repository owns one. The guard briefly borrowed the
  // other root's command and pointed it at the target, which produced a
  // refusal rooted at a repository the operator never named and a remedy
  // nothing established would work. The target's own row is the contract.
  const unowned = decision(
    codex_payload("git -C /repo/plain worktree add /tmp/lane origin/main"),
    census,
    NO_MAKE_TARGETS,
  )
  assert(
    unowned.allow,
    "a target that owns no admission command is not this rule's: " + unowned.reason,
  )
  // A target that owns one is still refused, and names that repository's path.
  const refused = decision(
    codex_payload("git -C /repo/owner worktree add /tmp/lane origin/main"),
    census,
    NO_MAKE_TARGETS,
  )
  assert(!refused.allow, "a repository that owns the command must still be refused")
  assert(refused.reason.contains("scripts/fleet-worktree-admit.ts"))
  // A target no row covers was never looked at, and absence of a row must not
  // read as absence of a command. This is the arm that keeps the fix from
  // becoming a hole: the easy version of it allows anything unmeasured.
  const unmeasured = decision(
    codex_payload("git -C /repo/never-measured worktree add /tmp/lane origin/main"),
    census,
    NO_MAKE_TARGETS,
  )
  assert(!unmeasured.allow, "an unmeasured target must refuse, not allow")
  assert(unmeasured.reason.contains("could not tell"))
  assert(unmeasured.reason.contains("/repo/never-measured"))
  // With no directory of its own the command means the wrapper's repository,
  // which is the first row.
  const here = decision(
    codex_payload("git worktree add /tmp/lane origin/main"),
    census,
    NO_MAKE_TARGETS,
  )
  assert(!here.allow, "the first row owns the command, so a bare add is refused")
  // The nearest enclosing repository wins, so a worktree nested inside
  // another repository is judged by its own root rather than the outer one.
  const nested = worktree_admission_census(
    "1",
    "/repo/owner\tscripts/fleet-worktree-admit.ts\n/repo/owner/vendor\t",
  )
  // The inner root owns no command, so the command is allowed. THAT is what
  // shows the inner root was chosen: the outer root owns a command, so a
  // resolution that fell back to it would refuse and name it. An allow here
  // is only reachable by matching the longer root.
  const deep = decision(
    codex_payload("git -C /repo/owner/vendor/deep worktree add /tmp/lane origin/main"),
    nested,
    NO_MAKE_TARGETS,
  )
  assert(deep.allow, "the longest matching root must win: " + deep.reason)
  // The control for it, on the same census: the outer root DOES own a command,
  // so a target under it alone is refused and names that command. Without this
  // the assertion above would pass against a guard that had stopped reading
  // the census at all.
  const outer = decision(
    codex_payload("git -C /repo/owner/src worktree add /tmp/lane origin/main"),
    nested,
    NO_MAKE_TARGETS,
  )
  assert(!outer.allow, "the outer root still owns admission: " + outer.reason)
  assert(outer.reason.contains("scripts/fleet-worktree-admit.ts"), outer.reason)
}

@test
pipeline test_make_owned_build_refusal_requires_a_measured_target(harness: Harness, task: unknown) {
  // The pair that decides whether this rule is safe to ship at all. Cargo is
  // universal across the repositories that wire this guard; Swift is not. A
  // repository whose Makefile owns `swift-test` can be sent there, and one
  // whose Makefile does not must be left alone rather than pointed at a
  // target it has never declared.
  const owns = make_target_census("1", "build check swift-build swift-test test")
  const owns_none = make_target_census("1", "build check test")
  const refused = decision(codex_payload("swift test"), ADMITTED, owns)
  assert(!refused.allow, "a repository that owns swift-test must refuse a bare swift test")
  assert(
    refused.reason.contains("make swift-test"),
    "the refusal must name the target to run instead: " + refused.reason,
  )
  assert(!decision(codex_payload("swift build"), ADMITTED, owns).allow)
  // NEGATIVE CONTROL: the identical commands where the target does not exist.
  const allowed = decision(codex_payload("swift test"), ADMITTED, owns_none)
  assert(
    allowed.allow,
    "a repository with no swift-test target must not be sent to one: " + allowed.reason,
  )
  assert(decision(codex_payload("swift build"), ADMITTED, owns_none).allow)
  // An unmeasured repository is the same answer as one that owns nothing, and
  // deliberately the opposite of the worktree rule: refusing here would name
  // a command that may not exist, where refusing there prevents real harm.
  assert(decision(codex_payload("swift test"), ADMITTED, NO_MAKE_TARGETS).allow)
  assert(!make_target_census("", "swift-build swift-test").checked)
  assert_eq(len(make_target_census("", "swift-build swift-test").targets), 0)
  // The Make target itself is the allowed form, and so is a Swift verb no
  // rule claims.
  assert(decision(codex_payload("make swift-test ARGS='--filter Foo'"), ADMITTED, owns).allow)
  assert(decision(codex_payload("swift package resolve"), ADMITTED, owns).allow)
  assert(decision(codex_payload("swift --version"), ADMITTED, owns).allow)
  // The escape hatch is per tool, and must not open any other rule.
  assert(decision(codex_payload("HARN_ALLOW_RAW_SWIFT=1 swift build"), ADMITTED, owns).allow)
  assert(
    !decision(codex_payload("HARN_ALLOW_RAW_SWIFT=1 trash /tmp/generated.log"), ADMITTED, owns)
      .allow,
  )
  // The Cargo escape does not release a Swift build, and vice versa.
  assert(!decision(codex_payload("HARN_ALLOW_RAW_CARGO=1 swift build"), ADMITTED, owns).allow)
  assert(!decision(codex_payload("HARN_ALLOW_RAW_SWIFT=1 cargo build"), ADMITTED, owns).allow)
  // Compound and wrapped forms are classified per stage, like every other rule.
  assert(!decision(codex_payload("cd /repo && swift build"), ADMITTED, owns).allow)
  assert(!decision(codex_payload("env FOO=1 swift test"), ADMITTED, owns).allow)
  assert(decision(codex_payload("grep swift-test Makefile"), ADMITTED, owns).allow)
}

@test
pipeline test_an_option_value_is_not_read_as_the_subcommand(harness: Harness, task: unknown) {
  const owns: MakeTargetCensus = {checked: true, targets: ["swift-build", "swift-test"]}
  // The verb used to be "the first argument that does not begin with `-`",
  // which skips an option but not the option's value. `/tmp` became the verb
  // and no rule matched, so every Swift option with a value was a bypass.
  assert(
    !decision(codex_payload("swift --package-path /tmp test"), ADMITTED, owns).allow,
    "an option's value must not be read as the subcommand",
  )
  // An option the value table has never heard of must fail closed rather than
  // leave the same hole under a different name. This is the case an arity
  // table alone does not cover.
  assert(
    !decision(codex_payload("swift --not-a-known-option /tmp build"), ADMITTED, owns).allow,
    "an unknown option must not open the same bypass",
  )
  // POSITIVE CONTROL: a Swift subcommand no rule claims is still allowed, and
  // so is the Make target itself. Refusing everything would satisfy the two
  // assertions above while destroying the rule.
  assert(decision(codex_payload("swift package resolve"), ADMITTED, owns).allow)
  assert(decision(codex_payload("swift --version"), ADMITTED, owns).allow)
  assert(decision(codex_payload("make swift-test"), ADMITTED, owns).allow)
}

@test
pipeline test_a_raw_escape_only_releases_the_stage_that_sets_it(harness: Harness, task: unknown) {
  const owns: MakeTargetCensus = {checked: true, targets: ["swift-build", "swift-test"]}
  // The escape used to be a substring search over the whole command, so an
  // unrelated earlier stage that merely mentioned it released the guarded one.
  assert(
    !decision(codex_payload("echo HARN_ALLOW_RAW_SWIFT=1; swift test"), ADMITTED, owns).allow,
    "a mention in another stage must not release the swift stage",
  )
  assert(
    !decision(codex_payload("echo HARN_ALLOW_RAW_CARGO=1; cargo test"), ADMITTED, owns).allow,
    "a mention in another stage must not release the cargo stage",
  )
  // The same text as an argument rather than an assignment is also not an
  // escape, on the stage that runs the tool.
  assert(
    !decision(codex_payload("swift test --filter HARN_ALLOW_RAW_SWIFT=1"), ADMITTED, owns).allow,
    "the escape is an assignment, not an argument",
  )
  // POSITIVE CONTROL: the real assignment on the guarded stage still releases
  // it, through a bare prefix and through `env`. Without these, a guard that
  // ignored the escape entirely would pass every assertion above.
  assert(decision(codex_payload("HARN_ALLOW_RAW_SWIFT=1 swift test"), ADMITTED, owns).allow)
  assert(decision(codex_payload("env HARN_ALLOW_RAW_SWIFT=1 swift build"), ADMITTED, owns).allow)
  assert(decision(codex_payload("HARN_ALLOW_RAW_CARGO=1 cargo test"), ADMITTED, owns).allow)
  assert(
    decision(codex_payload("echo hi && HARN_ALLOW_RAW_SWIFT=1 swift test"), ADMITTED, owns).allow,
    "an earlier unrelated stage must not withdraw a real escape",
  )
}

@test
pipeline test_absolute_cd_names_the_repository_the_creation_targets(
  harness: Harness,
  task: unknown,
) {
  // A command that reaches another repository by changing directory first used
  // to be judged against the repository this guard is installed in, so the
  // rule answered for the wrong root entirely.
  // INVERTED ON PURPOSE. These cases prove that a `cd` selected the repository
  // the command lands in, and the proof has to be a refusal that could only
  // come from that repository's own row. So the repository the `cd` moves to
  // is the one that owns the admission command, and the other root owns none:
  // a scan that lost the directory falls back to a root with nothing to name
  // and ALLOWS, which is exactly the defect these cases now catch.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/plain", command: ""},
      {root: "/repo/admitted", command: "scripts/fleet-worktree-admit.ts"},
    ],
    denial: "",
  }
  const moved = decision(
    codex_payload("cd /repo/admitted && git worktree add ../lane origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!moved.allow, "a creation in a repository reached by cd must be refused")
  assert(
    moved.reason.contains("scripts/fleet-worktree-admit.ts"),
    "the refusal must name the target's own command: " + moved.reason,
  )
  // AN OPTION IS NOT THE DESTINATION. `-P` is what a script writes when it
  // wants the physical path. Read as the directory it answers "not absolute",
  // the working directory stays empty, and the raw creation is ALLOWED in a
  // repository that advertises admission.
  for spelling in [
    "cd -P /repo/admitted && git worktree add ../lane origin/main",
    "cd -L -P /repo/admitted && git worktree add ../lane origin/main",
    "cd -- /repo/admitted && git worktree add ../lane origin/main",
  ] {
    const optioned = decision(codex_payload(spelling), mixed, NO_MAKE_TARGETS)
    assert(!optioned.allow, "cd options must be stepped over: " + spelling)
    assert(
      optioned.reason.contains("scripts/fleet-worktree-admit.ts"),
      "the refusal must name the target's own command: " + optioned.reason,
    )
  }
  // `--` ENDS options rather than being one, so a directory literally named
  // `-P` is still reachable and is not mistaken for an option to skip.
  const literal = decision(
    codex_payload("cd -- -P && git worktree add ../lane origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(literal.allow, "a relative operand after -- names no measured root: " + literal.reason)
  // `-C` names one invocation and still wins over the directory a cd moved to.
  const named = decision(
    codex_payload("cd /repo/admitted && git -C /repo/plain worktree add ../lane"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(named.allow, "an explicit -C wins over the directory a cd established: " + named.reason)
}

@test
pipeline test_a_cd_survives_a_shell_launched_after_it(harness: Harness, task: unknown) {
  // The directory a `cd` established holds for a shell launched after it, the
  // same way it holds for the next stage. Scanning the nested payload from a
  // fresh directory judged the creation against the repository this guard is
  // installed in, which is the defect the directory tracking exists to remove.
  // Inverted for the reason given above: the repository the `cd` reaches is
  // the one that owns the admission command, so only a refusal naming that
  // command proves the directory was carried in.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/plain", command: ""},
      {root: "/repo/admitted", command: "scripts/fleet-worktree-admit.ts"},
    ],
    denial: "",
  }
  const nested = decision(
    codex_payload("cd /repo/admitted && bash -lc 'git worktree add ../lane origin/main'"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!nested.allow, "a creation inside a nested shell must still be refused")
  assert(
    nested.reason.contains("scripts/fleet-worktree-admit.ts"),
    "the nested scan must inherit the directory the cd established: " + nested.reason,
  )
  // Two levels deep, so the inheritance is carried rather than special-cased
  // for the first nesting.
  const deeper = decision(
    codex_payload("cd /repo/admitted && bash -lc \"sh -c 'git worktree add ../lane origin/main'\""),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!deeper.allow)
  assert(
    deeper.reason.contains("scripts/fleet-worktree-admit.ts"),
    "the directory must survive more than one nesting: " + deeper.reason,
  )
  // A `cd` inside the nested payload still wins, so inheriting a directory
  // never overrides one the inner shell names for itself.
  const inner = decision(
    codex_payload("cd /repo/plain && bash -lc 'cd /repo/admitted && git worktree add ../lane'"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!inner.allow)
  assert(
    inner.reason.contains("scripts/fleet-worktree-admit.ts"),
    "a cd inside the nested payload must win over the inherited one: " + inner.reason,
  )
}

@test
pipeline test_the_cd_option_separator_is_not_the_directory(harness: Harness, task: unknown) {
  // `cd -- <path>` is the standard spelling for a directory that could be read
  // as an option. Taking `--` as the argument answers "no absolute target",
  // which leaves the rule with no repository to judge and lets the raw
  // creation through. A test on the plain form cannot reach this.
  // Inverted for the reason given above: the repository the `cd` reaches is
  // the one that owns the admission command, so only a refusal naming that
  // command proves the directory was carried in.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/plain", command: ""},
      {root: "/repo/admitted", command: "scripts/fleet-worktree-admit.ts"},
    ],
    denial: "",
  }
  const separated = decision(
    codex_payload("cd -- /repo/admitted && git worktree add ../lane origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!separated.allow)
  assert(
    separated.reason.contains("scripts/fleet-worktree-admit.ts"),
    "`cd --` must name the directory after the separator: " + separated.reason,
  )
  // The separator does not invent a target either: with nothing after it there
  // is no directory, and the answer falls back rather than reading `--`.
  const bare = decision(
    codex_payload("cd -- && git worktree add ../lane origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(bare.allow, "a bare separator must never be read as a directory: " + bare.reason)
}

@test
pipeline test_relative_cd_is_not_resolved_into_a_repository(harness: Harness, task: unknown) {
  // The hook payload carries no working directory, so a relative cd cannot be
  // resolved. Guessing a root is the error this rule exists to prevent, and it
  // must fall back to the answer it had before rather than invent one.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/plain", command: ""},
      {root: "/repo/admitted", command: "scripts/fleet-worktree-admit.ts"},
    ],
    denial: "",
  }
  const relative = decision(
    codex_payload("cd ../elsewhere && git worktree add ../lane origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  // No root was guessed, so the answer falls back to the wrapper's own
  // repository, which owns no command. With no target to point a borrowed
  // command at there is no remedy to name, and naming none is the whole
  // defect, so this stays allowed rather than refusing into a dead end.
  assert(relative.allow, "a relative cd must not be resolved into a repository: " + relative.reason)
  assert(!relative.reason.contains("/elsewhere"), relative.reason)
  // The same command with an absolute cd is refused, which is what proves the
  // allowance above is about the relative path and not about the rule being
  // off on this census.
  const absolute = decision(
    codex_payload("cd /repo/admitted && git worktree add ../lane origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!absolute.allow, "an absolute cd must still be refused")
}

@test
pipeline test_no_measured_repository_owning_admission_still_allows(
  harness: Harness,
  task: unknown,
) {
  // The remedy has to exist. Where nothing measured owns an admission command
  // there is nothing to name, and the raw command stays allowed rather than
  // being refused with no way forward.
  const none: WorktreeAdmissionCensus = {
    rows: [{root: "/repo/a", command: ""}, {root: "/repo/b", command: ""}],
    denial: "",
  }
  const verdict_none = decision(
    codex_payload("cd /repo/b && git worktree add ../lane origin/main"),
    none,
    NO_MAKE_TARGETS,
  )
  assert(
    verdict_none.allow,
    "with no admission command anywhere the creation must stay allowed: " + verdict_none.reason,
  )
}

@test
pipeline test_the_admission_command_named_in_a_refusal_exists(harness: Harness, task: unknown) {
  // The defect this rule exists to remove is a refusal naming a path that is
  // not there, so the assertion reads the path back out of the refusal and
  // checks it on disk, rather than trusting the sentence. The path is read
  // relative to the repository the refusal is about, which is the only
  // repository the sentence offers it in. Fixture repositories, never a real
  // checkout: a test that passes because the host happens to be laid out a
  // certain way measures the host.
  const fixtures = harness.fs.mkdtemp_in_workspace("shell-guard-admission-")
  const target = path_join(fixtures, "target")
  const other = path_join(fixtures, "other")
  const relative = WORKTREE_ADMISSION_POLICY.admission_command_paths[0] ?? ""
  harness.fs.write_text(path_join(target, relative), "// fixture admission command\n")
  harness.fs.write_text(path_join(other, "README.md"), "no admission command here\n")
  const census: WorktreeAdmissionCensus = {
    rows: [{root: other, command: ""}, {root: target, command: relative}],
    denial: "",
  }
  const refused = decision(
    codex_payload("cd " + target + " && git worktree add ../lane origin/main"),
    census,
    NO_MAKE_TARGETS,
  )
  assert(!refused.allow, "a repository that owns admission must be refused")
  assert_eq(
    len(refused.reason.split("Run it as `")),
    2,
    "the refusal must name one command: " + refused.reason,
  )
  // The path is matched against the paths this policy knows rather than cut
  // out of the sentence, so the assertion also proves the refusal names one
  // of them and never an improvised path.
  let named = ""
  for candidate in WORKTREE_ADMISSION_POLICY.admission_command_paths {
    if refused.reason.contains(
      "Run it as `" + candidate + " " + WORKTREE_ADMISSION_POLICY.admission_arguments + "`",
    ) {
      named = candidate
    }
  }
  assert(named != "", "the refusal must name a path this policy knows: " + refused.reason)
  assert(
    harness.fs.exists(path_join(target, named)),
    "the refusal named a command that does not exist in the repository it is about: " + named,
  )
}

@test
pipeline test_a_cd_narrows_only_through_an_unbroken_and_chain(harness: Harness, task: unknown) {
  // THE REVIEWER'S SHAPE, and one negation per clause, in a case of its own
  // so a control can measure each alone.
  //
  // A `cd` narrows only when (a) it carries one operand and is not in a
  // pipeline, (b) it is reached unconditionally, and (c) every operator
  // between it and the command is `&&`.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/guard", command: "scripts/fleet-worktree-admit.ts"},
      {root: "/repo/plain", command: ""},
    ],
    denial: "",
  }
  // Row zero owns the command, so the bare form is the refusal these shapes
  // must not lose. Without this the whole case could pass on a census that
  // refuses nothing.
  const bare = decision(
    codex_payload("git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!bare.allow, "the bare creation must be refused or this fixture proves nothing")
  // (a) negated, twice. Two operands make the `cd` FAIL, which is the
  // reviewer's command: the `&&` then short-circuits and the `||` runs the
  // creation from the ORIGINAL directory. A `cd` inside a pipeline runs in a
  // subshell and never moves what follows.
  //
  // (b) negated: `||` before the `cd` means the shell may never reach it.
  //
  // (c) negated, twice: a `;` between the `cd` and the command runs the
  // command either way, and a `||` between them catches the `cd`'s failure.
  for routed in [
    "cd /repo/plain extra && false || git worktree add ../unowned origin/main",
    "cd /repo/plain extra && git worktree add ../unowned origin/main",
    "cd /repo/plain | cat && git worktree add ../unowned origin/main",
    "true || cd /repo/plain && git worktree add ../unowned origin/main",
    "cd /repo/plain; git worktree add ../unowned origin/main",
    "cd /repo/plain || true && git worktree add ../unowned origin/main",
  ] {
    const verdict = decision(codex_payload(routed), mixed, NO_MAKE_TARGETS)
    assert(!verdict.allow, "a cd that is not proven to have taken effect must union: " + routed)
    assert(
      verdict.reason.contains("scripts/fleet-worktree-admit.ts"),
      "the refusal must name the command of the repository it could be in: " + verdict.reason,
    )
  }
  // ALL THREE CLAUSES SATISFIED, or every assertion above would hold with the
  // directory tracking deleted. One operand, no pipeline, reached at the list
  // start, and nothing but `&&` between the `cd` and the creation.
  const chained = decision(
    codex_payload("cd /repo/plain && true && git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(chained.allow, "an unbroken && chain from the cd narrows to its target: " + chained.reason)
}

@test
pipeline test_a_cd_the_shell_may_skip_never_relaxes_the_rule(harness: Harness, task: unknown) {
  // THE DISARM WAS TWO WORDS. The rule refused a bare creation in a repository
  // that owns an admission command, and `true || cd /repo/plain` in front of
  // the same command made it pass. The right side of `||` never runs, so the
  // creation happened in the admission-owning repository after all, and the
  // guard had answered for a directory the shell never entered.
  //
  // The fix is not a better model of the shell. A `cd` whose execution depends
  // on control flow leaves the directory AMBIGUOUS, every directory the
  // command could be in is asked about, and the first refusal wins.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/guard", command: "scripts/fleet-worktree-admit.ts"},
      {root: "/repo/plain", command: ""},
    ],
    denial: "",
  }
  // Row zero is where a command that names no directory runs, and it owns the
  // command, so the bare form is the refusal these cases must not lose.
  const bare = decision(
    codex_payload("git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!bare.allow, "the bare creation must be refused or this fixture proves nothing")
  for skipped in [
    "true || cd /repo/plain; git worktree add ../unowned origin/main",
    "false && cd /repo/plain; git worktree add ../unowned origin/main",
    "true || cd /repo/plain && git worktree add ../unowned origin/main",
  ] {
    const verdict = decision(codex_payload(skipped), mixed, NO_MAKE_TARGETS)
    assert(!verdict.allow, "a cd the shell may skip must not relax the rule: " + skipped)
    assert(
      verdict.reason.contains("scripts/fleet-worktree-admit.ts"),
      "the refusal must name the command of the repository it could be in: " + verdict.reason,
    )
  }
  // A cd whose FAILURE is swallowed is the same ambiguity from the other side:
  // it runs, it may not succeed, and the command after it runs either way.
  const tolerated = decision(
    codex_payload("cd /repo/plain || true; git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!tolerated.allow, "a cd whose failure is swallowed leaves two directories reachable")
  // A cd inside a pipeline runs in a subshell and never reaches what follows.
  const piped = decision(
    codex_payload("cd /repo/plain | cat; git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!piped.allow, "a cd inside a pipeline cannot move the directory of a later stage")
  // `;` IS NOT A NARROWING, and this case used to assert the opposite.
  //
  // `cd X; cmd` runs `cmd` whether or not the `cd` succeeded, so the original
  // directory is still reachable. Only an unbroken `&&` chain proves the `cd`
  // took effect.
  const sequential = decision(
    codex_payload("cd /repo/plain; git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(
    !sequential.allow,
    "a `;` after a cd leaves the original directory reachable: " + sequential.reason,
  )
  // THE OTHER SIDE OF THE RULE, or this test would pass with the directory
  // tracking deleted. `&&` runs the creation only when the `cd` succeeded, so
  // it narrows and the creation is judged where it lands.
  const conjunctive = decision(
    codex_payload("cd /repo/plain && git worktree add ../unowned origin/main"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(
    conjunctive.allow,
    "an unbroken && chain from the cd still answers for its target: " + conjunctive.reason,
  )
  // A nested shell launched after a skipped cd inherits the ambiguity rather
  // than the skipped directory.
  const nested = decision(
    codex_payload("true || cd /repo/plain; bash -lc 'git worktree add ../unowned origin/main'"),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!nested.allow, "the ambiguity must travel into a nested shell: " + nested.reason)
}

@test
pipeline test_a_nested_scan_asks_about_every_reachable_directory(harness: Harness, task: unknown) {
  // A DIRECTORY THAT ALLOWS MUST NOT END THE SEARCH. The nested-shell scan
  // ran once per reachable directory and returned as soon as one produced a
  // match, carrying only that one directory into the decision. Whichever
  // candidate came first ended the loop, and a candidate that ALLOWS is
  // exactly the one that then hid every other reachable directory that would
  // have refused.
  const mixed: WorktreeAdmissionCensus = {
    rows: [
      {root: "/repo/guard", command: "scripts/fleet-worktree-admit.ts"},
      {root: "/repo/other", command: ""},
    ],
    denial: "",
  }
  // Unnested, this is already refused: `|| true` swallows the failure of the
  // second `cd`, so both directories stay reachable and one owns a command.
  const flat = decision(
    codex_payload(
      "cd /repo/other; cd /repo/guard || true; git worktree add ../unowned origin/main",
    ),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!flat.allow, "the unnested form must be refused or this pair proves nothing")
  // Wrapping the creation in a shell described the same situation and passed.
  const nested = decision(
    codex_payload(
      "bash -lc 'cd /repo/other; cd /repo/guard || true; bash -lc \"git worktree add ../unowned origin/main\"'",
    ),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(!nested.allow, "a nested creation must be judged against every reachable directory")
  assert(
    nested.reason.contains("scripts/fleet-worktree-admit.ts"),
    "the refusal must name the command of the repository that owns one: " + nested.reason,
  )
  // THE CONTROL. Without this the fix would be indistinguishable from
  // refusing every nested creation. Here the `cd` reaches the nested shell
  // through an unbroken `&&` chain, so one directory is reachable, it owns no
  // admission command, and the rule does not police it. `&&` rather than `;`
  // is the whole point: `;` would run the nested shell even if the `cd`
  // failed, which leaves two directories reachable.
  const single = decision(
    codex_payload(
      "bash -lc 'cd /repo/other && bash -lc \"git worktree add ../unowned origin/main\"'",
    ),
    mixed,
    NO_MAKE_TARGETS,
  )
  assert(
    single.allow,
    "one reachable directory that owns no command is still not this rule's: " + single.reason,
  )
}

@test
pipeline test_git_stash_writes_are_denied_across_parser_shapes(harness: Harness, task: unknown) {
  for command in [
    "git stash",
    "git stash push -m wip",
    "git stash save wip",
    "git stash -u",
    "git stash -m wip",
    "git stash -m list",
    "git stash --message show",
    "git stash -q list",
    "git stash pop",
    "git stash apply stash@{1}",
    "git stash drop",
    "git stash clear",
    "git stash branch rescue",
    "/usr/bin/git stash pop",
    "git -C /workspace stash pop",
    "git --no-pager -c core.editor=true stash",
    "env GIT_DIR=/x git stash",
    "sudo git stash",
    "sudo -u x git stash push",
    "sudo -E -- HOME=/root git stash pop",
    "nice -n 10 git stash",
    "timeout 30 git stash drop",
    "timeout --signal KILL 30s git stash clear",
    "time git stash",
    "sudo nice timeout 30 git stash",
    "git add -A && git stash && make test",
    "bash -lc 'git stash pop'",
    "sh -c \"git -C /workspace stash push\"",
    "git -c alias.s=stash s pop",
    "git -c alias.s=stash s",
    "git -c alias.s='stash push' s",
    "git -c alias.a=stash -c alias.b=a b drop",
    "git -c alias.s='!git stash pop' s",
    "git --config-env=alias.s=SAVED s pop",
  ] {
    const refused = verdict(claude_payload(command))
    assert(!refused.allow, command + " writes the shared stash list")
    assert(
      refused.reason.contains("git commit"),
      "the refusal must name the replacement: " + refused.reason,
    )
    assert(
      !decision(codex_payload(command), UNADMITTED, NO_MAKE_TARGETS).allow,
      command + " is refused for Codex in any repository",
    )
  }
}

/**
 * The lane that runs these tests uses the previous published runtime, whose scanner does not project
 * `xargs_child_argv` yet. Without it the guard cannot see the launched command, so the cases are
 * skipped there and run wherever the scanner projects the field.
 */
fn scanner_projects_xargs_child() -> bool {
  const scan = command_risk_scan({request: {mode: "shell", command: "xargs git status"}})
  const stage = (scan.shell_command_groups ?? [])[0]?.[0]
  return len(stage?.xargs_child_argv ?? []) > 0
}

@test
pipeline test_git_stash_writes_launched_through_xargs_are_denied(harness: Harness, task: unknown) {
  if !scanner_projects_xargs_child() {
    return
  }
  for command in [
    "xargs -n 1 git stash drop",
    "printf x | xargs git stash",
    "xargs -0 -I {} git -C /workspace stash pop",
  ] {
    assert(!verdict(claude_payload(command)).allow, command + " writes the shared stash list")
  }
}

/**
 * An `xargs` form the scanner cannot place a child for fails closed, on every runtime: the guard
 * reads each `git` operand as a launch. `-a` is outside the scanner's option boundary.
 */
@test
pipeline test_unresolved_xargs_forms_still_refuse_stash_writes(harness: Harness, task: unknown) {
  for command in [
    "xargs -a input git stash drop",
    "xargs -a input -n 1 git stash pop",
    "xargs --arg-file=input git stash",
    "xargs -a input git -C /workspace stash clear",
    "xargs -a input sh -c 'git stash drop'",
    "xargs -a input bash -lc \"git -C /workspace stash pop\"",
    "xargs -a input env GIT_DIR=/x git stash",
    "xargs -a input -I{} sh -c 'git stash drop {}'",
    "xargs -a f python3 -c 'import os; os.system(\"git stash drop\")'",
    "xargs -a f perl -e 'system \"git stash clear\"'",
    "xargs -a f node -e 'require(\"child_process\").execSync(\"git stash pop\")'",
    "xargs -a f sh -c 'eval \"git stash\"'",
    "xargs -a f git --config-env=alias.s=SAVED s pop",
    "xargs -a f grep stash",
  ] {
    assert(!verdict(claude_payload(command)).allow, command + " writes the shared stash list")
  }
  for command in [
    "xargs -a input git status",
    "xargs -a input git stash list",
    "xargs -a input rm",
    "xargs -a input sh -c 'git status'",
  ] {
    const allowed = verdict(claude_payload(command))
    assert(allowed.allow, command + " does not write the stash list: " + allowed.reason)
  }
}

/**
 * An alias defined in repository or user git configuration is invisible in the command text. The
 * guard reads it with the command's own global options, so `git -C B s` is judged by repo B's
 * configuration, not the repository the hook runs in.
 */
@test
pipeline test_git_config_aliases_that_expand_to_stash_writes_are_denied(
  harness: Harness,
  task: unknown,
) {
  const listing = git_config_aliases(
    "alias.s stash pop\nalias.l stash list\nalias.sh !git stash drop\nalias.st status\nalias.broken\n",
  )
  assert_eq(listing["s"], "stash pop")
  assert_eq(listing["sh"], "!git stash drop")
  // Repo A (the hook's directory) defines nothing; repo B, reached through -C, defines the listing.
  const lookup = { context ->
    if context.options.contains("/repo/b") {
      listing
    } else {
      {}
    }
  }
  const refused = [
    "git -C /repo/b s",
    "git -C /repo/b sh",
    "sudo git -C /repo/b s",
    "sh -c 'git -C /repo/b s'",
    "xargs -a input git -C /repo/b s",
  ]
  for command in refused {
    assert(
      !decision(claude_payload(command), ADMITTED, NO_MAKE_TARGETS, lookup).allow,
      command + " expands to a stash write through repo B's configured aliases",
    )
  }
  // Falsifiers: the same alias name from repo A (no alias there) is allowed, as is a lookup that
  // reads nothing, so the denial above comes from the option-scoped configuration.
  assert(decision(claude_payload("git s"), ADMITTED, NO_MAKE_TARGETS, lookup).allow)
  assert(verdict(claude_payload("git -C /repo/b s")).allow)
  for command in ["git -C /repo/b l", "git -C /repo/b st", "git -C /repo/b broken"] {
    assert(
      decision(claude_payload(command), ADMITTED, NO_MAKE_TARGETS, lookup).allow,
      command + " does not write the stash list",
    )
  }
  // A configuration git could not read is refused rather than read as having no aliases.
  const unreadable = { options -> {"<unreadable>": ""} }
  assert(
    !decision(claude_payload("git -C /missing s"), ADMITTED, NO_MAKE_TARGETS, unreadable).allow,
  )
  // A built-in is never an alias, so it triggers no lookup: a lookup that reports unreadable would
  // refuse it if it were consulted.
  for command in ["git -C /missing status", "git -C /missing log -1", "git diff"] {
    assert(
      decision(
        claude_payload(command),
        ADMITTED,
        NO_MAKE_TARGETS,
        unreadable,
        { program -> ["status", "log", "diff"] },
      ).allow,
      command + " must not consult the alias lookup",
    )
  }
  // Config text that itself contains "alias." keeps its expansion intact.
  const nested = git_config_aliases("alias.foo !git -c alias.s=stash s pop\n")
  assert_eq(nested["foo"], "!git -c alias.s=stash s pop")
  assert(
    !decision(claude_payload("git foo"), ADMITTED, NO_MAKE_TARGETS, { options -> nested }).allow,
    "an alias that defines an inner alias still reaches the stash write",
  )
  // A command-local config source is invisible to the lookup, so a non-built-in subcommand under it
  // is refused even when the lookup reads nothing; a built-in under it is not.
  for command in [
    "GIT_CONFIG_GLOBAL=/tmp/aliases git s",
    "env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=alias.s GIT_CONFIG_VALUE_0='stash pop' git s",
    "export GIT_CONFIG_GLOBAL=/tmp/aliases; git s",
    "HOME=/tmp/h sh -c 'git s'",
    "env -u HOME git s",
    "env -i git s",
    "unset HOME; git s",
    "env --unset=HOME git s",
    "FOO=1 git s",
    "cd /repo/b && git s",
    "(cd /repo/b; git s)",
    "eval 'git s'",
    "git -C /repo/a s; export X=1",
  ] {
    assert(
      !decision(claude_payload(command), ADMITTED, NO_MAKE_TARGETS, lookup).allow,
      command + " runs under a configuration the lookup cannot read",
    )
  }
  assert(
    decision(
      claude_payload("GIT_CONFIG_GLOBAL=/tmp/aliases git status"),
      ADMITTED,
      NO_MAKE_TARGETS,
      lookup,
      { program -> ["status"] },
    ).allow,
  )
  assert(
    decision(claude_payload("git s"), ADMITTED, NO_MAKE_TARGETS, lookup).allow,
    "the falsifier: no source override, no alias in A",
  )
  // A plain custom subcommand with no environment change still runs, after the lookup finds no alias.
  for command in [
    "git frobnicate --flag",
    "git -C /repo/a frobnicate",
    "git frobnicate | cat",
    "git commit -m a=b",
  ] {
    assert(
      decision(claude_payload(command), ADMITTED, NO_MAKE_TARGETS, lookup).allow,
      command + " changes no environment and is no alias",
    )
  }
  // `eval` runs its operands as a command line, so a stash write behind it is refused too.
  assert(!verdict(claude_payload("eval 'git stash pop'")).allow)
  assert(!verdict(claude_payload("eval git stash drop")).allow)
  assert_eq(GIT_ALIASES_UNREADABLE, "<unreadable>")
}

/**
 * A substitution body is a command line the shell runs, so a stash write inside `$(...)`, backticks
 * or process substitution is refused like the bare command. Single-quoted text is literal, and a
 * body that never closes is refused rather than guessed at.
 */
@test
pipeline test_git_stash_writes_inside_command_substitution_are_denied(
  harness: Harness,
  task: unknown,
) {
  for command in [
    "echo $(git stash pop)",
    "echo $(echo $(git stash drop))",
    "x=`git stash drop`",
    "echo \"$(git stash pop)\"",
    "echo \"$( # )\ngit stash drop\n)\"",
    "cat <( # )\ngit stash pop\n)",
    "cat <(git stash pop)",
    "tee >(git stash drop) < /dev/null",
    "echo $((1 + $(git stash pop; echo 1)))",
    "echo $(git -C /workspace stash clear)",
    "echo $(git stash pop",
    "echo `git stash pop",
    "echo $(echo $(echo $(echo $(echo $(git stash pop)))))",
    "cat <<EOF\n'$(git stash pop)'\nEOF",
    "cat <<-EOF\n'`git stash drop`'\nEOF",
    "cat <<EOF\n$(git stash pop)\nEOF",
    "cat <<'EOF'\n'\nEOF\necho \"$(git stash pop)\"",
    "cat <<\"EOF\"\n'\nEOF\necho `git stash drop`",
    "cat <<'A' <<'B'\n'\nA\n\"\nB\necho \"$(git stash pop)\"",
    "cat <<'EOF'\ntext\nEOF\nprintf x | xargs git stash drop",
    "cat <<'EOF'\n'\nEOF\ndash -c 'git stash pop'",
  ] {
    assert(!verdict(claude_payload(command)).allow, command + " writes the shared stash list")
  }
  for command in [
    "echo $(git rev-parse HEAD)",
    "echo $(git stash list)",
    "echo \"$( # )\ngit stash list\n)\"",
    "echo \"$(printf '%s' '# )')\"",
    "echo `git stash show`",
    "diff <(git show a) <(git show b)",
    "echo '$(git stash pop)'",
    "cat <<'EOF'\n'$(git stash pop)'\nEOF",
    "cat <<'EOF'\n'\n$(git stash pop)\nEOF\necho done",
    "cat <<'EOF'\n'\nEOF\necho \"$(git stash list)\"",
    "cat <<'EOF'\ngit stash pop\nEOF",
    "cat <<'EOF'\n'\nEOF\ndash -c 'git stash list'",
    "cat <<EOF\n$(git rev-parse HEAD)\nEOF",
    "cat <<< '$(git stash pop)'",
    "echo \\$(git stash pop)",
    "echo $((1 + 2))",
    "git commit -m \"fix (parens) in $(git rev-parse --short HEAD)\"",
  ] {
    assert(verdict(claude_payload(command)).allow, command + " does not write the stash list")
  }
}

@test
pipeline test_git_stash_reads_and_lookalikes_are_allowed(harness: Harness, task: unknown) {
  // THE CONTROL. Refusing every command that mentions `stash` would pass the
  // denial cases above, so the read-only verbs and unrelated words must pass.
  for command in [
    "git stash list",
    "git stash show -p stash@{0}",
    "git -C /workspace stash list",
    "sudo -u x git stash list",
    "timeout 30 git stash show",
    "nice -n 5 git log --oneline",
    "git log --oneline",
    "git commit -am 'stash the cache'",
    "echo git stash",
    "grep stash docs/notes.md",
    "git -c alias.s=stash s list",
    "git -c alias.l=log l --oneline",
    "git -c alias.s=stash status",
    "xargs git stash list",
    "xargs -n 1 git log",
    "git reset --soft HEAD~1",
  ] {
    const allowed = verdict(claude_payload(command))
    assert(allowed.allow, command + " does not write the stash list: " + allowed.reason)
  }
}
