import "../verify_crate_packages_plan.harn"

const META = {
  target_directory: "/repo/target",
  workspace_members: ["id-cli", "id-vm", "id-private"],
  packages: [
    {id: "id-vm", name: "harn-vm", version: "1.2.3", manifest_path: "/repo/crates/harn-vm/Cargo.toml"},
    {
      id: "id-private",
      name: "private-helper",
      version: "0.0.0",
      manifest_path: "/repo/crates/private-helper/Cargo.toml",
      publish: [],
    },
    {
      id: "id-cli",
      name: "harn-cli",
      version: "1.2.3",
      manifest_path: "/repo/crates/harn-cli/Cargo.toml",
    },
    {id: "id-nonmember", name: "external", version: "9.9.9", manifest_path: "/repo/external/Cargo.toml"},
  ],
}

fn assert_throws_contains(body, fragment: string) -> nil {
  let error_text = ""
  try {
    body()
  } catch (e) {
    error_text = to_string(e)
  }
  require error_text != "", "expected closure to throw"
  require error_text.contains(fragment), "expected error to contain " + fragment + ", got: " + error_text
  return nil
}

@test
pipeline test_publishable_workspace_packages_filter_and_sort(task) {
  assert_eq(
    publishable_workspace_packages_from_metadata(META, "/repo"),
    [
      {
        dir: "crates/harn-cli",
        manifest_path: "/repo/crates/harn-cli/Cargo.toml",
        name: "harn-cli",
        version: "1.2.3",
      },
      {
        dir: "crates/harn-vm",
        manifest_path: "/repo/crates/harn-vm/Cargo.toml",
        name: "harn-vm",
        version: "1.2.3",
      },
    ],
  )
}

@test
pipeline test_plan_rows_are_shell_readable(task) {
  assert_eq(
    verify_crate_packages_plan_rows(META, "/repo"),
    [
      "target_directory\t/repo/target",
      "package\tharn-cli\t1.2.3\t/repo/crates/harn-cli/Cargo.toml\tcrates/harn-cli",
      "package\tharn-vm\t1.2.3\t/repo/crates/harn-vm/Cargo.toml\tcrates/harn-vm",
    ],
  )
}

@test
pipeline test_plan_fails_closed_for_duplicate_package_names(task) {
  const meta = META
    + {
    workspace_members: ["id-cli", "id-duplicate"],
    packages: [
      {
        id: "id-cli",
        name: "harn-cli",
        version: "1.2.3",
        manifest_path: "/repo/crates/harn-cli/Cargo.toml",
      },
      {
        id: "id-duplicate",
        name: "harn-cli",
        version: "1.2.4",
        manifest_path: "/repo/crates/harn-cli-copy/Cargo.toml",
      },
    ],
  }
  assert_throws_contains(
    { -> publishable_workspace_packages_from_metadata(meta, "/repo") },
    "duplicate workspace package name",
  )
}

@test
pipeline test_plan_fails_closed_for_missing_target_directory(task) {
  assert_throws_contains({ -> target_directory_from_metadata({}) }, "target_directory")
}
