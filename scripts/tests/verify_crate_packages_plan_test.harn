import "../verify_crate_packages_plan.harn"

const META = {
  target_directory: "/repo/target",
  workspace_members: ["id-cli", "id-vm", "id-private"],
  packages: [
    {
      id: "id-vm",
      name: "harn-vm",
      version: "1.2.3",
      manifest_path: "/repo/crates/harn-vm/Cargo.toml",
      metadata: {
        harn: {package_verify: {dependency_contracts: [{name: "rmcp", minimum: "3.1.4"}]}},
      },
      dependencies: [
        {name: "rmcp", req: "=3.1.4", kind: nil},
        {name: "rmcp", req: "=3.1.4", kind: "dev"},
      ],
    },
    {
      id: "id-private",
      name: "private-helper",
      version: "0.0.0",
      manifest_path: "/repo/crates/private-helper/Cargo.toml",
      publish: [],
    },
    {
      id: "id-cli",
      name: "harn-cli",
      version: "1.2.3",
      manifest_path: "/repo/crates/harn-cli/Cargo.toml",
    },
    {
      id: "id-nonmember",
      name: "external",
      version: "9.9.9",
      manifest_path: "/repo/external/Cargo.toml",
    },
  ],
}

fn assert_throws_contains(body: unknown, fragment: string) -> nil {
  let error_text = ""
  try {
    body()
  } catch (e) {
    error_text = to_string(e)
  }
  require error_text != "", "expected closure to throw"
  require error_text.contains(fragment),
    "expected error to contain " + fragment + ", got: "
    + error_text
  return nil
}

@test
pipeline test_publishable_workspace_packages_filter_and_sort(harness: Harness, task: unknown) {
  assert_eq(
    publishable_workspace_packages_from_metadata(META, "/repo"),
    [
      {
        dir: "crates/harn-cli",
        manifest_path: "/repo/crates/harn-cli/Cargo.toml",
        name: "harn-cli",
        version: "1.2.3",
      },
      {
        dir: "crates/harn-vm",
        manifest_path: "/repo/crates/harn-vm/Cargo.toml",
        name: "harn-vm",
        version: "1.2.3",
      },
    ],
  )
}

@test
pipeline test_plan_rows_are_shell_readable(harness: Harness, task: unknown) {
  assert_eq(
    verify_crate_packages_plan_rows(META, "/repo"),
    [
      "target_directory\t/repo/target",
      "package\tharn-cli\t1.2.3\t/repo/crates/harn-cli/Cargo.toml\tcrates/harn-cli",
      "package\tharn-vm\t1.2.3\t/repo/crates/harn-vm/Cargo.toml\tcrates/harn-vm",
      "dependency_contract\tharn-vm\t1.2.3\trmcp\t=3.1.4\t3.1.4\trmcp",
    ],
  )
}

@test
pipeline test_dependency_contracts_name_the_normal_dependency_and_minimum(
  harness: Harness,
  task: unknown,
) {
  assert_eq(
    package_dependency_contracts_from_metadata(META),
    [
      {
        dependency: "rmcp",
        minimum: "3.1.4",
        package: "harn-vm",
        package_version: "1.2.3",
        requirement: "=3.1.4",
        resolution_name: "rmcp",
      },
    ],
  )
}

@test
pipeline test_dependency_contract_fails_closed_when_the_normal_dependency_is_absent(
  harness: Harness,
  task: unknown,
) {
  const meta = META
    + {
      packages: META.packages.map(
        { package ->
          if package.name == "harn-vm" {
            return package + {dependencies: [{name: "rmcp", req: "=3.1.4", kind: "dev"}]}
          }
          return package
        },
      ),
    }
  assert_throws_contains(
    { -> package_dependency_contracts_from_metadata(meta) },
    "normal dependency",
  )
}

/**
 * A contract may omit its minimum, and the row must still carry a non-empty
 * field there.
 *
 * That is not cosmetic. The row is read back with `IFS=$'\t' read -r ...`,
 * and tab is IFS whitespace, so the shell collapses a run of tabs into one
 * separator. An empty minimum would not arrive empty: it would vanish and
 * shift `resolution_name` into its place, leaving the resolution name empty.
 * The reader still succeeds, so the damage lands later as a dependency edge
 * that matches nothing. Asserting on the rendered row is what catches it;
 * asserting on the contract struct alone would not.
 */
@test
pipeline test_dependency_contract_without_minimum_renders_an_absent_token(
  harness: Harness,
  task: unknown,
) {
  const meta = META
    + {
      packages: META.packages.map(
        { package ->
          if package.name == "harn-vm" {
            return package
              + {
                metadata: {
                  harn: {package_verify: {dependency_contracts: [{name: "rmcp"}]}},
                },
              }
          }
          return package
        },
      ),
    }
  const contracts = package_dependency_contracts_from_metadata(meta)
  assert_eq(len(contracts), 1)
  assert_eq(contracts[0].minimum, "none")

  const rows = verify_crate_packages_plan_rows(meta, "/repo")
  const contract_rows = rows.filter({ row -> row.starts_with("dependency_contract\t") })
  assert_eq(len(contract_rows), 1)
  const fields = contract_rows[0].split("\t")
  // kind, package, package_version, dependency, requirement, minimum,
  // resolution_name. Seven fields, none of them empty.
  assert_eq(len(fields), 7)
  assert_eq(fields[5], "none")
  assert_eq(fields[6], "rmcp")
}

@test
pipeline test_plan_fails_closed_for_duplicate_package_names(harness: Harness, task: unknown) {
  const meta = META
    + {
      workspace_members: ["id-cli", "id-duplicate"],
      packages: [
        {
          id: "id-cli",
          name: "harn-cli",
          version: "1.2.3",
          manifest_path: "/repo/crates/harn-cli/Cargo.toml",
        },
        {
          id: "id-duplicate",
          name: "harn-cli",
          version: "1.2.4",
          manifest_path: "/repo/crates/harn-cli-copy/Cargo.toml",
        },
      ],
    }
  assert_throws_contains(
    { -> publishable_workspace_packages_from_metadata(meta, "/repo") },
    "duplicate workspace package name",
  )
}

@test
pipeline test_plan_fails_closed_for_missing_target_directory(harness: Harness, task: unknown) {
  assert_throws_contains({ -> target_directory_from_metadata({}) }, "target_directory")
}
