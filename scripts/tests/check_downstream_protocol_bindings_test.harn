import { with_temp_dir } from "std/testing"
import "../check_downstream_protocol_bindings.harn"

fn mkdirs(fs: HarnessFs, path: string) -> nil {
  const parts = split(path_normalize(path), "/")
  let current = if path.starts_with("/") {
    "/"
  } else {
    ""
  }
  for part in parts {
    if part == "" {
      continue
    }
    current = if current == "" || current == "/" {
      current + part
    } else {
      path_join(current, part)
    }
    if !fs.exists(current) {
      fs.mkdir(current)
    }
  }
  return nil
}

fn write_text(fs: HarnessFs, root: string, rel: string, text: string) -> nil {
  const path = path_join(root, rel)
  mkdirs(fs, dirname(path) ?? root)
  fs.write_text(path, text)
  return nil
}

fn write_sources(fs: HarnessFs, root: string, swift: string, rust: string, ts: string) -> nil {
  write_text(fs, root, "spec/protocol-artifacts/HarnProtocol.swift", swift)
  write_text(fs, root, "spec/protocol-artifacts/harn-protocol.rs", rust)
  write_text(fs, root, "spec/protocol-artifacts/harn-protocol.ts", ts)
  return nil
}

fn write_downstream(fs: HarnessFs, root: string, swift: string, rust: string, ts: string) -> nil {
  write_text(fs, root, "Sources/BurinCore/ACP/HarnProtocol.generated.swift", swift)
  write_text(fs, root, "crates/burin-tui/protocol/src/harn_protocol_generated.rs", rust)
  write_text(fs, root, "server/src/generated/harn-protocol.ts", ts)
  write_text(fs, root, "burin-portal/src/generated/harn-protocol.ts", ts)
  return nil
}

@test
pipeline test_normalize_protocol_text_line_endings(harness: Harness, task: unknown) {
  assert_eq(normalize_protocol_text("a\r\nb\rc\n"), "a\nb\nc\n")
}

@test
@heavy(threads: 2)
pipeline test_matching_bindings_pass_after_consumer_normalization(harness: Harness, task: unknown) {
  with_temp_dir(
    harness.fs,
    { root ->
      const harn_root = path_join(root, "harn")
      const downstream_root = path_join(root, "downstream-host")
      const rust_source = "pub enum Receipt { Confirmed, Rejected }\n"
      const rust_destination = "pub enum Receipt {\r\n    Confirmed,\r\n    Rejected,\r\n}\r\n"
      write_sources(harness.fs, harn_root, "swift\n", rust_source, "type Foo = string\n")
      write_downstream(
        harness.fs,
        downstream_root,
        "swift\r\n",
        rust_destination,
        "type Foo = string\r\n",
      )
      const report = check_downstream_protocol_bindings(
        harness.env,
        harness.process,
        harness.fs,
        downstream_root,
        true,
        harn_root,
      )
      assert_eq(report.stale, [])
      assert_eq(report.ok, true)
      assert_eq(report.status, "ok")
      assert_eq(report.stale_count, 0)
      assert_eq(report.skipped, false)
    },
  )
}

@test
pipeline test_stale_and_missing_bindings_are_reported_in_target_order(
  harness: Harness,
  task: unknown,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      const harn_root = path_join(root, "harn")
      const downstream_root = path_join(root, "downstream-host")
      write_sources(harness.fs, harn_root, "swift source\n", "rust source\n", "ts source\n")
      write_text(
        harness.fs,
        downstream_root,
        "Sources/BurinCore/ACP/HarnProtocol.generated.swift",
        "swift stale\n",
      )
      mkdirs(harness.fs, path_join(downstream_root, "server/src/generated"))
      const report = check_downstream_protocol_bindings(
        harness.env,
        harness.process,
        harness.fs,
        downstream_root,
        true,
        harn_root,
      )
      assert_eq(report.ok, false)
      assert_eq(report.status, "stale")
      assert_eq(report.stale_count, 4)
      assert_eq(report.stale[0], "Sources/BurinCore/ACP/HarnProtocol.generated.swift")
      assert_eq(
        report.stale[1],
        "crates/burin-tui/protocol/src/harn_protocol_generated.rs (missing)",
      )
      assert_eq(report.stale[2], "server/src/generated/harn-protocol.ts (missing)")
      assert_eq(report.stale[3], "burin-portal/src/generated/harn-protocol.ts (missing)")
    },
  )
}

@test
pipeline test_missing_root_respects_required_flag(harness: Harness, task: unknown) {
  with_temp_dir(
    harness.fs,
    { root ->
      const missing = path_join(root, "missing-burin")
      const optional = check_downstream_protocol_bindings(
        harness.env,
        harness.process,
        harness.fs,
        missing,
        false,
        root,
      )
      assert_eq(optional.ok, true)
      assert_eq(optional.skipped, true)
      assert_eq(optional.status, "missing_root")
      const required = check_downstream_protocol_bindings(
        harness.env,
        harness.process,
        harness.fs,
        missing,
        true,
        root,
      )
      assert_eq(required.ok, false)
      assert_eq(required.skipped, false)
      assert_eq(required.status, "missing_root")
    },
  )
}
