import { read_yaml } from "std/fs"

fn expression(value: string) -> string {
  return "$" + "{{ " + value + " }}"
}

pipeline test_candidate_security_owns_exact_source_admission_before_builds(harness: Harness) {
  const flow = read_yaml(harness.fs, "../../.github/workflows/build-release-binaries.yml", nil)
  const supply = read_yaml(harness.fs, "../../.github/workflows/supply-chain.yml", nil)
  const security = flow.jobs["source-security"]
  assert(security.uses.contains("/.github/workflows/dependency-security-proof.yml@"))
  assert_eq(security.uses, supply.jobs["cargo-deny"].uses)
  assert_eq(security.needs, "setup")
  assert_eq(security["if"], "needs.setup.outputs.build_mode == 'candidate'")
  assert_eq(
    security.with["source-revision"],
    expression("needs.setup.outputs.candidate_source_sha"),
  )
  assert_eq(security.with.policy, false)
  assert_eq(security["continue-on-error"], nil)
  const admission = flow.jobs["source-ci"]
  assert_eq(admission.needs, ["setup", "source-security"])
  assert(
    admission["if"].contains("!cancelled()"),
    "a skipped security job must not skip warm builds",
  )
  assert(admission["if"].contains("needs.setup.outputs.build_mode != 'candidate'"))
  assert(admission["if"].contains("needs.source-security.result == 'success'"))
  assert(flow.jobs["candidate-verdict"].needs.contains("source-security"))
}

pipeline test_publication_refreshes_security_after_all_other_authority(harness: Harness) {
  const flow = read_yaml(harness.fs, "../../.github/workflows/promote-release.yml", nil)
  const supply = read_yaml(harness.fs, "../../.github/workflows/supply-chain.yml", nil)
  const security = flow.jobs["publication-security"]
  assert(security.uses.contains("/.github/workflows/dependency-security-proof.yml@"))
  assert_eq(security.uses, supply.jobs["cargo-deny"].uses)
  assert_eq(security.needs, ["plan", "authorize"])
  assert_eq(security.with["source-revision"], expression("needs.plan.outputs.source_sha"))
  assert_eq(security.with.policy, false)
  assert_eq(security["continue-on-error"], nil)
  assert(security["if"].contains("needs.authorize.result == 'success'"))
  assert(security["if"].contains("needs.authorize.outputs.ready == 'true'"))
  assert(flow.jobs.promote.needs.contains("publication-security"))
  assert(flow.jobs.promote["if"].contains("needs.publication-security.result == 'success'"))
}

pipeline test_existing_tag_recovery_uses_the_same_source_bound_security_owner(harness: Harness) {
  const flow = read_yaml(harness.fs, "../../.github/workflows/publish-release.yml", nil)
  const supply = read_yaml(harness.fs, "../../.github/workflows/supply-chain.yml", nil)
  const policy = json_parse(harness.fs.read_text("../lib/dependency-security-policy.json"))
  const security = flow.jobs["publication-security"]
  assert_eq(security.uses, supply.jobs["cargo-deny"].uses)
  assert_eq(security.uses, policy.signerWorkflow + "@" + policy.signerRevision)
  assert_eq(security.with["source-revision"], expression("needs.detect-drift.outputs.source_sha"))
  assert_eq(security.with.policy, false)
  assert(flow.jobs.publish.needs.contains("publication-security"))
  assert(flow.jobs.publish["if"].contains("needs.publication-security.result == 'success'"))
  assert_eq(
    flow.jobs["detect-drift"].outputs.source_sha,
    expression("steps.publication-source.outputs.source_sha"),
  )
  for config in [flow, supply] {
    const job = config.jobs[config == flow ? "publication-security" : "cargo-deny"]
    assert_eq(job.permissions["id-token"], "write")
    assert_eq(job.permissions.attestations, "write")
  }
}

pipeline test_recovery_requires_exact_source_ci_and_native_before_the_consumer(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/promote-release.yml", nil)
  assert_eq(workflow.jobs["consumer-rehearsal"].needs, "plan")
  for job_name in ["plan", "authorize"] {
    const job = workflow.jobs[job_name]
    const gates = job.steps.filter({ step -> step?.run == "bash scripts/ci/require_full_suite.sh" })
      .to_list()
    assert_eq(len(gates), 1)
    const gate = gates[0]
    assert_eq(
      gate.env.SOURCE_SHA,
      expression(
        job_name == "plan" ? "needs.resolve.outputs.source_sha" : "needs.plan.outputs.source_sha",
      ),
    )
    assert_eq(gate.env.GH_REPO, expression("github.repository"))
    assert_eq(gate.env.WAIT_FOR_FULL_SUITE, "true")
    assert_eq(gate["continue-on-error"], nil)
    assert_eq(gate["timeout-minutes"], 90)
  }
}

pipeline test_publication_receives_only_the_authenticated_recovery_outputs(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/promote-release.yml", nil)
  const job = workflow.jobs.authorize
  const readers = job.steps.filter({ step -> step?.id == "consumer-repair" }).to_list()
  assert_eq(len(readers), 1)
  const reader = readers[0]
  assert(reader.run.contains("node scripts/ci/consumer-observer-read-decision.mjs --repair"))
  assert_eq(
    reader.env.ISSUED_CONTEXT,
    expression("needs.consumer-rehearsal.outputs.observer_context"),
  )
  assert_eq(reader.env.PRODUCER_RUN, expression("needs.plan.outputs.run_id"))
  assert_eq(reader.env.PRODUCER_ATTEMPT, expression("needs.plan.outputs.producer_attempt"))
  assert_eq(reader.env.CONSUMER_PULL, expression("inputs.consumer_pull_request"))
  assert_eq(reader.env.REQUIRE_CURRENT_DEFAULT, "false")
  assert_eq(job.outputs.consumer_repair, expression("steps.consumer-repair.outputs.repair_request"))
  const call = workflow.jobs.promote
  assert_eq(call.with["consumer-repair"], expression("needs.authorize.outputs.consumer_repair"))
  assert_eq(
    call.with["original-consumer-context"],
    expression("needs.authorize.outputs.original_context"),
  )
  assert_eq(call.with["authorization-run-id"], nil)
  assert_eq(call.with["authorization-attempt"], nil)
  assert_eq(
    call.secrets.CONSUMER_CANARY_REPOSITORY,
    expression("secrets.CONSUMER_CANARY_REPOSITORY"),
  )
  const authority = job.steps.filter({ step -> step?.id == "completed-consumer-token" }).to_list()
  assert_eq(len(authority), 1)
  assert_eq(authority[0].with["permission-actions"], "read")
  assert_eq(authority[0].with["permission-contents"], "read")
  assert_eq(authority[0].with["permission-pull-requests"], "read")
}
