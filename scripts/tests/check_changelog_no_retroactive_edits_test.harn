// Tests for scripts/check_changelog_no_retroactive_edits.harn — exercise the
// pure helpers on synthetic inputs (no filesystem / git dependency).
import "../check_changelog_no_retroactive_edits.harn"

// --- heading_version / is_all_digits -------------------------------------
@test
pipeline test_heading_version_basic(task) {
  assert_eq(heading_version("## v0.8.72"), "0.8.72")
}

@test
pipeline test_heading_version_multidigit(task) {
  assert_eq(heading_version("## v12.345.6"), "12.345.6")
}

@test
pipeline test_heading_version_not_a_heading(task) {
  assert_eq(heading_version("### Added"), nil)
  assert_eq(heading_version("## Unreleased"), nil)
  assert_eq(heading_version("regular line"), nil)
}

@test
pipeline test_heading_version_rejects_suffix(task) {
  // Anchored to the whole line: trailing content disqualifies it.
  assert_eq(heading_version("## v1.2.3 (beta)"), nil)
  assert_eq(heading_version("## v1.2"), nil)
  assert_eq(heading_version("## v1.2.3.4"), nil)
}

@test
pipeline test_heading_version_rejects_non_digits(task) {
  assert_eq(heading_version("## v1.2.x"), nil)
  assert_eq(heading_version("## va.b.c"), nil)
}

@test
pipeline test_is_all_digits(task) {
  assert_eq(is_all_digits("0123456789"), true)
  assert_eq(is_all_digits("007"), true)
  assert_eq(is_all_digits(""), false)
  assert_eq(is_all_digits("1a"), false)
  assert_eq(is_all_digits(" 1"), false)
}

// --- version_headings ----------------------------------------------------
@test
pipeline test_version_headings_in_order(task) {
  let text = "# CL\n\n## v2.0.0\n\nbody\n\n## v1.5.0\n\nbody2\n\n## Unreleased\n\nx\n"
  assert_eq(version_headings(text), ["2.0.0", "1.5.0"])
}

@test
pipeline test_version_headings_empty(task) {
  assert_eq(version_headings("no headings here\n### Added\n"), [])
}

// --- is_section_boundary -------------------------------------------------
@test
pipeline test_is_section_boundary(task) {
  assert_eq(is_section_boundary("## v1.0.0"), true)
  assert_eq(is_section_boundary("## Unreleased"), true)
  // Subheadings are NOT boundaries (third char is '#', not space).
  assert_eq(is_section_boundary("### Added"), false)
  assert_eq(is_section_boundary("- bullet"), false)
  assert_eq(is_section_boundary("#single"), false)
}

// --- section_body --------------------------------------------------------
@test
pipeline test_section_body_basic(task) {
  // Body is everything after the heading's newline up to the next "## " line,
  // each retained line keeping its trailing newline.
  let text = "## v1.0.0\n\nfirst\nsecond\n\n## v0.9.0\n\nother\n"
  assert_eq(section_body(text, "1.0.0"), "\nfirst\nsecond\n\n")
}

@test
pipeline test_section_body_includes_subheadings(task) {
  let text = "## v1.0.0\n\n### Added\n\n- x\n\n## v0.9.0\n\ny\n"
  assert_eq(section_body(text, "1.0.0"), "\n### Added\n\n- x\n\n")
}

@test
pipeline test_section_body_last_section_no_trailing_newline(task) {
  // Final section, end-of-text boundary, source has no trailing newline:
  // the last body line carries no extra newline.
  let text = "## v1.0.0\n\ntail line"
  assert_eq(section_body(text, "1.0.0"), "\ntail line")
}

@test
pipeline test_section_body_last_section_with_trailing_newline(task) {
  // Final section, end-of-text, source ends with a newline: the trailing
  // empty split element contributes nothing, matching the regex capture.
  let text = "## v1.0.0\n\ntail line\n"
  assert_eq(section_body(text, "1.0.0"), "\ntail line\n")
}

@test
pipeline test_section_body_missing(task) {
  assert_eq(section_body("## v1.0.0\n\nx\n", "9.9.9"), nil)
}

@test
pipeline test_section_body_heading_is_final_line(task) {
  // A heading with no following newline can't match Python's "^## v..\n".
  assert_eq(section_body("intro\n## v1.0.0", "1.0.0"), nil)
}

@test
pipeline test_section_body_empty_body(task) {
  // Heading immediately followed by the next heading: empty body.
  let text = "## v1.0.0\n## v0.9.0\n\nx\n"
  assert_eq(section_body(text, "1.0.0"), "")
}

// --- section_bodies (single-pass map; must equal section_body) -----------
@test
pipeline test_section_bodies_matches_section_body(task) {
  let text = "# CL\n\n## v2.0.0\n\nbody A\n\n### Fixed\n\n- f\n\n## v1.0.0\n\nbody B\n"
  let bodies = section_bodies(text)
  assert_eq(bodies["2.0.0"], section_body(text, "2.0.0"))
  assert_eq(bodies["1.0.0"], section_body(text, "1.0.0"))
}

@test
pipeline test_section_bodies_first_occurrence_wins(task) {
  // re.search returns the first match; the map keeps the first occurrence.
  let text = "## v1.0.0\n\nfirst\n\n## v1.0.0\n\nsecond\n"
  assert_eq(section_bodies(text)["1.0.0"], "\nfirst\n\n")
}

// --- compute_drift -------------------------------------------------------
@test
pipeline test_compute_drift_flags_changed_published(task) {
  let head = "## v2.0.0\n\nNEW body\n\n## v1.0.0\n\nuntagged\n"
  let base = "## v2.0.0\n\nOLD body\n\n## v1.0.0\n\nuntagged\n"
  // v2.0.0 tagged + changed -> drift; v1.0.0 untagged -> ignored.
  assert_eq(compute_drift(head, base, ["v2.0.0"]), ["2.0.0"])
}

@test
pipeline test_compute_drift_ignores_untagged_change(task) {
  let head = "## v2.0.0\n\nbody\n\n## v1.0.0\n\nCHANGED\n"
  let base = "## v2.0.0\n\nbody\n\n## v1.0.0\n\noriginal\n"
  // Only v1.0.0 changed, but it has no tag -> not flagged.
  assert_eq(compute_drift(head, base, ["v2.0.0"]), [])
}

@test
pipeline test_compute_drift_ignores_unchanged(task) {
  let text = "## v2.0.0\n\nsame\n\n## v1.0.0\n\nsame too\n"
  assert_eq(compute_drift(text, text, ["v2.0.0", "v1.0.0"]), [])
}

@test
pipeline test_compute_drift_section_only_in_head(task) {
  // A published version present in HEAD but absent in base is skipped
  // (base_body == nil), matching Python's `continue`.
  let head = "## v2.0.0\n\nbody\n"
  let base = "# CL\n\nno sections\n"
  assert_eq(compute_drift(head, base, ["v2.0.0"]), [])
}

@test
pipeline test_compute_drift_multiple(task) {
  let head = "## v3.0.0\n\nA2\n\n## v2.0.0\n\nB\n\n## v1.0.0\n\nC2\n"
  let base = "## v3.0.0\n\nA1\n\n## v2.0.0\n\nB\n\n## v1.0.0\n\nC1\n"
  // v3 and v1 changed + tagged; v2 unchanged. Document order preserved.
  assert_eq(compute_drift(head, base, ["v3.0.0", "v2.0.0", "v1.0.0"]), ["3.0.0", "1.0.0"])
}

// --- has_bypass_trailer --------------------------------------------------
@test
pipeline test_has_bypass_trailer_present(task) {
  let msg = "subject\n\nbody\nAllow-Retroactive-Changelog: fixing a broken link\n"
  assert_eq(has_bypass_trailer(msg), true)
}

@test
pipeline test_has_bypass_trailer_absent(task) {
  assert_eq(has_bypass_trailer("subject\n\njust a normal commit\n"), false)
}

@test
pipeline test_has_bypass_trailer_requires_value(task) {
  // Trailer key with only whitespace after the colon does not count.
  assert_eq(has_bypass_trailer("Allow-Retroactive-Changelog:   \n"), false)
}

@test
pipeline test_has_bypass_trailer_must_be_line_start(task) {
  // Indented / inline mentions do not match the line-anchored regex.
  assert_eq(has_bypass_trailer("  Allow-Retroactive-Changelog: x\n"), false)
  assert_eq(has_bypass_trailer("see Allow-Retroactive-Changelog: x\n"), false)
}

@test
pipeline test_has_bypass_trailer_value_after_newlines(task) {
  // Python's `\s*\S` spans newlines: a value on a later line still matches.
  assert_eq(has_bypass_trailer("Allow-Retroactive-Changelog:\n\nreason here\n"), true)
}

// --- flag_value ----------------------------------------------------------
@test
pipeline test_flag_value_space_form(task) {
  assert_eq(flag_value(["--base", "abc123"], "--base"), "abc123")
}

@test
pipeline test_flag_value_equals_form(task) {
  assert_eq(flag_value(["--base=abc123"], "--base"), "abc123")
}

@test
pipeline test_flag_value_absent(task) {
  assert_eq(flag_value(["--other", "x"], "--base"), nil)
}

@test
pipeline test_flag_value_trailing_flag_no_value(task) {
  assert_eq(flag_value(["--base"], "--base"), nil)
}

// --- drift_report --------------------------------------------------------
@test
pipeline test_drift_report_shape(task) {
  let report = drift_report("BASEREF", ["2.0.0", "1.0.0"])
  let lines = report.split("\n")
  assert_eq(
    lines[0],
    "error: CHANGELOG.md sections for already-published versions were modified in this change (compared against BASEREF):",
  )
  assert_eq(lines[1], "  - v2.0.0")
  assert_eq(lines[2], "  - v1.0.0")
  assert_eq(lines[3], "")
  assert_eq(lines[4], "New entries belong under '## Unreleased' (or the next unreleased '## vX.Y.Z'")
  // Em-dash (U+2014) is part of the message, matching the Python output.
  assert_eq(lines[6], "already shipped. Move the entry, or — if this is a deliberate fix-up")
  assert_eq(lines[10], "or set ALLOW_CHANGELOG_RETROACTIVE_EDIT=1 in the environment.")
}
