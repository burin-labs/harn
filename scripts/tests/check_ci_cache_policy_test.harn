pipeline test_windows_shared_cache_requires_release_certification_bypass(harness: Harness, task) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"].jobs.nextest
  const cache = producer.steps[3]
  const invalid = {
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.slice(0, 3) + [{...cache, if: nil}] + producer.steps.slice(4),
      },
    },
  }
  assert(
    windows_shared_cache_errors(declared["ci.yml"], invalid).contains(
      "windows-nightly.yml:nextest must skip the shared target cache for release-certify refs",
    ),
  )
}

pipeline test_windows_release_certify_warm_requires_artifact_path_and_larger_drive(
  harness: Harness,
  task,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"]
  assert_eq(windows_release_certify_warm_errors(producer), [])
  const without_restore = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step ->
            return !contains(
              trim(step?.run ?? ""),
              "windows_workspace_warm_artifact.sh download-and-restore",
            )
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(without_restore).contains(
      "windows-nightly.yml:nextest must restore-only the main warm artifact on release-certify refs with cold fallback",
    ),
  )
  const small_drive = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Set up Dev Drive" {
              return step
            }
            return {...step, with: {...step.with, "drive-size": "25GB"}}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(small_drive).contains(
      "windows-nightly.yml:nextest must give release-certify refs a 50GB Dev Drive ceiling",
    ),
  )
}

pipeline test_actions_cache_capacity_stays_at_ten_gib(harness: Harness, task) {
  assert_eq(actions_cache_capacity_errors(policy()), [])
  const base = policy()
  const oversized: CiCachePolicy = {
    schema_version: base.schema_version,
    rust_cache_action: base.rust_cache_action,
    node_cache_action: base.node_cache_action,
    persistent_ref: base.persistent_ref,
    storage_limit_bytes: 32212254720,
    remote_sccache: base.remote_sccache,
    writers: base.writers,
  }
  assert(
    actions_cache_capacity_errors(oversized).contains(
      "cache-policy.json storage_limit_bytes must stay at 10737418240; Windows warm targets use workflow artifacts instead of raising Actions cache capacity",
    ),
  )
}

pipeline test_windows_shared_cache_rejects_source_partitioning_and_missing_target_mapping(
  harness: Harness,
  task,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"].jobs.nextest
  const producer_cache = producer.steps[3]
  const invalid = {
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.slice(0, 3)
          + [
          {
            ...producer_cache,
            with: {
              ...producer_cache.with,
              "source-key": native_source_key(),
              "target-dir": "",
              "broad-restore-prefix": "v0-rust-workspace-windows-",
            },
          },
        ],
      },
    },
  }
  const errors = windows_shared_cache_errors(declared["ci.yml"], invalid)
  assert(
    errors.contains(
      "workspace-windows producer and consumer must cache CARGO_TARGET_DIR explicitly",
    ),
  )
  assert(
    errors.contains(
      "workspace-windows producer and consumer must use one stable native restore namespace",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-windows cache-key inputs drift:") }))
}

pipeline test_ci_cache_policy_rejects_bypasses_remote_sccache_and_rogue_writers(
  harness: Harness,
  task,
) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {contents: "read"},
          steps: [
            {run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true},
            {run: "./scripts/report_ci_cache_budget.sh"},
          ],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "true"},
      jobs: {
        test: {
          steps: [
            {uses: "Swatinem/rust-cache@floating"},
            {
              uses: "./.github/actions/rust-cache",
              with: {
                "shared-key": "rogue",
                "prune-superseded-release-generations": true,
                save: true,
              },
            },
            {uses: "actions/setup-node@floating", with: {cache: "npm"}},
            {uses: "actions/cache/save@floating"},
            {uses: "docker/build-push-action@floating", with: {"cache-to": "type=gha"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains("ci.yml.env.SCCACHE_GHA_ENABLED enables the per-object GHA sccache backend"),
  )
  assert(errors.contains("ci.yml:test bypasses ./.github/actions/rust-cache"))
  assert(errors.contains("ci.yml:test:rogue is not an authorized persistent cache writer"))
  assert(
    errors.contains("ci.yml:test enables release-generation pruning outside its configured writer"),
  )
  assert(
    errors.contains("ci.yml:test bypasses ./.github/actions/node-cache with setup-node caching"),
  )
  assert(
    errors.contains(
      "ci.yml:test bypasses Harn-owned cache actions with actions/cache/save@floating",
    ),
  )
  assert(errors.contains("ci.yml:test enables an ungated BuildKit cache writer"))
  assert(errors.contains("build-release-binaries.yml:cache_budget must grant actions: write"))
  assert(
    errors.contains("build-release-binaries.yml:cache_budget must prune superseded release caches"),
  )
  assert(errors.contains("build-release-binaries.yml:cache_budget must enforce the cache budget"))
  assert(
    errors.contains(
      "build-release-binaries.yml:cache_budget must run ./scripts/report_ci_cache_budget.sh exactly once",
    ),
  )
}

@test
pipeline test_setup_harn_cache_accepts_default_branch_writer_and_ephemeral_restore(
  harness: Harness,
  task,
) {
  assert_eq(setup_harn_cache_action_errors(setup_harn_action()), [])
}

@test
pipeline test_setup_harn_cache_rejects_ephemeral_writer_or_incompatible_key(
  harness: Harness,
  task,
) {
  const invalid = {
    runs: {
      steps: [
        {
          uses: "actions/cache/restore@exact-pin",
          if: "github.ref != 'refs/heads/main'",
          with: {path: "restore", key: "setup-harn-v2-restore"},
        },
        {
          uses: "actions/cache@exact-pin",
          if: "github.ref != 'refs/heads/main'",
          with: {path: "writer", key: "setup-harn-v2-writer"},
        },
      ],
    },
  }
  const errors = setup_harn_cache_action_errors(invalid)
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml must use restore-only caching away from the caller's default branch",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml must save archives only on the caller's default branch",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml restore-only consumers and default-branch writer must share one versioned path and key",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml must keep cache-service failures non-fatal",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_missing_broad_rust_cache_fallback(harness: Harness, task) {
  const invalid_action = {
    runs: {
      steps: [
        {
          uses: "Swatinem/rust-cache@exact-pin",
          "continue-on-error": true,
          with: {
            "save-if": gha_expression("inputs.save == 'true' && github.ref == 'refs/heads/main'"),
          },
        },
      ],
    },
  }
  assert(
    ci_cache_policy_errors(policy(), invalid_action, node_action(), workflows()).contains(
      ".github/actions/rust-cache/action.yml must contain one pinned restore-only broad Rust cache fallback step",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_ignored_rust_cache_source_fingerprint(
  harness: Harness,
  task,
) {
  const valid_action = action()
  const invalid_action = {
    ...valid_action,
    runs: {
      ...valid_action.runs,
      steps: [
        valid_action.runs.steps[0],
        valid_action.runs.steps[1],
        {
          ...valid_action.runs.steps[2],
          with: {
            ...valid_action.runs.steps[2]?.with ?? {},
            "shared-key": gha_expression("inputs.shared-key"),
            key: gha_expression("inputs.source-key"),
          },
        },
      ],
    },
  }
  assert(
    ci_cache_policy_errors(policy(), invalid_action, node_action(), workflows()).contains(
      ".github/actions/rust-cache/action.yml must compose source-key and workspace retention into the effective upstream shared-key",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_uncoupled_workspace_retention(harness: Harness, task) {
  const valid_action = action()
  const cache = valid_action.runs.steps[2]
  const invalid_action = {
    ...valid_action,
    runs: {
      ...valid_action.runs,
      steps: valid_action.runs.steps.slice(0, 2)
        + [
        {
          ...cache,
          with: {
            ...cache?.with ?? {},
            "shared-key": gha_expression(
              "inputs.source-key != '' && format('{0}-{1}', inputs.shared-key, inputs.source-key) || inputs.shared-key",
            ),
            "cache-workspace-crates": nil,
          },
        },
      ],
    },
  }
  const errors = ci_cache_policy_errors(policy(), invalid_action, node_action(), workflows())
  assert(
    errors.contains(
      ".github/actions/rust-cache/action.yml must compose source-key and workspace retention into the effective upstream shared-key",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/rust-cache/action.yml must pass an opt-in workspace-crate retention input to Swatinem",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_open_or_duplicate_config(harness: Harness, task) {
  assert_eq(ci_cache_policy_parse({...policy(), unexpected: true}), nil)
  assert_eq(ci_cache_policy_parse({...policy(), writers: policy().writers + policy().writers}), nil)
  assert_eq(ci_cache_policy_parse({...policy(), writers: []}), nil)
}

pipeline test_ci_cache_policy_rejects_writer_key_drift(harness: Harness, task) {
  const invalid = {
    ...workflows(),
    "windows-nightly.yml": {
      jobs: {
        nextest: {
          steps: [
            {
              uses: "./.github/actions/rust-cache",
              with: {"shared-key": "workspace-windows-renamed", save: true},
            },
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains(
      "windows-nightly.yml:nextest:workspace-windows-renamed is not an authorized persistent cache writer",
    ),
  )
  assert(
    errors.contains(
      "authorized persistent cache writer is not active: windows-nightly.yml:nextest:workspace-windows",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_ownerless_or_incompatible_macos_cache(
  harness: Harness,
  task,
) {
  const invalid = {
    ...workflows(),
    "ci.yml": {
      ...workflows()["ci.yml"],
      jobs: {
        ...workflows()["ci.yml"].jobs,
        macos: {
          ...workflows()["ci.yml"].jobs.macos,
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "mozilla-actions/sccache-action@exact-pin"},
            {uses: "./.github/actions/configure-cargo-sccache"},
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-macos"}},
            {name: "Clippy all targets (deny warnings)", run: "cargo clippy -- -D warnings"},
          ],
        },
      },
    },
    "macos-nightly.yml": {
      ...workflows()["macos-nightly.yml"],
      jobs: {
        nextest: {
          ...workflows()["macos-nightly.yml"].jobs.nextest,
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "./.github/actions/rust-toolchain"},
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-macos"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
    + macos_shared_cache_errors(
    invalid["ci.yml"],
    invalid["macos-nightly.yml"],
  )
  assert(
    errors.contains(
      "authorized persistent cache writer is not active: macos-nightly.yml:nextest:workspace-macos",
    ),
  )
  assert(
    errors.any(
      { error -> error.starts_with("workspace-macos producer and consumer must use plain rustc:") },
    ),
  )
  assert(
    errors.contains(
      "workspace-macos producer and consumer must use the canonical source fingerprint",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-macos cache-key inputs drift:") }))
  assert(
    errors.contains(
      "ci.yml:macos must route strict Clippy through the cache-safe Rust lint entrypoint",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_advisory_budget_reporter(harness: Harness, task) {
