  assert_eq(
    release_warm_cache_path_policy_parse(
      {...policy, release_build_inputs: policy.release_build_inputs + ["Cargo.lock"]},
    ),
    nil,
  )
  assert_eq(
    release_warm_cache_path_policy_parse(
      {...policy, release_build_inputs: policy.release_build_inputs + ["../Cargo.lock"]},
    ),
    nil,
  )
  assert_eq(
    release_warm_cache_path_policy_parse(
      {...policy, release_build_inputs: policy.release_build_inputs + ["crates/*/Cargo.toml"]},
    ),
    nil,
  )
}

