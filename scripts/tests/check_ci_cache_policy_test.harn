/**
 * Native Windows is advisory. Each rule below is exercised by the regression
 * it exists to refuse, so none of them can be deleted without a red test.
 */
pipeline test_windows_native_admission_refuses_a_native_windows_ci_job(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const nightly = declared["windows-nightly.yml"]
  const restored = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {"runs-on": windows_runner_expression(), steps: []},
    },
  }
  assert_eq(
    windows_native_admission_errors(policy(), restored, nightly),
    [
      "ci.yml:windows runs on a native Windows runner; native Windows belongs to windows-nightly.yml (nightly, dispatch, and release pull requests), not pull-request or merge-group admission",
    ],
  )
  // An unreadable ci.yml has no jobs, which would otherwise read as "no
  // Windows job" and pass.
  assert_eq(
    windows_native_admission_errors(policy(), {}, nightly),
    ["ci.yml must declare jobs for the native Windows admission check to read"],
  )
}

pipeline test_windows_native_admission_pins_release_pull_request_routing(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const ci = declared["ci.yml"]
  const nightly = declared["windows-nightly.yml"]
  const path_gated = {...nightly, on: {...nightly.on, pull_request: {paths: ["crates/**"]}}}
  assert_eq(
    windows_native_admission_errors(policy(), ci, path_gated),
    [
      "windows-nightly.yml pull_request trigger must carry no path filter; the release route alone decides which pull requests run",
    ],
  )
  const queued = {...nightly, on: {...nightly.on, merge_group: nil}}
  assert_eq(
    windows_native_admission_errors(policy(), ci, queued),
    ["windows-nightly.yml must not run on merge_group"],
  )
  const no_release_prs = {...nightly, on: {schedule: nightly.on.schedule, workflow_dispatch: nil}}
  assert_eq(
    windows_native_admission_errors(policy(), ci, no_release_prs),
    ["windows-nightly.yml must run on release pull requests"],
  )
  const route = nightly.jobs.route
  const inline_matcher = {
    ...nightly,
    jobs: {
      ...nightly.jobs,
      route: {
        ...route,
        steps: route.steps.map(
          { step ->
            if trim(step?.id ?? "") == "decide" {
              return {...step, run: "[[ \"$PR_HEAD_REF\" == release/v* ]] && echo run=true"}
            }
            return step
          },
        )
          .to_list(),
      },
    },
  }
  assert_eq(
    windows_native_admission_errors(policy(), ci, inline_matcher),
    [
      "windows-nightly.yml:route must decide pull-request runs through .github/scripts/release-ref.sh release_pr_only_lane_run and publish it as outputs.run",
    ],
  )
  const unrouted = {
    ...nightly,
    jobs: {
      ...nightly.jobs,
      nextest: {...nightly.jobs.nextest, needs: nil, if: "github.repository == 'burin-labs/harn'"},
    },
  }
  assert_eq(
    windows_native_admission_errors(policy(), ci, unrouted),
    [
      "windows-nightly.yml:nextest must need route and run only when it says `needs.route.outputs.run == 'true'`",
    ],
  )
}

pipeline test_windows_nightly_producer_keeps_its_runner_tier_contract(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const ci = declared["ci.yml"]
  const nightly = declared["windows-nightly.yml"]
  const producer = nightly.jobs.nextest
  const with_producer = { job -> return {...nightly, jobs: {...nightly.jobs, nextest: job}} }
  // The 8 vCPU expression keeps the runner family, the tier, and the single
  // opt-in variable, so it decides whether the size is genuinely pinned.
  assert_eq(
    windows_native_admission_errors(
      policy(),
      ci,
      with_producer({...producer, "runs-on": windows_runner_expression()}),
    ),
    [
      "windows-nightly.yml:nextest must default to windows-latest, with HARN_CI_ENABLE_BLACKSMITH_WINDOWS=true opting into blacksmith-16vcpu-windows-2025",
    ],
  )
  const variable_only_drive = {
    ...producer,
    steps: producer.steps.map(
      { step ->
        if trim(step?.name ?? "") == "Set up Dev Drive" {
          return {...step, if: gha_expression("vars.HARN_WINDOWS_DEVDRIVE == 'on'")}
        }
        return step
      },
    )
      .to_list(),
  }
  assert_eq(
    windows_native_admission_errors(policy(), ci, with_producer(variable_only_drive)),
    [
      "windows-nightly.yml:nextest must skip Hyper-V Dev Drive setup on Blacksmith and retain it for the github-hosted fallback",
    ],
  )
}

pipeline test_windows_test_stack_is_runtime_only_and_exact(harness: Harness, task: unknown) {
  const declared = workflows()
  const ci = declared["ci.yml"]
  const nightly = declared["windows-nightly.yml"]
  const cache_polluted = {...nightly, env: {RUST_MIN_STACK: "16777216"}}
  assert(
    windows_native_admission_errors(policy(), ci, cache_polluted).contains(
      "Windows RUST_MIN_STACK is test-runtime-only and must not enter the producer's cache-action environment",
    ),
  )
  const producer = nightly.jobs.nextest
  const wrong_stack = {
    ...nightly,
    jobs: {
      ...nightly.jobs,
      nextest: {
        ...producer,
        steps: producer.steps.map(
          { step ->
            if trim(step?.name ?? "") == "Run workspace nextest" {
              return {...step, env: {RUST_MIN_STACK: "8388608"}}
            }
            return step
          },
        )
          .to_list(),
      },
    },
  }
  assert_eq(
    windows_native_admission_errors(policy(), ci, wrong_stack),
    ["windows-nightly.yml:nextest must set RUST_MIN_STACK=16777216 on its test step"],
  )
}

pipeline test_native_cache_inputs_exclude_test_runtime_stack(harness: Harness, task: unknown) {
  assert_eq(
    NATIVE_CACHE_INPUTS,
    ["CARGO_INCREMENTAL", "CARGO_TERM_COLOR", "RUSTC_WRAPPER", "RUSTFLAGS"],
  )
  assert(!NATIVE_CACHE_INPUTS.contains("RUST_MIN_STACK"))
}

pipeline test_windows_shared_cache_requires_release_certification_bypass(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"].jobs.nextest
  const cache = producer.steps[3]
  const invalid = {
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.slice(0, 3) + [{...cache, if: nil}] + producer.steps.slice(4),
      },
    },
  }
  assert(
    windows_shared_cache_errors(invalid).contains(
      "windows-nightly.yml:nextest must skip the shared target cache for release-certify refs",
    ),
  )
}

/**
 * The macOS warm path must be provable by its absence, not only its presence.
 *
 * Every other check in this suite governs the Actions cache. The warm artifact
 * replaced that cache on macOS because the namespace evicts it the same day, so
 * without this test the entire producer and consumer could be deleted and the
 * gate would stay green.
 */
pipeline test_macos_warm_requires_a_main_producer_and_a_pull_request_consumer(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const producer = declared["macos-nightly.yml"]
  const ci = declared["ci.yml"]
  const declared_policy = policy()
  assert_eq(macos_warm_errors(declared_policy, producer, ci), [])
  const without_pack = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step ->
            return !contains(trim(step?.run ?? ""), "workspace_warm_artifact.sh macos pack")
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    macos_warm_errors(declared_policy, without_pack, ci).contains(
      "macos-nightly.yml:nextest must pack the macOS warm artifact only on main",
    ),
  )
  const without_upload = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step ->
            return trim(to_string(step?.uses ?? "")) != "actions/upload-artifact@exact-pin"
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    macos_warm_errors(declared_policy, without_upload, ci).contains(
      "macos-nightly.yml:nextest must upload workspace-macos-warm from main with 3-day retention",
    ),
  )
  const without_actions_write = {...producer, permissions: {contents: "read"}}
  assert(
    macos_warm_errors(declared_policy, without_actions_write, ci).contains(
      "macos-nightly.yml must grant actions: write for warm artifact upload/download",
    ),
  )
  const ci_without_consumer = {
    ...ci,
    jobs: {
      ...ci.jobs,
      macos: {
        ...ci.jobs.macos,
        steps: ci.jobs.macos.steps.filter(
          { step ->
            return !contains(
              trim(step?.run ?? ""),
              "workspace_warm_artifact.sh macos download-and-restore",
            )
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    macos_warm_errors(declared_policy, producer, ci_without_consumer).contains(
      "ci.yml:macos must restore workspace-macos-warm through one macos-warm-restore step with cold fallback",
    ),
  )
}

pipeline test_windows_release_certify_warm_requires_artifact_path_and_larger_drive(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"]
  const declared_policy = policy()
  assert_eq(windows_release_certify_warm_errors(declared_policy, producer), [])
  // The job's own block replaces the workflow's, so a workflow-level grant
  // does not reach a job that declares `contents: read` alone.
  const read_only_job = {
    ...producer,
    permissions: {contents: "read", actions: "write"},
    jobs: {...producer.jobs, nextest: {...producer.jobs.nextest, permissions: {contents: "read"}}},
  }
  assert_eq(
    windows_release_certify_warm_errors(declared_policy, read_only_job),
    ["windows-nightly.yml:nextest must grant actions: write for warm artifact upload/download"],
  )
  const without_restore = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step ->
            return !contains(
              trim(step?.run ?? ""),
              "workspace_warm_artifact.sh windows download-and-restore",
            )
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, without_restore).contains(
      "windows-nightly.yml:nextest must restore-only the main warm artifact on release-certify refs with cold fallback",
    ),
  )
  const small_drive = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Set up Dev Drive" {
              return step
            }
            return {...step, with: {...step.with, "drive-size": "25GB"}}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, small_drive).contains(
      "windows-nightly.yml:nextest Dev Drive size must follow cache-policy.json windows_workspace_warm ceilings",
    ),
  )
  const silent_terminal = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step -> return trim(step?.name ?? "") != "Report Windows storage (terminal)" },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, silent_terminal).contains(
      "windows-nightly.yml:nextest must always emit the terminal storage receipt through the shared budget owner",
    ),
  )
  // Dropping the gate flag leaves a step that still reports before_build, so
  // every receipt assertion above stays satisfied. Without this control the
  // job could go back to measuring free space and entering the build anyway.
  const unguarded_before_build = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Report Windows storage (before build)" {
              return step
            }
            return {...step, run: "./scripts/ci/windows_storage_budget.sh report before_build"}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, unguarded_before_build).contains(
      "windows-nightly.yml:nextest must refuse the build when the before_build reading is under the declared headroom",
    ),
  )
}

pipeline test_nextest_version_locks_every_workflow_pin(harness: Harness, task: unknown) {
  const declared = workflows()
  const declared_policy = policy()
  assert_eq(nextest_version_errors(declared_policy, declared), [])
  const drifted = {
    ...declared,
    "windows-nightly.yml": {
      ...declared["windows-nightly.yml"],
      jobs: {
        nextest: {
          ...declared["windows-nightly.yml"].jobs.nextest,
          steps: declared["windows-nightly.yml"].jobs.nextest.steps.map(
            { step ->
              if trim(step?.name ?? "") != "Install cargo-nextest" {
                return step
              }
              return {...step, with: {tool: "nextest@0.9.131"}}
            },
          )
            .to_list(),
        },
      },
    },
  }
  assert(
    nextest_version_errors(declared_policy, drifted).contains(
      "windows-nightly.yml:nextest must install nextest@0.9.132 from cache-policy.json",
    ),
  )
}

pipeline test_actions_cache_capacity_keeps_warm_artifact_below_pool(
  harness: Harness,
  task: unknown,
) {
  assert_eq(actions_cache_capacity_errors(policy()), [])
  const base = policy()
  // Every field is re-listed on purpose. A named type annotation does not
  // accept a top-level `...base` spread, so these literals have to enumerate,
  // and adding a policy block is expected to touch each of them.
  const oversized_warm: CiCachePolicy = {
    schema_version: base.schema_version,
    rust_cache_action: base.rust_cache_action,
    node_cache_action: base.node_cache_action,
    persistent_ref: base.persistent_ref,
    storage_limit_bytes: base.storage_limit_bytes,
    remote_sccache: base.remote_sccache,
    nextest_version: base.nextest_version,
    windows_workspace_warm: {...base.windows_workspace_warm, max_bytes: base.storage_limit_bytes},
    macos_workspace_warm: base.macos_workspace_warm,
    writers: base.writers,
  }
  assert(
    actions_cache_capacity_errors(oversized_warm).contains(
      "cache-policy.json windows_workspace_warm.max_bytes must stay below storage_limit_bytes so warm artifacts cannot pretend to replace the Actions cache pool",
    ),
  )
  const flat_drive: CiCachePolicy = {
    schema_version: base.schema_version,
    rust_cache_action: base.rust_cache_action,
    node_cache_action: base.node_cache_action,
    persistent_ref: base.persistent_ref,
    storage_limit_bytes: base.storage_limit_bytes,
    remote_sccache: base.remote_sccache,
    nextest_version: base.nextest_version,
    windows_workspace_warm: {
      ...base.windows_workspace_warm,
      dev_drive_size_full_workspace: base.windows_workspace_warm.dev_drive_size_default,
    },
    macos_workspace_warm: base.macos_workspace_warm,
    writers: base.writers,
  }
  assert(
    actions_cache_capacity_errors(flat_drive).contains(
      "cache-policy.json windows_workspace_warm must give full-workspace runs a larger Dev Drive ceiling than the default",
    ),
  )
  // The macOS ceiling is governed too. Without this the new block could declare
  // an artifact larger than the whole cache pool and no check would say so.
  const oversized_macos_warm: CiCachePolicy = {
    schema_version: base.schema_version,
    rust_cache_action: base.rust_cache_action,
    node_cache_action: base.node_cache_action,
    persistent_ref: base.persistent_ref,
    storage_limit_bytes: base.storage_limit_bytes,
    remote_sccache: base.remote_sccache,
    nextest_version: base.nextest_version,
    windows_workspace_warm: base.windows_workspace_warm,
    macos_workspace_warm: {...base.macos_workspace_warm, max_bytes: base.storage_limit_bytes},
    writers: base.writers,
  }
  assert(
    actions_cache_capacity_errors(oversized_macos_warm).contains(
      "cache-policy.json macos_workspace_warm.max_bytes must stay below storage_limit_bytes so warm artifacts cannot pretend to replace the Actions cache pool",
    ),
  )
}

pipeline test_windows_shared_cache_rejects_source_partitioning_and_missing_target_mapping(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"].jobs.nextest
  const producer_cache = producer.steps[3]
  const invalid = {
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.slice(0, 3)
          + [
            {
              ...producer_cache,
              with: {
                ...producer_cache.with,
                "source-key": native_source_key(),
                "target-dir": "",
                "broad-restore-prefix": "v0-rust-workspace-windows-",
              },
            },
          ],
      },
    },
  }
  assert_eq(
    windows_shared_cache_errors(invalid),
    [
      "workspace-windows producer must cache CARGO_TARGET_DIR explicitly",
      "workspace-windows producer must use one stable native restore namespace",
    ],
  )
}

pipeline test_ci_cache_policy_rejects_bypasses_remote_sccache_and_rogue_writers(
  harness: Harness,
  task: unknown,
) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {contents: "read"},
          steps: [
            {run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true},
            {run: "./scripts/report_ci_cache_budget.sh"},
          ],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "true"},
      jobs: {
        test: {
          steps: [
            {uses: "Swatinem/rust-cache@floating"},
            {
              uses: "./.github/actions/rust-cache",
              with: {
                "shared-key": "rogue",
                "prune-superseded-release-generations": true,
                save: true,
              },
            },
            {uses: "actions/setup-node@floating", with: {cache: "npm"}},
            {uses: "actions/cache/save@floating"},
            {uses: "docker/build-push-action@floating", with: {"cache-to": "type=gha"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains("ci.yml.env.SCCACHE_GHA_ENABLED enables the per-object GHA sccache backend"),
  )
  assert(errors.contains("ci.yml:test bypasses ./.github/actions/rust-cache"))
  assert(errors.contains("ci.yml:test:rogue is not an authorized persistent cache writer"))
  assert(
    errors.contains("ci.yml:test enables release-generation pruning outside its configured writer"),
  )
  assert(
    errors.contains("ci.yml:test bypasses ./.github/actions/node-cache with setup-node caching"),
  )
  assert(
    errors.contains(
      "ci.yml:test bypasses Harn-owned cache actions with actions/cache/save@floating",
    ),
  )
  assert(errors.contains("ci.yml:test enables an ungated BuildKit cache writer"))
  assert(errors.contains("build-release-binaries.yml:cache_budget must grant actions: write"))
  assert(
    errors.contains("build-release-binaries.yml:cache_budget must prune superseded release caches"),
  )
  assert(errors.contains("build-release-binaries.yml:cache_budget must enforce the cache budget"))
  assert(
    errors.contains(
      "build-release-binaries.yml:cache_budget must run ./scripts/report_ci_cache_budget.sh exactly once",
    ),
  )
}

/**
 * A cache writer's `save` may be conditional, but only on a guard this checker
 * recognises. An expression nobody classified is refused rather than read as
 * "saves": that reading is what would let a sole producer silently stop writing
 * while the gate went on reporting a healthy writer, which is the exact shape
 * where a missing observation passes for a satisfied one.
 */
pipeline test_cache_save_guard_must_be_recognised(task: any) {
  assert_eq(save_requested({with: {save: true}}), true)
  assert_eq(save_requested({with: {save: "true"}}), true)
  assert_eq(save_requested({with: {save: PULL_REQUEST_RESTORE_ONLY_SAVE}}), true)
  assert_eq(save_requested({with: {save: false}}), false)
  assert_eq(save_requested({}), false)
  // The failure this rule exists for: a plausible-looking guard nobody
  // declared, which the old string test would have accepted as a writer.
  const undeclared = "$" + "{{ github.event_name == 'schedule' }}"
  assert_eq(save_requested({with: {save: undeclared}}), false)
}
