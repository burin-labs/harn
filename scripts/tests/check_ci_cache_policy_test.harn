@test
pipeline test_cache_refresh_rejects_warming_a_generation_it_cannot_save(
  harness: Harness,
  task: unknown,
) {
  // An exact-key restore is immutable: the post step writes nothing, so an
  // unguarded warm compiles for minutes and discards the result.
  const job = {
    steps: [
      {
        name: "Prepare Linux cache generation save",
        if: "steps.rust-cache.outputs.cache-hit != 'true'",
      },
      {name: "Install cargo-nextest", if: "matrix.install_nextest"},
      {name: "Warm Cargo graph", run: gha_expression("matrix.warm_script")},
    ],
  }
  assert_eq(len(rust_cache_refresh_miss_only_errors(job)), 2)
}

