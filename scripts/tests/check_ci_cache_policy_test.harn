pipeline test_ci_cache_policy_accepts_declared_main_guarded_writers(
  harness: Harness,
  task: unknown,
) {
  assert(ci_cache_policy_parse(policy()) != nil)
  const declared = workflows()
  assert_eq(
    ci_cache_policy_errors(policy(), action(), node_action(), declared)
      + windows_shared_cache_errors(declared["ci.yml"], declared["windows-nightly.yml"])
      + windows_pr_native_feedback_errors(
        policy(),
        declared["ci.yml"],
        declared["windows-nightly.yml"],
      )
      + windows_release_certify_warm_errors(policy(), declared["windows-nightly.yml"])
      + nextest_version_errors(policy(), declared)
      + actions_cache_capacity_errors(policy()),
    [],
  )
}

