pipeline test_windows_pr_runner_requires_internal_blacksmith_with_safe_fallbacks(
  harness: Harness,
  task,
) {
  const declared = workflows()
  const windows = declared["ci.yml"].jobs.windows
  const hosted_only = {
    ...declared["ci.yml"],
    jobs: {...declared["ci.yml"].jobs, windows: {...windows, "runs-on": "windows-latest"}},
  }
  assert(
    windows_pr_native_feedback_errors(policy(), hosted_only, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows must route merge_group and same-repository pull_request to blacksmith-8vcpu-windows-2025, with HARN_CI_DISABLE_BLACKSMITH_WINDOWS=true and external events falling back to windows-latest",
      ),
  )
  const wrong_tier = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {...windows, env: {...windows.env, HARN_RUNNER_TIER: "blacksmith"}},
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), wrong_tier, declared["windows-nightly.yml"])
      .contains("ci.yml:windows must mirror its Blacksmith/hosted runner tier"),
  )
  const no_artifact_authority = {
    ...declared["ci.yml"],
    jobs: {...declared["ci.yml"].jobs, windows: {...windows, permissions: {contents: "read"}}},
  }
  assert(
    windows_pr_native_feedback_errors(
      policy(),
      no_artifact_authority,
      declared["windows-nightly.yml"],
    )
      .contains(
        "ci.yml:windows must grant only contents: read and actions: read for artifact discovery",
      ),
  )
  const dev_drive_on_blacksmith = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Set up Dev Drive" {
              return step
            }
            return {...step, if: gha_expression("vars.HARN_WINDOWS_DEVDRIVE == 'on'")}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(
      policy(),
      dev_drive_on_blacksmith,
      declared["windows-nightly.yml"],
    )
      .contains(
        "ci.yml:windows must skip Hyper-V Dev Drive setup on Blacksmith and retain it for the github-hosted fallback",
      ),
  )
}

pipeline test_windows_storage_budget_rejects_small_full_drive_duplicate_profile_and_silent_tail(
  harness: Harness,
  task,
) {
  const declared = workflows()
  const windows = declared["ci.yml"].jobs.windows
  const small_drive = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Set up Dev Drive" {
              return step
            }
            return {...step, with: {...step.with, "drive-size": "25GB"}}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), small_drive, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows Dev Drive must reserve the full-workspace ceiling outside pull requests",
      ),
  )
  const duplicate_profile = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Produce exact Windows Harn binary" {
              return step
            }
            return {...step, run: "cargo build --locked -p harn-cli"}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), duplicate_profile, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows must publish its freshness receipt from the Cargo test profile before nextest",
      ),
  )
  const rebuilding_tail = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Compile Windows tests and run unit slice" {
              return step
            }
            return {...step, run: step.run + "\nHARN_BIN_NO_BUILD=0 ./scripts/harn_bin.sh --print"}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), rebuilding_tail, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows must consume the produced Harn receipt without a fallback or feature-drift rebuild",
      ),
  )
  const feature_drift = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Compile Windows tests and run unit slice" {
              return step
            }
            return {
              ...step,
              run: "HARN_BIN='' HARN_BIN_NO_BUILD=1 ./scripts/harn_bin.sh --no-build --print\ncargo nextest run",
            }
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), feature_drift, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows must consume the produced Harn receipt without a fallback or feature-drift rebuild",
      ),
  )
  const direct_smoke = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Smoke test harn run" {
              return step
            }
            return {...step, run: "target/debug/harn.exe\" run smoke.harn"}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), direct_smoke, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows smoke must fail closed through receipt-validated no-build Harn resolution",
      ),
  )
  const silent_tail = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.filter(
          { step -> return trim(step?.name ?? "") != "Report Windows storage (terminal)" },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), silent_tail, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows must always emit the terminal storage receipt through the shared budget owner",
      ),
  )
}

pipeline test_windows_pr_warm_artifact_is_primary_fail_open_and_provenanced(
  harness: Harness,
  task,
) {
  const declared = workflows()
  const windows = declared["ci.yml"].jobs.windows
  const cache = windows.steps.filter(
    { step -> return step?.uses == "./.github/actions/rust-cache" },
  )
    .first()
  // GitHub evaluates this exact guard after the receipt-producing restore:
  // hit skips the provider cache; miss or absent output runs the fallback.
  assert_eq(
    cache.if,
    "steps.windows-warm-restore.outputs.windows_warm_restore != 'hit' && steps.windows-warm-restore.outputs.windows_warm_restore_reason != 'insufficient_space'",
  )
  assert_eq(windows.permissions, {contents: "read", actions: "read"})
  const reversed = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.slice(0, 4)
          + [windows.steps[5], windows.steps[4]]
          + windows.steps.slice(6),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), reversed, declared["windows-nightly.yml"])
      .contains(
        "ci.yml:windows must try the main warm artifact before its provider-local rust-cache fallback",
      ),
  )
  const layered = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.map(
          { step ->
            if step?.uses == "./.github/actions/rust-cache" {
              return {...step, if: nil}
            }
            return step
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), layered, declared["windows-nightly.yml"]).contains(
      "ci.yml:windows must use rust-cache only when the provider-neutral warm artifact misses",
    ),
  )
  const restore = windows.steps[4]
  const closed = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.slice(0, 4)
          + [
          {...restore, "continue-on-error": false, run: restore.run.split("\n")[0]},
        ]
          + windows.steps.slice(5),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), closed, declared["windows-nightly.yml"]).contains(
      "ci.yml:windows must fail-open through one output-producing workspace-windows-warm restore",
    ),
  )
  const silent = {
    ...declared["ci.yml"],
    jobs: {
      ...declared["ci.yml"].jobs,
      windows: {
        ...windows,
        steps: windows.steps.filter(
          { step -> return trim(step?.name ?? "") != "Report Windows warm restore outcome" },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), silent, declared["windows-nightly.yml"]).contains(
      "ci.yml:windows must always report warm-artifact outcome, producer commit, and source run",
    ),
  )
}

pipeline test_windows_test_stack_is_runtime_only_and_exact_on_both_jobs(harness: Harness, task) {
  const declared = workflows()
  const nightly = declared["windows-nightly.yml"]
  const cache_polluted = {...nightly, env: {RUST_MIN_STACK: "16777216"}}
  assert(
    windows_pr_native_feedback_errors(policy(), declared["ci.yml"], cache_polluted).contains(
      "Windows RUST_MIN_STACK is test-runtime-only and must not enter producer or consumer cache-action environments",
    ),
  )
  const producer = nightly.jobs.nextest
  const wrong_stack = {
    ...nightly,
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.map(
          { step ->
            if trim(step?.name ?? "") == "Run workspace nextest" {
              return {...step, env: {RUST_MIN_STACK: "8388608"}}
            }
            return step
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_pr_native_feedback_errors(policy(), declared["ci.yml"], wrong_stack).contains(
      "Windows test steps must set identical RUST_MIN_STACK=16777216 runtime stacks",
    ),
  )
  const migrated_writer = {
    ...nightly,
    jobs: {nextest: {...producer, "runs-on": "blacksmith-8vcpu-windows-2025"}},
  }
  assert(
    windows_pr_native_feedback_errors(policy(), declared["ci.yml"], migrated_writer).contains(
      "windows-nightly.yml:nextest must remain on windows-latest",
    ),
  )
}

