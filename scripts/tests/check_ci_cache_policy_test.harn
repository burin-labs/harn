  assert_eq(
    ci_cache_policy_errors(policy(), action(), node_action(), declared)
      + windows_shared_cache_errors(declared["windows-nightly.yml"])
      + windows_native_admission_errors(
        policy(),
        declared["ci.yml"],
        declared["windows-nightly.yml"],
      )
      + windows_release_certify_warm_errors(policy(), declared["windows-nightly.yml"])
      + nextest_version_errors(policy(), declared)
      + actions_cache_capacity_errors(policy()),
    [],
  )
}

