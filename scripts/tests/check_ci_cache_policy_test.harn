import {
  ci_cache_policy_errors,
  ci_cache_policy_parse,
  macos_shared_cache_errors,
  setup_harn_cache_action_errors,
  windows_shared_cache_errors,
} from "../check_ci_cache_policy"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn native_source_key() -> string {
  return gha_expression(
    "hashFiles('Cargo.lock', 'Cargo.toml', 'crates/**', 'spec/**', 'tree-sitter-harn/**')",
  )
}

fn windows_cache_inputs(save: bool = false) {
  return {
    "shared-key": "workspace-windows",
    "target-dir": gha_expression("env.CARGO_TARGET_DIR"),
    ...if save {
      {save: true}
    } else {
      {}
    },
  }
}

fn policy() -> CiCachePolicy {
  return {
    schema_version: 2,
    rust_cache_action: "./.github/actions/rust-cache",
    node_cache_action: "./.github/actions/node-cache",
    persistent_ref: "refs/heads/main",
    storage_limit_bytes: 10737418240,
    remote_sccache: false,
    writers: [
      {
        workflow: "build-release-binaries.yml",
        job: "build",
        shared_key: "release-" + gha_expression("matrix.target"),
      },
      {workflow: "windows-nightly.yml", job: "nextest", shared_key: "workspace-windows"},
      {workflow: "macos-nightly.yml", job: "nextest", shared_key: "workspace-macos"},
    ],
  }
}

fn node_action() {
  return {
    runs: {
      steps: [
        {uses: "actions/setup-node@exact-pin"},
        {
          uses: "actions/cache/restore@exact-pin",
          if: "github.ref != 'refs/heads/main'",
          "continue-on-error": true,
        },
        {
          uses: "actions/cache@exact-pin",
          if: "github.ref == 'refs/heads/main'",
          "continue-on-error": true,
        },
      ],
    },
  }
}

fn setup_harn_action() {
  const default_ref = "format('refs/heads/{0}', github.event.repository.default_branch)"
  const path = gha_expression("steps.resolve.outputs.cache-dir")
  const key = "setup-harn-v2-" + gha_expression("steps.resolve.outputs.version")
  return {
    runs: {
      steps: [
        {
          uses: "actions/cache/restore@exact-pin",
          if: "github.ref != " + default_ref,
          "continue-on-error": true,
          with: {path: path, key: key},
        },
        {
          uses: "actions/cache@exact-pin",
          if: "github.ref == " + default_ref,
          "continue-on-error": true,
          with: {path: path, key: key},
        },
      ],
    },
  }
}

fn action() {
  return {
    inputs: {
      "prune-superseded-release-generations": {default: "false"},
      "target-dir": {default: ""},
    },
    runs: {
      steps: [
        {
          run:
            "./scripts/prune_ci_cache_generations.sh --family-prefix \"$HARN_CACHE_FAMILY_PREFIX\"",
          if:
            "inputs.prune-superseded-release-generations == 'true' && inputs.save == 'true' && github.ref == 'refs/heads/main'",
          env: {
            GH_TOKEN: gha_expression("github.token"),
            HARN_CACHE_FAMILY_PREFIX: "v0-rust-" + gha_expression("inputs.shared-key") + "-",
          },
        },
        {
          uses: "actions/cache/restore@exact-pin",
          if: "inputs.broad-restore-prefix != ''",
          "continue-on-error": true,
          with: {
            path: gha_expression("env.CARGO_HOME || '~/.cargo'")
              + "/registry\n"
              + gha_expression("env.CARGO_HOME || '~/.cargo'")
              + "/git\n"
              + gha_expression(
              "env.CARGO_TARGET_DIR || format('{0}/target', github.workspace)",
            ),
            key: gha_expression("inputs.broad-restore-prefix") + gha_expression("github.sha"),
            "restore-keys": gha_expression("inputs.broad-restore-prefix"),
          },
        },
        {
          uses: "Swatinem/rust-cache@exact-pin",
          "continue-on-error": true,
          with: {
            "shared-key": gha_expression(
              "inputs.source-key != '' && format('{0}-{1}', inputs.shared-key, inputs.source-key) || inputs.shared-key",
            ),
            "cache-targets": gha_expression("inputs.target-dir == ''"),
            "cache-directories": gha_expression("inputs.target-dir"),
            "save-if": gha_expression("inputs.save == 'true' && github.ref == 'refs/heads/main'"),
          },
        },
      ],
    },
  }
}

fn workflows() {
  return {
    "build-release-binaries.yml": {
      jobs: {
        build: {
          permissions: {actions: "write", contents: "write"},
          steps: [
            {
              uses: "./.github/actions/rust-cache",
              with: {
                "shared-key": "release-" + gha_expression("matrix.target"),
                "prune-superseded-release-generations": true,
                save: gha_expression("needs.setup.outputs.build_mode == 'warm'"),
              },
            },
          ],
        },
        cache_budget: {
          permissions: {actions: "write", contents: "read"},
          steps: [
            {
              env: {HARN_PRUNE_SUPERSEDED_RELEASE_CACHES: "1", HARN_ENFORCE_CACHE_BUDGET: "1"},
              run: "./scripts/report_ci_cache_budget.sh",
            },
          ],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "false"},
      jobs: {
        test: {
          steps: [
            {uses: "./.github/actions/rust-cache"},
            {uses: "./.github/actions/node-cache"},
            {
              uses: "docker/build-push-action@exact-pin",
              with: {
                "cache-to": gha_expression("github.ref == 'refs/heads/main' && 'type=gha' || ''"),
              },
            },
          ],
        },
        macos: {
          env: {RUSTFLAGS: "-D warnings"},
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "./.github/actions/rust-toolchain"},
            {
              uses: "./.github/actions/rust-cache",
              with: {"shared-key": "workspace-macos", "source-key": native_source_key()},
            },
            {name: "Clippy all targets (deny warnings)", run: "./scripts/ci/run_rust_lint_lane.sh"},
          ],
        },
        windows: {
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "samypr100/setup-dev-drive@exact-pin"},
            {uses: "./.github/actions/rust-toolchain"},
            {uses: "./.github/actions/rust-cache", with: windows_cache_inputs()},
          ],
        },
      },
    },
    "cli-cold-start-budget.yml": {
      on: {schedule: [{cron: "17 11 * * *"}], workflow_dispatch: {}},
      jobs: {
        "cold-start-budget": {
          if:
            "(github.event_name != 'workflow_dispatch' || !startsWith(github.ref_name, 'release/v'))",
          "timeout-minutes": 30,
          steps: [{name: "Build release harn", "timeout-minutes": 25}],
        },
      },
    },
    "windows-nightly.yml": {
      jobs: {
        nextest: {
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "samypr100/setup-dev-drive@exact-pin"},
            {uses: "./.github/actions/rust-toolchain"},
            {uses: "./.github/actions/rust-cache", with: windows_cache_inputs(true)},
          ],
        },
      },
    },
    "macos-nightly.yml": {
      env: {RUSTFLAGS: "-D warnings"},
      jobs: {
        nextest: {
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "./.github/actions/rust-toolchain"},
            {
              uses: "./.github/actions/rust-cache",
              with: {
                "shared-key": "workspace-macos",
                "source-key": native_source_key(),
                save: true,
              },
            },
          ],
        },
      },
    },
  }
}

pipeline test_ci_cache_policy_accepts_declared_main_guarded_writers(harness: Harness, task) {
  assert(ci_cache_policy_parse(policy()) != nil)
  const declared = workflows()
  assert_eq(
    ci_cache_policy_errors(policy(), action(), node_action(), declared)
      + windows_shared_cache_errors(
      declared["ci.yml"],
      declared["windows-nightly.yml"],
    ),
    [],
  )
}

pipeline test_windows_shared_cache_targets_dev_drive_with_one_stable_restore_owner(
  harness: Harness,
  task,
) {
  const declared = workflows()
  assert_eq(windows_shared_cache_errors(declared["ci.yml"], declared["windows-nightly.yml"]), [])
}

pipeline test_windows_shared_cache_rejects_source_partitioning_and_missing_target_mapping(
  harness: Harness,
  task,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"].jobs.nextest
  const producer_cache = producer.steps[3]
  const invalid = {
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.slice(0, 3)
          + [
          {
            ...producer_cache,
            with: {
              ...producer_cache.with,
              "source-key": native_source_key(),
              "target-dir": "",
              "broad-restore-prefix": "v0-rust-workspace-windows-",
            },
          },
        ],
      },
    },
  }
  const errors = windows_shared_cache_errors(declared["ci.yml"], invalid)
  assert(
    errors.contains(
      "workspace-windows producer and consumer must cache CARGO_TARGET_DIR explicitly",
    ),
  )
  assert(
    errors.contains(
      "workspace-windows producer and consumer must use one stable native restore namespace",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-windows cache-key inputs drift:") }))
}

pipeline test_ci_cache_policy_rejects_bypasses_remote_sccache_and_rogue_writers(
  harness: Harness,
  task,
) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {contents: "read"},
          steps: [
            {run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true},
            {run: "./scripts/report_ci_cache_budget.sh"},
          ],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "true"},
      jobs: {
        test: {
          steps: [
            {uses: "Swatinem/rust-cache@floating"},
            {
              uses: "./.github/actions/rust-cache",
              with: {
                "shared-key": "rogue",
                "prune-superseded-release-generations": true,
                save: true,
              },
            },
            {uses: "actions/setup-node@floating", with: {cache: "npm"}},
            {uses: "actions/cache/save@floating"},
            {uses: "docker/build-push-action@floating", with: {"cache-to": "type=gha"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains("ci.yml.env.SCCACHE_GHA_ENABLED enables the per-object GHA sccache backend"),
  )
  assert(errors.contains("ci.yml:test bypasses ./.github/actions/rust-cache"))
  assert(errors.contains("ci.yml:test:rogue is not an authorized persistent cache writer"))
  assert(
    errors.contains("ci.yml:test enables release-generation pruning outside its configured writer"),
  )
  assert(
    errors.contains("ci.yml:test bypasses ./.github/actions/node-cache with setup-node caching"),
  )
  assert(
    errors.contains(
      "ci.yml:test bypasses Harn-owned cache actions with actions/cache/save@floating",
    ),
  )
  assert(errors.contains("ci.yml:test enables an ungated BuildKit cache writer"))
  assert(errors.contains("build-release-binaries.yml:cache_budget must grant actions: write"))
  assert(
    errors.contains("build-release-binaries.yml:cache_budget must prune superseded release caches"),
  )
  assert(errors.contains("build-release-binaries.yml:cache_budget must enforce the cache budget"))
  assert(
    errors.contains(
      "build-release-binaries.yml:cache_budget must run ./scripts/report_ci_cache_budget.sh exactly once",
    ),
  )
}

@test
pipeline test_setup_harn_cache_accepts_default_branch_writer_and_ephemeral_restore(
  harness: Harness,
  task,
) {
  assert_eq(setup_harn_cache_action_errors(setup_harn_action()), [])
}

@test
pipeline test_setup_harn_cache_rejects_ephemeral_writer_or_incompatible_key(
  harness: Harness,
  task,
) {
  const invalid = {
    runs: {
      steps: [
        {
          uses: "actions/cache/restore@exact-pin",
          if: "github.ref != 'refs/heads/main'",
          with: {path: "restore", key: "setup-harn-v2-restore"},
        },
        {
          uses: "actions/cache@exact-pin",
          if: "github.ref != 'refs/heads/main'",
          with: {path: "writer", key: "setup-harn-v2-writer"},
        },
      ],
    },
  }
  const errors = setup_harn_cache_action_errors(invalid)
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml must use restore-only caching away from the caller's default branch",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml must save archives only on the caller's default branch",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml restore-only consumers and default-branch writer must share one versioned path and key",
    ),
  )
  assert(
    errors.contains(
      ".github/actions/setup-harn/action.yml must keep cache-service failures non-fatal",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_missing_broad_rust_cache_fallback(harness: Harness, task) {
  const invalid_action = {
    runs: {
      steps: [
        {
          uses: "Swatinem/rust-cache@exact-pin",
          "continue-on-error": true,
          with: {
            "save-if": gha_expression("inputs.save == 'true' && github.ref == 'refs/heads/main'"),
          },
        },
      ],
    },
  }
  assert(
    ci_cache_policy_errors(policy(), invalid_action, node_action(), workflows()).contains(
      ".github/actions/rust-cache/action.yml must contain one pinned restore-only broad Rust cache fallback step",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_ignored_rust_cache_source_fingerprint(
  harness: Harness,
  task,
) {
  const valid_action = action()
  const invalid_action = {
    ...valid_action,
    runs: {
      ...valid_action.runs,
      steps: [
        valid_action.runs.steps[0],
        valid_action.runs.steps[1],
        {
          ...valid_action.runs.steps[2],
          with: {
            ...valid_action.runs.steps[2]?.with ?? {},
            "shared-key": gha_expression("inputs.shared-key"),
            key: gha_expression("inputs.source-key"),
          },
        },
      ],
    },
  }
  assert(
    ci_cache_policy_errors(policy(), invalid_action, node_action(), workflows()).contains(
      ".github/actions/rust-cache/action.yml must compose source-key into the effective upstream shared-key",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_open_or_duplicate_config(harness: Harness, task) {
  assert_eq(ci_cache_policy_parse({...policy(), unexpected: true}), nil)
  assert_eq(ci_cache_policy_parse({...policy(), writers: policy().writers + policy().writers}), nil)
  assert_eq(ci_cache_policy_parse({...policy(), writers: []}), nil)
}

pipeline test_ci_cache_policy_rejects_writer_key_drift(harness: Harness, task) {
  const invalid = {
    ...workflows(),
    "windows-nightly.yml": {
      jobs: {
        nextest: {
          steps: [
            {
              uses: "./.github/actions/rust-cache",
              with: {"shared-key": "workspace-windows-renamed", save: true},
            },
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains(
      "windows-nightly.yml:nextest:workspace-windows-renamed is not an authorized persistent cache writer",
    ),
  )
  assert(
    errors.contains(
      "authorized persistent cache writer is not active: windows-nightly.yml:nextest:workspace-windows",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_ownerless_or_incompatible_macos_cache(
  harness: Harness,
  task,
) {
  const invalid = {
    ...workflows(),
    "ci.yml": {
      ...workflows()["ci.yml"],
      jobs: {
        ...workflows()["ci.yml"].jobs,
        macos: {
          ...workflows()["ci.yml"].jobs.macos,
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "mozilla-actions/sccache-action@exact-pin"},
            {uses: "./.github/actions/configure-cargo-sccache"},
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-macos"}},
            {name: "Clippy all targets (deny warnings)", run: "cargo clippy -- -D warnings"},
          ],
        },
      },
    },
    "macos-nightly.yml": {
      ...workflows()["macos-nightly.yml"],
      jobs: {
        nextest: {
          ...workflows()["macos-nightly.yml"].jobs.nextest,
          steps: [
            {uses: "actions/checkout@exact-pin"},
            {uses: "./.github/actions/rust-toolchain"},
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-macos"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
    + macos_shared_cache_errors(
    invalid["ci.yml"],
    invalid["macos-nightly.yml"],
  )
  assert(
    errors.contains(
      "authorized persistent cache writer is not active: macos-nightly.yml:nextest:workspace-macos",
    ),
  )
  assert(
    errors.any(
      { error -> error.starts_with("workspace-macos producer and consumer must use plain rustc:") },
    ),
  )
  assert(
    errors.contains(
      "workspace-macos producer and consumer must use the canonical source fingerprint",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-macos cache-key inputs drift:") }))
  assert(
    errors.contains(
      "ci.yml:macos must route strict Clippy through the cache-safe Rust lint entrypoint",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_advisory_budget_reporter(harness: Harness, task) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {actions: "read", contents: "read"},
          steps: [{run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true}],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains("build-release-binaries.yml:cache_budget must fail when cache telemetry fails"),
  )
}

pipeline test_ci_cache_policy_rejects_unbounded_release_writer(harness: Harness, task) {
  const bounded = workflows()["build-release-binaries.yml"].jobs.build
  const release_cache = bounded.steps[0]
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: {
          ...bounded,
          permissions: {actions: "read", contents: "write"},
          steps: [
            {
              ...release_cache,
              with: {...release_cache.with, "prune-superseded-release-generations": false},
            },
          ],
        },
        cache_budget: workflows()["build-release-binaries.yml"].jobs.cache_budget,
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(errors.contains("build-release-binaries.yml:build must grant actions: write"))
  assert(
    errors.contains(
      "build-release-binaries.yml:build must prune superseded release generations before saving",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_cold_start_pr_trigger(harness: Harness, task) {
  const invalid = {
    ...workflows(),
    "cli-cold-start-budget.yml": {
      on: {
        pull_request: {
          paths: [
            "Cargo.toml",
            "crates/harn-cli/src/cli/**",
            "bench/cli/**",
            "scripts/bench_cli_cold_start.sh",
            "scripts/bench_cli_cold_start.harn",
            ".github/workflows/cli-cold-start-budget.yml",
          ],
        },
        workflow_dispatch: {},
      },
      jobs: {
        "cold-start-budget": {
          if: "github.event_name != 'pull_request' || !startsWith(github.head_ref, 'release/v')",
          "timeout-minutes": 45,
          steps: [{name: "Build release harn", "timeout-minutes": 40}],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains(
      "cli-cold-start-budget.yml must not run release-build cold-start benchmarks on pull_request",
    ),
  )
  assert(
    errors.contains("cli-cold-start-budget.yml must keep a scheduled main-branch advisory run"),
  )
  assert(
    errors.contains("cli-cold-start-budget.yml:cold-start-budget must skip release manual refs"),
  )
  assert(
    errors.contains(
      "cli-cold-start-budget.yml:cold-start-budget must cap total runtime at 30 minutes",
    ),
  )
  assert(
    errors.contains(
      "cli-cold-start-budget.yml:cold-start-budget release build step must cap runtime at 25 minutes",
    ),
  )
}
