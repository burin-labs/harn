fn sccache_action(
  default_size: string = "",
  configure_run: string = "\"$GITHUB_ACTION_PATH/configure-env.sh\"",
) -> dict {
  return {
    inputs: {"cache-size": {default: default_size}},
    runs: {
      steps: [
        {
          env: {HARN_SCCACHE_CACHE_SIZE_INPUT: gha_expression("inputs.cache-size")},
          run: configure_run,
        },
      ],
    },
  }
}

@test
pipeline test_sccache_action_preserves_the_callers_cache_size_contract(
  harness: Harness,
  task: unknown,
) {
  assert_eq(sccache_action_cache_size_errors(sccache_action()), [])
}

@test
pipeline test_sccache_action_rejects_a_default_that_overwrites_the_caller(
  harness: Harness,
  task: unknown,
) {
  const errors = sccache_action_cache_size_errors(sccache_action("2G"))
  assert_eq(len(errors), 1)
  assert_eq(contains(errors[0] ?? "", "default empty"), true)
}

@test
pipeline test_sccache_action_requires_one_unparameterized_environment_owner(
  harness: Harness,
  task: unknown,
) {
  const command = "\"$GITHUB_ACTION_PATH/configure-env.sh\""
  const invalid_runs = [
    "echo \"SCCACHE_CACHE_SIZE=15G\"",
    command + "\n" + command,
    command + " \"$SCCACHE_CACHE_SIZE\" \"$HARN_SCCACHE_CACHE_SIZE_INPUT\"",
  ]
  for run in invalid_runs {
    const errors = sccache_action_cache_size_errors(sccache_action("", run))
    assert_eq(len(errors), 1)
    assert_eq(contains(errors[0] ?? "", "exactly once"), true)
  }
}

@test
pipeline test_sccache_action_rejects_a_second_helper_step(harness: Harness, task: unknown) {
  let action = sccache_action()
  action.runs.steps = action.runs.steps
    + [{run: "\"$GITHUB_ACTION_PATH/configure-env.sh\" reversed args"}]
  const errors = sccache_action_cache_size_errors(action)
  assert_eq(len(errors), 1)
  assert_eq(contains(errors[0] ?? "", "exactly once"), true)
}

@test
pipeline test_sccache_action_rejects_a_step_local_inherited_size_override(
  harness: Harness,
  task: unknown,
) {
  let action = sccache_action()
  action.runs.steps[0].env.SCCACHE_CACHE_SIZE = "2G"
  const errors = sccache_action_cache_size_errors(action)
  assert_eq(len(errors), 1)
  assert_eq(contains(errors[0] ?? "", "instead of shadowing"), true)
}

@test
pipeline test_ci_concurrency_keeps_an_executed_result_per_main_head(
  harness: Harness,
  task: unknown,
) {
  assert_eq(ci_workflow_concurrency_errors({concurrency: ci_concurrency()}), [])
}

@test
pipeline test_ci_concurrency_rejects_cancelling_main_pushes(harness: Harness, task: unknown) {
  // The other half of the defect: even with a per-commit key, cancelling on
  // push lets a merge kill a run already executing, so that head sha still
  // ends with no executed result.
  let cancels_main = ci_concurrency()
  cancels_main["cancel-in-progress"] = gha_expression(
    "github.event_name == 'pull_request' || (github.event_name == 'push' && github.ref == 'refs/heads/main')",
  )
  const errors = ci_workflow_concurrency_errors({concurrency: cancels_main})
  assert_eq(len(errors), 1)
  assert(contains(errors[0] ?? "", "nothing may supersede a main push"))
}

@test
pipeline test_ci_concurrency_rejects_one_shared_main_key(harness: Harness, task: unknown) {
  // The defect the per-commit key exists to refuse: one key for every main
  // push lets a later merge evict a pending proof before any job starts, so
  // most main commits never finish being proved.
  const invalid = {
    concurrency: {
      group: gha_expression("github.workflow")
        + "-"
        + gha_expression(
          "github.event.pull_request.number || github.event.merge_group.head_sha || (github.ref == 'refs/heads/main' && 'main') || github.ref",
        ),
      "cancel-in-progress": ci_concurrency()["cancel-in-progress"],
    },
  }
  const errors = ci_workflow_concurrency_errors(invalid)
  assert_eq(len(errors), 1)
  assert(contains(errors[0] ?? "", "its own key"))
}

@test
pipeline test_e2e_concurrency_keeps_an_executed_result_per_main_head(
  harness: Harness,
  task: unknown,
) {
  // The shipped expression, read off the workflow rather than restated, so a
  // change to the group that nobody updated here is refused rather than
  // compared against a copy of itself.
  const workflow = read_yaml(harness.fs, "../../.github/workflows/e2e.yml")
  assert_eq(e2e_workflow_concurrency_errors(workflow), [])
  assert_eq(e2e_workflow_concurrency_errors({concurrency: e2e_concurrency()}), [])
}

@test
pipeline test_e2e_concurrency_rejects_one_shared_main_key(harness: Harness, task: unknown) {
  // The observed defect: with one key for every main push, a push waiting
  // behind an executing run is cancelled by the push after it with zero jobs,
  // so `notify` never runs and the commit carries no slow-suite result.
  let shared = e2e_concurrency()
  shared.group = gha_expression("github.workflow")
    + "-"
    + gha_expression("github.event.pull_request.number || github.ref")
  const errors = e2e_workflow_concurrency_errors({concurrency: shared})
  assert_eq(len(errors), 1)
  assert(contains(errors[0] ?? "", "its own key"))
}

@test
pipeline test_e2e_concurrency_rejects_cancelling_main_pushes(harness: Harness, task: unknown) {
  // The other half: a per-commit key does not help if a push may cancel a run
  // that is already executing.
  let cancels_main = e2e_concurrency()
  cancels_main["cancel-in-progress"] = gha_expression("true")
  const errors = e2e_workflow_concurrency_errors({concurrency: cancels_main})
  assert_eq(len(errors), 1)
  assert(contains(errors[0] ?? "", "nothing may supersede a main push"))
}

@test
pipeline test_minimal_pr_capacity_policy_and_negative_controls(harness: Harness, task: unknown) {
  const publish = read_yaml(harness.fs, "../../.github/workflows/publish-release.yml")
  const ci = read_yaml(harness.fs, "../../.github/workflows/ci.yml")
  assert_eq(minimal_pr_capacity_errors(ci, publish), [])
  let self_hosted_waiter = ci
  self_hosted_waiter.jobs["rust-artifacts-ready"]["runs-on"] = "self-hosted"
  assert(
    minimal_pr_capacity_errors(self_hosted_waiter, publish).contains(
      "ci.yml:rust-artifacts-ready must use GitHub-hosted ubuntu-latest",
    ),
  )
  let pr_policy = ci
  pr_policy.jobs["audit-scripts"].if = "needs.changes.outputs.rust == 'true'"
  assert(
    minimal_pr_capacity_errors(pr_policy, publish).contains(
      "ci.yml:audit-scripts must run on Rust-changing main pushes only",
    ),
  )
  let main_publish = publish
  main_publish["on"].push.branches = ["main"]
  assert(
    minimal_pr_capacity_errors(ci, main_publish).contains(
      "publish-release.yml must not trigger on branch pushes",
    ),
  )
  let unrouted_source_checks = ci
  unrouted_source_checks.jobs["harn-audit"]["runs-on"] = "ubuntu-latest"
  assert(
    minimal_pr_capacity_errors(unrouted_source_checks, publish).contains(
      "ci.yml:harn-audit must use the shared elastic Linux runner switch",
    ),
  )
}

