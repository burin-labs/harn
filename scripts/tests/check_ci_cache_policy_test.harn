pipeline test_windows_release_certify_warm_requires_artifact_path_and_larger_drive(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"]
  const declared_policy = policy()
  assert_eq(windows_release_certify_warm_errors(declared_policy, producer), [])
  const without_restore = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step ->
            return !contains(
              trim(step?.run ?? ""),
              "windows_workspace_warm_artifact.sh download-and-restore",
            )
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, without_restore).contains(
      "windows-nightly.yml:nextest must restore-only the main warm artifact on release-certify refs with cold fallback",
    ),
  )
  const small_drive = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.map(
          { step ->
            if trim(step?.name ?? "") != "Set up Dev Drive" {
              return step
            }
            return {...step, with: {...step.with, "drive-size": "25GB"}}
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, small_drive).contains(
      "windows-nightly.yml:nextest Dev Drive size must follow cache-policy.json windows_workspace_warm ceilings",
    ),
  )
  const silent_terminal = {
    ...producer,
    jobs: {
      nextest: {
        ...producer.jobs.nextest,
        steps: producer.jobs.nextest.steps.filter(
          { step -> return trim(step?.name ?? "") != "Report Windows storage (terminal)" },
        )
          .to_list(),
      },
    },
  }
  assert(
    windows_release_certify_warm_errors(declared_policy, silent_terminal).contains(
      "windows-nightly.yml:nextest must always emit the terminal storage receipt through the shared budget owner",
    ),
  )
}

pipeline test_nextest_version_locks_every_workflow_pin(harness: Harness, task: unknown) {
  const declared = workflows()
  const declared_policy = policy()
  assert_eq(nextest_version_errors(declared_policy, declared), [])
  const drifted = {
    ...declared,
    "windows-nightly.yml": {
      ...declared["windows-nightly.yml"],
      jobs: {
        nextest: {
          ...declared["windows-nightly.yml"].jobs.nextest,
          steps: declared["windows-nightly.yml"].jobs.nextest.steps.map(
            { step ->
              if trim(step?.name ?? "") != "Install cargo-nextest" {
                return step
              }
              return {...step, with: {tool: "nextest@0.9.131"}}
            },
          )
            .to_list(),
        },
      },
    },
  }
  assert(
    nextest_version_errors(declared_policy, drifted).contains(
      "windows-nightly.yml:nextest must install nextest@0.9.132 from cache-policy.json",
    ),
  )
}

pipeline test_actions_cache_capacity_keeps_warm_artifact_below_pool(
  harness: Harness,
  task: unknown,
) {
  assert_eq(actions_cache_capacity_errors(policy()), [])
  const base = policy()
  const oversized_warm: CiCachePolicy = {
    schema_version: base.schema_version,
    rust_cache_action: base.rust_cache_action,
    node_cache_action: base.node_cache_action,
    persistent_ref: base.persistent_ref,
    storage_limit_bytes: base.storage_limit_bytes,
    remote_sccache: base.remote_sccache,
    nextest_version: base.nextest_version,
    windows_workspace_warm: {...base.windows_workspace_warm, max_bytes: base.storage_limit_bytes},
    writers: base.writers,
  }
  assert(
    actions_cache_capacity_errors(oversized_warm).contains(
      "cache-policy.json windows_workspace_warm.max_bytes must stay below storage_limit_bytes so warm artifacts cannot pretend to replace the Actions cache pool",
    ),
  )
  const flat_drive: CiCachePolicy = {
    schema_version: base.schema_version,
    rust_cache_action: base.rust_cache_action,
    node_cache_action: base.node_cache_action,
    persistent_ref: base.persistent_ref,
    storage_limit_bytes: base.storage_limit_bytes,
    remote_sccache: base.remote_sccache,
    nextest_version: base.nextest_version,
    windows_workspace_warm: {
      ...base.windows_workspace_warm,
      dev_drive_size_release_certify: base.windows_workspace_warm.dev_drive_size_default,
    },
    writers: base.writers,
  }
  assert(
    actions_cache_capacity_errors(flat_drive).contains(
      "cache-policy.json windows_workspace_warm must give full-workspace and release-certify runs larger Dev Drive ceilings than the default",
    ),
  )
}

pipeline test_windows_shared_cache_rejects_source_partitioning_and_missing_target_mapping(
  harness: Harness,
  task: unknown,
) {
  const declared = workflows()
  const producer = declared["windows-nightly.yml"].jobs.nextest
  const producer_cache = producer.steps[3]
  const invalid = {
    jobs: {
      nextest: {
        ...producer,
        steps: producer.steps.slice(0, 3)
          + [
            {
              ...producer_cache,
              with: {
                ...producer_cache.with,
                "source-key": native_source_key(),
                "target-dir": "",
                "broad-restore-prefix": "v0-rust-workspace-windows-",
              },
            },
          ],
      },
    },
  }
  const errors = windows_shared_cache_errors(declared["ci.yml"], invalid)
  assert(
    errors.contains(
      "workspace-windows producer and consumer must cache CARGO_TARGET_DIR explicitly",
    ),
  )
  assert(
    errors.contains(
      "workspace-windows producer and consumer must use one stable native restore namespace",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-windows cache-key inputs drift:") }))
}

pipeline test_ci_cache_policy_rejects_bypasses_remote_sccache_and_rogue_writers(
  harness: Harness,
  task: unknown,
) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {contents: "read"},
          steps: [
            {run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true},
            {run: "./scripts/report_ci_cache_budget.sh"},
          ],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "true"},
      jobs: {
        test: {
          steps: [
            {uses: "Swatinem/rust-cache@floating"},
            {
              uses: "./.github/actions/rust-cache",
              with: {
                "shared-key": "rogue",
                "prune-superseded-release-generations": true,
                save: true,
              },
            },
            {uses: "actions/setup-node@floating", with: {cache: "npm"}},
            {uses: "actions/cache/save@floating"},
            {uses: "docker/build-push-action@floating", with: {"cache-to": "type=gha"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains("ci.yml.env.SCCACHE_GHA_ENABLED enables the per-object GHA sccache backend"),
  )
  assert(errors.contains("ci.yml:test bypasses ./.github/actions/rust-cache"))
  assert(errors.contains("ci.yml:test:rogue is not an authorized persistent cache writer"))
  assert(
    errors.contains("ci.yml:test enables release-generation pruning outside its configured writer"),
  )
  assert(
    errors.contains("ci.yml:test bypasses ./.github/actions/node-cache with setup-node caching"),
  )
  assert(
    errors.contains(
      "ci.yml:test bypasses Harn-owned cache actions with actions/cache/save@floating",
    ),
  )
  assert(errors.contains("ci.yml:test enables an ungated BuildKit cache writer"))
  assert(errors.contains("build-release-binaries.yml:cache_budget must grant actions: write"))
  assert(
    errors.contains("build-release-binaries.yml:cache_budget must prune superseded release caches"),
  )
  assert(errors.contains("build-release-binaries.yml:cache_budget must enforce the cache budget"))
  assert(
    errors.contains(
      "build-release-binaries.yml:cache_budget must run ./scripts/report_ci_cache_budget.sh exactly once",
    ),
  )
}

/**
 * A cache writer's `save` may be conditional, but only on a guard this checker
 * recognises. An expression nobody classified is refused rather than read as
 * "saves": that reading is what would let a sole producer silently stop writing
 * while the gate went on reporting a healthy writer, which is the exact shape
 * where a missing observation passes for a satisfied one.
 */
pipeline test_cache_save_guard_must_be_recognised(task: any) {
  assert_eq(save_requested({with: {save: true}}), true)
  assert_eq(save_requested({with: {save: "true"}}), true)
  assert_eq(save_requested({with: {save: PULL_REQUEST_RESTORE_ONLY_SAVE}}), true)
  assert_eq(save_requested({with: {save: false}}), false)
  assert_eq(save_requested({}), false)
  // The failure this rule exists for: a plausible-looking guard nobody
  // declared, which the old string test would have accepted as a writer.
  const undeclared = "$" + "{{ github.event_name == 'schedule' }}"
  assert_eq(save_requested({with: {save: undeclared}}), false)
}
