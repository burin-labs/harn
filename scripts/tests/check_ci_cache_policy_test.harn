import { ci_cache_policy_errors, ci_cache_policy_parse } from "../check_ci_cache_policy"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn policy() -> CiCachePolicy {
  return {
    schema_version: 2,
    rust_cache_action: "./.github/actions/rust-cache",
    node_cache_action: "./.github/actions/node-cache",
    persistent_ref: "refs/heads/main",
    storage_limit_bytes: 10737418240,
    remote_sccache: false,
    writers: [
      {workflow: "build-release-binaries.yml", job: "build", shared_key: "release-target"},
      {workflow: "windows-nightly.yml", job: "nextest", shared_key: "workspace-windows"},
    ],
  }
}

fn node_action() {
  return {
    runs: {
      steps: [
        {uses: "actions/setup-node@exact-pin"},
        {
          uses: "actions/cache/restore@exact-pin",
          if: "github.ref != 'refs/heads/main'",
          "continue-on-error": true,
        },
        {uses: "actions/cache@exact-pin", if: "github.ref == 'refs/heads/main'", "continue-on-error": true},
      ],
    },
  }
}

fn action() {
  return {
    runs: {
      steps: [
        {
          uses: "actions/cache/restore@exact-pin",
          if: "inputs.broad-restore-prefix != ''",
          "continue-on-error": true,
          with: {
            key: gha_expression("inputs.broad-restore-prefix") + gha_expression("github.sha"),
            "restore-keys": gha_expression("inputs.broad-restore-prefix"),
          },
        },
        {
          uses: "Swatinem/rust-cache@exact-pin",
          "continue-on-error": true,
          with: {"save-if": gha_expression("inputs.save == 'true' && github.ref == 'refs/heads/main'")},
        },
      ],
    },
  }
}

fn workflows() {
  return {
    "build-release-binaries.yml": {
      jobs: {
        build: {
          steps: [
            {
              uses: "./.github/actions/rust-cache",
              with: {"shared-key": "release-target", save: gha_expression("needs.setup.outputs.build_mode == 'warm'")},
            },
          ],
        },
        cache_budget: {
          permissions: {actions: "read", contents: "read"},
          steps: [{run: "./scripts/report_ci_cache_budget.sh"}],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "false"},
      jobs: {
        test: {
          steps: [
            {uses: "./.github/actions/rust-cache"},
            {uses: "./.github/actions/node-cache"},
            {
              uses: "docker/build-push-action@exact-pin",
              with: {"cache-to": gha_expression("github.ref == 'refs/heads/main' && 'type=gha' || ''")},
            },
          ],
        },
      },
    },
    "cli-cold-start-budget.yml": {
      on: {schedule: [{cron: "17 11 * * *"}], workflow_dispatch: {}},
      jobs: {
        "cold-start-budget": {
          if: "(github.event_name != 'workflow_dispatch' || !startsWith(github.ref_name, 'release/v'))",
          "timeout-minutes": 25,
          steps: [{name: "Build release harn", "timeout-minutes": 20}],
        },
      },
    },
    "windows-nightly.yml": {
      jobs: {
        nextest: {
          steps: [{uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-windows", save: true}}],
        },
      },
    },
  }
}

pipeline test_ci_cache_policy_accepts_declared_main_guarded_writers(task) {
  assert(ci_cache_policy_parse(policy()) != nil)
  assert_eq(ci_cache_policy_errors(policy(), action(), node_action(), workflows()), [])
}

pipeline test_ci_cache_policy_rejects_bypasses_remote_sccache_and_rogue_writers(task) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {contents: "read"},
          steps: [
            {run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true},
            {run: "./scripts/report_ci_cache_budget.sh"},
          ],
        },
      },
    },
    "ci.yml": {
      env: {SCCACHE_GHA_ENABLED: "true"},
      jobs: {
        test: {
          steps: [
            {uses: "Swatinem/rust-cache@floating"},
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "rogue", save: true}},
            {uses: "actions/setup-node@floating", with: {cache: "npm"}},
            {uses: "actions/cache/save@floating"},
            {uses: "docker/build-push-action@floating", with: {"cache-to": "type=gha"}},
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(errors.contains("ci.yml.env.SCCACHE_GHA_ENABLED enables the per-object GHA sccache backend"))
  assert(errors.contains("ci.yml:test bypasses ./.github/actions/rust-cache"))
  assert(errors.contains("ci.yml:test:rogue is not an authorized persistent cache writer"))
  assert(errors.contains("ci.yml:test bypasses ./.github/actions/node-cache with setup-node caching"))
  assert(
    errors.contains(
      "ci.yml:test bypasses Harn-owned cache actions with actions/cache/save@floating",
    ),
  )
  assert(errors.contains("ci.yml:test enables an ungated BuildKit cache writer"))
  assert(errors.contains("build-release-binaries.yml:cache_budget must grant actions: read"))
  assert(
    errors.contains(
      "build-release-binaries.yml:cache_budget must run ./scripts/report_ci_cache_budget.sh exactly once",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_missing_broad_rust_cache_fallback(task) {
  const invalid_action = {
    runs: {
      steps: [
        {
          uses: "Swatinem/rust-cache@exact-pin",
          "continue-on-error": true,
          with: {"save-if": gha_expression("inputs.save == 'true' && github.ref == 'refs/heads/main'")},
        },
      ],
    },
  }
  assert(
    ci_cache_policy_errors(policy(), invalid_action, node_action(), workflows()).contains(
      ".github/actions/rust-cache/action.yml must contain one pinned restore-only broad Rust cache fallback step",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_open_or_duplicate_config(task) {
  assert_eq(ci_cache_policy_parse({...policy(), unexpected: true}), nil)
  assert_eq(ci_cache_policy_parse({...policy(), writers: policy().writers + policy().writers}), nil)
  assert_eq(ci_cache_policy_parse({...policy(), writers: []}), nil)
}

pipeline test_ci_cache_policy_rejects_writer_key_drift(task) {
  const invalid = {
    ...workflows(),
    "windows-nightly.yml": {
      jobs: {
        nextest: {
          steps: [
            {
              uses: "./.github/actions/rust-cache",
              with: {"shared-key": "workspace-windows-renamed", save: true},
            },
          ],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains(
      "windows-nightly.yml:nextest:workspace-windows-renamed is not an authorized persistent cache writer",
    ),
  )
  assert(
    errors.contains(
      "authorized persistent cache writer is not active: windows-nightly.yml:nextest:workspace-windows",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_advisory_budget_reporter(task) {
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: workflows()["build-release-binaries.yml"].jobs.build,
        cache_budget: {
          permissions: {actions: "read", contents: "read"},
          steps: [{run: "./scripts/report_ci_cache_budget.sh", "continue-on-error": true}],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains("build-release-binaries.yml:cache_budget must fail when cache telemetry fails"),
  )
}

pipeline test_ci_cache_policy_rejects_cold_start_pr_trigger(task) {
  const invalid = {
    ...workflows(),
    "cli-cold-start-budget.yml": {
      on: {
        pull_request: {
          paths: [
            "Cargo.toml",
            "crates/harn-cli/src/cli/**",
            "perf/cli/**",
            "scripts/bench_cli_cold_start.sh",
            "scripts/bench_cli_cold_start.harn",
            ".github/workflows/cli-cold-start-budget.yml",
          ],
        },
        workflow_dispatch: {},
      },
      jobs: {
        "cold-start-budget": {
          if: "github.event_name != 'pull_request' || !startsWith(github.head_ref, 'release/v')",
          "timeout-minutes": 45,
          steps: [{name: "Build release harn", "timeout-minutes": 40}],
        },
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(
    errors.contains(
      "cli-cold-start-budget.yml must not run release-build cold-start benchmarks on pull_request",
    ),
  )
  assert(errors.contains("cli-cold-start-budget.yml must keep a scheduled main-branch advisory run"))
  assert(errors.contains("cli-cold-start-budget.yml:cold-start-budget must skip release manual refs"))
  assert(
    errors.contains(
      "cli-cold-start-budget.yml:cold-start-budget must cap total runtime at 25 minutes",
    ),
  )
  assert(
    errors.contains(
      "cli-cold-start-budget.yml:cold-start-budget release build step must cap runtime at 20 minutes",
    ),
  )
}
