pipeline test_ci_cache_policy_rejects_unbounded_release_writer(harness: Harness, task) {
  const bounded = workflows()["build-release-binaries.yml"].jobs.build
  const release_cache = bounded.steps[0]
  const invalid = {
    ...workflows(),
    "build-release-binaries.yml": {
      jobs: {
        build: {
          ...bounded,
          permissions: {actions: "read", contents: "write"},
          steps: [
            {
              ...release_cache,
              with: {...release_cache.with, "prune-superseded-release-generations": false},
            },
          ],
        },
        cache_budget: workflows()["build-release-binaries.yml"].jobs.cache_budget,
      },
    },
  }
  const errors = ci_cache_policy_errors(policy(), action(), node_action(), invalid)
  assert(errors.contains("build-release-binaries.yml:build must grant actions: write"))
  assert(
    errors.contains(
      "build-release-binaries.yml:build must prune superseded release generations before saving",
    ),
  )
}

pipeline test_ci_cache_policy_rejects_unpartitioned_release_exact_cache(harness: Harness, task) {
