import {
  RepoPlan,
  Symbol,
  container_shape,
  index_clone,
  insert_query,
  oracle_control,
  prepare_repo,
  run_symbol,
} from "../precise_qualify.harn"

const LIB =
  "pub fn helper() -> i32 {\n    1\n}\n\npub fn user() -> i32 {\n    helper() + helper()\n}\n"

const HELPER: Symbol = {
  name: "helper",
  path: "src/lib.rs",
  line: 1,
  col: nil,
  kind: "Function",
  container: "",
}

fn git(process: HarnessProcess, root: string, args: list<string>) {
  const res = process.run(
    {
      program: "git",
      args: ["-c", "user.name=probe", "-c", "user.email=probe@example.invalid"] + args,
      cwd: root,
    },
  )
  assert(res.success, res.stderr)
}

/** A committed one-file crate whose oracle is the given command. */
fn fixture(harness: Harness, oracle: list<string>) -> {root: string, repo: RepoPlan} {
  const root = harness.fs.mkdtemp_in_workspace("precise-qualify-")
  harness.fs.mkdir(root + "/src")
  harness.fs.write_text(root + "/src/lib.rs", LIB)
  git(harness.process, root, ["init", "-q"])
  git(harness.process, root, ["add", "-A"])
  git(harness.process, root, ["commit", "-q", "-m", "fixture"])
  assert(index_clone(harness, root).ok)
  return {
    root: root,
    repo: {
      id: "fixture",
      language: "rust",
      url: "",
      commit: "",
      checkout: root,
      setup: [],
      oracle: [oracle],
    },
  }
}

fn outcome_of(attempts: list<dict>, arm: string) -> dict {
  return attempts.filter({ attempt -> attempt.arm == arm }).to_list()[0] ?? {}
}

// Negative control: the oracle requires the old public name, so any applied
// rename breaks it. The probe must report that edit as wrong, never applied.
@serial(group: "code_index")
pipeline test_an_applied_rename_the_oracle_rejects_is_reported_wrong(harness: Harness) {
  const fx = fixture(harness, ["grep", "-q", "fn helper()", "src/lib.rs"])
  const attempts = run_symbol(
    harness,
    fx.repo,
    fx.root,
    HELPER,
    ["find_references", "rename_symbol:syntax_tree"],
  )
  const rename = outcome_of(attempts, "rename_symbol:syntax_tree")
  assert_eq(rename.outcome, "applied_wrong")
  assert_eq(rename.reason, "oracle_failed")
  assert_eq(rename.apply.changed_files, ["src/lib.rs"])
  assert_eq(outcome_of(attempts, "find_references").outcome, "pending")
  assert_eq(harness.fs.read_text(fx.root + "/src/lib.rs"), LIB)
}

@serial(group: "code_index")
pipeline test_an_applied_rename_the_oracle_accepts_is_correct(harness: Harness) {
  const fx = fixture(harness, ["grep", "-q", "pub fn user()", "src/lib.rs"])
  const attempts = run_symbol(
    harness,
    fx.repo,
    fx.root,
    HELPER,
    ["find_references", "rename_symbol:syntax_tree"],
  )
  assert_eq(outcome_of(attempts, "rename_symbol:syntax_tree").outcome, "applied_correct")
  const references = outcome_of(attempts, "find_references")
  assert_eq(references.outcome, "applied_correct")
  assert_eq(references.oracle_source, "rename_symbol:syntax_tree")
  assert_eq(harness.fs.read_text(fx.root + "/src/lib.rs"), LIB)
}

/** An oracle that judges nothing must leave the repo unmeasured, never pass. */
pipeline test_a_repo_without_an_oracle_is_not_measured(harness: Harness) {
  const fx = fixture(harness, ["true"])
  const prepared = prepare_repo(harness, fx.repo + {oracle: []}, fx.root)
  assert_eq(prepared.ok, false)
  assert_eq(prepared.reason, "oracle_missing")
}

@serial(group: "code_index")
pipeline test_an_oracle_that_passes_a_broken_file_is_blind(harness: Harness) {
  const blind = fixture(harness, ["true"])
  const control = oracle_control(harness, blind.repo, blind.root, ["src/lib.rs"])
  assert_eq(control.reason, "oracle_blind")
  assert_eq(harness.fs.read_text(blind.root + "/src/lib.rs"), LIB)
  const sighted = fixture(harness, ["sh", "-c", "! grep -q @@@ src/lib.rs"])
  assert(oracle_control(harness, sighted.repo, sighted.root, ["src/lib.rs", "src/lib.rs"]).ok)
  assert_eq(harness.fs.read_text(sighted.root + "/src/lib.rs"), LIB)
  // Every sampled file is checked: the oracle above never reads `src/other.rs`.
  harness.fs.write_text(sighted.root + "/src/other.rs", "pub fn other() {}\n")
  const partial = oracle_control(
    harness,
    sighted.repo,
    sighted.root,
    ["src/lib.rs", "src/other.rs"],
  )
  assert_eq(partial.reason, "oracle_blind")
  assert(partial.detail.contains("src/other.rs"))
}

/** A setup file reaches the scratch clone, so a generated config can widen the oracle. */
@serial(group: "code_index")
pipeline test_setup_files_widen_the_oracle(harness: Harness) {
  const fx = fixture(harness, ["grep", "-q", "pub fn", "extra.cfg"])
  const head = harness.process.run({program: "git", args: ["rev-parse", "HEAD"], cwd: fx.root})
  const commit = trim(head.stdout)
  const repo = fx.repo + {commit: commit, setup_files: {"extra.cfg": "pub fn\n"}}
  const work = harness.fs.mkdtemp_in_workspace("precise-qualify-work-")
  const prepared = prepare_repo(harness, repo, work)
  assert_eq(prepared.ok, true)
  assert_eq(harness.fs.read_text(prepared.root + "/extra.cfg"), "pub fn\n")
}

type InsertCase = {name: string, shape: string, content: string}

/**
 * An insert of `item` into `path` through the probe's query; the response is the raw builtin result.
 */
fn dry_insert(ast: HarnessAst, path: string, language: string, item: InsertCase) -> dict {
  return ast.insert_at_anchor(
    {
      path: path,
      query: insert_query(language, item.name, item.shape),
      position: "last_child",
      content: item.content,
      dry_run: true,
    },
  )
}

/** The insert query must pick one container; the old shape matched every class in the file. */
pipeline test_insert_query_names_exactly_one_container(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("precise-qualify-insert-")
  const source = "class A {}\nclass B {}\nabstract class C {}\ninterface D {}\ninterface E {}\n"
  harness.fs.write_text(root + "/a.ts", source)
  const ts_cases: list<InsertCase> = [
    {name: "A", shape: "body", content: "m(): number {}"},
    {name: "C", shape: "body", content: "m(): number {}"},
    {name: "D", shape: "definition", content: "m(): number"},
  ]
  for item in ts_cases {
    const res = dry_insert(harness.ast, root + "/a.ts", "typescript", item)
    assert_eq(res.result, "applied", item.name + ": " + to_string(res.details ?? ""))
    // Everything else is byte-for-byte what it was.
    for other in ["A", "B", "C", "D", "E"].filter({ name -> name != item.name }) {
      assert(to_string(res.preview).contains(other + " {}"), item.name + " insert touched " + other)
    }
  }
  const java = harness.fs.mkdtemp_in_workspace("precise-qualify-insert-")
  harness.fs.write_text(java + "/A.java", "class A {}\nclass B {}\ninterface I {}\nenum E { X; }\n")
  const java_cases: list<InsertCase> = [
    {name: "A", shape: "body", content: "int m() { return 0; }"},
    {name: "E", shape: "body", content: "int m() { return 0; }"},
    {name: "I", shape: "definition", content: "default int m() { return 0; }"},
  ]
  for item in java_cases {
    const res = dry_insert(harness.ast, java + "/A.java", "java", item)
    assert_eq(res.result, "applied", item.name + ": " + to_string(res.details ?? ""))
  }
}

/** A trait or interface is a definition; a struct's members live in its impl. */
pipeline test_a_trait_definition_is_an_insert_target(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("precise-qualify-insert-")
  const source =
    "pub trait Shape {\n    fn area(&self) -> f64;\n}\n\npub struct Square(f64);\n\nimpl Square {\n    pub fn side(&self) -> f64 {\n        self.0\n    }\n}\n"
  harness.fs.write_text(root + "/lib.rs", source)
  assert_eq(container_shape("rust", "pub trait Shape {", "Shape"), "definition")
  assert_eq(container_shape("rust", "pub struct Square(f64);", "Square"), "body")
  assert_eq(container_shape("typescript", "export interface Named {", "Named"), "definition")
  assert_eq(container_shape("typescript", "export class Named {", "Named"), "body")
  const method = "fn added(&self) -> u8 {\n    0\n}"
  const trait_res = harness.ast.insert_at_anchor(
    {
      path: root + "/lib.rs",
      query: insert_query("rust", "Shape", "definition"),
      position: "last_child",
      content: method,
      dry_run: true,
    },
  )
  assert_eq(trait_res.result, "applied", to_string(trait_res.details))
  assert(trait_res.preview.index_of("fn added") < trait_res.preview.index_of("pub struct Square"))
  // The inherent-impl query still lands in the impl.
  const impl_res = harness.ast.insert_at_anchor(
    {
      path: root + "/lib.rs",
      query: insert_query("rust", "Square", "body"),
      position: "last_child",
      content: method,
      dry_run: true,
    },
  )
  assert_eq(impl_res.result, "applied", to_string(impl_res.details))
  assert(impl_res.preview.index_of("fn added") > impl_res.preview.index_of("impl Square"))
  // A trait name has no inherent impl: the refusal lists the containers to retry.
  const miss = harness.ast.insert_at_anchor(
    {
      path: root + "/lib.rs",
      query: insert_query("rust", "Shape", "body"),
      position: "last_child",
      content: method,
      dry_run: true,
    },
  )
  assert_eq(miss.result, "no_match")
  assert_eq(miss.candidates.map({ c -> c.kind + ":" + c.name }), ["trait:Shape", "impl:Square"])
}
