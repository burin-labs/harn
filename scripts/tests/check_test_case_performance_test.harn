import { assert_throws, with_capability_fixtures } from "std/testing"
import {
  aggregate_runs,
  best_metrics,
  evaluate_metrics,
  load_platform_baseline,
  parse_diagnose_output,
  parse_time_output,
  percentile,
  resolve_references,
  time_args,
  validated_baseline_profile,
} from "../check_test_case_performance.harn"
import {
  hosted_mac_profile,
  measured_hosted_mac_profile,
} from "../ci/macos_performance_profile.harn"

@test
pipeline test_hosted_mac_baselines_follow_measured_hardware(harness: Harness) {
  assert_eq(hosted_mac_profile(3, 7516192768), "macos_hosted_arm64")
  assert_eq(hosted_mac_profile(5, 15032385536), "macos_hosted_5core_arm64")
  for hardware in [
    {cores: 0, memory: 0},
    {cores: 3, memory: 15032385536},
    {cores: 5, memory: 7516192768},
    {cores: 8, memory: 15032385536},
  ] {
    assert_eq(hosted_mac_profile(hardware.cores, hardware.memory), nil)
  }
  for output in [
    "3\n7516192768\n1\n",
    "5\n15032385536\n1\n",
    "",
    "5\n",
    "x\ny\n1\n",
    "5\n7516192768\n1\n",
    "5\n15032385536\n0\n",
  ] {
    with_capability_fixtures(
      harness.testing,
      [
        {
          capability: "process",
          method: "run",
          result: {success: true, exit_code: 0, stdout: output, stderr: ""},
        },
      ],
      { ->
        if output == "3\n7516192768\n1\n" {
          assert_eq(measured_hosted_mac_profile(harness.process), "macos_hosted_arm64")
        } else if output == "5\n15032385536\n1\n" {
          assert_eq(measured_hosted_mac_profile(harness.process), "macos_hosted_5core_arm64")
        } else {
          assert_throws({ -> measured_hosted_mac_profile(harness.process) })
        }
      },
    )
  }
  with_capability_fixtures(
    harness.testing,
    [
      {
        capability: "process",
        method: "run",
        result: {success: false, exit_code: 1, stdout: "5\n15032385536\n", stderr: "refused"},
      },
    ],
    { -> assert_throws({ -> measured_hosted_mac_profile(harness.process) }) },
  )
}

type PerformanceWorkflow = {
  jobs: {
    nextest: {
      steps: list<{
        name?: string,
        uses?: string,
        if?: string,
        with?: dict<string, string | bool | int>,
      }>,
    },
  },
}

type BaselineFile = {platform: dict<string, dict>}

fn sample_diag(name: string, setup: int, execute: int) -> string {
  return "[harn test diag] ok ${name} setup=${setup}ms compile=2ms execute=${execute}ms teardown=1ms total=20ms"
}

@test
pipeline test_macos_uploads_nonempty_evidence_after_failed_performance(
  harness: Harness,
  task: unknown,
) {
  const workflow = schema_expect(
    yaml_parse(harness.fs.read_text("../../.github/workflows/macos-nightly.yml")),
    schema_of(PerformanceWorkflow),
  )
  const uploads = workflow.jobs.nextest.steps.filter(
    { step -> step.name == "Upload failed test-case performance evidence" },
  )
    .to_list()
  assert_eq(uploads.count, 1)
  const upload = uploads[0]
  assert_eq(
    upload["if"],
    r"${{ failure() && steps.release-test-case-performance.outcome == 'failure' }}",
  )
  assert(regex_match(r"^actions/upload-artifact@[0-9a-f]{40}$", upload.uses) != nil)
  assert_eq(upload["with"].path, ".harn-runs/test-case-performance/")
  assert_eq(upload["with"]["include-hidden-files"], true)
  assert_eq(upload["with"]["if-no-files-found"], "error")
}

@test
pipeline test_diagnose_parser_requires_exact_lines(harness: Harness, task: unknown) {
  const parsed = parse_diagnose_output(
    sample_diag("alpha", 4, 7)
      + "\nnoise\n[harn test diag] FAIL beta setup=8ms compile=2ms execute=9ms teardown=1ms total=20ms\n",
  )
  assert_eq(parsed.samples.count, 2)
  assert_eq(parsed.samples[0].name, "alpha")
  assert_eq(parsed.samples[0].setup_ms, 4)
  assert_eq(parsed.samples[1].execute_ms, 9)
  assert_eq(parsed.samples[0].module_compile_ms, nil)
  assert_eq(parsed.failures, ["beta"])
}

@test
pipeline test_diagnose_parser_accepts_additive_fields(harness: Harness, task: unknown) {
  const parsed = parse_diagnose_output(
    "[harn test diag] ok perf_0_8 setup=10ms compile=0ms admission=13ms execute=37ms teardown=1ms module_compile=14ms module_load=21ms modules_compiled=5 modules_loaded=5 total=64ms\n",
  )
  assert_eq(parsed.samples.count, 1)
  const sample = parsed.samples[0]
  assert_eq(sample.name, "perf_0_8")
  assert_eq(sample.setup_ms, 10)
  assert_eq(sample.compile_ms, 0)
  assert_eq(sample.execute_ms, 37)
  assert_eq(sample.teardown_ms, 1)
  assert_eq(sample.total_ms, 64)
  assert_eq(sample.admission_ms, 13)
  assert_eq(sample.module_compile_ms, 14)
  assert_eq(sample.module_load_ms, 21)
  assert_eq(sample.modules_compiled, 5)
  assert_eq(sample.modules_loaded, 5)
}

@test
pipeline test_diagnose_parser_rejects_non_diagnostic_selectors(harness: Harness, task: unknown) {
  const parsed = parse_diagnose_output(
    "ok perf_0_8 setup=10ms compile=0ms admission=13ms execute=37ms teardown=1ms total=64ms\n"
      + "[harn test summary] ok perf_0_8 setup=10ms compile=0ms admission=13ms execute=37ms teardown=1ms total=64ms\n",
  )
  assert_eq(parsed.samples, [])
  assert_eq(parsed.failures, [])
}

@test
pipeline test_linux_time_uses_one_explicit_combined_format(harness: Harness, task: unknown) {
  const args = time_args("linux")
  assert_eq(args.count, 2)
  assert_eq(args[0], "-f")
  assert_eq(args.contains("-p"), false)
  assert_eq(args.contains("-v"), false)
  const format = args[1]
  for field in [
    "real %e",
    "user %U",
    "sys %S",
    "Maximum resident set size (kbytes): %M",
    "Major (requiring I/O) page faults: %F",
    "Minor (reclaiming a frame) page faults: %R",
    "Voluntary context switches: %w",
    "Involuntary context switches: %c",
    "File system inputs: %I",
    "File system outputs: %O",
  ] {
    assert_eq(format.contains(field), true)
  }
}

@test
pipeline test_portable_time_parser_reads_gnu_output(harness: Harness, task: unknown) {
  const parsed = parse_time_output(
    "real 0.42\nuser 0.31\nsys 0.17\n\tMaximum resident set size (kbytes): 12345\n\tMajor (requiring I/O) page faults: 2\n\tMinor (reclaiming a frame) page faults: 300\n\tVoluntary context switches: 41\n\tInvoluntary context switches: 5\n\tFile system inputs: 6\n\tFile system outputs: 7\n",
  )
  assert_eq(parsed.ok, true)
  assert_eq(parsed.wall_ms, 420.0)
  assert_eq(parsed.user_ms, 310.0)
  assert_eq(parsed.sys_ms, 170.0)
  assert_eq(parsed.max_rss_kb, 12345)
  assert_eq(parsed.major_faults, 2)
  assert_eq(parsed.minor_faults, 300)
  assert_eq(parsed.voluntary_context_switches, 41)
  assert_eq(parsed.involuntary_context_switches, 5)
  assert_eq(parsed.fs_inputs, 6)
  assert_eq(parsed.fs_outputs, 7)
}

@test
pipeline test_portable_time_parser_reads_bsd_output(harness: Harness, task: unknown) {
  const parsed = parse_time_output(
    "real 0.55\nuser 0.40\nsys 0.20\n  54321  maximum resident set size\n  77  page reclaims\n  3  page faults\n  19  voluntary context switches\n  4  involuntary context switches\n  8  block input operations\n  9  block output operations\n",
  )
  assert_eq(parsed.ok, true)
  assert_eq(parsed.wall_ms, 550.0)
  assert_eq(parsed.max_rss_kb, 53)
  assert_eq(parsed.minor_faults, 77)
  assert_eq(parsed.major_faults, 3)
  assert_eq(parsed.fs_inputs, 8)
  assert_eq(parsed.fs_outputs, 9)
}

@test
pipeline test_portable_time_parser_fails_closed(harness: Harness, task: unknown) {
  assert_eq(parse_time_output("real 1.0\nuser 0.5\n").ok, false)
}

@test
pipeline test_percentile_uses_nearest_rank(harness: Harness, task: unknown) {
  assert_eq(percentile([], 90), 0)
  assert_eq(percentile([1, 2, 3, 4, 5], 50), 3)
  assert_eq(percentile([1, 2, 3, 4, 5], 90), 5)
  assert_eq(percentile([9], 90), 9)
}

@test
pipeline test_aggregate_keeps_parallel_wall_and_sums_cpu(harness: Harness, task: unknown) {
  const first = {
    time: {
      wall_ms: 400.0,
      user_ms: 100.0,
      sys_ms: 50.0,
      max_rss_kb: 100,
      major_faults: 1,
      minor_faults: 10,
      voluntary_context_switches: 3,
      involuntary_context_switches: 2,
      fs_inputs: 4,
      fs_outputs: 5,
    },
    diagnose: {samples: [{setup_ms: 2, execute_ms: 1}, {setup_ms: 8, execute_ms: 4}]},
  }
  const second = {
    time: {
      wall_ms: 500.0,
      user_ms: 200.0,
      sys_ms: 70.0,
      max_rss_kb: 90,
      major_faults: 2,
      minor_faults: 20,
      voluntary_context_switches: 4,
      involuntary_context_switches: 1,
      fs_inputs: 6,
      fs_outputs: 7,
    },
    diagnose: {samples: [{setup_ms: 4, execute_ms: 2}, {setup_ms: 6, execute_ms: 3}]},
  }
  const metrics = aggregate_runs([first, second])
  assert_eq(metrics.max_child_wall_ms, 500.0)
  assert_eq(metrics.sum_user_ms, 300.0)
  assert_eq(metrics.sum_sys_ms, 120.0)
  assert_eq(metrics.setup_p50_ms, 4)
  assert_eq(metrics.setup_p90_ms, 8)
  assert_eq(metrics.execute_p90_ms, 4)
  assert_eq(metrics.test_count, 4)
  assert_eq(metrics.telemetry.max_rss_kb, 100)
  assert_eq(metrics.telemetry.minor_faults, 30)
}

fn baseline() -> dict {
  return {
    regression_x: 2.0,
    warn_utilization: 0.8,
    telemetry_warn_x: 4.0,
    max_child_wall_ms: 400.0,
    sum_user_ms: 300.0,
    sum_sys_ms: 200.0,
    setup_p50_ms: 4.0,
    setup_p90_ms: 8.0,
    execute_p90_ms: 3.0,
    telemetry: {max_rss_kb: 100.0},
  }
}

fn metrics() -> dict {
  return {
    max_child_wall_ms: 500.0,
    sum_user_ms: 400.0,
    sum_sys_ms: 250.0,
    setup_p50_ms: 5.0,
    setup_p90_ms: 9.0,
    execute_p90_ms: 4.0,
    telemetry: {max_rss_kb: 200.0},
  }
}

@test
pipeline test_evaluation_passes_below_multiplicative_and_additive_limits(
  harness: Harness,
  task: unknown,
) {
  const verdict = evaluate_metrics(metrics(), baseline())
  assert_eq(verdict.ok, true)
  assert_eq(verdict.failures, [])
}

@test
pipeline test_evaluation_fails_checked_metric_and_only_warns_telemetry(
  harness: Harness,
  task: unknown,
) {
  const regressed = metrics() + {sum_sys_ms: 401.0, telemetry: {max_rss_kb: 500.0}}
  const verdict = evaluate_metrics(regressed, baseline())
  assert_eq(verdict.ok, false)
  assert_eq(verdict.failures.count, 1)
  assert_eq(verdict.warnings.count, 1)
}

@test
pipeline test_evaluation_rejects_unmeasured_zero_reference(harness: Harness, task: unknown) {
  const verdict = evaluate_metrics(metrics(), baseline() + {setup_p50_ms: 0.0})
  assert_eq(verdict.ok, false)
  assert_eq(verdict.failures.contains("baseline `setup_p50_ms` must be positive"), true)
}

@test
pipeline test_baseline_loader_is_platform_specific_and_versioned(harness: Harness, task: unknown) {
  const text =
    "schema_version = 1\nworkload_version = 1\n[platform.macos]\nmax_child_wall_ms = 12.0\n"
  const found = load_platform_baseline(text, "macos")
  assert_eq(found.ok, true)
  assert_eq(found.baseline.max_child_wall_ms, 12.0)
  assert_eq(load_platform_baseline(text, "linux").ok, false)
  assert_eq(
    load_platform_baseline(text.replace("schema_version = 1", "schema_version = 2"), "macos").ok,
    false,
  )
}

@test
pipeline test_baseline_profile_cannot_cross_platforms(harness: Harness, task: unknown) {
  assert_eq(validated_baseline_profile("macos", nil), {ok: true, profile: "macos", error: ""})
  assert_eq(
    validated_baseline_profile("macos", "macos_hosted_arm64"),
    {ok: true, profile: "macos_hosted_arm64", error: ""},
  )
  const rejected = validated_baseline_profile("macos", "linux")
  assert_eq(rejected.ok, false)
  assert(rejected.error.contains("not compatible with platform `macos`"))
}

@test
pipeline test_best_metrics_takes_the_per_metric_minimum_across_rounds(
  harness: Harness,
  task: unknown,
) {
  const noisy = metrics() + {setup_p90_ms: 40.0, sum_sys_ms: 600.0}
  const clean = metrics() + {max_child_wall_ms: 900.0}
  const best = best_metrics([noisy, clean])
  assert_eq(best.setup_p90_ms, 9.0)
  assert_eq(best.sum_sys_ms, 250.0)
  assert_eq(best.max_child_wall_ms, 500.0)
  assert_eq(best.telemetry.max_rss_kb, 200.0)
}

@test
pipeline test_transient_noise_spike_clears_on_the_re_measured_round(
  harness: Harness,
  task: unknown,
) {
  const spiked = metrics() + {setup_p90_ms: 40.0}
  assert_eq(evaluate_metrics(best_metrics([spiked]), baseline()).ok, false)
  const remeasured = best_metrics([spiked, metrics()])
  assert_eq(evaluate_metrics(remeasured, baseline()).ok, true)
}

@test
pipeline test_persistent_regression_breaches_every_round_and_still_fails(
  harness: Harness,
  task: unknown,
) {
  const regressed = metrics() + {setup_p90_ms: 40.0}
  const verdict = evaluate_metrics(best_metrics([regressed, regressed, regressed]), baseline())
  assert_eq(verdict.ok, false)
  assert_eq(verdict.failures.count, 1)
}

fn sampled_profile(count: int) -> dict {
  let samples = {jobs: range(0, count).to_list()}
  for name in [
    "max_child_wall_ms",
    "sum_user_ms",
    "sum_sys_ms",
    "setup_p50_ms",
    "setup_p90_ms",
    "execute_p90_ms",
  ] {
    samples = samples + {[name]: range(0, count).map({ index -> index + 1 }).to_list()}
  }
  return {regression_x: 2.0, samples: samples}
}

@test
pipeline test_sampled_profile_derives_every_reference_as_the_median(
  harness: Harness,
  task: unknown,
) {
  const resolved = resolve_references(sampled_profile(31))
  assert_eq(resolved.ok, true)
  assert_eq(resolved.baseline.execute_p90_ms, 16.0)
  assert_eq(resolved.baseline.sum_sys_ms, 16.0)
  assert_eq(resolve_references(sampled_profile(32)).baseline.setup_p90_ms, 16.5)
}

@test
pipeline test_sampled_profile_refuses_a_hand_written_reference(harness: Harness, task: unknown) {
  const resolved = resolve_references(sampled_profile(31) + {execute_p90_ms: 27.0})
  assert_eq(resolved.ok, false)
  assert(resolved.error.contains("`execute_p90_ms` is derived from samples"))
}

@test
pipeline test_sampled_profile_refuses_malformed_samples_without_throwing(
  harness: Harness,
  task: unknown,
) {
  const profile = sampled_profile(31)
  const with_samples = { changed -> profile + {samples: profile.samples + changed} }
  const cases = [
    {profile: sampled_profile(29), error: "needs at least 30"},
    {profile: with_samples({setup_p90_ms: [1, 2]}), error: "samples.setup_p90_ms has 2 values"},
    {
      profile: with_samples({execute_p90_ms: ["53"] + range(1, 31).to_list()}),
      error: "samples table is malformed",
    },
    {profile: with_samples({jobs: "114613237276"}), error: "samples table is malformed"},
    {profile: with_samples({max_child_wall_ms: nil}), error: "samples table is malformed"},
  ]
  for case in cases {
    const resolved = resolve_references(case.profile)
    assert_eq(resolved.ok, false)
    assert(resolved.error.contains(case.error), resolved.error)
  }
}

// The hosted macOS job only runs when crates change, so a malformed profile
// edit would otherwise first fail on main's nightly.
@test
pipeline test_every_checked_in_profile_resolves(harness: Harness, task: unknown) {
  const text = harness.fs.read_text("../../bench/test-case-performance/baselines.toml")
  const parsed = schema_expect(toml_parse(text), schema_of(BaselineFile))
  for profile in parsed.platform.keys().sorted() {
    const loaded = load_platform_baseline(text, profile)
    assert_eq(loaded.error, "")
    assert_eq(evaluate_metrics({telemetry: {}}, loaded.baseline).ok, true)
  }
  assert_eq(load_platform_baseline(text, "macos_hosted_arm64").baseline.execute_p90_ms, 53.0)
}
