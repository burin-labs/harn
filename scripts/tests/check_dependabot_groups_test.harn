import "std/schema"
import "../check_dependabot_groups.harn"

type VscodePackageManifest = {
  engines: {vscode: string, ...dict<string, unknown>},
  devDependencies: dict<string, string>,
  ...dict<string, unknown>,
}

type VscodePackageLock = {packages: dict<string, unknown>, ...dict<string, unknown>}

type VscodePackageLockManifest = {devDependencies: dict<string, string>, ...dict<string, unknown>}

type VscodePackageLockResolution = {version: string, ...dict<string, unknown>}

fn group(patterns: list<string>, excludes: list<string> = [], updates: list<string> = []) {
  return {patterns: patterns, exclude_patterns: excludes, update_types: updates}
}

/** One update entry, the unit `ecosystem_errors` checks. */
fn entry(ecosystem: string, groups: any, directories: list<string> = ["/"]) -> EcosystemGroups {
  return {ecosystem: ecosystem, directories: directories, groups: groups, ignores: []}
}

fn yaml(lines: list<string>) -> string {
  return lines.join("\n") + "\n"
}

/** The update entry covering `directory`, so a test can name one. */
fn entry_for(entries: list<EcosystemGroups>, ecosystem: string, directory: string = "/") {
  for candidate in entries {
    if candidate.ecosystem == ecosystem && candidate.directories.contains(directory) {
      return candidate
    }
  }
  throw "no ${ecosystem} entry covers ${directory}"
}

/** The groups of the entry covering `directory`, so a test can name one. */
fn groups_for(entries: list<EcosystemGroups>, ecosystem: string, directory: string = "/") {
  return entry_for(entries, ecosystem, directory).groups
}

fn cargo_policy() {
  return {
    families: {
      cranelift: ["cranelift-codegen"],
      wasmtime: ["wasmtime", "wasmtime-wasi"],
      opentelemetry: ["opentelemetry", "tracing-opentelemetry"],
    },
    catch_all_update_types: ["minor", "patch"],
  }
}

/** The shape the policy describes: named families plus a bounded catch-all. */
fn valid_groups() {
  return {
    cranelift: group(["cranelift-*"]),
    wasmtime: group(["wasmtime*"]),
    opentelemetry: group(["opentelemetry*", "tracing-opentelemetry"]),
    "cargo-minor-patch": group(
      ["*"],
      ["cranelift-*", "wasmtime*", "opentelemetry*", "tracing-opentelemetry"],
      ["minor", "patch"],
    ),
  }
}

@test
pipeline test_actual_dependabot_document(harness: Harness, task: unknown) {
  const text = harness.fs.read_text("../../.github/dependabot.yml")
  const entries = groups_from_text(text)
  const package = schema_expect(
    json_parse(harness.fs.read_text("../../editors/vscode/package.json")),
    schema_of(VscodePackageManifest),
  )
  const lock = schema_expect(
    json_parse(harness.fs.read_text("../../editors/vscode/package-lock.json")),
    schema_of(VscodePackageLock),
  )
  const lock_manifest = schema_expect(lock.packages.get(""), schema_of(VscodePackageLockManifest))
  const lock_resolution = schema_expect(
    lock.packages.get("node_modules/@types/vscode"),
    schema_of(VscodePackageLockResolution),
  )
  assert_eq(group_errors(entries), [])
  // The extension may compile only against the oldest VS Code API it claims
  // to support. Dependabot cannot move that API surface independently.
  assert_eq(
    vscode_api_contract_errors(
      {
        engine_range: package.engines.vscode,
        manifest_types: package.devDependencies.get("@types/vscode"),
        lock_manifest_types: lock_manifest.devDependencies.get("@types/vscode"),
        lock_resolved_types: lock_resolution.version,
        dependabot_ignored: dependabot_ignores(
          entry_for(entries, "npm", "/editors/vscode"),
          "@types/vscode",
        ),
      },
    ),
    [],
  )
  // A routine dependency lands in the batch rather than opening its own PR.
  assert_eq(matching_groups(groups_for(entries, "cargo"), "serde"), ["cargo-minor-patch"])
  assert_eq(matching_groups(groups_for(entries, "npm"), "vite"), ["npm-minor-patch"])
  // A named family stays reviewable on its own.
  assert_eq(matching_groups(groups_for(entries, "cargo"), "wasmtime-wasi"), ["wasmtime"])
  assert_eq(matching_groups(groups_for(entries, "npm"), "react-dom"), ["react-runtime"])
  // Parser runtime and grammars leave the batch together: a bump to either is
  // answerable only by the corpus result, and in the catch-all one grammar
  // question blocks every unrelated crate in the same PR (#6205, #6240).
  assert_eq(matching_groups(groups_for(entries, "cargo"), "tree-sitter"), ["tree-sitter"])
  assert_eq(matching_groups(groups_for(entries, "cargo"), "tree-sitter-swift"), ["tree-sitter"])
  assert_eq(matching_groups(groups_for(entries, "cargo"), "tree-sitter-kotlin-ng"), ["tree-sitter"])
  // The npm entry governs the nested package directories too, not just the root.
  assert_eq(
    matching_groups(groups_for(entries, "npm", "/editors/vscode"), "react-dom"),
    ["react-runtime"],
  )
}

@test
pipeline test_vscode_types_cannot_exceed_the_engine_minimum(harness: Harness, task: unknown) {
  const errors = vscode_api_contract_errors(
    {
      engine_range: "^1.125.0",
      manifest_types: "1.134.0",
      lock_manifest_types: "1.134.0",
      lock_resolved_types: "1.134.0",
      dependabot_ignored: true,
    },
  )
  assert_eq(errors.count, 3)
  assert_eq(errors.all({ error -> error.contains("engine minimum") }), true)
}

@test
pipeline test_vscode_types_ignore_is_required(harness: Harness, task: unknown) {
  assert_eq(
    vscode_api_contract_errors(
      {
        engine_range: "^1.125.0",
        manifest_types: "1.125.0",
        lock_manifest_types: "1.125.0",
        lock_resolved_types: "1.125.0",
        dependabot_ignored: false,
      },
    ),
    ["Dependabot must ignore @types/vscode"],
  )
}

@test
pipeline test_wildcard_positions(harness: Harness, task: unknown) {
  assert_eq(dependabot_pattern_matches("wasmtime*", "wasmtime-wasi"), true)
  assert_eq(dependabot_pattern_matches("*-wasi", "wasmtime-wasi"), true)
  assert_eq(dependabot_pattern_matches("wasm*-wasi", "wasmtime-wasi"), true)
  assert_eq(dependabot_pattern_matches("wasm*-wasi", "wasmtime"), false)
}

@test
pipeline test_overlap_is_rejected(harness: Harness, task: unknown) {
  const groups = valid_groups() + {wasi: group(["*-wasi"])}
  const errors = ecosystem_errors(entry("cargo", groups), cargo_policy())
  assert_eq(
    errors.filter({ error -> error.kind == "ambiguous_membership" }),
    [
      {
        kind: "ambiguous_membership",
        ecosystem: "cargo",
        directories: ["/"],
        group: "wasmtime",
        dependency: "wasmtime-wasi",
        matches: ["wasi", "wasmtime"],
      },
    ],
  )
}

@test
pipeline test_missing_group_is_rejected(harness: Harness, task: unknown) {
  const errors = ecosystem_errors(
    entry("cargo", {cranelift: valid_groups().cranelift}),
    cargo_policy(),
  )
  assert_eq(
    errors.filter({ error -> error.kind == "missing_group" }).map({ error -> error.group }),
    ["opentelemetry", "wasmtime"],
  )
}

/**
 * The catch-all is the point of the grouping policy — without one, every
 * routine minor/patch bump opens its own PR and walks the merge queue alone.
 * Regression for #6015.
 */
@test
pipeline test_a_missing_catch_all_is_rejected(harness: Harness, task: unknown) {
  const all = valid_groups()
  const groups = {
    cranelift: all.cranelift,
    wasmtime: all.wasmtime,
    opentelemetry: all.opentelemetry,
  }
  const errors = ecosystem_errors(entry("cargo", groups), cargo_policy())
  assert_eq(
    errors,
    [
      {
        kind: "missing_catch_all",
        ecosystem: "cargo",
        directories: ["/"],
        group: "",
        dependency: "",
        matches: [],
      },
    ],
  )
}

/**
 * A catch-all that also swept majors would batch a breaking API change with
 * routine bumps, so the batch could not be reviewed or reverted as one unit.
 */
@test
pipeline test_a_catch_all_that_takes_majors_is_rejected(harness: Harness, task: unknown) {
  const groups = valid_groups()
    + {"cargo-minor-patch": group(["*"], [], ["major", "minor", "patch"])}
  const errors = ecosystem_errors(entry("cargo", groups), cargo_policy())
  assert_eq(
    errors.filter({ error -> error.kind == "catch_all_update_types" }).map(
      { error -> error.matches },
    ),
    [["major", "minor", "patch"]],
  )
}

/**
 * Membership must not depend on which group happens to come first. GitHub
 * resolves an overlap by file order, but `yaml_parse` sorts, so the checker
 * cannot see file order — a catch-all that does not exclude the families is
 * indistinguishable here from one that swallows them.
 */
@test
pipeline test_a_catch_all_without_excludes_is_rejected(harness: Harness, task: unknown) {
  const groups = valid_groups() + {"cargo-minor-patch": group(["*"], [], ["minor", "patch"])}
  const errors = ecosystem_errors(entry("cargo", groups), cargo_policy())
  assert_eq(
    errors.filter({ error -> error.kind == "ambiguous_membership" }).map(
      { error -> error.dependency },
    ),
    ["cranelift-codegen", "opentelemetry", "tracing-opentelemetry", "wasmtime", "wasmtime-wasi"],
  )
}

/** A new ecosystem must declare its policy rather than inherit silence. */
@test
pipeline test_an_undeclared_ecosystem_is_rejected(harness: Harness, task: unknown) {
  const errors = group_errors([entry("pip", {})], {cargo: cargo_policy()})
  assert_eq(
    errors,
    [
      {
        kind: "unknown_ecosystem",
        ecosystem: "pip",
        directories: ["/"],
        group: "",
        dependency: "",
        matches: [],
      },
    ],
  )
}

/** Action majors are runner-baseline bumps, so that catch-all takes them too. */
@test
pipeline test_github_actions_groups_majors_too(harness: Harness, task: unknown) {
  const policy = {families: {}, catch_all_update_types: []}
  assert_eq(ecosystem_errors(entry("github-actions", {actions: group(["*"])}), policy), [])
  assert_eq(
    ecosystem_errors(entry("github-actions", {actions: group(["*"], [], ["minor"])}), policy).map(
      { error -> error.kind },
    ),
    ["catch_all_update_types"],
  )
}

@test
pipeline test_yaml_boundary_rejects_malformed_groups(harness: Harness, task: unknown) {
  const invalid = yaml(
    [
      "version: 2",
      "updates:",
      "  - package-ecosystem: cargo",
      "    directory: \"/\"",
      "    groups:",
      "      wasmtime:",
      "        patterns: wasmtime*",
    ],
  )
  assert_eq(
    is_err(
      try {
        groups_from_text(invalid)
      },
    ),
    true,
  )
}

/**
 * One ecosystem may appear once per package directory. A monorepo publishing a
 * dashboard and an SDK wants different families and different reviewers for
 * each, and collapsing them onto `package-ecosystem` alone made that
 * unrepresentable.
 */
@test
pipeline test_one_ecosystem_may_repeat_across_directories(harness: Harness, task: unknown) {
  const text = yaml(
    [
      "version: 2",
      "updates:",
      "  - package-ecosystem: npm",
      "    directory: \"/dashboard\"",
      "    groups:",
      "      react-runtime:",
      "        patterns:",
      "          - \"react\"",
      "          - \"react-dom\"",
      "      npm-minor-patch:",
      "        patterns:",
      "          - \"*\"",
      "        exclude-patterns:",
      "          - \"react\"",
      "          - \"react-dom\"",
      "        update-types:",
      "          - \"minor\"",
      "          - \"patch\"",
      "  - package-ecosystem: npm",
      "    directory: \"/sdks/typescript\"",
      "    groups:",
      "      npm-minor-patch:",
      "        patterns:",
      "          - \"*\"",
      "        update-types:",
      "          - \"minor\"",
      "          - \"patch\"",
    ],
  )
  const entries = groups_from_text(text)
  assert_eq(
    entries.map({ candidate -> candidate.directories }),
    [["/dashboard"], ["/sdks/typescript"]],
  )
  // Each entry is checked against the policy on its own terms: the SDK has no
  // React to keep separate, so its missing family is the only complaint.
  const policy = {
    families: {"react-runtime": ["react", "react-dom"]},
    catch_all_update_types: ["minor", "patch"],
  }
  assert_eq(
    group_errors(entries, {npm: policy}).map(
      { error -> "${group_error_scope(error)} ${error.kind}" },
    ),
    [
      "npm (/sdks/typescript) missing_group",
      "npm (/sdks/typescript) ambiguous_membership",
      "npm (/sdks/typescript) ambiguous_membership",
    ],
  )
}

/** Two entries claiming one directory leave no answer for who governs it. */
@test
pipeline test_two_entries_for_one_directory_are_rejected(harness: Harness, task: unknown) {
  const duplicated = yaml(
    [
      "version: 2",
      "updates:",
      "  - package-ecosystem: cargo",
      "    directories:",
      "      - \"/\"",
      "      - \"/crates\"",
      "    groups:",
      "      a:",
      "        patterns:",
      "          - \"x\"",
      "  - package-ecosystem: cargo",
      "    directory: \"/crates\"",
      "    groups:",
      "      b:",
      "        patterns:",
      "          - \"y\"",
    ],
  )
  assert_eq(
    is_err(
      try {
        groups_from_text(duplicated)
      },
    ),
    true,
  )
}

/** An entry has to say what it covers, in exactly one of the two spellings. */
@test
pipeline test_an_entry_must_name_its_directories(harness: Harness, task: unknown) {
  const missing = yaml(["version: 2", "updates:", "  - package-ecosystem: cargo"])
  assert_eq(
    is_err(
      try {
        groups_from_text(missing)
      },
    ),
    true,
  )
  const both = yaml(
    [
      "version: 2",
      "updates:",
      "  - package-ecosystem: cargo",
      "    directory: \"/\"",
      "    directories:",
      "      - \"/crates\"",
    ],
  )
  assert_eq(
    is_err(
      try {
        groups_from_text(both)
      },
    ),
    true,
  )
}
