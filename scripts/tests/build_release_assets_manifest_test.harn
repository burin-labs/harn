// Tests for scripts/build_release_assets_manifest.harn — exercise the pure
// helpers on synthetic inputs (no filesystem dependency). The host-backed
// archive hashing/sizing and write are covered by the end-to-end parity run.
import "../build_release_assets_manifest.harn"

@test
pipeline test_target_triples_order(task) {
  // Insertion order must match the Python TARGETS dict so unsorted `missing`
  // accumulates in the same order before the final sort.
  assert_eq(
    target_triples(),
    [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
    ],
  )
}

@test
pipeline test_target_meta_darwin(task) {
  const m = target_meta("aarch64-apple-darwin")
  assert_eq(m.filename, "harn-aarch64-apple-darwin.tar.gz")
  assert_eq(m.format, "tar.gz")
  assert_eq(m.binaries, ["harn", "harn-dap", "harn-lsp"])
}

@test
pipeline test_target_meta_linux_has_container_probe(task) {
  const m = target_meta("x86_64-unknown-linux-gnu")
  assert_eq(m.binaries, ["harn", "harn-dap", "harn-lsp", "harn-container-probe"])
}

@test
pipeline test_target_meta_windows_zip_exe(task) {
  const m = target_meta("x86_64-pc-windows-msvc")
  assert_eq(m.filename, "harn-x86_64-pc-windows-msvc.zip")
  assert_eq(m.format, "zip")
  assert_eq(m.binaries, ["harn.exe", "harn-dap.exe", "harn-lsp.exe"])
}

@test
pipeline test_target_meta_unknown_is_nil(task) {
  assert_eq(target_meta("riscv64-unknown-linux-gnu"), nil)
}

@test
pipeline test_strip_leading_v(task) {
  // Single, multiple, none, and all-v cases mirror Python `lstrip("v")`.
  assert_eq(strip_leading_v("v0.8.21"), "0.8.21")
  assert_eq(strip_leading_v("vvv9.9"), "9.9")
  assert_eq(strip_leading_v("1.2.3"), "1.2.3")
  assert_eq(strip_leading_v("vvv"), "")
  assert_eq(strip_leading_v(""), "")
  // Only LEADING v's are stripped; an interior v is kept.
  assert_eq(strip_leading_v("v1v2"), "1v2")
}

@test
pipeline test_posix_path_str_basic(task) {
  assert_eq(posix_path_str("out.json"), "out.json")
  assert_eq(posix_path_str("./out.json"), "out.json")
  assert_eq(posix_path_str("a//b"), "a/b")
  assert_eq(posix_path_str("a/./b"), "a/b")
  assert_eq(posix_path_str("/abs/x"), "/abs/x")
  assert_eq(posix_path_str("a/b/"), "a/b")
  assert_eq(posix_path_str("./"), ".")
  assert_eq(posix_path_str("."), ".")
}

@test
pipeline test_posix_path_str_keeps_dotdot(task) {
  // `..` is preserved (not collapsed) exactly like PurePosixPath.
  assert_eq(posix_path_str("a/../b"), "a/../b")
  assert_eq(posix_path_str("foo//./bar"), "foo/bar")
  assert_eq(posix_path_str("/tmp/sub/../out.json"), "/tmp/sub/../out.json")
}

@test
pipeline test_join_path(task) {
  assert_eq(join_path("artifacts", "harn-x.tar.gz"), "artifacts/harn-x.tar.gz")
  assert_eq(join_path("./artifacts", "f.zip"), "artifacts/f.zip")
  assert_eq(join_path("/tmp/arts", "f.tar.gz"), "/tmp/arts/f.tar.gz")
  // A bare "." directory yields just the filename, matching `Path(".") / f`.
  assert_eq(join_path(".", "f.json"), "f.json")
  assert_eq(join_path("a//b", "f"), "a/b/f")
}

@test
pipeline test_asset_record_shape(task) {
  const base = "https://github.com/burin-labs/harn/releases/download/v0.8.21"
  const rec = asset_record("aarch64-apple-darwin", base, "deadbeef", 1234)
  assert_eq(rec.filename, "harn-aarch64-apple-darwin.tar.gz")
  assert_eq(rec.url, base + "/harn-aarch64-apple-darwin.tar.gz")
  assert_eq(rec.sha256, "deadbeef")
  assert_eq(rec.size, 1234)
  assert_eq(rec.format, "tar.gz")
  assert_eq(rec.binaries, ["harn", "harn-dap", "harn-lsp"])
}

@test
pipeline test_missing_message_sorts(task) {
  // Accumulation order is TARGETS order; the message sorts before joining.
  const missing = [
    "harn-x86_64-pc-windows-msvc.zip",
    "harn-aarch64-apple-darwin.tar.gz",
    "harn-x86_64-apple-darwin.tar.gz",
  ]
  assert_eq(
    missing_message(missing),
    "release-assets manifest is missing required archives: harn-aarch64-apple-darwin.tar.gz, harn-x86_64-apple-darwin.tar.gz, harn-x86_64-pc-windows-msvc.zip",
  )
}

@test
pipeline test_missing_message_single(task) {
  assert_eq(
    missing_message(["harn-x86_64-pc-windows-msvc.zip"]),
    "release-assets manifest is missing required archives: harn-x86_64-pc-windows-msvc.zip",
  )
}

@test
pipeline test_build_manifest_shape(task) {
  const assets = {"aarch64-apple-darwin": {filename: "harn-aarch64-apple-darwin.tar.gz"}}
  const m = build_manifest("0.8.21", "v0.8.21", "https://x/tag", assets)
  assert_eq(m.version, "0.8.21")
  assert_eq(m.tag, "v0.8.21")
  assert_eq(m.release_url, "https://x/tag")
  assert_eq(m.assets, assets)
}

@test
pipeline test_full_manifest_json_byte_format(task) {
  // End-to-end of the pure assembly + serialization: the JSON must match
  // Python `json.dumps(indent=2, sort_keys=True)` (sorted keys, 2-space
  // indent, expanded lists). This locks the on-disk byte format.
  const base = "https://github.com/burin-labs/harn/releases/download/v0.8.21"
  let assets: any = {}
  assets = {...assets, "aarch64-apple-darwin": asset_record("aarch64-apple-darwin", base, "aaa", 100)}
  const manifest = build_manifest(
    "0.8.21",
    "v0.8.21",
    "https://github.com/burin-labs/harn/releases/tag/v0.8.21",
    assets,
  )
  const expected = "{\n  \"assets\": {\n    \"aarch64-apple-darwin\": {\n      \"binaries\": [\n        \"harn\",\n        \"harn-dap\",\n        \"harn-lsp\"\n      ],\n      \"filename\": \"harn-aarch64-apple-darwin.tar.gz\",\n      \"format\": \"tar.gz\",\n      \"sha256\": \"aaa\",\n      \"size\": 100,\n      \"url\": \"https://github.com/burin-labs/harn/releases/download/v0.8.21/harn-aarch64-apple-darwin.tar.gz\"\n    }\n  },\n  \"release_url\": \"https://github.com/burin-labs/harn/releases/tag/v0.8.21\",\n  \"tag\": \"v0.8.21\",\n  \"version\": \"0.8.21\"\n}"
  assert_eq(json_stringify_pretty(manifest), expected)
}

@test
pipeline test_help_text_starts_with_usage(task) {
  const h = help_text()
  assert_eq(
    h.starts_with("usage: build_release_assets_manifest.py [-h] --artifacts-dir ARTIFACTS_DIR"),
    true,
  )
  assert_eq(h.contains("Emit `release-assets.json` for a Harn GitHub release."), true)
  assert_eq(h.contains("-h, --help            show this help message and exit"), true)
}

@test
pipeline test_parse_args_success(task) {
  const p = parse_args(["--artifacts-dir", "arts", "--tag", "v1", "--output", "o.json"])
  assert_eq(p.help, false)
  assert_eq(p.error, nil)
  assert_eq(p.artifacts_dir, "arts")
  assert_eq(p.tag, "v1")
  assert_eq(p.output, "o.json")
}

@test
pipeline test_parse_args_equals_syntax(task) {
  const p = parse_args(["--artifacts-dir=arts", "--tag=v1", "--output=o.json"])
  assert_eq(p.error, nil)
  assert_eq(p.artifacts_dir, "arts")
  assert_eq(p.tag, "v1")
  assert_eq(p.output, "o.json")
}

@test
pipeline test_parse_args_duplicate_last_wins(task) {
  const p = parse_args(["--artifacts-dir", "arts", "--tag", "v1", "--tag", "v2", "--output", "o"])
  assert_eq(p.error, nil)
  assert_eq(p.tag, "v2")
}

@test
pipeline test_parse_args_help_flag(task) {
  assert_eq(parse_args(["-h"]).help, true)
  assert_eq(parse_args(["--help"]).help, true)
  // Help wins even when other args are present (argparse short-circuits).
  assert_eq(parse_args(["--tag", "v1", "-h"]).help, true)
}

@test
pipeline test_parse_args_missing_all_required(task) {
  const p = parse_args([])
  assert_eq(p.help, false)
  assert_eq(p.error, "the following arguments are required: --artifacts-dir, --tag, --output")
}

@test
pipeline test_parse_args_missing_some_required_in_decl_order(task) {
  // Only --tag given → the other two are reported in declaration order.
  const p = parse_args(["--tag", "v1"])
  assert_eq(p.error, "the following arguments are required: --artifacts-dir, --output")
}

@test
pipeline test_parse_args_missing_beats_unrecognized(task) {
  // When BOTH a required arg is missing AND there are extras, argparse
  // reports the missing-required error first.
  const p = parse_args(["--bogus", "xyz"])
  assert_eq(p.error, "the following arguments are required: --artifacts-dir, --tag, --output")
}

@test
pipeline test_parse_args_unrecognized_when_required_present(task) {
  const p = parse_args(["--artifacts-dir", "a", "--tag", "v1", "--output", "o", "--bogus"])
  assert_eq(p.error, "unrecognized arguments: --bogus")
}

@test
pipeline test_parse_args_positional_is_unrecognized(task) {
  const p = parse_args(["foo", "--artifacts-dir", "a", "--tag", "v1", "--output", "o"])
  assert_eq(p.error, "unrecognized arguments: foo")
}

@test
pipeline test_parse_args_dangling_value(task) {
  // A required flag with no following value → "expected one argument".
  const p = parse_args(["--tag"])
  assert_eq(p.error, "argument --tag: expected one argument")
}
