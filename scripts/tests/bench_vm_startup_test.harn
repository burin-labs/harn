import "../bench_vm_startup.harn"

@test
pipeline test_parse_positive_int(task) {
  assert_eq(parse_positive_int("--runs", "3").value, 3)
  assert_eq(parse_positive_int("--runs", "0").ok, false)
  assert_eq(parse_positive_int("--runs", "wat").error, "--runs must be an integer, got 'wat'")
}

@test
pipeline test_summarize_samples(task) {
  const summary = summarize_samples([10.0, 25.0, 15.0])
  assert_eq(summary.min_ms, 10.0)
  assert_eq(summary.avg_ms, 50.0 / 3.0)
  assert_eq(summary.max_ms, 25.0)
}

@test
pipeline test_summary_row_formats_three_decimals(task) {
  assert_eq(summary_row({min_ms: 1.2, avg_ms: 3.4567, max_ms: 10.0}), "1.200 3.457 10.000")
}
