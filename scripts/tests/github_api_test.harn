import {
  GitHubApiAdapters,
  GitHubApiAttempt,
  github_api_failure_kind,
  github_api_json_result,
  github_api_json_with_retry,
} from "../github_api.harn"

type RecordedGitHubCalls = list<{method: string, args: list<unknown>}>

fn command_capture(stdout: string, truncated: bool) -> dict {
  return {
    status: "completed",
    exit_code: 0,
    cwd: "",
    stdout: stdout,
    stderr: "",
    stdout_truncated: truncated,
    stderr_truncated: false,
    stdout_path: "fixture.stdout",
    stderr_path: "fixture.stderr",
    byte_count: 11,
    timed_out: false,
  }
}

pipeline test_github_api_uses_the_command_owner_and_reads_complete_truncated_output(
  harness: Harness,
) {
  for truncated in [false, true] {
    harness.testing.clear()
    harness.testing.respond(
      "tools",
      "run_command",
      command_capture(
        if truncated {
          "{"
        } else {
          "{\"known\":1}"
        },
        truncated,
      ),
    )
    harness.testing.respond(
      "tools",
      "read_command_output",
      {
        content: "{\"known\":1}",
        total_bytes: 11,
        offset: 0,
        bytes_read: 11,
        eof: true,
        path: "fixture.stdout",
      },
    )
    const receipt = github_api_json_result(harness.tools, harness.clock, "/repos/o/r")
    assert_eq(receipt.ok, true)
    assert_eq(receipt.value, {known: 1})
    const calls: RecordedGitHubCalls = schema_expect(
      harness.testing.calls(),
      schema_of(RecordedGitHubCalls),
    )
    assert_eq(
      len(calls),
      if truncated {
        2
      } else {
        1
      },
    )
    assert_eq(calls[0]?.method, "run_command")
    assert_eq(calls[0]?.args, [{mode: "argv", argv: ["gh", "api", "repos/o/r"], timeout_ms: 30000}])
    if truncated {
      assert_eq(calls[1]?.method, "read_command_output")
      assert_eq(calls[1]?.args, [{path: "fixture.stdout", offset: 0, length: 11}])
    }
  }
}

pipeline test_github_api_refuses_missing_partial_or_foreign_command_artifacts(harness: Harness) {
  for output in [
    {},
    {
      content: "{\"known\":1}",
      total_bytes: 11,
      offset: 0,
      bytes_read: 10,
      eof: false,
      path: "fixture.stdout",
    },
    {
      content: "{\"known\":1}",
      total_bytes: 11,
      offset: 1,
      bytes_read: 11,
      eof: true,
      path: "fixture.stdout",
    },
    {
      content: "{\"known\":1}",
      total_bytes: 11,
      offset: 0,
      bytes_read: 11,
      eof: true,
      path: "other.stdout",
    },
  ] {
    harness.testing.clear()
    harness.testing.respond("tools", "run_command", command_capture("{", true))
    harness.testing.respond("tools", "read_command_output", output)
    const result = try {
      github_api_json_result(harness.tools, harness.clock, "repos/o/r")
    }
    assert_eq(is_err(result), true)
    const calls: RecordedGitHubCalls = schema_expect(
      harness.testing.calls(),
      schema_of(RecordedGitHubCalls),
    )
    assert_eq(len(calls), 2)
    assert_eq(calls[1]?.method, "read_command_output")
  }
}

fn failed(detail: string) -> GitHubApiAttempt {
  return {success: false, stdout: "", stderr: detail, timed_out: false}
}

pipeline test_github_api_retries_known_transport_failures() {
  for detail in [
    "tls: failed to verify certificate: x509: certificate is not valid",
    "gh: HTTP 502\n",
    "gh: HTTP 503\n",
    "gh: HTTP 504\n",
  ] {
    let attempts = [
      failed(detail),
      {success: true, stdout: "{\"ok\":true}", stderr: "", timed_out: false},
    ]
    let waits: list<int> = []
    const adapters: GitHubApiAdapters = {
      request: { _path ->
        const next = attempts[0] ?? failed("fixture exhausted")
        attempts = attempts[1:]
        return next
      },
      wait: { delay_ms -> waits = waits + [delay_ms] },
    }
    const receipt = github_api_json_with_retry(
      adapters,
      "/repos/burin-labs/harn/actions/runs/1/jobs",
      {max_attempts: 3, delay_ms: 25},
    )
    assert_eq(receipt.ok, true)
    assert_eq(receipt.attempts, 2)
    assert_eq(receipt.value?.ok, true)
    assert_eq(waits, [25])
  }
}

pipeline test_github_api_retries_a_reset_http2_stream(task: unknown) {
  assert_eq(
    github_api_failure_kind(
      failed("GitHub API request failed: stream error: stream ID 1; CANCEL; received from peer"),
    ),
    "transient_transport",
  )
  assert_eq(github_api_failure_kind(failed("gh: Server Error (HTTP 502)")), "transient_transport")
  assert_eq(github_api_failure_kind(failed("gh: Server Error (HTTP 500)")), "command")
}

pipeline test_github_api_fails_closed_after_bounded_transport_retries(task: unknown) {
  let request_count = 0
  const adapters: GitHubApiAdapters = {
    request: { _path ->
      request_count = request_count + 1
      return failed("gh: HTTP 503\n")
    },
    wait: { _delay_ms -> nil },
  }
  const receipt = github_api_json_with_retry(
    adapters,
    "/repos/burin-labs/harn/actions/runs/1/jobs",
    {max_attempts: 3, delay_ms: 0},
  )
  assert_eq(receipt.ok, false)
  assert_eq(receipt.attempts, 3)
  assert_eq(receipt.failure_kind, "transient_transport")
  assert_eq(request_count, 3)
}

pipeline test_github_api_does_not_retry_semantic_or_malformed_responses(task: unknown) {
  assert_eq(github_api_failure_kind(failed("gh: Not Found (HTTP 404)")), "command")
  for detail in [
    "gh: HTTP 403",
    "gh: HTTP 429",
    "gh: HTTP 500",
    "gh: HTTP 5030",
    "echo gh: HTTP 503",
  ] {
    assert_eq(github_api_failure_kind(failed(detail)), "command")
  }
  // A stream error the client raised itself is not a server reset.
  assert_eq(github_api_failure_kind(failed("stream error: unknown")), "command")
  let request_count = 0
  const adapters: GitHubApiAdapters = {
    request: { _path ->
      request_count = request_count + 1
      return {success: true, stdout: "not-json", stderr: "", timed_out: false}
    },
    wait: { _delay_ms -> nil },
  }
  const receipt = github_api_json_with_retry(
    adapters,
    "/repos/burin-labs/harn/actions/runs/1/jobs",
    {max_attempts: 3, delay_ms: 0},
  )
  assert_eq(receipt.ok, false)
  assert_eq(receipt.failure_kind, "invalid_json")
  assert_eq(request_count, 1)
  const null_receipt = github_api_json_with_retry(
    {
      request: { _path -> return {success: true, stdout: "null", stderr: "", timed_out: false} },
      wait: { _delay_ms -> nil },
    },
    "/repos/burin-labs/harn/nullable",
    {max_attempts: 3, delay_ms: 0},
  )
  assert_eq(null_receipt.ok, true)
  assert_eq(null_receipt.attempts, 1)
}
