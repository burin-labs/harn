// Tests for scripts/check_docs_cli_flags.harn — drive the pure block /
// tokenizer / help-parsing helpers, and the analyzer with an injected
// fake `--help` fetcher (no subprocess or filesystem dependency).
import "../check_docs_cli_flags.harn"

// --- bash_blocks ------------------------------------------------------------
@test
pipeline test_bash_blocks_basic(task) {
  let md = "intro\n```bash\nharn run x\n```\n```sh\nharn lint y\n```\n```python\nnope\n```\n"
  let blocks = bash_blocks(md)
  assert_eq(blocks.count, 2)
  assert_eq(blocks[0].first_line, 3)
  assert_eq(blocks[0].lines, ["harn run x"])
  assert_eq(blocks[1].lines, ["harn lint y"])
}

@test
pipeline test_bash_blocks_info_string_exact(task) {
  // ```bash with trailing text is not a tracked block.
  assert_eq(bash_blocks("```bash title\nharn run x\n```\n"), [])
}

// --- logical_lines ----------------------------------------------------------
@test
pipeline test_logical_lines_plain(task) {
  let out = logical_lines(["harn run a", "harn run b"], 10)
  assert_eq(out.count, 2)
  assert_eq(out[0].line_no, 10)
  assert_eq(out[0].command, "harn run a")
  assert_eq(out[1].line_no, 11)
}

@test
pipeline test_logical_lines_continuation(task) {
  let out = logical_lines(["harn run x \\", "  --flag value"], 5)
  assert_eq(out.count, 1)
  assert_eq(out[0].line_no, 5)
  assert_eq(out[0].command, "harn run x    --flag value")
}

@test
pipeline test_logical_lines_allow_stale_any_physical_line(task) {
  let out = logical_lines(["harn run x \\", "  --old # harn-doc-cli: allow-stale"], 1)
  assert_eq(out.count, 1)
  assert_eq(out[0].allow_stale, true)
}

@test
pipeline test_logical_lines_trailing_continuation_flushes(task) {
  let out = logical_lines(["harn run x \\"], 1)
  assert_eq(out.count, 1)
  // The pre-backslash spacing survives, like Python's rstrip()[:-1].
  assert_eq(out[0].command, "harn run x ")
}

// --- shell_tokens -----------------------------------------------------------
@test
pipeline test_tokens_basic(task) {
  assert_eq(shell_tokens("harn run --json x.harn"), ["harn", "run", "--json", "x.harn"])
}

@test
pipeline test_tokens_separators_padded(task) {
  assert_eq(shell_tokens("harn a&&harn b|grep c"), ["harn", "a", "&&", "harn", "b", "|", "grep", "c"])
}

@test
pipeline test_tokens_quotes(task) {
  assert_eq(shell_tokens("harn run 'a b' \"c d\""), ["harn", "run", "a b", "c d"])
  // Adjacent quoted/unquoted parts are one token.
  assert_eq(shell_tokens("pre'fix'post"), ["prefixpost"])
}

@test
pipeline test_tokens_comment_strips_rest(task) {
  assert_eq(shell_tokens("harn run x # trailing note"), ["harn", "run", "x"])
}

@test
pipeline test_tokens_unclosed_quote_is_error(task) {
  assert_eq(shell_tokens("harn run \"unclosed"), nil)
  assert_eq(shell_tokens("harn run 'unclosed"), nil)
}

@test
pipeline test_tokens_escapes(task) {
  // Outside quotes a backslash escapes anything; inside double quotes it
  // only escapes `"` and `\` and stays literal otherwise.
  assert_eq(shell_tokens(r"a\ b"), ["a b"])
  assert_eq(shell_tokens(r#""a\"b""#), [r#"a"b"#])
  assert_eq(shell_tokens(r#""a\nb""#), [r"a\nb"])
}

@test
pipeline test_tokens_empty_quoted_token(task) {
  assert_eq(shell_tokens("harn run ''"), ["harn", "run", ""])
}

// --- command_segments / find_harn_segment -----------------------------------
@test
pipeline test_segments_split(task) {
  let segs = command_segments(["a", "&&", "b", "c", ";", ";", "d"])
  assert_eq(segs, [["a"], ["b", "c"], ["d"]])
}

@test
pipeline test_find_harn_segment_forms(task) {
  assert_eq(find_harn_segment(["harn", "run", "x"]), ["run", "x"])
  assert_eq(find_harn_segment(["$", "harn", "version"]), ["version"])
  assert_eq(find_harn_segment(["env", "HARN_LOG=1", "harn", "run"]), ["run"])
  assert_eq(find_harn_segment(["FOO=bar", "harn", "run"]), ["run"])
  assert_eq(find_harn_segment(["cargo", "run"]), nil)
}

// --- help parsing -----------------------------------------------------------
let HELP_ROOT = """
Harn CLI

Usage: harn [OPTIONS] <COMMAND>

Commands:
  run    Run a script
  lint   Lint a script

Options:
      --json           Emit JSON
      --config <PATH>  Config file
  -h, --help           Print help
"""

let HELP_RUN = """
Run a script

Usage: harn run [OPTIONS] <SCRIPT>

Options:
      --as-job [<NAME>]  Run as job
      --timeout <MS>     Timeout
  -h, --help             Print help
"""

@test
pipeline test_parse_command_names(task) {
  assert_eq(parse_command_names(HELP_ROOT), ["run", "lint"])
}

@test
pipeline test_parse_command_names_requires_heading(task) {
  assert_eq(parse_command_names("no commands section\n  run  x\n"), [])
}

@test
pipeline test_parse_help_flags(task) {
  let parsed = parse_help_flags(HELP_ROOT)
  assert_eq(parsed.flags.contains("--json"), true)
  assert_eq(parsed.flags.contains("--config"), true)
  assert_eq(parsed.takes["--json"], false)
  assert_eq(parsed.takes["--config"], true)
}

@test
pipeline test_parse_help_flags_optional_value(task) {
  let parsed = parse_help_flags(HELP_RUN)
  assert_eq(parsed.takes["--as-job"], true)
  assert_eq(parsed.takes["--timeout"], true)
}

@test
pipeline test_parse_help_flags_lookbehind_equivalent(task) {
  // `--` runs embedded in a word or after a hyphen do not count as flags
  // (the Python `(?<![\w-])` look-behind).
  let parsed = parse_help_flags("see foo--bar and legit --baz\n")
  assert_eq(parsed.flags.contains("--bar"), false)
  assert_eq(parsed.flags.contains("--baz"), true)
}

/**
 * analyze_harn_args coverage with an injected fake help oracle: `fake_fetch`
 * stands in for the real `--help` fetcher so the analyzer tests below stay
 * free of any subprocess or filesystem dependency.
 */
fn fake_fetch(path: list<string>) -> string {
  if path.count == 0 {
    return HELP_ROOT
  }
  if path == ["run"] {
    return HELP_RUN
  }
  return ""
}

fn fresh_state() {
  return {help: {}, flagsets: {}}
}

@test
pipeline test_analyze_known_flags_ok(task) {
  let res = analyze_harn_args(fresh_state(), ["run", "--timeout", "5", "x.harn"], fake_fetch)
  assert_eq(res.path, ["run"])
  assert_eq(res.missing, [])
}

@test
pipeline test_analyze_parent_flags_accepted_in_subcommand(task) {
  // Root-level flags stay accepted below (union over path prefixes).
  let res = analyze_harn_args(fresh_state(), ["run", "--json", "x.harn"], fake_fetch)
  assert_eq(res.missing, [])
}

@test
pipeline test_analyze_missing_flag_reported(task) {
  let res = analyze_harn_args(fresh_state(), ["run", "--bogus", "x.harn"], fake_fetch)
  assert_eq(res.missing, ["--bogus"])
}

@test
pipeline test_analyze_stops_at_double_dash(task) {
  let res = analyze_harn_args(fresh_state(), ["run", "x.harn", "--", "--not-checked"], fake_fetch)
  assert_eq(res.missing, [])
}

@test
pipeline test_analyze_value_skip_does_not_eat_subcommand(task) {
  // `--json` takes no value, so the next token still counts as a
  // subcommand path element.
  let res = analyze_harn_args(fresh_state(), ["--json", "run", "--timeout", "5"], fake_fetch)
  assert_eq(res.path, ["run"])
  assert_eq(res.missing, [])
}

@test
pipeline test_analyze_flag_with_equals_value(task) {
  let res = analyze_harn_args(fresh_state(), ["run", "--timeout=5", "x.harn"], fake_fetch)
  assert_eq(res.missing, [])
}

// --- misc -------------------------------------------------------------------
@test
pipeline test_has_long_flag(task) {
  assert_eq(has_long_flag(["run", "--json"]), true)
  assert_eq(has_long_flag(["run", "-v", "x"]), false)
}

@test
pipeline test_is_assignment(task) {
  assert_eq(is_assignment("FOO=bar"), true)
  assert_eq(is_assignment("_x1=2"), true)
  assert_eq(is_assignment("1FOO=bar"), false)
  assert_eq(is_assignment("plain"), false)
}

@test
pipeline test_right_trim(task) {
  assert_eq(right_trim("abc  \t"), "abc")
  assert_eq(right_trim("   "), "")
}
