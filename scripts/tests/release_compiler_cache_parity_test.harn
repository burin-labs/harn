import { read_yaml } from "std/fs"
import "std/schema"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn step_by_name(steps: list, name: string) {
  return steps.find({ step -> trim(step?.name ?? "") == name })
}

@test
pipeline test_release_build_records_cache_mode_stats_and_budget(harness: Harness, task: unknown) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/build-release-binaries.yml", nil)
  const steps = workflow?.jobs?.build?.steps ?? []
  const rust_cache = steps.find(
    { step -> trim(step?.uses ?? "") == "./.github/actions/rust-cache" },
  )
  assert(rust_cache != nil)
  assert_eq(
    trim(rust_cache?.with?.["source-key"] ?? ""),
    gha_expression("matrix.rust_cache_broad_restore_prefix"),
  )
  assert_eq(
    trim(rust_cache?.with?.["broad-restore-prefix"] ?? ""),
    gha_expression("matrix.rust_cache_broad_restore_prefix"),
  )
  assert(step_by_name(steps, "Summarize cache mode") != nil)
  assert(step_by_name(steps, "Summarize sccache stats") != nil)
  assert(step_by_name(steps, "Evaluate warm-build budget") != nil)
  assert(step_by_name(steps, "Persist local release sccache") != nil)
  const arm_cross_toolchain = step_by_name(
    steps,
    "Install Linux ARM64 cross toolchain (x86 host only)",
  )
  assert(arm_cross_toolchain != nil)
  assert_eq(
    trim(arm_cross_toolchain?.if ?? ""),
    "matrix.target == 'aarch64-unknown-linux-gnu' && runner.arch == 'X64'",
  )
  assert_eq(
    trim(arm_cross_toolchain?.with?.packages ?? ""),
    "gcc-aarch64-linux-gnu libc6-dev-arm64-cross",
  )
  assert_eq(trim(arm_cross_toolchain?.with?.["check-command"] ?? ""), "aarch64-linux-gnu-gcc")
  const build = step_by_name(steps, "Build")
  assert_eq(build?.id, "build")
  assert(to_string(build?.run ?? "").contains("duration_seconds="))
  assert(to_string(build?.run ?? "").contains("GITHUB_OUTPUT"))
  const stats = step_by_name(steps, "Summarize sccache stats")
  assert_eq(trim(stats?.if ?? ""), "always()")
  assert(to_string(stats?.run ?? "").contains("sccache_backend=none"))
  const budget = step_by_name(steps, "Evaluate warm-build budget")
  assert(to_string(budget?.run ?? "").contains("scripts/check_release_warm_build_budget.sh"))
  assert_eq(
    trim(budget?.env?.HARN_RELEASE_BUILD_SECONDS ?? ""),
    gha_expression("steps.build.outputs.duration_seconds"),
  )
}

@test
pipeline test_release_runner_policy_enables_macos_windows_compiler_cache(
  harness: Harness,
  task: unknown,
) {
  const policy = schema_expect(
    json_parse(harness.fs.read_text("../../.github/release-runner-policy.json")),
    schema_object(
      {
        targets: schema_field(
          schema_list(
            schema_object(
              {
                target: schema_field(schema_string()),
                sccache_backend: schema_field(schema_enum(["sticky", "local", "install", "none"])),
              },
              {additional_properties: true},
            ),
            {min_items: 1},
          ),
        ),
      },
      {additional_properties: true},
    ),
  )
  const apple_x86 = policy.targets.find({ row -> row.target == "x86_64-apple-darwin" })
  const apple_arm = policy.targets.find({ row -> row.target == "aarch64-apple-darwin" })
  const windows = policy.targets.find({ row -> row.target == "x86_64-pc-windows-msvc" })
  const linux_x86 = policy.targets.find({ row -> row.target == "x86_64-unknown-linux-gnu" })
  const linux_arm = policy.targets.find({ row -> row.target == "aarch64-unknown-linux-gnu" })
  assert_eq(apple_x86?.sccache_backend, "sticky")
  assert_eq(apple_arm?.sccache_backend, "local")
  assert_eq(windows?.sccache_backend, "local")
  assert_eq(linux_x86?.sccache_backend, "install")
  assert_eq(linux_arm?.sccache_backend, "install")
}

@test
pipeline test_warm_build_budget_ratchets_v01065_baseline(harness: Harness, task: unknown) {
  const budget = schema_expect(
    json_parse(harness.fs.read_text("../../.github/release-warm-build-budget.json")),
    schema_object(
      {
        metric: schema_field(schema_literal("build_step_wall_seconds")),
        baseline: schema_field(
          schema_object(
            {version: schema_field(schema_string()), run_id: schema_field(schema_string())},
            {additional_properties: true},
          ),
        ),
        targets: schema_field(
          schema_list(
            schema_object(
              {
                target: schema_field(schema_string()),
                baseline_seconds: schema_field(schema_int()),
                budget_seconds: schema_field(schema_int()),
              },
              {additional_properties: true},
            ),
            {min_items: 1},
          ),
        ),
      },
      {additional_properties: true},
    ),
  )
  assert_eq(budget.baseline.version, "0.10.65")
  assert_eq(budget.baseline.run_id, "31288092986")
  assert_eq(budget.metric, "build_step_wall_seconds")
  const apple = budget.targets.find({ row -> row.target == "x86_64-apple-darwin" })
  assert_eq(apple?.baseline_seconds, 1948)
  assert(apple?.budget_seconds >= apple?.baseline_seconds)
}
