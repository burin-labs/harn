// Tests for scripts/check_docs_workflow_quickstart.harn — the pure JSON
// path navigation/assertion helpers (the fixture runs themselves shell
// out to `harn workflow ...` and are covered by parity runs).
import "../check_docs_workflow_quickstart.harn"

const DOC = {
  valid: true,
  bundle_id: "quickstart-minimal",
  errors: [],
  executed_nodes: [{node_id: "summarize", kind: "task"}, {node_id: "notify", kind: "task"}],
  connectors: [{id: "github"}],
}

// --- json_path_get ----------------------------------------------------------
@test
pipeline test_get_scalar(task) {
  assert_eq(json_path_get(DOC, "valid"), true)
  assert_eq(json_path_get(DOC, "bundle_id"), "quickstart-minimal")
}

@test
pipeline test_get_indexed_field(task) {
  assert_eq(json_path_get(DOC, "executed_nodes[1].node_id"), "notify")
  assert_eq(json_path_get(DOC, "connectors[0].id"), "github")
}

@test
pipeline test_get_empty_path_returns_doc(task) {
  assert_eq(json_path_get({a: 1}, ""), {a: 1})
}

@test
pipeline test_get_missing_key_is_nil(task) {
  // A missing dict key subscripts to nil (so the check reports
  // `actual: null` rather than crashing, unlike the bash+python original).
  assert_eq(json_path_get(DOC, "nope"), nil)
  assert_eq(json_path_check(DOC, "nope", "\"x\"").actual, "null")
}

// --- json_path_check --------------------------------------------------------
@test
pipeline test_check_bool_true(task) {
  assert_eq(json_path_check(DOC, "valid", "true").ok, true)
}

@test
pipeline test_check_string_json_encoding(task) {
  // Expected values are JSON literals, so strings carry quotes.
  assert_eq(json_path_check(DOC, "bundle_id", "\"quickstart-minimal\"").ok, true)
  assert_eq(json_path_check(DOC, "bundle_id", "quickstart-minimal").ok, false)
}

@test
pipeline test_check_empty_list(task) {
  assert_eq(json_path_check(DOC, "errors", "[]").ok, true)
}

@test
pipeline test_check_mismatch_reports_actual(task) {
  const res = json_path_check(DOC, "executed_nodes[0].node_id", "\"notify\"")
  assert_eq(res.ok, false)
  assert_eq(res.actual, "\"summarize\"")
}

@test
pipeline test_check_missing_path_not_ok(task) {
  const res = json_path_check(DOC, "missing[0].x", "\"y\"")
  assert_eq(res.ok, false)
  assert_eq(res.actual.starts_with("<missing path:"), true)
}
