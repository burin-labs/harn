@test
pipeline test_elf_section_deltas_rank_by_magnitude_and_drop_unchanged(
  harness: Harness,
  task: unknown,
) {
  const before = [
    {name: ".text", bytes: 100},
    {name: ".rodata", bytes: 50},
    {name: ".bss", bytes: 7},
  ]
  const after = [
    {name: ".text", bytes: 90},
    {name: ".rodata", bytes: 500},
    {name: ".bss", bytes: 7},
  ]
  const deltas = elf_section_deltas(before, after)
  assert_eq(deltas.count, 2)
  assert_eq(deltas[0]?.name, ".rodata")
  assert_eq(deltas[0]?.delta, 450)
  assert_eq(deltas[1]?.name, ".text")
  assert_eq(deltas[1]?.delta, -10)
}

/**
 * A blocked release has to carry its own attribution: which fuse, which
 * baseline, and what both sides were built with. Otherwise diagnosing it costs
 * a second exact release build.
 */
@test
pipeline test_verdict_report_lines_carry_both_build_identities(harness: Harness, task: unknown) {
  const entry = valid_target_policy()
  const grown = measurement(entry.baseline.bytes + 6000000)
  const lines = verdict_report_lines(evaluate_release_binary_size(entry, grown), entry, grown)
  assert(lines.contains("distribution_fuse: ok"))
  assert(lines.contains("growth: warn"))
  assert(lines.contains("comparability: comparable"))
  assert(lines.contains("delta_bytes: 6000000"))
  assert(lines.contains("baseline_source_sha: ${entry.baseline.source_sha}"))
  assert(
    lines.contains(
      "baseline_build_identity: profile=release codegen_units=8 lto=thin strip=symbols rustc=1.95.0 aot_embedded=true",
    ),
  )
  assert(
    lines.contains(
      "observed_build_identity: profile=release codegen_units=8 lto=thin strip=symbols rustc=1.95.0 aot_embedded=true",
    ),
  )
}

/**
 * The fuse is pure bash and pure arithmetic so it holds even when the binary it
 * just measured cannot run; the growth signal needs that binary. Collapsing
 * them back into one step is the regression this contract exists to prevent.
 */
@test
pipeline test_workflow_evaluates_the_growth_signal_after_the_fuse(harness: Harness, task: unknown) {
  const steps = release_workflow(harness.fs).jobs.build.steps
  const fuse = release_workflow_step(steps, "Check the distribution fuse")
  const growth = release_workflow_step(steps, "Evaluate the binary-size growth signal")
  assert_eq(fuse.id, "binary_size_fuse")
  assert_eq(growth.id, "binary_size_growth")
  assert(!(fuse.run?.contains("harn run") ?? true), "the fuse must not depend on the built binary")
  assert(growth.run?.contains("scripts/check_binary_size.harn"))
  assert_eq(
    growth.if,
    "always() && matrix.target == 'x86_64-unknown-linux-gnu' && steps.binary_size_fuse.outcome == 'success'",
  )
  assert_eq(
    growth.env?.BINARY_SIZE_FUSE_BYTES,
    gha_expression("needs.setup.outputs.binary_size_fuse_bytes"),
  )
  // The attested revision, not the tag that asked for the build.
  assert(growth.run?.contains("HARN_BUILD_REVISION"))
  assert(growth.run?.contains("export BINARY_SIZE_SOURCE_SHA="))
  assert_eq(growth.env?.BINARY_SIZE_SOURCE_REF, gha_expression("needs.setup.outputs.ref"))
}

/**
 * Tag recovery runs the policy from the dispatch ref but the size script from
 * the source checkout. Recovering a tag cut before the policy contract existed
 * must therefore skip the growth signal rather than fail on that script's own
 * hardcoded default (#6257) — v0.10.51's would reject 218.05 MiB while the
 * fuse it just cleared is 250 MiB.
 */
@test
pipeline test_workflow_skips_the_growth_signal_for_pre_contract_sources(
  harness: Harness,
  task: unknown,
) {
  const steps = release_workflow(harness.fs).jobs.build.steps
  const growth = release_workflow_step(steps, "Evaluate the binary-size growth signal")
  const run = growth.run ?? ""
  const contract_at = run.index_of(".github/release-binary-size-policy.json")
  const invoke_at = run.index_of("scripts/check_binary_size.harn")
  assert(contract_at >= 0, "the growth step must test for the policy contract")
  assert(invoke_at >= 0, "the growth step must invoke the size script")
  // Ordering is the whole point: a check after the invocation prevents nothing.
  assert(contract_at < invoke_at, "the contract check must precede the invocation")
  // A skip that reads as a pass is the failure mode this guard must not have.
  assert(run.contains("::notice::"), "an unevaluated growth signal must announce itself")
  assert(run.contains("growth_signal: not-evaluated"), "the report must record the skip")
  assert(run.contains("exit 0"), "a pre-contract source is not a release failure")
  // Exporting a legacy BINARY_SIZE_BUDGET_MB would also make recovery pass, but
  // it is a shim with no retirement condition. Matched as an assignment so the
  // workflow comment explaining that choice does not satisfy the check.
  assert(!run.contains("BINARY_SIZE_BUDGET_MB="), "no legacy budget-name alias")
}
