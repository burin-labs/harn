import { command_run } from "std/command"
import "std/schema"
import { with_temp_dir } from "std/testing"
// Tests for scripts/check_binary_size.harn and the two-level release size
// policy it applies — argument parsing, fuse math, the growth verdict, causality
// attribution, report formatting, and release-workflow default drift. The
// build/bloat paths shell out and are covered by behavior-parity runs.
import "../check_binary_size.harn"
import "../release_binary_size_policy.harn"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

type ReleaseWorkflowStep = {
  id?: string,
  name?: string,
  if?: string,
  shell?: string,
  uses?: string,
  run?: string,
  env?: {
    CARGO_PROFILE_RELEASE_LTO?: string,
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS?: string,
    CARGO_PROFILE_RELEASE_STRIP?: string,
    HARN_REQUIRE_CLI_AOT?: string,
    BINARY_SIZE_FUSE_BYTES?: string,
    BINARY_SIZE_SOURCE_REF?: string,
    BINARY_SIZE_TARGET?: string,
  },
}

type ReleaseWorkflow = {
  jobs: {
    setup: {outputs: {binary_size_fuse_bytes: string}, steps: list<ReleaseWorkflowStep>},
    prepare_cli_aot: {needs: string, if: string, steps: list<ReleaseWorkflowStep>},
    build: {
      needs: list<string>,
      env: {
        CARGO_PROFILE_RELEASE_LTO: string,
        CARGO_PROFILE_RELEASE_CODEGEN_UNITS: string,
        CARGO_PROFILE_RELEASE_STRIP: string,
        HARN_REQUIRE_CLI_AOT: string,
      },
      steps: list<ReleaseWorkflowStep>,
    },
    release: {needs: list<string>, if: string},
  },
}

fn release_workflow(fs: HarnessFs) -> ReleaseWorkflow {
  const step_schema = schema_object(
    {
      name: schema_field(schema_string(), false),
      id: schema_field(schema_string(), false),
      if: schema_field(schema_string(), false),
      shell: schema_field(schema_string(), false),
      env: schema_field(
        schema_object(
          {
            CARGO_PROFILE_RELEASE_LTO: schema_field(schema_string(), false),
            CARGO_PROFILE_RELEASE_CODEGEN_UNITS: schema_field(schema_string(), false),
            CARGO_PROFILE_RELEASE_STRIP: schema_field(schema_string(), false),
            HARN_REQUIRE_CLI_AOT: schema_field(schema_string(), false),
            BINARY_SIZE_FUSE_BYTES: schema_field(schema_string(), false),
            BINARY_SIZE_SOURCE_REF: schema_field(schema_string(), false),
            BINARY_SIZE_TARGET: schema_field(schema_string(), false),
          },
        ),
        false,
      ),
    },
  )
  const schema: Schema<ReleaseWorkflow> = schema_refine(
    schema_of(ReleaseWorkflow),
    schema_object(
      {
        jobs: schema_field(
          schema_object(
            {
              setup: schema_field(
                schema_object(
                  {
                    outputs: schema_field(
                      schema_object({binary_size_fuse_bytes: schema_field(schema_string())}),
                    ),
                    steps: schema_field(schema_list(step_schema)),
                  },
                ),
              ),
              prepare_cli_aot: schema_field(
                schema_object(
                  {
                    needs: schema_field(schema_string()),
                    if: schema_field(schema_string()),
                    steps: schema_field(schema_list(step_schema)),
                  },
                ),
              ),
              build: schema_field(
                schema_object(
                  {
                    needs: schema_field(schema_list(schema_string())),
                    env: schema_field(
                      schema_object(
                        {
                          CARGO_PROFILE_RELEASE_LTO: schema_field(schema_string()),
                          CARGO_PROFILE_RELEASE_CODEGEN_UNITS: schema_field(schema_string()),
                          CARGO_PROFILE_RELEASE_STRIP: schema_field(schema_string()),
                          HARN_REQUIRE_CLI_AOT: schema_field(schema_string()),
                        },
                      ),
                    ),
                    steps: schema_field(schema_list(step_schema)),
                  },
                ),
              ),
              release: schema_field(
                schema_object(
                  {
                    needs: schema_field(schema_list(schema_string())),
                    if: schema_field(schema_string()),
                  },
                ),
              ),
            },
          ),
        ),
      },
    ),
  )
  const path = "../../.github/workflows/build-release-binaries.yml"
  return unwrap(get_typed_result(yaml_parse(fs.read_text(path)), schema))
}

fn release_workflow_step(steps: list<ReleaseWorkflowStep>, name: string) -> ReleaseWorkflowStep {
  for step in steps {
    if step.name == name {
      return step
    }
  }
  throw "release workflow step not found: ${name}"
}

fn defaults() {
  return {
    target: "",
    harn_bin: "",
    fuse_mb: "",
    fuse_bytes: "",
    report_dir: "",
    baseline_sections: "",
  }
}

fn valid_build_identity() -> ReleaseBuildIdentity {
  return {
    profile: "release",
    codegen_units: 8,
    lto: "thin",
    strip: "symbols",
    rustc: "1.95.0",
    aot_embedded: true,
  }
}

fn valid_baseline() -> ReleaseBinarySizeBaseline {
  return {
    version: "0.10.51",
    source_sha: "1347f161a30aaaaa7c36546f2101c65aed2154a7",
    bytes: 228819544,
    observed_at: "2026-08-01T23:34:02Z",
    build_identity: valid_build_identity(),
  }
}

/**
 * 228819544 * 1.12 — inside the 10-15% fuse band, so the fixture is a policy
 * the contract accepts rather than one that only happens to parse.
 */
fn valid_target_policy() -> ReleaseBinarySizeTargetPolicy {
  return {
    target: "x86_64-unknown-linux-gnu",
    distribution_fuse_bytes: 256277889,
    growth: {warn_bytes: 4194304, warn_percent_hundredths: 200},
    baseline: valid_baseline(),
    accepted_growth: [],
  }
}

fn valid_policy() -> ReleaseBinarySizePolicy {
  return {
    schema_version: 2,
    default_target: "x86_64-unknown-linux-gnu",
    targets: [valid_target_policy()],
  }
}

fn measurement(bytes: int) -> ReleaseBinarySizeMeasurement {
  return {
    target: "x86_64-unknown-linux-gnu",
    source_sha: "1e5eb3af1bd0f3a5a26e2cb0d7f1b6a6b3f0dd11",
    bytes: bytes,
    build_identity: valid_build_identity(),
  }
}

// --- parse_args -------------------------------------------------------------
@test
pipeline test_parse_args_defaults(harness: Harness, task: unknown) {
  const res = parse_args([], defaults())
  assert_eq(res.ok, true)
  assert_eq(res.opts.build_release, true)
  assert_eq(res.opts.emit_bloat, true)
  assert_eq(res.opts.fuse_mb, "")
  assert_eq(res.opts.fuse_mb_explicit, false)
  assert_eq(res.opts.fuse_bytes, "")
  assert_eq(res.opts.help, false)
}

@test
pipeline test_parse_args_flags(harness: Harness, task: unknown) {
  const res = parse_args(
    ["--no-build", "--target", "x86_64-unknown-linux-gnu", "--skip-bloat", "--fuse-mb", "50"],
    defaults(),
  )
  assert_eq(res.ok, true)
  assert_eq(res.opts.build_release, false)
  assert_eq(res.opts.emit_bloat, false)
  assert_eq(res.opts.target, "x86_64-unknown-linux-gnu")
  assert_eq(res.opts.fuse_mb, "50")
  assert_eq(res.opts.fuse_mb_explicit, true)
}

@test
pipeline test_parse_args_bin_and_report_dir(harness: Harness, task: unknown) {
  const res = parse_args(["--bin", "/x/harn", "--report-dir", "out"], defaults())
  assert_eq(res.opts.harn_bin, "/x/harn")
  assert_eq(res.opts.report_dir, "out")
}

@test
pipeline test_parse_args_missing_value(harness: Harness, task: unknown) {
  const res = parse_args(["--target"], defaults())
  assert_eq(res.ok, false)
  assert_eq(res.message, "error: --target requires a value")
  assert_eq(res.show_usage, false)
}

@test
pipeline test_parse_args_missing_path_noun(harness: Harness, task: unknown) {
  assert_eq(parse_args(["--bin"], defaults()).message, "error: --bin requires a path")
  assert_eq(parse_args(["--report-dir"], defaults()).message, "error: --report-dir requires a path")
}

@test
pipeline test_parse_args_unknown_flag_shows_usage(harness: Harness, task: unknown) {
  const res = parse_args(["--wat"], defaults())
  assert_eq(res.ok, false)
  assert_eq(res.message, "error: unknown argument: --wat")
  assert_eq(res.show_usage, true)
}

@test
pipeline test_parse_args_help(harness: Harness, task: unknown) {
  assert_eq(parse_args(["-h"], defaults()).opts.help, true)
  assert_eq(parse_args(["--help"], defaults()).opts.help, true)
}

// --- parse_fuse_mb / fuse_bytes_of --------------------------------------
@test
pipeline test_fuse_parse_valid(harness: Harness, task: unknown) {
  assert_eq(parse_fuse_mb("219.00"), 219.0)
  assert_eq(parse_fuse_mb("1.2"), 1.2)
}

@test
pipeline test_fuse_parse_invalid(harness: Harness, task: unknown) {
  assert_eq(parse_fuse_mb("0"), nil)
  assert_eq(parse_fuse_mb("-5"), nil)
  assert_eq(parse_fuse_mb("abc"), nil)
}

@test
pipeline test_positive_integer_fuse_parse(harness: Harness, task: unknown) {
  assert_eq(parse_positive_int("230686720"), 230686720)
  assert_eq(parse_positive_int("0"), nil)
  assert_eq(parse_positive_int("1.5"), nil)
  assert_eq(parse_positive_int("+1"), nil)
}

@test
pipeline test_fuse_bytes_rounding(harness: Harness, task: unknown) {
  assert_eq(fuse_bytes_of(192.0), 201326592)
  // awk printf "%.0f", 1.2 * 1024 * 1024 == 1258291
  assert_eq(fuse_bytes_of(1.2), 1258291)
}

@test
pipeline test_fuse_resolution_preserves_exact_bytes_and_override_precedence(
  harness: Harness,
  task: unknown,
) {
  const policy = valid_policy()
  assert_eq(
    resolve_distribution_fuse_bytes(
      policy,
      "",
      {fuse_mb: "", fuse_mb_explicit: false, fuse_bytes: ""},
    ),
    Ok(256277889),
  )
  assert_eq(
    resolve_distribution_fuse_bytes(
      policy,
      "",
      {fuse_mb: "", fuse_mb_explicit: false, fuse_bytes: "229700000"},
    ),
    Ok(229700000),
  )
  assert_eq(
    resolve_distribution_fuse_bytes(
      policy,
      "",
      {fuse_mb: "1.2", fuse_mb_explicit: false, fuse_bytes: "229700000"},
    ),
    Ok(229700000),
  )
  assert_eq(
    resolve_distribution_fuse_bytes(
      policy,
      "",
      {fuse_mb: "1.2", fuse_mb_explicit: true, fuse_bytes: "229700000"},
    ),
    Ok(1258291),
  )
  assert_eq(
    resolve_distribution_fuse_bytes(
      policy,
      "missing-target",
      {fuse_mb: "", fuse_mb_explicit: false, fuse_bytes: ""},
    ),
    Err(
      "release binary-size policy has no target 'missing-target'; add a target entry or pass an explicit fuse override",
    ),
  )
}

@test
pipeline test_binary_size_policy_is_typed_and_ratchets_observed_candidate(
  harness: Harness,
  task: unknown,
) {
  const result = read_release_binary_size_policy_result(
    harness.fs,
    "../../.github/release-binary-size-policy.json",
  )
  assert(
    is_ok(result),
    json_stringify(
      if is_err(result) {
        unwrap_err(result)
      } else {
        {}
      },
    ),
  )
  const policy = unwrap(result)
  assert_eq(release_binary_size_policy_errors(policy), [])
  assert_eq(policy.default_target, "x86_64-unknown-linux-gnu")
  assert_eq(policy.targets.count, 1)
  const target = unwrap(policy.targets[0])
  assert_eq(target.distribution_fuse_bytes, 267386880)
  assert_eq(target.baseline.version, "0.10.118")
  assert_eq(target.baseline.source_sha, "40a4030d5c2204d27975cfd22f4d65fbe89ad2cc")
  assert_eq(target.baseline.bytes, 242554944)
  assert_eq(target.baseline.observed_at, "2026-08-27T01:19:49Z")
  // The fuse is a fuse, not a ratchet: ~10.2% of headroom, where the schema-1
  // policy this replaced allowed at most 4 MiB (1.8%) and turned every real
  // change into a release-day cliff.
  assert_eq(target.distribution_fuse_bytes - target.baseline.bytes, 24831936)
  assert_eq(target.growth.warn_bytes, 4194304)
  assert_eq(target.growth.warn_percent_hundredths, 200)
  assert_eq(target.baseline.build_identity.codegen_units, 8)
  assert_eq(target.baseline.build_identity.rustc, "1.95.0")
  assert_eq(target.accepted_growth.count, 1)
  const acceptance = unwrap(target.accepted_growth[0])
  assert_eq(acceptance.against_baseline_sha, target.baseline.source_sha)
  assert_eq(acceptance.bytes, 8357976)
  const baseline = evaluate_release_binary_size(target, measurement(242554944))
  assert_eq(baseline.growth, "ok")
  assert_eq(baseline.failures, [])
  const measured_candidate = evaluate_release_binary_size(target, measurement(250388632))
  assert_eq(measured_candidate.growth, "accepted")
  assert_eq(measured_candidate.failures, [])
  // The decision is bounded: one byte beyond its allowance still fails.
  const beyond_acceptance = evaluate_release_binary_size(target, measurement(250912921))
  assert_eq(beyond_acceptance.growth, "warn")
  assert_eq(beyond_acceptance.failures.count, 1)
  assert(beyond_acceptance.failures[0]?.starts_with("growth signal:"))
  assert_eq(release_binary_size_target_policy(policy, policy.default_target), target)
}

@test
pipeline test_binary_size_policy_rejects_invalid_topology(harness: Harness, task: unknown) {
  const target = valid_target_policy()
  assert_eq(
    release_binary_size_policy_errors({schema_version: 1, default_target: "missing", targets: []}),
    [
      "schema_version must be 2",
      "targets must not be empty",
      "default_target must name one target policy",
    ],
  )
  assert_eq(
    release_binary_size_policy_errors(
      {schema_version: 2, default_target: target.target, targets: [target, target]},
    ),
    ["target must be unique: x86_64-unknown-linux-gnu"],
  )
}

@test
pipeline test_binary_size_policy_rejects_every_invalid_baseline_field(
  harness: Harness,
  task: unknown,
) {
  const target = valid_target_policy()
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy()
        + {targets: [target + {baseline: target.baseline + {bytes: 0}}]},
    ),
    ["x86_64-unknown-linux-gnu: baseline.bytes must be positive"],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {baseline: target.baseline + {version: "next"}}]},
    ),
    ["x86_64-unknown-linux-gnu: baseline.version must be a semantic release version"],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {baseline: target.baseline + {source_sha: "short"}}]},
    ),
    ["x86_64-unknown-linux-gnu: baseline.source_sha must be a full lowercase Git commit"],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {baseline: target.baseline + {observed_at: "today"}}]},
    ),
    ["x86_64-unknown-linux-gnu: baseline.observed_at must be a UTC second-resolution timestamp"],
  )
}

@test
pipeline test_binary_size_policy_enforces_a_fuse_shaped_ceiling(harness: Harness, task: unknown) {
  const target = valid_target_policy()
  // 228819544 * 1.10 and * 1.15, the exact boundary the contract states.
  const min_fuse = 251701498
  const max_fuse = 263142475
  assert_eq(release_binary_size_policy_errors(valid_policy()), [])
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {distribution_fuse_bytes: min_fuse}]},
    ),
    [],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {distribution_fuse_bytes: max_fuse}]},
    ),
    [],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {distribution_fuse_bytes: min_fuse - 1}]},
    ),
    [
      "x86_64-unknown-linux-gnu: distribution_fuse_bytes must leave at least 10% headroom above the baseline (>= ${min_fuse})",
    ],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {distribution_fuse_bytes: max_fuse + 1}]},
    ),
    [
      "x86_64-unknown-linux-gnu: distribution_fuse_bytes must stay within 15% of the baseline (<= ${max_fuse})",
    ],
  )
}

/**
 * An acceptance outlives the baseline it was written against only if nothing
 * stops it, and a stale acceptance silently blesses growth nobody decided on.
 */
@test
pipeline test_accepted_growth_must_name_the_current_baseline(harness: Harness, task: unknown) {
  const target = valid_target_policy()
  const current = {
    against_baseline_sha: target.baseline.source_sha,
    bytes: 8000000,
    reason: "embed the CLI AOT payload",
  }
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {accepted_growth: [current]}]},
    ),
    [],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy()
        + {
          targets: [
            target
              + {
                accepted_growth: [
                  current + {against_baseline_sha: "0000000000000000000000000000000000000000"},
                ],
              },
          ],
        },
    ),
    [
      "x86_64-unknown-linux-gnu: accepted_growth.against_baseline_sha must be the current baseline 1347f161a30aaaaa7c36546f2101c65aed2154a7, got 0000000000000000000000000000000000000000",
    ],
  )
  assert_eq(
    release_binary_size_policy_errors(
      valid_policy() + {targets: [target + {accepted_growth: [current + {reason: "  "}]}]},
    ),
    ["x86_64-unknown-linux-gnu: accepted_growth.reason must not be empty"],
  )
}

@test
pipeline test_binary_size_policy_schema_is_closed(harness: Harness, task: unknown) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "policy.json")
      harness.fs.write_text(path, json_stringify(valid_policy() + {notes: "not in the contract"}))
      assert(is_err(read_release_binary_size_policy_result(harness.fs, path)))
    },
    "binary-size-policy-closed",
  )
}

@test
pipeline test_bootstrap_query_matches_typed_policy_contract(harness: Harness, task: unknown) {
  with_temp_dir(
    harness.fs,
    { root ->
      const jq_version = command_run(harness.tools, ["jq", "--version"])
      assert(jq_version.success, "jq is required to validate the release bootstrap projection")
      const query_path = path_join(root, "policy.jq")
      const policy_path = path_join(root, "policy.json")
      harness.fs.write_text(
        query_path,
        harness.fs.read_text("../../.github/release-binary-size-policy.jq"),
      )
      const cases = [
        valid_policy(),
        valid_policy() + {extra: true},
        valid_policy() + {schema_version: 1},
        valid_policy() + {targets: []},
        valid_policy() + {default_target: "missing"},
        valid_policy() + {targets: [valid_target_policy(), valid_target_policy()]},
        valid_policy()
          + {targets: [valid_target_policy() + {distribution_fuse_bytes: 251701497}]},
        valid_policy()
          + {targets: [valid_target_policy() + {distribution_fuse_bytes: 263142476}]},
        valid_policy()
          + {
            targets: [
              valid_target_policy()
                + {
                  accepted_growth: [
                    {
                      against_baseline_sha: "0000000000000000000000000000000000000000",
                      bytes: 1,
                      reason: "stale",
                    },
                  ],
                },
            ],
          },
        valid_policy()
          + {
            targets: [
              valid_target_policy()
                + {
                  baseline: valid_target_policy().baseline
                    + {build_identity: valid_build_identity() + {codegen_units: 0}},
                },
            ],
          },
        valid_policy()
          + {
            targets: [
              valid_target_policy()
                + {baseline: valid_target_policy().baseline + {version: "next"}},
            ],
          },
        valid_policy()
          + {
            targets: [
              valid_target_policy()
                + {baseline: valid_target_policy().baseline + {source_sha: "short"}},
            ],
          },
        valid_policy()
          + {
            targets: [
              valid_target_policy()
                + {baseline: valid_target_policy().baseline + {observed_at: "today"}},
            ],
          },
        valid_policy()
          + {
            targets: [
              valid_target_policy() + {baseline: valid_target_policy().baseline + {bytes: 0}},
            ],
          },
        valid_policy() + {targets: [valid_target_policy() + {target: ""}]},
      ]
      let index = 0
      for policy in cases {
        harness.fs.write_text(policy_path, json_stringify(policy))
        const typed_result = read_release_binary_size_policy_result(harness.fs, policy_path)
        const typed_accepts = if is_err(typed_result) {
          false
        } else {
          release_binary_size_policy_errors(unwrap(typed_result)).count == 0
        }
        const result = command_run(
          harness.tools,
          [
            "jq",
            "-er",
            "--arg",
            "target",
            "x86_64-unknown-linux-gnu",
            "-f",
            query_path,
            policy_path,
          ],
        )
        if index == 0 {
          assert(typed_accepts)
          assert(result.success)
          assert_eq(result.stdout.trim(), "256277889")
        } else {
          assert(!typed_accepts)
          assert(!result.success)
        }
        index = index + 1
      }
    },
    "binary-size-policy-bootstrap-parity",
  )
}

@test
pipeline test_workflow_projects_typed_binary_size_policy(harness: Harness, task: unknown) {
  const workflow = release_workflow(harness.fs)
  assert_eq(
    workflow.jobs.setup.outputs.binary_size_fuse_bytes,
    gha_expression("steps.binary-size-policy.outputs.fuse_bytes"),
  )
  const policy_step = release_workflow_step(
    workflow.jobs.setup.steps,
    "Resolve release binary-size policy",
  )
  assert_eq(policy_step.id, "binary-size-policy")
  assert_eq(policy_step.shell, "bash")
  assert_eq(policy_step.env?.BINARY_SIZE_TARGET, "x86_64-unknown-linux-gnu")
  assert_eq(
    release_workflow_step(workflow.jobs.build.steps, "Check the distribution fuse").env
      ?.BINARY_SIZE_FUSE_BYTES,
    gha_expression("needs.setup.outputs.binary_size_fuse_bytes"),
  )
}

@test
pipeline test_workflow_preserves_bloat_after_a_failed_size_gate(harness: Harness, task: unknown) {
  const measured_target = "matrix.target == 'x86_64-unknown-linux-gnu'"
  const diagnostic_mode = measured_target
    + " && (needs.setup.outputs.build_mode == 'warm' || (needs.setup.outputs.build_mode == 'benchmark' && inputs.benchmark_cargo_bloat) || steps.binary_size_fuse.outcome == 'failure' || steps.binary_size_growth.outcome == 'failure')"
  const diagnostics = "always() && " + diagnostic_mode
  const build = release_workflow(harness.fs).jobs.build
  const steps = build.steps
  const bloat = release_workflow_step(steps, "Generate cargo-bloat report")
  // Cargo's environment-backed profile configuration is job-wide so the
  // canonical build and every later Cargo diagnostic share one fingerprint.
  assert_eq(build.env.CARGO_PROFILE_RELEASE_LTO, "thin")
  assert_eq(
    build.env.CARGO_PROFILE_RELEASE_CODEGEN_UNITS,
    gha_expression("matrix.release_codegen_units"),
  )
  assert_eq(build.env.CARGO_PROFILE_RELEASE_STRIP, "symbols")
  const canonical_build = release_workflow_step(steps, "Build")
  assert_eq(canonical_build.env?.CARGO_PROFILE_RELEASE_LTO, nil)
  assert_eq(canonical_build.env?.CARGO_PROFILE_RELEASE_CODEGEN_UNITS, nil)
  assert_eq(canonical_build.env?.CARGO_PROFILE_RELEASE_STRIP, nil)
  // Install precedes both size gates, so it cannot read their outcome. It must
  // stay unconditional on the measured target or a size failure would try to
  // attribute itself with cargo-bloat missing.
  assert_eq(release_workflow_step(steps, "Install cargo-bloat").if, measured_target)
  assert_eq(bloat.if, diagnostics)
  assert_eq(bloat["continue-on-error"], nil)
  assert(!bloat.run?.contains("run scripts/check_binary_size.harn"))
  assert(bloat.run?.contains("cargo bloat --release --crates"))
  assert(bloat.run?.contains("cargo-bloat-crates.txt"))
  assert(bloat.run?.contains("cargo-bloat-deserialize.txt"))
  assert(bloat.run?.contains("crates_status=$?"))
  assert(bloat.run?.contains("filtered_status=$?"))
  assert(
    bloat.run?.index_of("crates_status=$?")
      < bloat.run?.index_of("cargo bloat --release -p harn-cli"),
  )
  assert(
    bloat.run?.index_of("filtered_status=$?")
      < bloat.run?.index_of("if (( crates_status != 0 || filtered_status != 0 ))"),
  )
  assert(bloat.run?.contains("cmp -s \"$restore_dir/harn\" \"$harn_bin\""))
  assert(bloat.run?.contains("trap - EXIT"))
  assert(bloat.run?.contains("::warning::cargo-bloat attribution was incomplete"))
  assert_eq(bloat.run?.split("exit 1").count, 2)
  assert_eq(
    release_workflow_step(steps, "Check the distribution fuse").if,
    "matrix.target == 'x86_64-unknown-linux-gnu'",
  )
  assert_eq(
    release_workflow_step(steps, "Upload binary-size report").if,
    "always() && matrix.target == 'x86_64-unknown-linux-gnu'",
  )
}

