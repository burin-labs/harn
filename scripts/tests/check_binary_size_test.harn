// --- the two levels ---------------------------------------------------------
/**
 * The fuse is the distribution safety property. It does not care how the
 * artifact was built, because an oversized artifact is undistributable whatever
 * produced it.
 */
@test
pipeline test_the_fuse_fails_closed_regardless_of_comparability(harness: Harness, task: unknown) {
  const entry = valid_target_policy()
  const over = measurement(entry.distribution_fuse_bytes + 1)
  const verdict = evaluate_release_binary_size(entry, over)
  assert_eq(verdict.fuse, "breached")
  // An artifact this far past the fuse is also past the growth thresholds, and
  // both are reported: the operator gets the ceiling breach and the delta that
  // produced it, not one standing in for the other.
  assert_eq(verdict.growth, "warn")
  assert_eq(verdict.failures.count, 2)
  assert(verdict.failures[0]?.starts_with("distribution fuse:"))
  // Not comparable, so no growth conclusion — and the fuse still fires.
  const incomparable = evaluate_release_binary_size(
    entry,
    over + {build_identity: valid_build_identity() + {codegen_units: 16}},
  )
  assert_eq(incomparable.fuse, "breached")
  assert_eq(incomparable.growth, "not-comparable")
  assert_eq(incomparable.failures.count, 1)
  assert_eq(
    evaluate_release_binary_size(entry, measurement(entry.distribution_fuse_bytes)).fuse,
    "ok",
  )
}

/**
 * Both thresholds, not either. A few megabytes on a 200+ MiB artifact is noise,
 * and a large ratio on a small one is not a distribution concern.
 */
@test
pipeline test_the_growth_signal_needs_both_thresholds(harness: Harness, task: unknown) {
  const entry = valid_target_policy()
  const baseline = entry.baseline.bytes
  // 4 MiB is 1.83% of this baseline: over the byte floor, under the ratio.
  assert_eq(evaluate_release_binary_size(entry, measurement(baseline + 4194304)).growth, "ok")
  // 2.00% is 4577990 bytes: over both.
  assert_eq(evaluate_release_binary_size(entry, measurement(baseline + 4577990)).growth, "warn")
  // A ratio crossing under the byte floor cannot fire on its own.
  const tiny = entry
    + {
      baseline: entry.baseline + {bytes: 1000000},
      growth: {warn_bytes: 4194304, warn_percent_hundredths: 200},
    }
  assert_eq(evaluate_release_binary_size(tiny, measurement(1500000)).growth, "ok")
  assert_eq(evaluate_release_binary_size(entry, measurement(baseline)).growth, "ok")
  assert_eq(evaluate_release_binary_size(entry, measurement(baseline - 5000000)).growth, "ok")
}

/**
 * The v0.10.52 shape. Identical source and toolchain, codegen units 16 -> 8,
 * 8,407,168 bytes of difference — a number with no product meaning. The policy
 * declines to draw a growth conclusion and says which field diverged.
 */
@test
pipeline test_the_growth_signal_is_withheld_when_the_build_is_not_comparable(
  harness: Harness,
  task: unknown,
) {
  const entry = valid_target_policy()
  const grown = measurement(entry.baseline.bytes + 8407168)
  assert_eq(evaluate_release_binary_size(entry, grown).growth, "warn")
  const verdict = evaluate_release_binary_size(
    entry,
    grown + {build_identity: valid_build_identity() + {codegen_units: 16}},
  )
  assert_eq(verdict.comparability, "not-comparable")
  assert_eq(verdict.growth, "not-comparable")
  assert_eq(verdict.divergent_identity_fields, ["codegen_units"])
  assert_eq(verdict.failures, [])
  const rebuilt = evaluate_release_binary_size(
    entry,
    grown
      + {
        build_identity: valid_build_identity()
          + {rustc: "1.96.0", strip: "debuginfo", aot_embedded: false},
      },
  )
  assert_eq(rebuilt.divergent_identity_fields, ["strip", "rustc", "aot_embedded"])
}

/** A crossing is a decision, and the decision is written down. */
@test
pipeline test_an_accepted_growth_clears_the_signal_and_names_its_reason(
  harness: Harness,
  task: unknown,
) {
  const entry = valid_target_policy()
  const grown = measurement(entry.baseline.bytes + 6000000)
  assert_eq(evaluate_release_binary_size(entry, grown).growth, "warn")
  const accepted = entry
    + {
      accepted_growth: [
        {
          against_baseline_sha: entry.baseline.source_sha,
          bytes: 8000000,
          reason: "embed the CLI AOT payload for offline start",
        },
      ],
    }
  const verdict = evaluate_release_binary_size(accepted, grown)
  assert_eq(verdict.growth, "accepted")
  assert_eq(verdict.accepted_reason, "embed the CLI AOT payload for offline start")
  assert_eq(verdict.failures, [])
  // An acceptance covers what it says it covers and no more.
  assert_eq(
    evaluate_release_binary_size(accepted, measurement(entry.baseline.bytes + 8000001)).growth,
    "warn",
  )
}

// --- causality attribution --------------------------------------------------
/**
 * The discrimination raw bytes cannot make, on the numbers the v0.10.52
 * incident actually reported. `.text`, `.eh_frame`, and `.gcc_except_table`
 * carry 97% of the movement while `.rodata` barely shifts: codegen duplication
 * and layout, not eight megabytes of removed product.
 *
 * The deltas are the measurements published in #6020; the absolute before/after
 * sizes here are only their carrier, since the two artifacts are not archived.
 */
@test
pipeline test_classify_growth_separates_codegen_layout_from_content(
  harness: Harness,
  task: unknown,
) {
  const codegen_units_16_to_8 = [
    {name: ".text", before: 100000000, after: 100000000 - 6155200, delta: -6155200},
    {name: ".eh_frame", before: 20000000, after: 20000000 - 1053992, delta: -1053992},
    {name: ".gcc_except_table", before: 9000000, after: 9000000 - 599028, delta: -599028},
    {name: ".rodata", before: 40000000, after: 40000000 - 225280, delta: -225280},
  ]
  const layout = classify_growth(codegen_units_16_to_8)
  assert_eq(layout.classification, "codegen-layout")
  assert_eq(layout.codegen_bytes, -7808220)
  assert_eq(layout.content_bytes, -225280)
  // The opposite shape: an embedded asset lands in .rodata and barely moves
  // generated code. The same report must not call this a layout change.
  const embedded_asset = [
    {name: ".rodata", before: 40000000, after: 48000000, delta: 8000000},
    {name: ".text", before: 100000000, after: 100050000, delta: 50000},
  ]
  const content = classify_growth(embedded_asset)
  assert_eq(content.classification, "content")
  assert_eq(content.content_bytes, 8000000)
  assert_eq(classify_growth([]).classification, "unchanged")
}

@test
pipeline test_parse_elf_sections_reads_the_size_table(harness: Harness, task: unknown) {
  const table = """
harn  :
section                size      addr
.text             104857600   4194304
.rodata            41943040 109051904
.eh_frame          20971520 150994944
Total             167772160
