@test
pipeline test_release_workflow_generates_aot_once_for_release_and_benchmark_targets(
  harness: Harness,
  task: unknown,
) {
  const workflow = release_workflow(harness.fs)
  const checkout = workflow.jobs.prepare_cli_aot.steps[0]
  const generator = release_workflow_step(
    workflow.jobs.prepare_cli_aot.steps,
    "Generate and verify target-independent CLI AOT payload",
  )
  const restore = release_workflow_step(
    workflow.jobs.build.steps,
    "Restore target-independent CLI AOT payload",
  )
  const build = release_workflow_step(workflow.jobs.build.steps, "Build")
  const aot_condition =
    "needs.setup.outputs.is_release == 'true' || needs.setup.outputs.build_mode == 'benchmark' || needs.setup.outputs.build_mode == 'candidate'"
  assert_eq(workflow.jobs.prepare_cli_aot.needs, "setup")
  assert_eq(workflow.jobs.prepare_cli_aot.if, "needs.setup.outputs.should_build_binaries == 'true'")
  assert_eq(checkout.if, aot_condition)
  assert_eq(generator.if, aot_condition)
  assert_eq(generator.run, "make gen-cli-aot && make check-cli-aot")
  assert_eq(restore.if, aot_condition)
  assert_eq(restore.uses, "./.github/actions/download-artifact-with-retry")
  const required_aot = "$" + "{{ (" + aot_condition + ") && '1' || '0' }}"
  assert_eq(workflow.jobs.build.env.HARN_REQUIRE_CLI_AOT, required_aot)
  assert_eq(build.env?.HARN_REQUIRE_CLI_AOT, nil)
  assert_eq(
    release_workflow_step(workflow.jobs.build.steps, "Evaluate the binary-size growth signal").env
      ?.HARN_REQUIRE_CLI_AOT,
    nil,
  )
  assert_eq(workflow.jobs.build.needs.contains("prepare_cli_aot"), true)
  assert_eq(workflow.jobs.release.needs.contains("prepare_cli_aot"), true)
  assert_eq(workflow.jobs.release.if.contains("needs.prepare_cli_aot.result"), true)
}

@test
pipeline test_artifact_download_retry_is_bounded_and_fail_closed(harness: Harness, task: unknown) {
  const action = harness.fs.read_text(
    "../../.github/actions/download-artifact-with-retry/action.yml",
  )
  const release_workflow_text = harness.fs.read_text(
    "../../.github/workflows/build-release-binaries.yml",
  )
  const ci_workflow_text = harness.fs.read_text("../../.github/workflows/ci.yml")
  const official_download =
    "uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"
  const bounded_download = "uses: ./.github/actions/download-artifact-with-retry"
  assert_eq(action.split(official_download).count, 4)
  assert_eq(action.split("continue-on-error: true").count, 3)
  assert(action.contains("if: steps.attempt_1.outcome == 'failure'"))
  assert(action.contains("if: steps.attempt_2.outcome == 'failure'"))
  assert_eq(action.split("sleep 2").count, 2)
  assert_eq(action.split("sleep 5").count, 2)
  assert(action.contains("Download artifact (attempt 3/3)"))
  assert(!action.contains("continue-on-error: false"))
  assert(!release_workflow_text.contains(official_download))
  assert(!ci_workflow_text.contains(official_download))
  assert_eq(release_workflow_text.split(bounded_download).count, 3)
  assert_eq(ci_workflow_text.split(bounded_download).count, 6)
}

