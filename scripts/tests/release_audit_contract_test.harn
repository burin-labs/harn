import { with_temp_dir } from "std/testing"
import {
  release_audit_ci_contract_report,
  release_audit_contract_parse,
  release_audit_contract_read,
  release_audit_receipt_plan,
} from "../release_audit_contract"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BINARY_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn proof_step(
  id: string,
  condition: string,
  run: string,
  required_env: ReleaseAuditCiEnvironment = {},
) -> ReleaseAuditCiStep {
  return {id: id, condition: condition, run: run, required_env: required_env}
}

fn contract() -> ReleaseAuditContract {
  return {
    schema_version: "harn.release_audit_contract.v1",
    lanes: [
      {name: "rust-audit", runner: "run_rust_audit", proof: "merge_group"},
      {name: "harn-audit", runner: "run_harn_audit", proof: "merge_group"},
      {name: "package-audit", runner: "run_package_audit", proof: "merge_group"},
      {name: "docs-audit", runner: "run_docs_audit", proof: "residual"},
    ],
    merge_group_jobs: [
      {
        name: "Format check",
        job_id: "fmt",
        matrix_kind: "",
        proofs: ["rust-audit"],
        steps: [proof_step("release-audit-format", "", "make fmt-check")],
      },
      {
        name: "Package audit",
        job_id: "package-audit",
        matrix_kind: "",
        proofs: ["package-audit"],
        steps: [proof_step("release-audit-package", "", "./scripts/verify_crate_packages.sh")],
      },
      {
        name: "Rust lint",
        job_id: "rust-builds",
        matrix_kind: "lint",
        proofs: ["rust-audit"],
        steps: [
          proof_step("release-audit-rust-lint", "matrix.kind == 'lint'", "./scripts/ci/run_rust_lint_lane.sh"),
        ],
      },
      {
        name: "Rust test",
        job_id: "rust-test",
        matrix_kind: "",
        proofs: ["rust-audit"],
        steps: [
          proof_step(
            "release-audit-rust-test",
            "",
            "scripts/ci/run_rust_test_lane.sh cargo nextest run --workspace --profile ci -E 'not test(test_linux_process_sandbox_catches_ten_process_escapes)'",
            {HARN_LLM_CALLS_DISABLED: "1"},
          ),
        ],
      },
      {
        name: "Rust security proof",
        job_id: "rust-security",
        matrix_kind: "",
        proofs: ["rust-audit"],
        steps: [
          proof_step(
            "release-audit-rust-security",
            "",
            "cargo nextest run --profile ci --archive-file \"$RUNNER_TEMP/harn-behavior/harn-security.tar.zst\" --workspace-remap \"$GITHUB_WORKSPACE\" -E 'test(test_linux_process_sandbox_catches_ten_process_escapes)'",
          ),
        ],
      },
      {
        name: "Harn conformance + audit",
        job_id: "harn-audit",
        matrix_kind: "",
        proofs: ["harn-audit"],
        steps: [
          proof_step(
            "release-audit-harn",
            "",
            "./scripts/audit_gates.sh",
            {AUDIT_GATES_CONCURRENCY: "2", HARN_CONFORMANCE_SHARDS: "2"},
          ),
        ],
      },
    ],
  }
}

fn jobs() {
  return [
    {
      id: 4,
      name: "Format check",
      url: "https://github.com/burin-labs/harn/actions/runs/123/job/4",
      status: "completed",
      conclusion: "success",
    },
    {
      id: 5,
      name: "Package audit",
      url: "https://github.com/burin-labs/harn/actions/runs/123/job/5",
      status: "completed",
      conclusion: "success",
    },
    {
      id: 1,
      name: "Rust lint",
      url: "https://github.com/burin-labs/harn/actions/runs/123/job/1",
      status: "completed",
      conclusion: "success",
    },
    {
      id: 2,
      name: "Rust test",
      url: "https://github.com/burin-labs/harn/actions/runs/123/job/2",
      status: "completed",
      conclusion: "success",
    },
    {
      id: 3,
      name: "Harn conformance + audit",
      url: "https://github.com/burin-labs/harn/actions/runs/123/job/3",
      status: "completed",
      conclusion: "success",
    },
    {
      id: 6,
      name: "Rust security proof",
      url: "https://github.com/burin-labs/harn/actions/runs/123/job/6",
      status: "completed",
      conclusion: "success",
    },
  ]
}

fn merge_receipt() {
  return {
    schema_version: "harn.release_audit_receipt.v1",
    proof_kind: "merge_group",
    head_sha: SHA,
    run: {
      id: 123,
      url: "https://github.com/burin-labs/harn/actions/runs/123",
      event: "merge_group",
      workflow: "CI",
      head_sha: SHA,
      status: "completed",
      conclusion: "success",
    },
    jobs: jobs(),
    warm: {
      head_sha: SHA,
      command: "cargo build -p harn-cli --bin harn --locked",
      binary_sha256: BINARY_SHA,
      status: "success",
    },
  }
}

pipeline test_release_audit_contract_and_receipts(task) {
  const cfg = contract()
  assert(release_audit_contract_parse(cfg) != nil)
  assert_eq(release_audit_contract_parse({...cfg, unexpected: true}), nil)
  const accepted = release_audit_receipt_plan(cfg, merge_receipt(), SHA, BINARY_SHA)
  assert_eq(accepted.ok, true)
  assert_eq(accepted.proof_kind, "merge_group")
  assert_eq(accepted.lane_names, ["docs-audit"])
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...merge_receipt(), head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
      SHA,
      BINARY_SHA,
    ).reason,
    "head_sha_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...merge_receipt(), jobs: jobs().filter({ job -> job.name != "Rust test" }).to_list()},
      SHA,
      BINARY_SHA,
    ).reason,
    "merge_group_jobs_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(cfg, {...merge_receipt(), jobs: jobs() + [jobs()[0]]}, SHA, BINARY_SHA).reason,
    "duplicate_merge_group_job_id",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...merge_receipt(), jobs: [{...jobs()[0], conclusion: "skipped"}, jobs()[1], jobs()[2]]},
      SHA,
      BINARY_SHA,
    ).reason,
    "invalid_receipt",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...merge_receipt(), warm: {...merge_receipt().warm, status: "failed"}},
      SHA,
      BINARY_SHA,
    ).reason,
    "invalid_receipt",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      merge_receipt(),
      SHA,
      "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
    ).reason,
    "warm_binary_sha256_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(cfg, {...merge_receipt(), unexpected: true}, SHA, BINARY_SHA).reason,
    "invalid_receipt",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...merge_receipt(),
        run: {...merge_receipt().run, url: "https://github.com/burin-labs/harn/actions/runs/999"},
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "run_url_identity_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...merge_receipt(),
        jobs: [
          {...jobs()[0], url: "https://github.com/burin-labs/harn/actions/runs/123/job/999"},
          jobs()[1],
          jobs()[2],
        ],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "job_url_identity_mismatch",
  )
}

pipeline test_release_audit_contract_reads_typed_result_from_disk(task) {
  with_temp_dir(
    { dir ->
      const path = path_join(dir, "release-audit-contract.json")
      harness.fs.write_text(path, json_stringify(contract()))
      const loaded = release_audit_contract_read(path)
      assert(loaded != nil)
      assert_eq(loaded.schema_version, "harn.release_audit_contract.v1")
      assert_eq(
        loaded.merge_group_jobs.map({ job -> job.name }).to_list(),
        [
          "Format check",
          "Package audit",
          "Rust lint",
          "Rust test",
          "Rust security proof",
          "Harn conformance + audit",
        ],
      )
      harness.fs.write_text(path, "{invalid")
      assert_eq(release_audit_contract_read(path), nil)
    },
  )
}

pipeline test_release_audit_ci_contract_drift(task) {
  const cfg = contract()
  const ci = {
    jobs: {
      fmt: {name: "Format check", steps: [{id: "release-audit-format", run: "make fmt-check"}]},
      "package-audit": {
        name: "Package audit",
        steps: [{id: "release-audit-package", run: "./scripts/verify_crate_packages.sh"}],
      },
      "rust-builds": {
        strategy: {matrix: {include: [{kind: "lint", name: "Rust lint"}, {kind: "behavior", name: "Behavior build"}]}},
        steps: [
          {
            id: "release-audit-rust-lint",
            if: "matrix.kind == 'lint'",
            run: "./scripts/ci/run_rust_lint_lane.sh",
          },
        ],
      },
      "rust-test": {
        name: "Rust test",
        steps: [
          {
            id: "release-audit-rust-test",
            env: {HARN_LLM_CALLS_DISABLED: "1"},
            run: "scripts/ci/run_rust_test_lane.sh cargo nextest run --workspace --profile ci -E 'not test(test_linux_process_sandbox_catches_ten_process_escapes)'",
          },
        ],
      },
      "rust-security": {
        name: "Rust security proof",
        steps: [
          {
            id: "release-audit-rust-security",
            run: "cargo nextest run --profile ci --archive-file \"$RUNNER_TEMP/harn-behavior/harn-security.tar.zst\" --workspace-remap \"$GITHUB_WORKSPACE\" -E 'test(test_linux_process_sandbox_catches_ten_process_escapes)'",
          },
        ],
      },
      "harn-audit": {
        name: "Harn conformance + audit",
        steps: [
          {
            id: "release-audit-harn",
            env: {AUDIT_GATES_CONCURRENCY: "2", HARN_CONFORMANCE_SHARDS: "2"},
            run: "./scripts/audit_gates.sh",
          },
        ],
      },
    },
  }
  assert_eq(release_audit_ci_contract_report(cfg, ci).ok, true)
  assert_eq(
    release_audit_ci_contract_report(
      cfg,
      {
        ...ci,
        jobs: {
          ...ci.jobs,
          "rust-test": {
            ...ci.jobs["rust-test"],
            steps: ci.jobs["rust-test"].steps
              .map(
              { step ->
                if step.id == "release-audit-rust-test" {
                  {...step, run: "make test-affected"}
                } else {
                  step
                }
              },
            ).to_list(),
          },
        },
      },
    ).errors,
    ["proof command drift: release-audit-rust-test"],
  )
  assert_eq(
    release_audit_ci_contract_report(
      cfg,
      {
        ...ci,
        jobs: {
          ...ci.jobs,
          "rust-test": {
            ...ci.jobs["rust-test"],
            steps: ci.jobs["rust-test"].steps
              .map(
              { step ->
                if step.id == "release-audit-rust-test" {
                  {...step, env: {}}
                } else {
                  step
                }
              },
            ).to_list(),
          },
        },
      },
    ).errors,
    ["proof environment drift: release-audit-rust-test:HARN_LLM_CALLS_DISABLED"],
  )
  assert_eq(
    release_audit_ci_contract_report(
      cfg,
      {
        ...ci,
        jobs: {
          ...ci.jobs,
          "harn-audit": {
            ...ci.jobs["harn-audit"],
            steps: [{id: "release-audit-harn", env: {AUDIT_GATES_CONCURRENCY: "2"}, run: "./scripts/audit_gates.sh"}],
          },
        },
      },
    ).errors,
    ["proof environment drift: release-audit-harn:HARN_CONFORMANCE_SHARDS"],
  )
  assert_eq(
    release_audit_ci_contract_report(
      cfg,
      {
        ...ci,
        jobs: {
          ...ci.jobs,
          "rust-builds": {
            ...ci.jobs["rust-builds"],
            strategy: {matrix: {include: [{kind: "behavior", name: "Behavior build"}]}},
          },
        },
      },
    ).reason,
    "ci_contract_drift",
  )
}
