import { omit } from "std/json"
import { RELEASE_PLATFORMS } from "../lib/release_platforms"
import {
  release_audit_ci_contract_report,
  release_audit_contract_parse,
  release_audit_receipt_plan,
  release_audit_residual_plan,
  release_audit_source_plan,
} from "../release_audit_contract"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const OTHER_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const BINARY_SHA = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

fn contract() {
  return {
    schema_version: "harn.release_audit_contract.v1",
    platforms: RELEASE_PLATFORMS,
    lanes: [
      {name: "source-audit", runner: "run_source_audit", proof: "merge_group"},
      {name: "release-metadata", runner: "run_release_metadata", proof: "residual"},
    ],
    merge_group_jobs: [
      {
        name: "Source audit",
        job_id: "source-audit",
        matrix_kind: "",
        proofs: ["source-audit"],
        steps: [{id: "source-audit", condition: "", run: "make source-audit", required_env: {}}],
      },
    ],
  }
}

fn platform(kind: string, id: int, job_id: int, duration_ms: int) {
  const workflow = ".github/workflows/" + kind + "-nightly.yml"
  const job_name = if kind == "windows" {
    "Workspace nextest (windows-latest)"
  } else {
    "Workspace nextest (macos-latest)"
  }
  const run_url = "https://github.com/burin-labs/harn/actions/runs/${id}"
  const qualification = {
    kind: "harn.native_qualification.v1",
    repository: "burin-labs/harn",
    source_sha: SHA,
    policy_sha: SHA,
    run_id: id,
    run_attempt: 1,
    phases: RELEASE_PLATFORMS.find({ row -> row.name == kind }).required_steps,
  }
  return {
    platform: kind,
    qualification: qualification,
    acquisition: {
      action: "dispatch_new",
      selection_reason: "no_reusable_exact_run",
      reused: false,
      cancellations: [],
    },
    workflow_path: workflow,
    required_job: job_name,
    run: {
      repo: "burin-labs/harn",
      id: id,
      workflow_path: workflow,
      run_attempt: 1,
      event: "workflow_dispatch",
      status: "completed",
      conclusion: "success",
      head_sha: SHA,
      head_branch: "main",
      url: run_url,
    },
    jobs: {
      repo: "burin-labs/harn",
      run_id: id,
      total_count: 1,
      jobs: [
        {
          id: job_id,
          run_id: id,
          name: job_name,
          status: "completed",
          conclusion: "success",
          steps: RELEASE_PLATFORMS.find({ row -> row.name == kind }).required_steps.map(
            { name -> {name: name, status: "completed", conclusion: "success"} },
          )
            .to_list(),
          url: run_url + "/job/${job_id}",
        },
      ],
      page: 1,
      per_page: 100,
    },
    started_at_ms: 100,
    completed_at_ms: 100 + duration_ms,
    duration_ms: duration_ms,
  }
}

fn receipt() {
  return {
    schema_version: "harn.release_audit_receipt.v2",
    proof_kind: "hosted_platform",
    source: {repo: "burin-labs/harn", branch: "main", sha: SHA, remote_sha_after: SHA},
    platforms: [platform("windows", 123, 456, 900), platform("macos", 124, 457, 700)],
    local_source: {
      head_sha: SHA,
      status: "success",
      lane_names: ["source-audit"],
      started_at_ms: 100,
      completed_at_ms: 600,
      duration_ms: 500,
    },
    join: {started_at_ms: 100, completed_at_ms: 1000, duration_ms: 900, critical_path: "windows"},
    warm: {
      head_sha: SHA,
      command: "cargo build -p harn-cli --bin harn --locked",
      binary_sha256: BINARY_SHA,
      status: "success",
    },
  }
}

pipeline test_main_policy_source_receipt(harness: Harness, task: unknown) {
  const macos = platform("macos", 124, 457, 700)
  const qualified = {
    ...macos,
    run: {...macos.run, head_sha: OTHER_SHA},
    qualification: {...macos.qualification, policy_sha: OTHER_SHA},
  }
  const windows = platform("windows", 123, 456, 900)
  const value = {...receipt(), platforms: [windows, qualified]}
  assert_eq(release_audit_receipt_plan(contract(), value, SHA, BINARY_SHA).ok, true)
  for defect in [
    {...qualified.qualification, source_sha: OTHER_SHA},
    {...qualified.qualification, policy_sha: SHA},
    {...qualified.qualification, run_id: 125},
    {...qualified.qualification, run_attempt: 2},
    {...qualified.qualification, phases: []},
  ] {
    assert_eq(
      release_audit_receipt_plan(
        contract(),
        {...value, platforms: [windows, {...qualified, qualification: defect}]},
        SHA,
        BINARY_SHA,
      ).reason,
      "platform_qualification_mismatch",
    )
  }
  assert_eq(
    release_audit_receipt_plan(
      contract(),
      {...value, platforms: [windows, omit(qualified, ["qualification"])]},
      SHA,
      BINARY_SHA,
    ).reason,
    "platform_qualification_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(
      contract(),
      {
        ...value,
        platforms: [windows, {...qualified, run: {...qualified.run, head_branch: "topic"}}],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "platform_qualification_mismatch",
  )
}

pipeline test_release_audit_contract_and_hosted_receipt(harness: Harness, task: unknown) {
  const cfg = release_audit_contract_parse(contract())
  assert(cfg != nil)
  const source = release_audit_source_plan(cfg, SHA)
  assert_eq(source.reason, "source_only")
  assert_eq(source.proof_kind, "local_source")
  assert_eq(source.lane_names, ["source-audit"])
  const accepted = release_audit_receipt_plan(cfg, receipt(), SHA, BINARY_SHA)
  assert_eq(accepted.ok, true)
  assert_eq(accepted.receipt_reused, true)
  assert_eq(accepted.proof_kind, "hosted_platform")
  assert_eq(accepted.lane_names, ["release-metadata"])
  // The pre-cut rehearsal runs exactly the lanes an accepted receipt would.
  const residual = release_audit_residual_plan(cfg, SHA)
  assert_eq(residual.reason, "residual_only")
  assert_eq(residual.receipt_reused, false)
  assert_eq(residual.lane_names, accepted.lane_names)
  assert_eq(residual.lane_runners, accepted.lane_runners)
  const advanced_base = release_audit_receipt_plan(
    cfg,
    {...receipt(), source: {...receipt().source, remote_sha_after: OTHER_SHA}},
    SHA,
    BINARY_SHA,
  )
  assert_eq(advanced_base.receipt_reused, true)
  assert_eq(advanced_base.proof_kind, "hosted_platform")
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...receipt(), source: {...receipt().source, sha: OTHER_SHA}},
      SHA,
      BINARY_SHA,
    ).reason,
    "head_sha_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...receipt(),
        platforms: [platform("windows", 123, 456, 900), platform("windows", 123, 456, 900)],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "platform_proofs_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...receipt(),
        platforms: [
          {
            ...platform("windows", 123, 456, 900),
            run: {...platform("windows", 123, 456, 900).run, conclusion: "failure"},
          },
          platform("macos", 124, 457, 700),
        ],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "invalid_receipt",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...receipt(),
        platforms: [
          {
            ...platform("windows", 123, 456, 900),
            workflow_path: ".github/workflows/macos-nightly.yml",
          },
          platform("macos", 124, 457, 700),
        ],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "platform_identity_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...receipt(), join: {...receipt().join, critical_path: "macos"}},
      SHA,
      BINARY_SHA,
    ).reason,
    "join_timing_mismatch",
  )
  assert_eq(
    release_audit_receipt_plan(cfg, {...receipt(), extra: true}, SHA, BINARY_SHA).reason,
    "invalid_receipt",
  )
  // The certifier records how it obtained each run. A reused run is only as
  // strong as its exact-SHA match, so the decision is proof and is validated
  // rather than merely tolerated: the receipt carried `acquisition` for two
  // releases while the closed schema rejected every one of them.
  const reused_platform = {
    ...platform("windows", 123, 456, 900),
    acquisition: {
      action: "reuse_success",
      selection_reason: "successful_exact_run",
      reused: true,
      cancellations: [
        {repo: "burin-labs/harn", run_id: 77, accepted: true, state: "cancel_requested"},
      ],
    },
  }
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...receipt(), platforms: [reused_platform, platform("macos", 124, 457, 700)]},
      SHA,
      BINARY_SHA,
    ).reason,
    "receipt_accepted",
  )
  for bad_acquisition in [
    {
      action: "not_a_real_action",
      selection_reason: "successful_exact_run",
      reused: true,
      cancellations: [],
    },
    {
      action: "reuse_success",
      selection_reason: "not_a_real_reason",
      reused: true,
      cancellations: [],
    },
    {
      action: "reuse_success",
      selection_reason: "successful_exact_run",
      reused: true,
      cancellations: [],
      unexpected: 1,
    },
    {
      action: "reuse_success",
      selection_reason: "successful_exact_run",
      reused: true,
      cancellations: [{malformed: true}],
    },
  ] {
    assert_eq(
      release_audit_receipt_plan(
        cfg,
        {
          ...receipt(),
          platforms: [
            {...platform("windows", 123, 456, 900), acquisition: bad_acquisition},
            platform("macos", 124, 457, 700),
          ],
        },
        SHA,
        BINARY_SHA,
      ).reason,
      "invalid_receipt",
    )
  }
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...receipt(),
        platforms: [
          omit(platform("windows", 123, 456, 900), ["acquisition"]),
          platform("macos", 124, 457, 700),
        ],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "invalid_receipt",
  )
}

fn windows_advisory(state: string, run_url: string?) {
  return {
    platform: "windows",
    state: state,
    code: "run_unsuccessful",
    message: "Workspace nextest (windows-latest) concluded failure",
    run_url: run_url,
  }
}

/** A receipt the certifier emits when Windows produced no successful proof. */
fn macos_only_receipt(advisories: list) {
  return {
    ...receipt(),
    platforms: [platform("macos", 124, 457, 700)],
    advisories: advisories,
    join: {started_at_ms: 100, completed_at_ms: 800, duration_ms: 700, critical_path: "macos"},
  }
}

/**
 * Native Windows is advisory in release certification. A receipt proves macOS,
 * and accounts for Windows with either a successful proof or an advisory entry.
 */
pipeline test_release_audit_windows_nightly_is_advisory(harness: Harness, task: unknown) {
  const cfg = release_audit_contract_parse(contract())
  assert(cfg != nil)
  // The old two-platform receipt is still accepted, and reports Windows.
  const both = release_audit_receipt_plan(cfg, receipt(), SHA, BINARY_SHA)
  assert_eq(both.reason, "receipt_accepted")
  assert_eq(
    both.advisories,
    [
      "WINDOWS_NIGHTLY_ADVISORY state=success run=https://github.com/burin-labs/harn/actions/runs/123",
    ],
  )
  // macOS plus a Windows advisory certifies and carries the named line.
  const failed = release_audit_receipt_plan(
    cfg,
    macos_only_receipt(
      [windows_advisory("failure", "https://github.com/burin-labs/harn/actions/runs/123")],
    ),
    SHA,
    BINARY_SHA,
  )
  assert_eq(failed.reason, "receipt_accepted")
  assert_eq(failed.receipt_reused, true)
  assert_eq(failed.lane_names, ["release-metadata"])
  assert_eq(
    failed.advisories,
    [
      "WINDOWS_NIGHTLY_ADVISORY state=failure run=https://github.com/burin-labs/harn/actions/runs/123 code=run_unsuccessful",
    ],
  )
  const missing = release_audit_receipt_plan(
    cfg,
    macos_only_receipt([windows_advisory("missing", nil)]),
    SHA,
    BINARY_SHA,
  )
  assert_eq(missing.reason, "receipt_accepted")
  assert_eq(
    missing.advisories,
    ["WINDOWS_NIGHTLY_ADVISORY state=missing run=none code=run_unsuccessful"],
  )
  // Windows only, macOS missing: refused.
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...receipt(),
        platforms: [platform("windows", 123, 456, 900)],
        join: {...receipt().join, critical_path: "windows"},
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "platform_proofs_mismatch",
  )
  // Windows must be accounted for exactly once: not silently absent, and not
  // both proven and advised.
  assert_eq(
    release_audit_receipt_plan(cfg, macos_only_receipt([]), SHA, BINARY_SHA).reason,
    "advisory_platform_unaccounted",
  )
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {...receipt(), advisories: [windows_advisory("failure", nil)]},
      SHA,
      BINARY_SHA,
    ).reason,
    "advisory_platform_unaccounted",
  )
  // A present Windows proof keeps every per-proof check.
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      {
        ...receipt(),
        platforms: [
          {...platform("windows", 123, 456, 900), required_job: "Some other job"},
          platform("macos", 124, 457, 700),
        ],
      },
      SHA,
      BINARY_SHA,
    ).reason,
    "platform_identity_mismatch",
  )
  // Advisory entries are closed: an unknown state or platform is refused.
  assert_eq(
    release_audit_receipt_plan(
      cfg,
      macos_only_receipt([{...windows_advisory("failure", nil), state: "flaky"}]),
      SHA,
      BINARY_SHA,
    ).reason,
    "invalid_receipt",
  )
  // A rejected receipt carries no advisory to print.
  assert_eq(
    release_audit_receipt_plan(cfg, {...receipt(), extra: true}, SHA, BINARY_SHA).advisories,
    [],
  )
}

fn lint_leg(kind: string, name: string) {
  return {
    name: name,
    job_id: "lint",
    matrix_kind: kind,
    proofs: ["source-audit"],
    steps: [{id: "lint", condition: "", run: "./lint.sh", required_env: {}}],
  }
}

pipeline test_native_platform_policy_projection_cannot_waive_measurement() {
  assert(release_audit_contract_parse(contract()) != nil)
  assert_eq(release_audit_contract_parse({...contract(), platforms: []}), nil)
  assert_eq(
    release_audit_contract_parse(
      {
        ...contract(),
        platforms: RELEASE_PLATFORMS.map({ row -> {...row, required: false} }).to_list(),
      },
    ),
    nil,
  )
  assert_eq(
    release_audit_contract_parse(
      {
        ...contract(),
        platforms: RELEASE_PLATFORMS.map({ row -> {...row, required_steps: []} }).to_list(),
      },
    ),
    nil,
  )
}

pipeline test_hosted_native_receipt_requires_each_executed_phase() {
  const cfg = release_audit_contract_parse(contract())
  assert(cfg != nil)
  const native = platform("macos", 124, 457, 700)
  const job = native.jobs.jobs[0]
  assert_eq(len(job.steps), 8)
  for phase in job.steps {
    const missing = job.steps.filter({ step -> step.name != phase.name }).to_list()
    const skipped = job.steps.map(
      { step ->
        if step.name == phase.name {
          {...step, conclusion: "skipped"}
        } else {
          step
        }
      },
    )
      .to_list()
    for steps in [missing, skipped, job.steps + [phase]] {
      const candidate = {
        ...receipt(),
        platforms: [
          platform("windows", 123, 456, 900),
          {...native, jobs: {...native.jobs, jobs: [{...job, steps: steps}]}},
        ],
      }
      assert_eq(
        release_audit_receipt_plan(cfg, candidate, SHA, BINARY_SHA).reason,
        "platform_steps_unmeasured",
      )
    }
  }
}

fn lint_ci(kinds: list<dict>) {
  return {
    jobs: {
      lint: {
        name: "lint",
        strategy: {matrix: {include: kinds}},
        steps: [{id: "lint", run: "./lint.sh"}],
      },
    },
  }
}

pipeline test_release_audit_ci_contract_requires_every_matrix_leg(harness: Harness, task: unknown) {
  const cfg = release_audit_contract_parse(
    {
      ...contract(),
      merge_group_jobs: [lint_leg("workspace", "Lint"), lint_leg("lean", "Lint (lean)")],
    },
  )
  assert(cfg != nil)
  const both = [{kind: "workspace", name: "Lint"}, {kind: "lean", name: "Lint (lean)"}]
  const covered = release_audit_ci_contract_report(cfg, lint_ci(both))
  assert_eq(covered.errors, [])
  assert_eq(covered.ok, true)
  // A leg the proof does not name could fail while the proof reads complete.
  const extra = release_audit_ci_contract_report(
    cfg,
    lint_ci(both + [{kind: "extra", name: "Lint (extra)"}]),
  )
  assert_eq(extra.ok, false)
  assert_eq(extra.errors, ["uncontracted matrix kind: lint:extra"])
}
