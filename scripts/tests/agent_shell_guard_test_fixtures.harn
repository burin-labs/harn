import * as shell_guard from "../agent_shell_guard.harn"
import {
  MakeTargetCensus,
  NO_CONFIG_ALIASES,
  ShellGuardDecision,
  WorktreeAdmissionCensus,
} from "../agent_shell_guard.harn"

pub const TEST_GIT_BUILTINS: fn(string) -> list<string> = { program ->
  [
    "config",
    "diff",
    "log",
    "status",
    "worktree",
    "rev-parse",
    "commit",
    "show",
    "version",
    "init",
    "stash",
  ]
}

pub fn decision(
  payload: string,
  census: WorktreeAdmissionCensus,
  make_targets: MakeTargetCensus,
  alias_lookup: fn(list<string>) -> dict = NO_CONFIG_ALIASES,
  builtin_lookup: fn(string) -> list<string> = TEST_GIT_BUILTINS,
) -> ShellGuardDecision {
  return shell_guard.decision(payload, census, make_targets, alias_lookup, builtin_lookup)
}
