fn run_matrix(args) {
  const root = dirname(dirname(runtime_paths().asset_root))
  return shell_at(root, "bash scripts/release_runner_matrix.sh " + args)
}

fn matrix(args) {
  const result = run_matrix(args)
  if !result.success {
    throw result.stderr
  }
  return json_parse(result.stdout)
}

fn runners(rows) {
  return rows.map({ row -> row.target + "=" + row.runner })
}

pipeline test_release_runner_policy_pins_every_mode(task) {
  const standard = [
    "x86_64-apple-darwin=macos-15-intel",
    "aarch64-apple-darwin=macos-latest",
    "x86_64-unknown-linux-gnu=ubuntu-latest",
    "aarch64-unknown-linux-gnu=ubuntu-24.04-arm",
    "x86_64-pc-windows-msvc=windows-latest",
  ]
  assert_eq(runners(matrix("--mode warm")), standard)
  assert_eq(runners(matrix("--mode primary")), standard)
  assert_eq(runners(matrix("--mode recovery")), standard)
}

pipeline test_release_runner_policy_selects_targeted_fast_capacity(task) {
  assert_eq(
    matrix("--mode benchmark --profile fast --targets x86_64-apple-darwin"),
    [
      {
        target: "x86_64-apple-darwin",
        runner: "macos-15-large",
        release_codegen_units: 16,
        use_sccache: "false",
      },
    ],
  )
  assert_eq(
    runners(matrix("--mode recovery --profile fast --targets aarch64-apple-darwin")),
    ["aarch64-apple-darwin=macos-15-xlarge"],
  )
}

pipeline test_release_runner_policy_rejects_unsafe_requests(task) {
  assert_eq(run_matrix("--mode benchmark --profile policy").success, false)
  assert_eq(run_matrix("--mode benchmark --profile fast").success, false)
  assert_eq(run_matrix("--mode warm --profile fast").success, false)
  assert_eq(run_matrix("--mode recovery --targets unknown-target").success, false)
}
