import "std/schema"

fn run_matrix(fs: HarnessFs, process: HarnessProcess, args: string) {
  const root = dirname(dirname(fs.runtime_paths().asset_root))
  return process.shell_at(root, "bash scripts/release_runner_matrix.sh " + args)
}

fn run_matrix_with_policy(
  fs: HarnessFs,
  process: HarnessProcess,
  random: HarnessRandom,
  policy: dict,
  args: string,
) {
  const root = dirname(dirname(fs.runtime_paths().asset_root))
  const path = path_join(
    fs.workspace_temp_dir(),
    "release-runner-policy-" + random.uuid_v7() + ".json",
  )
  fs.write_text(path, json_stringify(policy))
  return process.shell_at(
    root,
    "HARN_RELEASE_RUNNER_POLICY=" + path + " bash scripts/release_runner_matrix.sh " + args,
  )
}

fn matrix(fs: HarnessFs, process: HarnessProcess, args: string) {
  const result = run_matrix(fs, process, args)
  if !result.success {
    throw result.stderr
  }
  return json_parse(result.stdout)
}

fn runners(rows: any) {
  return rows.map({ row -> row.target + "=" + row.runner })
}

fn cache_prefixes(rows: any) {
  return rows.map({ row -> row.target + "=" + row.rust_cache_broad_restore_prefix })
}

pipeline test_release_runner_policy_pins_every_mode(harness: Harness, task: unknown) {
  const standard = [
    "x86_64-apple-darwin=macos-latest",
    "aarch64-apple-darwin=macos-latest",
    "x86_64-unknown-linux-gnu=ubuntu-22.04",
    "aarch64-unknown-linux-gnu=ubuntu-22.04",
    "x86_64-pc-windows-msvc=windows-latest",
  ]
  assert_eq(runners(matrix(harness.fs, harness.process, "--mode warm")), standard)
  // Public repository: every release mode runs on GitHub's free standard
  // runners (harn#9370). No larger, Ubicloud or Blacksmith runner bills.
  const primary = standard
  const recovery = standard
  assert_eq(runners(matrix(harness.fs, harness.process, "--mode primary")), primary)
  assert_eq(runners(matrix(harness.fs, harness.process, "--mode candidate")), primary)
  assert_eq(runners(matrix(harness.fs, harness.process, "--mode recovery")), recovery)
  assert_eq(
    cache_prefixes(matrix(harness.fs, harness.process, "--mode primary")),
    [
      "x86_64-apple-darwin=v0-rust-release-x86_64-apple-darwin-Darwin-arm64-",
      "aarch64-apple-darwin=v0-rust-release-aarch64-apple-darwin-Darwin-arm64-",
      "x86_64-unknown-linux-gnu=v1-rust-release-glibc235-x86_64-unknown-linux-gnu-Linux-x64-",
      "aarch64-unknown-linux-gnu=v1-rust-release-glibc235-aarch64-unknown-linux-gnu-Linux-x64-",
      "x86_64-pc-windows-msvc=v0-rust-release-x86_64-pc-windows-msvc-Windows_NT-x64-",
    ],
  )
}

pipeline test_release_runner_policy_selects_targeted_fast_capacity(
  harness: Harness,
  task: unknown,
) {
  assert_eq(
    matrix(
      harness.fs,
      harness.process,
      "--mode benchmark --profile fast --targets x86_64-apple-darwin",
    ),
    [
      {
        target: "x86_64-apple-darwin",
        glibc_max: nil,
        runner: "macos-latest",
        rust_cache_broad_restore_prefix: "v0-rust-release-x86_64-apple-darwin-Darwin-arm64-",
        use_sccache: "true",
        sccache_backend: "local",
      },
    ],
  )
  assert_eq(
    runners(
      matrix(
        harness.fs,
        harness.process,
        "--mode recovery --profile fast --targets aarch64-apple-darwin",
      ),
    ),
    ["aarch64-apple-darwin=macos-latest"],
  )
}

pipeline test_release_runner_policy_rejects_unsafe_requests(harness: Harness, task: unknown) {
  const root = dirname(dirname(harness.fs.runtime_paths().asset_root))
  assert_eq(
    run_matrix(harness.fs, harness.process, "--mode benchmark --profile policy").success,
    false,
  )
  assert_eq(
    run_matrix(harness.fs, harness.process, "--mode benchmark --profile fast").success,
    false,
  )
  assert_eq(run_matrix(harness.fs, harness.process, "--mode warm --profile fast").success, false)
  assert_eq(
    run_matrix(harness.fs, harness.process, "--mode recovery --targets unknown-target").success,
    false,
  )
  // The policy is consumed by scripts/release_runner_matrix.sh, so no Harn
  // module owns its shape. This test spreads the real document to build
  // deliberately-invalid variants, and each assertion below is only meaningful
  // if the base it started from was actually valid.
  const policy = schema_expect(
    json_parse(harness.fs.read_text(path_join(root, ".github", "release-runner-policy.json"))),
    schema_object(
      {
        schema_version: schema_field(schema_int()),
        targets: schema_field(
          schema_list(
            schema_object(
              {
                target: schema_field(schema_string()),
                glibc_max: schema_field(schema_union([schema_string(), schema_literal(nil)])),
                // Stringly-typed: scripts/release_runner_matrix.sh compares it as text,
                // so "false" here is the string, not a boolean.
                use_sccache: schema_field(schema_enum(["true", "false"])),
                sccache_backend: schema_field(schema_enum(["sticky", "local", "install", "none"])),
                runners: schema_field(schema_dict(schema_string())),
              },
              {additional_properties: true},
            ),
            {min_items: 1},
          ),
        ),
      },
      {additional_properties: true},
    ),
  )
  assert_eq(
    run_matrix_with_policy(
      harness.fs,
      harness.process,
      harness.random,
      {
        ...policy,
        targets: policy.targets.map(
          { target ->
            if target.target == "x86_64-apple-darwin" {
              return {...target, sccache_backend: "sticky"}
            }
            return target
          },
        ),
      },
      "--mode primary",
    ).success,
    false,
    "GitHub capacity cannot mount Blacksmith compiler storage",
  )
  assert_eq(
    run_matrix_with_policy(
      harness.fs,
      harness.process,
      harness.random,
      {
        ...policy,
        targets: policy.targets.map(
          { target ->
            if target.target == "x86_64-apple-darwin" {
              return {
                ...target,
                sccache_backend: "sticky",
                runners: {
                  warm: "blacksmith-12vcpu-macos-15",
                  primary: "blacksmith-12vcpu-macos-15",
                  recovery: "blacksmith-12vcpu-macos-15",
                  standard: "blacksmith-12vcpu-macos-15",
                  fast: "blacksmith-12vcpu-macos-15",
                },
              }
            }
            return target
          },
        ),
      },
      "--mode primary",
    ).success,
    true,
    "Blacksmith capacity retains its supported sticky backend",
  )
  assert_eq(
    run_matrix_with_policy(
      harness.fs,
      harness.process,
      harness.random,
      {...policy, typo: true},
      "--mode primary",
    ).success,
    false,
  )
  assert_eq(
    run_matrix_with_policy(
      harness.fs,
      harness.process,
      harness.random,
      {
        ...policy,
        runner_registry: {
          ...policy.runner_registry,
          "ubuntu-22.04": {...policy.runner_registry["ubuntu-22.04"], glibc_version: "2.39"},
        },
      },
      "--mode primary",
    ).success,
    false,
  )
  assert_eq(
    run_matrix_with_policy(
      harness.fs,
      harness.process,
      harness.random,
      {
        ...policy,
        targets: policy.targets.map(
          { target ->
            if target.target == "x86_64-unknown-linux-gnu" {
              return {...target, runners: {...target.runners, primary: "macos-15-xlarge"}}
            }
            return target
          },
        ),
      },
      "--mode primary",
    ).success,
    false,
  )
  assert_eq(
    run_matrix_with_policy(
      harness.fs,
      harness.process,
      harness.random,
      {
        ...policy,
        targets: [{...policy.targets[0], runners: {...policy.targets[0].runners, typo: "runner"}}],
      },
      "--mode primary",
    ).success,
    false,
  )
}
