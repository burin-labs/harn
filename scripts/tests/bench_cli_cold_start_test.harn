import "../bench_cli_cold_start.harn"

const CONTEXT = {host: "Linux x86_64", timer: "monotonic fallback"}

@test
pipeline test_load_budgets_defaults_and_command_override(harness: Harness, task: unknown) {
  const budgets = load_budgets_text(
    """
[defaults]
cold_ms = 300
regression_x = 1.5

[commands.version]
cold_ms = 180

[commands."try --help"]
regression_x = 1.1
""",
  )
  assert_eq(budgets.version.cold_ms, 180.0)
  assert_eq(budgets.version.regression_x, 1.5)
  assert_eq(budgets["try --help"].cold_ms, 300.0)
  assert_eq(budgets["try --help"].regression_x, 1.1)
}

@test
pipeline test_load_baseline_blank_is_empty(harness: Harness, task: unknown) {
  assert_eq(load_baseline_text(" \n"), {})
}

@test
pipeline test_most_recent_baseline_skips_current_sha(harness: Harness, task: unknown) {
  const payload = {
    current: {...CONTEXT, captured_at: "2026-01-03T00:00:00Z", commands: {version: {cold_ms: 1.0}}},
    old: {...CONTEXT, captured_at: "2026-01-01T00:00:00Z", commands: {version: {cold_ms: 10.0}}},
    newest: {...CONTEXT, captured_at: "2026-01-02T00:00:00Z", commands: {version: {cold_ms: 5.0}}},
  }
  const found = most_recent_baseline_for(payload, "version", "current", CONTEXT)
  assert_eq(found.sha, "newest")
  assert_eq(found.cold_ms, 5.0)
}

@test
pipeline test_most_recent_baseline_missing(harness: Harness, task: unknown) {
  const found = most_recent_baseline_for({}, "version", "sha", CONTEXT)
  assert_eq(found.sha, nil)
  assert_eq(found.cold_ms, nil)
}

@test
pipeline test_cross_host_and_timer_baselines_cannot_decide_regressions() {
  const mac = {
    host: "Apple M5 Pro, Darwin arm64 (Darwin 25.5.0)",
    timer: CONTEXT.timer,
    captured_at: "2026-07-04",
    commands: {version: {cold_ms: 53.0}},
  }
  const budget = {cold_ms: 200.0, regression_x: 1.25}
  const missing = most_recent_baseline_for({mac: mac}, "version", "current", CONTEXT)
  assert_eq(missing.sha, nil)
  assert_eq(failure_reasons(68.0, budget, missing), [])
  assert_eq(failure_reasons(201.0, budget, missing), ["exceeds budget 200.0 ms"])
  const matching = {...CONTEXT, captured_at: "2026-07-03", commands: {version: {cold_ms: 53.0}}}
  const other_timer = {...matching, timer: "hyperfine", captured_at: "2026-07-05"}
  const found = most_recent_baseline_for(
    {mac: mac, linux: matching, hyperfine: other_timer},
    "version",
    "current",
    CONTEXT,
  )
  assert_eq(found.sha, "linux")
  assert_eq(failure_reasons(68.0, budget, found), ["exceeds 1.25x baseline (53.0 ms from linux)"])
}

@test
pipeline test_build_invocation_expands_trace_paths(harness: Harness, task: unknown) {
  const dir = harness.fs.workspace_temp_dir() + "/harn-cold-start-test-" + harness.random.uuid_v7()
  harness.fs.mkdir(dir)
  defer {
    harness.fs.delete(dir)
  }
  const args = build_invocation(
    harness.fs,
    ["trace", "import", "{trace_input}", "--out", "{trace_output}"],
    dir,
  )
  assert_eq(args[2], path_join(dir, "trace_input.jsonl"))
  assert_eq(args[4], path_join(dir, "trace_output.jsonl"))
  assert_eq(harness.fs.exists(path_join(dir, "trace_input.jsonl")), true)
}

@test
pipeline test_select_commands_filter(harness: Harness, task: unknown) {
  const selected = select_commands("version")
  assert_eq(selected.ok, true)
  assert_eq(selected.commands.count, 1)
  assert_eq(selected.commands[0].key, "version")
  const missing = select_commands("version,missing")
  assert_eq(missing.ok, false)
  assert_eq(missing.missing, ["missing"])
}

@test
pipeline test_failure_reasons_cover_budget_and_baseline(harness: Harness, task: unknown) {
  const reasons = failure_reasons(
    151.0,
    {cold_ms: 100.0, regression_x: 1.25},
    {sha: "abcdef123456", cold_ms: 100.0},
  )
  assert_eq(reasons.count, 2)
  assert_eq(reasons[0], "exceeds budget 100.0 ms")
  assert_eq(reasons[1], "exceeds 1.25x baseline (100.0 ms from abcdef12)")
}

@test
pipeline test_merge_baseline_append_only_without_update(harness: Harness, task: unknown) {
  const merged = merge_baseline(
    {
      payload: {
        sha: {
          host: "old-host",
          timer: "monotonic fallback",
          harn_version: "old-version",
          captured_at: "old",
          commands: {version: {cold_ms: 10.0}},
        },
      },
      sha: "sha",
      measurements: {version: {cold_ms: 20.0}, "try --help": {cold_ms: 30.0}},
      update_baseline: false,
      host: "old-host",
      timer: "monotonic fallback",
      version: "version",
      captured_at: "now",
    },
  )
  assert_eq(merged.sha.host, "old-host")
  assert_eq(merged.sha.harn_version, "old-version")
  assert_eq(merged.sha.captured_at, "now")
  assert_eq(merged.sha.commands.version.cold_ms, 10.0)
  assert_eq(merged.sha.commands["try --help"].cold_ms, 30.0)
}

@test
pipeline test_merge_baseline_update_overwrites_current_slot(harness: Harness, task: unknown) {
  const merged = merge_baseline(
    {
      payload: {sha: {...CONTEXT, commands: {version: {cold_ms: 10.0}}}},
      sha: "sha",
      measurements: {version: {cold_ms: 20.0}},
      update_baseline: true,
      host: CONTEXT.host,
      timer: CONTEXT.timer,
      version: "version",
      captured_at: "now",
    },
  )
  assert_eq(merged.sha.commands.version.cold_ms, 20.0)
}

@test
pipeline test_parse_positive_int(harness: Harness, task: unknown) {
  assert_eq(parse_positive_int("N", "3").value, 3)
  assert_eq(parse_positive_int("N", "0").ok, false)
  assert_eq(parse_positive_int("N", "wat").error, "N must be an integer, got 'wat'")
}

@test
pipeline test_baseline_slot_cannot_mix_measurement_contexts() {
  const result = try {
    merge_baseline(
      {
        payload: {sha: {...CONTEXT, commands: {version: {cold_ms: 53.0}}}},
        sha: "sha",
        measurements: {"try --help": {cold_ms: 17.0}},
        update_baseline: true,
        host: "Darwin arm64",
        timer: CONTEXT.timer,
        version: "harn",
        captured_at: "now",
      },
    )
    "accepted"
  } catch (err) {
    to_string(err)
  }
  assert(result.contains("different host or timer"))
}
