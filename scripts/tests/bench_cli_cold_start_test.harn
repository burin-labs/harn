import "../bench_cli_cold_start.harn"

@test
pipeline test_load_budgets_defaults_and_command_override(task) {
  const budgets = load_budgets_text(
    """
[defaults]
cold_ms = 300
regression_x = 1.5

[commands.version]
cold_ms = 180

[commands."try --help"]
regression_x = 1.1
""",
  )
  assert_eq(budgets.version.cold_ms, 180.0)
  assert_eq(budgets.version.regression_x, 1.5)
  assert_eq(budgets["try --help"].cold_ms, 300.0)
  assert_eq(budgets["try --help"].regression_x, 1.1)
}

@test
pipeline test_load_baseline_blank_is_empty(task) {
  assert_eq(load_baseline_text(" \n"), {})
}

@test
pipeline test_most_recent_baseline_skips_current_sha(task) {
  const payload = {
    current: {captured_at: "2026-01-03T00:00:00Z", commands: {version: {cold_ms: 1.0}}},
    old: {captured_at: "2026-01-01T00:00:00Z", commands: {version: {cold_ms: 10.0}}},
    newest: {captured_at: "2026-01-02T00:00:00Z", commands: {version: {cold_ms: 5.0}}},
  }
  const found = most_recent_baseline_for(payload, "version", "current")
  assert_eq(found.sha, "newest")
  assert_eq(found.cold_ms, 5.0)
}

@test
pipeline test_most_recent_baseline_missing(task) {
  const found = most_recent_baseline_for({}, "version", "sha")
  assert_eq(found.sha, nil)
  assert_eq(found.cold_ms, nil)
}

@test
pipeline test_build_invocation_expands_trace_paths(task) {
  const dir = harness.fs.temp_dir() + "/harn-cold-start-test-" + uuid_v7()
  harness.fs.mkdir(dir)
  defer {
    harness.fs.delete(dir)
  }
  const args = build_invocation(["trace", "import", "{trace_input}", "--out", "{trace_output}"], dir)
  assert_eq(args[2], path_join(dir, "trace_input.jsonl"))
  assert_eq(args[4], path_join(dir, "trace_output.jsonl"))
  assert_eq(harness.fs.exists(path_join(dir, "trace_input.jsonl")), true)
}

@test
pipeline test_select_commands_filter(task) {
  const selected = select_commands("version")
  assert_eq(selected.ok, true)
  assert_eq(selected.commands.count, 1)
  assert_eq(selected.commands[0].key, "version")
  const missing = select_commands("version,missing")
  assert_eq(missing.ok, false)
  assert_eq(missing.missing, ["missing"])
}

@test
pipeline test_failure_reasons_cover_budget_and_baseline(task) {
  const reasons = failure_reasons(151.0, {cold_ms: 100.0, regression_x: 1.25}, {sha: "abcdef123456", cold_ms: 100.0})
  assert_eq(reasons.count, 2)
  assert_eq(reasons[0], "exceeds budget 100.0 ms")
  assert_eq(reasons[1], "exceeds 1.25x baseline (100.0 ms from abcdef12)")
}

@test
pipeline test_merge_baseline_append_only_without_update(task) {
  const merged = merge_baseline(
    {
      sha: {
        host: "old-host",
        harn_version: "old-version",
        captured_at: "old",
        commands: {version: {cold_ms: 10.0}},
      },
    },
    "sha",
    {version: {cold_ms: 20.0}, "try --help": {cold_ms: 30.0}},
    false,
    "host",
    "version",
    "now",
  )
  assert_eq(merged.sha.host, "old-host")
  assert_eq(merged.sha.harn_version, "old-version")
  assert_eq(merged.sha.captured_at, "now")
  assert_eq(merged.sha.commands.version.cold_ms, 10.0)
  assert_eq(merged.sha.commands["try --help"].cold_ms, 30.0)
}

@test
pipeline test_merge_baseline_update_overwrites_current_slot(task) {
  const merged = merge_baseline(
    {sha: {commands: {version: {cold_ms: 10.0}}}},
    "sha",
    {version: {cold_ms: 20.0}},
    true,
    "host",
    "version",
    "now",
  )
  assert_eq(merged.sha.commands.version.cold_ms, 20.0)
}

@test
pipeline test_parse_positive_int(task) {
  assert_eq(parse_positive_int("N", "3").value, 3)
  assert_eq(parse_positive_int("N", "0").ok, false)
  assert_eq(parse_positive_int("N", "wat").error, "N must be an integer, got 'wat'")
}
