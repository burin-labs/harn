import { AgentModelSpec } from "std/agent/options_types"
import {
  AgentGateEntry,
  AgentGateRegistry,
  agent_gate_audit,
  agent_gate_findings,
  agent_gate_reads,
} from "std/dev/agent_gates"

type GateEntries = list<AgentGateEntry>

@test
// Every key declared on the compiled model shape must be inventoried, and the
// model inventory files must not carry a key the shape does not declare.
//
// The two directions read different sets on purpose. Entry names share one flat
// namespace and the registry refuses a duplicate, so a declared key may be
// filed under whichever entry file owns its theme: `run_id` sits in the
// execution spec and `token_budget` in the budget file. Asking whether a
// declared key is inventoried therefore has to ask the WHOLE registry, the same
// list of files the audit itself runs over, rather than two filenames repeated
// here. Keying the question on a hand-picked pair made a correctly filed key
// indistinguishable from a missing one, and a key added to the shape could not
// be satisfied at all: filing it in the model file duplicates the existing
// entry and the registry throws.
pipeline test_model_setting_inventory_matches_compiled_top_level_shape(
  harness: Harness,
  task: unknown,
) {
  const root = path_join(harness.fs.source_dir(), "../../spec/agent-gates")
  const registry = schema_expect(
    json_parse(harness.fs.read_text(path_join(root, "registry.json"))),
    schema_of(AgentGateRegistry),
  )
  let inventoried: list<string> = []
  for file in registry.entry_files {
    const entries = schema_expect(
      json_parse(harness.fs.read_text(path_join(harness.fs.source_dir(), "../..", file))),
      schema_of(GateEntries),
    )
    inventoried = inventoried + entries.map(fn(entry) { return entry.name })
  }
  const declared = schema_of(AgentModelSpec).properties.keys().map(
    fn(name) { return "AgentSpec." + name },
  )
  assert(len(declared) > 0)
  assert(len(inventoried) > 0)
  const uninventoried = declared.filter(fn(name) { return !contains(inventoried, name) })
  assert_eq(uninventoried.sorted(), [])
  // The reverse direction stays scoped to the files that own this shape: an
  // entry there naming a key the shape no longer declares is stale.
  let model_named: list<string> = []
  for file in ["agent-model-spec.json", "agent-model-routing.json"] {
    const entries = schema_expect(
      json_parse(harness.fs.read_text(path_join(root, file))),
      schema_of(GateEntries),
    )
    model_named = model_named + entries.map(fn(entry) { return entry.name })
  }
  const undeclared = model_named.filter(fn(name) { return !contains(declared, name) })
  assert_eq(undeclared.sorted(), [])
}

fn entry() -> AgentGateEntry {
  return {
    name: "options.enabled",
    kind: "option",
    layer: "runner",
    default: "false",
    readers: [{file: "fixture.harn", line: 1, reader: "example"}],
    reachability: "unknown",
    evidence: "Structural fixture only.",
    verdict: "KEEP-with-expiry",
    reason: "Fixture retention.",
    expiry: "2026-09-20",
  }
}

fn registry(path: string) -> AgentGateRegistry {
  return {
    schema_version: 1,
    repo: "fixture",
    entry_files: [],
    forwarder_files: [],
    non_behavior_files: [],
    name_prefixes: [],
    name_aliases: {},
    projections: [],
    binding_scopes: [],
    scopes: [
      {
        id: "options",
        kind: "option",
        glob: path,
        language: "harn",
        query: "(property_access object: (identifier) @object property: (identifier) @key)",
        prefix: "options.",
        key_form: "field",
      },
    ],
  }
}

@test
pipeline test_structural_read_then_unregistered_key_fails(harness: Harness, task: unknown) {
  const dir = harness.fs.workspace_temp_dir() + "/gate-registry-" + harness.random.uuid_v7()
  harness.fs.mkdir(dir)
  defer {
    harness.fs.delete(dir)
  }
  const path = path_join(dir, "fixture.harn")
  harness.fs.write_text(path, "fn example(options: dict) { return options.enabled }\n")
  const scope = registry(path)
  const original = agent_gate_reads(
    {ast: harness.ast, fs: harness.fs, process: harness.process},
    scope,
  )
  assert_eq(len(original), 1)
  assert_eq(original[0]?.name, "options.enabled")
  assert_eq(agent_gate_findings([entry()], original, []).failures, [])
  let nested_owner = scope
  nested_owner.name_prefixes = [{from: "options.", to: "NestedOptions."}]
  const renamed = agent_gate_reads(
    {ast: harness.ast, fs: harness.fs, process: harness.process},
    nested_owner,
  )
  assert_eq(renamed[0]?.name, "NestedOptions.enabled")
  harness.fs.write_text(path, "fn example(options: dict) { return options.unregistered }\n")
  const changed = agent_gate_reads(
    {ast: harness.ast, fs: harness.fs, process: harness.process},
    scope,
  )
  assert_eq(len(changed), 1)
  const findings = agent_gate_findings([entry()], changed, [])
  assert_eq(len(findings.failures), 1)
  assert_eq(changed[0]?.name, "options.unregistered")
}

@test
pipeline test_dynamic_key_cannot_borrow_a_registered_identifier(harness: Harness, task: unknown) {
  const dir = harness.fs.mkdtemp_in_workspace("gate-key-origin")
  defer {
    harness.fs.delete(dir)
  }
  const path = path_join(dir, "fixture.harn")
  let scope = registry(path)
  scope.scopes = [
    {
      id: "options",
      kind: "option",
      glob: path,
      language: "harn",
      query:
        "((call_expression function: (identifier) @callee (argument_list . (_) @key)) (#eq? @callee \"lookup\"))",
      prefix: "options.",
      key_form: "literal",
    },
  ]
  harness.fs.write_text(path, "fn example() { return lookup(\"enabled\") }\n")
  const original = agent_gate_reads(
    {ast: harness.ast, fs: harness.fs, process: harness.process},
    scope,
  )
  assert_eq(len(original), 1)
  assert_eq(agent_gate_findings([entry()], original, []).failures, [])
  harness.fs.write_text(path, "fn example(enabled: string) { return lookup(enabled) }\n")
  const changed = agent_gate_reads(
    {ast: harness.ast, fs: harness.fs, process: harness.process},
    scope,
  )
  assert_eq(len(changed), 1)
  assert_eq(changed[0]?.name, "")
  assert_eq(len(agent_gate_findings([entry()], changed, []).failures), 1)
}

@test
pipeline test_classification_is_unique_and_cannot_hide_flags(harness: Harness, task: unknown) {
  const read = {
    scope: "options",
    file: "fixture.harn",
    line: 1,
    expression: "key",
    name: "",
    reader: "example",
  }
  const boundary = {
    scope: "options",
    file: "fixture.harn",
    expression: "key",
    owner: "resolver",
    evidence: "Resolver validates the dynamic key.",
  }
  assert_eq(agent_gate_findings([entry()], [read], [boundary]).forwarded, 1)
  assert(
    is_err(
      try {
        agent_gate_findings([entry()], [read], [boundary, boundary])
      },
    ),
  )
  assert(
    is_err(
      try {
        agent_gate_findings([entry()], [read], [boundary], [boundary])
      },
    ),
  )
  assert(
    is_err(
      try {
        agent_gate_findings([entry()], [read], [], [boundary], ["options"])
      },
    ),
  )
  assert_eq(
    len(agent_gate_findings([entry()], [read], [boundary + {expression: "other"}]).failures),
    2,
  )
}

@test
pipeline test_audit_regenerates_reader_locations_and_refuses_drift(
  harness: Harness,
  task: unknown,
) {
  const dir = harness.fs.mkdtemp_in_workspace("gate-audit")
  defer {
    harness.fs.delete(dir)
  }
  const source = path_join(dir, "source.harn")
  const entries = path_join(dir, "entries.json")
  const manifest = path_join(dir, "registry.json")
  let config = registry(source)
  config.entry_files = [entries]
  config.projections = [
    {layer: "runner", file: path_join(dir, "runner.md")},
    {layer: "stop decision", file: path_join(dir, "stop.md")},
    {layer: "stall handler", file: path_join(dir, "stall.md")},
  ]
  harness.fs.write_text(entries, json_stringify([entry()]))
  harness.fs.write_text(manifest, json_stringify(config))
  harness.fs.write_text(source, "fn example(options: dict) { return options.enabled }\n")
  const capabilities = {ast: harness.ast, fs: harness.fs, process: harness.process}
  const generated = agent_gate_audit(capabilities, manifest, true)
  assert_eq(generated.reads, 1)
  assert_eq(generated.pending, 0)
  assert_eq(agent_gate_audit(capabilities, manifest).pending, 0)
  harness.fs.write_text(source, "\nfn example(options: dict) { return options.enabled }\n")
  const moved = agent_gate_audit(capabilities, manifest)
  assert(contains(moved.failures, "stale readers options.enabled"))
  assert_eq(agent_gate_audit(capabilities, manifest, true).pending, 0)
  harness.fs.write_text(source, "fn example(options: dict) { return options.unregistered }\n")
  const unknown = agent_gate_audit(capabilities, manifest, true)
  assert_eq(unknown.reads, 1)
  assert_eq(unknown.pending, 1)
  assert_eq(unknown.unread_entries, ["options.enabled"])
}

@test
pipeline test_binding_source_files_are_required_and_audited(harness: Harness, task: unknown) {
  const dir = harness.fs.mkdtemp_in_workspace("gate-binding-source")
  defer {
    harness.fs.delete(dir)
  }
  const path = path_join(dir, "source.harn")
  const scope_file = path_join(dir, "bindings.json")
  harness.fs.write_text(path, "fn example(options: dict) { return options.enabled }")
  harness.fs.write_text(
    scope_file,
    json_stringify(
      {
        glob: path,
        config: {
          id: "options",
          prefix: "options.",
          types: [],
          parameters: [{function: "example", name: "options"}],
          normalizers: [],
        },
      },
    ),
  )
  let config = registry(path)
  config.scopes = []
  config.binding_scope_files = [scope_file]
  const capabilities = {ast: harness.ast, fs: harness.fs, process: harness.process}
  assert_eq(
    agent_gate_reads(capabilities, config).map(fn(read) { return read.name }),
    ["options.enabled"],
  )
  let missing_extra = json_parse(harness.fs.read_text(scope_file))
  missing_extra.extra_globs = [path_join(dir, "missing.harn")]
  harness.fs.write_text(scope_file, json_stringify(missing_extra))
  assert(
    is_err(
      try {
        agent_gate_reads(capabilities, config)
      },
    ),
  )
  harness.fs.delete(scope_file)
  assert(
    is_err(
      try {
        agent_gate_reads(capabilities, config)
      },
    ),
  )
}

@test
pipeline test_classified_handoff_cannot_outlive_its_consumer_origin(harness: Harness) {
  const dir = harness.fs.mkdtemp_in_workspace("gate-consumer-origin")
  defer {
    harness.fs.delete(dir)
  }
  const source = path_join(dir, "source.harn")
  const entries = path_join(dir, "entries.json")
  const boundaries = path_join(dir, "boundaries.json")
  const manifest = path_join(dir, "registry.json")
  const caller = {function: "caller", name: "options"}
  const consumer = {function: "helper", name: "settings"}
  let binding = {
    id: "options",
    prefix: "options.",
    types: [],
    parameters: [caller, consumer],
    normalizers: [],
  }
  let config = registry(source)
  config.scopes = []
  config.binding_scopes = [{glob: source, config: binding}]
  config.entry_files = [entries]
  config.forwarder_files = [boundaries]
  config.projections = [
    {layer: "runner", file: path_join(dir, "runner.md")},
    {layer: "stop decision", file: path_join(dir, "stop.md")},
    {layer: "stall handler", file: path_join(dir, "stall.md")},
  ]
  harness.fs.write_text(
    source,
    "fn caller(options: dict) { const enabled = options.enabled; return helper(options) }\n"
      + "fn helper(settings: dict) { return settings.threshold }\n",
  )
  harness.fs.write_text(entries, json_stringify([entry(), entry() + {name: "options.threshold"}]))
  harness.fs.write_text(
    boundaries,
    json_stringify(
      [
        {
          scope: "options",
          file: source,
          expression: "helper(options)",
          owner: "helper",
          evidence: "Local helper consumes the configuration.",
          consumers: [{scope: "options", function: "helper", parameter: "settings"}],
        },
      ],
    ),
  )
  harness.fs.write_text(manifest, json_stringify(config))
  const capabilities = {ast: harness.ast, fs: harness.fs, process: harness.process}
  const baseline = agent_gate_audit(capabilities, manifest, true)
  assert_eq(baseline.pending, 0)
  assert_eq(baseline.reads, 3)
  assert_eq(baseline.forwarded, 1)
  binding.parameters = [caller]
  config.binding_scopes = [{glob: source, config: binding}]
  harness.fs.write_text(manifest, json_stringify(config))
  let failure = ""
  try {
    agent_gate_audit(capabilities, manifest)
  } catch (error) {
    failure = to_string(error)
  }
  assert(contains(failure, "missing classified consumer origin options helper(settings)"))
}

@test
pipeline test_stale_parameter_mapping_cannot_hide_configuration_reads(
  harness: Harness,
  task: unknown,
) {
  const dir = harness.fs.mkdtemp_in_workspace("gate-stale-parameter")
  defer {
    harness.fs.delete(dir)
  }
  const path = path_join(dir, "source.harn")
  harness.fs.write_text(path, "fn example(options: dict) { return options.enabled }")
  let config = registry(path)
  config.scopes = []
  config.binding_scopes = [
    {
      glob: path,
      config: {
        id: "options",
        prefix: "options.",
        types: [],
        parameters: [{function: "example", name: "options"}],
        normalizers: [],
      },
    },
  ]
  const capabilities = {ast: harness.ast, fs: harness.fs, process: harness.process}
  assert_eq(
    agent_gate_reads(capabilities, config).map(fn(read) { return read.name }),
    ["options.enabled"],
  )
  config.binding_scopes[0].config.parameters = [{function: "example", name: "obsolete"}]
  const stale = try {
    agent_gate_reads(capabilities, config)
  }
  assert(is_err(stale))
  assert(contains(to_string(unwrap_err(stale)), "stale parameter origin options example(obsolete)"))
}

@test
pipeline test_repository_selectors_reject_new_keys(harness: Harness, task: unknown) {
  const manifest = path_join(harness.fs.source_dir(), "../../spec/agent-gates/registry.json")
  const config = schema_expect(
    json_parse(harness.fs.read_text(manifest)),
    schema_of(AgentGateRegistry),
  )
  const fixtures = {
    "native-budget-envelope": "fn example() { let value = fields.get(\"__TEST_KEY__\"); }",
    "native-equivalent-failover": "fn example() { let value = dict.get(\"__TEST_KEY__\"); }",
    "native-system-replacement": "fn example() { let value = spec.get(\"__TEST_KEY__\"); }",
    "native-model-step-identity": "fn example() { let value = non_nil(\"__TEST_KEY__\"); }",
    "native-model-step-overrides":
      "fn example() { let value = parse_ladder_step_overrides(dict.get(\"__TEST_KEY__\"), idx); }",
    "explicit-routing-key-domain": "const __LLM_EXPLICIT_ROUTING_KEYS = [\"__TEST_KEY__\"]",
    "native-skill-match-options": "fn example() { let value = options.get(\"__TEST_KEY__\"); }",
    "workflow-loop-key-domain": "fn example() { const loop_option_keys = [\"__TEST_KEY__\"] }",
    "model-registry-key-domain":
      "const LLM_CALL_OPTION_FIELDS: &[Field] = &[ShapeFieldDescriptor::optional(\"__TEST_KEY__\", TY_STRING)];",
    "retry-destructured-options": "fn with_retry() { const {__TEST_KEY__ = 3} = cfg }",
    "native-runner-option-helpers":
      "fn example() { let value = opt_str(options, \"__TEST_KEY__\"); }",
    "native-daemon-options": "fn example() { let value = options.get(\"__TEST_KEY__\"); }",
    "native-reminder-options": "fn example() { let value = options.get(\"__TEST_KEY__\"); }",
    "native-reminder-policy": "fn example() { let value = reminders.get(\"__TEST_KEY__\"); }",
    "runner-model-environment": "fn example() { let _value = std::env::var(\"__TEST_KEY__\"); }",
    "runner-native-environment": "fn example() { let _value = std::env::var(\"__TEST_KEY__\"); }",
    "runner-stdlib-environment":
      "fn example(env: HarnessEnv) { return env.get_or(\"__TEST_KEY__\", \"\") }",
    "native-stage-environment":
      "fn example() { let _value = serde_json::json!({\"value\": non_empty_env(\"__TEST_KEY__\")}); }",
    "cli-runner-environment":
      "fn example(harness: Harness) { return __trimmed_env(harness.env, \"__TEST_KEY__\") }",
    "runner-environment-constants": "const EXAMPLE_ENV: &str = \"__TEST_KEY__\";",
    "judge-override-key-domain": "const __JUDGE_LLM_OVERRIDE_KEYS = [\"__TEST_KEY__\"]",
    "judge-model-key-domain": "const __JUDGE_MODEL_SETTING = \"__TEST_KEY__\"",
    "missing-tool-recovery-key-domain":
      "fn example() { for key in [\"__TEST_KEY__\"] { let value = key } }",
  }
  assert_eq(len(config.scopes), len(fixtures))
  const dir = harness.fs.mkdtemp_in_workspace("gate-environment-selectors")
  defer {
    harness.fs.delete(dir)
  }
  for declared in config.scopes {
    assert(contains(fixtures.keys(), declared.id))
    const path = path_join(
      dir,
      declared.id
        + if declared.language == "rust" {
          ".rs"
        } else {
          ".harn"
        },
    )
    let selected = registry(path)
    selected.scopes = [declared + {glob: path}]
    const allowed = entry() + {name: declared.prefix + "HARN_LLM_MODEL"}
    harness.fs.write_text(path, replace(fixtures[declared.id], "__TEST_KEY__", "HARN_LLM_MODEL"))
    const baseline = agent_gate_reads(
      {ast: harness.ast, fs: harness.fs, process: harness.process},
      selected,
    )
    assert_eq(len(baseline), 1)
    assert_eq(agent_gate_findings([allowed], baseline, []).failures, [])
    // This is an intentionally absent fixture name, not a production env read.
    harness.fs.write_text(
      path,
      replace(fixtures[declared.id], "__TEST_KEY__", "HARN" + "_UNREGISTERED_CENSUS"),
    )
    const changed = agent_gate_reads(
      {ast: harness.ast, fs: harness.fs, process: harness.process},
      selected,
    )
    assert_eq(len(changed), 1)
    assert_eq(len(agent_gate_findings([allowed], changed, []).failures), 1)
  }
}

@test
pipeline test_empty_and_invalid_sources_cannot_pass(harness: Harness, task: unknown) {
  const dir = harness.fs.workspace_temp_dir() + "/gate-registry-" + harness.random.uuid_v7()
  harness.fs.mkdir(dir)
  defer {
    harness.fs.delete(dir)
  }
  const path = path_join(dir, "fixture.harn")
  const scope = registry(path)
  assert(
    is_err(
      try {
        agent_gate_reads({ast: harness.ast, fs: harness.fs, process: harness.process}, scope)
      },
    ),
  )
  harness.fs.write_text(path, "fn example() { return true }\n")
  assert(
    is_err(
      try {
        agent_gate_reads({ast: harness.ast, fs: harness.fs, process: harness.process}, scope)
      },
    ),
  )
  harness.fs.write_text(path, "fn example(options: dict) { return options.enabled + }\n")
  assert(
    is_err(
      try {
        agent_gate_reads({ast: harness.ast, fs: harness.fs, process: harness.process}, scope)
      },
    ),
  )
  assert(
    is_err(
      try {
        agent_gate_findings([entry()], [], [])
      },
    ),
  )
}
