      ...valid.jobs,
      "security-tests-ready": {...valid.jobs["security-tests-ready"], "timeout-minutes": 12},
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:artifact waits must share the bounded workflow wait budget"))
  assert(
    errors.contains(
      "ci.yml:security-tests-ready must be the bounded free-hosted security archive barrier",
    ),
  )
}

@test
pipeline test_rejects_parser_check_after_shared_binary_wait(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const audit = valid.jobs["harn-audit"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "harn-audit": {
        ...audit,
        steps: audit.steps.filter({ step -> step.name != "Check generated parser is current" })
          .to_list(),
      },
    },
  }
  const refusal = "ci.yml:harn-audit must start from the CLI producer and verify the exact shared"
    + " Harn binary, not hold a runner waiting for it"
  assert(ci_linux_lane_policy_errors(invalid).contains(refusal))
  // A worker that polls for the CLI holds a hosted runner for the whole build.
  const polling = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "harn-audit": {
        ...audit,
        needs: ["changes"],
        if: "needs.changes.outputs.rust == 'true'",
        steps: audit.steps.filter({ step -> step.name != "Download shared Harn binary" }).to_list()
          + [
            {
              name: "Wait for shared Harn binary",
              run: "./scripts/ci/wait_for_run_artifacts.sh harn-cli.tar.zst",
            },
            {name: "Download shared Harn binary"},
          ],
      },
    },
  }
  assert(ci_linux_lane_policy_errors(polling).contains(refusal))
}

