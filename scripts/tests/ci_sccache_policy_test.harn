}

@test
pipeline test_rejects_host_bound_sandbox_coverage_drift(harness: Harness, task: unknown) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const security = valid.jobs["rust-security"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: producer.steps.map(
          { step ->
            if step?.name != "Run Rust workspace tests" {
              return step
            }
            return {...step, run: "cargo nextest run --locked --workspace --profile ci"}
          },
        )
          .to_list(),
      },
      "rust-security": {
        ...security,
        "runs-on": "blacksmith-8vcpu-ubuntu-2404",
        steps: security.steps.map(
          { step -> return {...step, run: "cargo nextest run -E 'test(only_one_case)'"} },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must own the exact co-located environment-neutral Rust proof",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-security must own every host-bound Linux sandbox proof on GitHub Ubuntu",
    ),
  )
}

@test
pipeline test_rejects_unbounded_or_wrong_tier_cache(harness: Harness, task: unknown) {
  const valid = workflow()
  const audit = valid.jobs["package-audit"]
  const steps = audit.steps.map(
    { step ->
      if step?.uses != "./.github/actions/rust-cache" {
        return step
      }
      return {...step, if: "always()"}
    },
  )
    .to_list()
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "package-audit": {
        ...audit,
        env: {...audit.env, SCCACHE_CACHE_SIZE: "unbounded"},
        steps: steps,
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:package-audit must restore its hosted rust-cache unconditionally"))
  assert(errors.contains("ci.yml:package-audit must not spend persistent compiler-cache capacity"))
}

@test
pipeline test_rejects_persistent_sccache_outside_owned_lanes(harness: Harness, task: unknown) {
  const valid = workflow()
  const invalid = {
    ...valid,
    jobs: {...valid.jobs, surprise: {steps: [{uses: "./.github/actions/sccache"}]}},
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:surprise is not an authorized persistent sccache lane"))
}

/** Every compile lane must be present; a missing one is not a silent pass. */
@test
pipeline test_rejects_a_missing_compile_lane(harness: Harness, task: unknown) {
  const errors = ci_linux_lane_policy_errors({jobs: {}})
  assert(errors.contains("ci.yml:rust-check-inputs must define the persistent Linux compile lane"))
  assert(errors.contains("ci.yml:package-audit must define the hosted Linux compile lane"))
}

@test
pipeline test_accepts_plain_rustc_windows_cache_writer(harness: Harness, task: unknown) {
  assert_eq(windows_shared_cache_errors(windows_cache_writer()), [])
}

@test
pipeline test_rejects_windows_cache_wrapper(harness: Harness, task: unknown) {
  const writer = windows_cache_writer()
  const steps = writer.jobs.nextest.steps
  const wrapped = with_windows_writer_steps(
    writer,
    [steps[0], steps[1], {uses: "mozilla-actions/sccache-action@untrusted"}, steps[2]],
  )
  assert_eq(
    windows_shared_cache_errors(wrapped),
    [
      "workspace-windows producer must use plain rustc: [\"mozilla-actions/sccache-action@untrusted\"]",
    ],
  )
}

@test
pipeline test_rejects_windows_cache_source_partitioning(harness: Harness, task: unknown) {
  const writer = windows_cache_writer()
  const steps = writer.jobs.nextest.steps
  const partitioned = with_windows_writer_steps(
    writer,
    [
      steps[0],
      steps[1],
      {
        ...steps[2],
        with: {...steps[2]?.with ?? {}, "source-key": gha_expression("hashFiles('Cargo.lock')")},
      },
    ],
  )
  assert_eq(
    windows_shared_cache_errors(partitioned),
    ["workspace-windows producer must use one stable native restore namespace"],
  )
}

@test
pipeline test_rejects_a_missing_windows_cache_writer(harness: Harness, task: unknown) {
  assert_eq(
    windows_shared_cache_errors({jobs: {}}),
    ["workspace-windows must be written by windows-nightly.yml:nextest"],
  )
  const writer = windows_cache_writer()
  const steps = writer.jobs.nextest.steps
  const restore_only = with_windows_writer_steps(
    writer,
    [steps[0], steps[1], {...steps[2], with: {...steps[2]?.with ?? {}, save: false}}],
  )
  assert_eq(
    windows_shared_cache_errors(restore_only),
    ["windows-nightly.yml:nextest must write workspace-windows exactly once"],
  )
}

/**
 * The main-branch cache save is a post step, so it spends whatever the bounded
 * steps leave behind. This holds the reserve above the largest full-generation
 * save observed on main (8m35s on 2026-09-02, run 33630075085), which is the
 * save that cancelled a job after its 12853-test suite had already passed.
 * Raising a step budget without raising the ceiling would silently spend the
 * reserve, and the symptom would be a cancelled green job, not a policy error.
 */
@test
pipeline test_producer_ceiling_reserves_a_full_cache_generation_save(
  harness: Harness,
  task: unknown,
) {
  assert(producer_cache_save_reserve_minutes() >= 9)
  assert(producer_hosted_ceiling_minutes() > producer_cache_save_reserve_minutes())
  assert_eq(ci_linux_lane_policy_errors(workflow()), [])
}

/**
 * A step budget is only honest about the wall it was measured against. The
 * producer's cache is written from the persistent ref alone and is evicted
 * between writes, so a branch compiling from no restore is ordinary, and a
 * budget sized on a warm run cancels a step that did nothing wrong. Recording
 * the cold wall next to the budget makes that failure a policy error instead of
 * a cancelled job with no diagnostic.
 */
@test
pipeline test_a_step_budget_below_its_recorded_cold_wall_is_refused(
  harness: Harness,
  task: unknown,
) {
  assert_eq(
    step_budget_margin_errors(
      [{name: "Build security test archive", minutes: 12, cold_seconds: 720}],
    ),
    [
      "ci.yml step 'Build security test archive' budget of 12m must clear its recorded 720s cold wall by 130%",
    ],
  )
  assert_eq(
    step_budget_margin_errors(
      [{name: "Build security test archive", minutes: 16, cold_seconds: 720}],
    ),
    [],
  )
  assert_eq(producer_step_budget_margin_errors(), [])
}

@test
pipeline test_residual_rehearsal_names_the_docs_slice_it_relies_on(
  harness: Harness,
  task: unknown,
) {
  const valid = workflow()
  const message =
    "ci.yml:release-residual-audit may skip check-docs only by naming the harn-audit docs slice outside sprint mode"
  assert(!ci_linux_lane_policy_errors(valid).contains(message))
  // A renamed docs slice leaves the rehearsal pointing at a job that proves nothing.
  const audit = valid.jobs["harn-audit"]
  const renamed = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "harn-audit": {
        ...audit,
        strategy: {
          matrix: {
            include: audit.strategy.matrix.include.map(
              { row -> row.kind == "audit-docs" ? {...row, name: "Docs v2"} : row },
            )
              .to_list(),
          },
        },
      },
    },
  }
  assert(ci_linux_lane_policy_errors(renamed).contains(message))
  // Leaning on the slice in sprint mode, where it is skipped, proves nothing.
  const residual = valid.jobs["release-residual-audit"]
  const always = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "release-residual-audit": {
        ...residual,
        steps: [
          {...residual.steps[0], env: {DOCS_CONTRACTS_PROVEN_BY: "Check Harn documentation"}},
        ],
      },
    },
  }
  assert(ci_linux_lane_policy_errors(always).contains(message))
}

@test
pipeline test_test_producer_leaves_the_cli_to_its_sibling(harness: Harness, task: unknown) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const message =
    "ci.yml:rust-check-inputs must publish security before co-located tests and leave the CLI to rust-cli"
  assert(!ci_linux_lane_policy_errors(valid).contains(message))
  // A second CLI build in the test job is the serial cost the split removed.
  const doubled = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: [
          {
            name: "Build portable Harn CLI",
            run: "./scripts/ci/rust_artifact.sh build-cli cli-bundle sha",
          },
        ]
          + producer.steps,
      },
    },
  }
  assert(ci_linux_lane_policy_errors(doubled).contains(message))
}
