import {
  cache_refresh_trigger_errors,
  cache_refresh_workflow_errors,
  ci_linux_lane_policy_errors,
  cli_producer_hosted_ceiling_minutes,
  cli_producer_owned_ceiling_minutes,
  cli_producer_timeout_expression,
  consumer_canary_errors,
  e2e_elastic_capacity_errors,
  producer_admission_expression,
  producer_cache_save_reserve_minutes,
  producer_cli_timeout_expression,
  producer_hosted_ceiling_minutes,
  producer_owned_ceiling_minutes,
  producer_runner_expression,
  producer_security_timeout_expression,
  producer_step_budget_margin_errors,
  producer_tier_expression,
  producer_timeout_expression,
  step_budget_margin_errors,
  windows_shared_cache_errors,
} from "../check_ci_cache_policy"
import {
  HOST_BOUND_RUST_TEST_FILTER_COMMAND,
  HOST_BOUND_RUST_TEST_FILTER_FLAG,
  HOST_BOUND_RUST_TEST_FILTER_SETUP,
  HOST_BOUND_RUST_TEST_FILTER_SOURCE,
  NEUTRAL_RUST_TEST_FILTER_FLAG,
} from "../ci_cache_policy/host_bound_rust_test_filter"

type CiWorkflowDocument = {jobs: dict<string, dict>}

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

// The producer's compile fan-out is measured by a step rather than typed, so
// the fixture carries the same expression the workflow does. A literal here
// would make the fixture describe a producer the policy now refuses.
const MEASURED_BUILD_JOBS = "$" + "{{ steps.resource-budget.outputs.build_jobs }}"

const BUDGET_STEP = {
  name: "Measure the compile budget",
  id: "resource-budget",
  run: "bash scripts/ci/rust_resource_budget.sh",
  env: {HARN_BUDGET_PROFILE: "producer"},
}

const E2E_SWITCH_ROUTE =
  "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && 'blacksmith-8vcpu-ubuntu-2404' || 'ubuntu-24.04'"

fn e2e_workflow(runs_on: string, evacuation_input: string) -> dict {
  return {
    jobs: {
      e2e: {"runs-on": runs_on},
      "e2e-capacity": {
        steps: [
          {
            name: "Decide where the slow E2E suite lands",
            run: "bash scripts/ci/runner_capacity.sh",
            env: {FLEET_EVACUATION: evacuation_input},
          },
        ],
      },
    },
  }
}

@test
pipeline test_e2e_paid_override_fails_when_runner_route_drops_switch(
  harness: Harness,
  task: unknown,
) {
  const invalid = e2e_workflow(
    "ubuntu-24.04",
    gha_expression("vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true'"),
  )
  const errors = e2e_elastic_capacity_errors(invalid)
  assert(errors.any(fn(error) { contains(error, "HARN_CI_ENABLE_BLACKSMITH_LINUX") }))
}

@test
pipeline test_e2e_paid_override_fails_when_the_switch_never_reaches_the_measured_route(
  harness: Harness,
  task: unknown,
) {
  // The switch on `runs-on` alone is the case the old rule could not see. The
  // job evacuates while the capacity step still names the owned census, so the
  // run is attributed to a rung it never touched.
  const invalid = e2e_workflow(gha_expression(E2E_SWITCH_ROUTE), "")
  const errors = e2e_elastic_capacity_errors(invalid)
  assert(errors.any(fn(error) { contains(error, "FLEET_EVACUATION") }))
}

@test
pipeline test_e2e_paid_override_fails_when_the_capacity_step_is_gone(
  harness: Harness,
  task: unknown,
) {
  const invalid = {jobs: {e2e: {"runs-on": gha_expression(E2E_SWITCH_ROUTE)}}}
  const errors = e2e_elastic_capacity_errors(invalid)
  assert(errors.any(fn(error) { contains(error, "Decide where the slow E2E suite lands") }))
}

@test
pipeline test_e2e_paid_override_accepts_the_switch_on_both_seams(harness: Harness, task: unknown) {
  const valid = e2e_workflow(
    gha_expression(E2E_SWITCH_ROUTE),
    gha_expression("vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true'"),
  )
  assert_eq(e2e_elastic_capacity_errors(valid), [])
}

fn consumer_canary_workflow(extra: list) -> dict {
  return {
    jobs: {
      consumers: {
        steps: [
          {uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"},
          {uses: "actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1"},
          {
            name: "Rehearse the consumer update at this revision",
            run: "bash scripts/ci/consumer_canary.sh",
          },
        ]
          + extra,
      },
    },
  }
}

@test
pipeline test_consumer_canary_refuses_an_upload(harness: Harness, task: unknown) {
  // The consumer may be private; an upload is the direct way its content
  // would reach this public repository.
  const invalid = consumer_canary_workflow([{uses: "actions/upload-artifact@v4"}])
  const errors = consumer_canary_errors(invalid)
  assert(errors.any(fn(error) { contains(error, "actions/upload-artifact@v4") }))
}

@test
pipeline test_consumer_canary_refuses_a_step_summary(harness: Harness, task: unknown) {
  const invalid = consumer_canary_workflow([{run: "cat report.md >> \"$GITHUB_STEP_SUMMARY\""}])
  assert_eq(
    consumer_canary_errors(invalid),
    ["consumer-canary.yml:consumers must not write a step summary"],
  )
}

@test
pipeline test_consumer_canary_refuses_an_unmasked_identity(harness: Harness, task: unknown) {
  // Variables print in the public log; only a secret is masked.
  const invalid = consumer_canary_workflow(
    [
      {
        run: "bash scripts/ci/consumer_canary.sh",
        env: {CANARY_NAME: "vars.CONSUMER_CANARY_REPOSITORY"},
      },
    ],
  )
  assert_eq(len(consumer_canary_errors(invalid)), 1)
}

@test
pipeline test_consumer_canary_accepts_checkout_mint_and_script(harness: Harness, task: unknown) {
  assert_eq(consumer_canary_errors(consumer_canary_workflow([])), [])
}

fn persistent_lane(
  runner: string,
  sccache_key: string,
  rust_cache_key: string,
  write_cache: bool = false,
  timeout: string = "",
  owned_rung: bool = true,
) {
  const cache_inputs = {"shared-key": rust_cache_key, "cache-workspace-crates": "true"}
  let lane = {
    "runs-on": producer_runner_expression(runner, owned_rung),
    needs: ["changes", "runner-availability", "rust-producer-capacity"],
    if: producer_admission_expression(),
    "timeout-minutes": if timeout == "" {
      producer_timeout_expression()
    } else {
      timeout
    },
    env: {HARN_RUNNER_TIER: producer_tier_expression(owned_rung), SCCACHE_CACHE_SIZE: "15G"},
    steps: [
      {
        uses: "./.github/actions/sccache",
        if: "env.HARN_RUNNER_TIER == 'blacksmith'",
        with: {"cache-key": sccache_key, sticky: "true"},
      },
      {
        uses: "./.github/actions/rust-cache",
        if: "env.HARN_RUNNER_TIER != 'blacksmith'",
        with: cache_inputs,
      },
      {name: "Summarize and stop sccache", if: "always()", run: "./scripts/ci/finalize_sccache.sh"},
    ],
  }
  if write_cache {
    lane = {
      ...lane,
      permissions: {contents: "read", actions: "write"},
      steps: lane.steps.map(
        { step ->
          if step?.uses != "./.github/actions/rust-cache" {
            return step
          }
          return {...step, with: {...cache_inputs, save: "true"}}
        },
      )
        .to_list(),
    }
  }
  return lane
}

fn hosted_lane(cache_key: string, write_cache: bool = false) {
  const cache_inputs = {"shared-key": cache_key, "cache-workspace-crates": "true"}
  let lane = {
    "runs-on": "ubuntu-24.04",
    env: {HARN_RUNNER_TIER: "github-hosted"},
    steps: [{uses: "./.github/actions/rust-cache", with: cache_inputs}],
  }
  if write_cache {
    lane = {
      ...lane,
      permissions: {contents: "read", actions: "write"},
      steps: [{uses: "./.github/actions/rust-cache", with: {...cache_inputs, save: "true"}}],
    }
  }
  return lane
}

fn lint_lane() {
  return {
    "runs-on": gha_expression(
      "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && (github.event_name == 'merge_group' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)) && 'blacksmith-8vcpu-ubuntu-2404' || 'ubuntu-24.04'",
    ),
    env: {
      HARN_RUNNER_TIER: gha_expression(
        "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && (github.event_name == 'merge_group' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)) && 'blacksmith' || 'github-hosted'",
      ),
    },
    strategy: {
      "fail-fast": false,
      matrix: {
        include: [
          {kind: "workspace", name: "Check Rust code"},
          {kind: "lean-lsp", name: "Check Rust code (lean LSP features)"},
          {kind: "freshness-checker", name: "Check Rust code (freshness checker)"},
        ],
      },
    },
    steps: [],
  }
}

fn workflow() {
  const package_audit = hosted_lane("package-audit", true)
  const lint = lint_lane()
  const producer = persistent_lane(
    "blacksmith-8vcpu-ubuntu-2404",
    "workspace-tests",
    "workspace-tests",
    true,
  )
  const cli_producer = persistent_lane(
    "blacksmith-8vcpu-ubuntu-2404",
    "harn-ci-cli",
    "harn-ci-cli",
    true,
    cli_producer_timeout_expression(),
    false,
  )
  const rust_test = {
    env: {RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
    "runs-on": "ubuntu-24.04",
    needs: ["changes", "rust-check-inputs"],
    if:
      "needs.changes.outputs.rust == 'true' && needs.rust-check-inputs.result == 'success' && vars.HARN_CI_DISABLE_COLOCATED_TESTS == 'true'",
    "timeout-minutes": 35,
    steps: [
      {
        name: "Verify workspace test archive",
        env: {HARN_VERIFY_RUST_RUNTIME: "1"},
        run: "./scripts/ci/rust_artifact.sh restore-tests bundle destination sha",
      },
      {
        name: "Run Rust workspace tests",
        run:
          "${HOST_BOUND_RUST_TEST_FILTER_SETUP} scripts/ci/run_rust_test_lane.sh cargo nextest run --profile ci --archive-file harn-tests.tar.zst --workspace-remap workspace ${NEUTRAL_RUST_TEST_FILTER_FLAG}",
      },
    ],
  }
  const artifact_consumer_if =
    "needs.changes.outputs.rust == 'true' && needs.rust-artifacts-ready.result == 'success'"
  const artifact_consumer_needs = ["changes", "rust-artifacts-ready"]
  return {
    env: {
      HARN_EXT_ARTIFACT_WAIT_MAX_ATTEMPTS: "270",
      HARN_EXT_ARTIFACT_WAIT_INTERVAL_SECONDS: "10",
      HARN_EXT_ARTIFACT_WAIT_STATE_EVERY_POLLS: "6",
      HARN_EXT_ARTIFACT_WAIT_RATE_LIMIT_MAX_SECONDS: "2400",
    },
    jobs: {
      "package-audit": package_audit,
      "rust-cli": {
        ...cli_producer,
        env: {...cli_producer.env, RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
        steps: cli_producer.steps
          + [
            BUDGET_STEP,
            {
              name: "Build portable Harn CLI",
              "timeout-minutes": producer_cli_timeout_expression(),
              run: "./scripts/ci/rust_artifact.sh build-cli cli-bundle sha",
            },
            {name: "Upload portable Harn CLI", uses: "actions/upload-artifact@pinned"},
          ],
      },
      "rust-check-inputs": {
        ...producer,
        env: {...producer.env, RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
        steps: producer.steps
          + [
            BUDGET_STEP,
            {
              name: "Build security test archive",
              "timeout-minutes": producer_security_timeout_expression(),
              run: "./scripts/ci/rust_artifact.sh build-security security-bundle sha",
            },
            {name: "Upload security test archive", uses: "actions/upload-artifact@pinned"},
            {
              name: "Build portable workspace test archive",
              if: "vars.HARN_CI_DISABLE_COLOCATED_TESTS == 'true'",
              env: {CARGO_BUILD_JOBS: MEASURED_BUILD_JOBS},
              run: "./scripts/ci/rust_artifact.sh build-tests bundle sha",
            },
            {
              name: "Run Rust workspace tests",
              "timeout-minutes": 26,
              id: "release-audit-rust-test",
              if: "vars.HARN_CI_DISABLE_COLOCATED_TESTS != 'true'",
              env: {HARN_LLM_CALLS_DISABLED: "1"},
              run:
                "${HOST_BOUND_RUST_TEST_FILTER_SETUP} scripts/ci/run_rust_test_lane.sh cargo nextest run --locked --workspace --profile ci ${NEUTRAL_RUST_TEST_FILTER_FLAG}",
            },
          ],
      },
      "rust-artifacts-ready": {
        "runs-on": "ubuntu-24.04",
        "timeout-minutes": 50,
        needs: ["changes"],
        permissions: {actions: "read", contents: "read"},
        steps: [
          {
            name: "Wait for shared Harn binary",
            run: "./scripts/ci/wait_for_run_artifacts.sh harn-cli.tar.zst",
          },
        ],
      },
      "rust-checks": {
        ...lint,
        env: {...lint.env, RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
        steps: lint.steps
          + [
            {
              name: "Check Rust code with Clippy",
              run: "./scripts/ci/run_rust_lint_lane.sh --leg \"" + gha_expression("matrix.kind")
                + "\"",
            },
          ],
      },
      "rust-cache-refresh": {
        "runs-on": "ubuntu-24.04",
        if: "needs.changes.outputs.rust_cache_refresh == 'true'",
        concurrency: {group: "harn-ci-rust-cache-refresh", "cancel-in-progress": false},
        permissions: {contents: "read", actions: "write"},
        env: {HARN_RUNNER_TIER: "github-hosted", RUSTFLAGS: gha_expression("matrix.rustflags")},
        strategy: {
          matrix: {
            include: [
              {
                cache_key: "workspace-tests",
                warm_script: "./scripts/ci/warm_rust_cache.sh",
                save_headroom_bytes: 4294967296,
              },
              {
                cache_key: "package-audit",
                warm_script: "./scripts/ci/warm_package_audit_cache.sh",
                save_headroom_bytes: 2147483648,
              },
            ],
          },
        },
        steps: [
          {
            id: "rust-cache",
            uses: "./.github/actions/rust-cache",
            with: {
              "shared-key": gha_expression("matrix.cache_key"),
              "cache-workspace-crates": "true",
              save: "true",
            },
          },
          {
            name: "Prepare Linux cache generation save",
            if: "steps.rust-cache.outputs.cache-hit != 'true'",
            run:
              "./scripts/prune_ci_cache_generations.sh --clear-family-prefix prefix\n./scripts/prune_ci_cache_generations.sh --ensure-headroom bytes",
          },
          {
            name: "Warm Cargo graph",
            if: "steps.rust-cache.outputs.cache-hit != 'true'",
            run: gha_expression("matrix.warm_script"),
          },
        ],
      },
      "rust-test": rust_test,
      "release-residual-audit": {
        steps: [
          {
            name: "Run the release residual audit",
            env: {
              DOCS_CONTRACTS_PROVEN_BY: gha_expression(
                "needs.changes.outputs.sprint_fast_ci != 'true' && 'Check Harn documentation' || ''",
              ),
            },
            run:
              "./scripts/release_gate.sh audit --residual-only --docs-contracts-proven-by \"$DOCS_CONTRACTS_PROVEN_BY\"",
          },
        ],
      },
      "security-tests-ready": {
        "runs-on": "ubuntu-24.04",
        "timeout-minutes": 50,
        needs: ["changes"],
        if:
          "needs.changes.outputs.rust == 'true' && needs.changes.outputs.sprint_fast_ci != 'true'",
        permissions: {actions: "read", contents: "read"},
        steps: [
          {
            name: "Wait for Linux security tests",
            run: "./scripts/ci/wait_for_run_artifacts.sh harn-security.tar.zst",
          },
        ],
      },
      "rust-security": {
        "runs-on": "ubuntu-24.04",
        permissions: {actions: "read", contents: "read"},
        needs: ["changes", "rust-artifacts-ready", "security-tests-ready"],
        if:
          "needs.changes.outputs.rust == 'true' && needs.rust-artifacts-ready.result == 'success' && needs.security-tests-ready.result == 'success'",
        steps: [
          {
            name: "Download shared Harn binary",
            with: {"run-id": gha_expression("needs.rust-artifacts-ready.outputs.source_run_id")},
          },
          {
            name: "Verify shared Harn binary",
            run:
              "./scripts/ci/rust_artifact.sh restore-cli $RUNNER_TEMP/harn-cli.tar.zst $RUNNER_TEMP/harn-cli $GITHUB_SHA $GITHUB_ENV",
          },
          {
            name: "Run Linux sandbox tests",
            id: "release-audit-rust-security",
            env: {HARN_CLI_E2E_BINARY: gha_expression("env.HARN_BIN")},
            run:
              "${HOST_BOUND_RUST_TEST_FILTER_SETUP} scripts/ci/run_rust_test_lane.sh cargo nextest run --profile ci --ignore-default-filter --archive-file harn-security-tests.tar.zst --workspace-remap workspace ${HOST_BOUND_RUST_TEST_FILTER_FLAG}",
          },
        ],
      },
      "harn-audit": {
        "runs-on": "ubuntu-24.04",
        "timeout-minutes": 65,
        needs: ["changes"],
        if:
          "needs.changes.outputs.rust == 'true' && needs.changes.outputs.sprint_fast_ci != 'true'",
        strategy: {
          matrix: {
            include: [
              {kind: "audit", name: "Check Harn sources", selector: "--group=sources"},
              {kind: "audit-docs", name: "Check Harn documentation", selector: "--group=docs"},
            ],
          },
        },
        steps: [
          {name: "Build tree-sitter grammar for the parse sweep"},
          {name: "Check generated parser is current", run: "make check-tree-sitter-parser"},
          {
            name: "Wait for shared Harn binary",
            run: "./scripts/ci/wait_for_run_artifacts.sh harn-cli.tar.zst",
          },
          {name: "Download shared Harn binary"},
          {name: "Verify shared Harn binary"},
          {
            name: "Run $" + "{{ matrix.step_name }}",
            run: "./scripts/audit_gates.sh --tree-sitter-parser-preflighted",
          },
        ],
      },
      "ci-walltime-report": {
        "runs-on": "ubuntu-24.04",
        needs: artifact_consumer_needs,
        if: artifact_consumer_if,
        steps: [
          {
            name: "Write CI timing report",
            run:
              "./scripts/ci/write_ci_walltime_report.sh \"$RUNNER_TEMP/ci-walltime-report.json\"",
          },
          {name: "Upload CI timing report", with: {"if-no-files-found": "error"}},
        ],
      },
      "source-length-ratchet": {
        needs: artifact_consumer_needs,
        if: artifact_consumer_if,
        "timeout-minutes": 15,
        steps: [{name: "Check source file lengths"}],
      },
      "fast-policy-gates": {
        "runs-on": "ubuntu-24.04",
        needs: artifact_consumer_needs,
        // No event term: the refusals here must be able to refuse a pull
        // request, which is the whole reason this job exists.
        if: artifact_consumer_if,
        "timeout-minutes": 15,
        steps: [
          {
            uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
            with: {"fetch-depth": 0, "persist-credentials": false},
          },
          {name: "Verify shared Harn binary"},
          {name: "Reject flaky test patterns", run: "make lint-test-patterns"},
          {name: "Check no retroactive CHANGELOG edits"},
          {
            name: "Check no undeclared protocol symbol removals",
            run: "make check-protocol-symbol-removals",
          },
          {name: "Check CI cache and gate ownership policy", run: "make check-ci-cache-policy"},
          {name: "Check source-only repository policies", run: "make repository-policies-source"},
        ],
      },
      "audit-scripts": {
        "runs-on": "ubuntu-24.04",
        needs: artifact_consumer_needs,
        if: artifact_consumer_if,
        steps: [
          {name: "Verify portable Harn CLI"},
          {
            name: "Check prompts are not embedded in Rust",
            if: "needs.changes.outputs.prompt_prose == 'true'",
            run: "make lint-no-rust-prompt-prose",
          },
          {uses: "./.github/actions/node-cache"},
          {run: "make test-pr-gate-post-warm-integrations"},
        ],
      },
      "shell-gates": {
        "runs-on": "ubuntu-24.04",
        needs: ["changes"],
        if: "needs.changes.outputs.rust == 'true'",
        "timeout-minutes": 20,
        steps: [
          {
            name: "Run pre-warm shell gates without Cargo",
            run: "./scripts/tests/pr_gate_pre_warm_boundary_test.sh",
          },
        ],
      },
      "ci-status": {
        needs: ["rust-artifacts-ready", "security-tests-ready", "ci-walltime-report"],
        steps: [
          {
            name: "Verify required CI jobs",
            env: {COLOCATED_TESTS_DISABLED: gha_expression("vars.HARN_CI_DISABLE_COLOCATED_TESTS")},
            run: "rust_artifacts_ready_result=\""
              + gha_expression("needs['rust-artifacts-ready'].result")
              + "\nsecurity_tests_ready_result=\""
              + gha_expression("needs['security-tests-ready'].result")
              + "\"\nci_walltime_report_result=\""
              + gha_expression("needs['ci-walltime-report'].result")
              + "\"\nif [ \"$rust_artifacts_ready_result\" != success ]; then echo 'Rust artifact handoff failed or skipped'; fi\nif [ \"$security_tests_ready_result\" != success ]; then echo 'Linux security test input handoff failed or skipped'; fi\nif [ \"$ci_walltime_report_result\" != success ]; then echo 'CI timing report failed or skipped'; fi\nif [ \"$rust_test_result\" = skipped ] && [ \"$COLOCATED_TESTS_DISABLED\" != true ]; then :; fi",
          },
        ],
      },
    },
  }
}

/** The sole native-Windows cache writer; no pull-request lane consumes it. */
fn windows_cache_writer() {
  return {
    env: {CARGO_INCREMENTAL: "0", CARGO_TERM_COLOR: "always", RUSTFLAGS: "-D warnings"},
    jobs: {
      nextest: {
        steps: [
          {uses: "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0"},
          {uses: "./.github/actions/rust-toolchain"},
          {
            uses: "./.github/actions/rust-cache",
            if: gha_expression("!startsWith(github.ref_name, 'release-certify/')"),
            with: {
              "shared-key": "workspace-windows",
              "target-dir": gha_expression("env.CARGO_TARGET_DIR"),
              save: true,
            },
          },
        ],
      },
    },
  }
}

fn with_windows_writer_steps(writer: dict, steps: list) -> dict {
  return {...writer, jobs: {...writer.jobs, nextest: {...writer.jobs.nextest, steps: steps}}}
}

@test
pipeline test_accepts_persistent_compile_lanes_with_hosted_fallback(
  harness: Harness,
  task: unknown,
) {
  assert_eq(ci_linux_lane_policy_errors(workflow()), [])
}

/**
 * The refresh lives in its own workflow now, so its checks take a document with
 * its own `on:` block rather than a job inside the CI graph.
 */
fn refresh_workflow() -> dict {
  return {
    on: {push: {branches: ["main"]}, schedule: [{cron: "43 9 * * *"}], workflow_dispatch: nil},
    jobs: {"rust-cache-refresh": workflow().jobs["rust-cache-refresh"]},
  }
}

@test
pipeline test_rejects_cache_writer_without_actions_write(harness: Harness, task: unknown) {
  const valid = refresh_workflow()
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cache-refresh": {...valid.jobs["rust-cache-refresh"], permissions: {contents: "read"}},
    },
  }
  const errors = cache_refresh_workflow_errors(invalid)
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must grant actions: write to persist rust-cache",
    ),
  )
}

/**
 * The falsifier for the trigger itself. The refresh spent a week doing nothing
 * because it was gated on a merge-queue proof while the queue was off, and no
 * check noticed: the job was present, correct, and unreachable. A trigger set
 * that names an optional event instead of the persistent ref is refused here,
 * and so is one with no scheduled backstop.
 */
@test
pipeline test_rejects_a_cache_refresh_trigger_that_may_never_fire(harness: Harness, task: unknown) {
  assert_eq(cache_refresh_trigger_errors(refresh_workflow()), [])
  const queue_gated = {
    ...refresh_workflow(),
    on: {merge_group: nil, schedule: [{cron: "43 9 * * *"}]},
  }
  const queue_errors = cache_refresh_trigger_errors(queue_gated)
  assert(
    queue_errors.contains(
      "rust-cache-refresh.yml must trigger on a push to main; a refresh gated on the merge queue stops running when the queue is off",
    ),
  )
  assert(
    queue_errors.contains(
      "rust-cache-refresh.yml must not depend on merge_group; the merge queue is optional and its absence must not disable the refresh",
    ),
  )
  const no_backstop = {...refresh_workflow(), on: {push: {branches: ["main"]}}}
  assert(
    cache_refresh_trigger_errors(no_backstop).contains(
      "rust-cache-refresh.yml must carry a scheduled backstop so a quiet period does not leave the caches unwritten",
    ),
  )
}

@test
pipeline test_rejects_unbounded_or_unconditional_cache_generation_save(
  harness: Harness,
  task: unknown,
) {
  const valid = workflow()
  const refresh = valid.jobs["rust-cache-refresh"]
  const invalid_steps = refresh.steps.map(
    fn(step) {
      if step?.name == "Prepare Linux cache generation save" {
        return {...step, if: "", run: "echo unbounded"}
      }
      return step
    },
  )
  const invalid_matrix = refresh.strategy.matrix.include.map(
    fn(entry) { return {...entry, save_headroom_bytes: 1610612736} },
  )
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cache-refresh": {
        ...refresh,
        strategy: {...refresh.strategy, matrix: {include: invalid_matrix}},
        steps: invalid_steps,
      },
    },
  }
  const errors = cache_refresh_workflow_errors({...refresh_workflow(), jobs: invalid.jobs})
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh matrix legs must reserve their measured save envelope",
    ),
  )
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must prepare a generation only after a cache miss",
    ),
  )
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must replace stale generations with bounded save headroom",
    ),
  )
}

