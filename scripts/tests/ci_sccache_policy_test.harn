@test
/**
 * A tier guard that names the tiers it knows makes a new tier a silent skip.
 *
 * On the producer's rust-cache step that is not a cosmetic miss: the owned rung
 * would restore nothing, compile from cold, and report a clean pass, with the
 * skipped step the only evidence and nobody reading it. The guard is therefore
 * written as an exclusion, and this refuses the inclusion form that #8334
 * identified.
 */
pipeline test_rejects_a_producer_cache_guard_that_names_only_the_hosted_tier(harness: Harness) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const guarded = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: producer.steps.map(
          fn(step) {
            if trim(to_string(step?.uses ?? "")) != "./.github/actions/rust-cache" {
              return step
            }
            return {...step, if: "env.HARN_RUNNER_TIER == 'github-hosted'"}
          },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(guarded)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must restore rust-cache on every tier except Blacksmith, which has its own sticky sccache",
    ),
    "a guard naming only the hosted tier must be refused; got ${to_string(errors)}",
  )
}

/**
 * The cache summary must not name the tiers it knows. A tier left off that
 * list emits no counters, and a rung with no counters is indistinguishable
 * from one with a warm cache, so a fully cold compile reports as a clean
 * pass. This is the defect that hid the owned pool's cache behaviour.
 */
pipeline test_rejects_a_cache_summary_guard_that_names_one_tier(harness: Harness) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const guarded = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: producer.steps.map(
          fn(step) {
            if trim(to_string(step?.name ?? "")) != "Summarize and stop sccache" {
              return step
            }
            return {...step, if: "always() && env.HARN_RUNNER_TIER == 'blacksmith'"}
          },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(guarded)
  assert(
    errors.contains("ci.yml:rust-check-inputs must finalize its job-owned sccache daemon"),
    "a summary guard naming one tier must be refused; got ${to_string(errors)}",
  )
}

/**
 * The owned ceiling is derived, not chosen. It is the hosted ceiling without
 * the cache-save reserve and adds CLI and security build margins. The owned rung is
 * pull-request-only, so it never reaches the main-only cache save.
 */
pipeline test_owned_ceiling_accounts_for_build_margins_without_cache_save(harness: Harness) {
  assert_eq(
    producer_owned_ceiling_minutes(),
    producer_hosted_ceiling_minutes() - producer_cache_save_reserve_minutes() + 8,
    "the owned ceiling must account for the security margin without a cache-save reserve",
  )
  assert_eq(
    cli_producer_owned_ceiling_minutes(),
    cli_producer_hosted_ceiling_minutes() - producer_cache_save_reserve_minutes() + 12,
    "the owned CLI ceiling must account for the CLI margin without a cache-save reserve",
  )
}

@test
pipeline test_owned_cli_rejects_the_hosted_only_timeout(harness: Harness) {
  const valid = workflow()
  const producer = valid.jobs["rust-cli"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cli": {
        ...producer,
        steps: producer.steps.map(
          { step ->
            if step?.name == "Build portable Harn CLI" {
              return {...step, "timeout-minutes": 10}
            }
            return step
          },
        )
          .to_list(),
      },
    },
  }
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  assert(
    ci_linux_lane_policy_errors(invalid).contains(
      "ci.yml:rust-cli step 'Build portable Harn CLI' must carry its own "
        + producer_cli_timeout_expression()
        + " budget so the cache save reserve stays reserved",
    ),
  )
  assert_eq(producer_hosted_ceiling_minutes(), 60)
  assert_eq(producer_owned_ceiling_minutes(), 56)
  assert_eq(cli_producer_hosted_ceiling_minutes(), 37)
  assert_eq(cli_producer_owned_ceiling_minutes(), 37)
}

pipeline test_security_wait_uses_the_shared_waiter_budget() {
  const valid = workflow()
  const ready = valid.jobs["security-tests-ready"]
  const unbounded = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "security-tests-ready": {
        ...ready,
        steps: ready.steps.map(
          { step -> return {...step, env: {HARN_EXT_ARTIFACT_WAIT_MAX_ATTEMPTS: "270"}} },
        )
          .to_list(),
      },
    },
  }
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  assert(
    ci_linux_lane_policy_errors(unbounded).contains(
      "ci.yml:security-tests-ready must be the bounded free-hosted security archive barrier",
    ),
  )
}

pipeline test_security_barrier_overlaps_the_producer() {
  const valid = workflow()
  const ready = valid.jobs["security-tests-ready"]
  assert_eq(ready.needs, ["changes"])
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  // Waiting for producer completion delays the sandbox proof behind the whole
  // test phase; the waiter already treats a running producer as pending.
  const serialized = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "security-tests-ready": {
        ...ready,
        needs: ["changes", "rust-check-inputs"],
        if: "needs.changes.outputs.rust == 'true' && needs.rust-check-inputs.result == 'success'",
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(serialized).contains(
      "ci.yml:security-tests-ready must be the bounded free-hosted security archive barrier",
    ),
  )
}

pipeline test_owned_producer_requires_measured_capacity(harness: Harness) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  for broken in [
    {...producer, if: gha_expression("!cancelled() && needs.changes.outputs.rust == 'true'")},
    {...producer, needs: ["changes", "runner-availability"]},
  ] {
    const errors = ci_linux_lane_policy_errors(
      {...valid, jobs: {...valid.jobs, "rust-check-inputs": broken}},
    )
    assert(
      errors.contains(
        "ci.yml:rust-check-inputs must require a successful capacity decision on trusted pull requests",
      ),
    )
  }
}

pipeline test_rejects_paid_producer_outside_trusted_events_or_without_fuse(
  harness: Harness,
  task: unknown,
) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        "runs-on": gha_expression(
          "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && 'blacksmith-8vcpu-ubuntu-2404' || 'ubuntu-24.04'",
        ),
        "timeout-minutes": 10,
        env: {
          ...producer.env,
          HARN_RUNNER_TIER: gha_expression(
            "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && 'blacksmith' || 'github-hosted'",
          ),
        },
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must ladder paid blacksmith-8vcpu-ubuntu-2404, the owned linux_big pool on same-repository pull requests, ubicloud-standard-8, then ubuntu-8core",
    ),
  )
  assert(errors.contains("ci.yml:rust-check-inputs must mirror every one of its runner tiers"))
  // The shared CLI must not wait on the owned pool's one-job compile budget:
  // putting the owned rung back on it is refused.
  const cli = valid.jobs["rust-cli"]
  const owned_cli = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cli": {
        ...cli,
        "runs-on": producer_runner_expression("blacksmith-8vcpu-ubuntu-2404", true),
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(owned_cli).contains(
      "ci.yml:rust-cli must ladder paid blacksmith-8vcpu-ubuntu-2404, ubicloud-standard-8, then ubuntu-8core",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must keep the 20-minute paid-runner fuse, the 56-minute owned ceiling, and the 60-minute hosted ceiling sized from its step budgets plus a cache-save reserve",
    ),
  )
}

@test
pipeline test_host_bound_sandbox_filter_has_one_owner(harness: Harness, task: unknown) {
  const root = path_normalize(path_join(harness.fs.cwd(), "../.."))
  const test_names = harness.fs.read_text(path_join(root, HOST_BOUND_RUST_TEST_FILTER_SOURCE))
    .split("\n")
    .filter({ row -> trim(row) != "" })
    .to_list()
  assert_eq(test_names.count, 12)
  const linux_names = test_names.filter(
    { row -> ["all", "linux", "unix"].contains(trim(row).split(" ")[0]) },
  )
    .map({ row -> trim(row).split(" ")[1] })
    .to_list()
  const macos_names = test_names.filter(
    { row -> ["all", "macos", "unix"].contains(trim(row).split(" ")[0]) },
  )
    .map({ row -> trim(row).split(" ")[1] })
    .to_list()
  const windows_names = test_names.filter(
    { row -> ["all", "windows"].contains(trim(row).split(" ")[0]) },
  )
    .map({ row -> trim(row).split(" ")[1] })
    .to_list()
  const rendered_linux = harness.process.run(
    {program: path_join(root, HOST_BOUND_RUST_TEST_FILTER_COMMAND), args: ["linux"]},
  )
  assert_eq(rendered_linux.exit_code, 0)
  assert_eq(
    trim(rendered_linux.stdout),
    linux_names.map({ name -> "test(/(^|::)" + name + "(::|$)/)" }).to_list().join(" or "),
  )
  const rendered_macos = harness.process.run(
    {program: path_join(root, HOST_BOUND_RUST_TEST_FILTER_COMMAND), args: ["macos"]},
  )
  assert_eq(rendered_macos.exit_code, 0)
  assert_eq(
    trim(rendered_macos.stdout),
    macos_names.map({ name -> "test(/(^|::)" + name + "(::|$)/)" }).to_list().join(" or "),
  )
  const rendered_windows = harness.process.run(
    {program: path_join(root, HOST_BOUND_RUST_TEST_FILTER_COMMAND), args: ["windows"]},
  )
  assert_eq(rendered_windows.exit_code, 0)
  assert_eq(
    trim(rendered_windows.stdout),
    windows_names.map({ name -> "test(/(^|::)" + name + "(::|$)/)" }).to_list().join(" or "),
  )
  const renderer_source = harness.fs.read_text(path_join(root, HOST_BOUND_RUST_TEST_FILTER_COMMAND))
  assert_eq(renderer_source.split(HOST_BOUND_RUST_TEST_FILTER_SOURCE).count - 1, 1)
  for projection in [
    {path: ".github/workflows/ci.yml", references: 3},
    {path: "scripts/release_audit_contract.json", references: 2},
    {path: "scripts/release_gate.sh", references: 1},
    {path: "scripts/ci/warm_rust_cache.sh", references: 1},
    {path: "scripts/ci_cache_policy/host_bound_rust_test_filter.harn", references: 1},
  ] {
    const source = harness.fs.read_text(path_join(root, projection.path))
    assert_eq(
      source.split(HOST_BOUND_RUST_TEST_FILTER_COMMAND).count - 1,
      projection.references,
      projection.path + " must read the owned host-bound filter at every projection",
    )
    for test_name in test_names {
      assert(
        !source.contains("test(/(^|::)" + test_name + "(::|$)/)"),
        projection.path + " must not copy host-bound selector " + test_name,
      )
    }
  }
  const actual_workflow = schema_expect(
    yaml_parse(harness.fs.read_text(path_join(root, ".github/workflows/ci.yml"))),
    schema_of(CiWorkflowDocument),
  )
  assert_eq(ci_linux_lane_policy_errors(actual_workflow), [])
  const security_job = actual_workflow.jobs["rust-security"]
  const artifact_download = security_job.steps.find(
    { step -> step.name == "Download shared Harn binary" },
  )
  const download_config = artifact_download?.with ?? {}
  assert(
    download_config["run-id"]
      == gha_expression("needs.rust-artifacts-ready.outputs.source_run_id"),
  )
  const artifact_restore = security_job.steps.find(
    { step -> step.name == "Verify shared Harn binary" },
  )
  assert(artifact_restore?.run.contains("./scripts/ci/rust_artifact.sh restore-cli"))
  const security_step = security_job.steps.find(
    { step -> step?.id == "release-audit-rust-security" },
  )
  assert(security_step?.env?.HARN_CLI_E2E_BINARY == gha_expression("env.HARN_BIN"))
  const cli_test_source = harness.fs.read_text(
    path_join(root, "crates/harn-cli/tests/test_util/process.rs"),
  )
  assert(cli_test_source.contains("std::env::var_os(\"HARN_CLI_E2E_BINARY\")"))
  const wrong_security = {
    ...security_job,
    steps: security_job.steps.map(
      { step ->
        if step?.id != "release-audit-rust-security" {
          return step
        }
        return {...step, env: {...step.env, HARN_CLI_E2E_BINARY: ""}}
      },
    )
      .to_list(),
  }
  const wrong_workflow = {
    ...actual_workflow,
    jobs: {...actual_workflow.jobs, "rust-security": wrong_security},
  }
  assert(
    ci_linux_lane_policy_errors(wrong_workflow).contains(
      "ci.yml:rust-security must consume exact-commit artifacts and run CLI subprocess tests from the verified binary",
    ),
  )
}

@test
pipeline test_rejects_masked_host_bound_filter_renderer_failure(harness: Harness, task: unknown) {
