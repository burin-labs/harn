import { ci_sccache_policy_errors, windows_shared_cache_errors } from "../check_ci_cache_policy"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn sccache_action() {
  return {
    runs: {
      steps: [
        {
          uses: "useblacksmith/stickydisk@6d373c96a74cbde0c99fedc5ea5d3a7ba66ba494",
          if: "inputs.sticky == 'true'",
          "continue-on-error": true,
          with: {
            key: gha_expression("github.repository") + gha_expression("inputs.cache-key"),
            path: "~/.cache/sccache",
          },
        },
        {
          uses: "mozilla-actions/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696",
          "continue-on-error": true,
        },
        {uses: "./.github/actions/configure-cargo-sccache"},
      ],
    },
  }
}

fn persistent_job(runner: string, cache_key: string, sticky_if: string, fallback_if: string) {
  return {
    "runs-on": runner,
    env: {SCCACHE_BASEDIRS: gha_expression("github.workspace"), SCCACHE_CACHE_SIZE: "15G"},
    steps: [
      {
        uses: "./.github/actions/sccache",
        with: {"cache-key": cache_key, sticky: gha_expression(sticky_if)},
      },
      {uses: "./.github/actions/rust-cache", if: fallback_if},
      {run: "./scripts/ci/finalize_sccache.sh", if: "always()"},
    ],
  }
}

fn workflow() {
  const disable = "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'"
  const rust = persistent_job(
    gha_expression(disable + " && 'ubuntu-latest' || matrix.runner"),
    gha_expression("matrix.cache_key"),
    "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX != 'true'",
    "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'",
  )
  return {
    jobs: {
      "package-audit": persistent_job(
        gha_expression(disable + " && 'ubuntu-latest' || 'blacksmith-4vcpu-ubuntu-2404'"),
        "package-audit",
        "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX != 'true'",
        "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'",
      ),
      "rust-builds": {
        ...rust,
        strategy: {
          matrix: {
            include: [
              {runner: "blacksmith-4vcpu-ubuntu-2404", cache_key: "workspace-lint"},
              {runner: "blacksmith-8vcpu-ubuntu-2404", cache_key: "workspace-behavior"},
            ],
          },
        },
        steps: rust.steps
          + [
          {name: "Build portable behavior payload", env: {CARGO_BUILD_JOBS: "4"}},
          {name: "Run full environment-neutral test suite", env: {CARGO_BUILD_JOBS: "4"}},
        ],
      },
    },
  }
}

fn windows_cache_pair() {
  const checkout = {uses: "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0"}
  const toolchain = {uses: "./.github/actions/rust-toolchain"}
  const environment = {CARGO_INCREMENTAL: "0", CARGO_TERM_COLOR: "always", RUSTFLAGS: "-D warnings"}
  return {
    consumer: {
      env: environment,
      jobs: {
        windows: {
          steps: [
            checkout,
            toolchain,
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-windows"}},
          ],
        },
      },
    },
    producer: {
      env: environment,
      jobs: {
        nextest: {
          steps: [
            checkout,
            toolchain,
            {uses: "./.github/actions/rust-cache", with: {"shared-key": "workspace-windows", save: true}},
          ],
        },
      },
    },
  }
}

@test
pipeline test_accepts_pinned_lane_local_sticky_cache_with_kill_switch(task) {
  assert_eq(ci_sccache_policy_errors(sccache_action(), workflow()), [])
}

@test
pipeline test_rejects_unpinned_storage_missing_fallback_and_unauthorized_lane(task) {
  const invalid_action = {runs: {steps: [{uses: "useblacksmith/stickydisk@v1", with: {key: "shared", path: "target"}}]}}
  const invalid_workflow = {
    jobs: {
      "package-audit": {"runs-on": "ubuntu-latest", steps: []},
      "rust-builds": {"runs-on": "ubuntu-latest", steps: []},
      surprise: {steps: [{uses: "./.github/actions/sccache"}]},
    },
  }
  const errors = ci_sccache_policy_errors(invalid_action, invalid_workflow)
  assert(
    errors.contains(".github/actions/sccache/action.yml must use exactly one pinned sticky-disk action"),
  )
  assert(
    errors.contains("ci.yml:package-audit must retain rust-cache only on the GitHub-hosted fallback"),
  )
  assert(errors.contains("ci.yml:package-audit must cap persistent sccache at 15G"))
  assert(errors.contains("ci.yml:surprise uses persistent sccache without a lane policy"))
}

@test
pipeline test_accepts_plain_rustc_windows_cache_pair(task) {
  const pair = windows_cache_pair()
  assert_eq(windows_shared_cache_errors(pair.consumer, pair.producer), [])
}

@test
pipeline test_rejects_windows_cache_wrapper_drift(task) {
  const pair = windows_cache_pair()
  const producer = {
    ...pair.producer,
    jobs: {
      ...pair.producer.jobs,
      nextest: {
        ...pair.producer.jobs.nextest,
        steps: [
          pair.producer.jobs.nextest.steps[0],
          pair.producer.jobs.nextest.steps[1],
          {uses: "mozilla-actions/sccache-action@untrusted"},
          pair.producer.jobs.nextest.steps[2],
        ],
      },
    },
  }
  assert_eq(
    windows_shared_cache_errors(pair.consumer, producer),
    [
      "workspace-windows producer and consumer must use plain rustc: [\"mozilla-actions/sccache-action@untrusted\"]",
      "workspace-windows cache-key inputs drift: consumer=[\"CARGO_INCREMENTAL=0\",\"CARGO_TERM_COLOR=always\",\"RUSTC_WRAPPER=<unset>\",\"RUSTFLAGS=-D warnings\",\"pre-cache-uses=actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0\",\"pre-cache-uses=./.github/actions/rust-toolchain\"] producer=[\"CARGO_INCREMENTAL=0\",\"CARGO_TERM_COLOR=always\",\"RUSTC_WRAPPER=<unset>\",\"RUSTFLAGS=-D warnings\",\"pre-cache-uses=actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0\",\"pre-cache-uses=./.github/actions/rust-toolchain\",\"pre-cache-uses=mozilla-actions/sccache-action@untrusted\"]",
    ],
  )
}

@test
pipeline test_rejects_windows_cache_environment_drift(task) {
  const pair = windows_cache_pair()
  const producer = {...pair.producer, env: {...pair.producer.env, RUSTFLAGS: "-D warnings -C target-cpu=native"}}
  assert_eq(
    windows_shared_cache_errors(pair.consumer, producer),
    [
      "workspace-windows cache-key inputs drift: consumer=[\"CARGO_INCREMENTAL=0\",\"CARGO_TERM_COLOR=always\",\"RUSTC_WRAPPER=<unset>\",\"RUSTFLAGS=-D warnings\",\"pre-cache-uses=actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0\",\"pre-cache-uses=./.github/actions/rust-toolchain\"] producer=[\"CARGO_INCREMENTAL=0\",\"CARGO_TERM_COLOR=always\",\"RUSTC_WRAPPER=<unset>\",\"RUSTFLAGS=-D warnings -C target-cpu=native\",\"pre-cache-uses=actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0\",\"pre-cache-uses=./.github/actions/rust-toolchain\"]",
    ],
  )
}
