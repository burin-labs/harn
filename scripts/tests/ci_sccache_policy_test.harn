import { ci_sccache_policy_errors } from "../check_ci_cache_policy"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn sccache_action() {
  return {
    runs: {
      steps: [
        {
          uses: "useblacksmith/stickydisk@6d373c96a74cbde0c99fedc5ea5d3a7ba66ba494",
          if: "inputs.sticky == 'true'",
          "continue-on-error": true,
          with: {
            key: gha_expression("github.repository") + gha_expression("inputs.cache-key"),
            path: "~/.cache/sccache",
          },
        },
        {
          uses: "mozilla-actions/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696",
          "continue-on-error": true,
        },
        {uses: "./.github/actions/configure-cargo-sccache"},
      ],
    },
  }
}

fn persistent_job(runner: string, cache_key: string, sticky_if: string, fallback_if: string) {
  return {
    "runs-on": runner,
    env: {SCCACHE_BASEDIRS: gha_expression("github.workspace"), SCCACHE_CACHE_SIZE: "15G"},
    steps: [
      {
        uses: "./.github/actions/sccache",
        with: {"cache-key": cache_key, sticky: gha_expression(sticky_if)},
      },
      {uses: "./.github/actions/rust-cache", if: fallback_if},
      {run: "./scripts/ci/finalize_sccache.sh", if: "always()"},
    ],
  }
}

fn workflow() {
  const disable = "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'"
  const rust = persistent_job(
    gha_expression(disable + " && 'ubuntu-latest' || matrix.runner"),
    gha_expression("matrix.cache_key"),
    "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX != 'true'",
    "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'",
  )
  const test = persistent_job(
    gha_expression(disable + " && 'ubuntu-latest' || 'blacksmith-8vcpu-ubuntu-2404'"),
    "workspace-behavior",
    "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX != 'true'",
    "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'",
  )
  return {
    jobs: {
      "package-audit": {
        ...test,
        "runs-on": gha_expression(disable + " && 'ubuntu-latest' || 'blacksmith-4vcpu-ubuntu-2404'"),
        needs: ["changes", "rust-builds"],
        if: "always() && needs.rust-builds.result == 'skipped'",
      },
      "rust-builds": {
        ...rust,
        strategy: {
          matrix: {
            include: [
              {kind: "lint", runner: "blacksmith-4vcpu-ubuntu-2404", cache_key: "workspace-lint"},
              {kind: "behavior", runner: "blacksmith-8vcpu-ubuntu-2404", cache_key: "workspace-behavior"},
            ],
          },
        },
        steps: rust.steps
          + [
          {
            name: "Build portable behavior payload",
            if: "matrix.kind == 'behavior'",
            env: {CARGO_BUILD_JOBS: "4"},
          },
        ],
      },
      "rust-test": {
        ...test,
        needs: ["changes", "rust-builds"],
        steps: test.steps
          + [{name: "Run full environment-neutral test suite", env: {CARGO_BUILD_JOBS: "4"}}],
      },
    },
  }
}

@test
pipeline test_accepts_pinned_lane_local_sticky_cache_with_kill_switch(task) {
  assert_eq(ci_sccache_policy_errors(sccache_action(), workflow()), [])
}

@test
pipeline test_rejects_unpinned_storage_missing_fallback_and_unauthorized_lane(task) {
  const invalid_action = {runs: {steps: [{uses: "useblacksmith/stickydisk@v1", with: {key: "shared", path: "target"}}]}}
  const invalid_workflow = {
    jobs: {
      "package-audit": {"runs-on": "ubuntu-latest", steps: []},
      "rust-builds": {"runs-on": "ubuntu-latest", steps: []},
      "rust-test": {"runs-on": "ubuntu-latest", steps: []},
      surprise: {steps: [{uses: "./.github/actions/sccache"}]},
    },
  }
  const errors = ci_sccache_policy_errors(invalid_action, invalid_workflow)
  assert(
    errors.contains(".github/actions/sccache/action.yml must use exactly one pinned sticky-disk action"),
  )
  assert(
    errors.contains("ci.yml:package-audit must retain rust-cache only on the GitHub-hosted fallback"),
  )
  assert(errors.contains("ci.yml:package-audit must cap persistent sccache at 15G"))
  assert(errors.contains("ci.yml:surprise uses persistent sccache without a lane policy"))
}

@test
pipeline test_rejects_consumers_that_cannot_reuse_the_completed_producer(task) {
  const valid = workflow()
  const test = valid.jobs["rust-test"]
  const invalid_cache = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-test": {
        ...test,
        steps: test.steps
          .map(
          { step ->
            if step.uses == "./.github/actions/sccache" {
              {...step, with: {...step.with, "cache-key": "cold-test-cache"}}
            } else {
              step
            }
          },
        )
          .to_list(),
      },
    },
  }
  const cache_errors = ci_sccache_policy_errors(sccache_action(), invalid_cache)
  assert(cache_errors.contains("ci.yml:rust-test must reuse the producer's workspace-behavior cache"))
  const invalid_order = {...valid, jobs: {...valid.jobs, "rust-test": {...test, needs: ["changes"]}}}
  const order_errors = ci_sccache_policy_errors(sccache_action(), invalid_order)
  assert(
    order_errors
      .contains("ci.yml:rust-test must wait for rust-builds before reusing its persistent cache"),
  )
  const package = valid.jobs["package-audit"]
  const invalid_package = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "package-audit": {
        ...package,
        needs: ["changes"],
        if: "needs.rust-builds.result == 'success'",
        steps: package.steps
          .map(
          { step ->
            if step.uses == "./.github/actions/sccache" {
              {...step, with: {...step.with, "cache-key": "cold-package-cache"}}
            } else {
              step
            }
          },
        )
          .to_list(),
      },
    },
  }
  const package_errors = ci_sccache_policy_errors(sccache_action(), invalid_package)
  assert(
    package_errors.contains("ci.yml:package-audit must reuse the producer's workspace-behavior cache"),
  )
  assert(
    package_errors
      .contains(
      "ci.yml:package-audit must wait for rust-builds before reusing its persistent cache",
    ),
  )
  assert(
    package_errors
      .contains("ci.yml:package-audit must preserve package-only proof when rust-builds skips"),
  )
}
