@test
pipeline test_rejects_a_cheap_refusal_moved_back_or_made_expensive(
  harness: Harness,
  task: unknown,
) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  const fast_job = valid.jobs["fast-policy-gates"]
  const policy_job = valid.jobs["audit-scripts"]
  // Moved back behind the merge. Both halves are asserted: the cheap job
  // losing it, and the expensive job gaining it. Checking only one would pass
  // while the refusal was merely deleted, or while a duplicate still burned
  // fourteen minutes after the fact.
  const moved_back = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "fast-policy-gates": {
        ...fast_job,
        steps: fast_job.steps.filter(
          { step -> trim(step?.run ?? "") != "make lint-test-patterns" },
        )
          .to_list(),
      },
      "audit-scripts": {
        ...policy_job,
        steps: policy_job.steps
          + [{name: "Reject flaky test patterns", run: "make lint-test-patterns"}],
      },
    },
  }
  const moved_errors = ci_linux_lane_policy_errors(moved_back)
  assert(
    moved_errors.contains(
      "ci.yml:fast-policy-gates must own exactly one invocation to reject flaky test patterns",
    ),
  )
  assert(
    moved_errors.contains(
      "ci.yml:audit-scripts must not reject flaky test patterns behind the merge",
    ),
  )
  // Duplicated inside the cheap job.
  const duplicated = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "fast-policy-gates": {
        ...fast_job,
        steps: fast_job.steps + [{run: "make lint-test-patterns"}],
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(duplicated).contains(
      "ci.yml:fast-policy-gates must own exactly one invocation to reject flaky test patterns",
    ),
  )
  // Made expensive. Running before the merge is earned by staying cheap, so
  // the moment this job grows a sweep it has stopped satisfying the rule that
  // put it there.
  const fattened = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "fast-policy-gates": {
        ...fast_job,
        steps: fast_job.steps + [{run: "make test-pr-gate-post-warm-integrations"}],
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(fattened).contains(
      "ci.yml:fast-policy-gates must not run make test-pr-gate-post-warm-integrations; it would stop being cheap",
    ),
  )
  // Left reachable only from the push-only sweep. The rule would then refuse
  // a re-added event condition one merge after it landed.
  const unreachable = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "fast-policy-gates": {
        ...fast_job,
        steps: fast_job.steps.filter(
          { step -> trim(step?.run ?? "") != "make check-ci-cache-policy" },
        )
          .to_list(),
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(unreachable).contains(
      "ci.yml:fast-policy-gates must run this contract itself, or it cannot refuse before a merge",
    ),
  )
  // Credentials persisted back onto the checkout. Git then cannot read its
  // own config inside the sandbox and both base-relative guards fail closed.
  const credentialed = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "fast-policy-gates": {
        ...fast_job,
        steps: fast_job.steps.map(
          { step ->
            if contains(trim(step?.uses ?? ""), "actions/checkout@") {
              {...step, with: {"fetch-depth": 0}}
            } else {
              step
            }
          },
        )
          .to_list(),
      },
    },
  }
  const credential_message =
    "ci.yml:fast-policy-gates must check out with persist-credentials: false,"
    + " or its base-relative guards cannot read a base"
  assert(ci_linux_lane_policy_errors(credentialed).contains(credential_message))
  // A job with no checkout at all must not satisfy the rule by having nothing
  // to persist, which is the shape that let the defect through in the first
  // place.
  const uncheckedout = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "fast-policy-gates": {
        ...fast_job,
        steps: fast_job.steps.filter(
          { step -> !contains(trim(step?.uses ?? ""), "actions/checkout@") },
        )
          .to_list(),
      },
    },
  }
  assert(ci_linux_lane_policy_errors(uncheckedout).contains(credential_message))
}

@test
pipeline test_rejects_shell_gates_moved_behind_the_merge_or_the_cli(
  harness: Harness,
  task: unknown,
) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  const shell_job = valid.jobs["shell-gates"]
  const policy_job = valid.jobs["audit-scripts"]
  const pre_warm = "./scripts/tests/pr_gate_pre_warm_boundary_test.sh"
  // Moved back into the main-push lane, the shape that let a fixture defect
  // merge and turn main red. Both halves are asserted.
  const moved_back = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "shell-gates": {...shell_job, steps: []},
      "audit-scripts": {...policy_job, steps: policy_job.steps + [{run: pre_warm}]},
    },
  }
  const moved_errors = ci_linux_lane_policy_errors(moved_back)
  assert(
    moved_errors.contains(
      "ci.yml:shell-gates must own exactly one invocation to run the pre-warm shell gates",
    ),
  )
  assert(
    moved_errors.contains(
      "ci.yml:audit-scripts must not run the pre-warm shell gates behind the merge",
    ),
  )
  // Scoping it to main pushes is refused by the cheap-refusal rule, pinned in
  // check_ci_cache_policy_test.harn against the real workflow.
  // Put behind the shared-CLI barrier.
  const barriered = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "shell-gates": {...shell_job, needs: ["changes", "rust-artifacts-ready"]},
    },
  }
  assert(
    ci_linux_lane_policy_errors(barriered).contains(
      "ci.yml:shell-gates must need only changes, not wait for the shared Harn binary",
    ),
  )
}

@test
pipeline test_rejects_unowned_runner_routing(harness: Harness, task: unknown) {
