/**
 * The main-branch cache save is a post step, so it spends whatever the bounded
 * steps leave behind. This holds the reserve above the largest full-generation
 * save observed on main (8m35s on 2026-09-02, run 33630075085), which is the
 * save that cancelled a job after its 12853-test suite had already passed.
 * Raising a step budget without raising the ceiling would silently spend the
 * reserve, and the symptom would be a cancelled green job, not a policy error.
 */
@test
pipeline test_producer_ceiling_reserves_a_full_cache_generation_save(
  harness: Harness,
  task: unknown,
) {
  assert(producer_cache_save_reserve_minutes() >= 9)
  assert(producer_hosted_ceiling_minutes() > producer_cache_save_reserve_minutes())
  assert_eq(ci_linux_lane_policy_errors(workflow(harness.fs)), [])
}

/**
 * A step budget is only honest about the wall it was measured against. The
 * producer's cache is written from the persistent ref alone and is evicted
 * between writes, so a branch compiling from no restore is ordinary, and a
 * budget sized on a warm run cancels a step that did nothing wrong. Recording
 * the cold wall next to the budget makes that failure a policy error instead of
 * a cancelled job with no diagnostic.
 */
@test
pipeline test_a_step_budget_below_its_recorded_cold_wall_is_refused(
  harness: Harness,
  task: unknown,
) {
  assert_eq(
    step_budget_margin_errors(
      [{name: "Build security test archive", minutes: 12, cold_seconds: 720}],
    ),
    [
      "ci.yml step 'Build security test archive' budget of 12m must clear its recorded 720s cold wall by 130%",
    ],
  )
  assert_eq(
    step_budget_margin_errors(
      [{name: "Build security test archive", minutes: 16, cold_seconds: 720}],
    ),
    [],
  )
  assert_eq(producer_step_budget_margin_errors(), [])
}

@test
pipeline test_residual_rehearsal_names_the_docs_slice_it_relies_on(
  harness: Harness,
  task: unknown,
) {
  const valid = workflow(harness.fs)
  const message =
    "ci.yml:release-residual-audit may skip check-docs only by naming the harn-audit docs slice"
  assert(!ci_linux_lane_policy_errors(valid).contains(message))
  // A renamed docs slice leaves the rehearsal pointing at a job that proves nothing.
  const audit = valid.jobs["harn-audit"]
  const renamed = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "harn-audit": {
        ...audit,
        strategy: {
          matrix: {
            include: audit.strategy.matrix.include.map(
              { row -> row.kind == "audit-docs" ? {...row, name: "Docs v2"} : row },
            )
              .to_list(),
          },
        },
      },
    },
  }
  assert(ci_linux_lane_policy_errors(renamed).contains(message))
  // Naming any other job leans on a proof that is not the docs slice.
  const residual = valid.jobs["release-residual-audit"]
  const elsewhere = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "release-residual-audit": {
        ...residual,
        steps: [{...residual.steps[0], env: {DOCS_CONTRACTS_PROVEN_BY: "Check Harn sources"}}],
      },
    },
  }
  assert(ci_linux_lane_policy_errors(elsewhere).contains(message))
}

@test
pipeline test_test_producer_leaves_the_cli_to_its_sibling(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const producer = valid.jobs["rust-check-inputs"]
  const message =
    "ci.yml:rust-check-inputs must publish security before the fallback archive and leave ordinary tests to parallel partitions"
  assert(!ci_linux_lane_policy_errors(valid).contains(message))
  // A second CLI build in the test job is the serial cost the split removed.
  const doubled = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: [
          {
            name: "Build portable Harn CLI",
            run: "./scripts/ci/rust_artifact.sh build-cli cli-bundle sha",
          },
        ]
          + producer.steps,
      },
    },
  }
  assert(ci_linux_lane_policy_errors(doubled).contains(message))
}

@test
pipeline test_parallel_workspace_suite_refuses_missing_or_duplicated_shares(harness: Harness) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  const partitions = valid.jobs["rust-test-partitions"]
  const rows = partitions.strategy.matrix.include
  const message =
    "ci.yml:rust-test-partitions must execute every exact workspace test share independently"
  for removed in rows {
    const missing = rows.filter({ row -> row.partition != removed.partition }).to_list()
    for invalid_rows in [missing, missing + [missing[0]]] {
      const invalid = {
        ...valid,
        jobs: {
          ...valid.jobs,
          "rust-test-partitions": {...partitions, strategy: {matrix: {include: invalid_rows}}},
        },
      }
      assert(ci_linux_lane_policy_errors(invalid).contains(message))
    }
  }
}

@test
pipeline test_rust_test_aggregate_refuses_unreported_or_forged_inputs(harness: Harness) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  const aggregate = valid.jobs["rust-test-status"]
  const step = aggregate.steps.find(
    fn(step: dict) -> bool { return step?.run == "bash scripts/ci/verify_rust_test_results.sh" },
  )
  assert(step != nil && len(step.env ?? {}) > 0, "the actual test aggregate declares result inputs")
  for key in step.env.keys() {
    const invalid = {
      ...valid,
      jobs: {
        ...valid.jobs,
        "rust-test-status": {
          ...aggregate,
          steps: aggregate.steps.map(
            fn(candidate: dict) -> dict {
              if candidate == step {
                return {...step, env: {...step.env, [key]: "success"}}
              }
              return candidate
            },
          )
            .to_list(),
        },
      },
    }
    assert(
      ci_linux_lane_policy_errors(invalid).contains(
        "ci.yml:rust-test-status must verify every partition or the complete archive fallback",
      ),
    )
  }
}

/** The shared CLI producer has one rung: GitHub's free standard runner. */
@test
pipeline test_cli_producer_runs_only_on_the_free_hosted_runner(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  const reserved = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cli": {
        ...valid.jobs["rust-cli"],
        "runs-on": "$"
          + "{{ (needs.rust-producer-capacity.outputs.cli_route == 'owned'\n  && fromJSON('[\"self-hosted\", \"Linux\", \"X64\", \"harn-ci-producer\"]'))\n  || 'ubuntu-24.04' }}",
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(reserved).contains(
      "ci.yml:rust-cli must use standard hosted ubuntu-24.04",
    ),
  )
}

/**
 * Merge groups take the hosted rung for the workspace producer. The datacenter
 * route ran the security archive past its 24-minute step limit five times out
 * of five while the hosted rung finished it in 7-14 minutes (#9428), so a
 * ladder that names that host again, or any second owned rung, is refused.
 */
@test
pipeline test_merge_groups_take_the_hosted_workspace_producer(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  assert(!contains(producer_runner_expression(), "merge_route"))
  assert(!contains(producer_runner_expression(), "hetzner-1"))
  assert_eq(producer_runner_expression(), "$" + "{{ 'ubuntu-24.04' }}")
  const producer = valid.jobs["rust-check-inputs"]
  const datacenter_ladder = "$"
    + "{{ (needs.rust-producer-capacity.outputs.route == 'owned'\n  && fromJSON('[\"self-hosted\", \"Linux\", \"X64\", \"harn-ci-big\"]'))\n  || (needs.rust-producer-capacity.outputs.merge_route == 'owned'\n  && fromJSON('[\"self-hosted\", \"Linux\", \"X64\", \"harn-ci-big\", \"hetzner-1\"]'))\n  || 'ubuntu-24.04' }}"
  assert(
    ci_linux_lane_policy_errors(
      {
        ...valid,
        jobs: {...valid.jobs, "rust-check-inputs": {...producer, "runs-on": datacenter_ladder}},
      },
    )
      .contains("ci.yml:rust-check-inputs must use standard hosted ubuntu-24.04"),
  )
}
