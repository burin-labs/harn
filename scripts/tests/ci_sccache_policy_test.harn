pipeline test_security_barrier_overlaps_the_producer(harness: Harness) {
  const valid = workflow(harness.fs)
  const ready = valid.jobs["security-tests-ready"]
  assert_eq(ready.needs, ["changes"])
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  // Waiting for producer completion delays the sandbox proof behind the whole
  // test phase; the waiter already treats a running producer as pending.
  const serialized = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "security-tests-ready": {
        ...ready,
        needs: ["changes", "rust-check-inputs"],
        if: "needs.changes.outputs.rust == 'true' && needs.rust-check-inputs.result == 'success'",
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(serialized).contains(
      "ci.yml:security-tests-ready must be the bounded free-hosted security archive barrier",
    ),
  )
}

pipeline test_hosted_producers_depend_only_on_the_change_decision(harness: Harness) {
  const valid = workflow(harness.fs)
  const producer = valid.jobs["rust-check-inputs"]
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  for broken in [
    {...producer, if: "github.event_name == 'pull_request'"},
    {...producer, needs: ["changes", "runner-availability"]},
  ] {
    const errors = ci_linux_lane_policy_errors(
      {...valid, jobs: {...valid.jobs, "rust-check-inputs": broken}},
    )
    assert(errors.contains("ci.yml:rust-check-inputs must depend only on the Rust change decision"))
  }
}

pipeline test_rejects_a_producer_ladder_off_its_rungs_or_ceilings(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const producer = valid.jobs["rust-check-inputs"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        "runs-on": gha_expression(
          "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && 'blacksmith-8vcpu-ubuntu-2404' || 'ubuntu-24.04'",
        ),
        "timeout-minutes": 10,
        env: {
          ...producer.env,
          HARN_RUNNER_TIER: gha_expression(
            "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && 'blacksmith' || 'github-hosted'",
          ),
        },
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:rust-check-inputs must use standard hosted ubuntu-24.04"))
  assert(errors.contains("ci.yml:rust-check-inputs must mirror every one of its runner tiers"))
  // The shared CLI must not wait on the owned pool's compile budget: an owned
  // rung on it is refused, and the hosted-only ladder is the valid one.
  const cli = valid.jobs["rust-cli"]
  const cli_ladder_error = "ci.yml:rust-cli must use standard hosted ubuntu-24.04"
  const regressed = {
    ...valid,
    jobs: {...valid.jobs, "rust-cli": {...cli, "runs-on": "self-hosted"}},
  }
  assert(ci_linux_lane_policy_errors(regressed).contains(cli_ladder_error))
  assert(!ci_linux_lane_policy_errors(valid).contains(cli_ladder_error))
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must keep the 68-minute hosted ceiling sized from its step budgets plus a cache-save reserve",
    ),
  )
}

@test
pipeline test_host_bound_sandbox_filter_has_one_owner(harness: Harness) {
  const root = path_normalize(path_join(harness.fs.cwd(), "../.."))
  const test_names = harness.fs.read_text(path_join(root, HOST_BOUND_RUST_TEST_FILTER_SOURCE))
    .split("\n")
    .filter({ name -> trim(name) != "" })
    .to_list()
  assert(test_names.count > 0, "the host-bound registry must be nonempty")
  assert(
    test_names.contains("nested_availability_refuses_before_command_deadline"),
    "the registry must reach the nested confinement regression",
  )
  assert(
    test_names.contains("a_confined_command_stacks_its_own_confinement"),
    "the registry must reach the stacked confinement regression",
  )
  const rendered = harness.process.run(
    {program: path_join(root, HOST_BOUND_RUST_TEST_FILTER_COMMAND), args: []},
  )
  assert_eq(rendered.exit_code, 0)
  assert_eq(
    trim(rendered.stdout),
    test_names.map({ name -> "test(${name})" }).to_list().join(" or "),
  )
  const renderer_source = harness.fs.read_text(path_join(root, HOST_BOUND_RUST_TEST_FILTER_COMMAND))
  assert_eq(renderer_source.split(HOST_BOUND_RUST_TEST_FILTER_SOURCE).count - 1, 1)
  for projection in [
    {path: ".github/workflows/ci.yml", references: 1},
    {path: "scripts/release_audit_contract.json", references: 1},
    {path: "scripts/ci/run_workspace_tests.sh", references: 1},
    {path: "scripts/release_gate.sh", references: 1},
    {path: "scripts/ci/warm_rust_cache.sh", references: 1},
    {path: "scripts/ci_cache_policy/host_bound_rust_test_filter.harn", references: 1},
  ] {
    const source = harness.fs.read_text(path_join(root, projection.path))
    assert_eq(
      source.split(path_basename(HOST_BOUND_RUST_TEST_FILTER_COMMAND)).count - 1,
      projection.references,
      projection.path + " must read the owned host-bound filter at every projection",
    )
    for test_name in test_names {
      assert(
        !source.contains("test(${test_name})"),
        projection.path + " must not copy host-bound selector " + test_name,
      )
    }
  }
}

@test
pipeline test_rejects_masked_workspace_test_failure(harness: Harness) {
  const valid = workflow(harness.fs)
  const partitions = valid.jobs["rust-test-partitions"]
  const unsafe = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-test-partitions": {
        ...partitions,
        steps: partitions.steps.map(
          { step ->
            return {
              ...step,
              run: to_string(step.run ?? "").replace(
                "run_workspace_tests.sh \"$HARN_EXT_TEST_PARTITION\"",
                "run_workspace_tests.sh \"$HARN_EXT_TEST_PARTITION\" || true",
              ),
            }
          },
        )
          .to_list(),
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(unsafe).contains(
      "ci.yml:rust-test-partitions must execute every exact workspace test share independently",
    ),
  )
}

@test
pipeline test_rejects_host_bound_sandbox_coverage_drift(harness: Harness) {
  const valid = workflow(harness.fs)
  const partitions = valid.jobs["rust-test-partitions"]
  const security = valid.jobs["rust-security"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-test-partitions": {
        ...partitions,
        steps: partitions.steps.map(
          { step ->
            if step.name != "Run Rust workspace tests" {
              return step
            }
            return {...step, run: "cargo-nextest nextest run --locked --workspace --profile ci"}
          },
        )
          .to_list(),
      },
      "rust-security": {
        ...security,
        "runs-on": "blacksmith-8vcpu-ubuntu-2404",
        steps: security.steps.map(
          { step -> return {...step, run: "cargo-nextest nextest run -E 'test(only_one_case)'"} },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-test-partitions must execute every exact workspace test share independently",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-security must own every host-bound Linux sandbox proof on GitHub Ubuntu",
    ),
  )
}

@test
pipeline test_rejects_unbounded_or_wrong_tier_cache(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const audit = valid.jobs["package-audit"]
  const steps = audit.steps.map(
    { step ->
      if step?.uses != "./.github/actions/rust-cache" {
        return step
      }
      return {...step, if: "always()"}
    },
  )
    .to_list()
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "package-audit": {
        ...audit,
        env: {...audit.env, SCCACHE_CACHE_SIZE: "unbounded"},
        steps: steps,
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:package-audit must restore its hosted rust-cache unconditionally"))
  assert(errors.contains("ci.yml:package-audit must not spend persistent compiler-cache capacity"))
}

