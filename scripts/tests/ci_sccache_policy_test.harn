@test
pipeline test_rust_lint_lane_runs_every_leg_without_a_build_cache(harness: Harness, task: unknown) {
  const valid = workflow()
  const rust_job = valid.jobs["rust-checks"]
  assert_eq(
    ci_linux_lane_policy_errors(valid).filter({ e -> contains(e, "rust-checks") }).to_list(),
    [],
  )
  const leg_message =
    "ci.yml:rust-checks must run exactly one fail-slow matrix leg per lint leg: workspace, lean-lsp, freshness-checker"
  // Dropping a leg leaves that feature graph unlinted on every merge group.
  const missing_leg = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-checks": {
        ...rust_job,
        strategy: {
          ...rust_job.strategy,
          matrix: {
            include: rust_job.strategy.matrix.include.filter({ e -> e.kind != "lean-lsp" })
              .to_list(),
          },
        },
      },
    },
  }
  assert(ci_linux_lane_policy_errors(missing_leg).contains(leg_message))
  // Fail-fast would cancel sibling legs and hide their verdicts.
  const fail_fast = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-checks": {...rust_job, strategy: {...rust_job.strategy, "fail-fast": true}},
    },
  }
  assert(ci_linux_lane_policy_errors(fail_fast).contains(leg_message))
  // Clippy cannot reuse the producer's build cache; restoring it only costs time.
  const cached = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-checks": {
        ...rust_job,
        steps: [
          {
            uses: "./.github/actions/rust-cache",
            with: {"shared-key": "workspace-tests", "cache-workspace-crates": "true"},
          },
        ]
          + rust_job.steps,
      },
    },
  }
  assert(
    ci_linux_lane_policy_errors(cached).contains(
      "ci.yml:rust-checks must not restore a build cache Clippy cannot reuse",
    ),
  )
}

