    ),
  )
}

@test
pipeline test_rejects_unowned_runner_routing(harness: Harness, task) {
  const valid = workflow()
  const rust_job = valid.jobs["rust-checks"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "package-audit": {
        ...valid.jobs["package-audit"],
        "runs-on": gha_expression(
          "vars.HARN_CI_DISABLE_SELFHOSTED_LINUX != 'true'"
            + " && fromJSON('[\"self-hosted\", \"Linux\", \"X64\"]') || 'ubuntu-latest'",
        ),
      },
      "rust-checks": {
        ...rust_job,
        strategy: {matrix: {include: [{kind: "lint"}, {kind: "workspace-tests"}]}},
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:package-audit must run on ubuntu-latest"))
  assert(
    errors.contains("ci.yml:rust-checks must remain one fixed lint lane, not a compile matrix"),
  )
}

@test
pipeline test_rejects_paid_producer_outside_trusted_events_or_without_fuse(harness: Harness, task) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        "runs-on": gha_expression(
          "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true' && 'ubuntu-latest' || 'blacksmith-8vcpu-ubuntu-2404'",
        ),
        "timeout-minutes": 10,
        env: {
          ...producer.env,
          HARN_RUNNER_TIER: gha_expression(
            "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true' && 'github-hosted' || 'blacksmith'",
          ),
        },
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must route only merge_group and same-repository pull_request to blacksmith-8vcpu-ubuntu-2404 with a hosted fallback",
    ),
  )
  assert(errors.contains("ci.yml:rust-check-inputs must mirror its Blacksmith/hosted runner tier"))
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must keep the 20-minute paid-runner fuse and 25-minute hosted fallback",
    ),
  )
}

@test
pipeline test_rejects_host_bound_sandbox_coverage_drift(harness: Harness, task) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const security = valid.jobs["rust-security"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: producer.steps.map(
          { step ->
            if step?.name != "Run Rust workspace tests" {
              return step
            }
            return {...step, run: "cargo nextest run --locked --workspace --profile ci"}
          },
        )
          .to_list(),
      },
      "rust-security": {
        ...security,
        "runs-on": "blacksmith-8vcpu-ubuntu-2404",
        steps: security.steps.map(
          { step -> return {...step, run: "cargo nextest run -E 'test(only_one_case)'"} },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must own the exact co-located environment-neutral Rust proof",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-security must own every host-bound Linux sandbox proof on GitHub Ubuntu",
    ),
  )
}

@test
pipeline test_rejects_unbounded_or_wrong_tier_cache(harness: Harness, task) {
  const valid = workflow()
  const audit = valid.jobs["package-audit"]
  const steps = audit.steps.map(
    { step ->
      if step?.uses != "./.github/actions/rust-cache" {
        return step
      }
      return {...step, if: "always()"}
    },
  )
    .to_list()
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "package-audit": {
        ...audit,
        env: {...audit.env, SCCACHE_CACHE_SIZE: "unbounded"},
        steps: steps,
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:package-audit must restore its hosted rust-cache unconditionally"))
  assert(errors.contains("ci.yml:package-audit must not spend persistent compiler-cache capacity"))
}

@test
pipeline test_rejects_persistent_sccache_outside_owned_lanes(harness: Harness, task) {
  const valid = workflow()
  const invalid = {
    ...valid,
    jobs: {...valid.jobs, surprise: {steps: [{uses: "./.github/actions/sccache"}]}},
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:surprise is not an authorized persistent sccache lane"))
}

/** Every compile lane must be present; a missing one is not a silent pass. */
@test
pipeline test_rejects_a_missing_compile_lane(harness: Harness, task) {
  const errors = ci_linux_lane_policy_errors({jobs: {}})
  assert(errors.contains("ci.yml:rust-check-inputs must define the persistent Linux compile lane"))
  assert(errors.contains("ci.yml:package-audit must define the hosted Linux compile lane"))
}

@test
pipeline test_accepts_plain_rustc_windows_cache_pair(harness: Harness, task) {
  const pair = windows_cache_pair()
  assert_eq(windows_shared_cache_errors(pair.consumer, pair.producer), [])
}

@test
pipeline test_rejects_windows_cache_wrapper_drift(harness: Harness, task) {
  const pair = windows_cache_pair()
  const producer = {
    ...pair.producer,
    jobs: {
      ...pair.producer.jobs,
      nextest: {
        ...pair.producer.jobs.nextest,
        steps: [
          pair.producer.jobs.nextest.steps[0],
          pair.producer.jobs.nextest.steps[1],
          {uses: "mozilla-actions/sccache-action@untrusted"},
          pair.producer.jobs.nextest.steps[2],
        ],
      },
    },
  }
  const errors = windows_shared_cache_errors(pair.consumer, producer)
  assert_eq(len(errors), 2)
  assert(
    errors.contains(
      "workspace-windows producer and consumer must use plain rustc: [\"mozilla-actions/sccache-action@untrusted\"]",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-windows cache-key inputs drift:") }))
  assert(errors.any({ error -> error.contains("rust-cache-source-key=") }))
}

@test
pipeline test_rejects_windows_cache_environment_drift(harness: Harness, task) {
  const pair = windows_cache_pair()
  const producer = {
    ...pair.producer,
    env: {...pair.producer.env, RUSTFLAGS: "-D warnings -C target-cpu=native"},
  }
  const errors = windows_shared_cache_errors(pair.consumer, producer)
  assert_eq(len(errors), 1)
  assert(errors.any({ error -> error.starts_with("workspace-windows cache-key inputs drift:") }))
  assert(errors.any({ error -> error.contains("RUSTFLAGS=-D warnings -C target-cpu=native") }))
  assert(errors.any({ error -> error.contains("rust-cache-source-key=") }))
}

@test
pipeline test_rejects_windows_cache_source_partitioning(harness: Harness, task) {
  const pair = windows_cache_pair()
  const producer_cache = pair.producer.jobs.nextest.steps[2]
  const producer = {
    ...pair.producer,
    jobs: {
      ...pair.producer.jobs,
      nextest: {
        ...pair.producer.jobs.nextest,
        steps: [
          pair.producer.jobs.nextest.steps[0],
          pair.producer.jobs.nextest.steps[1],
          {
            ...producer_cache,
            with: {
              ...producer_cache?.with ?? {},
              "source-key": gha_expression("hashFiles('Cargo.lock')"),
            },
          },
        ],
      },
    },
  }
  const errors = windows_shared_cache_errors(pair.consumer, producer)
  assert_eq(len(errors), 2)
  assert(
    errors.contains(
      "workspace-windows producer and consumer must use one stable native restore namespace",
    ),
  )
  assert(errors.any({ error -> error.starts_with("workspace-windows cache-key inputs drift:") }))
}

@test
pipeline test_rejects_paired_windows_cache_source_partitioning(harness: Harness, task) {
  const pair = windows_cache_pair()
  const drifted_source_key = gha_expression("hashFiles('Cargo.lock')")
  const consumer_cache = pair.consumer.jobs.windows.steps[2]
  const producer_cache = pair.producer.jobs.nextest.steps[2]
  const consumer = {
    ...pair.consumer,
    jobs: {
      ...pair.consumer.jobs,
      windows: {
        ...pair.consumer.jobs.windows,
        steps: [
          pair.consumer.jobs.windows.steps[0],
          pair.consumer.jobs.windows.steps[1],
          {
            ...consumer_cache,
            with: {...consumer_cache?.with ?? {}, "source-key": drifted_source_key},
          },
        ],
      },
    },
  }
  const producer = {
    ...pair.producer,
    jobs: {
      ...pair.producer.jobs,
      nextest: {
        ...pair.producer.jobs.nextest,
        steps: [
          pair.producer.jobs.nextest.steps[0],
          pair.producer.jobs.nextest.steps[1],
          {
            ...producer_cache,
            with: {...producer_cache?.with ?? {}, "source-key": drifted_source_key},
          },
        ],
      },
    },
  }
  assert_eq(
    windows_shared_cache_errors(consumer, producer),
    ["workspace-windows producer and consumer must use one stable native restore namespace"],
  )
}
