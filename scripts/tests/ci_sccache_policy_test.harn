import { ci_linux_lane_policy_errors, windows_shared_cache_errors } from "../check_ci_cache_policy"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

fn persistent_lane(
  runner: string,
  sccache_key: string,
  rust_cache_key: string,
  write_cache: bool = false,
) {
  const cache_inputs = {"shared-key": rust_cache_key, "cache-workspace-crates": "true"}
  const paid_event =
    "(github.event_name == 'merge_group' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository))"
  let lane = {
    "runs-on": gha_expression(
      "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true' && 'ubuntu-latest' || (${paid_event} && '${runner}' || 'ubuntu-latest')",
    ),
    "timeout-minutes": gha_expression(
      "${paid_event} && vars.HARN_CI_DISABLE_BLACKSMITH_LINUX != 'true' && 20 || 25",
    ),
    env: {
      HARN_RUNNER_TIER: gha_expression(
        "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true' && 'github-hosted' || (${paid_event} && 'blacksmith' || 'github-hosted')",
      ),
      SCCACHE_CACHE_SIZE: "15G",
    },
    steps: [
      {
        uses: "./.github/actions/sccache",
        if: "env.HARN_RUNNER_TIER == 'blacksmith'",
        with: {"cache-key": sccache_key, sticky: "true"},
      },
      {
        uses: "./.github/actions/rust-cache",
        if: "env.HARN_RUNNER_TIER == 'github-hosted'",
        with: cache_inputs,
      },
      {
        name: "Summarize and stop sccache",
        if: "always() && env.HARN_RUNNER_TIER == 'blacksmith'",
        run: "./scripts/ci/finalize_sccache.sh",
      },
    ],
  }
  if write_cache {
    lane = {
      ...lane,
      permissions: {contents: "read", actions: "write"},
      steps: lane.steps.map(
        { step ->
          if step?.uses != "./.github/actions/rust-cache" {
            return step
          }
          return {...step, with: {...cache_inputs, save: "true"}}
        },
      )
        .to_list(),
    }
  }
  return lane
}

fn hosted_lane(cache_key: string, write_cache: bool = false) {
  const cache_inputs = {"shared-key": cache_key, "cache-workspace-crates": "true"}
  let lane = {
    "runs-on": "ubuntu-latest",
    env: {HARN_RUNNER_TIER: "github-hosted"},
    steps: [{uses: "./.github/actions/rust-cache", with: cache_inputs}],
  }
  if write_cache {
    lane = {
      ...lane,
      permissions: {contents: "read", actions: "write"},
      steps: [{uses: "./.github/actions/rust-cache", with: {...cache_inputs, save: "true"}}],
    }
  }
  return lane
}

fn workflow() {
  const host_bound_filter =
    "test(test_linux_process_sandbox_catches_ten_process_escapes) or test(workspace_env_integration) or test(local_backend_execs_inside_session_outputs) or test(local_backend_timeout_is_enforced_without_shell_timeout_binary) or test(sandboxed_npm_install_resolves_file_tarball_dependency_offline)"
  const package_audit = hosted_lane("package-audit", true)
  const lint = hosted_lane("workspace-tests")
  const producer = persistent_lane(
    "blacksmith-8vcpu-ubuntu-2404",
    "workspace-tests",
    "workspace-tests",
    true,
  )
  const rust_test = {
    env: {RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
    "runs-on": "ubuntu-latest",
    needs: ["changes", "rust-check-inputs"],
    if:
      "needs.changes.outputs.rust == 'true' && needs.rust-check-inputs.result == 'success' && vars.HARN_CI_DISABLE_COLOCATED_TESTS == 'true'",
    "timeout-minutes": 35,
    steps: [
      {
        name: "Verify workspace test archive",
        env: {HARN_VERIFY_RUST_RUNTIME: "1"},
        run: "./scripts/ci/rust_artifact.sh restore-tests bundle destination sha",
      },
      {
        name: "Run Rust workspace tests",
        run:
          "scripts/ci/run_rust_test_lane.sh cargo nextest run --profile ci --archive-file harn-tests.tar.zst --workspace-remap workspace -E 'not (${host_bound_filter})'",
      },
    ],
  }
  const artifact_consumer_if =
    "needs.changes.outputs.rust == 'true' && needs.rust-artifacts-ready.result == 'success'"
  const artifact_consumer_needs = ["changes", "rust-artifacts-ready"]
  return {
    env: {HARN_ARTIFACT_WAIT_MAX_ATTEMPTS: "270", HARN_ARTIFACT_WAIT_INTERVAL_SECONDS: "10"},
    jobs: {
      "package-audit": package_audit,
      "rust-check-inputs": {
        ...producer,
        env: {...producer.env, RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
        steps: producer.steps
          + [
          {
            name: "Build portable Harn CLI",
            run: "./scripts/ci/rust_artifact.sh build-cli cli-bundle sha",
          },
          {name: "Upload portable Harn CLI", uses: "actions/upload-artifact@pinned"},
          {
            name: "Build security test archive",
            run: "./scripts/ci/rust_artifact.sh build-security security-bundle sha",
          },
          {name: "Upload security test archive", uses: "actions/upload-artifact@pinned"},
          {
            name: "Build portable workspace test archive",
            if: "vars.HARN_CI_DISABLE_COLOCATED_TESTS == 'true'",
            env: {CARGO_BUILD_JOBS: "4"},
            run: "./scripts/ci/rust_artifact.sh build-tests bundle sha",
          },
          {
            name: "Run Rust workspace tests",
            id: "release-audit-rust-test",
            if: "vars.HARN_CI_DISABLE_COLOCATED_TESTS != 'true'",
            env: {HARN_LLM_CALLS_DISABLED: "1"},
            run:
              "scripts/ci/run_rust_test_lane.sh cargo nextest run --locked --workspace --profile ci -E 'not (${host_bound_filter})'",
          },
        ],
      },
      "rust-artifacts-ready": {
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 50,
        needs: ["changes"],
        permissions: {actions: "read", contents: "read"},
        steps: [
          {
            name: "Wait for shared Harn binary",
            run: "./scripts/ci/wait_for_run_artifacts.sh harn-cli.tar.zst",
          },
        ],
      },
      "rust-checks": {
        ...lint,
        env: {...lint.env, RUSTFLAGS: "-D warnings -Clink-arg=-fuse-ld=mold"},
        steps: lint.steps
          + [
          {name: "Check Rust code with Clippy", run: "./scripts/ci/run_rust_lint_lane.sh"},
        ],
      },
      "rust-cache-refresh": {
        "runs-on": "ubuntu-latest",
        if: "needs.changes.outputs.rust_cache_refresh == 'true'",
        concurrency: {group: "harn-ci-rust-cache-refresh", "cancel-in-progress": false},
        permissions: {contents: "read", actions: "write"},
        env: {HARN_RUNNER_TIER: "github-hosted", RUSTFLAGS: gha_expression("matrix.rustflags")},
        strategy: {
          matrix: {
            include: [
              {
                cache_key: "workspace-tests",
                warm_script: "./scripts/ci/warm_rust_cache.sh",
                save_headroom_bytes: 4294967296,
              },
              {
                cache_key: "package-audit",
                warm_script: "./scripts/ci/warm_package_audit_cache.sh",
                save_headroom_bytes: 2147483648,
              },
            ],
          },
        },
        steps: [
          {
            id: "rust-cache",
            uses: "./.github/actions/rust-cache",
            with: {
              "shared-key": gha_expression("matrix.cache_key"),
              "cache-workspace-crates": "true",
              save: "true",
            },
          },
          {
            name: "Prepare Linux cache generation save",
            if: "steps.rust-cache.outputs.cache-hit != 'true'",
            run:
              "./scripts/prune_ci_cache_generations.sh --clear-family-prefix prefix\n./scripts/prune_ci_cache_generations.sh --ensure-headroom bytes",
          },
          {name: "Warm Cargo graph", run: gha_expression("matrix.warm_script")},
        ],
      },
      "rust-test": rust_test,
      "security-tests-ready": {
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 50,
        needs: ["changes"],
        permissions: {actions: "read", contents: "read"},
        steps: [
          {
            name: "Wait for Linux security tests",
            run: "./scripts/ci/wait_for_run_artifacts.sh harn-security.tar.zst",
          },
        ],
      },
      "rust-security": {
        "runs-on": "ubuntu-latest",
        needs: ["changes", "security-tests-ready"],
        if:
          "needs.changes.outputs.rust == 'true' && needs.security-tests-ready.result == 'success'",
        steps: [
          {
            name: "Run Linux sandbox tests",
            id: "release-audit-rust-security",
            run:
              "scripts/ci/run_rust_test_lane.sh cargo nextest run --profile ci --archive-file harn-security-tests.tar.zst --workspace-remap workspace -E '${host_bound_filter}'",
          },
        ],
      },
      "harn-audit": {
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 65,
        needs: ["changes"],
        if: "needs.changes.outputs.rust == 'true'",
        steps: [
          {name: "Build tree-sitter grammar for the parse sweep"},
          {name: "Check generated parser is current", run: "make check-tree-sitter-parser"},
          {
            name: "Wait for shared Harn binary",
            run: "./scripts/ci/wait_for_run_artifacts.sh harn-cli.tar.zst",
          },
          {name: "Download shared Harn binary"},
          {name: "Verify shared Harn binary"},
          {
            name: "Run $" + "{{ matrix.step_name }}",
            run: "./scripts/audit_gates.sh --tree-sitter-parser-preflighted",
          },
        ],
      },
      "ci-walltime-report": {
        "runs-on": "ubuntu-latest",
        needs: artifact_consumer_needs,
        if: artifact_consumer_if,
        steps: [
          {
            name: "Write CI timing report",
            run:
              "./scripts/ci/write_ci_walltime_report.sh \"$RUNNER_TEMP/ci-walltime-report.json\"",
          },
          {name: "Upload CI timing report", with: {"if-no-files-found": "error"}},
        ],
      },
      "audit-scripts": {
        "runs-on": "ubuntu-latest",
        needs: artifact_consumer_needs,
        if: artifact_consumer_if,
        steps: [
          {name: "Verify portable Harn CLI"},
          {
            name: "Check prompts are not embedded in Rust",
            if: "needs.changes.outputs.prompt_prose == 'true'",
            run: "make lint-no-rust-prompt-prose",
          },
        ],
      },
      "ci-status": {
        needs: ["rust-artifacts-ready", "security-tests-ready", "ci-walltime-report"],
        steps: [
          {
            name: "Verify required CI jobs",
            env: {COLOCATED_TESTS_DISABLED: gha_expression("vars.HARN_CI_DISABLE_COLOCATED_TESTS")},
            run: "rust_artifacts_ready_result=\""
              + gha_expression(
              "needs['rust-artifacts-ready'].result",
            )
              + "\nsecurity_tests_ready_result=\""
              + gha_expression(
              "needs['security-tests-ready'].result",
            )
              + "\"\nci_walltime_report_result=\""
              + gha_expression(
              "needs['ci-walltime-report'].result",
            )
              + "\"\nif [ \"$rust_artifacts_ready_result\" != success ]; then echo 'Rust artifact handoff failed or skipped'; fi\nif [ \"$security_tests_ready_result\" != success ]; then echo 'Linux security test input handoff failed or skipped'; fi\nif [ \"$ci_walltime_report_result\" != success ]; then echo 'CI timing report failed or skipped'; fi\nif [ \"$rust_test_result\" = skipped ] && [ \"$COLOCATED_TESTS_DISABLED\" != true ]; then :; fi",
          },
        ],
      },
    },
  }
}

fn windows_cache_pair() {
  const checkout = {uses: "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0"}
  const toolchain = {uses: "./.github/actions/rust-toolchain"}
  const environment = {CARGO_INCREMENTAL: "0", CARGO_TERM_COLOR: "always", RUSTFLAGS: "-D warnings"}
  const cache_inputs = {
    "shared-key": "workspace-windows",
    "target-dir": gha_expression("env.CARGO_TARGET_DIR"),
  }
  return {
    consumer: {
      env: environment,
      jobs: {
        windows: {
          steps: [checkout, toolchain, {uses: "./.github/actions/rust-cache", with: cache_inputs}],
        },
      },
    },
    producer: {
      env: environment,
      jobs: {
        nextest: {
          steps: [
            checkout,
            toolchain,
            {
              uses: "./.github/actions/rust-cache",
              if: gha_expression("!startsWith(github.ref_name, 'release-certify/')"),
              with: {...cache_inputs, save: true},
            },
          ],
        },
      },
    },
  }
}

@test
pipeline test_accepts_persistent_compile_lanes_with_hosted_fallback(harness: Harness, task) {
  assert_eq(ci_linux_lane_policy_errors(workflow()), [])
}

@test
pipeline test_rejects_cache_writer_without_actions_write(harness: Harness, task) {
  const valid = workflow()
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cache-refresh": {...valid.jobs["rust-cache-refresh"], permissions: {contents: "read"}},
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains("ci.yml:rust-cache-refresh must grant actions: write to persist rust-cache"),
  )
}

@test
pipeline test_rejects_unbounded_or_unconditional_cache_generation_save(harness: Harness, task) {
  const valid = workflow()
  const refresh = valid.jobs["rust-cache-refresh"]
  const invalid_steps = refresh.steps.map(
    fn(step) {
      if step?.name == "Prepare Linux cache generation save" {
        return {...step, if: "", run: "echo unbounded"}
      }
      return step
    },
  )
  const invalid_matrix = refresh.strategy.matrix.include.map(
    fn(entry) { return {...entry, save_headroom_bytes: 1610612736} },
  )
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cache-refresh": {
        ...refresh,
        strategy: {...refresh.strategy, matrix: {include: invalid_matrix}},
        steps: invalid_steps,
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-cache-refresh matrix legs must reserve their measured save envelope",
    ),
  )
  assert(
    errors.contains("ci.yml:rust-cache-refresh must prepare a generation only after a cache miss"),
  )
  assert(
    errors.contains(
      "ci.yml:rust-cache-refresh must replace stale generations with bounded save headroom",
    ),
  )
}

@test
pipeline test_rejects_incomplete_workspace_cache_generation(harness: Harness, task) {
  const valid = workflow()
  const audit = valid.jobs["package-audit"]
  const steps = audit.steps.map(
    { step ->
      if step?.uses != "./.github/actions/rust-cache" {
        return step
      }
      return {...step, with: {...step?.with ?? {}, "cache-workspace-crates": "false"}}
    },
  )
    .to_list()
  const invalid = {...valid, jobs: {...valid.jobs, "package-audit": {...audit, steps: steps}}}
  assert(
    ci_linux_lane_policy_errors(invalid).contains(
      "ci.yml:package-audit must keep complete hosted cache package-audit",
    ),
  )
}

@test
pipeline test_rejects_missing_main_scoped_cache_refresh(harness: Harness, task) {
  const valid = workflow()
  let jobs = {}
  for {key: name, value: job} in valid.jobs {
    if name != "rust-cache-refresh" {
      jobs[name] = job
    }
  }
  const errors = ci_linux_lane_policy_errors({...valid, jobs: jobs})
  assert(errors.contains("ci.yml:rust-cache-refresh must define the hosted Linux compile lane"))
  assert(errors.contains("ci.yml:rust-cache-refresh must define the main-scoped cache writer"))
}

@test
pipeline test_rejects_recompiling_workspace_test_consumer(harness: Harness, task) {
  const valid = workflow()
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-test": {
        ...valid.jobs["rust-test"],
        "timeout-minutes": 12,
        steps: [
          {uses: "./.github/actions/rust-cache"},
          {
            name: "Run Rust workspace tests",
            env: {CARGO_BUILD_JOBS: "4"},
            run: "cargo nextest run --workspace --profile ci",
          },
        ],
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:rust-test must keep the execution-only 35-minute timeout"))
  assert(errors.contains("ci.yml:rust-test must not restore compiler caches or build-disk setup"))
  assert(errors.contains("ci.yml:rust-test must verify the archived Rust runtime contract"))
  assert(errors.contains("ci.yml:rust-test must execute only the remapped nextest archive"))
  assert(errors.contains("ci.yml:rust-test must not configure compile fan-out"))
}

@test
pipeline test_rejects_co_location_without_fail_closed_fallback(harness: Harness, task) {
  const valid = workflow()
  const rust_job = valid.jobs["rust-check-inputs"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...rust_job,
        steps: rust_job.steps.filter({ step -> step?.name != "Run Rust workspace tests" }).map(
          { step ->
            if step?.name != "Build portable workspace test archive" {
              return step
            }
            return {...step, if: "true", run: "cargo build"}
          },
        )
          .to_list(),
      },
      "rust-test": {...valid.jobs["rust-test"], if: "false"},
      "ci-status": {
        steps: [
          {
            name: "Verify required CI jobs",
            env: {BLACKSMITH_DISABLED: "true"},
            run: "[ \"$BLACKSMITH_DISABLED\" = true ]",
          },
        ],
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must build the workspace test archive only for the standalone fallback",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must own the exact co-located environment-neutral Rust proof",
    ),
  )
  assert(errors.contains("ci.yml:rust-test must run only as the co-location kill-switch fallback"))
  assert(
    errors.contains("ci.yml:ci-status must fail closed across co-located and fallback Rust proofs"),
  )
}

@test
pipeline test_rejects_serialized_live_artifact_handoff(harness: Harness, task) {
  const valid = workflow()
  const producer = valid.jobs["rust-check-inputs"]
  const walltime_report = valid.jobs["ci-walltime-report"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...producer,
        steps: producer.steps.filter({ step -> step?.name != "Upload portable Harn CLI" }).to_list()
          + [
          producer.steps[4],
        ],
      },
      "rust-security": {
        ...valid.jobs["rust-security"],
        needs: ["changes", "rust-artifacts-ready"],
        if:
          "needs.changes.outputs.rust == 'true' && needs.rust-artifacts-ready.result == 'success'",
      },
      "ci-walltime-report": {
        ...walltime_report,
        steps: walltime_report.steps.map(
          { step ->
            if step.name != "Upload CI timing report" {
              return step
            }
            return {...step, "continue-on-error": true, with: {"if-no-files-found": "warn"}}
          },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must publish the CLI before building security inputs, then publish security before co-located tests",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-security must consume the live exact-commit security archive without waiting for producer completion",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:ci-walltime-report must publish a non-empty fail-closed timing report off the conformance tail",
    ),
  )
}

@test
pipeline test_rejects_artifact_wait_shorter_than_cold_producer_headroom(harness: Harness, task) {
  const valid = workflow()
  const invalid = {
    ...valid,
    env: {...valid.env, HARN_ARTIFACT_WAIT_MAX_ATTEMPTS: "66"},
    jobs: {
      ...valid.jobs,
      "security-tests-ready": {...valid.jobs["security-tests-ready"], "timeout-minutes": 12},
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-artifacts-ready must be the bounded free-hosted immutable artifact barrier",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:security-tests-ready must be the bounded free-hosted security artifact barrier",
    ),
  )
}

@test
pipeline test_rejects_parser_check_after_shared_binary_wait(harness: Harness, task) {
