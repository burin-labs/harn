} from "../ci_cache_policy/host_bound_rust_test_filter"

fn gha_expression(body: string) -> string {
  return "$" + "{{ " + body + " }}"
}

// The slow E2E suite's route: owned capacity when the census says so, else the
// shared hosted runner. The evacuation switch reaches it through the capacity
// decision, never through a Blacksmith Linux rung.
const E2E_SWITCH_ROUTE =
  "needs.e2e-capacity.outputs.route == 'owned' && 'self-hosted' || 'ubuntu-24.04'"

fn e2e_workflow(runs_on: string, decision_env: dict) -> dict {
  return {
    jobs: {
      e2e: {"runs-on": runs_on},
      "e2e-capacity": {
        steps: [
          {
            name: "Decide where the slow E2E suite lands",
            run: "bash scripts/ci/runner_capacity.sh",
            env: decision_env,
          },
        ],
      },
    },
  }
}

@test
pipeline test_e2e_route_refuses_a_linux_runner_that_cannot_confine_harn(
  harness: Harness,
  task: unknown,
) {
  // Blacksmith Linux has neither Landlock nor bubblewrap, so every Harn child
  // this suite spawns refuses to start there.
  const invalid = e2e_workflow(
    gha_expression(
      "vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true' && 'blacksmith-8vcpu-ubuntu-2404' || 'ubuntu-24.04'",
    ),
    {},
  )
  assert(
    landlock_incapable_runner_errors("e2e.yml", invalid).contains(
      "e2e.yml:e2e can resolve to blacksmith-8vcpu-ubuntu-2404, a Linux runner that cannot confine a Harn child (no Landlock or bubblewrap)",
    ),
  )
}

@test
pipeline test_landlock_contract_keeps_vendor_windows_and_macos_runners(
  harness: Harness,
  task: unknown,
) {
  // Only Linux labels are refused: the contract is about Harn's Linux child
  // confinement, and Blacksmith's Windows runners are not Linux.
  const workflow = {
    jobs: {
      windows: {"runs-on": "blacksmith-16vcpu-windows-2025"},
      linux: {"runs-on": "ubuntu-24.04"},
      matrix_linux: {
        "runs-on": gha_expression("matrix.runner"),
        strategy: {matrix: {include: [{runner: "blacksmith-4vcpu-ubuntu-2404"}]}},
      },
    },
  }
  assert_eq(
    landlock_incapable_runner_errors("ci.yml", workflow),
    [
      "ci.yml:matrix_linux can resolve to blacksmith-4vcpu-ubuntu-2404, a Linux runner that cannot confine a Harn child (no Landlock or bubblewrap)",
    ],
  )
}

@test
pipeline test_public_runner_policy_refuses_a_paid_capacity_route_input(
  harness: Harness,
  task: unknown,
) {
  const invalid = e2e_workflow(
    gha_expression(E2E_SWITCH_ROUTE),
    {FLEET_EVACUATION: gha_expression("vars.HARN_CI_ENABLE_BLACKSMITH_LINUX == 'true'")},
  )
  const errors = public_repository_runner_errors({"e2e.yml": invalid}, {targets: []})
  assert(
    errors.contains(
      "e2e.yml:e2e-capacity runner capacity decision must not accept paid route input FLEET_EVACUATION",
    ),
  )
}

@test
pipeline test_public_runner_policy_refuses_inherited_paid_capacity_route_inputs(
  harness: Harness,
  task: unknown,
) {
  const base = e2e_workflow(gha_expression(E2E_SWITCH_ROUTE), {})
  const workflow_env = {...base, env: {PAID_LINUX_PROVIDER: "blacksmith"}}
  const capacity = base.jobs["e2e-capacity"]
  const job_env = {
    ...base,
    jobs: {
      ...base.jobs,
      "e2e-capacity": {...capacity, env: {CAPACITY_VENDOR_RUNNER: "blacksmith-8vcpu-ubuntu-2404"}},
    },
  }
  assert_eq(
    public_repository_runner_errors(
      {"workflow-env.yml": workflow_env, "job-env.yml": job_env},
      {targets: []},
    ),
    [
      "job-env.yml:e2e must not request a self-hosted runner",
      "job-env.yml:e2e-capacity runner capacity decision must not accept paid route input CAPACITY_VENDOR_RUNNER",
      "workflow-env.yml:e2e must not request a self-hosted runner",
      "workflow-env.yml:e2e-capacity runner capacity decision must not accept paid route input PAID_LINUX_PROVIDER",
    ],
  )
}

@test
pipeline test_public_runner_policy_checks_reusable_workflow_callers(
  harness: Harness,
  task: unknown,
) {
  const reusable = {
    on: {workflow_call: {inputs: {os: {required: true, type: "string"}}}},
    jobs: {install: {"runs-on": gha_expression("inputs.os")}},
  }
  const caller = {
    jobs: {
      direct: {uses: "./.github/workflows/setup-harn-contract.yml", with: {os: "ubuntu-24.04"}},
      matrix: {
        uses: "./.github/workflows/setup-harn-contract.yml",
        strategy: {matrix: {os: ["ubuntu-24.04", "blacksmith-8vcpu-ubuntu-2404"]}},
        with: {os: gha_expression("matrix.os")},
      },
    },
  }
  assert_eq(
    public_repository_runner_errors(
      {"ci.yml": caller, "setup-harn-contract.yml": reusable},
      {targets: []},
    ),
    [
      "ci.yml:matrix passes paid runner token blacksmith-8vcpu-ubuntu-2404 to setup-harn-contract.yml input os",
    ],
  )
}

@test
pipeline test_public_runner_policy_checks_reusable_workflow_call_defaults(
  harness: Harness,
  task: unknown,
) {
  const reusable = {
    on: {workflow_call: {inputs: {os: {type: "string", default: "ubuntu-8core"}}}},
    jobs: {
      install: {
        "runs-on": gha_expression("matrix.runner"),
        strategy: {matrix: {runner: [gha_expression("inputs.os")]}},
      },
    },
  }
  const caller = {jobs: {omitted: {uses: "./.github/workflows/setup-harn-contract.yml"}}}
  assert_eq(
    public_repository_runner_errors(
      {"ci.yml": caller, "setup-harn-contract.yml": reusable},
      {targets: []},
    ),
    [
      "ci.yml:omitted passes paid runner token ubuntu-8core to setup-harn-contract.yml input os",
      "setup-harn-contract.yml:install runner selection can resolve through paid token ubuntu-8core",
    ],
  )
}

@test
pipeline test_e2e_hosted_route_rejects_the_old_owned_route(harness: Harness, task: unknown) {
  const invalid = {jobs: {e2e: {"runs-on": gha_expression(E2E_SWITCH_ROUTE)}}}
  assert(e2e_hosted_runner_errors(invalid).count > 0)
  assert(e2e_hosted_runner_errors({jobs: {}}).count > 0)
}

@test
pipeline test_e2e_uses_standard_hosted_capacity(harness: Harness, task: unknown) {
  const valid = {jobs: {e2e: {"runs-on": "ubuntu-24.04"}}}
  assert_eq(e2e_hosted_runner_errors(valid), [])
  assert_eq(public_repository_runner_errors({"e2e.yml": valid}, {targets: []}), [])
  assert_eq(public_repository_runner_errors({"other.yml": valid}, {targets: []}), [])
  assert(
    public_repository_runner_errors(
      {"e2e.yml": {jobs: {other: {"runs-on": "ubuntu-8core"}}}},
      {targets: []},
    ).count
      > 0,
  )
  assert(
    public_repository_runner_errors(
      {"e2e.yml": {jobs: {e2e: {"runs-on": gha_expression("'ubuntu-8core'")}}}},
      {targets: []},
    ).count
      > 0,
  )
}

pipeline test_routine_workflows_refuse_self_hosted_capacity() {
  assert_eq(
    public_repository_runner_errors(
      {"routine.yml": {jobs: {build: {"runs-on": ["self-hosted", "Linux"]}}}},
      {targets: []},
    ),
    ["routine.yml:build must not request a self-hosted runner"],
  )
}

fn consumer_canary_workflow(extra: list) -> dict {
  return {
    jobs: {
      consumers: {
        steps: [
          {uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"},
          {uses: "actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1"},
          {
            name: "Rehearse the consumer update at this revision",
            run: "bash scripts/ci/consumer_canary.sh --observe",
          },
        ]
          + extra,
      },
    },
  }
}

@test
pipeline test_consumer_canary_refuses_an_upload(harness: Harness, task: unknown) {
  // The consumer may be private; an upload is the direct way its content
  // would reach this public repository.
  const invalid = consumer_canary_workflow([{uses: "actions/upload-artifact@v4"}])
  const errors = consumer_canary_errors(invalid)
  assert(errors.any(fn(error) { contains(error, "actions/upload-artifact@v4") }))
}

@test
pipeline test_consumer_canary_refuses_a_step_summary(harness: Harness, task: unknown) {
  const invalid = consumer_canary_workflow([{run: "cat report.md >> \"$GITHUB_STEP_SUMMARY\""}])
  assert_eq(
    consumer_canary_errors(invalid),
    ["consumer-canary.yml:consumers must not write a step summary"],
  )
}

@test
pipeline test_consumer_canary_refuses_an_unmasked_identity(harness: Harness, task: unknown) {
  // Variables print in the public log; only a secret is masked.
  const invalid = consumer_canary_workflow(
    [
      {
        run: "bash scripts/ci/consumer_canary.sh --observe",
        env: {CANARY_NAME: "vars.CONSUMER_CANARY_REPOSITORY"},
      },
    ],
  )
  assert_eq(len(consumer_canary_errors(invalid)), 1)
}

@test
pipeline test_consumer_canary_accepts_checkout_mint_and_script(harness: Harness, task: unknown) {
  assert_eq(consumer_canary_errors(consumer_canary_workflow([])), [])
}

@test
pipeline test_consumer_observer_uploads_have_only_the_canonical_descriptors(harness: Harness) {
  const workflow = read_yaml(harness.fs, "../../.github/workflows/consumer-canary.yml", nil)
  for name in [
    "Preserve the measured observer failure",
    "Preserve the consumer observation checkpoint",
  ] {
    const uploads = workflow.jobs.consumers.steps.filter(
      fn(step: dict) -> bool { return step?.name == name },
    )
    assert_eq(len(uploads), 1)
    const upload = uploads[0]
    assert_eq(consumer_canary_errors(consumer_canary_workflow([upload])), [])
    for invalid in [
      upload + {with: upload.with + {path: "consumer-private-report"}},
      upload + {with: upload.with + {name: "consumer-private-report"}},
      upload + {uses: "actions/upload-artifact@v7"},
      upload + {env: {PRIVATE_DATA: "consumer-log"}},
      upload + {run: "cat consumer.log"},
      upload + {if: "always()"},
      upload + {with: upload.with + {path: upload.with.path.replace("observe-4", "observe-5")}},
    ] {
      assert(len(consumer_canary_errors(consumer_canary_workflow([invalid]))) > 0)
    }
  }
}

@test
pipeline test_consumer_pairing_runtime_has_only_the_canonical_closed_capability() {
  const node_action = "actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e"
  const node = {runs: {steps: [{uses: node_action}]}}
  const setup = {
    id: "pairing-node",
    name: "Pairing runtime",
    uses: node_action,
    with: {"node-version": "22"},
  }
  const check = fn(step: dict, owner: dict?) { return consumer_canary_errors(
    consumer_canary_workflow([step]),
    nil,
    owner,
  ) }
  assert_eq(check(setup, node), [])
  for owner in [
    nil,
    {},
    {runs: {steps: []}},
    {runs: {steps: [{uses: "actions/upload-artifact@v4"}]}},
  ] {
    assert(len(check(setup, owner)) > 0)
  }
  for invalid in [
    setup + {uses: "actions/setup-node@unknown"},
    setup + {uses: "actions/upload-artifact@v4"},
    setup + {with: {"node-version": "22", cache: "npm"}},
    setup + {with: {"node-version": "24"}},
    setup + {env: {TOKEN: "unmasked"}},
    setup + {run: "echo data >> $GITHUB_STEP_SUMMARY"},
    setup + {if: "true"},
    setup + {"continue-on-error": true},
    setup + {id: "other-node"},
  ] {
    assert(len(check(invalid, node)) > 0)
  }
}

@test
pipeline test_consumer_observer_cannot_hide_publication(harness: Harness, task: unknown) {
  const workflow = consumer_canary_workflow([{uses: "./.github/actions/observe-consumer"}])
  assert(len(consumer_canary_errors(workflow)) > 0)
  assert(len(consumer_canary_errors(workflow, {runs: {using: "composite", steps: []}})) > 0)
  const safe = {
    runs: {using: "composite", steps: [{run: "bash scripts/ci/consumer_canary.sh --observe"}]},
  }
  assert_eq(consumer_canary_errors(workflow, safe), [])
  const upload = {runs: {using: "composite", steps: [{uses: "actions/upload-artifact@v4"}]}}
  assert(len(consumer_canary_errors(workflow, upload)) > 0)
  const summary = {
    runs: {using: "composite", steps: [{run: "echo report >> $GITHUB_STEP_SUMMARY"}]},
  }
  assert(len(consumer_canary_errors(workflow, summary)) > 0)
}

pipeline test_consumer_canary_requires_closed_public_custody_before_dispatch(harness: Harness) {
  const root = path_normalize(path_join(harness.fs.source_dir(), "../.."))
  const workflow = read_yaml(
    harness.fs,
    path_join(root, ".github/workflows/consumer-canary.yml"),
    nil,
  )
  const observer = read_yaml(
    harness.fs,
    path_join(root, ".github/actions/observe-consumer/action.yml"),
    nil,
  )
  const node = read_yaml(harness.fs, path_join(root, ".github/actions/node-cache/action.yml"), nil)
  const declaration = read_yaml(
    harness.fs,
    path_join(root, ".github/actions/consumer-observer-declare/action.yml"),
    nil,
  )
  const check = fn(candidate: dict, action: dict?) { return consumer_canary_errors(
    candidate,
    observer,
    node,
    action,
  ) }
  assert_eq(check(workflow, declaration), [])
  const publication = declaration.runs.steps[1]
  for action in [
    nil,
    {},
    declaration + {outputs: {context: {value: "unqualified"}}},
    declaration
      + {
        runs: {using: "composite", steps: declaration.runs.steps + [{run: "publish private data"}]},
      },
    declaration
      + {
        runs: {
          using: "composite",
          steps: [
            declaration.runs.steps[0],
            publication + {with: publication.with + {path: "consumer-private-report"}},
          ],
        },
      },
  ] {
    assert(len(check(workflow, action)) > 0, "the public exception cannot carry consumer data")
  }
  const job = workflow.jobs.consumers
  const steps = job.steps
  let missing = [
    steps.filter({ step -> step?.id != "observer" }).to_list(),
    steps.filter(
      { step -> step?.run != "node scripts/ci/consumer-observer-declare.mjs --witness" },
    )
      .to_list(),
    steps.map(
      { step ->
        if step?.run == "node scripts/ci/consumer-observer-declare.mjs --witness" {
          step + {env: step.env + {SOURCE_REVISION: "wrong source"}}
        } else {
          step
        }
      },
    )
      .to_list(),
    steps.reversed(),
    steps.map(
      { step ->
        if step?.id == "observer" {
          step + {if: "true"}
        } else {
          step
        }
      },
    )
      .to_list(),
  ]
  // Dispatch must name the one revision the decide job resolved for custody.
  for revision in ["$" + "{{ github.sha }}", "$" + "{{ inputs.source_revision || github.sha }}"] {
    missing = missing
      + [
        steps.map(
          { step ->
            if step?.id == "canary" {
              step + {env: step.env + {SOURCE_REVISION: revision}}
            } else {
              step
            }
          },
        )
          .to_list(),
      ]
  }
  for key in ["OBSERVER_CONTEXT", "PARENT_READ_TOKEN", "SOURCE_REVISION"] {
    missing = missing
      + [
        steps.map(
          { step ->
            if step?.id == "canary" {
              step + {env: step.env + {[key]: nil}}
            } else {
              step
            }
          },
        )
          .to_list(),
      ]
  }
  for candidate in missing {
    const changed = workflow + {jobs: workflow.jobs + {consumers: job + {steps: candidate}}}
    assert(len(check(changed, declaration)) > 0, "fresh dispatch cannot omit or outrun custody")
  }
  const no_read = workflow
    + {jobs: workflow.jobs + {consumers: job + {permissions: {contents: "read"}}}}
  assert(len(check(no_read, declaration)) > 0)
  for concurrency in [
    workflow.concurrency + {"cancel-in-progress": true},
    workflow.concurrency + {group: "all-canaries"},
  ] {
    assert(
      len(check(workflow + {concurrency: concurrency}, declaration)) > 0,
      "a schedule cannot retire a release or manual observer",
    )
  }
}

type PolicyWorkflow = {jobs: dict<string, dict>, env?: dict, on?: dict}

fn read_workflow(fs: HarnessFs, name: string) -> PolicyWorkflow {
  return read_yaml_typed(
    fs,
    path_join(fs.source_dir(), "../../.github/workflows/${name}"),
    schema_of(PolicyWorkflow),
  )
}

fn workflow(fs: HarnessFs) -> PolicyWorkflow {
  const ci = read_workflow(fs, "ci.yml")
  const refresh = refresh_workflow(fs)
  return schema_expect(
    {...ci, jobs: {...ci.jobs, "rust-cache-refresh": refresh.jobs["rust-cache-refresh"]}},
    schema_of(PolicyWorkflow),
  )
}

fn windows_cache_writer(fs: HarnessFs) -> PolicyWorkflow {
  return read_workflow(fs, "windows-nightly.yml")
}

fn with_windows_writer_steps(writer: dict, steps: list) -> dict {
  return {...writer, jobs: {...writer.jobs, nextest: {...writer.jobs.nextest, steps: steps}}}
}

fn with_windows_writer_inputs(writer: dict, inputs: dict) -> dict {
  const steps = writer.jobs.nextest.steps
  const caches = steps.filter(
    fn(step: dict) -> bool { return step?.uses == "./.github/actions/rust-cache" },
  )
    .to_list()
  assert_eq(len(caches), 1, "the canonical Windows writer must name exactly one cache step")
  return with_windows_writer_steps(
    writer,
    steps.map(
      fn(step: dict) -> dict {
        if step == caches[0] {
          return {...step, with: {...step.with, ...inputs}}
        }
        return step
      },
    )
      .to_list(),
  )
}

@test
pipeline test_accepts_persistent_compile_lanes_with_hosted_fallback(
  harness: Harness,
  task: unknown,
) {
  assert_eq(ci_linux_lane_policy_errors(workflow(harness.fs)), [])
}

@test
pipeline test_ordinary_linux_consumers_cannot_reintroduce_persistent_generation_writers(
  harness: Harness,
) {
  const valid = workflow(harness.fs)
  assert_eq(ci_linux_lane_policy_errors(valid), [])
  for name in ["package-audit", "rust-check-inputs", "rust-cli"] {
    const job = valid.jobs[name]
    const steps = job.steps.map(
      { step ->
        if step?.uses == "./.github/actions/rust-cache" {
          return {...step, with: {...step.with, save: "true"}}
        }
        return step
      },
    )
      .to_list()
    const invalid = {
      ...valid,
      jobs: {...valid.jobs, [name]: {...job, steps: steps, permissions: {contents: "read"}}},
    }
    assert(
      ci_linux_lane_policy_errors(invalid).contains(
        "ci.yml:${name} must restore only; persistent Linux generations belong to the admitted refresh producer",
      ),
    )
    assert(
      ci_linux_lane_policy_errors(invalid).contains(
        "ci.yml:${name} must grant actions: write to persist rust-cache",
      ),
    )
  }
}

fn refresh_workflow(fs: HarnessFs) -> PolicyWorkflow {
  return read_workflow(fs, "rust-cache-refresh.yml")
}

@test
pipeline test_rejects_cache_writer_without_actions_write(harness: Harness, task: unknown) {
  const valid = refresh_workflow(harness.fs)
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cache-refresh": {...valid.jobs["rust-cache-refresh"], permissions: {contents: "read"}},
    },
  }
  const errors = cache_refresh_workflow_errors(invalid)
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must grant actions: write to persist rust-cache",
    ),
  )
}

/**
 * The falsifier for the trigger itself. The refresh spent a week doing nothing
 * because it was gated on a merge-queue proof while the queue was off, and no
 * check noticed: the job was present, correct, and unreachable. A trigger set
 * that names an optional event instead of the persistent ref is refused here,
 * and so is one with no scheduled backstop.
 */
@test
pipeline test_rejects_a_cache_refresh_trigger_that_may_never_fire(harness: Harness, task: unknown) {
  assert_eq(cache_refresh_trigger_errors(refresh_workflow(harness.fs)), [])
  const queue_gated = {
    ...refresh_workflow(harness.fs),
    on: {merge_group: nil, schedule: [{cron: "43 9 * * *"}]},
  }
  const queue_errors = cache_refresh_trigger_errors(queue_gated)
  assert(
    queue_errors.contains(
      "rust-cache-refresh.yml must trigger on a push to main; a refresh gated on the merge queue stops running when the queue is off",
    ),
  )
  assert(
    queue_errors.contains(
      "rust-cache-refresh.yml must not depend on merge_group; the merge queue is optional and its absence must not disable the refresh",
    ),
  )
  const no_backstop = {...refresh_workflow(harness.fs), on: {push: {branches: ["main"]}}}
  assert(
    cache_refresh_trigger_errors(no_backstop).contains(
      "rust-cache-refresh.yml must carry a scheduled backstop so a quiet period does not leave the caches unwritten",
    ),
  )
}

@test
pipeline test_rejects_unbounded_or_non_main_cache_generation_save(harness: Harness) {
  const valid = workflow(harness.fs)
  const refresh = valid.jobs["rust-cache-refresh"]
  const invalid_steps = refresh.steps.map(
    fn(step: dict) -> dict {
      if step?.name == "Prepare Linux cache generation save" {
        return {...step, if: "steps.rust-cache.outputs.cache-hit != 'true'", run: "echo unbounded"}
      }
      return step
    },
  )
  const invalid_matrix = refresh.strategy.matrix.include.map(
    fn(entry) { return {...entry, save_headroom_bytes: 1610612736} },
  )
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-cache-refresh": {
        ...refresh,
        strategy: {...refresh.strategy, matrix: {include: invalid_matrix}},
        steps: invalid_steps,
      },
    },
  }
  const errors = cache_refresh_workflow_errors(
    {...refresh_workflow(harness.fs), jobs: invalid.jobs},
  )
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh matrix legs must reserve their measured save envelope",
    ),
  )
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must prepare a generation only from owning main after a cache miss",
    ),
  )
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must admit save headroom without deleting its current generation",
    ),
  )
}

@test
pipeline test_rejects_incomplete_workspace_cache_generation(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const audit = valid.jobs["package-audit"]
  const steps = audit.steps.map(
    { step ->
      if step?.uses != "./.github/actions/rust-cache" {
        return step
      }
      return {...step, with: {...step?.with ?? {}, "cache-workspace-crates": "false"}}
    },
  )
    .to_list()
  const invalid = {...valid, jobs: {...valid.jobs, "package-audit": {...audit, steps: steps}}}
  assert(
    ci_linux_lane_policy_errors(invalid).contains(
      "ci.yml:package-audit must keep complete hosted cache package-audit",
    ),
  )
}

@test
pipeline test_rejects_missing_main_scoped_cache_refresh(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  let jobs = {}
  for {key: name, value: job} in valid.jobs {
    if name != "rust-cache-refresh" {
      jobs[name] = job
    }
  }
  const errors = cache_refresh_workflow_errors({...refresh_workflow(harness.fs), jobs: jobs})
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must define the hosted Linux compile lane",
    ),
  )
  assert(
    errors.contains(
      "rust-cache-refresh.yml:rust-cache-refresh must define the main-scoped cache writer",
    ),
  )
}

@test
pipeline test_rejects_recompiling_workspace_test_consumer(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-test": {
        ...valid.jobs["rust-test"],
        "timeout-minutes": 12,
        steps: [
          {uses: "./.github/actions/rust-cache"},
          {
            name: "Run Rust workspace tests",
            env: {CARGO_BUILD_JOBS: "4"},
            run: "cargo-nextest nextest run --workspace --profile ci",
          },
        ],
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:rust-test must keep the execution-only 35-minute timeout"))
  assert(errors.contains("ci.yml:rust-test must not restore compiler caches or build-disk setup"))
  assert(errors.contains("ci.yml:rust-test must verify the archived Rust runtime contract"))
  assert(errors.contains("ci.yml:rust-test must execute only the remapped nextest archive"))
  assert(errors.contains("ci.yml:rust-test must not configure compile fan-out"))
}

@test
pipeline test_rejects_parallel_tests_without_fail_closed_fallback(harness: Harness) {
  const valid = workflow(harness.fs)
  const rust_job = valid.jobs["rust-check-inputs"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-check-inputs": {
        ...rust_job,
        steps: rust_job.steps.filter({ step -> step?.name != "Run Rust workspace tests" }).map(
          { step ->
            if step?.name != "Build portable workspace test archive" {
              return step
            }
            return {...step, if: "true", run: "cargo build"}
          },
        )
          .to_list(),
      },
      "rust-test": {...valid.jobs["rust-test"], if: "false"},
      "rust-test-partitions": {
        ...valid.jobs["rust-test-partitions"],
        strategy: {matrix: {include: []}},
      },
      "rust-test-status": {...valid.jobs["rust-test-status"], if: "success()"},
      "ci-status": {
        steps: [
          {
            name: "Verify required CI jobs",
            env: {BLACKSMITH_DISABLED: "true"},
            run: "[ \"$BLACKSMITH_DISABLED\" = true ]",
          },
        ],
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-check-inputs must build the workspace test archive only for the standalone fallback",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:rust-test-partitions must execute every exact workspace test share independently",
    ),
  )
  assert(errors.contains("ci.yml:rust-test must run only as the co-location kill-switch fallback"))
  assert(errors.contains("ci.yml:ci-status must require the complete Rust test verdict"))
  assert(
    errors.contains(
      "ci.yml:rust-test-status must verify every partition or the complete archive fallback",
    ),
  )
}

@test
pipeline test_rejects_serialized_live_artifact_handoff(harness: Harness, task: unknown) {
  const valid = workflow(harness.fs)
  const cli_producer = valid.jobs["rust-cli"]
  const upload = cli_producer.steps.find({ step -> step?.name == "Upload portable Harn CLI" })
  const walltime_report = valid.jobs["ci-walltime-report"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      // Publishing before the build hands consumers a stale or absent CLI.
      "rust-cli": {
        ...cli_producer,
        steps: [upload]
          + cli_producer.steps.filter({ step -> step?.name != "Upload portable Harn CLI" }).to_list(),
      },
      "rust-security": {
        ...valid.jobs["rust-security"],
        needs: ["changes", "rust-artifacts-ready"],
        if:
          "needs.changes.outputs.rust == 'true' && needs.rust-artifacts-ready.result == 'success'",
      },
      "ci-walltime-report": {
        ...walltime_report,
        steps: walltime_report.steps.map(
          { step ->
            if step.name != "Upload CI timing report" {
              return step
            }
            return {...step, "continue-on-error": true, with: {"if-no-files-found": "warn"}}
          },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(errors.contains("ci.yml:rust-cli must build and then publish the shared Harn CLI"))
  assert(
    errors.contains(
      "ci.yml:rust-security must consume the exact-commit security archive through its ready barrier",
    ),
  )
  assert(
    errors.contains(
      "ci.yml:ci-walltime-report must publish a non-empty fail-closed timing report off the conformance tail",
    ),
  )
}

