@test
pipeline test_rejects_strict_clippy_cache_safety_bypass(harness: Harness, task) {
  const valid = workflow()
  const rust_job = valid.jobs["rust-checks"]
  const invalid = {
    ...valid,
    jobs: {
      ...valid.jobs,
      "rust-checks": {
        ...rust_job,
        steps: rust_job.steps.map(
          { step ->
            if step?.name != "Check Rust code with Clippy" {
              return step
            }
            return {...step, run: "cargo clippy --workspace --all-targets -- -D warnings"}
          },
        )
          .to_list(),
      },
    },
  }
  const errors = ci_linux_lane_policy_errors(invalid)
  assert(
    errors.contains(
      "ci.yml:rust-checks must route strict Clippy through the cache-safe Rust lint entrypoint",
    ),
  )
}

