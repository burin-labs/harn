// Tests for scripts/check_receipt_struct_duplication.harn — exercise the
// pure helpers on synthetic Rust snippets (no filesystem dependency).
import "../check_receipt_struct_duplication.harn"

@test
pipeline test_is_skipped_matches_components(task) {
  assert_eq(is_skipped("target/debug/foo.rs"), true)
  assert_eq(is_skipped("crates/x/node_modules/y.rs"), true)
  assert_eq(is_skipped("docs/whatever.rs"), true)
  assert_eq(is_skipped("crates/harn-vm/src/foo.rs"), false)
}

@test
pipeline test_strip_comments_removes_line_and_block(task) {
  const src = "pub a; // trailing\n/* block\nspanning */ pub b;"
  const out = strip_comments(src)
  assert_eq(out.contains("trailing"), false)
  assert_eq(out.contains("block"), false)
  assert_eq(out.contains("pub a;"), true)
  assert_eq(out.contains("pub b;"), true)
}

@test
pipeline test_brace_body_balances(task) {
  // open brace at index 0; matching close at the final '}'.
  const text = "{ a { b } c }X"
  assert_eq(brace_body(text, 0), "{ a { b } c ")
}

@test
pipeline test_brace_body_unbalanced_returns_nil(task) {
  assert_eq(brace_body("{ a { b }", 0), nil)
}

@test
pipeline test_find_public_structs_name_and_line(task) {
  const text = "// header\npub struct Foo {\n  pub x: int,\n}\n"
  const structs = find_public_structs(text)
  assert_eq(structs.count, 1)
  assert_eq(structs[0].name, "Foo")
  // `pub struct` is on line 2 (1-based).
  assert_eq(structs[0].line, 2)
}

@test
pipeline test_body_has_full_trio(task) {
  const full = "pub parent_run_id: string, pub trace_id: string, pub cost_usd: float"
  assert_eq(body_has_full_trio(full), true)
  // Missing cost_usd → not a full envelope copy.
  const partial = "pub parent_run_id: string, pub trace_id: string"
  assert_eq(body_has_full_trio(partial), false)
}

@test
pipeline test_violations_in_text_flags_envelope_copy(task) {
  const src =
    "pub struct Dup {\n  pub parent_run_id: string,\n  pub trace_id: string,\n  pub cost_usd: float,\n}\n"
  const v = violations_in_text("crates/x/src/dup.rs", src)
  assert_eq(v.count, 1)
  assert_eq(v[0], "crates/x/src/dup.rs:1: pub struct Dup")
}

@test
pipeline test_violations_in_text_ignores_partial_struct(task) {
  const src = "pub struct Partial {\n  pub parent_run_id: string,\n  pub trace_id: string,\n}\n"
  assert_eq(violations_in_text("a.rs", src).count, 0)
}

@test
pipeline test_violations_in_text_ignores_commented_fields(task) {
  // The trio appears only inside a block comment → stripped → no violation.
  const src =
    "pub struct Looks {\n  /* pub parent_run_id: string, pub trace_id: string, pub cost_usd: f64 */\n  pub other: int,\n}\n"
  assert_eq(violations_in_text("a.rs", src).count, 0)
}

@test
pipeline test_rel_path_extracts_suffix(task) {
  assert_eq(rel_path("/abs/root/./crates/foo.rs"), "crates/foo.rs")
  assert_eq(rel_path("plain/relative.rs"), "plain/relative.rs")
}
