@test
pipeline test_conflicting_current_row_fails_closed(harness: Harness, task: unknown) {
  const input = fixture(harness.fs, "conflicting-current-row")
  const plan = plan_notice(harness, input.notice, input.extraction, BASE_CATALOG)
