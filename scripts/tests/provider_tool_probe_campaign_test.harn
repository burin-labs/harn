@test
pipeline test_provider_tool_probe_campaign_uses_case_verdict_for_no_tool_fixtures(
  harness: Harness,
  task: unknown,
) {
  const report = {
    cases: [{ok: true, classification: "direct_answer_no_tool", fallback_mode: "disabled"}],
    tool_calling: {
      native: "fail",
      text: "fail",
      streaming_native: "unknown",
      fallback_mode: "disabled",
    },
  }
  assert_eq(provider_tool_probe_campaign_case_status(report), "pass")
  assert_eq(
    provider_tool_probe_campaign_case_status(
      report + {cases: [{ok: false, failure_reason: "spurious tool call"}]},
    ),
    "fail",
  )
  assert_eq(provider_tool_probe_campaign_case_status({cases: []}), "skip")
}

