  assert_eq(report.auth_readiness.route_count, 3)
  assert_eq(report.auth_readiness.ready_routes, 2)
  assert_eq(report.auth_readiness.missing_auth_routes, 1)
  assert_eq(report.auth_readiness.local_routes, 1)
  assert_eq(report.auth_readiness.hosted_routes, 2)
  assert_eq(report.auth_readiness.ready_by_provider.moonshot, 1)
  assert_eq(report.auth_readiness.ready_by_provider.ollama, 1)
  assert_eq(report.auth_readiness.missing_by_provider.fireworks, 1)
  assert_eq(
    report.auth_readiness.missing_env_candidates_by_provider.fireworks,
    ["FIREWORKS_API_KEY"],
  )
}

@test
pipeline test_provider_tool_probe_campaign_artifact_paths_are_unique_per_behavior_case(
  harness: Harness,
  task: unknown,
) {
  const route: ProviderToolProbeRoute = {
    id: "ollama-gemma4-e4b",
    provider: "ollama",
    model: "gemma4:e4b",
    env_keys: [],
    local: true,
    cheap: true,
    metadata: {source: "fixture"},
  }
  const behaviors = provider_tool_probe_campaign_filter_behavior_modes(
    provider_tool_probe_campaign_select_behaviors(["provider_tool_probe"]),
    "non-streaming",
  )
  let paths: list<string> = []
  for behavior in behaviors {
    const path = provider_tool_probe_campaign_artifact_path(
      route,
      behavior,
      "non-streaming",
      "native",
      ".out",
    )
    assert_false(paths.contains(path), "artifact path must be unique: " + path)
    paths = paths + [path]
  }
  assert_eq(len(paths), 7)
  assert_contains(paths[0] ?? "", "tool-calling-non-streaming")
  assert_contains(paths[0] ?? "", "single-tool-call")
  assert_contains(paths[1] ?? "", "parallel-tool-calls")
}

