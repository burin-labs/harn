@test
pipeline test_provider_tool_probe_campaign_auth_readiness_summarizes_env_without_live_calls(
  harness: Harness,
  task: unknown,
) {
  const routes: list<ProviderToolProbeRoute> = [
    {
      id: "fireworks-fixture",
      provider: "fireworks",
      model: "accounts/fireworks/models/gpt-oss-120b",
      env_keys: ["FIREWORKS_API_KEY"],
      local: false,
      cheap: true,
      metadata: {source: "fixture"},
    },
    {
      id: "moonshot-fixture",
      provider: "moonshot",
      model: "kimi-k2.6",
      env_keys: ["MOONSHOT_API_KEY", "MOONSHOT_AI_API_KEY", "KIMI_API_KEY"],
      local: false,
      cheap: true,
      metadata: {source: "fixture"},
    },
    {
      id: "ollama-fixture",
      provider: "ollama",
      model: "gemma4:e4b",
      env_keys: [],
      local: true,
      cheap: true,
      metadata: {source: "fixture"},
    },
  ]
  const behaviors = provider_tool_probe_campaign_select_behaviors(["tool_calling_non_streaming"])
  const cells = provider_tool_probe_campaign_planned_cells(harness.llm, routes, behaviors)
  const report = provider_tool_probe_campaign_report(
    routes,
    behaviors,
    cells,
    false,
    false,
    ".out",
    1,
    {
      env: {KIMI_API_KEY: "present"},
      env_source: {checked: true, loaded: true, parsed_key_count: 1, reason: "loaded"},
    },
    verified_runtime(),
    verified_catalog(),
  )
  assert_eq(report.auth_readiness.env_checked, true)
  assert_eq(report.auth_readiness.env_source.loaded, true)
