@test
pipeline test_provider_tool_probe_campaign_auth_readiness_summarizes_env_without_live_calls(task) {
  const routes: list<ProviderToolProbeRoute> = [
    {
      id: "fireworks-fixture",
      provider: "fireworks",
      model: "accounts/fireworks/models/gpt-oss-120b",
      env_keys: ["FIREWORKS_API_KEY"],
      local: false,
      cheap: true,
      metadata: {source: "fixture"},
    },
    {
      id: "moonshot-fixture",
      provider: "moonshot",
      model: "kimi-k2.6",
      env_keys: ["MOONSHOT_API_KEY", "MOONSHOT_AI_API_KEY", "KIMI_API_KEY"],
      local: false,
      cheap: true,
      metadata: {source: "fixture"},
    },
    {
      id: "ollama-fixture",
      provider: "ollama",
      model: "gemma4:e4b",
      env_keys: [],
      local: true,
      cheap: true,
      metadata: {source: "fixture"},
    },
  ]
  const behaviors = provider_tool_probe_campaign_select_behaviors(["tool_calling_non_streaming"])
  const cells = provider_tool_probe_campaign_planned_cells(routes, behaviors)
  const report = provider_tool_probe_campaign_report(
    routes,
    behaviors,
    cells,
    false,
    false,
    ".out",
    1,
    {KIMI_API_KEY: "present"},
    {checked: true, loaded: true, parsed_key_count: 1, reason: "loaded"},
    verified_runtime(),
  )
  assert_eq(report.auth_readiness.env_checked, true)
  assert_eq(report.auth_readiness.env_source.loaded, true)
  assert_eq(report.auth_readiness.env_source.parsed_key_count, 1)
  assert_eq(report.auth_readiness.route_count, 3)
  assert_eq(report.auth_readiness.ready_routes, 2)
  assert_eq(report.auth_readiness.missing_auth_routes, 1)
  assert_eq(report.auth_readiness.local_routes, 1)
  assert_eq(report.auth_readiness.hosted_routes, 2)
  assert_eq(report.auth_readiness.ready_by_provider.moonshot, 1)
  assert_eq(report.auth_readiness.ready_by_provider.ollama, 1)
  assert_eq(report.auth_readiness.missing_by_provider.fireworks, 1)
  assert_eq(report.auth_readiness.missing_env_candidates_by_provider.fireworks, ["FIREWORKS_API_KEY"])
}

@test
pipeline test_provider_tool_probe_campaign_artifact_paths_are_unique_per_behavior_case(task) {
  const route: ProviderToolProbeRoute = {
    id: "ollama-gemma4-e4b",
    provider: "ollama",
    model: "gemma4:e4b",
    env_keys: [],
    local: true,
    cheap: true,
    metadata: {source: "fixture"},
  }
  const behaviors = provider_tool_probe_campaign_filter_behavior_modes(
    provider_tool_probe_campaign_select_behaviors(["provider_tool_probe"]),
    "non-streaming",
  )
  let paths: list<string> = []
  for behavior in behaviors {
    const path = provider_tool_probe_campaign_artifact_path(route, behavior, "non-streaming", ".out")
    assert_false(paths.contains(path), "artifact path must be unique: " + path)
    paths = paths + [path]
  }
  assert_eq(len(paths), 4)
  assert_contains(paths[0] ?? "", "tool-calling-non-streaming")
  assert_contains(paths[0] ?? "", "single-tool-call")
  assert_contains(paths[1] ?? "", "parallel-tool-calls")
}

@test
pipeline test_provider_tool_probe_campaign_dotenv_parser_does_not_require_shell(task) {
  const env = provider_tool_probe_campaign_env_from_dotenv_text(
    "# ignored\nexport FIREWORKS_API_KEY=\"secret=value\"\nEMPTY=\nBAD LINE\nMOONSHOT_API_KEY='moon'\n",
  )
  assert_eq(env.FIREWORKS_API_KEY, "secret=value")
  assert_eq(env.MOONSHOT_API_KEY, "moon")
  assert_eq(env.EMPTY, "")
  assert_eq(env.BAD, nil)
}

@test
pipeline test_provider_tool_probe_campaign_cli_parses_catalog_routes(task) {
  const parsed = provider_tool_probe_campaign_parse_args(
    [
      "--catalog-routes",
      "--include-expensive",
      "--shard-count",
      "4",
      "--shard-index",
      "2",
      "--max-probes",
      "10",
    ],
  )
  assert_eq(parsed.catalog_routes, true)
  assert_eq(parsed.include_expensive, true)
  assert_eq(parsed.shard_count, 4)
  assert_eq(parsed.shard_index, 2)
  assert_eq(parsed.max_probes, 10)
}

@test
pipeline test_provider_tool_probe_campaign_markdown_escapes_reasons(task) {
  const route: ProviderToolProbeRoute = {
    id: "fixture-route",
    provider: "mock",
    model: "mock",
    env_keys: [],
    local: true,
    cheap: true,
    metadata: {source: "fixture"},
  }
  const behavior: ProviderToolProbeBehavior = {
    id: "fixture-behavior",
    category: "tool_calls",
    description: "fixture",
    runner: "provider_tool_probe",
    modes: ["non-streaming"],
    tool_formats: ["native"],
    cheap: true,
  }
  const cell = {
    id: "cell",
    provider: route.provider,
    model: route.model,
    route_id: route.id,
    behavior: behavior.id,
    category: behavior.category,
    mode: "non-streaming",
    tool_format: "native",
    runner: behavior.runner,
    status: "planned",
    reason: "left | right",
    observed: {},
    catalog: {},
  }
  const report = provider_tool_probe_campaign_report(
    [route],
    [behavior],
    [cell],
    false,
    false,
    ".out",
    1,
    {},
    {checked: false},
    verified_runtime(),
  )
  const markdown = provider_tool_probe_campaign_markdown(report)
  assert_contains(markdown, "- Target runtime: `" + json_stringify(verified_runtime()) + "`")
  assert_contains(markdown, "left \\| right")
}
