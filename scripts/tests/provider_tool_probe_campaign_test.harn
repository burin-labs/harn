import { assert_contains, assert_false, assert_true } from "std/testing"
import "../provider_tool_probe_campaign.harn"

fn verified_runtime() -> ProviderToolProbeRuntimeReceipt {
  return {
    schema_version: "harn.provider_tool_probe_runtime.v1",
    command: ["harn", "version", "--json"],
    status: "verified",
    exit_code: 0,
    version: "0.10.24",
    reason: "target Harn runtime identified",
  }
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_verified_runtime_receipt(task) {
  const receipt = provider_tool_probe_campaign_runtime_receipt(
    "/opt/harn",
    {
      exit_code: 0,
      stdout: json_stringify({schemaVersion: 1, ok: true, data: {name: "harn-cli", version: "0.10.24"}}),
      stderr: "",
    },
  )
  assert_eq(
    receipt,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["/opt/harn", "version", "--json"],
      status: "verified",
      exit_code: 0,
      version: "0.10.24",
      reason: "target Harn runtime identified",
    },
  )
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(receipt), true)
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_unavailable_runtime_receipt(task) {
  const receipt = provider_tool_probe_campaign_runtime_receipt(
    "missing-harn",
    {exit_code: 127, stdout: "", stderr: "command not found"},
  )
  assert_eq(
    receipt,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["missing-harn", "version", "--json"],
      status: "unavailable",
      exit_code: 127,
      version: "",
      reason: "command not found",
    },
  )
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(receipt), false)
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_invalid_runtime_receipts(task) {
  const malformed = provider_tool_probe_campaign_runtime_receipt("harn", {exit_code: 0, stdout: "not-json", stderr: ""})
  assert_eq(
    malformed,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["harn", "version", "--json"],
      status: "invalid",
      exit_code: 0,
      version: "",
      reason: "target Harn runtime produced invalid version JSON",
    },
  )
  const wrong_contract = provider_tool_probe_campaign_runtime_receipt(
    "harn",
    {exit_code: 0, stdout: json_stringify({ok: true, data: {name: "harn-cli", version: "1.0.0"}})},
  )
  assert_eq(
    wrong_contract,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["harn", "version", "--json"],
      status: "invalid",
      exit_code: 0,
      version: "",
      reason: "target Harn runtime version JSON did not match the harn-cli contract",
    },
  )
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(malformed), false)
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(wrong_contract), false)
}

@test
pipeline test_provider_tool_probe_campaign_env_file_is_explicit_and_portable(task) {
  assert_eq(
    provider_tool_probe_campaign_env_file(" /explicit/.env ", "/configured/.env"),
    "/explicit/.env",
  )
  assert_eq(provider_tool_probe_campaign_env_file("", " /configured/.env "), "/configured/.env")
  assert_eq(provider_tool_probe_campaign_env_file("", ""), "")
}

@test
pipeline test_provider_tool_probe_campaign_parses_explicit_routes(task) {
  const routes = provider_tool_probe_campaign_routes(
    ["anthropic:claude-sonnet-5", "fireworks:accounts/fireworks/models/gpt-oss-120b"],
  )
  assert_eq(len(routes), 2)
  const first = routes[0]
  const second = routes[1]
  assert_eq(first.provider, "anthropic")
  assert_eq(first.model, "claude-sonnet-5")
  assert_eq(first.env_keys, [])
  assert_eq(second.provider, "fireworks")
  assert_eq(second.model, "accounts/fireworks/models/gpt-oss-120b")
}

@test
pipeline test_provider_tool_probe_campaign_cli_collects_repeated_routes_and_behaviors(task) {
  const parsed = provider_tool_probe_campaign_parse_args(
    [
      "--route",
      "fireworks:accounts/fireworks/models/gpt-oss-120b",
      "--route",
      "groq:openai/gpt-oss-120b",
      "--behavior",
      "tool_calling_non_streaming",
      "--behavior",
      "tool_calling_streaming",
    ],
  )
  assert_eq(
    parsed.route,
    ["fireworks:accounts/fireworks/models/gpt-oss-120b", "groq:openai/gpt-oss-120b"],
  )
  assert_eq(parsed.behavior, ["tool_calling_non_streaming", "tool_calling_streaming"])
}

@test
pipeline test_provider_tool_probe_campaign_rejects_malformed_routes(task) {
  const routes = provider_tool_probe_campaign_routes(["missing-separator", "openai:", ":model", "ollama:gemma4:e4b"])
  assert_eq(len(routes), 1)
  const route = routes[0]
  assert_eq(route.provider, "ollama")
  assert_eq(route.model, "gemma4:e4b")
}

@test
pipeline test_provider_tool_probe_campaign_default_routes_are_cheap_by_default(task) {
  const routes = provider_tool_probe_campaign_default_routes(false)
  const ids = routes.map({ route -> route.id }).to_list()
  assert_contains(ids, "fireworks-gpt-oss-120b")
  assert_contains(ids, "cerebras-gpt-oss-120b")
  assert_contains(ids, "openrouter-gpt-oss-120b")
  assert_contains(ids, "moonshot-kimi")
  assert_contains(ids, "local-vllm")
  assert_contains(ids, "ollama")
  assert_false(ids.contains("xai-grok"), "xAI is excluded unless expensive defaults are requested")
}

@test
pipeline test_provider_tool_probe_campaign_include_expensive_adds_xai(task) {
  const routes = provider_tool_probe_campaign_default_routes(true)
  const ids = routes.map({ route -> route.id }).to_list()
  assert_contains(ids, "xai-grok")
}

@test
pipeline test_provider_tool_probe_campaign_catalog_routes_use_catalog_metadata(task) {
  const catalog = {
    providers: [
      {id: "anthropic", classification: "hosted", auth: {env: ["ANTHROPIC_API_KEY"], required: true}},
      {id: "ollama", classification: "local", auth: {env: [], required: false}},
    ],
    models: [
      {
        provider: "anthropic",
        id: "claude-sonnet-fixture",
        strengths: ["coding"],
        pricing: {input_per_mtok: 3.0, output_per_mtok: 15.0},
      },
      {provider: "ollama", id: "local-fixture", strengths: [], pricing: {}},
    ],
  }
  const cheap = provider_tool_probe_campaign_catalog_routes(catalog, false)
  assert_eq(len(cheap), 1)
  assert_eq(cheap[0]?.provider, "ollama")
  assert_eq(cheap[0]?.local, true)
  assert_eq(cheap[0]?.cheap, true)
  const all = provider_tool_probe_campaign_catalog_routes(catalog, true)
  assert_eq(len(all), 2)
  const anthropic = all.filter({ route -> route.provider == "anthropic" }).to_list()[0]
  assert_eq(anthropic.env_keys, ["ANTHROPIC_API_KEY"])
  assert_eq(anthropic.local, false)
  assert_eq(anthropic.cheap, false)
}

