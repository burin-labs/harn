@test
pipeline test_provider_tool_probe_campaign_requires_measured_true_and_false_controls(
  harness: Harness,
  task: unknown,
) {
  const route = provider_tool_probe_campaign_routes(["anthropic:claude-opus-4-7"])[0]
  const behavior = provider_tool_probe_campaign_select_behaviors(["temperature"])[0]
  const command = ["harn", "provider", "option-probe"]
  const accepted_report = {
    schema_version: "harn.provider_option_probe.v1",
    endpoint: {provider: route.provider, model: route.model, route: "anthropic:default"},
    option: "temperature",
    catalog: {field: "temperature_supported", claimed_supported: true},
    probe: {
      ungated: true,
      request_count: 1,
      measured_count: 1,
      verdict: "accepted",
      attempt: {verdict: "accepted", measured: true, cost_usd: 0.001},
    },
    diff: {status: "match", claimed_supported: true, observed_supported: true},
  }
  const rejected_report = accepted_report
    + {
      catalog: {field: "temperature_supported", claimed_supported: false},
      probe: accepted_report.probe
        + {verdict: "rejected", attempt: {verdict: "rejected", measured: true, cost_usd: 0.0}},
      diff: {status: "match", claimed_supported: false, observed_supported: false},
    }
  const accepted = provider_tool_probe_campaign_option_probe_cell(
    harness.llm,
    route,
    behavior,
    accepted_report,
    "accepted.json",
    command,
    0,
  )
  const rejected = provider_tool_probe_campaign_option_probe_cell(
    harness.llm,
    route,
    behavior,
    rejected_report,
    "rejected.json",
    command,
    0,
  )
  const only_positive = provider_tool_probe_campaign_report(
    [route],
    [behavior],
    [accepted],
    true,
    false,
    ".out",
    1,
    {env: {}, env_source: {checked: false}},
    verified_runtime(),
    verified_catalog(),
  )
  const both = provider_tool_probe_campaign_report(
    [route],
    [behavior],
    [accepted, rejected],
    true,
    false,
    ".out",
    1,
    {env: {}, env_source: {checked: false}},
    verified_runtime(),
    verified_catalog(),
  )
  assert_eq(only_positive.claim_controls.status, "incomplete")
  assert_eq(only_positive.claim_controls.measured_supported_count, 1)
  assert_eq(only_positive.claim_controls.measured_unsupported_count, 0)
  assert_eq(both.claim_controls.status, "complete")
  assert_eq(both.claim_controls.measured_supported_count, 1)
  assert_eq(both.claim_controls.measured_unsupported_count, 1)
}

