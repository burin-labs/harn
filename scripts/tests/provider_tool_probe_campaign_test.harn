@test
pipeline test_provider_tool_probe_campaign_catalog_routes_prefer_routing_routes(task) {
  const catalog = {
    providers: [
      {id: "baseten", classification: "hosted", auth: {env: ["BASETEN_API_KEY"]}},
      {id: "fireworks", classification: "hosted", auth: {env: ["FIREWORKS_API_KEY"]}},
    ],
    models: [
      {
        provider: "baseten",
        id: "baseten/moonshotai/Kimi-K2.5",
        wire_model: "moonshotai/Kimi-K2.5",
        strengths: ["coding"],
        pricing: {input_per_mtok: 0.6, output_per_mtok: 3.0},
      },
      {
        provider: "fireworks",
        id: "accounts/fireworks/models/gpt-oss-120b",
        strengths: ["speed"],
        pricing: {input_per_mtok: 0.3, output_per_mtok: 0.6},
      },
    ],
    routing_routes: [
      {
        provider: "baseten",
        model: "moonshotai/Kimi-K2.5",
        secret_env: "BASETEN_ROUTE_KEY",
        capabilities: ["tools"],
      },
    ],
  }
  const routes = provider_tool_probe_campaign_catalog_routes(catalog, false)
  assert_eq(len(routes), 1)
  assert_eq(routes[0]?.provider, "baseten")
  assert_eq(routes[0]?.model, "moonshotai/Kimi-K2.5")
  assert_eq(routes[0]?.env_keys, ["BASETEN_ROUTE_KEY", "BASETEN_API_KEY"])
  assert_eq(routes[0]?.cheap, true)
  assert_eq(routes[0]?.metadata.source, "routing_route")
  assert_eq(routes[0]?.metadata.catalog_model_id, "baseten/moonshotai/Kimi-K2.5")
  assert_eq(routes[0]?.metadata.catalog_wire_model, "moonshotai/Kimi-K2.5")
  assert_eq(routes[0]?.metadata.route_capabilities, ["tools"])
  assert_eq(routes[0]?.metadata.route_secret_env, "BASETEN_ROUTE_KEY")
}

@test
pipeline test_provider_tool_probe_campaign_env_aliases_are_alternatives(task) {
  const route: ProviderToolProbeRoute = {
    id: "moonshot-fixture",
    provider: "moonshot",
    model: "kimi-k2.6",
    env_keys: ["MOONSHOT_API_KEY", "MOONSHOT_AI_API_KEY", "KIMI_API_KEY"],
    local: false,
    cheap: true,
    metadata: {source: "fixture"},
  }
  assert_eq(provider_tool_probe_campaign_missing_env_keys(route, {}), route.env_keys)
  assert_eq(
    provider_tool_probe_campaign_missing_env_keys(route, {MOONSHOT_AI_API_KEY: "present"}),
    [],
  )
  assert_eq(provider_tool_probe_campaign_missing_env_keys(route, {KIMI_API_KEY: "present"}), [])
}

@test
pipeline test_provider_tool_probe_campaign_modes_expand_both(task) {
  assert_eq(provider_tool_probe_campaign_modes("both"), ["non-streaming", "streaming"])
  assert_eq(provider_tool_probe_campaign_modes("streaming"), ["streaming"])
  assert_eq(provider_tool_probe_campaign_modes("non-streaming"), ["non-streaming"])
  assert_eq(provider_tool_probe_campaign_modes("nonsense"), [])
}

@test
pipeline test_provider_tool_probe_campaign_behavior_filter_matches_category_and_runner(task) {
  const tool_calls = provider_tool_probe_campaign_select_behaviors(["tool_calls"])
  const executable = provider_tool_probe_campaign_select_behaviors(["provider_tool_probe"])
  const parser = provider_tool_probe_campaign_select_behaviors(["parser"])
  assert_eq(len(tool_calls), 2)
  assert_eq(len(executable), 5)
  assert_true(len(parser) >= 2, "parser behaviors are selected by category")
}

@test
pipeline test_provider_tool_probe_campaign_mode_filter_keeps_matching_behaviors(task) {
  const behaviors = provider_tool_probe_campaign_select_behaviors(["tool_calls"])
  const streaming = provider_tool_probe_campaign_filter_behavior_modes(behaviors, "streaming")
  const non_streaming = provider_tool_probe_campaign_filter_behavior_modes(behaviors, "non-streaming")
  assert_eq(len(streaming), 1)
  assert_eq(streaming[0]?.id, "tool_calling_streaming")
  assert_eq(streaming[0]?.modes, ["streaming"])
  assert_eq(len(non_streaming), 1)
  assert_eq(non_streaming[0]?.id, "tool_calling_non_streaming")
}

@test
pipeline test_provider_tool_probe_campaign_planned_cells_cover_route_behavior_formats(task) {
  const routes = provider_tool_probe_campaign_routes(["ollama:gemma4:e4b"])
  const behaviors = provider_tool_probe_campaign_select_behaviors(["tool_calling_non_streaming"])
  const cells = provider_tool_probe_campaign_planned_cells(routes, behaviors)
  assert_eq(len(cells), 3)
  assert_eq(cells[0]?.status, "planned")
  assert_eq(cells[0]?.catalog?.tools, provider_capabilities("ollama", "gemma4:e4b")?.tools)
  assert_eq(cells[0]?.catalog?.route_metadata?.source, "explicit")
  assert_eq(
    cells[0]?.command,
    [
      "harn",
      "provider",
      "tool-probe",
      "ollama",
      "--model",
      "gemma4:e4b",
      "--mode",
      "non-streaming",
      "--case",
      "single_tool_call",
      "--repeat",
      "1",
      "--timeout-secs",
      "60",
      "--json",
    ],
  )
}

