    tool_format: "native",
    runner: behavior.runner,
    status: "planned",
    reason: "left | right",
    observed: {},
    catalog: {},
  }
  const report = provider_tool_probe_campaign_report(
    [route],
    [behavior],
    [cell],
    false,
    false,
    ".out",
    1,
    {env: {}, env_source: {checked: false}},
    verified_runtime(),
    verified_catalog(),
  )
  const markdown = provider_tool_probe_campaign_markdown(report)
  assert_contains(markdown, "- Target runtime: `" + json_stringify(verified_runtime()) + "`")
  assert_contains(markdown, "- Target catalog: `" + json_stringify(verified_catalog()) + "`")
  assert_contains(markdown, "left \\| right")
}
