import { assert_contains, assert_false, assert_true } from "std/testing"
import {
  RuntimeContentFingerprint,
} from "../../crates/harn-stdlib/src/stdlib/runtime/content_fingerprint"
import "../provider_tool_probe_campaign.harn"

fn runtime_content_fingerprint() -> RuntimeContentFingerprint {
  return {
    schema: "harn.runtime_content_fingerprint.v1",
    content_sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    harn_version: "0.10.24",
    embedded_stdlib_sha256: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    compatibility: {
      codegen_fingerprint: "harn-codegen-v1",
      bytecode_schema_version: 1,
      linked_program_schema_version: 1,
      linker_algorithm_version: 1,
      build_features: {
        default: true,
        full: true,
        llm_bench_internals: false,
        vm_bench_internals: false,
        content: true,
        compression: true,
        http_compression: true,
        cloud_aws: true,
        native_keyring: true,
        postgres: true,
        sqlite: true,
        otel: true,
        testbench_wasi: false,
      },
    },
    source_revision: "0123456789abcdef0123456789abcdef01234567",
  }
}

fn verified_runtime() -> ProviderToolProbeRuntimeReceipt {
  return {
    schema_version: "harn.provider_tool_probe_runtime.v1",
    command: ["harn", "version", "--json"],
    status: "verified",
    exit_code: 0,
    version: "0.10.24",
    source_revision: "0123456789abcdef0123456789abcdef01234567",
    runtime_content_fingerprint: runtime_content_fingerprint(),
    reason: "target Harn runtime identified",
  }
}

fn verified_catalog() -> ProviderToolProbeCatalogReceipt {
  return {
    schema_version: "harn.provider_tool_probe_catalog.v1",
    command: ["harn", "provider", "catalog", "show"],
    command_env: {},
    status: "verified",
    exit_code: 0,
    providers_config: "",
    catalog_sha256: "sha256:fixture",
    provider_count: 1,
    model_count: 1,
    route_count: 1,
    reason: "target Harn provider catalog identified",
  }
}

@test
pipeline test_provider_tool_probe_campaign_selects_explicit_provider_config(
  harness: Harness,
  task: unknown,
) {
  assert_eq(
    provider_tool_probe_campaign_providers_config(
      " /explicit/providers.toml ",
      "/configured",
      "/inherited",
    ),
    "/explicit/providers.toml",
  )
  assert_eq(
    provider_tool_probe_campaign_providers_config("", " /configured/providers.toml ", "/inherited"),
    "/configured/providers.toml",
  )
  assert_eq(
    provider_tool_probe_campaign_providers_config("", "", " /inherited/providers.toml "),
    "/inherited/providers.toml",
  )
  assert_eq(provider_tool_probe_campaign_command_env(""), {})
  assert_eq(
    provider_tool_probe_campaign_command_env(" /catalog/providers.toml "),
    {HARN_PROVIDERS_CONFIG: "/catalog/providers.toml"},
  )
  assert_eq(provider_tool_probe_campaign_providers_config_text_error("[aliases]\n"), nil)
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_verified_catalog_snapshot(
  harness: Harness,
  task: unknown,
) {
  const catalog = {
    providers: [{id: "openrouter"}],
    models: [{id: "anthropic/claude-sonnet-4.6"}],
    routing_routes: [{provider: "openrouter", model: "anthropic/claude-sonnet-4.6"}],
  }
  const snapshot = provider_tool_probe_campaign_catalog_snapshot(
    "/opt/harn",
    "/workspace/providers.toml",
    {exit_code: 0, stdout: json_stringify(catalog), stderr: ""},
  )
  assert_eq(snapshot.catalog, catalog)
  assert_eq(
    snapshot.receipt,
    {
      schema_version: "harn.provider_tool_probe_catalog.v1",
      command: ["/opt/harn", "provider", "catalog", "show"],
      command_env: {HARN_PROVIDERS_CONFIG: "/workspace/providers.toml"},
      status: "verified",
      exit_code: 0,
      providers_config: "/workspace/providers.toml",
      catalog_sha256: "sha256:" + sha256(json_stringify(catalog)),
      provider_count: 1,
      model_count: 1,
      route_count: 1,
      reason: "target Harn provider catalog identified",
    },
  )
}

@test
pipeline test_provider_tool_probe_campaign_rejects_unavailable_and_invalid_catalog_snapshots(
  harness: Harness,
  task: unknown,
) {
  const unavailable = provider_tool_probe_campaign_catalog_snapshot(
    "missing-harn",
    "",
    {exit_code: 127, stdout: "", stderr: "command not found"},
  )
  assert_eq(
    unavailable,
    {
      receipt: {
        schema_version: "harn.provider_tool_probe_catalog.v1",
        command: ["missing-harn", "provider", "catalog", "show"],
        command_env: {},
        status: "unavailable",
        exit_code: 127,
        providers_config: "",
        catalog_sha256: "",
        provider_count: 0,
        model_count: 0,
        route_count: 0,
        reason: "command not found",
      },
      catalog: {},
    },
  )
  const invalid = provider_tool_probe_campaign_catalog_snapshot(
    "harn",
    "",
    {exit_code: 0, stdout: json_stringify({providers: [], models: []}), stderr: ""},
  )
  assert_eq(invalid.receipt.status, "invalid")
  assert_eq(invalid.receipt.reason, "target Harn runtime produced invalid provider catalog JSON")
  assert_eq(invalid.catalog, {})
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_verified_runtime_receipt(
  harness: Harness,
  task: unknown,
) {
  const receipt = provider_tool_probe_campaign_runtime_receipt(
    "/opt/harn",
    {
      exit_code: 0,
      stdout: json_stringify(
        {
          schemaVersion: 2,
          ok: true,
          data: {
            name: "harn-cli",
            version: "0.10.24",
            description: "Harn CLI",
            source_revision: "0123456789abcdef0123456789abcdef01234567",
            runtime_content_fingerprint: runtime_content_fingerprint(),
          },
          error: nil,
          warnings: [],
        },
      ),
      stderr: "",
    },
  )
  assert_eq(
    receipt,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["/opt/harn", "version", "--json"],
      status: "verified",
      exit_code: 0,
      version: "0.10.24",
      source_revision: "0123456789abcdef0123456789abcdef01234567",
      runtime_content_fingerprint: runtime_content_fingerprint(),
      reason: "target Harn runtime identified",
    },
  )
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(receipt), true)
  assert_eq(
    provider_tool_probe_campaign_runtime_revision_requirement_error(
      receipt,
      "0123456789abcdef0123456789abcdef01234567",
    ),
    nil,
  )
  assert_eq(
    provider_tool_probe_campaign_runtime_revision_requirement_error(
      receipt,
      "ffffffffffffffffffffffffffffffffffffffff",
    ),
    "target Harn runtime source revision mismatch: expected ffffffffffffffffffffffffffffffffffffffff, got 0123456789abcdef0123456789abcdef01234567",
  )
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_unavailable_runtime_receipt(
  harness: Harness,
  task: unknown,
) {
  const receipt = provider_tool_probe_campaign_runtime_receipt(
    "missing-harn",
    {exit_code: 127, stdout: "", stderr: "command not found"},
  )
  assert_eq(
    receipt,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["missing-harn", "version", "--json"],
      status: "unavailable",
      exit_code: 127,
      version: "",
      source_revision: nil,
      runtime_content_fingerprint: nil,
      reason: "command not found",
    },
  )
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(receipt), false)
  assert_eq(
    provider_tool_probe_campaign_runtime_revision_requirement_error(
      receipt,
      "0123456789abcdef0123456789abcdef01234567",
    ),
    "target Harn runtime did not report a source revision; expected 0123456789abcdef0123456789abcdef01234567",
  )
}

@test
pipeline test_provider_tool_probe_campaign_normalizes_invalid_runtime_receipts(
  harness: Harness,
  task: unknown,
) {
  const malformed = provider_tool_probe_campaign_runtime_receipt(
    "harn",
    {exit_code: 0, stdout: "not-json", stderr: ""},
  )
  assert_eq(
    malformed,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["harn", "version", "--json"],
      status: "invalid",
      exit_code: 0,
      version: "",
      source_revision: nil,
      runtime_content_fingerprint: nil,
      reason: "target Harn runtime produced invalid version JSON",
    },
  )
  const wrong_contract = provider_tool_probe_campaign_runtime_receipt(
    "harn",
    {
      exit_code: 0,
      stdout: json_stringify(
        {schemaVersion: 1, ok: true, data: {name: "harn-cli", version: "1.0.0"}},
      ),
    },
  )
  const unsuccessful = provider_tool_probe_campaign_runtime_receipt(
    "harn",
    {
      exit_code: 0,
      stdout: json_stringify(
        {
          schemaVersion: 2,
          ok: false,
          data: {
            name: "harn-cli",
            version: "0.10.24",
            description: "Harn CLI",
            source_revision: "0123456789abcdef0123456789abcdef01234567",
            runtime_content_fingerprint: runtime_content_fingerprint(),
          },
          error: nil,
          warnings: [],
        },
      ),
    },
  )
  assert_eq(
    wrong_contract,
    {
      schema_version: "harn.provider_tool_probe_runtime.v1",
      command: ["harn", "version", "--json"],
      status: "invalid",
      exit_code: 0,
      version: "",
      source_revision: nil,
      runtime_content_fingerprint: nil,
      reason: "target Harn runtime version JSON did not match the harn-cli contract",
    },
  )
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(malformed), false)
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(wrong_contract), false)
  assert_eq(unsuccessful.status, "invalid")
  assert_eq(provider_tool_probe_campaign_runtime_allows_live(unsuccessful), false)
}

@test
pipeline test_provider_tool_probe_campaign_rejects_schema_two_without_runtime_fingerprint(
  harness: Harness,
  task: unknown,
) {
  const receipt = provider_tool_probe_campaign_runtime_receipt(
    "harn",
    {
      exit_code: 0,
      stdout: json_stringify(
        {
          schemaVersion: 2,
          ok: true,
          data: {
            name: "harn-cli",
            version: "0.10.24",
            description: "Harn CLI",
            source_revision: "0123456789abcdef0123456789abcdef01234567",
          },
          error: nil,
          warnings: [],
        },
      ),
    },
  )
  assert_eq(receipt.status, "invalid")
  assert_eq(receipt.runtime_content_fingerprint, nil)
  assert_eq(receipt.reason, "target Harn runtime version JSON did not match the harn-cli contract")
  assert_false(provider_tool_probe_campaign_runtime_allows_live(receipt))
}

@test
pipeline test_provider_tool_probe_campaign_env_file_is_explicit_and_portable(
  harness: Harness,
  task: unknown,
) {
  assert_eq(
    provider_tool_probe_campaign_env_file(" /explicit/.env ", "/configured/.env"),
    "/explicit/.env",
  )
  assert_eq(provider_tool_probe_campaign_env_file("", " /configured/.env "), "/configured/.env")
  assert_eq(provider_tool_probe_campaign_env_file("", ""), "")
}

@test
pipeline test_provider_tool_probe_campaign_parses_explicit_routes(harness: Harness, task: unknown) {
  const routes = provider_tool_probe_campaign_routes(
    ["anthropic:claude-sonnet-5", "fireworks:accounts/fireworks/models/gpt-oss-120b"],
  )
  assert_eq(len(routes), 2)
  const first = routes[0]
  const second = routes[1]
  assert_eq(first.provider, "anthropic")
  assert_eq(first.model, "claude-sonnet-5")
  assert_eq(first.env_keys, [])
  assert_eq(second.provider, "fireworks")
  assert_eq(second.model, "accounts/fireworks/models/gpt-oss-120b")
}

@test
pipeline test_provider_tool_probe_campaign_cli_collects_repeated_routes_and_behaviors(
  harness: Harness,
  task: unknown,
) {
  const parsed = unwrap(
    provider_tool_probe_campaign_parse_args(
      [
        "--route",
        "fireworks:accounts/fireworks/models/gpt-oss-120b",
        "--route",
        "groq:openai/gpt-oss-120b",
        "--behavior",
        "tool_calling_non_streaming",
        "--behavior",
        "tool_calling_streaming",
      ],
    ),
  ).options
  assert_eq(
    parsed.route,
    ["fireworks:accounts/fireworks/models/gpt-oss-120b", "groq:openai/gpt-oss-120b"],
  )
  assert_eq(parsed.behavior, ["tool_calling_non_streaming", "tool_calling_streaming"])
}

@test
pipeline test_provider_tool_probe_campaign_rejects_malformed_routes(
  harness: Harness,
  task: unknown,
) {
  const routes = provider_tool_probe_campaign_routes(
    ["missing-separator", "openai:", ":model", "ollama:gemma4:e4b"],
  )
  assert_eq(len(routes), 1)
  const route = routes[0]
  assert_eq(route.provider, "ollama")
  assert_eq(route.model, "gemma4:e4b")
