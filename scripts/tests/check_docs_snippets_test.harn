import { assert_throws, with_temp_dir } from "std/testing"
// Tests for scripts/check_docs_snippets.harn — drive the pure fence
// state machine and formatting helpers on synthetic markdown.
import "../check_docs_snippets.harn"
import { parse_snippet_config } from "../docs_snippet_policy.harn"

pipeline test_readme_snippet_formatting_uses_formatter(harness: Harness) {
  const root = path_normalize(path_join(harness.fs.cwd(), "../.."))
  const checker = path_join(root, "scripts/check_docs_snippets.harn")
  const harn_bin = resolve_harn_bin(harness)
  with_temp_dir(
    harness.fs,
    { dir ->
      harness.fs.mkdir(path_join(dir, "docs"))
      harness.fs.write_text(
        path_join(dir, ".harn-docs.toml"),
        "version = 1\ninclude = [\"*.md\"]\ndiagnostic_examples = \"docs/diagnostic-examples.json\"\n[defaults]\nvalidation = \"parse\"\nformat = true\nlint = \"off\"\nline_width = 74\n",
      )
      const readme = path_join(dir, "README.md")
      harness.fs.write_text(readme, "# Example\n\n```harn\nconst answer=42\n```\n")
      const rejected = harness.process.run(
        {
          program: harn_bin,
          args: ["run", "--standalone", checker, "--", "--write-diagnostics"],
          cwd: dir,
          env: {HARN_BIN: harn_bin},
        },
      )
      assert(rejected.exit_code != 0, "unformatted README source must fail the real docs gate")
      assert(rejected.stdout.contains("formatting"), rejected.stdout + rejected.stderr)
      harness.fs.write_text(readme, "# Example\n\n```harn\nconst answer = 42\n```\n")
      const accepted = harness.process.run(
        {
          program: harn_bin,
          args: ["run", "--standalone", checker, "--", "--write-diagnostics"],
          cwd: dir,
          env: {HARN_BIN: harn_bin},
        },
      )
      assert(accepted.success, accepted.stdout + accepted.stderr)
      assert(accepted.stdout.contains("1 checked"), "the corrected example must be measured")
      assert(accepted.stdout.contains("1 formatting checked"), "the formatter must actually run")
    },
  )
}

pipeline test_readme_agent_executes_its_declared_tool(harness: Harness) {
  const root = path_normalize(path_join(harness.fs.cwd(), "../.."))
  const examples = extract_blocks(harness.fs.read_text(path_join(root, "README.md"))).filter(
    { event -> event.kind == "block" && event.mode == "check" },
  )
  assert_eq(
    examples.count,
    1,
    "execute the exact introductory example, without a second source copy",
  )
  const binary = resolve_harn_bin(harness)
  with_temp_dir(
    harness.fs,
    { dir ->
      const source = path_join(dir, "main.harn")
      const tape = path_join(dir, "responses.jsonl")
      const canary = "README_DOC_PROBE_CANARY"
      harness.fs.write_text(source, examples[0].content)
      harness.fs.write_text(
        path_join(dir, "README.md"),
        "# Task tracker\nA small task tracker. ${canary}\n",
      )
      harness.fs.write_text(
        tape,
        json_stringify(
          {
            tool_calls: [{name: "read_project_file", args: {path: "README.md"}}],
            model: "readme-fixture",
            provider: "demo",
          },
        )
          + "\n"
          + json_stringify(
            {
              match: "*${canary}*",
              consume_match: true,
              text: "README.md describes a small task tracker. [${canary}]\n##DONE##",
              model: "readme-fixture",
              provider: "demo",
            },
          )
          + "\n",
      )
      const outcome = harness.process.run(
        {
          program: binary,
          args: ["run", "--standalone", "--json", "--llm-mock", tape, source],
          cwd: dir,
          timeout_ms: 30000,
        },
      )
      assert(outcome.success, outcome.stdout + outcome.stderr)
      const events = outcome.stdout.lines().filter({ line -> line.trim() != "" }).map(
        { line -> json_parse(line) },
      )
      const results = events.filter(
        { event ->
          event?.data?.event_type == "transcript" && event?.data?.kind == "message"
            && event?.data?.payload?.message?._harn?.kind == "tool_result"
            && event?.data?.payload?.message?._harn?.tool_name == "read_project_file"
        },
      )
      assert_eq(results.count, 1, "the README tool must actually fire exactly once")
      const message = results[0].data.payload.message
      assert_eq(
        message._harn.outcome,
        "ok",
        "the declared tool must accept its arguments and finish",
      )
      assert(message.content.contains(canary), "the tool must read the fixture file")
      const output = events.filter({ event -> event?.data?.event_type == "stdout" }).map(
        { event -> event.data.payload },
      )
        .join("")
      assert(
        output.starts_with("done\n"),
        "the agent must finish, not merely exit the script: ${output}",
      )
      assert(output.contains("README.md describes a small task tracker."), output)
      const requests = events.filter({ event -> event?.data?.kind == "provider_call_request" })
      assert_eq(
        requests.count,
        2,
        "the fixture must reach both the tool request and grounded response",
      )
    },
  )
}

pipeline test_snippet_config_rejects_invalid_policy(harness: Harness) {
  const valid = {
    version: 1,
    include: ["*.md"],
    defaults: {validation: "parse", format: false, lint: "off", line_width: 74},
  }
  assert_eq(parse_snippet_config(valid).defaults.line_width, 74)
  assert_throws({ -> parse_snippet_config(valid + {typo: true}) })
  assert_throws({ -> parse_snippet_config(valid + {include: []}) })
  assert_throws({ -> parse_snippet_config(valid + {version: 2}) })
  assert_throws({ -> parse_snippet_config(valid + {defaults: valid.defaults + {format: "true"}}) })
  assert_throws({ -> parse_snippet_config(valid + {rules: [{include: ["*.md"], line_width: 0}]}) })
  assert_throws({ -> parse_snippet_config(valid + {rules: [{include: ["*.md"]}]}) })
  assert_throws({ -> parse_snippet_config(valid + {rules: [{include: ["*.md"], fomrat: true}]}) })
}

pipeline test_snippet_glob_rule_controls_real_validation(harness: Harness) {
  const root = path_normalize(path_join(harness.fs.cwd(), "../.."))
  const checker = path_join(root, "scripts/check_docs_snippets.harn")
  const binary = resolve_harn_bin(harness)
  with_temp_dir(
    harness.fs,
    { dir ->
      harness.fs.mkdir(path_join(dir, "guides"))
      harness.fs.write_text(path_join(dir, "README.md"), "```harn\nmissing_name()\n```\n")
      const guide = path_join(dir, "guides/start.md")
      harness.fs.write_text(guide, "```harn\npub fn answer()->int{return 42}\n```\n")
      const config = path_join(dir, "custom.toml")
      const policy =
        "version = 1\ninclude = [\"*.md\", \"guides/*.md\"]\n[defaults]\nvalidation = \"parse\"\nformat = false\nlint = \"off\"\nline_width = 74\n[[rules]]\ninclude = [\"guides/*.md\"]\nvalidation = \"check\"\nformat = true\nlint = \"strict\"\nline_width = 40\n"
      harness.fs.write_text(config, policy)
      const invocation = {
        program: binary,
        args: ["run", "--standalone", checker, "--", "--config", config],
        cwd: dir,
        env: {HARN_BIN: binary},
      }
      const unformatted = harness.process.run(invocation)
      assert(!unformatted.success, "a matched non-README file must receive its formatting rule")
      assert(
        unformatted.stdout.contains("guides/start.md block #1 (formatting)"),
        unformatted.stdout,
      )
      harness.fs.write_text(guide, "```harn\npub fn answer() -> int {\n  return 42\n}\n```\n")
      const accepted = harness.process.run(invocation)
      assert(accepted.success, accepted.stdout + accepted.stderr)
      assert(accepted.stdout.contains("2 checked"), accepted.stdout)
      assert(accepted.stdout.contains("1 formatting checked; 1 lint checked"), accepted.stdout)
      harness.fs.write_text(guide, "```harn\nmissing_name()\n```\n")
      const invalid = harness.process.run(invocation)
      assert(
        !invalid.success,
        "the guide's check rule must reject an unresolved name that parse accepts",
      )
      assert(
        (invalid.stdout + invalid.stderr).contains("missing_name"),
        invalid.stdout + invalid.stderr,
      )
      harness.fs.write_text(config, policy.replace("guides/*.md", "missing/*.md"))
      const unmatched = harness.process.run(invocation)
      assert(!unmatched.success, "a rule selecting no included files must not pass")
      assert(
        (unmatched.stdout + unmatched.stderr).contains("selected file(s)"),
        unmatched.stdout + unmatched.stderr,
      )
      harness.fs.write_text(config, policy)
      harness.fs.write_text(guide, "# No code\n")
      harness.fs.write_text(path_join(dir, "README.md"), "# No code\n")
      const empty = harness.process.run(invocation)
      assert(!empty.success, "documents without checked snippets are not a passing run")
      assert(
        (empty.stdout + empty.stderr).contains("validated snippet(s)"),
        empty.stdout + empty.stderr,
      )
    },
  )
}

// --- extract_blocks ---------------------------------------------------------
@test
pipeline test_extract_basic_block(harness: Harness, task: unknown) {
  const md = "intro\n```harn\nlet x = 1\nlog(x)\n```\noutro\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].idx, 1)
  assert_eq(events[0].mode, "parse")
  assert_eq(events[0].content, "let x = 1\nlog(x)\n")
}

@test
pipeline test_extract_ignore_block_skipped(harness: Harness, task: unknown) {
  const md = "```harn,ignore\npartial fragment\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "skip")
  assert_eq(events[0].idx, 1)
}

@test
pipeline test_extract_idx_counts_all_harn_fences(harness: Harness, task: unknown) {
  // The block index counts harn fences (checked AND ignored), matching the
  // awk `idx++` on both fence kinds.
  const md = "```harn,ignore\na\n```\n\n```harn\nb\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 2)
  assert_eq(events[0].kind, "skip")
  assert_eq(events[1].kind, "block")
  assert_eq(events[1].idx, 2)
  assert_eq(events[1].mode, "parse")
}

@test
pipeline test_extract_check_block_opts_into_full_check(harness: Harness, task: unknown) {
  const md = "```harn,check\npipeline default() { return 1 }\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].idx, 1)
  assert_eq(events[0].mode, "check")
  assert_eq(events[0].content, "pipeline default() { return 1 }\n")
}

@test
pipeline test_extract_other_fences_ignored(harness: Harness, task: unknown) {
  const md = "```bash\necho hi\n```\n```harn\nx\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].content, "x\n")
}

@test
pipeline test_extract_info_string_must_be_exact(harness: Harness, task: unknown) {
  // Unknown options cannot silently opt a Harn fence out of verification.
  assert_eq(extract_blocks("```harn foo\nx\n```\n")[0].kind, "invalid")
  assert_eq(extract_blocks("```harn,chekc\nx\n```\n")[0].kind, "invalid")
  assert_eq(extract_blocks("```harn \nx\n```\n")[0].kind, "block")
}

@test
pipeline test_extract_unclosed_at_eof(harness: Harness, task: unknown) {
  const events = extract_blocks("pre\n```harn\nbody\n")
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "unclosed")
  assert_eq(events[0].open_line, 2)
}

@test
pipeline test_extract_reopened_fence_reports_previous(harness: Harness, task: unknown) {
  // A new ```harn fence while one is open reports the earlier open line
  // and starts a fresh block.
  const events = extract_blocks("```harn\na\n```harn\nb\n```\n")
  assert_eq(events.count, 2)
  assert_eq(events[0].kind, "unclosed")
  assert_eq(events[0].open_line, 1)
  assert_eq(events[1].kind, "block")
  assert_eq(events[1].idx, 2)
  assert_eq(events[1].mode, "parse")
  assert_eq(events[1].content, "b\n")
}

@test
pipeline test_extract_empty_input(harness: Harness, task: unknown) {
  assert_eq(extract_blocks(""), [])
}

@test
pipeline test_extract_indented_block_is_checked(harness: Harness, task: unknown) {
  // A fence nested under a list item is a real example and gets checked.
  // Before this was handled, such blocks were silently invisible to the
  // gate — a `harn parse` failure shipped in docs/src/diagnostics.md
  // behind exactly this shape.
  const md = "- bullet:\n\n  ```harn\n  const x = 1\n  ```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].mode, "parse")
  // The opening fence's indent is stripped, so the body parses at column 0.
  assert_eq(events[0].content, "const x = 1\n")
}

@test
pipeline test_extract_indented_block_keeps_relative_indent(harness: Harness, task: unknown) {
  // Only the fence's own indent is removed; nesting inside the snippet
  // survives, so the extracted source is byte-identical to the example.
  const md = "  ```harn\n  fn f() -> int {\n    return 1\n  }\n  ```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].content, "fn f() -> int {\n  return 1\n}\n")
}

@test
pipeline test_extract_indented_ignore_and_check_tags(harness: Harness, task: unknown) {
  assert_eq(extract_blocks("  ```harn,ignore\n  frag\n  ```\n")[0].kind, "skip")
  assert_eq(extract_blocks("  ```harn,check\n  x\n  ```\n")[0].mode, "check")
}

@test
pipeline test_extract_indented_blank_line_in_body(harness: Harness, task: unknown) {
  // A blank line carries no indent to strip and must not underflow.
  const events = extract_blocks("  ```harn\n  const a = 1\n\n  const b = 2\n  ```\n")
  assert_eq(events[0].content, "const a = 1\n\nconst b = 2\n")
}

// --- harn-prompt fences -----------------------------------------------------
@test
pipeline test_extract_prompt_block(harness: Harness, task: unknown) {
  const md = "```harn-prompt\n{{ if x }}a{{ end }}\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].mode, "prompt")
  assert_eq(events[0].content, "{{ if x }}a{{ end }}\n")
}

@test
pipeline test_extract_prompt_ignore_block_skipped(harness: Harness, task: unknown) {
  const events = extract_blocks("```harn-prompt,ignore\n{{ fragment\n```\n")
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "skip")
}

@test
pipeline test_extract_prompt_and_harn_share_one_index(harness: Harness, task: unknown) {
  // Temp-file names are keyed on idx, so both languages advance the same
  // counter and cannot collide within a file.
  const events = extract_blocks("```harn\nx\n```\n\n```harn-prompt\n{{ y }}\n```\n")
  assert_eq(events.count, 2)
  assert_eq(events[0].mode, "parse")
  assert_eq(events[0].idx, 1)
  assert_eq(events[1].mode, "prompt")
  assert_eq(events[1].idx, 2)
}

@test
pipeline test_extract_prompt_info_string_must_be_exact(harness: Harness, task: unknown) {
  assert_eq(extract_blocks("```harn-prompt extra\nx\n```\n")[0].kind, "invalid")
  assert_eq(extract_blocks("```text\n{{ x }}\n```\n"), [])
}

pipeline test_extract_does_not_check_markdown_inside_a_foreign_fence(harness: Harness) {
  const source =
    "````markdown\n```harn,not-an-example\ntext\n```\n````\n```harn\nconst x = 1\n```\n"
  const events = extract_blocks(source)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].content, "const x = 1\n")
}

pipeline test_extract_backticks_in_prose_do_not_open_a_foreign_fence(harness: Harness) {
  const source =
    "  - Read ```harn /\n    ``` fenced blocks with `extract_fenced: true`.\n\n```harn\nconst x = 1\n```\n"
  const events = extract_blocks(source)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].content, "const x = 1\n")
}

// --- longer fences ----------------------------------------------------------
@test
pipeline test_extract_longer_fence_keeps_inner_backticks(harness: Harness, task: unknown) {
  // A template that shows fenced output is itself fenced with four
  // backticks; the inner ``` lines are body, not the close.
  const md = "````harn-prompt\n{{ for s in xs }}\n```\n{{ s }}\n```\n{{ end }}\n````\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].mode, "prompt")
  assert_eq(events[0].content, "{{ for s in xs }}\n```\n{{ s }}\n```\n{{ end }}\n")
}

@test
pipeline test_extract_three_tick_block_still_closes_on_longer_fence(
  harness: Harness,
  task: unknown,
) {
  // A ``` block closes on any fence at least as long, preserving the
  // behaviour that predates variable-length fences.
  const events = extract_blocks("```harn\nx\n````\n")
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].content, "x\n")
}

// --- fence + mode tables ----------------------------------------------------
@test
pipeline test_backtick_run_len(harness: Harness, task: unknown) {
  assert_eq(backtick_run_len("```harn"), 3)
  assert_eq(backtick_run_len("````"), 4)
  assert_eq(backtick_run_len("no ticks"), 0)
  assert_eq(backtick_run_len(""), 0)
}

@test
pipeline test_fence_mode_and_ownership(harness: Harness, task: unknown) {
  assert_eq(fence_mode("harn"), "parse")
  assert_eq(fence_mode("harn,check"), "check")
  assert_eq(fence_mode("harn,diagnostic-check"), "diagnostic-check")
  assert_eq(fence_mode("harn,diagnostic-lint"), "diagnostic-lint")
  assert_eq(fence_mode("harn-prompt"), "prompt")
  assert_eq(fence_mode("text"), "")
  assert_eq(fence_mode("harn,ignore"), "")
  assert_eq(fence_is_ignored("harn,ignore"), true)
  assert_eq(fence_is_ignored("harn-prompt,ignore"), true)
  assert_eq(fence_is_ignored("harn"), false)
  assert_eq(fence_is_owned("harn-prompt,ignore"), true)
  assert_eq(fence_is_owned("bash"), false)
}

// The site renders `title="..."` as a filename header. A titled fence must stay
// inside this gate: before fence_strip_title, the longer info string missed the
// exact matches and the block was checked by nobody.
@test
pipeline test_fence_title_does_not_escape_the_gate(harness: Harness, task: unknown) {
  assert_eq(fence_mode("harn title=\"example.harn\""), "parse")
  assert_eq(fence_mode("harn,check title=\"example.harn\""), "check")
  assert_eq(fence_mode("harn-prompt title=\"review.harn.prompt\""), "prompt")
  assert_eq(fence_is_ignored("harn,ignore title=\"broken.harn\""), true)
  assert_eq(fence_is_owned("harn,check title=\"a.harn\""), true)
  // A title on a fence this checker does not own stays unowned.
  assert_eq(fence_mode("bash title=\"run.sh\""), "")
  // Anything other than `title` still fails to match, so an unrecognized
  // variant is never silently validated.
  assert_eq(fence_mode("harn,check lines=\"1-3\""), "")
  assert_eq(fence_mode("harn,check title=unquoted.harn"), "")
  // Stripping is exact, and leaves a fence with no title untouched.
  assert_eq(fence_strip_title("harn,check"), "harn,check")
  assert_eq(fence_strip_title("harn title=\"a.harn\""), "harn")
  // An unterminated title is left alone rather than half-stripped.
  assert_eq(fence_strip_title("harn title=\"a.harn"), "harn title=\"a.harn")
}

@test
pipeline test_mode_extension_and_argv(harness: Harness, task: unknown) {
  // A prompt block must reach `harn lint` as a .harn.prompt file: the
  // extension is what routes it to the template parser rather than the
  // Harn parser.
  assert_eq(mode_extension("prompt"), ".harn.prompt")
  assert_eq(mode_extension("parse"), ".harn")
  assert_eq(mode_extension("check"), ".harn")
  assert_eq(mode_argv("prompt", "/t/b.harn.prompt"), ["lint", "/t/b.harn.prompt"])
  assert_eq(mode_argv("check", "/t/b.harn"), ["check", "/t/b.harn"])
  assert_eq(mode_argv("diagnostic-check", "/t/b.harn"), ["check", "--json", "/t/b.harn"])
  assert_eq(mode_argv("diagnostic-lint", "/t/b.harn"), ["lint", "--json", "/t/b.harn"])
  assert_eq(mode_argv("parse", "/t/b.harn"), ["parse", "--json", "/t/b.harn"])
  assert_eq(mode_label("prompt"), "harn-prompt")
  assert_eq(mode_label("parse"), "harn")
  assert_eq(mode_is_diagnostic("diagnostic-check"), true)
  assert_eq(mode_is_diagnostic("check"), false)
}

// --- generated diagnostic projection --------------------------------------
@test
pipeline test_decode_example_diagnostic_requires_one_bounded_finding(
  harness: Harness,
  task: unknown,
) {
  const source = "const value: string = 42\n"
  const envelope = json_stringify(
    {
      data: {
        files: [
          {
            diagnostics: [
              {
                source: "type",
                severity: "error",
                code: "HARN-TYP-007",
                message: "expected string, found int",
                span: {start: 22, end: 24},
                help: "did you mean `to_string(42)`?",
              },
            ],
          },
        ],
      },
    },
  )
  const decoded = decode_example_diagnostic(envelope, source)
  assert_eq(decoded.ok, true)
  assert_eq(decoded.diagnostic.code, "HARN-TYP-007")
  assert_eq(decoded.diagnostic.span, {start: 22, end: 24})
  const none = json_stringify({data: {files: [{diagnostics: []}]}})
  assert_eq(decode_example_diagnostic(none, source).ok, false)
  const outside = json_stringify(
    {
      data: {
        files: [
          {
            diagnostics: [
              {
                source: "type",
                severity: "error",
                code: "HARN-TYP-007",
                message: "bad span",
                span: {start: 1, end: 999},
              },
            ],
          },
        ],
      },
    },
  )
  assert_eq(decode_example_diagnostic(outside, source).ok, false)
  const unicode_source = "é\n"
  const unicode = json_stringify(
    {
      data: {
        files: [
          {
            diagnostics: [
              {
                source: "parser",
                severity: "error",
                code: "HARN-PAR-001",
                message: "unexpected token",
                span: {start: 0, end: 2},
              },
            ],
          },
        ],
      },
    },
  )
  assert_eq(decode_example_diagnostic(unicode, unicode_source).ok, true)
}

@test
pipeline test_decode_example_repairs_projects_registry_contract(harness: Harness, task: unknown) {
  const explanation = json_stringify(
    {
      repairs: [
        {
          id: "casts/insert-explicit-conversion",
          safety: "scope-local",
          summary: "Insert an explicit conversion",
        },
      ],
    },
  )
  const decoded = decode_example_repairs(explanation)
  assert_eq(decoded.ok, true)
  assert_eq(decoded.repairs[0].id, "casts/insert-explicit-conversion")
  assert_eq(decode_example_repairs(json_stringify({repairs: []})).ok, false)
}

// --- leading_ws_len / strip_indent ------------------------------------------
@test
pipeline test_leading_ws_len(harness: Harness, task: unknown) {
  assert_eq(leading_ws_len("no indent"), 0)
  assert_eq(leading_ws_len("  two"), 2)
  assert_eq(leading_ws_len("\ttab"), 1)
  assert_eq(leading_ws_len("   "), 3)
  assert_eq(leading_ws_len(""), 0)
}

@test
pipeline test_strip_indent(harness: Harness, task: unknown) {
  assert_eq(strip_indent("  body", 2), "body")
  assert_eq(strip_indent("    nested", 2), "  nested")
  // Never strips past the whitespace a line actually has.
  assert_eq(strip_indent("", 2), "")
  assert_eq(strip_indent("flush", 2), "flush")
}

// --- md_base_name -----------------------------------------------------------
@test
pipeline test_md_base_name(harness: Harness, task: unknown) {
  assert_eq(md_base_name("docs/src/dev/testing.md"), "testing")
  assert_eq(md_base_name("plain.md"), "plain")
  assert_eq(md_base_name("docs/src/noext"), "noext")
}

// --- indent_output ----------------------------------------------------------
@test
pipeline test_indent_output(harness: Harness, task: unknown) {
  assert_eq(indent_output("a\nb\n"), ["      | a", "      | b"])
  assert_eq(indent_output(""), [])
}

// --- rel_path ---------------------------------------------------------------
@test
pipeline test_rel_path(harness: Harness, task: unknown) {
  assert_eq(rel_path("/r/./docs/src/a.md"), "docs/src/a.md")
}

// --- duplicate_leading_args -------------------------------------------------
@test
pipeline test_duplicate_leading_args_flags_repeated_receiver(harness: Harness, task: unknown) {
  const snippet = "pipeline main(harness: Harness) {\n"
    + "  const r = agent_loop(harness,\n"
    + "    harness,\n"
    + "    \"Triage ticket #42.\",\n"
    + "  )\n"
    + "}\n"
  const found = duplicate_leading_args(snippet)
  assert_eq(found.count, 1)
  assert_eq(found[0].callee, "agent_loop")
  assert_eq(found[0].name, "harness")
  assert_eq(found[0].line, 2)
}

@test
pipeline test_duplicate_leading_args_flags_same_line_form(harness: Harness, task: unknown) {
  const found = duplicate_leading_args("agent_loop(harness, harness, \"go\", nil)\n")
  assert_eq(found.count, 1)
  assert_eq(found[0].callee, "agent_loop")
}

@test
pipeline test_duplicate_leading_args_allows_distinct_arguments(harness: Harness, task: unknown) {
  const snippet = "pipeline main(harness: Harness) {\n"
    + "  const r = agent_loop(harness,\n"
    + "    \"Triage ticket #42.\",\n"
    + "    \"You are a careful triage assistant.\",\n"
    + "  )\n"
    + "  const s = sub_agent_run(harness, task, opts)\n"
    + "}\n"
  assert_eq(duplicate_leading_args(snippet), [])
}

// --- overlong_lines ---------------------------------------------------------
@test
pipeline test_overlong_lines_boundary_is_exclusive(harness: Harness, task: unknown) {
  // A line exactly at the limit is fine; one column past it is not. The
  // off-by-one here is the whole contract, so pin both sides.
  const at_limit = "x".repeat(88)
  const over = "x".repeat(89)
  assert_eq(overlong_lines(at_limit + "\n", 88), [])
  const found = overlong_lines(over + "\n", 88)
  assert_eq(found.count, 1)
  assert_eq(found[0].line, 1)
  assert_eq(found[0].width, 89)
  assert_eq(found[0].text, over)
}

@test
pipeline test_overlong_lines_pins_the_repo_budget(harness: Harness, task: unknown) {
  // The published budget is 74 columns, derived from the rendered article
  // column (max-w-3xl minus padding and border = 654px of code text, at
  // JetBrains Mono 13.6px whose advance is 8.734px). A 74-column line must
  // pass and a 75-column line must fail; if the policy drifts without the
  // derivation being redone, this fails.
  const root = path_normalize(path_join(harness.fs.cwd(), "../.."))
  const config = parse_snippet_config(
    toml_parse(harness.fs.read_text(path_join(root, ".harn-docs.toml"))),
  )
  assert_eq(config.defaults.line_width, 74)
  assert_eq(overlong_lines("x".repeat(74) + "\n", config.defaults.line_width), [])
  const over = overlong_lines("x".repeat(75) + "\n", config.defaults.line_width)
  assert_eq(over.count, 1)
  assert_eq(over[0].width, 75)
}

@test
pipeline test_overlong_lines_ignores_trailing_whitespace(harness: Harness, task: unknown) {
  // Trailing blanks cost the reader nothing, so they must not trip the budget.
  assert_eq(overlong_lines("x".repeat(88) + "    \n", 88), [])
}

@test
pipeline test_overlong_lines_reports_every_offender(harness: Harness, task: unknown) {
  const md = "ok\n" + "y".repeat(90) + "\nfine\n" + "z".repeat(95) + "\n"
  const found = overlong_lines(md, 88)
  assert_eq(found.count, 2)
  assert_eq(found[0].line, 2)
  assert_eq(found[1].line, 4)
}

@test
pipeline test_ignored_block_still_carries_content(harness: Harness, task: unknown) {
  // An ```harn,ignore block is exempt from type checking, never from the
  // reading budget: it still renders, so extract_blocks must hand back its
  // body for the width pass.
  const md = "```harn,ignore\n" + "w".repeat(120) + "\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "skip")
  assert_eq(overlong_lines(events[0].content, 88).count, 1)
}
