// Tests for scripts/check_docs_snippets.harn — drive the pure fence
// state machine and formatting helpers on synthetic markdown.
import "../check_docs_snippets.harn"

// --- extract_blocks ---------------------------------------------------------
@test
pipeline test_extract_basic_block(task) {
  const md = "intro\n```harn\nlet x = 1\nlog(x)\n```\noutro\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].idx, 1)
  assert_eq(events[0].mode, "parse")
  assert_eq(events[0].content, "let x = 1\nlog(x)\n")
}

@test
pipeline test_extract_ignore_block_skipped(task) {
  const md = "```harn,ignore\npartial fragment\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "skip")
  assert_eq(events[0].idx, 1)
}

@test
pipeline test_extract_idx_counts_all_harn_fences(task) {
  // The block index counts harn fences (checked AND ignored), matching the
  // awk `idx++` on both fence kinds.
  const md = "```harn,ignore\na\n```\n\n```harn\nb\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 2)
  assert_eq(events[0].kind, "skip")
  assert_eq(events[1].kind, "block")
  assert_eq(events[1].idx, 2)
  assert_eq(events[1].mode, "parse")
}

@test
pipeline test_extract_check_block_opts_into_full_check(task) {
  const md = "```harn,check\npipeline default() { return 1 }\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].idx, 1)
  assert_eq(events[0].mode, "check")
  assert_eq(events[0].content, "pipeline default() { return 1 }\n")
}

@test
pipeline test_extract_other_fences_ignored(task) {
  const md = "```bash\necho hi\n```\n```harn\nx\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].content, "x\n")
}

@test
pipeline test_extract_info_string_must_be_exact(task) {
  // ```harn extra or trailing spaces do not open a checked block.
  assert_eq(extract_blocks("```harn foo\nx\n```\n"), [])
  assert_eq(extract_blocks("```harn \nx\n```\n"), [])
}

@test
pipeline test_extract_unclosed_at_eof(task) {
  const events = extract_blocks("pre\n```harn\nbody\n")
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "unclosed")
  assert_eq(events[0].open_line, 2)
}

@test
pipeline test_extract_reopened_fence_reports_previous(task) {
  // A new ```harn fence while one is open reports the earlier open line
  // and starts a fresh block.
  const events = extract_blocks("```harn\na\n```harn\nb\n```\n")
  assert_eq(events.count, 2)
  assert_eq(events[0].kind, "unclosed")
  assert_eq(events[0].open_line, 1)
  assert_eq(events[1].kind, "block")
  assert_eq(events[1].idx, 2)
  assert_eq(events[1].mode, "parse")
  assert_eq(events[1].content, "b\n")
}

@test
pipeline test_extract_empty_input(task) {
  assert_eq(extract_blocks(""), [])
}

@test
pipeline test_extract_indented_block_is_checked(task) {
  // A fence nested under a list item is a real example and gets checked.
  // Before this was handled, such blocks were silently invisible to the
  // gate — a `harn parse` failure shipped in docs/src/diagnostics.md
  // behind exactly this shape.
  const md = "- bullet:\n\n  ```harn\n  const x = 1\n  ```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].mode, "parse")
  // The opening fence's indent is stripped, so the body parses at column 0.
  assert_eq(events[0].content, "const x = 1\n")
}

@test
pipeline test_extract_indented_block_keeps_relative_indent(task) {
  // Only the fence's own indent is removed; nesting inside the snippet
  // survives, so the extracted source is byte-identical to the example.
  const md = "  ```harn\n  fn f() -> int {\n    return 1\n  }\n  ```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].content, "fn f() -> int {\n  return 1\n}\n")
}

@test
pipeline test_extract_indented_ignore_and_check_tags(task) {
  assert_eq(extract_blocks("  ```harn,ignore\n  frag\n  ```\n")[0].kind, "skip")
  assert_eq(extract_blocks("  ```harn,check\n  x\n  ```\n")[0].mode, "check")
}

@test
pipeline test_extract_indented_blank_line_in_body(task) {
  // A blank line carries no indent to strip and must not underflow.
  const events = extract_blocks("  ```harn\n  const a = 1\n\n  const b = 2\n  ```\n")
  assert_eq(events[0].content, "const a = 1\n\nconst b = 2\n")
}

// --- harn-prompt fences -----------------------------------------------------
@test
pipeline test_extract_prompt_block(task) {
  const md = "```harn-prompt\n{{ if x }}a{{ end }}\n```\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].mode, "prompt")
  assert_eq(events[0].content, "{{ if x }}a{{ end }}\n")
}

@test
pipeline test_extract_prompt_ignore_block_skipped(task) {
  const events = extract_blocks("```harn-prompt,ignore\n{{ fragment\n```\n")
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "skip")
}

@test
pipeline test_extract_prompt_and_harn_share_one_index(task) {
  // Temp-file names are keyed on idx, so both languages advance the same
  // counter and cannot collide within a file.
  const events = extract_blocks("```harn\nx\n```\n\n```harn-prompt\n{{ y }}\n```\n")
  assert_eq(events.count, 2)
  assert_eq(events[0].mode, "parse")
  assert_eq(events[0].idx, 1)
  assert_eq(events[1].mode, "prompt")
  assert_eq(events[1].idx, 2)
}

@test
pipeline test_extract_prompt_info_string_must_be_exact(task) {
  assert_eq(extract_blocks("```harn-prompt extra\nx\n```\n"), [])
  assert_eq(extract_blocks("```text\n{{ x }}\n```\n"), [])
}

// --- longer fences ----------------------------------------------------------
@test
pipeline test_extract_longer_fence_keeps_inner_backticks(task) {
  // A template that shows fenced output is itself fenced with four
  // backticks; the inner ``` lines are body, not the close.
  const md = "````harn-prompt\n{{ for s in xs }}\n```\n{{ s }}\n```\n{{ end }}\n````\n"
  const events = extract_blocks(md)
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].mode, "prompt")
  assert_eq(events[0].content, "{{ for s in xs }}\n```\n{{ s }}\n```\n{{ end }}\n")
}

@test
pipeline test_extract_three_tick_block_still_closes_on_longer_fence(task) {
  // A ``` block closes on any fence at least as long, preserving the
  // behaviour that predates variable-length fences.
  const events = extract_blocks("```harn\nx\n````\n")
  assert_eq(events.count, 1)
  assert_eq(events[0].kind, "block")
  assert_eq(events[0].content, "x\n")
}

// --- fence + mode tables ----------------------------------------------------
@test
pipeline test_backtick_run_len(task) {
  assert_eq(backtick_run_len("```harn"), 3)
  assert_eq(backtick_run_len("````"), 4)
  assert_eq(backtick_run_len("no ticks"), 0)
  assert_eq(backtick_run_len(""), 0)
}

@test
pipeline test_fence_mode_and_ownership(task) {
  assert_eq(fence_mode("harn"), "parse")
  assert_eq(fence_mode("harn,check"), "check")
  assert_eq(fence_mode("harn-prompt"), "prompt")
  assert_eq(fence_mode("text"), "")
  assert_eq(fence_mode("harn,ignore"), "")
  assert_eq(fence_is_ignored("harn,ignore"), true)
  assert_eq(fence_is_ignored("harn-prompt,ignore"), true)
  assert_eq(fence_is_ignored("harn"), false)
  assert_eq(fence_is_owned("harn-prompt,ignore"), true)
  assert_eq(fence_is_owned("bash"), false)
}

@test
pipeline test_mode_extension_and_argv(task) {
  // A prompt block must reach `harn lint` as a .harn.prompt file: the
  // extension is what routes it to the template parser rather than the
  // Harn parser.
  assert_eq(mode_extension("prompt"), ".harn.prompt")
  assert_eq(mode_extension("parse"), ".harn")
  assert_eq(mode_extension("check"), ".harn")
  assert_eq(mode_argv("prompt", "/t/b.harn.prompt"), ["lint", "/t/b.harn.prompt"])
  assert_eq(mode_argv("check", "/t/b.harn"), ["check", "/t/b.harn"])
  assert_eq(mode_argv("parse", "/t/b.harn"), ["parse", "--json", "/t/b.harn"])
  assert_eq(mode_label("prompt"), "harn-prompt")
  assert_eq(mode_label("parse"), "harn")
}

// --- leading_ws_len / strip_indent ------------------------------------------
@test
pipeline test_leading_ws_len(task) {
  assert_eq(leading_ws_len("no indent"), 0)
  assert_eq(leading_ws_len("  two"), 2)
  assert_eq(leading_ws_len("\ttab"), 1)
  assert_eq(leading_ws_len("   "), 3)
  assert_eq(leading_ws_len(""), 0)
}

@test
pipeline test_strip_indent(task) {
  assert_eq(strip_indent("  body", 2), "body")
  assert_eq(strip_indent("    nested", 2), "  nested")
  // Never strips past the whitespace a line actually has.
  assert_eq(strip_indent("", 2), "")
  assert_eq(strip_indent("flush", 2), "flush")
}

// --- md_base_name -----------------------------------------------------------
@test
pipeline test_md_base_name(task) {
  assert_eq(md_base_name("docs/src/dev/testing.md"), "testing")
  assert_eq(md_base_name("plain.md"), "plain")
  assert_eq(md_base_name("docs/src/noext"), "noext")
}

// --- indent_output ----------------------------------------------------------
@test
pipeline test_indent_output(task) {
  assert_eq(indent_output("a\nb\n"), ["      | a", "      | b"])
  assert_eq(indent_output(""), [])
}

// --- rel_path ---------------------------------------------------------------
@test
pipeline test_rel_path(task) {
  assert_eq(rel_path("/r/./docs/src/a.md"), "docs/src/a.md")
}
