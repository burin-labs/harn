import {
  build_latency_report,
  build_report,
  detailed_job_observation_from_api,
  duration_stats,
  evaluate_ci_latency,
  group_job_samples,
  job_samples_from_api,
  latency_report_exit_code,
  parse_ci_latency_policy,
  run_has_full_coverage,
  run_samples_from_api,
} from "../ci_walltime_report.harn"

pipeline test_duration_stats_use_shared_percentile_contract(harness: Harness, task: unknown) {
  assert_eq(
    duration_stats([10000, 20000, 30000, 40000, 50000, 60000, 70000, 80000, 90000, 100000]),
    {count: 10, mean_ms: 55000, p50_ms: 55000, p90_ms: 91000, max_ms: 100000},
  )
  assert_eq(duration_stats([]), {count: 0, mean_ms: 0, p50_ms: 0, p90_ms: 0, max_ms: 0})
}

pipeline test_run_boundary_normalizes_once_and_rejects_invalid_intervals(
  harness: Harness,
  task: unknown,
) {
  const samples = run_samples_from_api(
    {
      workflow_runs: [
        {
          id: 12,
          created_at: "2026-07-18T00:00:00Z",
          updated_at: "2026-07-18T00:12:30Z",
          html_url: "https://example.test/run/12",
        },
        {id: 13, created_at: "2026-07-18T00:01:00Z", updated_at: "2026-07-18T00:00:00Z"},
        {id: 14, created_at: "bad", updated_at: "also-bad"},
      ],
    },
  )
  assert_eq(samples, [{id: 12, duration_ms: 750000, url: "https://example.test/run/12"}])
}

pipeline test_job_groups_are_typed_and_ordered_by_p90(harness: Harness, task: unknown) {
  const first = job_samples_from_api(
    12,
    {
      jobs: [
        {
          name: "Rust test",
          started_at: "2026-07-18T00:00:00Z",
          completed_at: "2026-07-18T00:10:00Z",
        },
        {
          name: "Audit scripts",
          started_at: "2026-07-18T00:00:00Z",
          completed_at: "2026-07-18T00:04:00Z",
        },
        {name: "", started_at: "2026-07-18T00:00:00Z", completed_at: "2026-07-18T00:01:00Z"},
      ],
    },
  )
  const second = job_samples_from_api(
    13,
    {
      jobs: [
        {
          name: "Rust test",
          started_at: "2026-07-18T01:00:00Z",
          completed_at: "2026-07-18T01:12:00Z",
        },
        {
          name: "Audit scripts",
          started_at: "2026-07-18T01:00:00Z",
          completed_at: "2026-07-18T01:05:00Z",
        },
      ],
    },
  )
  assert_eq(
    group_job_samples(first + second),
    [
      {
        name: "Rust test",
        stats: {count: 2, mean_ms: 660000, p50_ms: 660000, p90_ms: 708000, max_ms: 720000},
      },
      {
        name: "Audit scripts",
        stats: {count: 2, mean_ms: 270000, p50_ms: 270000, p90_ms: 294000, max_ms: 300000},
      },
    ],
  )
}

pipeline test_report_keeps_source_runs_and_job_summary(harness: Harness, task: unknown) {
  const runs = [{id: 1, duration_ms: 720000, url: "https://example.test/run/1"}]
  const jobs = [{run_id: 1, name: "Rust test", duration_ms: 600000}]
  assert_eq(
    build_report("burin-labs/harn", "ci.yml", "merge_group", runs, jobs),
    {
      schema_version: 1,
      repository: "burin-labs/harn",
      workflow: "ci.yml",
      event: "merge_group",
      runs: runs,
      wall: {count: 1, mean_ms: 720000, p50_ms: 720000, p90_ms: 720000, max_ms: 720000},
      jobs: [
        {
          name: "Rust test",
          stats: {count: 1, mean_ms: 600000, p50_ms: 600000, p90_ms: 600000, max_ms: 600000},
        },
      ],
    },
  )
}

@test
pipeline test_policy_rejects_ambiguous_or_inverted_contracts(harness: Harness, task: unknown) {
  const valid = json_stringify(
    {
      schema_version: 1,
      repository: "burin-labs/harn",
      workflow: "ci.yml",
      event: "merge_group",
      topology_epoch: "2026-08-01T00:00:00Z",
      full_run_jobs: [{name: "Rust workspace tests", match: "exact"}],
      slo: {
        warning_ms: 540000,
        p90_ms: 600000,
        hard_max_ms: 900000,
        min_samples: 5,
        window_samples: 5,
      },
    },
  )
  assert_eq(parse_ci_latency_policy(valid).slo.p90_ms, 600000)
  const raw = parse_ci_latency_policy(valid)
  const inverted = json_stringify({...raw, slo: {...raw.slo, warning_ms: 610000}})
  const result = try {
    parse_ci_latency_policy(inverted)
  }
  assert(is_err(result))
}

@test
pipeline test_full_run_requires_every_successful_sentinel(harness: Harness, task: unknown) {
  const jobs = [
    {
      run_id: 7,
      name: "Rust workspace tests",
      conclusion: "success",
      duration_ms: 100,
      dependency_wait_ms: 4,
      runner_queue_ms: 6,
      completion_offset_ms: 110,
      runner: "runner-a",
      steps: [],
    },
    {
      run_id: 7,
      name: "Run Harn conformance tests (1/2)",
      conclusion: "success",
      duration_ms: 100,
      dependency_wait_ms: 4,
      runner_queue_ms: 6,
      completion_offset_ms: 110,
      runner: "runner-b",
      steps: [],
    },
  ]
  assert(
    run_has_full_coverage(
      7,
      jobs,
      [
        {name: "Rust workspace tests", match: "exact"},
        {name: "Run Harn conformance tests", match: "prefix"},
      ],
    ),
  )
  assert(
    !run_has_full_coverage(
      7,
      jobs,
      [
        {name: "Rust workspace tests", match: "exact"},
        {name: "Run Linux sandbox tests", match: "exact"},
      ],
    ),
  )
}

@test
pipeline test_job_observation_splits_wait_queue_and_execution_and_preserves_rejections(
  harness: Harness,
  task: unknown,
) {
  const observed = detailed_job_observation_from_api(
    7,
    "2026-08-01T00:00:00Z",
    {
      jobs: [
        {
          name: "Native app macOS build & tests",
          conclusion: "success",
          created_at: "2026-08-01T00:03:00Z",
          started_at: "2026-08-01T00:03:30Z",
          completed_at: "2026-08-01T00:13:30Z",
          runner_name: "GitHub Actions 42",
          labels: ["macos-latest"],
          steps: [],
        },
        {
          name: "Missing queue boundary",
          conclusion: "success",
          started_at: "2026-08-01T00:01:00Z",
          completed_at: "2026-08-01T00:02:00Z",
          steps: [],
        },
        {
          name: "Inverted queue boundary",
          conclusion: "success",
          created_at: "2026-08-01T00:02:00Z",
          started_at: "2026-08-01T00:01:00Z",
          completed_at: "2026-08-01T00:03:00Z",
          steps: [],
        },
        {
          name: "Intentional platform skip",
          conclusion: "skipped",
          created_at: "2026-08-01T00:02:00Z",
          started_at: nil,
          completed_at: nil,
          steps: [],
        },
      ],
    },
  )
  assert_eq(observed.observed, 4)
  assert_eq(observed.samples.count, 1)
  assert_eq(
    observed.samples[0],
    {
      run_id: 7,
      name: "Native app macOS build & tests",
      conclusion: "success",
      duration_ms: 600000,
      dependency_wait_ms: 180000,
      runner_queue_ms: 30000,
      completion_offset_ms: 810000,
      runner: "github-hosted",
      steps: [],
    },
  )
  assert_eq(
    observed.excluded,
    [
      {
        run_id: 7,
        name: "Intentional platform skip",
        conclusion: "skipped",
        reason: "not_executed_successfully",
      },
    ],
  )
  assert_eq(
    observed.rejected,
    [
      {run_id: 7, name: "Missing queue boundary", reason: "invalid_run_to_job_created_interval"},
      {
        run_id: 7,
        name: "Inverted queue boundary",
        reason: "invalid_job_created_to_started_interval",
      },
    ],
  )
}

@test
pipeline test_report_attributes_each_wall_clock_to_the_terminal_job_and_tail(
  harness: Harness,
  task: unknown,
) {
  const policy = parse_ci_latency_policy(
    json_stringify(
      {
        schema_version: 1,
        repository: "example-org/downstream-host",
        workflow: "ci.yml",
        event: "push",
        topology_epoch: "2026-08-01T00:00:00Z",
        full_run_jobs: [{name: "CI status", match: "exact"}],
        slo: {
          warning_ms: 540000,
          p90_ms: 600000,
          hard_max_ms: 1200000,
          min_samples: 1,
          window_samples: 1,
        },
      },
    ),
  )
  const run = {
    id: 7,
    duration_ms: 900000,
    url: "https://example.test/run/7",
    created_at: "2026-08-01T00:00:00Z",
  }
  const common = {run_id: 7, conclusion: "success", runner: "github-hosted", steps: []}
  const observation = {
    observed: 4,
    samples: [
      {
        ...common,
        name: "Native app macOS build & tests",
        duration_ms: 600000,
        dependency_wait_ms: 120000,
        runner_queue_ms: 30000,
        completion_offset_ms: 750000,
      },
      {
        ...common,
        name: "CI status",
        duration_ms: 10000,
        dependency_wait_ms: 760000,
        runner_queue_ms: 5000,
        completion_offset_ms: 775000,
      },
      {
        ...common,
        name: "Independent job completed after terminal queue",
        duration_ms: 20000,
        dependency_wait_ms: 740000,
        runner_queue_ms: 10000,
        completion_offset_ms: 770000,
      },
    ],
    excluded: [],
    rejected: [{run_id: 7, name: "Unknown", reason: "invalid_job_execution_interval"}],
  }
  const report = build_latency_report(policy, [run], observation)
  assert_eq(report.schema_version, 3)
  assert_eq(report.jobs_observed, 4)
  assert_eq(report.jobs_measured, 3)
  assert_eq(report.jobs_excluded, 0)
  assert(!report.measurement_complete)
  assert_eq(latency_report_exit_code(report, true), 1)
  assert_eq(latency_report_exit_code(report, false), 0)
  const complete_report = build_latency_report(
    policy,
    [run],
    {
      observed: observation.observed,
      samples: observation.samples,
      excluded: observation.excluded,
      rejected: [],
    },
  )
  assert_eq(latency_report_exit_code(complete_report, true), 0)
  assert_eq(report.rejected_jobs.count, 1)
  assert_eq(
    report.critical_paths,
    [
      {
        run_id: 7,
        run_url: "https://example.test/run/7",
        wall_ms: 900000,
        terminal_job: "CI status",
        runner: "github-hosted",
        dependency_wait_ms: 760000,
        runner_queue_ms: 5000,
        execution_ms: 10000,
        completion_offset_ms: 775000,
        tail_ms: 125000,
        last_completed_before_queue: "Native app macOS build & tests",
        last_completed_runner: "github-hosted",
        last_completion_offset_ms: 750000,
      },
    ],
  )
}

@test
pipeline test_evaluation_needs_two_breached_windows_but_hard_max_is_immediate(
  harness: Harness,
  task: unknown,
) {
  const slo = {
    warning_ms: 540000,
    p90_ms: 600000,
    hard_max_ms: 900000,
    min_samples: 5,
    window_samples: 5,
  }
  const one_slow_window = [
    610000,
    620000,
    630000,
    640000,
    650000,
    500000,
    500000,
    500000,
    500000,
    500000,
  ]
    .enumerate()
    .map(
      { item ->
        {
          id: item.index,
          duration_ms: item.value,
          url: "https://example.test/${item.index}",
          created_at: "2026-08-01T00:00:00Z",
        }
      },
    )
    .to_list()
  const first = evaluate_ci_latency(one_slow_window, slo)
  assert_eq(first.status, "single_window_p90_breach")
  assert(first.ok)
  const sustained = evaluate_ci_latency(
    one_slow_window.map({ run -> {...run, duration_ms: max(run.duration_ms, 610000)} }).to_list(),
    slo,
  )
  assert_eq(sustained.status, "sustained_p90_breach")
  assert(!sustained.ok)
  const hard = evaluate_ci_latency(
    one_slow_window.map(
      { run ->
        if run.id == 0 {
          return {...run, duration_ms: 900000}
        }
        return run
      },
    )
      .to_list(),
    slo,
  )
  assert_eq(hard.status, "hard_max_breach")
  assert(!hard.ok)
}
