import { with_temp_dir } from "std/testing"
import "../check_protocol_bindings.harn"

fn mkdirs(fs: HarnessFs, path: string) -> nil {
  const parts = split(path_normalize(path), "/")
  let current = if path.starts_with("/") {
    "/"
  } else {
    ""
  }
  for part in parts {
    if part == "" {
      continue
    }
    current = if current == "" || current == "/" {
      current + part
    } else {
      path_join(current, part)
    }
    if !fs.exists(current) {
      fs.mkdir(current)
    }
  }
  return nil
}

fn write_text(fs: HarnessFs, root: string, rel: string, text: string) -> nil {
  const path = path_join(root, rel)
  mkdirs(fs, dirname(path) ?? root)
  fs.write_text(path, text)
  return nil
}

fn write_fixture_artifacts(
  fs: HarnessFs,
  root: string,
  binding_version: string,
  fixture_version: string,
) -> nil {
  const artifacts = path_join(fs.source_dir(), "../../spec/protocol-artifacts")
  const fixture = json_parse(fs.read_text(path_join(artifacts, "fixtures/round_trip.json")))
  const binding = fs.read_text(path_join(artifacts, "python/harn_protocol.py"))
  write_text(
    fs,
    root,
    "spec/protocol-artifacts/python/harn_protocol.py",
    binding.replace(fixture.artifactVersion, binding_version),
  )
  write_text(
    fs,
    root,
    "spec/protocol-artifacts/fixtures/round_trip.json",
    json_stringify_pretty(fixture + {artifactVersion: fixture_version}) + "\n",
  )
  return nil
}

@test
pipeline test_probe_args_pass_artifact_root_to_python(harness: Harness, task: unknown) {
  const args = python_binding_probe_args("/tmp/artifacts")
  assert_eq(args[0], "-c")
  assert(args[1]?.contains("python bindings: OK"))
  assert(args[1]?.contains("unknown recap snapshot field was accepted before write-back"))
  assert(args[1]?.contains("HarnSessionRecapSnapshot"))
  assert(args[1]?.contains("recap verification status did not hydrate into its closed enum"))
  assert_eq(args[2], "/tmp/artifacts")
}

@test
pipeline test_supplied_artifact_root_round_trip_passes(harness: Harness, task: unknown) {
  with_temp_dir(
    harness.fs,
    { root ->
      write_fixture_artifacts(harness.fs, root, "test-version", "test-version")
      const report = check_python_protocol_bindings(harness.fs, harness.process, "python3", root)
      assert_eq(report.ok, true)
      assert_eq(report.stage, "ok")
      assert(to_string(report.stdout).contains("python bindings: OK"))
    },
  )
}

@test
pipeline test_version_drift_is_reported_as_round_trip_failure(harness: Harness, task: unknown) {
  with_temp_dir(
    harness.fs,
    { root ->
      write_fixture_artifacts(harness.fs, root, "binding-version", "fixture-version")
      const report = check_python_protocol_bindings(harness.fs, harness.process, "python3", root)
      assert_eq(report.ok, false)
      assert_eq(report.stage, "round_trip")
      assert(to_string(report.stderr).contains("version drift"))
    },
  )
}

@test
pipeline test_current_repo_python_binding_round_trips(harness: Harness, task: unknown) {
  const report = check_python_protocol_bindings(harness.fs, harness.process)
  assert_eq(report.ok, true)
  assert_eq(report.stage, "ok")
}
