import { help_requested, parse, parser } from "std/cli/argparse"

/**
 * The token a row carries where a field has no value.
 *
 * A row is read back with `IFS=$'\t' read -r ...`, and tab is IFS whitespace,
 * so the shell collapses a run of tabs into one separator. An empty field in
 * the middle of a row therefore does not arrive empty: it disappears, and
 * every later field shifts one position left, silently. The reader still
 * succeeds, which is what makes it dangerous — the damage surfaces far away
 * as a wrong value, not as a parse error.
 */
const ROW_FIELD_ABSENT = "none"

type PublishablePackage = {dir: string, manifest_path: string, name: string, version: string}

type PackageDependencyContract = {
  dependency: string,
  minimum: string,
  package: string,
  package_version: string,
  requirement: string,
  resolution_name: string,
}

fn rel_path(path: string, root: string) -> string {
  const normalized = replace(path_normalize(path), "\\", "/")
  const normalized_root = replace(path_normalize(root), "\\", "/")
  const prefix = normalized_root + "/"
  if normalized == normalized_root {
    return "."
  }
  if normalized.starts_with(prefix) {
    return normalized[len(prefix):]
  }
  return normalized
}

fn workspace_member_ids(meta: dict) -> list<string> {
  return (meta?.workspace_members ?? []).map({ id -> to_string(id) }).to_list()
}

fn require_string(value: string?, field: string) -> string {
  const out = to_string(value ?? "")
  if out == "" {
    throw "cargo metadata is missing " + field
  }
  return out
}

pub fn target_directory_from_metadata(meta: dict) -> string {
  return require_string(meta?.target_directory, "target_directory")
}

pub fn publishable_workspace_packages_from_metadata(
  meta: dict,
  root: string,
) -> list<PublishablePackage> {
  const members = workspace_member_ids(meta)
  let packages: list<PublishablePackage> = []
  let seen: list<string> = []
  for package in meta?.packages ?? [] {
    const id = to_string(package?.id ?? "")
    if !members.contains(id) {
      continue
    }
    if package?.publish == [] {
      continue
    }
    const name = require_string(package?.name, "packages[].name")
    if seen.contains(name) {
      throw "cargo metadata contains duplicate workspace package name: " + name
    }
    seen = seen + [name]
    const version = require_string(package?.version, "packages[].version")
    const manifest_path = require_string(package?.manifest_path, "packages[].manifest_path")
    packages = packages
      + [
        {
          dir: rel_path(dirname(manifest_path) ?? ".", root),
          manifest_path: manifest_path,
          name: name,
          version: version,
        },
      ]
  }
  return packages.sorted_by({ package -> package.name })
}

/**
 * Return the API-sensitive dependencies that packaged-crate verification must
 * exercise at both their declared minimum and Cargo's resolver-latest choice.
 * Cargo.toml remains the requirement owner; package metadata only opts a
 * dependency into the stronger compatibility proof and names the minimum to
 * force through Cargo's resolver.
 */
pub fn package_dependency_contracts_from_metadata(meta: dict) -> list<PackageDependencyContract> {
  const members = workspace_member_ids(meta)
  let contracts: list<PackageDependencyContract> = []
  for package in meta?.packages ?? [] {
    const id = to_string(package?.id ?? "")
    if !members.contains(id) || package?.publish == [] {
      continue
    }
    const package_name = require_string(package?.name, "packages[].name")
    const package_version = require_string(package?.version, "packages[].version")
    let seen: list<string> = []
    for declared in package?.metadata?.harn?.package_verify?.dependency_contracts ?? [] {
      const dependency = require_string(declared?.name, package_name + " dependency contract name")
      // A contract may declare no minimum. That is the shape a ceiling takes:
      // the constraint names the first version that breaks rather than the
      // oldest that works, so there is no floor to pin. Pinning one anyway is
      // a treadmill — sibling crates in the same published SDK raise their own
      // floors on their own schedule, and the pin conflicts with whichever one
      // moved last. Such a contract still emits its resolver-latest receipt;
      // it just has no declared-minimum build to prove.
      const declared_minimum = to_string(declared?.minimum ?? "")
      const minimum = if declared_minimum == "" {
        ROW_FIELD_ABSENT
      } else {
        declared_minimum
      }
      if seen.contains(dependency) {
        throw package_name + " contains duplicate dependency contract: " + dependency
      }
      seen = seen + [dependency]
      const normal_dependencies = (package?.dependencies ?? []).filter(
        { candidate -> to_string(candidate?.name ?? "") == dependency && candidate?.kind == nil },
      )
      if len(normal_dependencies) != 1 {
        throw package_name + " dependency contract " + dependency
          + " must name exactly one normal dependency"
      }
      const requirement = require_string(
        normal_dependencies[0]?.req,
        package_name + " normal dependency " + dependency + " requirement",
      )
      const resolution_name = to_string(normal_dependencies[0]?.rename ?? dependency)
      contracts = contracts
        + [
          {
            dependency: dependency,
            minimum: minimum,
            package: package_name,
            package_version: package_version,
            requirement: requirement,
            resolution_name: resolution_name,
          },
        ]
    }
  }
  return contracts.sorted_by({ contract -> contract.package + "\t" + contract.dependency })
}

fn ensure_no_tabs(value: string, field: string) -> nil {
  if value.contains("\t") || value.contains("\n") {
    throw field + " contains a tab or newline, cannot render shell row safely"
  }
  // Refuse the empty field structurally rather than trusting each call site
  // to remember the collapse above. Absent is spelled `none`, never "".
  if value == "" {
    throw field + " is empty; a row field must be non-empty, use " + ROW_FIELD_ABSENT
  }
  return nil
}

pub fn verify_crate_packages_plan_rows(meta: dict, root: string) -> list<string> {
  const target_dir = target_directory_from_metadata(meta)
  ensure_no_tabs(target_dir, "target_directory")
  let rows = ["target_directory\t" + target_dir]
  for package in publishable_workspace_packages_from_metadata(meta, root) {
    ensure_no_tabs(package.name, "package name")
    ensure_no_tabs(package.version, "package version")
    ensure_no_tabs(package.manifest_path, "manifest path")
    ensure_no_tabs(package.dir, "package dir")
    rows = rows
      + [
        "package\t" + package.name + "\t" + package.version + "\t" + package.manifest_path + "\t"
          + package.dir,
      ]
  }
  for contract in package_dependency_contracts_from_metadata(meta) {
    ensure_no_tabs(contract.package, "dependency contract package")
    ensure_no_tabs(contract.package_version, "dependency contract package version")
    ensure_no_tabs(contract.dependency, "dependency contract name")
    ensure_no_tabs(contract.requirement, "dependency contract requirement")
    ensure_no_tabs(contract.minimum, "dependency contract minimum")
    ensure_no_tabs(contract.resolution_name, "dependency contract resolution name")
    rows = rows
      + [
        "dependency_contract\t" + contract.package + "\t" + contract.package_version + "\t"
          + contract.dependency
          + "\t"
          + contract.requirement
          + "\t"
          + contract.minimum
          + "\t"
          + contract.resolution_name,
      ]
  }
  return rows
}

fn arg_spec() {
  return parser(
    {
      name: "verify_crate_packages_plan",
      args: [
        {kind: "flag", name: "metadata", long: "--metadata", parse: "string", default: ""},
        {kind: "flag", name: "root", long: "--root", parse: "string", default: ""},
      ],
    },
  )
}

fn main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(
      "usage: harn run scripts/verify_crate_packages_plan.harn -- --metadata PATH --root PATH",
    )
    return nil
  }
  const parsed_result = parse(arg_spec(), argv)
  if is_err(parsed_result) {
    harness.stdio.eprintln(unwrap_err(parsed_result).message)
    harness.runtime.exit(2)
  }
  const parsed = unwrap(parsed_result).options
  const metadata_path = to_string(parsed?.metadata ?? "")
  const root = to_string(parsed?.root ?? "")
  if metadata_path == "" || root == "" {
    harness.stdio.eprintln("error: --metadata and --root are required")
    harness.runtime.exit(2)
  }
  const meta = json_parse(harness.fs.read_text(metadata_path))
  harness.stdio.println(join(verify_crate_packages_plan_rows(meta, path_normalize(root)), "\n"))
  return nil
}
