#!/usr/bin/env harn
//
// Entry point for the reusable `bump-harn` workflow (harn#5299).
//
// The orchestration is std/bump/runtime's pure state machine; the live effects
// are std/bump/live's adapter. This script is a thin shell: it reads its
// configuration from the GitHub Actions environment, runs the bump, prints the
// machine-readable receipt to stdout, and writes step outputs/summary.
//
// It intentionally holds NO decision logic — every branch lives in the tested
// std/bump/runtime module. Run it with `harn run --no-sandbox` so it can reach
// git, the network, and the caller's validation command.
//
// Configuration (all via env, GitHub Actions style):
//   GITHUB_REPOSITORY        owner/name of the package repo being bumped
//   HARN_BUMP_TOKEN          GitHub App installation token (contents+PRs write)
//   HARN_BUMP_TARGET_TAG     optional target tag vX.Y.Z; empty => latest release
//   HARN_BUMP_VALIDATE       the caller's single declared validation command
//   HARN_BUMP_BRANCH         bump branch (default automation/bump-harn-runtime)
//   HARN_BUMP_BASE           base branch (default main)
//   HARN_BUMP_ENABLE_AUTOMERGE  "false" to skip arming auto-merge
//   HARN_BUMP_READINESS_*     optional poll bounds (attempts/interval_ms/timeout_ms)
import { gha_append_summary, gha_write_output } from "std/gha"
import { live_bump_adapter } from "std/bump/live"
import { bump_options, run_bump } from "std/bump/runtime"

fn env_or(name: string, fallback: string) -> string {
  const value = trim(harness.env.get_or(name, ""))
  return if value == "" {
    fallback
  } else {
    value
  }
}

fn env_int(name: string, fallback: int) -> int {
  return to_int(env_or(name, to_string(fallback))) ?? fallback
}

pipeline main() {
  const repo = env_or("GITHUB_REPOSITORY", "")
  const token = harness.env.get_or("HARN_BUMP_TOKEN", "")
  if trim(repo) == "" || trim(token) == "" {
    harness.stdio.eprintln("bump_harn_runtime: GITHUB_REPOSITORY and HARN_BUMP_TOKEN are required")
    return 2
  }
  const branch = env_or("HARN_BUMP_BRANCH", "automation/bump-harn-runtime")
  const base = env_or("HARN_BUMP_BASE", "main")
  const enable_auto_merge = env_or("HARN_BUMP_ENABLE_AUTOMERGE", "true") != "false"

  const adapter = live_bump_adapter(
    {
      repo: repo,
      token: token,
      branch: branch,
      base: base,
      validation_command: env_or("HARN_BUMP_VALIDATE", ""),
      refresh_command: env_or("HARN_BUMP_REFRESH", "harn install --locked || harn install"),
      readiness_max_attempts: env_int("HARN_BUMP_READINESS_ATTEMPTS", 1),
      readiness_interval_ms: env_int("HARN_BUMP_READINESS_INTERVAL_MS", 20000),
      readiness_timeout_ms: env_int("HARN_BUMP_READINESS_TIMEOUT_MS", 20000),
    },
  )

  const options = bump_options(
    {
      repo: repo,
      branch: branch,
      base: base,
      tag: env_or("HARN_BUMP_TARGET_TAG", ""),
      enable_auto_merge: enable_auto_merge,
    },
  )

  const receipt = run_bump(options, adapter)

  harness.stdio.println(json_stringify_pretty(receipt))
  gha_write_output("outcome", receipt.outcome)
  gha_write_output("ok", receipt.ok)
  gha_write_output("target_tag", receipt.target_tag)
  gha_write_output("ready", receipt.ready)
  if receipt.pr_number != nil {
    gha_write_output("pr_number", receipt.pr_number)
    gha_write_output("pr_url", receipt.pr_url ?? "")
  }
  gha_append_summary(
    "### bump-harn: ${receipt.outcome}\n\n"
      + "- target: `${receipt.target_tag}` (was `${receipt.previous_version}`)\n"
      + "- ready: ${receipt.ready}\n"
      + join(receipt.notes.map({ n -> "- ${n}" }), "\n"),
  )
  // A validation failure is the only non-idempotent-safe outcome; everything
  // else (not_ready, already_current, no_changes, closed_noop, committed) is a
  // clean exit so scheduled reruns never flap.
  return if receipt.ok {
    0
  } else {
    1
  }
}
