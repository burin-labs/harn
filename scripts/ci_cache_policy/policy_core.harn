pub const HOSTED_BUILD_JOBS = "4"

// Hang backstop for the archived workspace-test consumer lanes. These lanes never
// compile (the structural checks below pin that directly: archive-only test
// command, no compiler caches, no compile fan-out), so the timeout only has to
// cover test execution. Worst observed hosted-runner execution is ~17m on a
// cold cache; ~2x headroom means only a genuine hang trips it. This constant is
// the single owner of the value — ci.yml carries the same number.
pub const EXECUTION_ONLY_TIMEOUT_MINUTES = "35"

