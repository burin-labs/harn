/** GitHub YAML scalars used by action inputs and environment variables. */
pub type CiScalar = string | bool | int | float

/** Normalize GitHub's scalar condition, input, and environment spellings. */
pub fn ci_text(value: CiScalar?) -> string {
  return to_string(value ?? "").trim()
}

pub type CiStep = {
  id?: string,
  name?: string,
  uses?: string,
  run?: string,
  shell?: string,
  if?: string | bool,
  with?: dict<string, CiScalar>,
  env?: dict<string, CiScalar>,
  ...dict,
}

pub type CiConcurrency = {group?: string, ...dict}

pub type CiMatrixRow = dict<string, CiScalar>

pub type CiMatrix = {
  include?: string | list<CiMatrixRow>,
  exclude?: string | list<CiMatrixRow>,
  ...dict<string, CiScalar | list<CiScalar> | list<CiMatrixRow>>,
}

pub type CiJob = {
  name?: string,
  steps?: list<CiStep>,
  env?: dict<string, CiScalar>,
  needs?: string | list<string>,
  if?: string | bool,
  uses?: string,
  with?: dict<string, CiScalar>,
  permissions?: string | dict<string, string>,
  outputs?: dict<string, string>,
  strategy?: {matrix?: string | CiMatrix, ...dict},
  concurrency?: string | CiConcurrency,
  ...dict,
}

pub type CiInput = {type?: string, default?: CiScalar, options?: list<CiScalar>, ...dict}

pub type CiTrigger = {
  inputs?: dict<string, CiInput>,
  branches?: list<string>,
  tags?: list<string>,
  paths?: list<string>,
  ...dict,
}

pub type CiEvents = {
  workflow_call?: CiTrigger,
  workflow_dispatch?: CiTrigger,
  push?: CiTrigger,
  pull_request?: CiTrigger,
  merge_group?: CiTrigger,
  schedule?: list<{cron: string}>,
  ...dict,
}

pub type CiWorkflow = {
  name?: string,
  jobs?: dict<string, CiJob>,
  env?: dict<string, CiScalar>,
  permissions?: string | dict<string, string>,
  on?: string | list<string> | CiEvents,
  concurrency?: string | CiConcurrency,
  ...dict,
}

pub type CiActionRuns = {
  using?: string,
  main?: string,
  pre?: string,
  post?: string,
  steps?: list<CiStep>,
  ...dict,
}

pub type CiAction = {
  inputs?: dict<string, CiInput>,
  outputs?: dict<string, {value?: string, ...dict}>,
  runs?: CiActionRuns,
  ...dict,
}

pub type CiRunner = string \
  | list<string> \
  | {group?: string, labels?: string | list<string>, ...dict}

type CiOptionalRunner = CiRunner?

type CiTimeout = string | int | float | nil

type CiBooleanExpression = string | bool | nil

type CiCountExpression = string | int | nil

type CiPaths = list<string>?

type CiText = string?

/** GitHub's hyphenated keys are decoded here because record fields are identifiers. */
pub fn job_runner(job: CiJob?) -> CiRunner? {
  return schema_expect(job?.["runs-on"], schema_of(CiOptionalRunner))
}

pub fn job_timeout(job: CiJob?) -> string | int | float | nil {
  return schema_expect(job?.["timeout-minutes"], schema_of(CiTimeout))
}

pub fn step_timeout(step: CiStep?) -> string | int | float | nil {
  return schema_expect(step?.["timeout-minutes"], schema_of(CiTimeout))
}

pub fn step_continue_on_error(step: CiStep?) -> string | bool | nil {
  return schema_expect(step?.["continue-on-error"], schema_of(CiBooleanExpression))
}

pub fn job_continue_on_error(job: CiJob?) -> string | bool | nil {
  return schema_expect(job?.["continue-on-error"], schema_of(CiBooleanExpression))
}

pub fn strategy_fail_fast(job: CiJob?) -> string | bool | nil {
  return schema_expect(job?.strategy?.["fail-fast"], schema_of(CiBooleanExpression))
}

pub fn strategy_max_parallel(job: CiJob?) -> string | int | nil {
  return schema_expect(job?.strategy?.["max-parallel"], schema_of(CiCountExpression))
}

pub fn concurrency_cancel(concurrency: string | CiConcurrency | nil) -> string | bool | nil {
  if type_of(concurrency) == "string" {
    return nil
  }
  return schema_expect(concurrency?.["cancel-in-progress"], schema_of(CiBooleanExpression))
}

pub fn trigger_ignored_paths(trigger: CiTrigger?) -> list<string>? {
  return schema_expect(trigger?.["paths-ignore"], schema_of(CiPaths))
}

pub fn action_post_condition(action: CiAction?) -> string? {
  return schema_expect(action?.runs?.["post-if"], schema_of(CiText))
}

/** Policy checks that enumerate legs require a statically declared matrix. */
pub fn matrix_include_rows(job: CiJob?) -> list<CiMatrixRow> {
  const matrix = job?.strategy?.matrix
  if type_of(matrix) == "string" {
    throw "CI policy requires a static include matrix, not a matrix expression"
  }
  const include = matrix?.include
  if type_of(include) == "string" {
    throw "CI policy requires static include rows, not an include expression"
  }
  return include ?? []
}

pub type CiReleaseRunnerPolicy = {
  targets?: list<{target?: string, runners?: dict<string, string>, ...dict}>,
  jobs?: dict<string, dict<string, string>>,
  runner_registry?: dict<string, {provider?: string, usd_per_minute?: int | float, ...dict}>,
  ...dict,
}

pub fn job_needs(job: CiJob?) -> list<string> {
  const needs = job?.needs
  if needs == nil {
    return []
  }
  if type_of(needs) == "list" {
    return needs
  }
  return [needs]
}

/** Event-name shorthand has no event configuration to inspect. */
pub fn workflow_events(workflow: CiWorkflow?) -> CiEvents {
  const events = workflow?.on
  if events == nil {
    return {}
  }
  if type_of(events) == "dict" {
    return events
  }
  return {}
}

pub fn workflow_inputs(workflow: CiWorkflow?, event: string) -> dict<string, CiInput> {
  const events = workflow_events(workflow)
  if event == "workflow_call" {
    return events.workflow_call?.inputs ?? {}
  }
  if event == "workflow_dispatch" {
    return events.workflow_dispatch?.inputs ?? {}
  }
  return {}
}
