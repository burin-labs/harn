import { run_visible_command } from "./lib/repository_command"

/** The all-features compile policy, including the headless host-library exception. */
pub fn feature_check_arguments() -> list<list<string>> {
  return [
    ["check", "--locked", "--workspace", "--all-features", "--exclude", "harn-hostlib"],
    ["check", "--locked", "-p", "harn-hostlib", "--features", "full,computer"],
  ]
}

fn main(harness: Harness) {
  const root = path_normalize(path_join(harness.fs.source_dir(), ".."))
  const configured = harness.env.get("HARN_CARGO_CMD") ?? ""
  const command = if configured == "" {
    [path_join(root, "scripts/cargo_with_worktree_build_dir.sh")]
  } else {
    regex_captures(r"(\S+)", configured).map({ capture -> capture.groups[0] ?? "" }).to_list()
  }
  if len(command) == 0 {
    throw "empty HARN_CARGO_CMD"
  }
  for args in feature_check_arguments() {
    harness.stdio.eprintln("checking " + join(args, " "))
    const result = run_visible_command(
      pick(harness, ["tools", "stdio"]),
      {mode: "argv", argv: command + args, cwd: root, env: {ORT_SKIP_DOWNLOAD: "1"}},
    )
    if !result.success {
      harness.runtime.exit(result.exit_code ?? 1)
    }
  }
  harness.stdio.println("all-features compile gate ok")
}
