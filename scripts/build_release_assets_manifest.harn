// Emit `release-assets.json` for a Harn GitHub release.
//
// Ported from scripts/build_release_assets_manifest.py. Behavior-identical:
// same TARGETS table (Rust target triple -> packaging metadata), same
// `tag.lstrip("v")` version derivation, same per-target existence check
// (regular file only, mirroring Python `Path.is_file()`), the same
// sorted missing-archive fail-loud `SystemExit` (exit 1) with the identical
// message, and the same `json.dumps(indent=2, sort_keys=True) + "\n"` output
// (json_stringify_pretty produces byte-identical 2-space-indent, sorted-key
// JSON). On success writes the manifest and prints
// `Wrote <output> (<n> targets)` to stderr, exit 0.
//
// The argparse front end is reproduced for the operationally-relevant paths:
// `-h`/`--help` (full help to stdout, exit 0), missing required args and
// unrecognized args and dangling flag values (usage + error to stderr, exit
// 2), `--flag value` and `--flag=value` syntax, and last-value-wins for
// duplicate flags. The argparse usage line is reproduced in its deterministic
// 80-column (non-tty / no $COLUMNS) wrapped form.
//
// Pure logic lives in `pub fn`s so the paired test can drive them with no
// filesystem; `main` does argv parsing, archive existence/hash/size, and IO.
let REPO = "burin-labs/harn"

let PROG = "build_release_assets_manifest.py"

// argparse usage block (deterministic width-80 / non-tty form) and the help
// epilog (the module docstring), reproduced verbatim from the Python.
let USAGE = "usage: build_release_assets_manifest.py [-h] --artifacts-dir ARTIFACTS_DIR\n                                        --tag TAG --output OUTPUT"

/**
 * Ordered list of Rust target triples. Order matches the Python `TARGETS`
 * dict insertion order so the unsorted `missing` accumulation matches before
 * the final `sorted(...)`.
 */
pub fn target_triples() -> list<string> {
  return [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
    "x86_64-pc-windows-msvc",
  ]
}

/**
 * Packaging metadata for one target triple: `{filename, format, binaries}`.
 * Returns nil for an unknown triple (never hit; callers iterate
 * `target_triples()`). Mirrors the Python `TARGETS` table exactly.
 */
pub fn target_meta(triple: string) -> any {
  if triple == "aarch64-apple-darwin" {
    return {
      filename: "harn-aarch64-apple-darwin.tar.gz",
      format: "tar.gz",
      binaries: ["harn", "harn-dap", "harn-lsp"],
    }
  }
  if triple == "x86_64-apple-darwin" {
    return {
      filename: "harn-x86_64-apple-darwin.tar.gz",
      format: "tar.gz",
      binaries: ["harn", "harn-dap", "harn-lsp"],
    }
  }
  if triple == "x86_64-unknown-linux-gnu" {
    return {
      filename: "harn-x86_64-unknown-linux-gnu.tar.gz",
      format: "tar.gz",
      binaries: ["harn", "harn-dap", "harn-lsp", "harn-container-probe"],
    }
  }
  if triple == "aarch64-unknown-linux-gnu" {
    return {
      filename: "harn-aarch64-unknown-linux-gnu.tar.gz",
      format: "tar.gz",
      binaries: ["harn", "harn-dap", "harn-lsp", "harn-container-probe"],
    }
  }
  if triple == "x86_64-pc-windows-msvc" {
    return {
      filename: "harn-x86_64-pc-windows-msvc.zip",
      format: "zip",
      binaries: ["harn.exe", "harn-dap.exe", "harn-lsp.exe"],
    }
  }
  return nil
}

/** Strip every leading "v" from `tag` — mirrors Python `tag.lstrip("v")`. */
pub fn strip_leading_v(tag: string) -> string {
  var i = 0
  let n = tag.len()
  while i < n && tag.char_at(i) == "v" {
    i = i + 1
  }
  return tag.substring(i, n)
}

/**
 * Normalize a path string the way Python's `str(PurePosixPath(s))` does:
 * split on "/", drop empty and "." segments (keep ".."), preserve a single
 * leading "/" for absolute paths, join the rest with "/". Empty result -> ".".
 * Used for the `Wrote <output> ...` message and the joined archive path so
 * both match the Python `Path` repr.
 */
pub fn posix_path_str(s: string) -> string {
  let absolute = s.starts_with("/")
  var parts: list<string> = []
  for seg in s.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    parts = parts + [seg]
  }
  let body = parts.join("/")
  if absolute {
    return "/" + body
  }
  if body == "" {
    return "."
  }
  return body
}

/**
 * Join a directory and a filename the way Python `Path(dir) / filename` then
 * `str(...)` does: normalize the directory, then append "/filename" (filename
 * has no separators here). A bare "." directory yields just the filename.
 */
pub fn join_path(dir: string, filename: string) -> string {
  let base = posix_path_str(dir)
  if base == "." {
    return filename
  }
  if base == "/" {
    return "/" + filename
  }
  return base + "/" + filename
}

/**
 * Build the per-target asset record from a populated archive. `sha256` and
 * `size` come from the host (computed in `main`); this assembles the dict in
 * the same shape the Python emits.
 */
pub fn asset_record(triple: string, download_base: string, sha256: string, size: int) -> any {
  let meta = target_meta(triple)
  let filename = meta.filename
  return {
    filename: filename,
    url: "${download_base}/${filename}",
    sha256: sha256,
    size: size,
    format: meta.format,
    binaries: meta.binaries,
  }
}

/**
 * Render the missing-archive `SystemExit` message — the literal prefix plus
 * the sorted filenames joined by ", ". Mirrors the Python join over
 * `sorted(missing)`.
 */
pub fn missing_message(missing: list<string>) -> string {
  let sorted = missing.sort()
  return "release-assets manifest is missing required archives: " + sorted.join(", ")
}

/**
 * Assemble the final manifest dict from `version`, `tag`, `release_url`, and
 * the already-built `assets` dict. Field order is irrelevant because
 * json_stringify_pretty sorts keys, matching `sort_keys=True`.
 */
pub fn build_manifest(version: string, tag: string, release_url: string, assets: any) -> any {
  return {version: version, tag: tag, release_url: release_url, assets: assets}
}

/**
 * The argparse help epilog: the module docstring, printed verbatim under the
 * usage line on `-h`/`--help`. Kept here so `main` can emit it without
 * embedding a giant literal at the call site.
 */
pub fn help_text() -> string {
  return USAGE + "\n\n" + DOC + "\n\n" + OPTIONS
}

let DOC = "Emit `release-assets.json` for a Harn GitHub release.\n\nDownstream consumers (`burin-code/scripts/fetch-harn.sh`, the Scoop\nmanifest generator, the `@burin/cli` npm postinstall) read this file\nto verify and fetch the correct per-architecture binary archive\nwithout scraping the GitHub releases API.\n\nSchema:\n    {\n      \"version\": \"0.8.21\",\n      \"tag\": \"v0.8.21\",\n      \"release_url\": \"https://github.com/.../releases/tag/v0.8.21\",\n      \"assets\": {\n        \"<rust-target-triple>\": {\n          \"filename\": \"harn-<triple>.tar.gz\" | \"harn-<triple>.zip\",\n          \"url\":      \"https://github.com/.../releases/download/<tag>/<filename>\",\n          \"sha256\":   \"<hex>\",\n          \"size\":     <bytes>,\n          \"format\":   \"tar.gz\" | \"zip\",\n          \"binaries\": [\"harn\", \"harn-dap\", \"harn-lsp\"] | [\"harn.exe\", ...]\n        }\n      }\n    }\n\nThe schema is keyed by Rust target triple so consumers can map their\nown platform detection (e.g. `uname -s`/`uname -m`, Node `process.platform`/\n`process.arch`) onto a single lookup. See\n`docs/src/dev/release-assets-manifest.md` for the consumer contract."

let OPTIONS = "options:\n  -h, --help            show this help message and exit\n  --artifacts-dir ARTIFACTS_DIR\n                        Directory holding the downloaded per-target archives.\n  --tag TAG             Release tag, e.g. \"v0.8.21\".\n  --output OUTPUT       Where to write release-assets.json."

/**
 * Parse argv into `{help, error, artifacts_dir, tag, output}`.
 *
 * Mirrors argparse for the operational paths:
 *   - `-h`/`--help` anywhere -> `{help: true}`.
 *   - `--flag value` and `--flag=value` for the three string options.
 *   - duplicate flags: last value wins.
 *   - a flag with no following value -> error "argument --flag: expected one
 *     argument" (exit 2).
 *   - any other token -> recorded as an unrecognized extra.
 *   - after parsing, missing required args are reported first (in declaration
 *     order); only if all required are present are extras reported as
 *     "unrecognized arguments: ...".
 * `error` is nil on success, else the post-`PROG: error: ` message text.
 */
pub fn parse_args(args: list<string>) -> any {
  var artifacts_dir: string? = nil
  var tag: string? = nil
  var output: string? = nil
  var extras: list<string> = []
  let n = args.count
  var i = 0
  while i < n {
    let a = args[i]
    if a == "-h" || a == "--help" {
      return {help: true, error: nil, artifacts_dir: nil, tag: nil, output: nil}
    }
    let eq = a.index_of("=")
    var name = a
    var inline_val: string? = nil
    if a.starts_with("--") && eq >= 0 {
      name = a.substring(0, eq)
      inline_val = a.substring(eq + 1, a.len())
    }
    if name == "--artifacts-dir" || name == "--tag" || name == "--output" {
      var value: string? = inline_val
      if value == nil {
        if i + 1 >= n {
          return {
            help: false,
            error: "argument ${name}: expected one argument",
            artifacts_dir: nil,
            tag: nil,
            output: nil,
          }
        }
        value = args[i + 1]
        i = i + 1
      }
      if name == "--artifacts-dir" {
        artifacts_dir = value
      }
      if name == "--tag" {
        tag = value
      }
      if name == "--output" {
        output = value
      }
    } else {
      extras = extras + [a]
    }
    i = i + 1
  }
  var missing: list<string> = []
  if artifacts_dir == nil {
    missing = missing + ["--artifacts-dir"]
  }
  if tag == nil {
    missing = missing + ["--tag"]
  }
  if output == nil {
    missing = missing + ["--output"]
  }
  if missing.count > 0 {
    return {
      help: false,
      error: "the following arguments are required: " + missing.join(", "),
      artifacts_dir: nil,
      tag: nil,
      output: nil,
    }
  }
  if extras.count > 0 {
    return {
      help: false,
      error: "unrecognized arguments: " + extras.join(", "),
      artifacts_dir: nil,
      tag: nil,
      output: nil,
    }
  }
  return {help: false, error: nil, artifacts_dir: artifacts_dir, tag: tag, output: output}
}

pipeline main(task) {
  let parsed = parse_args(argv)
  if parsed.help {
    __io_println(help_text())
    return 0
  }
  if parsed.error != nil {
    __io_eprintln(USAGE)
    __io_eprintln("${PROG}: error: ${parsed.error}")
    return 2
  }
  let artifacts_dir: string = parsed.artifacts_dir
  let tag: string = parsed.tag
  let output: string = parsed.output
  let version = strip_leading_v(tag)
  let download_base = "https://github.com/${REPO}/releases/download/${tag}"
  let release_url = "https://github.com/${REPO}/releases/tag/${tag}"
  var assets: any = {}
  var missing: list<string> = []
  for triple in target_triples() {
    let meta = target_meta(triple)
    let filename: string = meta.filename
    let path = join_path(artifacts_dir, filename)
    if !is_regular_file(path) {
      missing = missing + [filename]
      continue
    }
    let bytes = harness.fs.read_bytes(path)
    let sha = harness.crypto.sha256(bytes)
    let size: int = harness.fs.stat(path).size
    assets = {...assets, [triple]: asset_record(triple, download_base, sha, size)}
  }
  if missing.count > 0 {
    __io_eprintln(missing_message(missing))
    return 1
  }
  let manifest = build_manifest(version, tag, release_url, assets)
  let out_path = posix_path_str(output)
  harness.fs.write_text(out_path, json_stringify_pretty(manifest) + "\n")
  __io_eprintln("Wrote ${out_path} (${assets.keys().count} targets)")
  return 0
}

/**
 * True iff `path` exists and is a regular file (not a directory) — mirrors
 * Python `Path.is_file()`. `stat` throws on a missing path, so gate on
 * `exists` first.
 */
fn is_regular_file(path: string) -> bool {
  if !harness.fs.exists(path) {
    return false
  }
  return harness.fs.stat(path).is_file
}
