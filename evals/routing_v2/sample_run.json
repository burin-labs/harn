        "code": "fn fib(n: int) -> int {\n    if n < 2 {\n        return n;\n    }\n    let mut a: int = 0;\n    let mut b: int = 1;\n    let mut i: int = 2;\n    while i <= n {\n        let c: int = a + b;\n        a = b;\n        b = c;\n        i = i + 1;\n    }\n    return b;\n}",
