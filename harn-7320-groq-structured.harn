pipeline default(harness: Harness, task: unknown) {
  const schema = {
    type: "object",
    properties: {answer: {type: "string"}},
    required: ["answer"],
    additionalProperties: false,
  }
  const result = harness.llm.call_structured_result(
    "Return a JSON object whose answer field is exactly PONG.",
    schema,
    {
      provider: "groq",
      model: "groq/openai/gpt-oss-20b",
      max_tokens: 32,
      temperature: 0.0,
      schema_retries: 0,
      repair: false,
      timeout_ms: 30000,
    },
  )
  harness.stdio.println(json_stringify(result))
}
