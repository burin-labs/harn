pipeline default(harness: Harness, task: unknown) {
  fn countdown(n: int, acc: int) {
    if n <= 0 {
      return acc
    }
    return countdown(n - 1, acc + 1)
  }
  let i = 0
  let total = 0
  while i < 500 {
    total = total + countdown(60, 0)
    i = i + 1
  }
  if total < 0 {
    harness.stdio.log("unreachable")
  }
}
