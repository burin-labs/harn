{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/grammar-fitness/corpus.v1.json",
  "title": "Harn grammar fitness corpus",
  "type": "object",
  "required": ["schema_version", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["language", "fixture", "authority", "operations", "expected"],
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "fixture": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["parse", "search", "safe_edit"] }
        },
        "expected": {
          "type": "object",
          "required": ["clean_parse", "minimum_search_matches", "safe_edit_suffix"],
          "additionalProperties": false,
          "properties": {
            "clean_parse": { "const": true },
            "minimum_search_matches": { "type": "integer", "minimum": 1 },
            "safe_edit_suffix": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
