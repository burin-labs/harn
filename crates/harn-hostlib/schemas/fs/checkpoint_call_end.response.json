{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/fs/checkpoint_call_end.response.json",
  "title": "fs.checkpoint_call_end response",
  "type": "object",
  "description": "Either the method's result (`available: true`) or an explicit unavailable result. Unavailable is never an empty success.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "available": {
          "const": true
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "created",
                  "modified",
                  "deleted"
                ]
              },
              "post_hash": {
                "type": "string"
              },
              "writer": {
                "type": "object",
                "properties": {"kind": {"const": "unknown"}},
                "required": ["kind"],
                "additionalProperties": false
              },
              "incomplete": {
                "type": "boolean",
                "description": "True when a scan error means this path's attribution may be wrong; restore refuses it."
              }
            },
            "required": [
              "path",
              "kind",
              "writer"
            ],
            "additionalProperties": false
          }
        },
        "scan_errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "available",
        "call_id",
        "changes",
        "scan_errors"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "available": {
          "const": false
        },
        "reason": {
          "enum": [
            "not_a_git_worktree",
            "git_unavailable",
            "index_not_writable_as_tree",
            "no_checkpoint",
            "unknown_boundary"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "reason",
        "detail"
      ],
      "additionalProperties": false
    }
  ]
}
