{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/fs/checkpoint_capture.response.json",
  "title": "fs.checkpoint_capture response",
  "type": "object",
  "description": "Either the method's result (`available: true`) or an explicit unavailable result. Unavailable is never an empty success.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "available": {
          "const": true
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "writer_policy": {
          "enum": ["legacy_scan", "require_known"]
        },
        "scanned_files": {
          "type": "integer",
          "minimum": 0
        },
        "stored_files": {
          "type": "integer",
          "minimum": 0
        },
        "stored_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unrestorable_files": {
          "type": "integer",
          "minimum": 0
        },
        "scan_errors": {
          "type": "integer",
          "minimum": 0
        },
        "scan_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "available",
        "boundary_id",
        "writer_policy",
        "scanned_files",
        "stored_files",
        "stored_bytes",
        "unrestorable_files",
        "scan_errors",
        "scan_ms"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "available": {
          "const": false
        },
        "reason": {
          "enum": [
            "not_a_git_worktree",
            "git_unavailable",
            "index_not_writable_as_tree",
            "no_checkpoint",
            "unknown_boundary",
            "incomplete_capture",
            "calls_in_flight",
            "concurrent_calls"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "reason",
        "detail"
      ],
      "additionalProperties": false
    }
  ]
}
