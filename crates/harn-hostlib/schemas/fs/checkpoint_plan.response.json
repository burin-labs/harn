{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/fs/checkpoint_plan.response.json",
  "title": "fs.checkpoint_plan response",
  "type": "object",
  "description": "Either the method's result (`available: true`) or an explicit unavailable result. Unavailable is never an empty success.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "available": {
          "const": true
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "restore",
                  "delete",
                  "recreate",
                  "refuse",
                  "skip",
                  "fail"
                ]
              },
              "reason": {
                "type": "string"
              },
              "writers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {"kind": {"const": "unknown"}},
                  "required": ["kind"],
                  "additionalProperties": false
                }
              },
              "observed": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {"kind": {"const": "absent"}},
                    "required": ["kind"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {"const": "present"},
                      "sha256": {"type": "string"}
                    },
                    "required": ["kind", "sha256"],
                    "additionalProperties": false
                  }
                ]
              },
              "expected_hash": {
                "type": "string"
              },
              "found_hash": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "action",
              "writers"
            ],
            "additionalProperties": false
          }
        },
        "irreversible": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "call_id": {
                "type": "string",
                "minLength": 1
              },
              "side_effect": {
                "enum": [
                  "network",
                  "desktop_control"
                ]
              }
            },
            "required": [
              "call_id",
              "side_effect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "available",
        "boundary_id",
        "session_id",
        "entries",
        "irreversible"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "available": {
          "const": false
        },
        "reason": {
          "enum": [
            "not_a_git_worktree",
            "git_unavailable",
            "index_not_writable_as_tree",
            "no_checkpoint",
            "unknown_boundary",
            "calls_in_flight",
            "incomplete_attribution"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "reason",
        "detail"
      ],
      "additionalProperties": false
    }
  ]
}
