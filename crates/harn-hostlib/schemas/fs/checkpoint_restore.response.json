            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "restore",
                  "delete",
                  "recreate",
                  "refuse",
                  "skip",
                  "fail"
                ]
              },
              "reason": {
                "type": "string"
              },
              "expected_hash": {
                "type": "string"
              },
              "found_hash": {
                "type": "string"
              }
            },
