{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/fs/checkpoint_restore.request.json",
  "title": "fs.checkpoint_restore request",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "boundary_id": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Optional nonempty subset of attributed paths to restore. Omit to restore every attributed path."
    },
    "confirmed_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "boundary_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "observed": {
            "oneOf": [
              {
                "type": "object",
                "properties": {"kind": {"const": "absent"}},
                "required": ["kind"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {"const": "present"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                },
                "required": ["kind", "sha256"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["session_id", "boundary_id", "path", "observed"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "session_id",
    "boundary_id"
  ],
  "additionalProperties": false
}
