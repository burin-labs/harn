{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/terminal_session/start.request.json",
  "title": "terminal_session.start request",
  "type": "object",
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 32768 }
    },
    "rows": { "type": "integer", "minimum": 1, "maximum": 512, "default": 24 },
    "columns": { "type": "integer", "minimum": 1, "maximum": 512, "default": 80 },
    "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "env": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 256 },
      "additionalProperties": { "type": "string", "maxLength": 65536 }
    }
  },
  "required": ["argv"],
  "additionalProperties": false
}
