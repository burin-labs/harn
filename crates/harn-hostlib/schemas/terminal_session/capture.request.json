{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/terminal_session/capture.request.json",
  "title": "terminal_session.capture request",
  "type": "object",
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "region": {
      "type": "object",
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 511 },
        "column": { "type": "integer", "minimum": 0, "maximum": 511 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 512 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 512 }
      },
      "required": ["row", "column", "rows", "columns"],
      "additionalProperties": false
    }
  },
  "required": ["session_id"],
  "additionalProperties": false
}
