{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/terminal_session/wait_idle.request.json",
  "title": "terminal_session.wait_idle request",
  "type": "object",
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "after_revision": { "type": "integer", "minimum": 0 },
