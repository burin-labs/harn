{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/terminal_session/start.response.json",
  "title": "terminal_session.start response",
  "type": "object",
  "properties": {
    "session_id": { "type": "string", "pattern": "^terminal-[0-9a-f-]{36}$" },
    "rows": { "type": "integer", "minimum": 1, "maximum": 512 },
    "columns": { "type": "integer", "minimum": 1, "maximum": 512 }
  },
  "required": ["session_id", "rows", "columns"],
  "additionalProperties": false
}
