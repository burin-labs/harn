{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/ast/capabilities.response.json",
  "title": "ast.capabilities response",
  "description": "The per-language AST-precise edit capability matrix. `ok` carries the `languages` rows; `unsupported_language` is returned when a `language` filter resolves to no registered grammar. Both carry `fallback_suggestion`.",
  "type": "object",
  "properties": {
    "result": {
      "type": "string",
      "enum": ["ok", "unsupported_language"]
    },
    "fallback_suggestion": {
      "type": "string",
      "description": "Text-edit degradation path the agent loop should use when no AST primitive applies."
    },
    "details": {
      "type": "string",
      "description": "Short human-readable diagnostic; set when `result == \"unsupported_language\"`."
    },
    "languages": {
      "type": "array",
      "description": "Capability rows, one per language. Set when `result == \"ok\"`.",
      "items": {
        "type": "object",
        "properties": {
          "language": { "type": "string" },
          "extension": { "type": "string" },
          "apply_node": { "type": "boolean" },
          "insert_at_anchor": { "type": "boolean" },
          "rename_symbol": { "type": "boolean" },
          "symbols": { "type": "boolean" },
          "health": {
            "type": "object",
            "description": "Versioned safe-edit ParserHealth artifact and corpus fitness.",
            "required": ["schema_version", "operation", "grammar", "corpus", "source", "support", "coverage"],
            "properties": {
              "schema_version": { "const": 1 },
              "operation": { "enum": ["parse", "search", "safe_edit"] },
              "grammar": { "type": "object" },
              "corpus": { "type": "object" },
              "source": { "type": "object" },
              "support": { "enum": ["supported", "unsupported"] },
              "coverage": { "enum": ["verified", "partial", "unavailable", "inconclusive"] }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "language",
          "extension",
          "apply_node",
          "insert_at_anchor",
          "rename_symbol",
          "symbols",
          "health"
        ],
        "additionalProperties": false
      }
    },
    "health": {
      "type": "object",
      "description": "Explicit unavailable ParserHealth on an unsupported-language response.",
      "required": ["schema_version", "operation", "grammar", "corpus", "source", "support", "coverage"],
      "properties": {
        "schema_version": { "const": 1 },
        "operation": { "enum": ["parse", "search", "safe_edit"] },
        "grammar": { "type": "object" },
        "corpus": { "type": "object" },
        "source": { "type": "object" },
        "support": { "enum": ["supported", "unsupported"] },
        "coverage": { "enum": ["verified", "partial", "unavailable", "inconclusive"] }
      },
      "additionalProperties": false
    }
  },
  "required": ["result", "fallback_suggestion"],
  "additionalProperties": false
}
