{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/host_lease/release.response.json",
  "title": "host_lease.release response",
  "description": "Terminal idempotent release receipt.",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "released": {"type": "boolean"},
    "host": {"type": "string", "minLength": 1},
    "resource_class": {"type": "string", "enum": ["whole-machine", "rust-heavy"]},
    "lease_id": {"type": "string", "minLength": 1},
    "observed_at_ms": {"type": "integer"}
  },
  "required": ["schema_version", "released", "host", "resource_class", "lease_id", "observed_at_ms"],
  "additionalProperties": false
}
