{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/host_lease/acquire.request.json",
  "title": "host_lease.acquire request",
  "description": "Attempt one atomic local resource acquisition with an optional bounded event-driven wait slice.",
  "type": "object",
  "properties": {
    "host": {"type": ["string", "null"], "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "resource_class": {"type": "string", "enum": ["whole-machine", "rust-heavy"]},
    "priority_class": {"type": "string", "enum": ["interactive", "measurement", "ci-verify", "deferrable"]},
    "ttl_ms": {"type": ["integer", "null"], "minimum": 1},
    "wait_slice_ms": {"type": "integer", "minimum": 0, "maximum": 5000},
    "reason": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "required": ["owner", "resource_class", "priority_class", "wait_slice_ms", "metadata"],
  "additionalProperties": false
}
