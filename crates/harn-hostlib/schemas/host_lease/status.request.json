{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/host_lease/status.request.json",
  "title": "host_lease.status request",
  "description": "Read the authoritative lease state for one explicitly named local host resource.",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1,
      "description": "Local machine resource name. Remote observation is not provided by this capability."
    },
    "resource_class": {
      "type": "string",
      "enum": ["whole-machine", "rust-heavy"]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  },
  "required": ["host"],
  "additionalProperties": false
}
