{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/host_lease/status.response.json",
  "title": "host_lease.status response",
  "description": "The current authoritative lease state. A read may transactionally remove an expired or dead-owner lease and records that recovery explicitly.",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "host": {"type": "string", "minLength": 1},
    "resource_class": {"type": "string", "enum": ["whole-machine", "rust-heavy"]},
    "observed_at_ms": {"type": "integer"},
    "active": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/Handle"}
      ]
    },
    "recovered_stale_lease": {"type": "boolean"}
  },
  "required": [
    "schema_version",
    "host",
    "resource_class",
    "observed_at_ms",
    "active",
    "recovered_stale_lease"
  ],
  "additionalProperties": false,
  "$defs": {
    "Handle": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "host": {"type": "string", "minLength": 1},
        "resource_class": {"type": "string", "enum": ["whole-machine", "rust-heavy"]},
        "lease_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "priority_class": {
          "type": "string",
          "enum": ["interactive", "measurement", "ci-verify", "deferrable"]
        },
        "acquired_at_ms": {"type": "integer"},
        "updated_at_ms": {"type": "integer"},
        "expires_at_ms": {"type": ["integer", "null"]},
        "owner_pid": {"type": ["integer", "null"], "minimum": 0},
        "owner_process_identity": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": ["string", "null"]},
        "metadata": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "required": [
        "schema_version",
        "host",
        "resource_class",
        "lease_id",
        "owner",
        "priority_class",
        "acquired_at_ms",
        "updated_at_ms",
        "expires_at_ms",
        "owner_pid",
        "owner_process_identity",
        "reason",
        "metadata"
      ],
      "additionalProperties": false
    }
  }
}
