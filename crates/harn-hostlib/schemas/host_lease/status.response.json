{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/host_lease/status.response.json",
  "title": "host_lease.status response",
  "description": "Active ownership and pending admission requests for one resource. Reads apply the admission cleanup policy and report recovered leases explicitly.",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "minimum": 5},
    "host": {"type": "string", "minLength": 1},
    "resource_class": {"type": "string", "enum": ["whole-machine", "rust-heavy"]},
    "domain": {"type": "string", "minLength": 1},
    "observed_at_ms": {"type": "integer"},
    "active": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/Handle"}
      ]
    },
    "pending": {
      "type": "array",
      "items": {"$ref": "#/$defs/PendingRequest"}
    },
    "recovered_stale_lease": {"type": "boolean"},
    "recovered": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/Handle"}
      ]
    }
  },
  "required": [
    "schema_version",
    "host",
    "resource_class",
    "domain",
    "observed_at_ms",
    "active",
    "pending",
    "recovered_stale_lease",
    "recovered"
  ],
  "additionalProperties": false,
  "$defs": {
    "PendingRequest": {
      "type": "object",
      "properties": {
        "waiter_id": {"type": "string", "minLength": 1},
        "priority_class": {
          "type": "string",
          "enum": ["interactive", "measurement", "ci-verify", "deferrable"]
        },
        "requested_at_ms": {"type": "integer"},
        "deadline_at_ms": {"type": "integer"},
        "owner_pid": {"type": ["integer", "null"], "minimum": 0},
        "recoverable": {"type": "boolean"}
      },
      "required": ["waiter_id", "priority_class", "requested_at_ms", "deadline_at_ms", "owner_pid", "recoverable"],
      "additionalProperties": false
    },
    "Handle": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "host": {"type": "string", "minLength": 1},
        "resource_class": {"type": "string", "enum": ["whole-machine", "rust-heavy"]},
        "domain": {"type": "string", "minLength": 1},
        "lease_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "priority_class": {
          "type": "string",
          "enum": ["interactive", "measurement", "ci-verify", "deferrable"]
        },
        "acquired_at_ms": {"type": "integer"},
        "updated_at_ms": {"type": "integer"},
        "expires_at_ms": {"type": ["integer", "null"]},
        "owner_pid": {"type": ["integer", "null"], "minimum": 0},
        "owner_process_identity": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": ["string", "null"]},
        "metadata": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "required": [
        "schema_version",
        "host",
        "resource_class",
        "domain",
        "lease_id",
        "owner",
        "priority_class",
        "acquired_at_ms",
        "updated_at_ms",
        "expires_at_ms",
        "owner_pid",
        "owner_process_identity",
        "reason",
        "metadata"
      ],
      "additionalProperties": false
    }
  }
}
