{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/code_index/extract_function.response.json",
  "title": "code_index.extract_function response",
  "description": "Tagged result of an extraction in the shared refactoring envelope that `rename_symbol` defined: `applied` carries the edit (with `dry_run` nothing was written; a failed write keeps the tag with `applied: false` and `failed_paths_with_reasons`), and every other tag is a refusal that wrote nothing. `inputs` and `outputs` are reported whenever the analysis got far enough to compute them, so a `types_required` caller knows what to type.",
  "type": "object",
  "properties": {
    "result": {
      "type": "string",
      "enum": [
        "applied",
        "no_match",
        "ambiguous_symbol",
        "unsupported_language",
        "syntax_error",
        "control_flow_escapes",
        "signature_mismatch",
        "types_required",
        "name_conflict",
        "unsupported_region"
      ]
    },
    "applied": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "enum": [
        "file"
      ],
      "description": "Extraction always edits one file."
    },
    "symbol": {
      "type": "object",
      "description": "The function being created: `name` is `new_name`, `line` is where the region starts.",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "path"
      ],
      "additionalProperties": false
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "before_sha256": {
            "type": "string"
          },
          "after_sha256": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_row": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_col": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_row": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_col": {
                  "type": "integer",
                  "minimum": 0
                },
                "before": {
                  "type": "string"
                },
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "start_byte",
                "end_byte",
                "before",
                "after"
              ]
            }
          }
        },
        "required": [
          "path",
          "edits"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Populated on `name_conflict`: every existing use of `new_name`.",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "shadow": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "shadow"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "description": "Every match of an `ambiguous_symbol` region.",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "failed_paths_with_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ]
      }
    },
    "match_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Spans replaced; equals `occurrences_replaced`."
    },
    "details": {
      "type": "string"
    },
    "fallback_suggestion": {
      "type": "string"
    },
    "region": {
      "description": "The syntactic unit the selection lined up with; null when it lined up with none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "expression",
                "statements",
                "closure_body"
              ]
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "start_line",
            "end_line"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inputs": {
      "type": "array",
      "description": "Free names the region reads from the enclosing function, in parameter order: closure parameters first, then first use.",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "description": "Names the region binds or assigns that are read after it. One is returned; several become a tuple (Rust, Python) or an object (TypeScript, JavaScript).",
      "items": {
        "type": "string"
      }
    },
    "returns_value": {
      "type": "boolean"
    },
    "helper": {
      "type": "string",
      "description": "The inserted function text. Empty on refusals."
    },
    "call": {
      "type": "string",
      "description": "The text that replaced the primary region. Empty on refusals."
    },
    "sites": {
      "type": "array",
      "description": "Blocking jumps for `control_flow_escapes`, and copies left unchanged on success.",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "occurrences_replaced": {
      "type": "integer",
      "minimum": 0
    },
    "call_sites_updated": {
      "type": "integer",
      "minimum": 0
    },
    "comments_left_behind": {
      "type": "array",
      "description": "Always empty: comments inside the region move with it.",
      "items": {
        "$ref": "#/$defs/site"
      }
    }
  },
  "required": [
    "result",
    "applied",
    "dry_run",
    "scope",
    "symbol",
    "touched_files",
    "conflicts",
    "warnings",
    "failed_paths_with_reasons",
    "match_count",
    "details",
    "region",
    "inputs",
    "outputs",
    "returns_value",
    "helper",
    "call",
    "sites",
    "occurrences_replaced",
    "call_sites_updated",
    "comments_left_behind"
  ],
  "$defs": {
    "site": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "kind",
        "reason",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
