{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/code_index/file_hash_snapshot.request.json",
  "title": "code_index.file_hash_snapshot request",
  "description": "Capture current on-disk file hashes for a batch of workspace paths under one code-index sequence binding.",
  "type": "object",
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": ["paths"],
  "additionalProperties": false
}
