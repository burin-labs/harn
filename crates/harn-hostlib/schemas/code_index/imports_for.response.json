{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/code_index/imports_for.response.json",
  "title": "code_index.imports_for response",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Import"
      }
    },
    "resolution_strategy": {
      "type": "string",
      "enum": [
        "dotted",
        "dotted-literal",
        "relative",
        "rust-module",
        "unresolved-by-design"
      ],
      "description": "How this file's language resolves imports to workspace files. `unresolved-by-design` means no resolver exists for the language, so a null `resolved_path` on every entry reports that nothing was attempted rather than that nothing matched."
    }
  },
  "required": [
    "path",
    "imports",
    "resolution_strategy"
  ],
  "additionalProperties": false,
  "$defs": {
    "Import": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "resolved_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "description": "Language-specific kind (e.g. \"use\", \"import\", \"require\", \"include\")."
        }
      },
      "required": [
        "module",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
