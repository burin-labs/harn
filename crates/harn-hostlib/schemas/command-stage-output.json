{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/command-stage-output.json",
  "description": "Runner-owned output attribution, not proof that an executable ran tests.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": { "const": "unmeasured" },
        "reason": { "type": "string" }
      },
      "required": ["status", "reason"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "captured" },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "stdout_truncated": { "type": "boolean" },
        "stderr_truncated": { "type": "boolean" },
        "output_path": { "type": "string" },
        "stdout_path": { "type": "string" },
        "stderr_path": { "type": "string" },
        "line_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["status", "argv", "stdout", "stderr", "stdout_truncated", "stderr_truncated", "output_path", "stdout_path", "stderr_path", "line_count"],
      "additionalProperties": false
    }
  ]
}
