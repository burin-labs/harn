{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/scanner/discover_test_commands.response.json",
  "title": "scanner.discover_test_commands response",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": { "const": "complete" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/TestCommand" } },
        "preferred": { "type": ["integer", "null"], "minimum": 0 },
        "layout": { "$ref": "#/$defs/TestLayoutDiscovery" }
      },
      "required": ["state", "commands", "preferred", "layout"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "state": { "const": "unavailable" },
        "detail": { "type": "string", "minLength": 1 }
      },
      "required": ["state", "detail"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "TestCommand": {
      "type": "object",
      "properties": {
        "cwd": { "type": "string", "minLength": 1 },
        "invocation": { "$ref": "#/$defs/TestInvocation" },
        "label": { "type": "string" }
      },
      "required": ["cwd", "invocation", "label"],
      "additionalProperties": false
    },
    "TestInvocation": {
      "oneOf": [
        { "type": "object", "properties": { "mode": { "const": "argv" }, "program": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "type": "string" } } }, "required": ["mode", "program", "args"], "additionalProperties": false },
        { "type": "object", "properties": { "mode": { "const": "shell" }, "command": { "type": "string", "minLength": 1 } }, "required": ["mode", "command"], "additionalProperties": false }
      ]
    },
    "TestLayoutDiscovery": {
      "oneOf": [
        { "type": "object", "properties": { "state": { "const": "unconfigured" } }, "required": ["state"], "additionalProperties": false },
        { "type": "object", "properties": { "state": { "const": "empty" } }, "required": ["state"], "additionalProperties": false },
        { "type": "object", "properties": { "state": { "const": "single" }, "language": { "type": "string", "minLength": 1 }, "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "required": ["state", "language", "files"], "additionalProperties": false },
        { "type": "object", "properties": { "state": { "const": "ambiguous" }, "languages": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } } }, "required": ["state", "languages"], "additionalProperties": false }
      ]
    }
  }
}
