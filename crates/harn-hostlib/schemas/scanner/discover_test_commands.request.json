{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/scanner/discover_test_commands.request.json",
  "title": "scanner.discover_test_commands request",
  "type": "object",
  "properties": {
    "root": { "type": "string" },
    "include_hidden": { "type": "boolean", "default": false },
    "ignore_policy": { "type": "string", "enum": ["none", "builtin", "project"], "default": "project" },
    "layout_profiles": { "$ref": "#/$defs/TestLayoutProfiles" }
  },
  "required": ["root"],
  "additionalProperties": false,
  "$defs": {
    "TestLayoutProfiles": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "language": { "type": "string", "minLength": 1 },
          "extensions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["language", "extensions", "patterns"],
        "additionalProperties": false
      }
    }
  }
}
