{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository measurement request",
  "type": "object",
  "required": ["root", "registry"],
  "additionalProperties": false,
  "properties": {
    "root": {"type": "string", "minLength": 1},
    "registry": {
      "type": "object",
      "required": ["version", "areas", "exclusions"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "include": {"type": "array", "items": {"type": "string"}},
        "ignore_policy": {"enum": ["none", "builtin", "project"]},
        "areas": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "patterns"], "additionalProperties": false,
            "properties": {"name": {"type": "string", "minLength": 1}, "patterns": {"$ref": "#/$defs/patterns"}}
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["reason", "patterns"], "additionalProperties": false,
            "properties": {
              "reason": {"enum": ["generated", "vendored", "lockfiles", "build_output", "other", "symlink", "outside_scope", "non_text", "ignored"]},
              "patterns": {"$ref": "#/$defs/patterns"}
            }
          }
        }
      }
    }
  },
  "$defs": {"patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
}
