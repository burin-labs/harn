{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnlang.com/schemas/hostlib/tools/wait_command.response.json",
  "title": "tools.wait_command response",
  "type": "object",
  "properties": {
    "verifier_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["verifier_id", "baseline_sha256", "executed_material"],
      "properties": {
        "verifier_id": {"type": "string"},
        "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executed_material": {
          "type": "object", "additionalProperties": false,
          "required": ["disposition"],
          "properties": {"disposition": {"const": "unchanged"}}
        }
      }
    },
    "command_id": { "type": "string" },
    "cwd": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["completed", "running", "timed_out", "killed", "blocked", "spawn_failed"]
    },
    "handle_id": { "type": "string" },
    "completed": { "type": "boolean" },
    "feedback_kind": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": ["integer", "null"] },
    "missing_program": { "type": "string", "description": "First program proven absent against the child environment before a normal exit 127." },
    "signal": { "type": ["string", "null"] },
    "timed_out": { "type": "boolean" },
    "stdout": { "type": "string" },
    "stdout_truncated": {
      "type": "boolean",
      "description": "The returned stdout omits bytes the process wrote, because the capture exceeded max_inline_bytes."
    },
    "stderr": { "type": "string" },
    "stderr_truncated": {
      "type": "boolean",
      "description": "The returned stderr omits bytes the process wrote."
    },
    "output_path": { "type": "string" },
    "stdout_path": { "type": "string" },
    "stderr_path": { "type": "string" },
    "line_count": { "type": "integer", "minimum": 0 },
    "byte_count": { "type": "integer", "minimum": 0 },
    "output_sha256": { "type": "string" },
    "process_group_id": { "type": ["integer", "null"] },
    "sandbox": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "enforced": { "type": "boolean" },
        "network": {
          "description": "Normalized spawn-time grants retained when the command is read under another policy. Permission does not prove reachability or a denial.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": { "const": "policy" },
                "direct_network": { "type": "boolean" },
                "tcp_loopback": { "type": "boolean" },
                "managed_proxy": { "type": "boolean" }
              },
              "required": ["status", "direct_network", "tcp_loopback", "managed_proxy"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": { "status": { "enum": ["inherited", "unavailable", "unknown"] } },
              "required": ["status"],
              "additionalProperties": false
            }
          ]
        },
        "denial_reporting": {
          "type": "string",
          "enum": ["not_enforced", "backend_unavailable", "inferred_only"],
          "description": "Coverage of mid-run sandbox denial reporting. inferred_only means a null denial is not proof that no operation was refused."
        },
        "broker": {
          "type": "string",
          "description": "Id of the embedder spawn broker that ran this exact argv outside the active confinement. Absent for every confined spawn."
        }
      },
      "required": ["kind", "enforced", "denial_reporting", "network"],
      "additionalProperties": false
    },
    "denial": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/process_sandbox_denial" }
      ]
    },
    "snapshot_binding": {
      "type": "object",
      "description": "Opaque verification snapshot binding carried from the background run_command request.",
      "additionalProperties": true
    },
    "process_cleanup": { "$ref": "#/$defs/process_cleanup" },
    "command_or_op_descriptor": { "type": "string" }
  },
  "required": ["handle_id", "status", "timed_out"],
  "additionalProperties": false,
  "$defs": {
    "process_sandbox_denial": {
      "type": "object",
      "properties": {
        "schema": { "const": "harn.process.sandbox_refusal.v1" },
        "gate": { "const": "process_sandbox" },
        "capability": { "const": "process.run" },
        "backend": { "type": "string" },
        "operation": { "enum": ["read", "write", "unknown"] },
        "mechanism": {
          "enum": ["egress", "local_socket", "home_read", "write", "unknown"]
        },
        "resource": { "type": ["string", "null"] },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "type": "string" },
        "refused_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observability": { "enum": ["inferred"] },
        "stderr_excerpt": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "retryable": { "const": false },
        "reason": { "type": "string" }
      },
      "required": [
        "schema",
        "gate",
        "capability",
        "backend",
        "operation",
        "mechanism",
        "resource",
        "command",
        "cwd",
        "refused_paths",
        "observability",
        "stderr_excerpt",
        "count",
        "retryable",
        "reason"
      ],
      "additionalProperties": false
    },
    "process_cleanup": {
      "type": "object",
      "properties": {
        "root_pid": { "type": ["integer", "null"] },
        "attempted_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observed_child_count": { "type": "integer", "minimum": 0 },
        "reaped_child_count": { "type": "integer", "minimum": 0 },
        "survivor_count": { "type": ["integer", "null"], "minimum": 0 },
        "census_complete": { "type": "boolean" },
        "guardian_custody_complete": { "type": "boolean" },
        "census_control_read": { "type": "boolean" },
        "census_scanned_processes": { "type": "integer", "minimum": 0 },
        "census_unreadable_processes": { "type": "integer", "minimum": 0 },
        "omitted_child_count": { "type": "integer", "minimum": 0 },
        "observed_children": {
          "type": "array",
          "items": { "$ref": "#/$defs/process_cleanup_child" }
        },
        "reaped_children": {
          "type": "array",
          "items": { "$ref": "#/$defs/process_cleanup_child" }
        },
        "surviving_children": {
          "type": "array",
          "items": { "$ref": "#/$defs/process_cleanup_child" }
        }
      },
      "required": [
        "root_pid",
        "attempted_signals",
        "observed_child_count",
        "reaped_child_count",
        "survivor_count",
        "census_complete",
        "guardian_custody_complete",
        "census_control_read",
        "census_scanned_processes",
        "census_unreadable_processes",
        "omitted_child_count",
        "observed_children",
        "reaped_children",
        "surviving_children"
      ],
      "additionalProperties": false,
      "allOf": [{
        "if": { "properties": { "survivor_count": { "const": 0 } } },
        "then": { "anyOf": [
          { "properties": {
            "census_complete": { "const": true },
            "census_control_read": { "const": true },
            "census_scanned_processes": { "minimum": 1 },
            "census_unreadable_processes": { "const": 0 }
          } },
          { "properties": { "guardian_custody_complete": { "const": true } } }
        ], "properties": {
          "omitted_child_count": { "const": 0 },
          "surviving_children": { "maxItems": 0 },
          "observed_children": { "items": { "properties": { "alive_after_cleanup": { "const": false } } } }
        } }
      }]
    },
    "process_cleanup_child": {
      "type": "object",
      "properties": {
        "pid": { "type": "integer" },
        "parent_pid": { "type": ["integer", "null"] },
        "depth": { "type": "integer", "minimum": 1 },
        "command_name": { "type": ["string", "null"] },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alive_after_cleanup": { "type": ["boolean", "null"] }
      },
      "required": ["pid", "parent_pid", "depth", "command_name", "signals", "alive_after_cleanup"],
      "additionalProperties": false
    }
  }
}
