import { llm_caller } from "std/llm/caller"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  harness.llm.rate_limit("openai", {rpm: 1000, concurrency: 1})
  with_llm_script(
    harness.llm,
    [
      {error: {category: "transient_network", message: "connection reset"}},
      llm_text("reached-provider"),
    ],
    { ->
      const caller = llm_caller(harness, {retry: {max_attempts: 2, base_ms: 0, jitter: "none"}})
      const result = caller({prompt: "hello", opts: {provider: "openai"}})
      assert(result.ok)
      harness.stdio.println(result.value.text)
      harness.stdio.println(result.retries_attempted)
      harness.stdio.println(len(harness.llm.mock_calls()))
    },
  )
}
