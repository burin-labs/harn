 * @errors: []
 * @api_stability: stable
 * @example: web_parse_html(html, source_url)
 */
pub fn web_parse_html(html: string, source_url = nil) -> dict {
  return __web_extract_html(html, source_url)
}

/**
 * Extract the HTML title.
 *
 * @effects: []
 * @allocation: heap
 * @errors: []
