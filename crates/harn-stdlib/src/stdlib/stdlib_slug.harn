/**
 * std/slug — memorable, non-secret names for runs, agents, incidents, and fixtures.
 *
 * Import with: import "std/slug"
 *
 * @effects: ["random"]
 * @errors: []
 */
const __SLUG_ADJECTIVES = [
  "able",
  "bright",
  "calm",
  "careful",
  "clever",
  "crisp",
  "curious",
  "dapper",
  "direct",
  "eager",
  "fair",
  "fresh",
  "gentle",
  "honest",
  "kind",
  "lively",
  "lucid",
  "merry",
  "nimble",
  "patient",
  "plain",
  "precise",
  "quiet",
  "ready",
  "robust",
  "steady",
  "tidy",
  "useful",
  "vivid",
  "warm",
  "witty",
  "zesty",
]

const __SLUG_NOUNS = [
  "anchor",
  "apricot",
  "atlas",
  "battery",
  "beacon",
  "bridge",
  "button",
  "canvas",
  "celery",
  "circuit",
