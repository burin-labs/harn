import { filter_nil } from "std/collections"

/**
 * std/triage - normalized dashboard inbox envelopes for connector-derived
 * events.
 *
 * The normalized card fields are intentionally separate from `raw_payload` so
 * hosts can render inbox items without depending on provider-specific webhook
 * shapes while receipts keep the original source material available for audit.
 */
type TriagePriority = "p0" | "p1" | "p2" | "p3" | "p4" | string

type TriageUrgency = "critical" | "high" | "normal" | "low" | string

type TriageActor = {kind: string, id: string, display_name?: string, url?: string}

type TriageRelatedRef = {kind: string, label?: string, url: string}

type TriagePrivacy = {
  redacted: bool,
  raw_payload_retained: bool,
  contains_sensitive: bool,
  flags: list<string>,
}

type TriageActionIntent = {
  kind: string,
  label: string,
  target: dict,
  effect: string,
  requires_approval: bool,
  default_duration?: string,
}

type TriageEvent = {
  schema: "harn.triage_event.v1",
  id: string,
  provider: string,
  source_kind: string,
  source_id: string,
  source_url: string,
  source_timestamp: string?,
  received_at: string?,
  actors: list<TriageActor>,
  summary: string,
  why_it_matters: string,
  proposed_action: string,
  urgency: TriageUrgency,
  priority: TriagePriority,
  confidence: float,
  related_refs: list<TriageRelatedRef>,
  dedupe_key: string,
  privacy: TriagePrivacy,
  action_intents: list<TriageActionIntent>,
  raw_payload: dict,
}

/**
 * Always emitted by `triage_normalize` (the literal is not `filter_nil`-ed),
 * but the underlying lookup can resolve to nil, so the key is present with a
 * nilable value rather than being absent.
 */
type TriageEmitReceipt = {
  schema: "harn.triage_event_emit_receipt.v1",
  topic: string,
  kind: "triage_event",
  event_log_id: int,
  event: TriageEvent,
}

/** Feed contents retain typed events and receipts; title and timestamp values pass through. */
pub type TriageFeed = {
  schema: "harn.start_my_day.triage_feed.v1",
  generated_at: unknown,
  title: unknown,
  events: list<TriageEvent>,
  receipts: list<TriageEmitReceipt>,
}

type TriageRawEnvelope = {
  provider?: unknown,
  provider_payload?: unknown,
  raw_payload?: unknown,
  payload?: unknown,
  raw?: unknown,
  ...dict,
}

type TriageRawReference = {
  html_url?: unknown,
  target_url?: unknown,
  permalink?: unknown,
  node_id?: unknown,
  id?: unknown,
  login?: unknown,
  user?: unknown,
  full_name?: unknown,
  name?: unknown,
  text?: unknown,
  updated_at?: unknown,
  created_at?: unknown,
  submitted_at?: unknown,
  high_water_mark?: unknown,
  after?: unknown,
  last_edited_time?: unknown,
  ...dict,
}

fn __triage_reference(value: unknown) -> TriageRawReference? {
  if type_of(value) != "dict" {
    return nil
  }
  return schema_expect(value, schema_of(TriageRawReference))
}

const TRIAGE_EVENT_SCHEMA = "harn.triage_event.v1"

const TRIAGE_EVENT_KIND = "triage_event"

const TRIAGE_EVENT_TOPIC = "triage.inbox.events"

fn __triage_text(value: unknown) -> string {
  if value == nil {
    return ""
  }
  return trim(to_string(value))
}

fn __triage_first(values: list<unknown>) -> string? {
  for value in values {
    const text = __triage_text(value)
    if text != "" {
      return text
    }
  }
  return nil
}

fn __triage_compact(text: unknown, limit: int = 120) -> string {
  const value = __triage_text(text)
  if len(value) <= limit {
    return value
  }
  if limit <= 3 {
    return substring(value, 0, limit)
  }
  return substring(value, 0, limit - 3) + "..."
}

fn __triage_payload(input: TriageRawEnvelope) -> unknown {
  return input.provider_payload ?? input.raw_payload ?? input.payload ?? input.raw ?? input
}

fn __triage_provider(
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> string {
  const provider = __triage_first([options?.provider, input.provider, payload.provider])
  if provider == nil {
    throw "std/triage: provider is required"
  }
  return lowercase(provider)
}

fn __triage_source_kind(
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> string {
  return __triage_first(
    [
      options?.source_kind,
      input?.source_kind,
      input?.kind,
      payload?.source_kind,
      payload?.event,
      payload?.type,
    ],
  )
    ?? "item"
}

fn __triage_github_source_url(payload: TriageRawEnvelope) -> string? {
  const issue = __triage_reference(payload?.issue)
  const pull_request = __triage_reference(payload?.pull_request)
  const comment = __triage_reference(payload?.comment)
  const review = __triage_reference(payload?.review)
  const workflow_run = __triage_reference(payload?.workflow_run)
  const check_run = __triage_reference(payload?.check_run)
  const deployment_status = __triage_reference(payload?.deployment_status)
  const commit_status = __triage_reference(payload?.commit_status)
  const repository = __triage_reference(payload?.repository)
  const repo = __triage_reference(payload?.repo)
  const raw = __triage_reference(payload.raw)
  return __triage_first(
    [
      issue?.html_url,
      pull_request?.html_url,
      comment?.html_url,
      review?.html_url,
      workflow_run?.html_url,
      check_run?.html_url,
      deployment_status?.target_url,
      commit_status?.target_url,
      repository?.html_url,
      repo?.html_url,
      raw?.html_url,
    ],
  )
}

fn __triage_slack_source_url(input: TriageRawEnvelope, payload: TriageRawEnvelope) -> string? {
  const raw = __triage_reference(payload.raw)
  const explicit = __triage_first(
    [
      input?.source_url,
      payload?.source_url,
      payload?.permalink,
      payload?.message_url,
      raw?.permalink,
    ],
  )
  if explicit != nil {
    return explicit
  }
  const team = __triage_first([payload?.team_id, input?.team_id])
  const channel = __triage_first(
    [payload?.channel, payload?.channel_id, input?.channel, input?.channel_id],
  )
  const ts = __triage_first([payload?.ts, payload?.thread_ts, payload?.event_ts, input?.ts])
  if channel != nil && ts != nil {
    let link = "slack://channel?id=" + url_encode(channel) + "&message=" + url_encode(ts)
    if team != nil {
      link = link + "&team=" + url_encode(team)
    }
    return link
  }
  return nil
}

fn __triage_source_url(
  provider: string,
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> string? {
  const explicit = __triage_first(
    [options?.source_url, input?.source_url, input?.url, input?.deep_link],
  )
  if explicit != nil {
    return explicit
  }
  if provider == "github" {
    return __triage_github_source_url(payload)
  }
  if provider == "slack" {
    return __triage_slack_source_url(input, payload)
  }
  return __triage_first([payload?.source_url, payload?.url, payload?.html_url])
}

fn __triage_source_id(
  provider: string,
  source_url: string,
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> string {
  const explicit = __triage_first(
    [options?.source_id, input?.source_id, payload?.source_id, payload?.id],
  )
  if explicit != nil {
    return explicit
  }
  if provider == "github" {
    const comment = __triage_reference(payload?.comment)
    const issue = __triage_reference(payload?.issue)
    const pull_request = __triage_reference(payload?.pull_request)
    const workflow_run = __triage_reference(payload?.workflow_run)
    const check_run = __triage_reference(payload?.check_run)
    return __triage_first(
      [
        comment?.node_id,
        comment?.id,
        issue?.node_id,
        issue?.id,
        pull_request?.node_id,
        pull_request?.id,
        workflow_run?.id,
        check_run?.id,
      ],
    )
      ?? source_url
  }
  if provider == "slack" {
    const channel = __triage_first(
      [payload?.channel, payload?.channel_id, input?.channel, input?.channel_id],
    )
    const ts = __triage_first([payload?.ts, payload?.thread_ts, payload?.event_ts, input?.ts])
    if channel != nil && ts != nil {
      return channel + ":" + ts
    }
    const event_id = __triage_first([payload?.event_id, input?.event_id])
    if event_id != nil {
      return event_id
    }
  }
  return source_url
}

/**
 * Build the stable triage-event dedupe key from provider-neutral source data.
 *
 * @effects: []
 * @errors: []
 */
pub fn triage_dedupe_key(
  provider: unknown,
  source_kind: unknown,
  source_url: unknown,
  source_id: unknown = nil,
) -> string {
  const seed = lowercase(__triage_text(provider))
    + "\n"
    + lowercase(__triage_text(source_kind))
    + "\n"
    + __triage_text(source_url)
    + "\n"
    + __triage_text(source_id ?? source_url)
  return "triage:" + lowercase(__triage_text(provider)) + ":" + substring(sha256(seed), 0, 32)
}

fn __triage_actor(kind: string, id: any, display_name: any = nil, url: any = nil) {
  return filter_nil({kind: kind, id: id, display_name: display_name, url: url})
}

fn __triage_push_actor(
  actors: list,
  kind: string,
  id: any,
  display_name: any = nil,
  url: any = nil,
) {
  const actor_id = __triage_text(id)
  if actor_id == "" {
    return actors
  }
  return actors + [__triage_actor(kind, actor_id, display_name ?? actor_id, url)]
}

fn __triage_github_actors(payload: TriageRawEnvelope) {
  const sender = __triage_reference(payload?.sender)
  const issue = __triage_reference(payload?.issue)
  const issue_user = __triage_reference(issue?.user)
  const pull_request = __triage_reference(payload?.pull_request)
  const pull_request_user = __triage_reference(pull_request?.user)
  const comment = __triage_reference(payload?.comment)
  const comment_user = __triage_reference(comment?.user)
  const review = __triage_reference(payload?.review)
  const review_user = __triage_reference(review?.user)
  let actors = []
  actors = __triage_push_actor(actors, "user", sender?.login, sender?.login, sender?.html_url)
  actors = __triage_push_actor(
    actors,
    "user",
    issue_user?.login,
    issue_user?.login,
    issue_user?.html_url,
  )
  actors = __triage_push_actor(
    actors,
    "user",
    pull_request_user?.login,
    pull_request_user?.login,
    pull_request_user?.html_url,
  )
  actors = __triage_push_actor(
    actors,
    "user",
    comment_user?.login,
    comment_user?.login,
    comment_user?.html_url,
  )
  actors = __triage_push_actor(
    actors,
    "user",
    review_user?.login,
    review_user?.login,
    review_user?.html_url,
  )
  return actors
}

fn __triage_slack_actors(payload: TriageRawEnvelope) {
  let actors = []
  actors = __triage_push_actor(actors, "user", payload?.user ?? payload?.user_id)
  actors = __triage_push_actor(actors, "user", payload?.item_user)
  return actors
}

fn __triage_actors(
  provider: string,
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> list<TriageActor> {
  if options?.actors != nil {
    return options.actors
  }
  if input?.actors != nil {
    return input.actors
  }
  if provider == "github" {
    return __triage_github_actors(payload)
  }
  if provider == "slack" {
    return __triage_slack_actors(payload)
  }
  return []
}

fn __triage_github_summary(payload: TriageRawEnvelope, source_kind: string) -> string {
  const repository = __triage_reference(payload?.repository)
  const repo_ref = __triage_reference(payload?.repo)
  const repo = __triage_first([repository?.full_name, repo_ref?.full_name, repository?.name])
  const prefix = repo != nil ? repo + ": " : ""
  if payload?.issue != nil {
    return prefix + "Issue #" + __triage_text(payload.issue.number) + ": "
      + __triage_compact(payload.issue.title, 96)
  }
  if payload?.pull_request != nil {
    return prefix + "PR #" + __triage_text(payload.pull_request.number) + ": "
      + __triage_compact(payload.pull_request.title, 96)
  }
  if payload?.comment != nil {
    return prefix + "Comment: " + __triage_compact(payload.comment.body, 96)
  }
  if payload?.workflow_run != nil {
    return prefix + "Workflow " + __triage_text(payload.workflow_run.name ?? source_kind) + " "
      + __triage_text(payload.workflow_run.conclusion ?? payload.workflow_run.status)
  }
  return prefix + "GitHub " + source_kind
}

fn __triage_slack_summary(payload: TriageRawEnvelope) -> string {
  const channel = __triage_first([payload?.channel_name, payload?.channel, payload?.channel_id])
  const raw = __triage_reference(payload.raw)
  const text = __triage_compact(payload?.text ?? raw?.text ?? "Slack event", 110)
  if channel != nil {
    return "Slack " + channel + ": " + text
  }
  return "Slack: " + text
}

fn __triage_summary(
  provider: string,
  source_kind: string,
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> string {
  const explicit = __triage_first([options?.summary, input?.summary])
  if explicit != nil {
    return explicit
  }
  if provider == "github" {
    return __triage_github_summary(payload, source_kind)
  }
  if provider == "slack" {
    return __triage_slack_summary(payload)
  }
  return provider + " " + source_kind
}

fn __triage_default_why(provider: string) -> string {
  if provider == "github" {
    return "Repository activity may need review or follow-up."
  }
  if provider == "slack" {
    return "A workspace conversation may need a response or task capture."
  }
  return "Connector activity may need review."
}

fn __triage_default_action(provider: string) -> string {
  if provider == "github" {
    return "Open the GitHub item and decide whether to respond."
  }
  if provider == "slack" {
    return "Open the Slack thread and decide whether to reply or convert it."
  }
  return "Open the source item and decide the next action."
}

fn __triage_source_timestamp(
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> string? {
  const issue = __triage_reference(payload?.issue)
  const pull_request = __triage_reference(payload?.pull_request)
  const comment = __triage_reference(payload?.comment)
  const review = __triage_reference(payload?.review)
  const polled = __triage_reference(payload?.polled)
  const after = __triage_reference(payload?.after)
  const polled_after = __triage_reference(polled?.after)
  return __triage_first(
    [
      options?.source_timestamp,
      input?.source_timestamp,
      input?.occurred_at,
      payload?.source_timestamp,
      payload?.event_ts,
      payload?.ts,
      payload?.created_at,
      payload?.updated_at,
      issue?.updated_at,
      pull_request?.updated_at,
      comment?.created_at,
      review?.submitted_at,
      polled?.high_water_mark,
      after?.last_edited_time,
      polled_after?.last_edited_time,
    ],
  )
}

fn __triage_related_refs(
  source_url: string,
  input: TriageRawEnvelope,
  payload: TriageRawEnvelope,
  options: dict,
) -> list<TriageRelatedRef> {
  if options?.related_refs != nil {
    return options.related_refs
  }
  if input?.related_refs != nil {
    return input.related_refs
  }
  let refs = [{kind: "source", label: "Source", url: source_url}]
  const repository = __triage_reference(payload?.repository)
  const repo = __triage_reference(payload?.repo)
  const repo_url = __triage_first([repository?.html_url, repo?.html_url])
  if repo_url != nil && repo_url != source_url {
    refs.push({kind: "repository", label: repository?.full_name ?? repo?.full_name, url: repo_url})
  }
  return refs
}

fn __triage_privacy(input: TriageRawEnvelope, options: dict) {
  const privacy = input?.privacy ?? {}
  return {
    redacted: options?.redacted ?? privacy?.redacted ?? false,
    raw_payload_retained: options?.raw_payload_retained ?? privacy?.raw_payload_retained ?? true,
    contains_sensitive: options?.contains_sensitive ?? privacy?.contains_sensitive ?? false,
    flags: options?.privacy_flags ?? privacy?.flags ?? [],
  }
}

fn __triage_default_action_intents(dedupe_key: any, source_url: any) -> list<TriageActionIntent> {
  const target = {dedupe_key: dedupe_key, source_url: source_url}
  return [
    {
      kind: "open_source",
      label: "Open source",
      target: target,
      effect: "navigation",
      requires_approval: false,
    },
    {
      kind: "dismiss",
      label: "Dismiss",
      target: target,
      effect: "host_inbox_state",
      requires_approval: true,
    },
    {
      kind: "snooze",
      label: "Snooze",
      target: target,
      effect: "host_inbox_state",
      requires_approval: true,
      default_duration: "PT4H",
    },
    {
      kind: "convert_to_task",
      label: "Convert to task",
      target: target,
      effect: "host_task_write",
      requires_approval: true,
    },
  ]
}

/**
 * Validate that a normalized triage event has mandatory provenance and gated write intents.
 *
 * @effects: []
 * @errors: []
 */
pub fn triage_validate(event: TriageEvent) -> TriageEvent {
  if event.schema != TRIAGE_EVENT_SCHEMA {
    throw "std/triage: unsupported schema " + __triage_text(event.schema)
  }
  for key in ["provider", "source_kind", "source_url", "dedupe_key", "summary", "proposed_action"] {
    if __triage_text(event[key]) == "" {
      throw "std/triage: " + key + " is required"
    }
  }
  for intent in event.action_intents ?? [] {
    const effect = __triage_text(intent.effect)
    if effect != "navigation" && !(intent.requires_approval ?? false) {
      throw "std/triage: write action intent `" + __triage_text(intent.kind)
        + "` must require approval"
    }
  }
  return event
}

/**
 * Normalize a provider payload or TriggerEvent into the portable triage envelope.
 *
 * Optional source references retain record fields for scalar normalizers.
 * Summary generation keeps its conditional legacy field access; explicit
 * summaries leave unused source values available in `raw_payload`.
 *
 * @effects: []
 * @errors: [runtime]
 */
pub fn triage_normalize(input: unknown, options: dict? = nil) -> TriageEvent {
  const opts = options ?? {}
  const source = schema_expect(input, schema_of(TriageRawEnvelope))
  const payload = schema_expect(__triage_payload(source), schema_of(TriageRawEnvelope))
  const provider = __triage_provider(source, payload, opts)
  const source_kind = __triage_source_kind(source, payload, opts)
  // `__triage_source_url` returns `string?`; the guard below rejects empty
  // values, so coerce to a guaranteed `string` for the rest of the builder
  // (and the `TriageEvent.source_url: string` field). `__triage_text` trims
  // and stringifies, matching exactly the value the guard already validated.
  const source_url = __triage_text(__triage_source_url(provider, source, payload, opts))
  if source_url == "" {
    throw "std/triage: source_url is required"
  }
  const source_id = __triage_text(__triage_source_id(provider, source_url, source, payload, opts))
  const dedupe_key = opts.dedupe_key ?? source?.triage_dedupe_key
    ?? triage_dedupe_key(provider, source_kind, source_url, source_id)
  const summary = __triage_text(__triage_summary(provider, source_kind, source, payload, opts))
  const event = {
    schema: TRIAGE_EVENT_SCHEMA,
    id: opts.id ?? source?.triage_event_id ?? "triage_evt_" + substring(sha256(dedupe_key), 0, 24),
    provider: provider,
    source_kind: source_kind,
    source_id: source_id,
    source_url: source_url,
    source_timestamp: __triage_source_timestamp(source, payload, opts),
    received_at: __triage_first([opts.received_at, source?.received_at]),
    actors: __triage_actors(provider, source, payload, opts),
    summary: summary,
    why_it_matters: opts.why_it_matters ?? source?.why_it_matters ?? __triage_default_why(provider),
    proposed_action: opts.proposed_action ?? source?.proposed_action
      ?? __triage_default_action(provider),
    urgency: opts.urgency ?? source?.urgency ?? "normal",
    priority: opts.priority ?? source?.priority ?? "p3",
    confidence: opts.confidence ?? source?.confidence ?? 0.85,
    related_refs: __triage_related_refs(source_url, source, payload, opts),
    dedupe_key: dedupe_key,
    privacy: __triage_privacy(source, opts),
    action_intents: opts.action_intents ?? source?.action_intents
      ?? __triage_default_action_intents(dedupe_key, source_url),
    raw_payload: payload,
  }
  return triage_validate(event)
}

/**
 * Drop duplicate triage events by stable `dedupe_key`, preserving first-seen order.
 *
 * @effects: []
 * @errors: []
 */
pub fn triage_dedupe_events(events: list) -> list<TriageEvent> {
  let seen = {}
  let out = []
  for item in events {
    const event = item?.schema == TRIAGE_EVENT_SCHEMA ? item : triage_normalize(item)
    if seen[event.dedupe_key] == nil {
      seen[event.dedupe_key] = true
      out.push(event)
    }
  }
  return out
}

/**
 * Emit a normalized triage event to the EventLog and return an audit receipt.
 *
 * @effects: [transcript.write]
 * @errors: []
 */
pub fn triage_emit(obs: HarnessObs, input: any, options: dict? = nil) -> TriageEmitReceipt {
  const opts = options ?? {}
  const event = input?.schema == TRIAGE_EVENT_SCHEMA ? triage_validate(input) : triage_normalize(
    input,
    opts,
  )
  const topic = opts.topic ?? TRIAGE_EVENT_TOPIC
  const event_log_id = obs.event_log_emit(
    topic,
    TRIAGE_EVENT_KIND,
    event,
    {schema: TRIAGE_EVENT_SCHEMA, provider: event.provider, dedupe_key: event.dedupe_key},
  )
  return {
    schema: "harn.triage_event_emit_receipt.v1",
    topic: topic,
    kind: TRIAGE_EVENT_KIND,
    event_log_id: event_log_id,
    event: event,
  }
}

/**
 * Build a small Start My Day feed from connector fixtures. Pass `{emit: true}`
 * to also serialize each unique event to the EventLog.
 * Events and emission receipts retain their types; `title` and `generated_at`
 * carry the caller's metadata values.
 *
 * @effects: []
 * @errors: []
 */
pub fn triage_start_my_day(obs: HarnessObs, inputs: list, options: dict? = nil) -> TriageFeed {
  const opts = options ?? {}
  const events = triage_dedupe_events(inputs)
  let receipts: list<TriageEmitReceipt> = []
  if opts.emit ?? false {
    for event in events {
      receipts.push(triage_emit(obs, event, {topic: opts.topic ?? TRIAGE_EVENT_TOPIC}))
    }
  }
  return {
    schema: "harn.start_my_day.triage_feed.v1",
    generated_at: opts.generated_at,
    title: opts.title ?? "Start My Day",
    events: events,
    receipts: receipts,
  }
}
