 */
pub fn workflow_run(repo: string | dict, run_id: int | string, options: GitHubCallOptions = {}) {
  const r = __github_repo_or_throw(repo)
  return call("github.actions.run", {repo: r.full_name, run_id: run_id}, options)
}

/**
 * Package-compatible owner/repo alias for workflow_dispatch.
 *
 * @effects: []
 * @errors: []
 */
pub fn actions_workflow_dispatch(
  owner: string,
  repo: string,
  workflow_id: any,
  ref: string = "main",
  inputs: dict? = nil,
  options: GitHubCallOptions = {},
