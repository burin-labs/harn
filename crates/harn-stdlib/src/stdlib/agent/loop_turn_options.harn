import "std/agent/loop_foundation"
import "std/agent/loop_resource_dispatch"
import "std/agent/loop_result_status"
import "std/agent/loop_support"
import "std/agent/loop_tool_calls"
import { AgentStallState } from "std/agent/stall_types"

pub type AgentLoopCompletedDispatchStall = {state: AgentStallState, no_information_gain: bool}

/** Stable progress telemetry projected to agent lifecycle consumers. */
pub type AgentIterationInfo = {
  tool_count: int,
  text: string,
  provider: string,
  model: string,
  serving_base_url: string,
  serving_fingerprint?: string,
  cache_supported: bool,
  cache_read_tokens: int,
  cache_write_tokens: int,
  response_ms: int,
  client_first_frame_ms?: int,
  input_tokens: int,
  output_tokens: int,
  thinking_chars: int,
  cost_usd?: float,
  wall_clock_ms?: int,
  ...rest,
}

/**
 * Fold the two stall signals that become authoritative only after dispatch:
 * exact observation recurrence and completed read-only actuation.
 *
 * @effects: [agent]
 * @errors: [agent_loop]
 */
pub fn __agent_loop_completed_dispatch_stall(args: dict) -> AgentLoopCompletedDispatchStall {
  const results = __dispatch_results_list(args.dispatch)
  const completed = agent_stall_observe_completed_dispatch(
    args.harness.agent,
    args.session_id,
    args.tool_calls,
    args.dispatch,
    args.iteration,
    args.stall_config,
    args.stall_state,
    args.turn_opts?.tools,
    args.turn_opts?.policy,
  )
  const state = completed.state
    + {
      monologue_actuation: agent_monologue_actuation_observe_completed_dispatch(
        completed.state.monologue_actuation,
        args.stall_config.monologue_actuation,
        args.prior_read_streak,
        len(results) > 0
          && len(results) == len(args.tool_calls)
          && results.all({ result -> __tool_result_ok(result) })
          && agent_tool_calls_are_read_only(
            args.tool_calls,
            args.turn_opts?.tools,
            args.turn_opts?.policy,
          ),
      ),
    }
  return {state: state, no_information_gain: completed.no_information_gain}
}

pub fn __sync_tool_search_state(opts: any, turn_opts: dict) {
  let synced = opts
  if turn_opts?._tool_search_client != nil {
    synced = synced + {_tool_search_client: turn_opts._tool_search_client}
  }
  if turn_opts?._tool_batch_dependency_state != nil {
    synced = synced + {_tool_batch_dependency_state: turn_opts._tool_batch_dependency_state}
  }
  return synced
}

// A successful annotated workspace mutation advances the repair write epoch.
pub const __REPAIR_EDIT_KINDS = ["edit", "write", "scaffold", "delete", "mutation", "mutate"]

pub fn __turn_made_edit(dispatch: AgentToolDispatch?, tools: any) -> bool {
  if dispatch == nil {
    return false
  }
  for name in __tool_names_by_status(dispatch, true) {
    const entry = __tool_registry_entry(tools, name)
    const annotations = agent_tool_entry_annotations(entry)
    const kind = lowercase(
      to_string(annotations?.kind ?? annotations?.tool_kind ?? annotations?.toolKind ?? ""),
    )
    if contains(__REPAIR_EDIT_KINDS, kind) {
      return true
    }
  }
  return false
}

pub fn __agent_loop_verify_closure_exists(turn_opts: dict) -> bool {
  return turn_opts?.verify_completion != nil || turn_opts?.verify_completion_judge != nil
}

pub fn __agent_loop_post_edit_reverify_mandated(
  repair_cfg: dict,
  turn_opts: dict,
  stall_state: dict,
  dispatch: AgentToolDispatch,
  tools: dict,
) -> bool {
  const has_live_failure = stall_state.last_diagnostic_class == "fail" || stall_state.reverify_owed
  return repair_cfg.post_edit_reverify
    && __agent_loop_verify_closure_exists(turn_opts)
    && has_live_failure
    && __turn_made_edit(dispatch, tools)
}

// Terminal statuses the reserved-verify guard may intercept: a run that ran out
// of iteration/wall-clock/cost runway (`budget_exhausted`) or was stopped as a
// thrash (`stuck`). Other terminals (suspended / completion_unverified / scope_alert /
// done) are deliberate and must not be reinterpreted.
pub const __RESERVED_VERIFY_TERMINAL_STATUSES = ["budget_exhausted", "stuck"]

/**
 * __agent_loop_should_spend_reserve decides whether the reserved terminal-verify
 * guard should run a final verify(+repair) before the run terminates. It fires
 * ONLY when the guard is enabled, the run is terminating on a budget/stuck
 * boundary, the transcript still has an UNVERIFIED source write (the model
 * edited then ran out of runway without a passing verification), a
 * `verify_completion`/`verify_completion_judge` closure exists to run, and the
 * shared verify-attempt cap has not been hit. Default OFF: when
 * `reserved_terminal_verify` is false this always returns false, so behavior is
 * byte-identical to today. The `write_unverified` signal REUSES the existing
 * post-edit re-verify bookkeeping (it is true whenever a turn made a workspace
 * edit that no passing verification has cleared), the same notion the in-loop
 * `reverify_owed` mandate keys on. This is the budget-exit counterpart to the
 * loop-cap `iteration >= current_max` done-conversion (#3629), which only fires
 * when an in-loop reverify ALREADY confirmed green; this guard runs the verifier
 * on the terminal budget/stuck break where NO reverify fired. The guard verifies
 * first and only spends a reserve iteration on a repair turn when the verify
 * comes back red and reserve remains, so this predicate gates the verify.
 */
/**
 * Every terminal path must seal a NON-EMPTY, typed stop reason so downstream
 * forensics never has to infer a stop from an absent value (#4525). Several
 * inner breaks set `final_status` (e.g. "budget_exhausted") but leave
 * `stop_reason` unstamped; sealing `stop_reason ?? ""` then wrote an empty
 * string that read as "missing" to the eval completion-contract. Fall back to
 * the already-typed `final_status`; only a truly clean natural finish (both
 * empty) seals as "completed".
 *
 * @effects: [agent]
 * @errors: []
 */
pub fn __agent_loop_sealed_stop_reason(stop_reason: string?, final_status: string?) -> string {
  const explicit = to_string(stop_reason ?? "")
  if explicit != "" {
    return explicit
  }
  if to_string(final_status ?? "") != "" {
    return to_string(final_status)
  }
  return "completed"
}

pub fn __agent_loop_should_spend_reserve(
  repair_cfg: dict,
  turn_opts: dict,
  final_status: any,
  write_unverified: bool,
  made_source_write: bool,
  verify_allowed: bool,
) -> bool {
  const terminal = contains(__RESERVED_VERIFY_TERMINAL_STATUSES, final_status)
  const closure = __agent_loop_verify_closure_exists(turn_opts)
  // Existing case: an unverified source write ran out of runway.
  const write_path = repair_cfg.reserved_terminal_verify && write_unverified
  // #4525 case: a genuine ZERO-write terminal — no pending unverified write AND
  // nothing was ever written — so the completion gate (its `no_source_write`
  // rung) never got an evaluation pass before the run sealed. Default OFF: when
  // `zero_write_terminal_verify` is false this adds nothing and behavior is
  // byte-identical to today.
  const zero_write_path = repair_cfg.zero_write_terminal_verify
    && !write_unverified
    && !made_source_write
  return terminal && verify_allowed && closure && (write_path || zero_write_path)
}

pub fn __merge_tool_names(existing: list?, additions: list?) {
  let merged = existing ?? []
  const values = additions ?? []
  for name in values {
    if name != "" && !contains(merged, name) {
      merged = merged.appending(name)
    }
  }
  return merged
}

pub fn __merge_hook_dict(base: any, patch: any, label: string) {
  if patch == nil {
    return base
  }
  if type_of(patch) != "dict" {
    throw "agent_loop: post_turn_callback `" + label + "` must be a dict"
  }
  return base + patch
}

pub fn __strip_internal_keys(patch: unknown) {
  if patch == nil {
    return patch
  }
  if type_of(patch) != "dict" {
    return patch
  }
  let clean = {}
  for key in patch.keys() {
    if !starts_with(key, "_") {
      clean = clean + {[key]: patch[key]}
    }
  }
  return clean
}

pub fn __apply_post_turn_options(opts: any, outcome: dict) {
  let updated = opts
  const next_patch = __strip_internal_keys(outcome?.next_options)
  updated = __merge_hook_dict(updated, next_patch, "next_options")
  // Carry one typed tool claim into the immediately following turn. Always
  // assigned: after that turn's post-turn outcome, absence clears the claim,
  // including fallback and error-recovery completions.
  updated = updated + {_next_tool_claim: outcome?.next_tool_claim}
  const narrowing = outcome?.narrowing
  if narrowing != nil {
    updated = updated
      + {
        _tool_surface_narrowing_history: narrowing?.history ?? [],
        _tool_surface_narrowed_tools: narrowing?.narrowed_tools,
      }
  }
  const llm_patch = outcome?.llm_options
  if llm_patch != nil {
    if type_of(llm_patch) != "dict" {
      throw "agent_loop: post_turn_callback `llm_options` must be a dict"
    }
    const base_llm_options = updated?.llm_options ?? {}
    const route_patch_has_provider = contains(llm_patch.keys(), "provider")
    const route_patch_has_model = contains(llm_patch.keys(), "model")
    const route_patch_seen = route_patch_has_provider || route_patch_has_model
    updated = updated
      + {
        llm_options: base_llm_options + llm_patch,
        _agent_loop_last_llm_route_patch_seen: route_patch_seen,
        _agent_loop_last_llm_route_patch_complete: route_patch_has_provider
          && route_patch_has_model,
      }
  }
  return updated
}

pub fn __next_text_only_count(tool_count: int, consecutive_text_only: int) {
  if tool_count == 0 {
    return consecutive_text_only + 1
  }
  return 0
}

/**
 * "Turns since meaningful progress" — a decaying churn signal that, unlike
 * `__next_text_only_count`, does NOT fully reset on a single tool dispatch.
 * Meaningful progress = at least one SUCCESSFUL tool this turn (a mutating
 * or verify call that actually applied), not a rejected/no-op one. A turn
 * with no successful tool increments; a turn that made progress decays the
 * streak by one. This keeps mixed prose+tool churn (a successful call every
 * few turns interleaved with toolless narration) from evading the
 * escalating progress nudge the way the zeroing counter does.
 *
 * @effects: []
 * @errors: []
 */
pub fn __next_progress_count(made_progress: any, turns_since_progress: int) {
  if made_progress {
    return if turns_since_progress > 0 {
      turns_since_progress - 1
    } else {
      0
    }
  }
  return turns_since_progress + 1
}

/**
 * Escalating, depth-keyed copy for the toolless/no-progress churn nudge
 * (M1-1). Bounded: `__agent_loop_run` only invokes this below the hard
 * `max_nudges` stop, so it never nudges forever, and only when the
 * content-specific text-mode nudge (fence / missing-call recovery) did NOT fire
 * this turn — the content nudge takes precedence so a turn is never
 * double-injected; this streak nudge is the fallback for toolless churn.
 * Depth is `turns_since_progress`.
 *
 * @effects: []
 * @errors: []
 * @api_stability: experimental
 */
pub fn __loop_progress_nudge_text(
  depth: int,
  has_tools: any,
  paradigm: dict,
  made_tool_calls: bool = false,
) {
  const action = if has_tools {
    "Emit exactly one well-formed " + paradigm.call_noun + " now, or state your final answer "
      + paradigm.final_answer
      + " and stop."
  } else {
    "Make concrete progress in your reply now, or state your final answer and stop."
  }
  if depth >= 4 {
    // The "stuck in a narration loop / Do not restate the plan" framing is only
    // truthful when the recent turns were PURE PROSE. When the model IS issuing
    // real tool calls (edits/looks/searches/runs) but the loop's progress signal
    // still has not advanced, accusing it of narrating is wrong and unhelpful —
    // it is making changes that are not landing. Steer it to a DIFFERENT change
    // instead of telling it to stop narrating.
    if made_tool_calls {
      return "You have made no progress for "
        + to_string(depth)
        + " turns — your tool calls are not advancing the task. Stop repeating the same kind of change: re-read the failing output, target a DIFFERENT location, and make one concrete change. "
        + action
    }
    return "You have made no progress for "
      + to_string(depth)
      + " turns — you are stuck in a narration loop. "
      + action
      + " Do not restate the plan."
  }
  if depth >= 3 {
    return "Still no progress after "
      + to_string(depth)
      + " turns. "
      + action
  }
  return "No progress last turn. " + action
}

/**
 * Build the `iteration_info` payload for the `iteration_end` event from
 * the LLM result plus the loop's per-iteration aggregates. Carries `provider`,
 * `model`, `response_ms`, `client_first_frame_ms` (streamed calls only),
 * token and cache counts, and `thinking_chars` so live
 * pulse-check consumers (fleet hooks, ACP clients) can attribute
 * latency and surface "still working" indicators without re-parsing
 * the transcript JSONL. Empty/missing fields are dropped so the event
 * stays small for providers that don't report telemetry.
 *
 * @effects: []
 * @errors: []
 */
pub fn __iteration_info_payload(
  llm_result: dict,
  tool_count: int,
  visible_text: string,
  aggregates: dict? = nil,
) -> AgentIterationInfo {
  const telemetry = llm_result?.usage?.provider_telemetry ?? {}
  const thinking = llm_result?.thinking ?? ""
  const thinking_chars = if type_of(thinking) == "string" {
    len(thinking)
  } else {
    0
  }
  const extra = aggregates ?? {}
  // Absence stays absent: an unreported serving fingerprint must not read as
  // an empty build id that compares equal across two different servers.
  const serving_fingerprint = telemetry?.serving_fingerprint
  const serving_identity = if type_of(serving_fingerprint) == "string" {
    {serving_fingerprint: serving_fingerprint}
  } else {
    {}
  }
  // Same absence rule, for the same reason: a streamed call reports how long
  // the first provider frame took, and a single-shot call has no first frame.
  // Defaulting to 0 would make "not streamed" read as "arrived instantly".
  const first_frame_ms = telemetry?.client_first_frame_ms
  const first_frame_latency = if type_of(first_frame_ms) == "int" {
    {client_first_frame_ms: first_frame_ms}
  } else {
    {}
  }
  return {
    tool_count: tool_count,
    text: visible_text,
    provider: llm_result?.provider ?? "",
    model: llm_result?.model ?? "",
    serving_base_url: telemetry?.serving_base_url ?? "",
    cache_supported: llm_result?.usage?.cache_supported ?? false,
    cache_read_tokens: llm_result?.usage?.cache_read_tokens ?? 0,
    cache_write_tokens: llm_result?.usage?.cache_write_tokens ?? 0,
    response_ms: telemetry?.client_wall_ms ?? 0,
    input_tokens: llm_result?.usage?.input_tokens ?? 0,
    output_tokens: llm_result?.usage?.output_tokens ?? 0,
    thinking_chars: thinking_chars,
  }
    + serving_identity
    + first_frame_latency
    + extra
}

pub fn __agent_loop_elapsed_ms(clock: HarnessClock, start_ms: any) {
  const elapsed = __agent_loop_clock_now_ms(clock) - start_ms
  if elapsed < 0 {
    return 0
  }
  return elapsed
}

pub fn __agent_loop_cost_usd(totals: dict) {
  const value = to_float(totals?.cost_usd ?? 0.0)
  if value == nil {
    return 0.0
  }
  return value
}

pub fn __agent_loop_budget_aggregates(
  agent: HarnessAgent,
  clock: HarnessClock,
  session_id: any,
  totals: any,
  loop_start_ms: any,
) {
  const resolved_totals = totals ?? agent_session_totals(agent, session_id)
  return {
    cost_usd: __agent_loop_cost_usd(resolved_totals),
    known_cost_usd: to_float(resolved_totals?.known_cost_usd ?? 0.0) ?? 0.0,
    unpriced_calls: to_int(resolved_totals?.unpriced_calls ?? 0) ?? 0,
    usage_unknown_calls: to_int(resolved_totals?.usage_unknown_calls ?? 0) ?? 0,
    wall_clock_ms: __agent_loop_elapsed_ms(clock, loop_start_ms),
  }
}

pub fn __agent_loop_iteration_info(
  agent: HarnessAgent,
  clock: HarnessClock,
  session_id: any,
  llm_result: dict,
  tool_count: int,
  visible_text: string,
  totals: any,
  loop_start_ms: any,
) {
  return __iteration_info_payload(
    llm_result,
    tool_count,
    visible_text,
    __agent_loop_budget_aggregates(agent, clock, session_id, totals, loop_start_ms),
  )
}

pub fn __agent_loop_budget_exhaustion(
  agent: HarnessAgent,
  clock: HarnessClock,
  session_id: any,
  budget: dict,
  iteration: any,
  totals: any,
  loop_start_ms: any,
  max_iterations: any,
) {
  const aggregates = __agent_loop_budget_aggregates(agent, clock, session_id, totals, loop_start_ms)
  if budget?.wall_clock_ms != nil && aggregates.wall_clock_ms >= budget.wall_clock_ms {
    return aggregates
      + {exhausted: true, kind: "wall_clock", iteration: iteration, max_iterations: max_iterations}
  }
  if budget?.total_cost_usd != nil
    && (aggregates.unpriced_calls > 0
      || aggregates.cost_usd
        >= budget.total_cost_usd) {
    return aggregates
      + {exhausted: true, kind: "total_cost", iteration: iteration, max_iterations: max_iterations}
  }
  return aggregates
    + {exhausted: false, kind: "", iteration: iteration, max_iterations: max_iterations}
}

pub fn __agent_loop_emit_budget_exhausted(
  agent: HarnessAgent,
  session_id: any,
  exhaustion: dict,
  projection: dict = {},
) {
  agent_emit_event(
    agent,
    session_id,
    "budget_exhausted",
    {
      kind: exhaustion?.kind ?? "budget_exhausted",
      max_iterations: exhaustion?.max_iterations ?? 0,
      iteration: exhaustion?.iteration ?? 0,
      cost_usd: exhaustion?.cost_usd ?? 0.0,
      wall_clock_ms: exhaustion?.wall_clock_ms ?? 0,
    }
      + projection,
  )
}

/**
 * Keep the safe, typed pre-call budget projection attached to its terminal
 * event. Provider prose is excluded; the full error remains on AgentResult.
 *
 * @effects: []
 * @errors: []
 */
pub fn __agent_loop_budget_error_projection(error: unknown) -> dict {
  if type_of(error) != "dict" {
    return {}
  }
  const category = to_string(error?.category ?? "")
  const reason = to_string(error?.reason ?? "")
  if category != "budget_exceeded" && reason != "budget_exceeded" {
    return {}
  }
  const limit = to_string(error?.limit ?? "")
  if limit == "" {
    return {}
  }
  return {
    limit: limit,
    limit_value: error?.limit_value,
    projected_cost_usd: error?.projected_cost_usd,
    session_cost_usd: error?.session_cost_usd,
    projected_input_tokens: error?.projected_input_tokens,
    projected_output_tokens: error?.projected_output_tokens,
    projection_basis: error?.projection_basis,
    headroom_usd: error?.headroom_usd,
    provider: error?.provider,
    model: error?.model,
  }
}

pub fn __agent_loop_record_budget_stop(
  decisions: list,
  iteration: any,
  current_max: any,
  reason: any,
) {
  return decisions.appending(
    {
      iteration: iteration,
      action: "stop",
      old_limit: current_max,
      new_limit: current_max,
      reason: reason,
      status: "budget_exhausted",
    },
  )
}

pub fn __stall_judge_opts(
  turn_opts: dict,
  completion_judge_invocations: int,
  done_judge_invocations: int,
) -> dict {
  return turn_opts
    + {
      _done_judge_due: true,
      _done_judge_trigger: "stalled",
      _done_judge_invocations: done_judge_invocations,
      _verify_completion_judge_trigger: "stalled",
      _verify_completion_judge_invocations: completion_judge_invocations,
      _defer_judge_feedback: true,
    }
}

pub fn __done_judge_hit(verdict: dict) -> int {
  if verdict?.receipt?.invoked?.done_judge ?? false {
    return 1
  }
  return 0
}

pub fn __completion_judge_hit(verdict: dict) -> int {
  if verdict?.receipt?.invoked?.verify_completion_judge ?? false {
    return 1
  }
  return 0
}

/**
 * Whether a completion directive was decided by an adjudicator that actually
 * ran, rather than by the absence of one.
 *
 * `agent_evaluate_completion` plans zero stages when a run configures no
 * `verify_completion` callback and no judge, and a zero-stage evaluation is not
 * vetoed, so `__judge_directive` seals `accept`. That accept is vacuous: it
 * reports that nothing objected, not that anything approved. A caller that
 * converts a terminal on the strength of it would promote every unadjudicated
 * stop to a completion. The receipt's `invoked` map is the honest signal —
 * consult it before treating `accept` as an approval.
 *
 * @effects: []
 * @errors: []
 * @api_stability: experimental
 * @example: __completion_directive_adjudicated(verdict)
 */
pub fn __completion_directive_adjudicated(verdict: dict) -> bool {
  const invoked = verdict?.receipt?.invoked
  return (invoked?.deterministic ?? false)
    || (invoked?.verify_completion_judge ?? false)
    || (invoked?.done_judge ?? false)
}

pub fn __completion_stop_reason(verdict: dict) -> string {
  if verdict?.action == "stop_unverified" {
    return to_string(verdict?.receipt?.reason ?? "completion_unverified")
  }
  return ""
}

pub fn __close_stall_calls(
  agent: HarnessAgent,
  session_id: any,
  tool_calls: any,
  reason: string,
) -> nil {
  agent_session_record_undispatched_tool_results(
    agent,
    session_id,
    tool_calls,
    "skipped",
    "not dispatched: stall judge " + reason,
  )
  return nil
}

pub fn __agent_loop_apply_stall_judge_veto(
  agent: HarnessAgent,
  clock: HarnessClock,
  session_id: any,
  tool_calls: any,
  stall_verdict: dict,
  stall_observation: dict,
  stall_warning: any,
  stall_state: any,
  llm_result: dict,
  visible_text: string,
  turn_llm_opts: any,
  iteration: any,
  loop_start_ms: any,
) -> AgentStallState {
  const recovery = trim(to_string(stall_verdict?.feedback ?? ""))
  if len(tool_calls) > 0 {
    agent_session_record_undispatched_tool_results(
      agent,
      session_id,
      tool_calls,
      "skipped",
      "not dispatched: stall judge requested a different recovery step",
    )
  }
  let next_stall_state = stall_state
  if recovery != "" {
    agent_feedback_emit(
      agent,
      session_id,
      [
        {
          kind: "verify_completion",
          content: recovery,
          source: stall_verdict?.trigger ?? "completion_judge",
          reason: "stall_judge_veto",
          action: "continue",
          next_step: stall_verdict?.repair ?? "",
        },
      ],
    )
  } else if stall_observation.feedback_deferred {
    next_stall_state = agent_stall_inject_feedback(
      agent,
      session_id,
      stall_warning,
      stall_observation.config,
      stall_state,
    )
  }
  const totals = agent_session_record_usage(agent, session_id, llm_result, turn_llm_opts, iteration)
  agent_emit_event(
    agent,
    session_id,
    "iteration_end",
    {
      iteration: iteration,
      iteration_info: __agent_loop_iteration_info(
        agent,
        clock,
        session_id,
        llm_result,
        len(tool_calls),
        visible_text,
        totals,
        loop_start_ms,
      )
        + {dispatch_skipped: true, skip_reason: "stall_judge_continue"},
    },
  )
  return next_stall_state
}

pub fn __agent_loop_record_terminal_callback_continue(
  decisions: list,
  iteration: any,
  old_limit: any,
  new_limit: any,
) {
  return decisions.appending(
    {
      iteration: iteration,
      action: "extend",
      old_limit: old_limit,
      new_limit: new_limit,
      reason: "terminal_callback_continue",
      status: "",
    },
  )
}

pub fn __agent_loop_state_budget_fields(
  agent: HarnessAgent,
  clock: HarnessClock,
  session_id: any,
  totals: any,
  loop_start_ms: any,
  budget: dict,
  consecutive_failure_count: any,
) {
  const aggregates = __agent_loop_budget_aggregates(agent, clock, session_id, totals, loop_start_ms)
  const failure_config = __agent_loop_consecutive_failure_config(budget)
  return {
    wall_clock_ms: aggregates.wall_clock_ms,
    wall_clock_limit_ms: budget?.wall_clock_ms,
    cost_usd: aggregates.cost_usd,
    total_cost_limit_usd: budget?.total_cost_usd,
    consecutive_failures: consecutive_failure_count,
    consecutive_failure_limit: failure_config?.max,
  }
}

pub fn __agent_loop_failure_matches_kind(error: unknown, wanted: string) {
  const category = to_string(error?.category ?? "")
  const reason = to_string(error?.reason ?? "")
  const kind = to_string(error?.kind ?? "")
  const status = to_int(error?.status ?? error?.status_code ?? 0) ?? 0
  if wanted == "transient" {
    return kind == "transient" || category == "transient_network" || category == "timeout"
      || reason
        == "timeout"
  }
  if wanted == "rate_limit" {
    return kind == "rate_limit" || category == "rate_limit" || category == "rate_limited"
      || reason
        == "rate_limit"
      || status == 429
  }
  if wanted == "provider_5xx" {
    return kind == "provider_5xx" || category == "server_error" || category == "overloaded"
      || reason
        == "server_error"
      || (status >= 500 && status < 600)
  }
  return category == wanted || reason == wanted || kind == wanted
}

pub fn __agent_loop_consecutive_failure_config(budget: dict) {
  const config = budget?.consecutive_failures
  if type_of(config) != "dict" {
    return nil
  }
  return config
}

pub fn __agent_loop_tracks_failure(error: unknown, config: dict?) {
  if config == nil {
    return false
  }
  for kind in config?.kinds ?? ["transient", "rate_limit", "provider_5xx"] {
    if __agent_loop_failure_matches_kind(error, kind) {
      return true
    }
  }
  return false
}

pub fn __agent_loop_is_escalation_transport_failure(error: unknown) {
  const status = to_int(error?.status ?? error?.status_code ?? 0) ?? 0
  if status >= 400 && status < 500 && status != 429 {
    return false
  }
  const category = to_string(error?.category ?? "")
  const reason = to_string(error?.reason ?? "")
  const kind = to_string(error?.kind ?? "")
  if category == "circuit_open" || reason == "circuit_open" || kind == "circuit_open" {
    return true
  }
  return __agent_loop_failure_matches_kind(error, "transient")
    || __agent_loop_failure_matches_kind(error, "rate_limit")
    || __agent_loop_failure_matches_kind(error, "provider_5xx")
}

pub fn __agent_loop_transport_abort_error(error: unknown) {
  if type_of(error) == "dict" {
    return error + {escalation_aborted_provider_transport: true}
  }
  return {message: to_string(error), escalation_aborted_provider_transport: true}
}

/**
 * Surface a NON-tracked provider failure as an observable event instead of a
 * silent `break`. Mirrors the tracked-failure branch's `iteration_end` event
 * so any provider_error (including a fast pre-dispatch escalation failure) is
 * always visible in the transcript, carrying the provider/model/status/error
 * that caused it. The dispatch_skipped/skip_reason shape matches the tracked
 * branch so existing consumers parse it uniformly.
 *
 * @effects: [agent]
 * @errors: []
 */
pub fn __agent_loop_emit_provider_error(
  agent: HarnessAgent,
  clock: HarnessClock,
  session_id: string,
  iteration_index: int,
  call: dict,
  llm_opts: dict,
  loop_start_ms: any,
  escalation_fallback: any,
  skip_reason_override: string,
) {
  const aggregates = __agent_loop_budget_aggregates(agent, clock, session_id, nil, loop_start_ms)
  const skip_reason = if skip_reason_override != "" {
    skip_reason_override
  } else if escalation_fallback {
    "escalation_provider_failure"
  } else {
    "provider_failure"
  }
  agent_emit_event(
    agent,
    session_id,
    "iteration_end",
    {
      iteration: iteration_index + 1,
      iteration_info: aggregates
        + {
          dispatch_skipped: true,
          skip_reason: skip_reason,
          provider_error: call?.error ?? {},
          provider: to_string(llm_opts?.provider ?? ""),
          model: to_string(llm_opts?.model ?? ""),
          provider_status: to_string(call?.status ?? ""),
          provider_error_message: to_string(call?.error?.message ?? call?.error ?? ""),
          consecutive_failures: 0,
          escalation_fallback: escalation_fallback,
          escalation_transport_abort: skip_reason == "escalation_aborted_provider_transport",
        },
    },
  )
}

/**
 * Mode filter table for `agent_stage`. Each row encodes the
 * invariant for one seam: which bridge modes are eligible to drain, and
 * whether the host should pull the agent_inbox feedback queue.
 *
 *   iteration_start, post_tool_dispatch, iteration_end → drain `interrupt_immediate`
 *     and `finish_step`; the model will see whatever lands on its next
 *     prompt build, so both modes get the same opportunity here.
 *   pre_tool_dispatch → drain `interrupt_immediate` only. This is the
 *     "stop before the tool fires" seam — `finish_step` semantics
 *     would defeat the point (it means "after the current tool batch").
 *     If anything arrives, the caller skips the pending tool batch.
 *   pre_compact, post_compact → bracket the compactor with an
 *     agent_inbox drain so async producers (tool completions, MCP
 *     notifications, command-policy feedback) land in the transcript
 *     before the summarizer sees it and the next prompt is built.
 *   daemon_idle_pre, daemon_idle_post → drain `interrupt_immediate`
 *     only; the daemon path doesn't queue `finish_step`-mode injections.
 *   loop_exit → drain `audit_only`. The other two modes were already
 *     drained earlier in the loop body. `audit_only` reminders land in
 *     the transcript at this seam but are NEVER rendered into a model
 *     prompt — no further LLM call runs after `loop_exit` (harn#2212).
 *     Hosts that need the model to see a reminder before the agent
 *     terminates must use `finish_step` (drained at every iteration
 *     boundary, including the last `iteration_end` before the loop breaks).
 *
 * @effects: [agent]
 * @errors: []
 */
pub type AgentStage = "iteration_start" \
  | "pre_compact" \
  | "post_compact" \
  | "pre_tool_dispatch" \
  | "post_tool_dispatch" \
  | "iteration_end" \
  | "command_hold" \
  | "daemon_idle_pre" \
  | "daemon_idle_post" \
  | "loop_exit"

pub type AgentStageInput = {iteration?: int, mock_queue?: dict}

pub type AgentStageResult = {
  delivered: int,
  inbox_delivered: int,
  typed_delivered: int,
  dispatch_skipped: bool,
  kind: AgentStage,
}

pub fn __agent_stage_modes(kind: AgentStage) {
  if kind == "pre_tool_dispatch" || kind == "daemon_idle_pre" || kind == "daemon_idle_post" {
    return {
      immediate: true,
      finish_step: false,
      audit_only: false,
      inbox: false,
      typed_delivery: nil,
    }
  }
  if kind == __AGENT_LOOP_CHECKPOINT_ITERATION_START
    || kind
      == __AGENT_LOOP_CHECKPOINT_POST_TOOL_DISPATCH
    || kind == "iteration_end" {
    const typed_delivery = if kind == __AGENT_LOOP_CHECKPOINT_ITERATION_START {
      __AGENT_LOOP_HOST_INJECTION_TURN_BOUNDARY
    } else if kind == __AGENT_LOOP_CHECKPOINT_POST_TOOL_DISPATCH {
      __AGENT_LOOP_HOST_INJECTION_AFTER_NEXT_TOOL_CALL
    } else {
      nil
    }
    return {
      immediate: true,
      finish_step: true,
      audit_only: false,
      inbox: false,
      typed_delivery: typed_delivery,
    }
  }
  if kind == "pre_compact" || kind == "post_compact" {
    return {
      immediate: false,
      finish_step: false,
      audit_only: false,
      inbox: true,
      typed_delivery: nil,
    }
  }
  if kind == "command_hold" {
    // The command-hold seam: the loop parked on `agent_session_await_inbox`
    // while awaited command handles were live and re-entered the model with
    // one coalesced `command_status` digest. No drains here — the hold owns
    // command-update consumption via `agent_session_drain_command_updates`,
    // and its wake set is inclusive, so a user interrupt / peer message flows
    // through the normal drains at the following `iteration_start`. This row
    // exists so the checkpoint is a canonical, replayable transcript event.
    return {
      immediate: false,
      finish_step: false,
      audit_only: false,
      inbox: false,
      typed_delivery: nil,
    }
  }
  if kind == "loop_exit" {
    return {
      immediate: false,
      finish_step: false,
      audit_only: true,
      inbox: false,
      typed_delivery: nil,
    }
  }
  return {
    immediate: false,
    finish_step: false,
    audit_only: false,
    inbox: false,
    typed_delivery: nil,
  }
}

/**
 * Single HarnessAgent seam for every typed stage in the loop.
 * Every drain site in the agent loop body and the daemon idle path
 * routes through here so plugin authors and replayers see one canonical
 * event (`LoopCheckpoint`) instead of having to enumerate inline calls.
 *
 * Returns a result dict carrying `delivered` (bridge injections drained
 * at this seam), `inbox_delivered` (inbox feedback notes drained), and
 * `dispatch_skipped` (`pre_tool_dispatch` short-circuit: an
 * `interrupt_immediate` arrival here means the pending tool batch is
 * cancelled and the loop iterates once more so the LLM sees the
 * injection before the tool would have fired). Callers branch on
 * `delivered` for the "continue if a steer arrived" behavior the
 * stalled-done-judge and post-turn paths rely on.
 *
 * @effects: [host, agent]
 * @errors: []
 */
pub fn agent_stage(
  agent: HarnessAgent,
  session_id: string,
  kind: AgentStage,
  input: AgentStageInput? = nil,
) -> AgentStageResult {
  const opts = input ?? {}
  const modes = __agent_stage_modes(kind)
  let delivered = 0
  if modes.immediate {
    const result = agent_session_drain_bridge_injections(agent, session_id, "interrupt_immediate")
    delivered = delivered + (result?.delivered ?? 0)
  }
  const immediate_count = delivered
  if modes.finish_step {
    const result = agent_session_drain_bridge_injections(agent, session_id, "finish_step")
    delivered = delivered + (result?.delivered ?? 0)
  }
  if modes.audit_only {
    const result = agent_session_drain_bridge_injections(agent, session_id, "audit_only")
    delivered = delivered + (result?.delivered ?? 0)
  }
  let typed_delivered = 0
  if modes.typed_delivery != nil {
    const pending = agent_session_drain_host_injections(
      agent,
      session_id,
      modes.typed_delivery,
      kind,
    )
    typed_delivered = len(pending ?? [])
  }
  let inbox_delivered = 0
  if modes.inbox {
    const pending = agent_session_drain_feedback(agent, session_id)
    for note in pending {
      agent_session_inject_feedback(agent, session_id, note.kind, note.content)
      inbox_delivered = inbox_delivered + 1
    }
  }
  const dispatch_skipped = kind == "pre_tool_dispatch" && immediate_count > 0
  let iteration = to_int(opts?.iteration ?? 0)
  agent_emit_event(
    agent,
    session_id,
    "loop_checkpoint",
    {
      iteration: iteration,
      kind: kind,
      delivered: delivered,
      inbox_delivered: inbox_delivered,
      typed_delivered: typed_delivered,
      dispatch_skipped: dispatch_skipped,
    },
  )
  if kind == "iteration_end" && opts?.mock_queue != nil {
    const mock_queue = opts.mock_queue
    if mock_queue.schema_version > 0 || len(keys(mock_queue.queue_remaining)) > 0 {
      agent_emit_event(
        agent,
        session_id,
        "typed_checkpoint",
        mock_queue + {kind: "llm_mock_queue", iteration: iteration},
      )
    }
  }
  __host_fire_session_hook(
    "loop_checkpoint",
    {
      session_id: session_id,
      iteration: iteration,
      kind: kind,
      delivered: delivered,
      inbox_delivered: inbox_delivered,
      typed_delivered: typed_delivered,
      dispatch_skipped: dispatch_skipped,
    },
  )
  return {
    delivered: delivered,
    inbox_delivered: inbox_delivered,
    typed_delivered: typed_delivered,
    dispatch_skipped: dispatch_skipped,
    kind: kind,
  }
}

pub fn __agent_loop_fire_resume_continuity(agent: HarnessAgent, session: dict, opts: dict) {
  const payload = opts?._resume_continuity
  if type_of(payload) != "dict" {
    return opts
  }
  let _ = agent_reminder_providers_fire(
    agent,
    session.session_id,
    "worker_resumed",
    payload
      + {
        session_id: session.session_id,
        session: {id: session.session_id},
        turn: payload?.turn ?? 0,
        iteration: payload?.iteration ?? 0,
      },
    opts,
  )
  return omit(opts, ["_resume_continuity"])
}

/**
 * Construct one loop turn's direct caller options after visible projection.
 *
 * @effects: []
 * @errors: []
 * @api_stability: internal
 */
pub fn agent_direct_llm_options(
  turn_llm_opts: dict,
  turn_prompt: dict,
  session_id: any,
  iteration: any,
) -> dict {
  return turn_llm_opts
    + {
      messages: turn_prompt.messages,
      session_id: session_id,
      tool_format: turn_llm_opts.tool_format,
      _directives_rendered: true,
      _iteration: iteration,
      _call_stage: "work",
      _system_fragments: turn_prompt.fragments,
    }
}
