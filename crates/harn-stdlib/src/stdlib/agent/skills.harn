import {
  agent_session_active_skills,
  agent_session_record_skill_event,
  agent_session_set_active_skills,
  agent_session_visible_messages,
} from "std/agent/state"

fn __skills_registry(opts: dict) {
  const registry = opts?.skill_registry ?? opts?.skills
  if type_of(registry) == "list" {
    return {_type: "skill_registry", skills: registry}
  }
  return registry
}

fn __skills_entries(registry: dict?) {
  if registry == nil {
    return []
  }
  return registry?.skills ?? []
}

fn __skill_id(entry: dict?) {
  return entry?.id ?? entry?.name ?? ""
}

fn __skill_find(registry: dict, id: any) {
  for entry in __skills_entries(registry) {
    if __skill_id(entry) == id {
      return entry
    }
  }
  return nil
}

fn __skill_ids(entries: list) {
  let ids = []
  for entry in entries {
    const id = __skill_id(entry)
    if id != "" {
      ids = ids.appending(id)
    }
  }
  return ids
}

fn __tool_registry_has(registry: dict, name: string) {
  if type_of(registry) != "dict" {
    return false
  }
  for tool_entry in registry?.tools ?? [] {
    if __tool_name(tool_entry) == name {
      return true
    }
  }
  return false
}

fn __render_loaded_skill(agent: HarnessAgent, entry: dict, request: dict, session_id: any) {
  const rendered = try {
    agent.skill_render(entry, request?.arguments ?? request?.args ?? [], {session_id: session_id})
  }
  if !is_err(rendered) {
    const body = trim(unwrap(rendered))
    if body != "" {
      return body
    }
  }
  let out = "### " + __skill_id(entry) + "\n"
  const description = trim(entry?.description ?? "")
  if description != "" {
    out = out + description + "\n"
  }
  const when_to_use = trim(entry?.when_to_use ?? "")
  if when_to_use != "" {
    out = out + "When to use: " + when_to_use + "\n"
  }
  const allowed = entry?.allowed_tools ?? []
  if len(allowed) > 0 {
    out = out + "Scoped tools: " + join(allowed, ", ") + "\n"
  }
  const prompt = trim(entry?.prompt ?? "")
  if prompt != "" {
    out = out + "\n" + prompt + "\n"
  }
  return trim(out)
}

fn __load_skill_for_session(agent: HarnessAgent, session: dict, opts: dict, args: any) {
  const request = if type_of(args) == "dict" {
    args
  } else {
    {name: args}
  }
  const registry = __skills_registry(opts)
  const id = request?.name ?? ""
  const entry = __skill_find(registry, id)
  const require_signature = (request?.require_signature ?? false)
    || (entry?.require_signature ?? false)
  if entry == nil || require_signature {
    return agent.load_skill(request + {session_id: session.session_id})
  }
  if __skill_model_invocation_disabled(entry) {
    throw "skill_model_invocation_disabled: skill '" + id + "' cannot be loaded by a model"
  }
  const loaded = try {
    agent.load_skill(request + {session_id: session.session_id})
  }
  const body = if is_err(loaded) {
    __render_loaded_skill(agent, entry, request, session.session_id)
  } else {
    unwrap(loaded)
  }
  if entry != nil {
    const prev = __active_from_ids(
      registry,
      agent_session_active_skills(agent, session.session_id) ?? [],
    )
    let next = prev
    if !contains(__skill_ids(prev), id) {
      next = next.appending(entry + {id: id, score: 1.0, trigger: "load_skill"})
      __record_activations(agent, session, prev, next, 0)
      agent_session_set_active_skills(agent, session.session_id, next)
    }
  }
  return body
}

fn __with_load_skill_tool(agent: HarnessAgent, session: dict, opts: dict) {
  const existing = opts?.tools
  const registry = if type_of(existing) == "dict" {
    existing
  } else {
    tool_registry()
  }
  if __tool_registry_has(registry, "load_skill") {
    return opts + {tools: registry}
  }
  const next_registry = tool_define(
    registry,
    "load_skill",
    "Load the full instructions for a skill from the active skill catalog",
    {
      parameters: {
        name: {type: "string", description: "Skill id from the catalog"},
        require_signature: {
          type: "boolean",
          description: "Reject the skill unless provenance shows a trusted signature",
          required: false,
        },
      },
      handler: { args -> __load_skill_for_session(agent, session, opts, args) },
    },
  )
  return opts + {tools: next_registry}
}

fn __skills_same_ids(prev: list, next: list) {
  const prev_ids = __skill_ids(prev)
  const next_ids = __skill_ids(next)
  if len(prev_ids) != len(next_ids) {
    return false
  }
  for (index, id) in iter(next_ids).enumerate() {
    if prev_ids[index] != id {
      return false
    }
  }
  return true
}

fn __active_from_ids(registry: dict, ids: list) {
  let active = []
  for item in ids {
    const id = item?.id ?? item?.name ?? item
    const entry = __skill_find(registry, id)
    if entry != nil {
      active = active.appending(entry + {id: id})
    }
  }
  return active
}

type ContextProfileSkillBinding = {skill_id: string, tool_group: string}

fn __context_profile(opts: dict) -> dict {
  return opts?.context_profile ?? opts?.project_context_profile ?? {}
}

fn __served_tool_groups(opts: dict) -> list<string> {
  let groups: list<string> = []
  for tool_entry in opts?.tools?.tools ?? [] {
    const namespace = __tool_namespace(tool_entry)
    if namespace != "" && !contains(groups, namespace) {
      groups = groups.appending(namespace)
    }
  }
  return groups
}

fn __context_profile_skill_bindings(opts: dict) -> list<ContextProfileSkillBinding> {
  const served_groups = __served_tool_groups(opts)
  let bindings: list<ContextProfileSkillBinding> = []
  for profile in __context_profile(opts)?.profiles ?? [] {
    for tool_group in profile?.tool_groups ?? [] {
      if !contains(served_groups, tool_group) {
        continue
      }
      for skill_id in profile?.skills ?? [] {
        bindings = bindings.appending({skill_id: skill_id, tool_group: tool_group})
      }
    }
  }
  return bindings
}

fn __active_from_context_profile(registry: dict, opts: dict) {
  let active = []
  for binding in __context_profile_skill_bindings(opts) {
    const entry = __skill_find(registry, binding.skill_id)
    if entry != nil && !contains(__skill_ids(active), binding.skill_id) {
      active = active.appending(
        entry
          + {
            id: binding.skill_id,
            score: 1.0,
            trigger: "served_tool_group",
            tool_group: binding.tool_group,
          },
      )
    }
  }
  return active
}

fn __merge_active_skills(left: list?, right: list?) {
  let active = left ?? []
  let ids = __skill_ids(active)
  for entry in right ?? [] {
    const id = __skill_id(entry)
    if id != "" && !contains(ids, id) {
      active = active.appending(entry)
      ids = ids.appending(id)
    }
  }
  return active
}

fn __latest_user_text(agent: HarnessAgent, session: dict) {
  let latest = session?.task ?? ""
  for message in agent_session_visible_messages(agent, session.session_id) {
    if message?.role == "user" {
      latest = message?.content ?? latest
    }
  }
  return latest
}

fn __match_config(opts: dict) {
  return opts?.skill_match ?? {}
}

fn __match_strategy(opts: dict) {
  return __match_config(opts)?.strategy ?? "catalog"
}

fn __match_strategy_manual(opts: dict) {
  const strategy = __match_strategy(opts)
  return strategy == "manual" || strategy == "none"
}

fn __match_top_n(opts: dict) {
  const value = __match_config(opts)?.top_n
  if type_of(value) == "int" && value > 0 {
    return value
  }
  return 1
}

fn __match_sticky(opts: dict) {
  const value = __match_config(opts)?.sticky
  if type_of(value) == "bool" {
    return value
  }
  return true
}

fn __skill_catalog_limit(opts: dict) {
  const value = __match_config(opts)?.catalog_limit ?? opts?.skill_catalog_limit ?? 12
  if type_of(value) == "int" && value > 0 {
    return value
  }
  return 12
}

fn __skill_catalog_budget(opts: dict) {
  const value = __match_config(opts)?.catalog_budget ?? opts?.skill_catalog_budget ?? 2000
  if type_of(value) == "int" && value > 0 {
    return value
  }
  return 2000
}

fn __skill_catalog_always(opts: dict) {
  const value = __match_config(opts)?.catalog_always ?? opts?.skill_catalog_always
  if type_of(value) == "bool" {
    return value
  }
  return false
}

fn __skill_catalog_prompt(registry: dict, opts: dict, active: list?) {
  if __match_strategy(opts) != "catalog" {
    return ""
  }
  if len(active ?? []) > 0 && !__skill_catalog_always(opts) {
    return ""
  }
  const entries = skills_catalog_entries(
    {_type: "skill_registry", skills: __matchable_skill_entries(registry)},
  )
  if len(entries) == 0 {
    return ""
  }
  return render_always_on_catalog(
    entries.take(__skill_catalog_limit(opts)),
    __skill_catalog_budget(opts),
  )
}

fn __skill_model_invocation_disabled(entry: dict?) {
  return (entry?.["disable-model-invocation"] ?? false)
    || (entry?.disable_model_invocation ?? false)
}

fn __matchable_skill_entries(registry: dict) {
  let entries = []
  for entry in __skills_entries(registry) {
    if !__skill_model_invocation_disabled(entry) {
      entries = entries.appending(entry)
    }
  }
  return entries
}

fn __skill_score_stop_words() {
  return [
    "able",
    "about",
    "add",
    "after",
    "all",
    "and",
    "any",
    "are",
    "ask",
    "can",
    "clean",
    "code",
    "create",
    "does",
    "file",
    "for",
    "from",
    "has",
    "have",
    "how",
    "into",
    "its",
    "make",
    "more",
    "need",
    "not",
    "one",
    "only",
    "other",
    "read",
    "run",
    "space",
    "task",
    "test",
    "that",
    "the",
    "then",
    "this",
    "tool",
    "use",
    "user",
    "when",
    "with",
    "work",
    "write",
    "you",
    "your",
  ]
}

fn __skill_score_tokens(text: string?) {
  const normalized = regex_replace("[^A-Za-z0-9]+", " ", lowercase(to_string(text ?? "")))
  const stop_words = __skill_score_stop_words()
  let out = []
  for raw in split(trim(normalized), " ") {
    const token = trim(raw)
    if len(token) > 2 && !contains(stop_words, token) && !contains(out, token) {
      out = out.appending(token)
    }
  }
  return out
}

fn __skill_score_term_hits(query_tokens: list, text: string?) {
  const haystack_tokens = __skill_score_tokens(text)
  let hits = 0
  for token in query_tokens {
    if contains(haystack_tokens, token) {
      hits = hits + 1
    }
  }
  return hits
}

fn __skill_score_id_match(query_tokens: string | list, id: string?) {
  const id_tokens = __skill_score_tokens(id)
  if len(id_tokens) == 0 {
    return false
  }
  for token in id_tokens {
    if !contains(query_tokens, token) {
      return false
    }
  }
  return true
}

fn __skill_score_glob_match(pattern: string?, path: string?) {
  const glob = to_string(pattern ?? "")
  const value = to_string(path ?? "")
  if glob == "" || value == "" {
    return false
  }
  if glob == value {
    return true
  }
  if !contains(glob, "*") {
    return false
  }
  const parts = split(glob, "*")
  let cursor = 0
  for (index, part) in iter(parts).enumerate() {
    if part == "" {
      continue
    }
    const rest = substring(value, cursor)
    const offset = rest.index_of(part)
    if offset < 0 {
      return false
    }
    if index == 0 && !starts_with(glob, "*") && offset != 0 {
      return false
    }
    cursor = cursor + offset + len(part)
  }
  const last = parts[len(parts) - 1]
  return last == "" || ends_with(value, last)
}

fn __skill_score_path_hits(patterns: list?, working_files: list?) {
  let hits = 0
  for pattern in patterns ?? [] {
    for file in working_files ?? [] {
      if __skill_score_glob_match(pattern, file) {
        hits = hits + 1
        break
      }
    }
  }
  return hits
}

fn __skill_score_metadata(context: dict, registry: dict) {
  const query_tokens = __skill_score_tokens(context?.task ?? "")
  const working_files = context?.working_files ?? []
  let scored = []
  for entry in __matchable_skill_entries(registry) {
    const id = __skill_id(entry)
    if id == "" {
      continue
    }
    const keyword_hits = __skill_score_term_hits(query_tokens, entry?.description ?? "")
      + __skill_score_term_hits(query_tokens, entry?.when_to_use ?? "")
    const id_match = __skill_score_id_match(query_tokens, id)
    const path_hits = __skill_score_path_hits(entry?.paths ?? [], working_files)
    let score = 0.0
    let triggers = []
    if keyword_hits > 0 {
      score = score + keyword_hits / (keyword_hits + 1.5)
      triggers = triggers.appending(to_string(keyword_hits) + " keyword hit(s)")
    }
    if id_match {
      score = score + 2.0
      triggers = triggers.appending("task mentions '" + id + "'")
    }
    if path_hits > 0 {
      score = score + 1.5 * path_hits
      triggers = triggers.appending(to_string(path_hits) + " path glob(s) matched")
    }
    if score > 0.0 {
      scored = scored.appending(
        {
          id: id,
          name: id,
          score: score,
          trigger: join(triggers, "; "),
          reason: join(triggers, "; "),
        },
      )
    }
  }
  return scored.sorted_by({ candidate -> 0 - candidate.score })
}

fn __host_skill_score_candidates(context: dict, registry: dict, opts: dict) {
  const matchable = {_type: "skill_registry", skills: __matchable_skill_entries(registry)}
  const outcome = try {
    __host_skill_score(context, matchable, __match_config(opts))
  }
  if is_err(outcome) {
    return __skill_score_metadata(context, registry)
  }
  return unwrap(outcome)?.scored ?? []
}

fn __score_candidates(
  agent: HarnessAgent,
  session: dict,
  registry: dict,
  opts: dict,
  iteration: int,
) {
  const context = {
    task: __latest_user_text(agent, session),
    working_files: opts?.working_files ?? [],
    iteration: iteration,
  }
  if __match_strategy(opts) == "metadata" {
    return __skill_score_metadata(context, registry)
  }
  return __host_skill_score_candidates(context, registry, opts)
}

fn __top_active_from_scores(registry: dict, scored: list, opts: dict) {
  let active = []
  const top_n = __match_top_n(opts)
  const strategy = __match_strategy(opts)
  for candidate in scored {
    if len(active) >= top_n {
      break
    }
    const score = candidate?.score ?? 0.0
    if score <= 0.0 && strategy == "metadata" {
      continue
    }
    const id = candidate?.id ?? candidate?.name ?? ""
    const entry = __skill_find(registry, id)
    if entry != nil {
      active = active.appending(
        entry + {id: id, score: score, trigger: candidate?.trigger ?? candidate?.reason ?? ""},
      )
    }
  }
  return active
}

fn __record_matched(agent: HarnessAgent, session: dict, opts: dict, iteration: int, scored: any) {
  agent_session_record_skill_event(
    agent,
    session.session_id,
    "skill_matched",
    {
      strategy: __match_strategy(opts),
      iteration: iteration,
      reassess: iteration > 0,
      candidates: scored,
      working_files: opts?.working_files ?? [],
    },
  )
}

fn __record_deactivations(
  agent: HarnessAgent,
  session: dict,
  prev: list,
  next: list,
  iteration: int,
) {
  const next_ids = __skill_ids(next)
  for entry in prev {
    const id = __skill_id(entry)
    if id != "" && !contains(next_ids, id) {
      agent_session_record_skill_event(
        agent,
        session.session_id,
        "skill_deactivated",
        {name: id, id: id, iteration: iteration},
      )
    }
  }
}

fn __record_activations(
  agent: HarnessAgent,
  session: dict,
  prev: list,
  next: list,
  iteration: int,
) {
  const prev_ids = __skill_ids(prev)
  for entry in next {
    const id = __skill_id(entry)
    if id == "" || contains(prev_ids, id) {
      continue
    }
    agent_session_record_skill_event(
      agent,
      session.session_id,
      "skill_activated",
      {
        name: id,
        id: id,
        description: entry?.description ?? "",
        iteration: iteration,
        score: entry?.score ?? 0.0,
        trigger: entry?.trigger ?? "",
        allowed_tools: entry?.allowed_tools ?? [],
      },
    )
    if len(entry?.allowed_tools ?? []) > 0 {
      agent_session_record_skill_event(
        agent,
        session.session_id,
        "skill_scope_tools",
        {name: id, id: id, allowed_tools: entry.allowed_tools},
      )
    }
  }
}

fn __allowed_union(active: list) {
  let allowed = []
  for active_entry in active {
    for allowed_entry in active_entry?.allowed_tools ?? [] {
      if !contains(allowed, allowed_entry) {
        allowed = allowed.appending(allowed_entry)
      }
    }
  }
  return allowed
}

fn __has_new_skill(prev: list, active: list) {
  const prev_ids = __skill_ids(prev)
  for entry in active {
    const id = __skill_id(entry)
    if id != "" && !contains(prev_ids, id) {
      return true
    }
  }
  return false
}

fn __tool_name(tool_entry: dict?) {
  return tool_entry?.name ?? tool_entry?.function?.name ?? ""
}

fn __tool_namespace(tool_entry: dict?) {
  return tool_entry?.namespace ?? tool_entry?.function?.namespace ?? ""
}

fn __allowed_matches_tool(entry: string?, tool_entry: dict?) {
  if entry == "*" {
    return true
  }
  const name = __tool_name(tool_entry)
  if entry == name {
    return true
  }
  if starts_with(entry, "namespace:") {
    return substring(entry, len("namespace:")) == __tool_namespace(tool_entry)
  }
  return false
}

fn __skill_scoped_tools(opts: dict, active: list) {
  const allowed = __allowed_union(active)
  if len(allowed) == 0 || contains(allowed, "*") {
    return opts?.tools
  }
  const registry = opts?.tools
  if type_of(registry) != "dict" {
    return registry
  }
  let kept = []
  for tool_entry in registry?.tools ?? [] {
    if __tool_name(tool_entry) == "load_skill" {
      kept = kept.appending(tool_entry)
      continue
    }
    let keep = false
    for entry in allowed {
      if __allowed_matches_tool(entry, tool_entry) {
        keep = true
        break
      }
    }
    if keep {
      kept = kept.appending(tool_entry)
    }
  }
  return registry + {tools: kept}
}

fn __opts_with_active_skills(
  opts: dict,
  registry: dict,
  active: any,
  activated_this_turn: bool = false,
) {
  const scoped_tools = __skill_scoped_tools(opts, active)
  let next = opts + {active_skills: active, _skill_activated_this_turn: activated_this_turn}
  if scoped_tools != nil {
    next = next + {tools: scoped_tools}
  }
  const catalog_prompt = __skill_catalog_prompt(registry, opts, active)
  if catalog_prompt != "" {
    next = next + {skill_catalog_prompt: catalog_prompt}
  }
  return next
}

fn __fresh_skill_projection_inputs(agent: HarnessAgent, session: dict, opts: dict, registry: dict) {
  const tool_opts = __with_load_skill_tool(agent, session, opts)
  return {tool_opts: tool_opts, profile_active: __active_from_context_profile(registry, tool_opts)}
}

/**
 * Project the skill-owned options for a fresh first turn without requiring or
 * mutating an agent session. Prompt previews use this to share Harn's load-tool,
 * context-profile activation, tool-scoping, and catalog policy with live turns.
 * The projected `load_skill` handler is descriptive until execution; callers
 * must use `agent_skills_match` inside an open session before invoking tools.
 *
 * @effects: []
 * @errors: []
 * @api_stability: experimental
 */
pub fn agent_skills_preview(agent: HarnessAgent, opts: dict) -> dict {
  const registry = __skills_registry(opts)
  if registry == nil || len(__skills_entries(registry)) == 0 {
    return opts
  }
  const inputs = __fresh_skill_projection_inputs(agent, {session_id: ""}, opts, registry)
  return __opts_with_active_skills(inputs.tool_opts, registry, inputs.profile_active)
}

/**
 * agent_skills_match.
 *
 * @effects: []
 * @errors: []
 * @api_stability: experimental
 */
pub fn agent_skills_match(agent: HarnessAgent, session: dict, opts: dict, iteration: int) {
  const registry = __skills_registry(opts)
  if registry == nil || len(__skills_entries(registry)) == 0 {
    return opts
  }
  const inputs = __fresh_skill_projection_inputs(agent, session, opts, registry)
  const tool_opts = inputs.tool_opts
  const stored_prev = __active_from_ids(
    registry,
    agent_session_active_skills(agent, session.session_id) ?? [],
  )
  const profile_active = inputs.profile_active
  const prev = __merge_active_skills(stored_prev, profile_active)
  if !__skills_same_ids(stored_prev, prev) {
    __record_activations(agent, session, stored_prev, prev, iteration)
    agent_session_set_active_skills(agent, session.session_id, prev)
  }
  if __match_strategy_manual(opts) {
    return __opts_with_active_skills(tool_opts, registry, prev)
  }
  if __match_strategy(opts) == "catalog" {
    return __opts_with_active_skills(tool_opts, registry, prev)
  }
  if __match_sticky(opts) && len(prev) > 0 {
    return __opts_with_active_skills(tool_opts, registry, prev)
  }
  const scored = __score_candidates(agent, session, registry, tool_opts, iteration)
  __record_matched(agent, session, tool_opts, iteration, scored)
  const active = __merge_active_skills(
    __top_active_from_scores(registry, scored, tool_opts),
    profile_active,
  )
  if !__skills_same_ids(prev, active) {
    __record_deactivations(agent, session, prev, active, iteration)
    __record_activations(agent, session, prev, active, iteration)
    agent_session_set_active_skills(agent, session.session_id, active)
  }
  const activated_this_turn = __has_new_skill(prev, active)
  return __opts_with_active_skills(tool_opts, registry, active, activated_this_turn)
}
