          harness,
          session.session_id,
          {
            ledger: command_ledger,
            command_wait: command_wait,
            hold_state: command_hold_state,
            reentry_cap: command_hold_cap_tokens,
            iteration: iteration_index + 1,
            tool_count: tool_count,
