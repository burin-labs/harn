              harness.agent,
              harness.clock,
              session.session_id,
              budget,
              iteration,
              step_totals,
              loop_start_ms,
              current_max,
            )
            if step_exhaustion.exhausted {
              __agent_loop_emit_budget_exhausted(harness.agent, session.session_id, step_exhaustion)
              budget_exhausted_emitted = true
              budget_decisions = __agent_loop_record_budget_stop(
                budget_decisions,
                iteration,
                current_max,
