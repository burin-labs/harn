            call_budget = __agent_loop_record_grant(call_budget, "recovery")
            stall_hard_stop_rescues = stall_hard_stop_rescues + 1
            stall_recovery_evidence_revision = __agent_loop_recovery_evidence_revision(
              stall_warning,
