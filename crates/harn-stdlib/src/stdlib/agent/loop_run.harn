import {
  CommandHoldState,
  command_ledger_ingest,
  command_ledger_new,
  command_wait_normalize,
} from "std/agent/command_ledger"
import { AgentLoopFailure } from "std/agent/failure_types"
import { CompletionDirectiveReceipt } from "std/agent/judge"
import { __agent_loop_await_turn } from "std/agent/loop_await_turn"
import "std/agent/loop_call_budget"
import "std/agent/loop_call_resolution"
import "std/agent/loop_denial_cutoff"
import "std/agent/loop_finalize"
import "std/agent/loop_foundation"
import {
  agent_loop_command_hold_transition,
  agent_loop_post_turn_transition,
} from "std/agent/loop_post_turn"
import { agent_loop_provider_failure } from "std/agent/loop_provider_failure"
import "std/agent/loop_purpose_labels"
import "std/agent/loop_resource_dispatch"
import "std/agent/loop_result_status"
import { __agent_loop_skipped_dispatch_turn } from "std/agent/loop_skipped_dispatch"
import "std/agent/loop_support"
import "std/agent/loop_terminal"
import "std/agent/loop_tool_calls"
import "std/agent/loop_turn_options"
import "std/agent/loop_turn_scope"
import { __agent_loop_turn_setup } from "std/agent/loop_turn_setup"
import {
  agent_repair_checkpoint_state,
  agent_repair_initial_checkpoint,
  agent_repair_validate_checkpoint,
  agent_repair_verification_dispatch,
} from "std/agent/repair"

@complexity(allow)
pub fn __agent_loop_run(harness: Harness, message: any, session: dict, initial_opts: any) {
  let opts = initial_opts
  let iteration = 0
  let session_finalized = false
  let audit_background_tasks = []
  let successful_tools_seen = []
  let rejected_tools_seen = []
  let current_max = 0
  // Hoisted beside `current_max` for the same reason: the error epilogue below
  // runs outside the try block and reports the same budget the in-loop
  // terminal boundary reports. Reading the spec field again down there would
  // add a second, differently shaped read of the same option.
  let iteration_budget = nil
  let terminal_callback_attempted = false
  // One invoker serves ordinary terminal decisions and the error epilogue.
  // Mark entry before calling host code: a callback that throws is not retried.
  const notify_terminal = { terminal_opts, terminal ->
    terminal_callback_attempted = true
    return agent_compute_terminal_callback(harness.agent, session, terminal_opts, terminal)
  }
  let run: Result<_, AgentLoopFailure> = try {
    opts = agent_mcp_bootstrap_if_needed(harness.tools, session, opts)
    const primary_llm_opts = __agent_loop_effective_llm_options(harness.llm, opts)
    const primary_provider = to_string(primary_llm_opts?.provider ?? "")
    const primary_model = to_string(primary_llm_opts?.model ?? "")
    const primary_tool_format = to_string(primary_llm_opts?.tool_format ?? "")
    let escalation_retry_pending = false
    let stop_reason = nil
    let final_status = ""
    let terminal_error = nil
    let verify_attempts = 0
    let turn_end_judge_invocations = 0
    let turn_end_judge_vetoes = 0
    let verify_completion_judge_invocations = 0
    let verify_completion_judge_vetoes = 0
    let feedback_history = {}
    let step_judge_attempts = 0
    let step_judge_unavailable_count = 0
    let last_turn_parse_dropped = false
    let consecutive_text_only = 0
    let turns_since_progress = 0
    let turns_since_loop_progress = 0
    let fallback_index = 0
    // Per-CALL tallies, kept beside the name lists rather than derived from
    // them: `__merge_tool_names` deduplicates by name, so those lengths are
    // distinct-tool counts and would mislabel a call count if reported as one.
    let tool_calls_attempted = 0
    let tool_calls_succeeded = 0
    let last_tool_rejection_category = nil
    let suspend_result = nil
    let abandonment = nil
    let declared_artifacts = nil
    let stall_checkpoint = opts?.repair_checkpoint
      ?? agent_repair_initial_checkpoint(session.session_id)
    if stall_checkpoint.session_id != session.session_id {
      throw "agent_loop: repair checkpoint belongs to a different session"
    }
    agent_repair_validate_checkpoint(stall_checkpoint)
    let stall_state = stall_checkpoint.state
    let stall_prev_dispatch = stall_checkpoint.dispatch
    const max_verify_attempts = opts?.max_verify_attempts ?? 20
    const budget = opts.iteration_budget
    iteration_budget = budget
    current_max = budget.initial
    let extensions_used = 0
    let budget_decisions = []
    let consecutive_failure_count = 0
    let budget_exhausted_emitted = false
    let last_tool_count = 0
    const loop_start_ms = __agent_loop_clock_now_ms(harness.clock)
    opts = __agent_loop_apply_deadline(opts, budget, loop_start_ms)
    const __reserve_cfg = agent_repair_config(opts?.repair_diagnostics)
    let terminal_write_unverified = false
    let terminal_assessment: CompletionDirectiveReceipt? = nil
    let made_source_write = false
    // One owner tracks terminal verification and reporting grants.
    let call_budget = __agent_loop_call_budget_new(opts, __reserve_cfg)
    // Session-scoped ownership of long-running handles keeps polling out of the
    // model loop. Normalize thresholds and wording once here (harn#4456);
    // linked hosts predating `command_wait` receive the defaults.
    const command_wait = command_wait_normalize(opts?.command_wait)
    let command_ledger = command_ledger_new()
    let command_hold_state: CommandHoldState = {reentries: 0}
    // One-shot output cap after a progress-only hold: deciding "keep waiting"
    // needs no reasoning budget. Nil for normal/result turns and cleared after
    // exactly one application.
    let command_hold_cap_tokens = nil
    while true {
      terminal_callback_attempted = false
      while iteration < current_max {
        // The turn-setup phase owns the four pre-request guards and the
        // assembly of this turn's options, prompt and prefill (harn#7753). It
        // returns an explicit action rather than breaking across the module
        // boundary, so every guard that ends a run still writes exactly the
        // state it wrote before.
        const setup = __agent_loop_turn_setup(
          harness,
          session,
          {
            message: message,
            opts: opts,
            iteration: iteration,
            call_budget: call_budget,
            stall_state: stall_state,
            command_hold_cap_tokens: command_hold_cap_tokens,
            budget_decisions: budget_decisions,
            budget_exhausted_emitted: budget_exhausted_emitted,
            suspend_result: suspend_result,
            audit_background_tasks: audit_background_tasks,
            budget: budget,
            current_max: current_max,
            loop_start_ms: loop_start_ms,
            primary_provider: primary_provider,
            primary_model: primary_model,
          },
        )
        opts = setup.opts
        iteration = setup.iteration
        call_budget = setup.call_budget
        stall_state = setup.stall_state
        command_hold_cap_tokens = setup.command_hold_cap_tokens
        budget_decisions = setup.budget_decisions
        audit_background_tasks = setup.audit_background_tasks
        // Read back unconditionally, not only on a break. These two are passed
        // IN so that a guard which does not touch them returns them unchanged
        // through the state record; reading them only on the break arm would
        // have clobbered a caller value with nil on the arms that never set it.
        budget_exhausted_emitted = setup.budget_exhausted_emitted
        suspend_result = setup.suspend_result
        if setup.action == "break" {
          final_status = setup.final_status
          stop_reason = setup.stop_reason
          break
        }
        const iteration_index = setup.iteration_index
        const turn_opts = setup.turn_opts
        const turn_llm_opts = setup.turn_llm_opts
        const turn_prompt = setup.turn_prompt
        const llm_opts = setup.llm_opts
        let call = __agent_loop_invoke_main_request(
          harness,
          message,
          turn_prompt.system,
          llm_opts,
          turn_opts,
          session.session_id,
          iteration_index,
        )
        call = agent_loop_demote_empty_turn(call, turn_llm_opts)
        if !call.ok && __agent_loop_is_context_overflow(call?.error) {
          call = __agent_loop_recover_context_overflow(
            harness,
            call,
            message,
            turn_prompt.system,
            llm_opts,
            turn_opts,
            session,
            iteration_index,
            __agent_loop_output_contract(opts),
          )
        }
        if !call.ok {
          const provider_failure = agent_loop_provider_failure(
            harness.agent,
            harness.clock,
            session.session_id,
            call,
            turn_llm_opts,
            {
              primary_provider: primary_provider,
              primary_model: primary_model,
              primary_tool_format: primary_tool_format,
              opts: opts,
              budget: budget,
              iteration: iteration,
              iteration_index: iteration_index,
              consecutive_failure_count: consecutive_failure_count,
              loop_start_ms: loop_start_ms,
              current_max: current_max,
              escalation_retry_pending: escalation_retry_pending,
              budget_exhausted_emitted: budget_exhausted_emitted,
              budget_decisions: budget_decisions,
            },
          )
          opts = provider_failure.opts
          iteration = provider_failure.iteration
          consecutive_failure_count = provider_failure.consecutive_failure_count
          escalation_retry_pending = provider_failure.escalation_retry_pending
          budget_exhausted_emitted = provider_failure.budget_exhausted_emitted
          budget_decisions = provider_failure.budget_decisions
          if provider_failure.action == "continue" {
            continue
          }
          final_status = provider_failure.final_status
          stop_reason = provider_failure.stop_reason
          terminal_error = provider_failure.terminal_error
          break
        }
        escalation_retry_pending = false
        const llm_result = call.value
        consecutive_failure_count = 0
        iteration = iteration + 1
        const projection_context = {llm_options: turn_llm_opts, turn_options: turn_opts}
        const projected = __agent_loop_project_result(harness.agent, llm_result, projection_context)
        const raw_text = projected.raw_text
        const parsed = projected.parsed
        const visible_text = projected.visible_text
        const normalized = projected.normalized
        const fallback_outcome = __detect_native_fallback(
          harness.agent,
          harness.fs,
          llm_result,
          parsed,
          projected.tool_options,
          fallback_index,
          session.session_id,
          iteration_index,
        )
        fallback_index = fallback_outcome.fallback_index
        let tool_calls = if fallback_outcome.triggered {
          fallback_outcome.calls ?? []
        } else {
          __resolve_tool_calls(llm_result, parsed)
        }
        const recovered_batch_drop = __drop_unsafe_recovered_text_batch(
          harness.llm,
          parsed,
          tool_calls,
          projected.tool_options,
        )
        tool_calls = agent_collapse_duplicate_read_calls(
          recovered_batch_drop.tool_calls,
          turn_opts?.tools,
          turn_opts,
        )
        if len(tool_calls) > 0 {
          terminal_assessment = nil
        }
        __purpose_label_publish(harness.agent, session, projected, iteration_index, tool_calls)
        const parse_feedback = __agent_loop_record_parse_feedback(
          harness,
          session.session_id,
          normalized,
          fallback_outcome,
          tool_calls,
          parsed,
          recovered_batch_drop.feedback,
          llm_result,
          projected.tool_options,
        )
        last_turn_parse_dropped = parse_feedback.parse_dropped
        const had_parse_errors = parse_feedback.had_parse_errors
        const had_full_parse_rejection = parse_feedback.had_full_parse_rejection
        const await_call = __agent_await_resumption_call(tool_calls)
        if await_call != nil {
          const await_outcome = __agent_loop_await_turn(
            harness,
            session,
            {
              await_call: await_call,
              budget: budget,
              budget_decisions: budget_decisions,
              budget_exhausted_emitted: budget_exhausted_emitted,
              current_max: current_max,
              final_status: final_status,
              iteration: iteration,
              iteration_index: iteration_index,
              llm_result: llm_result,
              loop_start_ms: loop_start_ms,
              opts: opts,
              stop_reason: stop_reason,
              suspend_result: suspend_result,
              tool_calls: tool_calls,
              turn_llm_opts: turn_llm_opts,
              visible_text: visible_text,
            },
          )
          budget_decisions = await_outcome.budget_decisions
          budget_exhausted_emitted = await_outcome.budget_exhausted_emitted
          final_status = await_outcome.final_status
          stop_reason = await_outcome.stop_reason
          suspend_result = await_outcome.suspend_result
          if await_outcome.action == "break" {
            break
          }
          continue
        }
        stall_state = agent_repair_checkpoint_state(harness.agent, stall_checkpoint)
        stall_checkpoint = stall_checkpoint
          + {state: stall_state, consumed_dispatch_position: stall_checkpoint.dispatch_position}
        if stall_state.last_diagnostic_class == "pass"
          && stall_state.verified_write_epoch >= stall_state.write_epoch
          && !stall_state.reverify_owed {
          terminal_write_unverified = false
        }
        if turn_opts?.step_judge != nil {
          const remaining_iterations = current_max - iteration_index
          const step_verdict = agent_step_judge(
            harness,
            session,
            llm_result,
            turn_opts,
            iteration_index + 1,
            nil,
            step_judge_attempts,
            remaining_iterations,
            step_judge_unavailable_count,
          )
          step_judge_unavailable_count = step_verdict?.unavailable_count
            ?? step_judge_unavailable_count
          if step_verdict.vetoed {
            step_judge_attempts = step_judge_attempts + 1
            const on_veto = step_verdict?.on_veto ?? "replace"
            if on_veto == "replace" {
              agent_session_pop_last_assistant(harness.agent, session.session_id)
            }
            const critique = step_verdict?.feedback ?? step_verdict?.critique ?? ""
            if critique != "" {
              if on_veto == "replace" {
                agent_session_inject_feedback(
                  harness.agent,
                  session.session_id,
                  "step_judge",
                  critique,
                  1,
                )
              } else {
                __inject_feedback_with_tool_repair(
                  harness.agent,
                  session.session_id,
                  "step_judge",
                  critique,
                )
              }
            }
            const step_totals = agent_session_record_usage(
              harness.agent,
              session.session_id,
              llm_result,
              turn_llm_opts,
              iteration_index + 1,
            )
            agent_emit_event(
              harness.agent,
              session.session_id,
              "iteration_end",
              {
                iteration: iteration_index + 1,
                iteration_info: __agent_loop_iteration_info(
                  harness.agent,
                  harness.clock,
                  session.session_id,
                  llm_result,
                  0,
                  visible_text,
                  step_totals,
                  loop_start_ms,
                )
                  + {
                    dispatch_skipped: true,
                    skip_reason: "step_judge_revise",
                    on_veto: on_veto,
                    step_judge_attempts: step_judge_attempts,
                  },
              },
            )
            const step_exhaustion = __agent_loop_budget_exhaustion(
              harness.agent,
              harness.clock,
              session.session_id,
              budget,
              iteration,
              step_totals,
              loop_start_ms,
              current_max,
            )
            if step_exhaustion.exhausted {
              __agent_loop_emit_budget_exhausted(harness.agent, session.session_id, step_exhaustion)
              budget_exhausted_emitted = true
              budget_decisions = __agent_loop_record_budget_stop(
                budget_decisions,
                iteration,
                current_max,
                step_exhaustion.kind,
              )
              final_status = "budget_exhausted"
              stop_reason = step_exhaustion.kind
              break
            }
            continue
          } else if !(step_verdict?.skipped ?? false) {
            step_judge_attempts = 0
          }
        }
        const pre_dispatch_checkpoint = agent_stage(
          harness.agent,
          session.session_id,
          "pre_tool_dispatch",
          {iteration: iteration_index + 1},
        )
        if pre_dispatch_checkpoint.dispatch_skipped {
          const skipped_outcome = __agent_loop_skipped_dispatch_turn(
            harness,
            session,
            {
              budget: budget,
              budget_decisions: budget_decisions,
              consecutive_text_only: consecutive_text_only,
              current_max: current_max,
              iteration: iteration,
              iteration_index: iteration_index,
              last_tool_count: last_tool_count,
              llm_result: llm_result,
              loop_start_ms: loop_start_ms,
              tool_calls: tool_calls,
              turn_llm_opts: turn_llm_opts,
              turn_opts: turn_opts,
              turns_since_progress: turns_since_progress,
              visible_text: visible_text,
            },
          )
          budget_decisions = skipped_outcome.budget_decisions
          consecutive_text_only = skipped_outcome.consecutive_text_only
          last_tool_count = skipped_outcome.last_tool_count
          turns_since_progress = skipped_outcome.turns_since_progress
          if skipped_outcome.action == "break" {
            budget_exhausted_emitted = skipped_outcome.budget_exhausted_emitted
            final_status = skipped_outcome.final_status
            stop_reason = skipped_outcome.stop_reason
            break
          }
          continue
        }
        const dispatched = __dispatch_tool_calls(
          harness,
          session.session_id,
          tool_calls,
          turn_opts
            + {
              _iteration: iteration_index + 1,
              _tool_caller: opts?._tool_caller,
              _stop_reason: llm_result?.stop_reason ?? "",
              _purpose_label: projected.purpose_label,
            },
        )
        const dispatch = dispatched.dispatch
        const actuation_dispatch_results = __dispatch_results_list(dispatch)
        stall_checkpoint = stall_checkpoint
          + {
            state: stall_state,
            dispatch: dispatch,
            dispatch_position: stall_checkpoint.dispatch_position
              + if dispatch != nil {
                1
              } else {
                0
              },
            dispatch_made_edit: __turn_made_edit(dispatch, opts?.tools),
            verification_dispatch: agent_repair_verification_dispatch(dispatch, turn_opts),
          }
        // Register long-running handles (`status=="running"` with a `handle_id`).
        // Awaited rows gate the next no-tool-call boundary into a hold; the
        // loop owns the decision cadence, so the model never polls.
        command_ledger = command_ledger_ingest(
          command_ledger,
          actuation_dispatch_results,
          __agent_loop_clock_now_ms(harness.clock),
          command_wait,
        )
        audit_background_tasks = __spawn_audit_flushes(
          audit_background_tasks,
          dispatched.audit_flushes,
        )
        opts = __sync_tool_search_state(opts, dispatched.turn_opts)
        successful_tools_seen = __merge_tool_names(
          successful_tools_seen,
          __tool_names_by_status(dispatch, true),
        )
        rejected_tools_seen = __merge_tool_names(
          rejected_tools_seen,
          __tool_names_by_status(dispatch, false),
        )
        const call_tally = __dispatch_call_tally(dispatch)
        tool_calls_attempted = tool_calls_attempted + call_tally.attempted
        tool_calls_succeeded = tool_calls_succeeded + call_tally.succeeded
        last_tool_rejection_category = __dispatch_last_rejection_category(dispatch)
          ?? last_tool_rejection_category
        const post_dispatch = __agent_loop_post_dispatch(
          harness,
          session.session_id,
          llm_result,
          turn_llm_opts,
          iteration_index,
          tool_calls,
          visible_text,
          loop_start_ms,
          current_max,
          dispatch,
          stall_prev_dispatch,
        )
        const totals = post_dispatch.totals
        const tool_count = len(tool_calls)
        const bridge_step_delivered = post_dispatch.bridge_step_delivered
        if post_dispatch.terminal != nil {
          final_status = "error"
          stop_reason = post_dispatch.terminal.reason
          terminal_error = post_dispatch.terminal.error
          break
        }
        stall_prev_dispatch = dispatch
        const exhaustion = __agent_loop_budget_exhaustion(
          harness.agent,
          harness.clock,
          session.session_id,
          budget,
          iteration,
          totals,
          loop_start_ms,
          current_max,
        )
        if exhaustion.exhausted {
          __agent_loop_emit_budget_exhausted(harness.agent, session.session_id, exhaustion)
          budget_exhausted_emitted = true
          budget_decisions = __agent_loop_record_budget_stop(
            budget_decisions,
            iteration,
            current_max,
            exhaustion.kind,
          )
          final_status = "budget_exhausted"
          stop_reason = exhaustion.kind
          break
        }
        const budget_stop = agent_budget_post_call_stop_reason(totals, turn_opts)
        if budget_stop != "" {
          final_status = "budget_exhausted"
          stop_reason = budget_stop
          break
        }
        const hold_transition = agent_loop_command_hold_transition(
          harness,
          session.session_id,
          {
            ledger: command_ledger,
            command_wait: command_wait,
            hold_state: command_hold_state,
            reentry_cap: command_hold_cap_tokens,
            iteration: iteration_index + 1,
            tool_count: tool_count,
          },
        )
        command_ledger = hold_transition.ledger
        command_hold_state = hold_transition.hold_state
        command_hold_cap_tokens = hold_transition.reentry_cap
        if hold_transition.action == "continue" {
          if hold_transition.reset_progress {
            consecutive_text_only = 0
            turns_since_progress = 0
          }
          continue
        }
        const post_turn_transition = agent_loop_post_turn_transition(
          harness,
          session,
          {
            budget: budget,
            bridge_step_delivered: bridge_step_delivered,
            repair_checkpoint: stall_checkpoint,
            consecutive_failure_count: consecutive_failure_count,
            dispatch: dispatch,
            dispatched_turn_opts: dispatched.turn_opts,
            fallback_accepted: fallback_outcome.accepted,
            fallback_triggered: fallback_outcome.triggered,
            had_parse_errors: had_parse_errors,
            iteration: iteration,
            iteration_index: iteration_index,
            llm_result: llm_result,
            loop_start_ms: loop_start_ms,
            normalized: normalized,
            parsed_done_marker: parsed?.done_marker ?? "",
            raw_text: raw_text,
            rejected_tools_seen: rejected_tools_seen,
            successful_tools_seen: successful_tools_seen,
            tool_calls: tool_calls,
            totals: totals,
            turn_llm_opts: turn_llm_opts,
            turn_opts: turn_opts,
            visible_text: visible_text,
          },
          {
            budget_decisions: budget_decisions,
            consecutive_text_only: consecutive_text_only,
            current_max: current_max,
            turn_end_judge_invocations: turn_end_judge_invocations,
            turn_end_judge_vetoes: turn_end_judge_vetoes,
            extensions_used: extensions_used,
            feedback_history: feedback_history,
            final_status: final_status,
            last_tool_count: last_tool_count,
            made_source_write: made_source_write,
            opts: opts,
            stall_state: stall_state,
            stop_reason: stop_reason,
            terminal_assessment: terminal_assessment,
            terminal_write_unverified: terminal_write_unverified,
            turns_since_loop_progress: turns_since_loop_progress,
            turns_since_progress: turns_since_progress,
            verify_attempts: verify_attempts,
            verify_completion_judge_invocations: verify_completion_judge_invocations,
            verify_completion_judge_vetoes: verify_completion_judge_vetoes,
          },
          max_verify_attempts,
        )
        const post_turn_state = post_turn_transition.state
        budget_decisions = post_turn_state.budget_decisions
        consecutive_text_only = post_turn_state.consecutive_text_only
        current_max = post_turn_state.current_max
        turn_end_judge_invocations = post_turn_state.turn_end_judge_invocations
        turn_end_judge_vetoes = post_turn_state.turn_end_judge_vetoes
        extensions_used = post_turn_state.extensions_used
        feedback_history = post_turn_state.feedback_history
        final_status = post_turn_state.final_status
        last_tool_count = post_turn_state.last_tool_count
        made_source_write = post_turn_state.made_source_write
        opts = post_turn_state.opts
        stall_state = post_turn_state.stall_state
        stop_reason = post_turn_state.stop_reason
        terminal_assessment = post_turn_state.terminal_assessment
        terminal_write_unverified = post_turn_state.terminal_write_unverified
        turns_since_loop_progress = post_turn_state.turns_since_loop_progress
        turns_since_progress = post_turn_state.turns_since_progress
        verify_attempts = post_turn_state.verify_attempts
        verify_completion_judge_invocations = post_turn_state.verify_completion_judge_invocations
        verify_completion_judge_vetoes = post_turn_state.verify_completion_judge_vetoes
        if post_turn_transition.action == "break" {
          break
        }
        continue
      }
      const terminal_boundary = __agent_loop_terminal_boundary(
        harness,
        session,
        {
          opts: opts,
          final_status: final_status,
          stop_reason: stop_reason,
          reserve_cfg: __reserve_cfg,
          terminal_write_unverified: terminal_write_unverified,
          terminal_assessment: terminal_assessment,
          made_source_write: made_source_write,
          call_budget: call_budget,
          verify_attempts: verify_attempts,
          max_verify_attempts: max_verify_attempts,
          verify_completion_judge_invocations: verify_completion_judge_invocations,
          verify_completion_judge_vetoes: verify_completion_judge_vetoes,
          turn_end_judge_invocations: turn_end_judge_invocations,
          iteration: iteration,
          current_max: current_max,
          budget: budget,
          budget_exhausted_emitted: budget_exhausted_emitted,
          budget_decisions: budget_decisions,
          suspend_result: suspend_result,
          terminal_error: terminal_error,
          last_turn_parse_dropped: last_turn_parse_dropped,
          stall_state: stall_state,
          successful_tools_seen: successful_tools_seen,
          rejected_tools_seen: rejected_tools_seen,
          tool_calls_attempted: tool_calls_attempted,
          tool_calls_succeeded: tool_calls_succeeded,
          last_tool_rejection_category: last_tool_rejection_category,
          feedback_history: feedback_history,
        },
        notify_terminal,
      )
      opts = terminal_boundary.opts
      final_status = terminal_boundary.final_status
      stop_reason = terminal_boundary.stop_reason
      terminal_write_unverified = terminal_boundary.terminal_write_unverified
      terminal_assessment = terminal_boundary.terminal_assessment
      stall_state = terminal_boundary.stall_state
      call_budget = terminal_boundary.call_budget
      verify_attempts = terminal_boundary.verify_attempts
      verify_completion_judge_invocations = terminal_boundary.verify_completion_judge_invocations
      verify_completion_judge_vetoes = terminal_boundary.verify_completion_judge_vetoes
      current_max = terminal_boundary.current_max
      budget_exhausted_emitted = terminal_boundary.budget_exhausted_emitted
      budget_decisions = terminal_boundary.budget_decisions
      terminal_error = terminal_boundary.terminal_error
      abandonment = terminal_boundary.abandonment
      declared_artifacts = terminal_boundary.declared_artifacts
      feedback_history = terminal_boundary.feedback_history ?? feedback_history
      if terminal_boundary.action == "continue" {
        continue
      }
      break
    }
    const final_state = {
      successful_tools_seen: successful_tools_seen,
      opts: opts,
      final_status: final_status,
      stop_reason: stop_reason,
      iteration: iteration,
      loop_start_ms: loop_start_ms,
      suspend_result: suspend_result,
      terminal_error: terminal_error,
      terminal_assessment: terminal_assessment,
      abandonment: abandonment,
      audit_background_tasks: audit_background_tasks,
      budget: budget,
      budget_exhausted_emitted: budget_exhausted_emitted,
      budget_decisions: budget_decisions,
      current_max: current_max,
      extensions_used: extensions_used,
      last_tool_count: last_tool_count,
      stall_state: stall_state,
      repair_checkpoint: stall_checkpoint + {state: stall_state},
      verify_completion_judge_invocations: verify_completion_judge_invocations,
      verify_completion_judge_vetoes: verify_completion_judge_vetoes,
      turn_end_judge_invocations: turn_end_judge_invocations,
      turn_end_judge_vetoes: turn_end_judge_vetoes,
    }
    const finalized = __agent_loop_finalize(harness, message, session, final_state)
    session_finalized = true
    const projection_state = final_state
      + {
        final_status: finalized.final_status,
        stop_reason: finalized.stop_reason,
        verified_policy_stop: finalized.verified_policy_stop,
        terminal_verification: finalized.terminal_verification,
        budget_decisions: finalized.budget_decisions,
        output_contract: finalized.output_contract,
        abandonment: abandonment,
        declared_artifacts: declared_artifacts,
      }
    const final_result = __agent_loop_project_terminal_result(
      harness,
      finalized.result,
      message,
      session,
      projection_state,
    )
    final_result
  }
  if is_err(run) && !terminal_callback_attempted && opts?.terminal_callback != nil {
    const error = unwrap_err(run)
    const terminal = __agent_loop_boundary_terminal_record(error_category(error), iteration, error)
    // Call the terminal invoker by name rather than through the closure: the
    // epilogue runs outside the loop, and naming the owner keeps this read of
    // the agent options auditable at the same origin the in-loop path uses.
    const notification = try {
      agent_compute_terminal_callback(
        harness.agent,
        session,
        opts,
        {
          iteration: iteration,
          final_status: terminal.final_status,
          stop_reason: terminal.stop_reason,
          terminal_error: terminal?.error,
          max_iterations: current_max,
          iteration_budget: iteration_budget,
          session_successful_tools: successful_tools_seen,
          session_rejected_tools: rejected_tools_seen,
        },
      )
    }
    if is_err(notification) {
      run = try {
        throw {
          kind: "agent_loop_terminal_callback_failed",
          category: "internal",
          reason: "terminal_callback_failed",
          message: "agent loop failed and its terminal callback also failed",
          cause: {terminal_error: error, callback_error: unwrap_err(notification)},
        }
      }
    }
  }
  return __agent_loop_finish_run(
    harness.agent,
    session,
    {
      iteration: iteration,
      session_finalized: session_finalized,
      audit_background_tasks: audit_background_tasks,
    },
    run,
  )
}
