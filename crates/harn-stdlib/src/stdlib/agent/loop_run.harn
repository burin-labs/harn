            const old_limit = current_max
            current_max = max(current_max, iteration + 1)
            if len(tool_calls) > 0 {
              agent_session_record_undispatched_tool_results(
                harness.agent,
                session.session_id,
                tool_calls,
                "skipped",
                "not dispatched: repeated identical tool call entered bounded thrash recovery",
