/** Both exceptions retained when a terminal callback also fails. */
pub type AgentLoopCallbackCause = {terminal_error: unknown, callback_error: unknown}

/** A terminal callback failed while reporting the original loop failure. */
pub type AgentLoopCallbackFailure = {
  kind: "agent_loop_terminal_callback_failed",
  category: "internal",
  reason: "terminal_callback_failed",
  message: string,
  cause: AgentLoopCallbackCause,
}

/** Dispatch refused a provider request with no substantive input. */
pub type AgentDispatchProtocolFailure = {
  kind: "terminal",
  category: "agent_loop_protocol_failure",
  reason: "empty_provider_request",
  terminal_class: "agent_loop_protocol_failure",
  message: string,
}

/** Cancellation from an internal evaluator or a custom classifier. */
pub type AgentLoopCancellationFailure = {
  kind: "agent_loop_cancelled",
  category: "cancelled",
  reason: "cancelled",
  message: string,
  cause: {cancellation_error: unknown},
}

/**
 * Normalize cancellation before it enters the closed loop error channel.
 * @effects: []
 * @errors: []
 */
pub fn agent_loop_cancellation_failure(error: unknown) -> AgentLoopCancellationFailure {
  const details = type_of(error) == "dict" ? error : {}
  return {
    kind: "agent_loop_cancelled",
    category: "cancelled",
    reason: "cancelled",
    message: to_string(details?.message ?? error),
    cause: {cancellation_error: error},
  }
}

/** Optional details reported when a missing-call classifier option is invalid. */
pub type AgentMissingToolCallConfigDetails = {
  field?: string,
  expected?: string,
  actual_type?: string,
  actual?: unknown,
  min?: float,
  max?: float,
}

/** Classifier configuration failures retain the option and its rejected value. */
pub type AgentMissingToolCallConfigFailure = AgentMissingToolCallConfigDetails \
  & {
  error: string,
  category: "invalid_config",
  component: "missing_tool_call_classifier",
  message: string,
}

/** Internal failures normalized by the public agent-loop terminal boundary. */
pub type AgentLoopFailure = string \
  | AgentLoopCallbackFailure \
  | AgentDispatchProtocolFailure \
  | AgentLoopCancellationFailure \
  | AgentMissingToolCallConfigFailure
