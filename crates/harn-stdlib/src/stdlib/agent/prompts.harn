/**
 * step_judge_system_prompt renders the per-step judge's system prompt.
 * Default rubric is neutral; pass `{rubric: "adversarial"}` in options
 * to use the adversarial variant for sycophancy-mitigation experiments.
 *
 * @effects: []
 * @allocation: heap
 * @errors: []
 * @api_stability: experimental
 * @example: step_judge_system_prompt(options)
 */
pub fn step_judge_system_prompt(options = nil) {
  let rubric = options?.rubric ?? "default"
  let id = if rubric == "adversarial" {
    "agent.step_judge_system_adversarial"
  } else {
    "agent.step_judge_system"
  }
  return render_agent_prompt_id(id, {}, options)
}

/**
 * step_judge_user_prompt renders the per-step judge's user prompt
 * with the latest assistant response appended to the transcript view.
 * Bindings: session_id, iteration, task, transcript, latest_response.
 *
 * @effects: []
 * @allocation: heap
 * @errors: []
 * @api_stability: experimental
