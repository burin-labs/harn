import "std/agent/loop_result_status"
import "std/agent/loop_turn_options"
import { agent_emit_event, agent_session_record_usage } from "std/agent/state"
import { agent_tool_handler_result_denial } from "std/agent/tool_lifecycle"
import { AgentLoopCommandHoldResult } from "std/agent/loop_command_hold_types"

pub type AgentPostDispatchUsage = {
  tokens_used: int,
  cost_usd: float?,
  known_cost_usd: float,
  input_tokens?: int,
  output_tokens?: int,
  cache_read_tokens: int,
  cache_write_tokens: int,
  projected_cost_usd?: float,
  unpriced_calls: int,
  usage_unknown_calls: int,
}

pub type CommandCompletionBoundary = fn(AgentPostDispatchUsage) -> AgentLoopCommandHoldResult?

pub type AgentPostDispatchTerminal = {
  reason: string,
  error: {
    terminal_class: string,
    category: string,
    error_category: string,
    reason: string,
    message: string,
  },
}

pub type AgentPostDispatchResult = {
  totals: AgentPostDispatchUsage,
  bridge_step_delivered: int,
  delivery_occurred: bool,
  terminal: AgentPostDispatchTerminal?,
  command_hold: AgentLoopCommandHoldResult?,
  dispatch: AgentToolDispatch,
  calls: list,
}

fn __tool_result_denial(result: dict) {
  if type_of(result?.denial) == "dict" {
    return result.denial
  }
  if type_of(result?.result?.denial) == "dict" {
    return result.result.denial
  }
  // A handler that ran and then refused reports its denial one level deeper,
  // under the handler result's `data`. Both shapes above are what the VM
  // writes when it refuses to dispatch at all; without this third probe a
  // refusal a tool reported about itself is invisible here, and a repeatable
  // refusal — a consent gate says no to the identical command every time — is
  // exactly what this cutoff exists to stop.
  return agent_tool_handler_result_denial(result)
}

/**
 * Return a secret-safe identity for a dispatch made entirely of permanent
 * denials. Call IDs and denial repeat counters are deliberately excluded: a
 * model reissuing the same call receives a fresh ID, and some gates increment
 * their own diagnostic counter on every refusal.
 *
 * A mixed batch returns nil. In particular, one successful or retryable result
 * proves that this dispatch still had a live route and must not trip the
 * permanent-denial cutoff.
 *
 * @effects: []
 * @errors: []
 */
fn __non_retryable_denial_signature(dispatch: AgentToolDispatch) {
  const results = __dispatch_results_list(dispatch)
  if len(results) == 0 {
    return nil
  }
  let identities = []
  for result in results {
    const denial = __tool_result_denial(result)
    if denial == nil || denial?.retryable != false || __tool_result_ok(result) {
      return nil
    }
    identities.push(
      {
        tool_name: __tool_result_name(result),
        arguments: result?.arguments ?? {},
        gate: denial?.gate ?? "",
        capability: denial?.capability,
        denied_paths: denial?.denied_paths ?? [],
        reason: denial?.reason ?? "",
        denial_class: denial?.denial_class,
        side_effect_ceiling: denial?.side_effect_ceiling,
        machine_reason: denial?.machine_reason,
      },
    )
  }
  return "sha256:" + sha256(json_stringify(identities))
}

fn __emit_non_retryable_denial_cutoff(
  agent: HarnessAgent,
  session_id: string,
  iteration: any,
  current_max: any,
  dispatch: AgentToolDispatch,
  denial_signature: any,
) {
  agent_emit_event(
    agent,
    session_id,
    "typed_checkpoint",
    {
      schema: "harn.agent_non_retryable_denial_cutoff.v1",
      kind: "non_retryable_denial_cutoff",
      iteration: iteration,
      repeat_count: 2,
      tool_names: __tool_names_by_status(dispatch, false),
      denial_signature: denial_signature,
    },
  )
  agent_emit_event(
    agent,
    session_id,
    "loop_control_decision",
    {
      iteration: iteration,
      action: "stop",
      old_limit: current_max,
      new_limit: current_max,
      reason: "repeated_non_retryable_denial",
      status: "error",
    },
  )
}

/**
 * Own post-dispatch accounting and the permanent-denial terminal decision.
 * Returning the terminal envelope keeps the loop driver responsible only for
 * assigning its mutable terminal state and leaving the iteration loop.
 *
 * @effects: [agent]
 * @errors: []
 */
pub fn __agent_loop_post_dispatch(
  harness: Harness,
  session_id: string,
  llm_result: dict,
  turn_llm_opts: dict?,
  iteration_index: int,
  tool_calls: string | bytes | list | dict | set | range | nil,
  visible_text: string,
  loop_start_ms: any,
  current_max: any,
  dispatch: AgentToolDispatch,
  prior_dispatch: AgentToolDispatch,
  complete_commands: CommandCompletionBoundary? = nil,
) -> AgentPostDispatchResult {
  const iteration = iteration_index + 1
  const totals = agent_session_record_usage(
    harness.agent,
    session_id,
    llm_result,
    turn_llm_opts,
    iteration,
  )
  const checkpoint = agent_stage(
    harness.agent,
    session_id,
    "post_tool_dispatch",
    {iteration: iteration},
  )
  const command_hold = if complete_commands != nil && !agent_stage_has_delivery(checkpoint) {
    complete_commands(totals)
  } else {
    nil
  }
  const local = command_hold?.completion_dispatch
  const completed_dispatch = local == nil ? dispatch : (dispatch ?? []) + (local.dispatch ?? [])
  const completed_calls = (type_of(tool_calls) == "list" ? tool_calls : [])
    + (local?.calls ?? [])
  // A local completion is a real tool dispatch. Its own checkpoint delivers
  // inputs queued during that call before any completion decision can run.
  const completion_checkpoint = if local != nil {
    agent_stage(harness.agent, session_id, "post_tool_dispatch", {iteration: iteration})
  } else {
    nil
  }
  const delivery_occurred = agent_stage_has_delivery(checkpoint)
    || (completion_checkpoint != nil && agent_stage_has_delivery(completion_checkpoint))
  const bridge_step_delivered = checkpoint.delivered + (completion_checkpoint?.delivered ?? 0)
  agent_emit_event(
    harness.agent,
    session_id,
    "iteration_end",
    {
      iteration: iteration,
      iteration_info: __agent_loop_iteration_info(
        harness.agent,
        harness.clock,
        session_id,
        llm_result,
        len(completed_calls),
        visible_text,
        totals,
        loop_start_ms,
      ),
    },
  )
  const denial_signature = __non_retryable_denial_signature(completed_dispatch)
  const prior_signature = __non_retryable_denial_signature(prior_dispatch)
  if denial_signature != nil && denial_signature == prior_signature {
    __emit_non_retryable_denial_cutoff(
      harness.agent,
      session_id,
      iteration,
      current_max,
      completed_dispatch,
      denial_signature,
    )
    return {
      totals: totals,
      command_hold: command_hold,
      dispatch: completed_dispatch,
      calls: completed_calls,
      bridge_step_delivered: bridge_step_delivered,
      delivery_occurred: delivery_occurred,
      terminal: {
        reason: "repeated_non_retryable_denial",
        error: {
          terminal_class: "tool_policy_rejected",
          category: "tool_rejected",
          error_category: "permission_denied",
          reason: "repeated_non_retryable_denial",
          message: "The same non-retryable tool denial occurred twice consecutively.",
        },
      },
    }
  }
  return {
    totals: totals,
    bridge_step_delivered: bridge_step_delivered,
    delivery_occurred: delivery_occurred,
    terminal: nil,
    command_hold: command_hold,
    dispatch: completed_dispatch,
    calls: completed_calls,
  }
}
