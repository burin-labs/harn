import { agent_loop_default_retry_predicate } from "std/agent/retry"
import { agent_emit_event } from "std/agent/state"
import { with_retry } from "std/llm/handlers"
import { llm_call_options } from "std/llm/options"
import { structured_output_preface } from "std/llm/prompts"
import { __wrap_llm_result } from "std/llm/safe"

fn __dispatch_reject_removed_options(options: dict?) {
  const removed = __llm_call_option_registry().removed
  for key in keys(options ?? {}) {
    if removed[key] != nil {
      throw "agent_loop: option `" + key + "` was removed — " + removed[key]
    }
  }
}

fn __dispatch_messages_include_tool_result(messages: list?) {
  if type_of(messages) != "list" {
    return false
  }
  for msg in messages {
    const role = to_string(msg?.role ?? "")
    if role == "tool" || role == "tool_result" {
      return true
    }
  }
  return false
}

fn __dispatch_value_has_payload(value: any) {
  if value == nil {
    return false
  }
  if type_of(value) == "string" {
    return trim(value) != ""
  }
  if type_of(value) == "list" {
    for item in value {
      if __dispatch_value_has_payload(item) {
        return true
      }
    }
    return false
  }
  if type_of(value) == "dict" {
    for key in keys(value) {
      // Message discriminators describe an envelope, not provider input.
      // A role/type-only message is still structurally empty.
      if key != "role" && key != "type" && __dispatch_value_has_payload(value[key]) {
        return true
      }
    }
    return false
  }
  return true
}

fn __dispatch_request_has_payload(message: any, turn_system: any, llm_opts: dict) {
  return __dispatch_value_has_payload(message)
    || __dispatch_value_has_payload(turn_system)
    || __dispatch_value_has_payload(llm_opts?.messages)
}

fn __dispatch_reject_empty_request(message: any, turn_system: any, llm_opts: dict) {
  if __dispatch_request_has_payload(message, turn_system, llm_opts) {
    return nil
  }
  throw {
    kind: "terminal",
    category: "agent_loop_protocol_failure",
    reason: "empty_provider_request",
    terminal_class: "agent_loop_protocol_failure",
    message: "agent_loop: refusing a structurally empty provider request",
  }
}

fn __dispatch_error_field(err: any, key: string, fallback: string) {
  if type_of(err) == "dict" {
    const value = err[key]
    if value != nil {
      return to_string(value)
    }
  }
  return fallback
}

fn __dispatch_provider_error(err: any, llm_opts: dict) {
  const typed = if type_of(err) == "dict" {
    err
  } else {
    {}
  }
  const message = __dispatch_error_field(err, "message", to_string(err))
  const category = __dispatch_error_field(err, "category", error_category(err))
  const reason = __dispatch_error_field(err, "reason", "")
  const kind = __dispatch_error_field(err, "kind", "")
  const provider = __dispatch_error_field(err, "provider", to_string(llm_opts?.provider ?? ""))
  const model = __dispatch_error_field(err, "model", to_string(llm_opts?.model ?? ""))
  // Preserve additive transport taxonomy fields (for example source,
  // partial, status, and retry_after_ms) while normalizing the fields the
  // agent contract guarantees and enriching them with call context.
  return typed
    + {
      category: category,
      reason: reason,
      kind: kind,
      provider: provider,
      model: model,
      message: message,
      phase: "llm_call",
      tool_format: to_string(llm_opts?.tool_format ?? ""),
      after_tool_result: __dispatch_messages_include_tool_result(llm_opts?.messages),
    }
}

fn __dispatch_emit_call_start(agent: HarnessAgent, llm_opts: dict) {
  const session_id = to_string(llm_opts?.session_id ?? "")
  if session_id == "" {
    return nil
  }
  const checkpoint = {
    kind: "llm_call_start",
    phase: "llm_call",
    iteration: to_int(llm_opts?._iteration ?? 0),
    attempt: to_int(llm_opts?._truncation_auto_continue_attempt ?? 0) + 1,
    context_overflow_recovery_attempt: to_int(llm_opts?._context_overflow_recovery_attempt ?? 0),
    provider: to_string(llm_opts?.provider ?? ""),
    model: to_string(llm_opts?.model ?? ""),
    tool_format: to_string(llm_opts?.tool_format ?? ""),
    final_wrapup: llm_opts?._final_wrapup ?? false,
    structured_output_prompt_fallback: llm_opts?._structured_output_prompt_fallback ?? false,
  }
  agent_emit_event(agent, session_id, "typed_checkpoint", checkpoint)
  return nil
}

fn __dispatch_structured_output_schema(llm_opts: dict) -> dict? {
  const output = llm_opts?.output
  if output == nil || output == "text" {
    return nil
  }
  if output == "json" {
    return {}
  }
  if type_of(output) == "dict" && output?.schema != nil {
    return output.schema
  }
  if type_of(output) == "dict" {
    return output
  }
  return nil
}

fn __dispatch_prompt_mode_request(
  harness: Harness,
  message: any,
  llm_opts: dict,
  schema: dict,
) -> dict {
  const prompt = structured_output_preface(
    harness.fs,
    schema,
    {
      template: "std/llm/prompts/structured_envelope_schema_contract.harn.prompt",
      prompt: to_string(message),
    },
  )
  return {
    message: prompt,
    options: llm_opts
      + {output: "text", _structured_output_prompt_fallback: true},
  }
}

fn __dispatch_validate_caller_result<T>(result: T) {
  if type_of(result) != "dict" {
    throw "agent_loop: llm_caller must return a dict; got " + type_of(result)
  }
  if result?.ok == nil {
    throw "agent_loop: llm_caller result missing `ok`"
  }
  if result.ok && type_of(result?.value) != "dict" {
    throw "agent_loop: llm_caller returned ok=true but `value` is not a dict"
  }
  if !result.ok && type_of(result?.status) != "string" {
    throw "agent_loop: llm_caller returned ok=false but `status` is not a string"
  }
}

/**
 * Project a raw default-transport attempt into the canonical agent caller
 * envelope. The shared LLM projector owns retry status and retryability;
 * this boundary only enriches its error with agent call context.
 *
 * @effects: []
 * @errors: []
 */
pub fn __dispatch_default_result(result: any, llm_opts: dict) -> dict {
  const projected = __wrap_llm_result(result)
  if projected.ok {
    return projected
  }
  const normalized = __dispatch_provider_error(projected.error, llm_opts)
  return projected + {stop_reason: projected.status, error: normalized}
}

fn __dispatch_default(llm: HarnessLlm, message: any, turn_system: any, llm_opts: any) {
  // Streaming and non-streaming paths intentionally return the same normalized
  // result so downstream tool dispatch does not depend on rendering mode.
  const on_delta = llm_opts?._on_delta
  const result = try {
    if type_of(on_delta) == "closure" {
      __host_llm_stream_collect(message, turn_system, llm_call_options(llm_opts), on_delta)
    } else {
      llm.call(message, turn_system, llm_call_options(llm_opts))
    }
  }
  return __dispatch_default_result(result, llm_opts)
}

/**
 * Invoke one agent LLM request through the configured caller middleware or the
 * default provider transport, emitting the canonical call-start checkpoint.
 *
 * @effects: [agent, llm.call]
 * @errors: [agent_loop]
 * @api_stability: experimental
 */
fn __dispatch_invoke_once(
  harness: Harness,
  message: any,
  turn_system: any,
  llm_opts: dict,
) -> dict {
  const call_opts = llm_call_options(llm_opts)
  const caller = llm_opts?._llm_caller
  if caller == nil {
    const retry_cfg = llm_opts?._llm_retry
    if retry_cfg != nil {
      const retrying_default = with_retry(
        harness,
        { call -> __dispatch_default(harness.llm, call.prompt, call.system, call.opts) },
        retry_cfg + {predicate: retry_cfg?.predicate ?? agent_loop_default_retry_predicate},
      )
      return retrying_default(
        {
          prompt: message,
          system: turn_system,
          opts: call_opts,
          turn: {
            iteration: llm_opts?._iteration ?? 0,
            session_id: llm_opts?.session_id ?? "",
            attempt: 1,
          },
        },
      )
    }
    return __dispatch_default(harness.llm, message, turn_system, call_opts)
  }
  const call = {
    prompt: message,
    system: turn_system,
    opts: call_opts,
    turn: {
      iteration: llm_opts?._iteration ?? 0,
      session_id: llm_opts?.session_id ?? "",
      attempt: 1,
    },
  }
  const invoked = try {
    caller(call)
  }
  if is_err(invoked) {
    throw unwrap_err(invoked)
  }
  const result = unwrap(invoked)
  __dispatch_validate_caller_result(result)
  return result
}

/**
 * Invoke one agent LLM request, degrading a rejected structured-output
 * transport to the shared prompt-mode contract exactly once.
 *
 * The retry is keyed on the request's structured `output` contract and a
 * failed provider envelope, never on provider error prose. The fallback
 * removes the provider response format, carries the same schema in the prompt,
 * and leaves ordinary text requests unchanged.
 *
 * @effects: [agent, llm.call]
 * @errors: [agent_loop]
 * @api_stability: experimental
 */
pub fn agent_invoke_llm(harness: Harness, message: any, turn_system: any, llm_opts: dict) -> dict {
  __dispatch_reject_removed_options(llm_opts)
  __dispatch_reject_empty_request(message, turn_system, llm_opts)
  __dispatch_emit_call_start(harness.agent, llm_opts)
  const first = __dispatch_invoke_once(harness, message, turn_system, llm_opts)
  const schema = __dispatch_structured_output_schema(llm_opts)
  if first.ok || schema == nil || (llm_opts?._structured_output_prompt_fallback ?? false) {
    return first
  }
  const fallback = __dispatch_prompt_mode_request(harness, message, llm_opts, schema)
  __dispatch_emit_call_start(harness.agent, fallback.options)
  return __dispatch_invoke_once(harness, fallback.message, turn_system, fallback.options)
    + {_structured_output_prompt_fallback: true}
}
