/** Both failures are retained when notifying a terminal callback also fails. */
pub type AgentLoopTerminalCallbackCause = {terminal_error: unknown, callback_error: unknown}

pub type AgentLoopTerminalCallbackFailure = {
  kind: "agent_loop_terminal_callback_failed",
  category: "internal",
  reason: "terminal_callback_failed",
  message: string,
  cause: AgentLoopTerminalCallbackCause,
}

/** Dispatch refused before contacting a provider. */
pub type AgentLoopProtocolFailure = {
  kind: "terminal",
  category: "agent_loop_protocol_failure",
  reason: "empty_provider_request",
  terminal_class: "agent_loop_protocol_failure",
  message: string,
}

/** A typed cancellation outcome propagated from an auxiliary evaluation. */
pub type AgentLoopCancelledFailure = {category: "cancelled", message: string}

pub type AgentLoopClassifierConfigDetails = {
  field?: string,
  expected?: string,
  actual_type?: string,
  actual?: unknown,
  min?: float,
  max?: float,
}

/** Invalid settings are terminal configuration errors, not classifier refusals. */
pub type AgentLoopClassifierConfigFailure = AgentLoopClassifierConfigDetails \
  & {
  error: string,
  category: "invalid_config",
  component: "missing_tool_call_classifier",
  message: string,
}

pub type AgentLoopFailure = string \
  | AgentLoopTerminalCallbackFailure \
  | AgentLoopProtocolFailure \
  | AgentLoopCancelledFailure \
  | AgentLoopClassifierConfigFailure
