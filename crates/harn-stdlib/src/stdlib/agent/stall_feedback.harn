import { AgentStallWarning } from "std/agent/stall_types"

/**
 * Render feedback from the detector's observed warning, without predicting future outcomes.
 * @effects: []
 * @errors: []
 */
pub fn __agent_stall_feedback_text(warning: AgentStallWarning) -> string {
  return render_stdlib_prompt("std/agent/prompts/stall_feedback.harn.prompt", warning).trim()
}
