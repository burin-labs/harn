import {
  MonologueActuationConfig,
  MonologueActuationState,
} from "std/agent/monologue_actuation_types"

/** Normalized internal configuration for the agent stall detector. */
pub type AgentStallConfig = {
  enabled: bool,
  threshold: int,
  inject_feedback: bool,
  max_feedback: int,
  exempt_tools: list,
  include_arguments: bool,
  repeat_same_observation: int,
  repeat_success: int,
  repeat_same_error: int,
  no_progress_messages: int,
  ping_pong_cycles: int,
  repeat_context_window_error: int,
  hard_stop_after_trips: int,
  repair_aware: bool,
  stuck_same_diagnostic_after: int,
  post_edit_reverify: bool,
  no_net_progress_extend_guard: bool,
  no_net_progress_extend_after: int,
  no_net_progress_hard_cap_after: int,
  reserved_terminal_verify: bool,
  reserved_terminal_verify_iterations: int,
  zero_write_terminal_verify: bool,
  verify_state_streak: int,
  verify_state_stall_turns: int,
  verify_state_recurrence_hard: int,
  no_verifier_progress_limit: int,
  monologue_actuation: MonologueActuationConfig,
  progress_signal?: any,
  remediation_delivered?: any,
  action_signal?: any,
  turns_since_clean_verify?: int,
  no_net_progress_predicates: dict,
}

/** One normalized stall warning and its escalation evidence. */
pub type AgentStallWarning = {
  iteration: int,
  tool_name: string,
  repeat_count: int,
  threshold: int,
  arguments_digest: string,
  signature_digest: string,
  pattern: string,
  signature: string,
  count: int,
  consecutive_trips: int,
  hard_stop: bool,
  arguments?: dict,
  diagnostic_class?: string,
  diagnostic_signature?: string,
  diagnostic_snippet?: string,
  remediation_delivered?: bool,
}

/** Durable in-run detector state across tool and verification observations. */
pub type AgentStallState = {
  last_signature: string,
  streak: int,
  warnings: list<AgentStallWarning>,
  repeated_tool_calls: int,
  feedback_count: int,
  last_observation_signature: string,
  last_outcome_kind: string,
  same_observation_streak: int,
  same_success_streak: int,
  same_error_streak: int,
  context_window_error_streak: int,
  no_progress_streak: int,
  ping_pong_a: string,
  ping_pong_b: string,
  ping_pong_alternations: int,
  consecutive_trips: int,
  action_flail_trips: int,
  hard_stop: bool,
  last_diagnostic_class: string,
  last_diagnostic_signature: string,
  last_diagnostic_snippet: string,
  last_diagnostic_delta_current: dict,
  last_diagnostic_delta_status: string,
  last_diagnostic_delta_reason: string,
  write_epoch: int,
  same_diagnostic_streak: int,
  failing_verify_turns: int,
  turns_since_clean_verify: int,
  edit_since_failure: bool,
  reverify_owed: bool,
  verified_write_epoch: int,
  verify_state_seen: bool,
  verify_state_high: float,
  verify_turns_since_advance: int,
  verify_wrote_since_advance: bool,
  verify_signature_counts: dict,
  remediation_delivered_signature: string,
  remediation_delivered_count: int,
  monologue_actuation: MonologueActuationState,
}

/** Result of folding one turn through the configured stall detectors. */
pub type AgentStallObservation = {
  state: AgentStallState,
  enabled: bool,
  warning: AgentStallWarning?,
  feedback_deferred: bool,
  config: AgentStallConfig,
  hard_stop: bool,
}
