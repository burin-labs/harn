/**
 * std/testing — helpers for writing Harn tests.
 *
 * ## Argument order
 *
 * Every assertion here takes the thing under test FIRST:
 *
 *     assert_eq(actual, expected)
 *     assert_matches(actual, pattern)
 *     assert_contains(haystack, needle)
 *     assert_host_call_count(cap, op, expected_count)
 *
 * This is one rule with no exceptions, and it is worth stating loudly because
 * getting it wrong is invisible: swap the arguments of an equality assertion
 * and it still passes and fails in all the same cases — it just prints the two
 * halves of every failure the wrong way round, and sends the reader looking for
 * a bug in the value that was correct. The rule is pinned by a test on the
 * rendered failure text (`assert_eq_reads_argument_one_as_actual_and_two_as_
 * expected`), not by this comment.
 *
 * The reason for actual-first rather than expected-first: the subject of the
 * sentence goes first. "Assert THIS THING equals four" reads in the order it is
 * written, and it is the order that keeps `assert_eq(x, 4)` consistent with
 * one-sided checks like `assert_nil(x)` and `assert_true(x)`, where there is no
 * expected value to put first at all.
 *
 * `assert_snapshot(name, actual)` is the one shape that leads with something
 * else — its expected value lives in a file, so there is no second value to
 * order against, and the name is what identifies the snapshot.
 */
import { unified_diff } from "std/diff"

let __testing_step_events = []

fn params_subset_match(expected, actual) {
  if expected == nil {
    return true
  }
  if type_of(expected) != "dict" || type_of(actual) != "dict" {
    return expected == actual
  }
  for entry in entries(expected) {
    if actual[entry.key] != entry.value {
      return false
    }
  }
  return true
}

/**
 * clear_host_mocks.
 *
 * @effects: []
 * @errors: []
 */
pub fn clear_host_mocks() {
  return host_mock_clear()
}

/**
 * mock_host_result.
 *
 * @effects: []
 * @errors: []
 */
pub fn mock_host_result(cap: string, op: string, result, params = nil, unregistered_ok = false) {
  let config = {result: result}
  if params != nil {
    config = config + {params: params}
  }
  if unregistered_ok {
    config = config + {unregistered_ok: true}
  }
  return host_mock(cap, op, config)
}

/**
 * mock_host_error.
 *
 * @effects: []
 * @errors: []
 */
pub fn mock_host_error(
  cap: string,
  op: string,
  message: string,
  params = nil,
  unregistered_ok = false,
) {
  let config = {error: message}
  if unregistered_ok {
    config = config + {unregistered_ok: true}
  }
  if params == nil {
    return host_mock(cap, op, config)
  }
  return host_mock(cap, op, config + {params: params})
}

/**
 * mock_host_response.
 *
 * @effects: []
 * @errors: []
 */
pub fn mock_host_response(cap: string, op: string, config) {
  return host_mock(cap, op, config)
}

/**
 * host_calls.
 *
 * @effects: []
 * @errors: []
 */
pub fn host_calls() {
  return host_mock_calls()
}

/**
 * host_calls_for.
 *
 * @effects: []
 * @errors: []
 */
pub fn host_calls_for(cap: string, op: string) {
  return host_mock_calls()
    .filter({ call -> return call?.capability == cap && call?.operation == op })
}

/**
 * host_call_count.
 *
 * @effects: []
 * @errors: []
 */
pub fn host_call_count() -> int {
  return len(host_mock_calls())
}

/**
 * host_call_count_for.
 *
 * @effects: []
 * @errors: []
 */
pub fn host_call_count_for(cap: string, op: string) -> int {
  return len(host_calls_for(cap, op))
}

/**
 * host_was_called.
 *
 * @effects: []
 * @errors: []
 */
pub fn host_was_called(cap: string, op: string, expected_params) -> bool {
  for call in host_calls_for(cap, op) {
    if params_subset_match(expected_params, call?.params) {
      return true
    }
  }
  return false
}

/**
 * assert_host_called.
 *
 * @effects: []
 * @errors: []
 */
pub fn assert_host_called(cap: string, op: string, params = nil, message = nil) {
  if host_was_called(cap, op, params) {
    return nil
  }
  const default_message = if params == nil {
    "Expected host call " + cap + "." + op + " to be recorded"
  } else {
    "Expected host call " + cap + "." + op + " with params " + to_string(params) + " to be recorded"
  }
  require false, message ?? default_message
  return nil
}

/**
 * Assert `cap`.`op` was called exactly `expected_count` times. Returns the
 * actual count.
 *
 * The subject under test (`cap`, `op`) comes first, matching
 * `assert_host_called` and every other assertion in this module — see the
 * argument-order note at the top of the file.
 *
 * @effects: []
 * @errors: []
 * @example: assert_host_call_count("workspace", "read_text", 1)
 */
pub fn assert_host_call_count(cap: string, op: string, expected_count: int, message = nil) {
  const actual_count = host_call_count_for(cap, op)
  const default_message = "assert_host_call_count: expected "
    + to_string(expected_count)
    + " calls to "
    + cap
    + "."
    + op
    + ", got "
    + to_string(actual_count)
  require actual_count == expected_count, message ?? default_message
  return actual_count
}

/**
 * assert_no_host_calls.
 *
 * @effects: []
 * @errors: []
 */
pub fn assert_no_host_calls(message = nil) {
  const actual_count = host_call_count()
  require actual_count == 0, (message ?? "Expected no host calls, got ") + to_string(actual_count)
  return actual_count
}

/**
 * Apply a single host-mock fixture entry. Each entry is a dict with:
 *   { capability, operation, result?, error?, params?, unregistered_ok? }
 *
 * Hostlib builtins that take a request dict also honor the same mock registry
 * by module/method, for example `{capability: "tools", operation:
 * "run_command"}` for `hostlib_tools_run_command(...)`. During the
 * process-exec migration, `hostlib_tools_run_command` also accepts existing
 * `{capability: "process", operation: "exec"}` mocks when params match.
 *
 * `error` (string) takes precedence over `result` so an entry may
 * either mock a successful response or an exception, never both.
 */
fn apply_host_mock_entry(entry) {
  if type_of(entry) != "dict" {
    throw "with_host_mocks: each entry must be a dict, got " + type_of(entry)
  }
  const cap = entry?.capability
  const op = entry?.operation
  if cap == nil || op == nil {
    throw "with_host_mocks: each entry must include 'capability' and 'operation'"
  }
  let config = {}
  if entry?.error != nil {
    config = config + {error: entry.error}
  } else {
    config = config + {result: entry?.result}
  }
  if entry?.params != nil {
    config = config + {params: entry.params}
  }
  if entry?.unregistered_ok {
    config = config + {unregistered_ok: true}
  }
  return mock_host_response(cap, op, config)
}

/**
 * Run `body` with a fresh host-mock scope. Each entry in `mocks` is
 * applied via `mock_host_result` / `mock_host_error`, the body runs,
 * and the prior host-mock state plus call log is restored on exit —
 * even if the body throws. Nested scopes stack: an inner
 * `with_host_mocks` does not leak into the outer scope.
 *
 * Returns whatever `body` returns. Re-raises any thrown error after
 * cleanup.
 *
 * @effects: []
 * @errors: []
 */
pub fn with_host_mocks(mocks, body) {
  host_mock_push_scope()
  // Registration runs inside the same try/catch as the body so a
  // malformed entry takes the cleanup path instead of leaking the
  // pushed scope.
  try {
    for entry in mocks ?? [] {
      apply_host_mock_entry(entry)
    }
    const result = __testing_call_body(body)
    host_mock_pop_scope()
    return result
  } catch (e) {
    host_mock_pop_scope()
    throw e
  }
}

fn __testing_is_callable(value) -> bool {
  const kind = type_of(value)
  return kind == "function" || kind == "closure" || kind == "fn"
}

fn __testing_step_event_record(ctx) {
  let record = {
    event: ctx?.event,
    target: ctx?.target,
    persona: ctx?.persona,
    step_name: ctx?.step?.name,
    function: ctx?.step?.function,
    args: ctx?.step?.args ?? [],
  }
  if ctx?.output != nil {
    record = record + {output: ctx.output}
  }
  return record
}

fn __testing_step_events_for(kind) {
  let out = []
  for event in __testing_step_events {
    if event.event == kind {
      out = out.push(event)
    }
  }
  return out
}

fn __testing_event_matches(candidate, predicate) -> bool {
  if predicate == nil {
    return true
  }
  if __testing_is_callable(predicate) {
    return predicate(candidate)
  }
  if type_of(predicate) == "dict" {
    return params_subset_match(predicate, candidate)
  }
  return candidate == predicate
}

fn __testing_handoff_target_matches(handoff, target) -> bool {
  if target == nil {
    return true
  }
  const resolved = handoff?.target_persona_or_human ?? {}
  return resolved?.id == target
    || resolved?.label == target
    || resolved?.kind == target
    || handoff?.target == target
    || handoff?.target_persona == target
}

fn __testing_golden_match(expected, actual) -> bool {
  if expected == "<ms>" {
    const kind = type_of(actual)
    return kind == "int" || kind == "float"
      || (kind == "string" && len(regex_captures("^[0-9]+$", actual)) == 1)
  }
  if expected == "<uuid>" {
    return type_of(actual) == "string"
      && len(
      regex_captures(
        "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        actual,
      ),
    )
      == 1
  }
  if expected == "<any>" {
    return actual != nil
  }
  if type_of(expected) != type_of(actual) {
    return false
  }
  if type_of(expected) == "dict" {
    for entry in entries(expected) {
      if !__testing_golden_match(entry.value, actual[entry.key]) {
        return false
      }
    }
    return true
  }
  if type_of(expected) == "list" {
    if len(expected) != len(actual) {
      return false
    }
    let idx = 0
    while idx < len(expected) {
      if !__testing_golden_match(expected[idx], actual[idx]) {
        return false
      }
      idx += 1
    }
    return true
  }
  return expected == actual
}

/**
 * llm_calls. Returns the LLM mock call log for the current scope.
 *
 * @effects: []
 * @errors: []
 */
pub fn llm_calls() {
  return llm_mock_calls()
}

/**
 * llm_call_count. Number of LLM calls recorded in the current scope.
 *
 * @effects: []
 * @errors: []
 */
pub fn llm_call_count() -> int {
  return len(llm_mock_calls())
}

/**
 * Run `body` with a fresh LLM-mock scope. Each entry in `mocks` is
 * pushed via `llm_mock(...)` and consumed in order by the body. The
 * prior LLM-mock queue plus call log is restored on exit — even if
 * the body throws. Nested scopes stack the same way as
 * `with_host_mocks`.
 *
 * Returns whatever `body` returns. Re-raises any thrown error after
 * cleanup.
 *
 * @effects: []
 * @errors: []
 */
pub fn with_llm_mocks(mocks, body) {
  llm_mock_push_scope()
  try {
    for entry in mocks ?? [] {
      if type_of(entry) != "dict" {
        throw "with_llm_mocks: each entry must be a dict, got " + type_of(entry)
      }
      llm_mock(entry)
    }
    const result = __testing_call_body(body)
    llm_mock_pop_scope()
    return result
  } catch (e) {
    llm_mock_pop_scope()
    throw e
  }
}

/**
 * Unified scoped fixture for tests that mix host and LLM mocks.
 * `config` is a dict with optional `host_mocks` and `llm_mocks` lists,
 * each shaped like the entries accepted by `with_host_mocks` and
 * `with_llm_mocks`. Both scopes are pushed before the body runs and
 * popped (in reverse order) after — including on thrown errors.
 *
 * @effects: []
 * @errors: []
 */
pub fn with_mocks(config, body) {
  const host_entries = config?.host_mocks ?? []
  const llm_entries = config?.llm_mocks ?? []
  host_mock_push_scope()
  llm_mock_push_scope()
  // Wrap registration *and* body together so a malformed entry
  // (e.g. a missing capability) still triggers the same restore path
  // that a thrown body would. Without this, an exception during
  // registration would leak both pushed scopes.
  try {
    for entry in host_entries {
      apply_host_mock_entry(entry)
    }
    for entry in llm_entries {
      if type_of(entry) != "dict" {
        throw "with_mocks: each llm_mocks entry must be a dict, got " + type_of(entry)
      }
      llm_mock(entry)
    }
    const result = __testing_call_body(body)
    llm_mock_pop_scope()
    host_mock_pop_scope()
    return result
  } catch (e) {
    llm_mock_pop_scope()
    host_mock_pop_scope()
    throw e
  }
}

/**
 * Clear recorded persona step events.
 *
 * @effects: []
 * @errors: []
 */
pub fn step_events_clear() {
  __testing_step_events = []
  return nil
}

/**
 * Return recorded PreStep/PostStep payloads captured by step_assertions_begin.
 *
 * @effects: []
 * @errors: []
 */
pub fn step_events() {
  return __testing_step_events
}

/**
 * Start recording persona step hook payloads for Harn-level tests.
 *
 * This resets existing persona hooks because the helper owns the hook
 * registrations during a conformance fixture. Register any fixture-specific
 * hooks after calling this helper.
 *
 * @effects: []
 * @errors: []
 */
pub fn step_assertions_begin(persona_pattern = "*") {
  clear_persona_hooks()
  step_events_clear()
  register_persona_hook(
    persona_pattern,
    "PreStep",
    { ctx ->
      __testing_step_events = __testing_step_events.push(__testing_step_event_record(ctx))
      return nil
    },
  )
  register_persona_hook(
    persona_pattern,
    "PostStep",
    { ctx ->
      __testing_step_events = __testing_step_events.push(__testing_step_event_record(ctx))
      return nil
    },
  )
  return nil
}

/**
 * Stop recording persona step hook payloads.
 *
 * @effects: []
 * @errors: []
 */
pub fn step_assertions_end() {
  clear_persona_hooks()
  return nil
}

/**
 * Assert the exact ordered list of @step names that ran.
 *
 * @effects: []
 * @errors: []
 */
pub fn assert_steps_ran(expected_names, message = nil) {
  let actual = []
  for event in __testing_step_events_for("PreStep") {
    actual = actual.push(event.step_name)
  }
  for name in expected_names {
    require contains(actual, name), (message ?? "step '") + name + "' not callable: not annotated `@step`"
  }
  require actual == expected_names, message ?? "step order mismatch"
  return actual
}

/**
 * Assert that a step received an input matching a closure, dict subset, or value.
 *
 * @effects: []
 * @errors: []
 */
pub fn assert_step_received(step_name, predicate = nil, message = nil) {
  for event in __testing_step_events_for("PreStep") {
    if event.step_name == step_name && __testing_event_matches(event, predicate) {
      return event
    }
  }
  require false, (message ?? "step '") + step_name + "' did not receive the expected input"
  return nil
}

/**
 * Assert that a step emitted an output matching a closure, dict subset, or value.
 *
 * @effects: []
 * @errors: []
 */
pub fn assert_step_emitted(step_name, predicate = nil, message = nil) {
  for event in __testing_step_events_for("PostStep") {
    if event.step_name == step_name && __testing_event_matches(event, predicate) {
      return event
    }
  }
  require false, (message ?? "step '") + step_name + "' did not emit the expected output"
  return nil
}

/**
 * Assert that a handoff list or run record contains a handoff of kind and optional target.
 *
 * @effects: []
 * @errors: []
 */
pub fn assert_handoff_emitted(source, handoff_kind, target = nil) {
  const handoffs = source?.handoffs ?? source
  for item in handoffs ?? [] {
    if item?.kind == handoff_kind && __testing_handoff_target_matches(item, target) {
      return item
    }
  }
  const suffix = if target == nil {
    ""
  } else {
    " to " + to_string(target)
  }
  require false, "handoff '" + handoff_kind + "'" + suffix + " was not emitted"
  return nil
}

/**
 * Assert the value at RFC 6901 JSON Pointer `path` inside a receipt or
 * envelope. Returns the value found there.
 *
 * On a mismatch the failure carries the full `assert_eq` diff of that field, so
 * a deep pointer into a large receipt still says exactly what differs.
 *
 * @effects: []
 * @errors: []
 * @example: assert_receipt_field(receipt, "/outcome/status", "ok")
 */
pub fn assert_receipt_field(receipt, path: string, expected, message = nil) {
  const actual = json_pointer(receipt, path)
  const diff = value_diff(actual, expected)
  require diff == nil, message
    ?? ("assert_receipt_field: the receipt field " + path + " does not match.\n" + to_string(diff))
  return actual
}

/**
 * Assert an actual transcript-like value matches a structured golden.
 *
 * The golden may contain `<ms>`, `<uuid>`, or `<any>` sentinel strings. Dict
 * goldens are subset matches, so a test can pin the payload fields that matter
 * without pinning every implementation detail.
 *
 * Takes the actual value first, like every other assertion here — see the
 * argument-order note at the top of the file.
 *
 * @effects: []
 * @errors: []
 * @example: assert_golden_transcript(events, [{kind: "step", at: "<ms>"}])
 */
pub fn assert_golden_transcript(actual, golden, message = nil) {
  require __testing_golden_match(golden, actual), message
    ?? ("assert_golden_transcript: the value does not match the golden.\n    golden    "
    + to_string(golden)
    + "\n    actual    "
    + to_string(actual))
  return actual
}

// -------------------------------------------------------------------------------------------------

// LLM mock turn builders
//
// `with_llm_mocks` / `with_mocks` already accept a list of LLM response
// dicts, but hand-building `{tool_calls: [{id, name, arguments}]}` and
// `{text: "##DONE##"}` literals is the reason most fixtures still reach
// for the raw `llm_mock_clear()` + sequential `llm_mock(...)` form. These
// constructors make a scoped script read as one ordered list of turns:
//
//   with_llm_mocks(
//     [llm_tool_call("write_note", {path: "n.txt"}), llm_done()],
//     { _ -> run_agent() },
//   )

// -------------------------------------------------------------------------------------------------

/**
 * Build a plain-text assistant turn for an LLM mock script.
 *
 * @effects: []
 * @errors: []
 * @example: llm_text("Sure, here is the answer.")
 */
pub fn llm_text(text: string) -> dict {
  return {text: text}
}

/**
 * Build an assistant turn that streams its visible text as an ordered list of
 * chunks. When consumed through a streaming caller (e.g. `agent_loop`'s
 * `on_delta` seam) each chunk is emitted as a separate delta, in order; a
 * non-streaming caller sees only the flat text, which equals the concatenation
 * of the chunks. Use it to exercise token-stream harnesses deterministically.
 *
 * @effects: []
 * @errors: []
 * @example: llm_stream_text(["Hello ", "wor", "ld"])
 */
pub fn llm_stream_text(chunks: list) -> dict {
  return {stream_chunks: chunks}
}

/**
 * Build the terminal "done" turn for an agent-loop LLM mock script. The
 * default marker matches the `##DONE##` sentinel agent loops recognize;
 * pass a custom marker when the loop under test uses a different one.
 *
 * @effects: []
 * @errors: []
 */
pub fn llm_done(marker: string = "##DONE##") -> dict {
  return {text: marker}
}

/**
 * Build an assistant turn that fails the LLM call with `message`. Mirrors
 * the `{error: ...}` shape `llm_mock` accepts so error-path tests can be
 * scripted alongside successful turns.
 *
 * @effects: []
 * @errors: []
 * @example: llm_error("rate limited")
 */
pub fn llm_error(message: string) -> dict {
  return {error: message}
}

/**
 * Build a single-tool-call assistant turn. `id` defaults to the tool name
 * so simple scripts need not invent call ids; pass an explicit `id` when a
 * test asserts on it or issues the same tool twice in one turn.
 *
 * @effects: []
 * @errors: []
 * @example: llm_tool_call("write_note", {path: "n.txt"})
 */
pub fn llm_tool_call(name: string, args = {}, id = nil) -> dict {
  return {tool_calls: [{id: id ?? name, name: name, arguments: args ?? {}}]}
}

/**
 * Build an assistant turn that issues several tool calls in parallel.
 * Each entry is `{name, args?, id?}`; a missing `id` falls back to
 * `name + "_" + index` so parallel calls to the same tool stay distinct.
 *
 * @effects: []
 * @errors: []
 * @example: llm_tool_calls([{name: "a", args: {}}, {name: "b"}])
 */
pub fn llm_tool_calls(calls) -> dict {
  let out = []
  let index = 0
  for call in calls ?? [] {
    const resolved_id = call?.id ?? (to_string(call?.name) + "_" + to_string(index))
    out = out.push({id: resolved_id, name: call?.name, arguments: call?.args ?? {}})
    index = index + 1
  }
  return {tool_calls: out}
}

/**
 * Alias for `with_llm_mocks` that reads as scripting an ordered list of
 * assistant turns. Pair it with the `llm_*` turn builders.
 *
 * @effects: []
 * @errors: []
 * @example: with_llm_script([llm_text("hi"), llm_done()], body)
 */
pub fn with_llm_script(turns, body) {
  return with_llm_mocks(turns, body)
}

// -------------------------------------------------------------------------------------------------

// Error assertions
//
// Collapses the `try { ... }` + `is_err` + `unwrap_err` + `to_string` +
// `contains` chain that fixtures hand-roll to assert a call rejects.

// -------------------------------------------------------------------------------------------------

/**
 * Run `body` and assert it throws. Returns the thrown error so callers can
 * make further assertions on it. Fails if the body returns normally.
 *
 * @effects: []
 * @errors: []
 * @example: assert_throws({ -> parse("") })
 */
pub fn assert_throws(body, message = nil) -> any {
  let threw = false
  let captured = nil
  try {
    body()
  } catch (e) {
    threw = true
    captured = e
  }
  require threw, message ?? "assert_throws: expected the body to throw, but it returned normally"
  return captured
}

/**
 * Run `body`, assert it throws, and assert the rendered error contains
 * `substring`. Returns the thrown error. Replaces the
 * try/is_err/unwrap_err/to_string/contains chain with one call.
 *
 * @effects: []
 * @errors: []
 * @example: assert_error_contains({ -> connect("") }, "url is required")
 */
pub fn assert_error_contains(body, substring: string, message = nil) -> any {
  const captured = assert_throws(body, message)
  const rendered = to_string(captured)
  require contains(rendered, substring), message
    ?? ("assert_error_contains: expected thrown error to contain "
    + to_string(substring)
    + ", got: "
    + rendered)
  return captured
}

/**
 * Run `body` and assert it does NOT throw, returning its value. Useful for
 * pinning a regression where a previously-rejected input must now succeed.
 *
 * @effects: []
 * @errors: []
 * @example: assert_no_throw({ -> parse("ok") })
 */
pub fn assert_no_throw(body, message = nil) -> any {
  // NB: assign-then-return rather than `return body()` inside the try.
  // A throw inside `return <expr>` within a try is not observed by the
  // local catch, so the assign-then-return shape is required for the
  // catch to fire.
  let value = nil
  try {
    value = body()
  } catch (e) {
    require false, message ?? ("assert_no_throw: expected the body not to throw, but it threw: " + to_string(e))
  }
  return value
}

// -------------------------------------------------------------------------------------------------

// Value assertions
//
// `assert`, `assert_eq`, `assert_ne`, `assert_approx`, `assert_matches`, and
// `value_diff` are implemented in Rust (`crates/harn-vm/src/stdlib/
// testing.rs`) because they walk the runtime representation of a value, which
// Harn source cannot reach. They are callable with no import at all, and this
// module re-exports them so `import { assert_eq } from "std/testing"` resolves
// too — a reader should not have to know which side of that line an assertion
// falls on. See `harn_stdlib::builtin_reexports`.
//
// The functions below fill the remaining shapes test authors otherwise
// hand-roll with a bare `assert(cond, msg)`: nil checks, strict booleans (vs.
// merely-truthy), and haystack/needle containment for strings and lists. Each
// names the offending value(s) in its default failure message rather than
// saying "assertion failed" and leaving the author to add logging.

// -------------------------------------------------------------------------------------------------

/**
 * Assert `value` is `nil`.
 *
 * @effects: []
 * @errors: []
 * @example: assert_nil(cache_lookup("missing-key"))
 */
pub fn assert_nil(value: any, message = nil) -> nil {
  require value == nil, message ?? ("assert_nil: expected nil, got " + to_string(value))
  return nil
}

/**
 * Assert `value` is not `nil`. Returns `value` so callers can chain further
 * assertions or use the result directly.
 *
 * @effects: []
 * @errors: []
 * @example: const id = assert_not_nil(created.id)
 */
pub fn assert_not_nil(value: any, message = nil) -> any {
  require value != nil, message ?? "assert_not_nil: expected a non-nil value, got nil"
  return value
}

/**
 * Assert `value` is `true`. Prefer this over bare `assert(cond)` when the
 * condition itself IS the thing under test: `value` is typed `bool`, so a
 * caller passing a non-bool (e.g. a dict) is a compile-time type error
 * instead of the check silently passing on any truthy value.
 *
 * @effects: []
 * @errors: []
 * @example: assert_true(is_ready())
 */
pub fn assert_true(value: bool, message = nil) -> nil {
  require value, message ?? ("assert_true: expected true, got " + to_string(value))
  return nil
}

/**
 * Assert `value` is `false`. The `assert_true` counterpart; see there for
 * why the `bool` type annotation matters.
 *
 * @effects: []
 * @errors: []
 * @example: assert_false(is_ready())
 */
pub fn assert_false(value: bool, message = nil) -> nil {
  require !value, message ?? ("assert_false: expected false, got " + to_string(value))
  return nil
}

/**
 * Assert `haystack` contains `needle`: a substring check for `string`, or
 * membership by value equality for `list` — the same semantics as the
 * `contains` builtin, with a default message naming both sides. Returns
 * `haystack` so callers can chain further assertions.
 *
 * @effects: []
 * @errors: []
 * @example: assert_contains("hello world", "world")
 * @example: assert_contains([1, 2, 3], 2)
 */
pub fn assert_contains(haystack: string | list, needle: any, message = nil) -> any {
  require contains(haystack, needle), message
    ?? ("assert_contains: expected " + to_string(haystack) + " to contain " + to_string(needle))
  return haystack
}

// -------------------------------------------------------------------------------------------------

// Filesystem fixtures
//
// A scoped temp workspace with guaranteed cleanup — the fs counterpart to
// `with_host_mocks`. `with_fs` additionally seeds the workspace from a
// `{ relative_path: contents }` dict so a test states its starting tree
// declaratively instead of hand-writing mkdir/write/cleanup.

// -------------------------------------------------------------------------------------------------

fn __testing_fs_content(value) -> string {
  if type_of(value) == "string" {
    return value
  }
  return json_stringify(value)
}

/**
 * Create a unique temp directory, pass its path to `body`, and delete it
 * recursively on exit — even if `body` throws. Returns whatever `body`
 * returns.
 *
 * @effects: []
 * @errors: []
 * @example: with_temp_dir({ dir -> harness.fs.write_text(dir + "/x", "1") })
 */
pub fn with_temp_dir(body) -> any {
  const dir = harness.fs.temp_dir() + "/harn-test-" + uuid_v7()
  harness.fs.mkdir(dir)
  try {
    const result = body(dir)
    harness.fs.delete(dir)
    return result
  } catch (e) {
    harness.fs.delete(dir)
    throw e
  }
}

/**
 * Like `with_temp_dir`, but first seeds the workspace from `files`, a
 * `{ relative_path: contents }` dict. String contents are written
 * verbatim; any other value is JSON-encoded. Parent directories are
 * created automatically, so `{ "a/b/c.txt": "hi" }` just works. The temp
 * directory path is passed to `body` and removed on exit.
 *
 * @effects: []
 * @errors: []
 * @example: with_fs({"in.txt": "hello"}, { dir -> harness.fs.read_text(dir + "/in.txt") })
 */
pub fn with_fs(files, body) -> any {
  return with_temp_dir(
    { dir ->
      for entry in entries(files ?? {}) {
        const full = dir + "/" + entry.key
        harness.fs.mkdir(dirname(full))
        harness.fs.write_text(full, __testing_fs_content(entry.value))
      }
      body(dir)
    },
  )
}

/**
 * One declarative block for tests that mix mocks and a seeded workspace.
 * `config` accepts:
 *   * `host` — host-mock entries (same shape as `with_host_mocks`)
 *   * `llm`  — LLM-mock turns (build them with the `llm_*` constructors)
 *   * `fs`   — a `{ relative_path: contents }` seed dict (see `with_fs`)
 *   * `temp_dir` — set `true` for an empty temp workspace without `fs`
 *
 * `body` receives a context dict `{dir}` (the temp directory, or nil when
 * neither `fs` nor `temp_dir` is requested). All scopes are torn down in
 * reverse order on exit, including on a thrown error.
 *
 * @effects: []
 * @errors: []
 * @example: with_scenario({llm: [llm_done()], fs: {"a.txt": "1"}}, { s -> run(s.dir) })
 */
pub fn with_scenario(config, body) {
  const mock_config = {host_mocks: config?.host ?? [], llm_mocks: config?.llm ?? []}
  if config?.fs != nil {
    return with_fs(config.fs, { dir -> with_mocks(mock_config, { _ -> body({dir: dir}) }) })
  }
  if config?.temp_dir {
    return with_temp_dir({ dir -> with_mocks(mock_config, { _ -> body({dir: dir}) }) })
  }
  return with_mocks(mock_config, { _ -> body({dir: nil}) })
}

// -------------------------------------------------------------------------------------------------

// Golden-file snapshots
//
// `assert_snapshot` is the file-backed counterpart to
// `assert_golden_transcript`: instead of an inline expected value it pins
// `actual` against a committed golden file, so large or evolving outputs live
// on disk next to the test. Modeled on Jest's `toMatchSnapshot` and insta —
// running with `HARN_UPDATE_SNAPSHOTS=1` writes the golden; every other run
// asserts equality and fails with a unified diff on drift.
//
// CI safety is the load-bearing property. The #1 documented snapshot failure
// mode is a broken output silently rubber-stamping itself green because a
// golden was auto-created or auto-updated on the CI machine. So writes require
// an EXPLICIT `HARN_UPDATE_SNAPSHOTS` signal AND are refused whenever a `CI`
// signal is present (insta and Jest `--ci` enforce the same rule). There is
// deliberately no programmatic force-write / force-pass option: under CI a
// missing or drifted golden is always a hard failure, never a write.

// -------------------------------------------------------------------------------------------------

/** Truthy for an env var set to anything other than "", "0", or "false". */
fn __testing_env_flag(name: string) -> bool {
  const raw = harness.env.get(name)
  return raw != nil && raw != "" && raw != "0" && raw != "false"
}

/**
 * An update was requested via `HARN_UPDATE_SNAPSHOTS` (the opt-in write
 * signal; `harn test` exposes no snapshot flag today). Requesting an update
 * does not by itself permit a write — see `__testing_snapshot_may_write`.
 */
fn __testing_snapshot_update_requested() -> bool {
  return __testing_env_flag("HARN_UPDATE_SNAPSHOTS")
}

/**
 * Detect CI via the de-facto-standard `CI` env var (set by GitHub Actions and
 * every major CI), plus a Harn-specific `HARN_CI` override. In CI the
 * `HARN_UPDATE_SNAPSHOTS` env trigger is ignored, so a leaked update flag can
 * never make a broken output silently rewrite its own golden.
 */
fn __testing_running_in_ci() -> bool {
  return __testing_env_flag("CI") || __testing_env_flag("HARN_CI")
}

/**
 * A golden may be written when either:
 *   - the caller passed `options.update = true` — an explicit, in-source
 *     programmatic seam (used by this module's own tests to drive the write
 *     path against a temp golden); it is honored even under CI because it is
 *     deliberate code, not the accidental env-leak vector, or
 *   - `HARN_UPDATE_SNAPSHOTS` is set AND we are not in CI. The env trigger is
 *     the convenient local flow; CI suppresses it so an ambient flag can't
 *     turn the gate into a silent no-op.
 */
fn __testing_snapshot_may_write(options) -> bool {
  if options?.update == true {
    return true
  }
  return __testing_snapshot_update_requested() && !__testing_running_in_ci()
}

/**
 * Resolve the golden-file path for `name`. Defaults to a `__snapshots__/`
 * directory beside the running test file (`source_dir()` reflects the caller
 * because stdlib closures carry no source dir of their own); override the
 * directory with `options.dir`. The `.harn.snap` extension tags the file as
 * owned by this primitive so a future orphan sweep never touches another
 * tool's goldens.
 */
fn __testing_snapshot_path(name: string, options) -> string {
  const dir = options?.dir ?? (source_dir() + "/__snapshots__")
  return dir + "/" + name + ".harn.snap"
}

/**
 * Apply the optional `options.redact` scrubs to `actual` before it is written
 * or compared, so callers can mask residual volatile tokens (ids, timestamps)
 * deterministically. Each entry is `{pattern, replacement?}`; `pattern` is a
 * regex, `replacement` defaults to "". The same normalization runs on both the
 * write and the compare path, so the stored golden is always the scrubbed form.
 */
fn __testing_snapshot_normalize(actual: string, options) -> string {
  let out = actual
  for rule in options?.redact ?? [] {
    out = regex_replace(rule.pattern, rule.replacement ?? "", out)
  }
  return out
}

/**
 * Guidance appended to a create/update failure. Under CI it states the env
 * trigger is ignored and points at the local update flow; otherwise it names
 * the update env var.
 */
fn __testing_snapshot_guidance(action: string) -> string {
  if __testing_running_in_ci() {
    return "\nHARN_UPDATE_SNAPSHOTS is ignored in CI. Run the test locally with "
      + "HARN_UPDATE_SNAPSHOTS=1 to "
      + action
      + " and commit the golden."
  }
  return "\nRe-run locally with HARN_UPDATE_SNAPSHOTS=1 to " + action + "."
}

/**
 * Assert `actual` matches a committed golden snapshot file.
 *
 * The golden lives at `<dir>/<name>.harn.snap`, where `dir` defaults to a
 * `__snapshots__/` directory next to the running test file (override with
 * `options.dir`). Outside CI, running with `HARN_UPDATE_SNAPSHOTS=1` (re)writes
 * the golden and passes; every other run compares `actual` against the stored
 * golden.
 *
 * CI safety: when a CI signal (`CI` or `HARN_CI`) is set, the
 * `HARN_UPDATE_SNAPSHOTS` env trigger is ignored — the primitive compares only
 * and a missing or drifted golden is a hard failure with guidance to update
 * locally. A leaked update flag can never make a broken output silently rewrite
 * its own golden on the CI machine. The explicit `options.update = true` seam
 * is honored even under CI (deliberate in-source code, not the env-leak
 * vector); it is how this module's own tests drive the write path.
 *
 * `options.redact` is an optional list of `{pattern, replacement?}` regex
 * scrubs applied to `actual` before write/compare. The primitive only ever
 * reads or writes its own `<name>.harn.snap` file and never deletes anything.
 *
 * Returns `actual` so callers can chain further assertions.
 *
 * @effects: []
 * @errors: []
 * @example: assert_snapshot("render_home", render_home())
 */
pub fn assert_snapshot(name: string, actual: string, options = nil) -> string {
  const path = __testing_snapshot_path(name, options)
  const normalized = __testing_snapshot_normalize(actual, options)
  if __testing_snapshot_may_write(options) {
    harness.fs.mkdir(dirname(path))
    harness.fs.write_text(path, normalized)
    return actual
  }
  if !harness.fs.exists(path) {
    require false, "snapshot '" + name + "' does not exist at " + path + __testing_snapshot_guidance("create it")
    return actual
  }
  const golden = harness.fs.read_text(path)
  if golden == normalized {
    return actual
  }
  const diff = unified_diff(golden, normalized, {from_label: "snapshot (" + name + ")", to_label: "actual"})
  require false, "snapshot '"
    + name
    + "' mismatch at "
    + path
    + __testing_snapshot_guidance("update it if the change is intended")
    + "\n"
    + diff
  return actual
}
