import { filter_nil } from "std/collections"
import { slack_message_disclosure } from "std/disclosure"
import { merge } from "std/json"
import {
  MonitorEventReference,
  MonitorPollContext,
  MonitorSource,
  MonitorWaitResult,
  monitor_event,
  monitor_wait_options,
  wait_for,
} from "std/monitors"

let slack_connector_config = {}

/**
 * Configure default parameters merged into every Slack connector call.
 *
 * @effects: []
 * @errors: []
 */
pub fn configure(config: dict?) {
  slack_connector_config = filter_nil(config ?? {})
  return slack_connector_config
}

/**
 * Clear module-level Slack connector defaults.
 *
 * @effects: []
 * @errors: []
 */
pub fn reset() {
  slack_connector_config = {}
}

fn __call(net: HarnessNet, method: string, params: dict? = {}) {
  return net.connector_call(
    "slack",
    method,
    filter_nil(merge(slack_connector_config, params ?? {})),
  )
}

fn __configured_slack_disclosure(options: dict) {
  return options?._harn?.disclosure?.slack ?? options?.slack_disclosure
    ?? options?.disclosure?.slack
}

fn __slack_actor_chain(options: dict) {
  return options?.actor_chain ?? options?._harn?.actor_chain ?? options?.harn_actor_chain
}

fn __slack_disclosure_options(options: dict) {
  return options?.disclosure_options ?? options?._harn?.disclosure_options ?? {}
}

fn __with_slack_disclosure(env: HarnessEnv, fs: HarnessFs, options: dict?) {
  const opts = options ?? {}
  if __configured_slack_disclosure(opts) != nil {
    return opts
  }
  const chain = __slack_actor_chain(opts)
  if chain == nil {
    return opts
  }
  const disclosure = slack_message_disclosure(env, fs, chain, __slack_disclosure_options(opts))
  const harn = merge(
    opts?._harn ?? {},
    {disclosure: merge(opts?._harn?.disclosure ?? {}, {slack: disclosure})},
  )
  return merge(opts, {_harn: harn})
}

/**
 * Post a Slack channel or thread message.
 *
 * When `options.actor_chain` is present, the call carries Slack disclosure
 * metadata for connector-side byline and AI-mark handling.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn post_message(
  harness: Harness,
  channel: any,
  text: any,
  blocks: any = nil,
  options: dict? = nil,
) {
  const opts = __with_slack_disclosure(harness.env, harness.fs, options)
  return __call(
    harness.net,
    "post_message",
    filter_nil(merge(opts, {channel: channel, text: text, blocks: blocks})),
  )
}

/**
 * Update an existing Slack message.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn update_message(
  net: HarnessNet,
  channel: any,
  ts: any,
  text: any,
  blocks: any = nil,
  options: dict? = nil,
) {
  return __call(
    net,
    "update_message",
    filter_nil((options ?? {}) + {channel: channel, ts: ts, text: text, blocks: blocks}),
  )
}

/**
 * Add a reaction to a Slack message.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn add_reaction(net: HarnessNet, channel: any, ts: any, name: any, options: dict? = nil) {
  return __call(net, "add_reaction", (options ?? {}) + {channel: channel, ts: ts, name: name})
}

/**
 * Open a Slack modal view for an interaction trigger.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn open_view(net: HarnessNet, trigger_id: any, view: any, options: dict? = nil) {
  return __call(net, "open_view", (options ?? {}) + {trigger_id: trigger_id, view: view})
}

/**
 * Fetch Slack user profile information.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn user_info(net: HarnessNet, user_id: any, options: dict? = nil) {
  return __call(net, "user_info", (options ?? {}) + {user_id: user_id})
}

/**
 * Call a raw Slack Web API method through the active connector.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn api_call(net: HarnessNet, method: any, args: dict? = nil, options: dict? = nil) {
  return __call(net, "api_call", filter_nil((options ?? {}) + {method: method, args: args ?? {}}))
}

/**
 * Upload file content through the active Slack connector.
 *
 * @effects: [net]
 * @errors: [ConnectorError]
 */
pub fn upload_file(net: HarnessNet, filename: any, content: any, options: dict? = nil) {
  return __call(net, "upload_file", (options ?? {}) + {filename: filename, content: content})
}

type SlackMonitorReference = {
  channel?: unknown,
  channel_id?: unknown,
  user?: unknown,
  user_id?: unknown,
  text?: unknown,
  ts?: unknown,
  thread_ts?: unknown,
  reaction?: unknown,
  item?: unknown,
  item_user?: unknown,
  ...dict<string, unknown>,
}

pub type SlackMessageState = {
  matched: bool,
  message: unknown,
  channel: unknown,
  user: unknown,
  text: unknown,
  ts: unknown,
  thread_ts: unknown,
}

pub type SlackReactionState = {
  matched: bool,
  reaction: unknown,
  item: unknown,
  item_user: unknown,
  event: unknown,
}

type SlackMonitorText = string | list<unknown>

type SlackMonitorKind = string

fn __slack_reference(value: unknown) -> SlackMonitorReference? {
  const kind = type_of(value)
  return kind == "dict" || kind == "struct" ? schema_expect(
    value,
    schema_of(SlackMonitorReference),
  ) : nil
}

fn __slack_event(log_event: unknown) -> MonitorEventReference? {
  return monitor_event(log_event)
}

fn __slack_payload(log_event: unknown) -> unknown {
  return __slack_event(log_event)?.provider_payload
}

fn __slack_channel_matches(payload: unknown, channel: string?) -> bool {
  const fields = schema_expect(payload, schema_of(SlackMonitorReference))
  return channel == nil || fields?.channel == channel || fields?.channel_id == channel
}

fn __slack_user_matches(payload: unknown, user: unknown) -> bool {
  const fields = schema_expect(payload, schema_of(SlackMonitorReference))
  return user == nil || fields?.user == user || fields?.user_id == user
}

fn __slack_text_matches(payload: unknown, text: unknown) -> bool {
  const fields = schema_expect(payload, schema_of(SlackMonitorReference))
  return text == nil
    || contains(schema_expect(fields.text ?? "", schema_of(SlackMonitorText)), text)
}

/**
 * message_source.
 *
 * @effects: []
 * @errors: []
 */
pub fn message_source(
  channel: string? = nil,
  options: dict? = nil,
) -> MonitorSource<SlackMessageState> {
  return {
    label: "slack.message:" + to_string(channel ?? "*"),
    prefers_push: true,
    poll: { ctx: MonitorPollContext ->
      const payload = ctx.last_push_event == nil ? nil : __slack_payload(ctx.last_push_event)
      const fields = __slack_reference(payload)
      return {
        matched: payload != nil,
        message: payload,
        channel: fields?.channel ?? fields?.channel_id,
        user: fields?.user ?? fields?.user_id,
        text: fields?.text,
        ts: fields?.ts,
        thread_ts: fields?.thread_ts,
      }
    },
    push_filter: { log_event ->
      const event = __slack_event(log_event)
      const payload = __slack_payload(log_event)
      const fields = __slack_reference(payload)
      return event?.provider == "slack"
        && (event?.kind == "message" || event?.kind == "app_mention"
          || starts_with(schema_expect(event?.kind ?? "", schema_of(SlackMonitorKind)), "message."))
        && __slack_channel_matches(payload, channel)
        && __slack_user_matches(payload, options?.user)
        && (options?.thread_ts == nil
          || fields?.thread_ts
            == options.thread_ts)
        && __slack_text_matches(payload, options?.text_contains)
    },
  }
}

/**
 * reaction_source.
 *
 * @effects: []
 * @errors: []
 */
pub fn reaction_source(
  channel: string? = nil,
  reaction: string? = nil,
  options: dict? = nil,
) -> MonitorSource<SlackReactionState> {
  return {
    label: "slack.reaction:" + to_string(channel ?? "*") + ":" + to_string(reaction ?? "*"),
    prefers_push: true,
    poll: { ctx: MonitorPollContext ->
      const payload = ctx.last_push_event == nil ? nil : __slack_payload(ctx.last_push_event)
      const fields = __slack_reference(payload)
      return {
        matched: payload != nil,
        reaction: fields?.reaction,
        item: fields?.item,
        item_user: fields?.item_user,
        event: payload,
      }
    },
    push_filter: { log_event ->
      const event = __slack_event(log_event)
      const payload = __slack_payload(log_event)
      const fields = __slack_reference(payload)
      const item = __slack_reference(fields?.item)
      return event?.provider == "slack"
        && event?.kind == "reaction_added"
        && (reaction == nil || fields?.reaction == reaction)
        && (channel == nil
          || item?.channel
            == channel
          || fields?.channel_id == channel)
        && __slack_user_matches(payload, options?.user)
    },
  }
}

/**
 * wait_for_message.
 *
 * @effects: []
 * @errors: []
 */
pub fn wait_for_message(
  runtime: HarnessRuntime,
  channel: string? = nil,
  options: any = nil,
) -> MonitorWaitResult<SlackMessageState> {
  const wait_options = monitor_wait_options(
    options ?? {},
    message_source(channel, options),
    { state -> state.matched },
  )
  return wait_for(runtime, wait_options)
}

/**
 * wait_for_reaction.
 *
 * @effects: []
 * @errors: []
 */
pub fn wait_for_reaction(
  runtime: HarnessRuntime,
  channel: string? = nil,
  reaction: string? = nil,
  options: any = nil,
) -> MonitorWaitResult<SlackReactionState> {
  const wait_options = monitor_wait_options(
    options ?? {},
    reaction_source(channel, reaction, options),
    { state -> state.matched },
  )
  return wait_for(runtime, wait_options)
}
