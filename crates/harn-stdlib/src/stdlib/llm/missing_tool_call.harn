import {
  AgentMissingToolCallConfigDetails,
  AgentMissingToolCallConfigFailure,
} from "std/agent/failures"
pub import { MissingToolCallClassifier, MissingToolCallVerdict } from "std/agent/options_types"
import { MissingToolCallRecoveryOptions } from "std/agent/options_types"
import { EvaluationPolicy, choice } from "std/predicate"

type MissingToolCallAction = "tool_call_intended" | "no_tool_call_intended" | "ambiguous"

type MissingToolCallTool = {name: string, description?: string}

fn __missing_tool_call_string(value: any) -> string {
  if value == nil {
    return ""
  }
  return trim(to_string(value))
}

fn __missing_tool_call_float(value: float?, fallback: float) {
  const parsed = to_float(value ?? fallback)
  if parsed == nil {
    return fallback
  }
  if !(parsed >= 0.0 && parsed <= 1.0) {
    return fallback
  }
  return parsed
}

fn __missing_tool_call_config_error(
  code: string,
  message: string,
  fields: AgentMissingToolCallConfigDetails? = {},
) -> AgentMissingToolCallConfigFailure {
  return {
    error: code,
    category: "invalid_config",
    component: "missing_tool_call_classifier",
    message: message,
  }
    + (fields ?? {})
}

fn __missing_tool_call_threshold(value: float?) -> float {
  const threshold = to_float(value ?? 0.65)
  if threshold == nil || !(threshold >= 0.0 && threshold <= 1.0) {
    throw __missing_tool_call_config_error(
      "missing_tool_call.invalid_confidence_threshold",
      "confidence_threshold must be between 0.0 and 1.0",
      {field: "confidence_threshold", expected: "0.0..1.0", actual: value, min: 0.0, max: 1.0},
    )
  }
  return threshold
}

fn __missing_tool_call_candidate_tool_entries(payload: dict) {
  const registry = payload?.tools
  if type_of(registry) == "dict" {
    return registry?.tools ?? []
  }
  if type_of(registry) == "list" {
    return registry
  }
  return payload?.candidate_tools ?? []
}

fn __missing_tool_call_candidate_tools(payload: dict) -> list<MissingToolCallTool> {
  let out = []
  let names = []
  for entry in __missing_tool_call_candidate_tool_entries(payload) {
    const name = __missing_tool_call_string(entry?.name ?? entry?.function?.name)
    if name == "" || contains(names, name) {
      continue
    }
    names = names.appending(name)
    out = out.appending(
      {
        name: name,
        description: __missing_tool_call_string(entry?.description ?? entry?.function?.description),
      },
    )
  }
  for name in payload?.tool_names ?? [] {
    const text = __missing_tool_call_string(name)
    if text != "" && !contains(names, text) {
      names = names.appending(text)
      out = out.appending({name: text, description: ""})
    }
  }
  return out
}

fn __missing_tool_call_tool_names(candidate_tools: list<MissingToolCallTool>) -> list<string> {
  let names = []
  for entry in candidate_tools {
    const name = __missing_tool_call_string(entry.name)
    if name != "" && !contains(names, name) {
      names = names.appending(name)
    }
  }
  return names
}

fn __missing_tool_call_tool_name(value: any, candidate_tools: list<MissingToolCallTool>) -> string {
  const requested = __missing_tool_call_string(value)
  if requested == "" {
    return ""
  }
  for name in __missing_tool_call_tool_names(candidate_tools) {
    if requested == name || lowercase(requested) == lowercase(name) {
      return name
    }
  }
  return ""
}

fn __missing_tool_call_policy(
  llm: HarnessLlm,
  cfg: MissingToolCallRecoveryOptions,
) -> EvaluationPolicy {
  if cfg.evaluation != nil {
    return cfg.evaluation + {threshold: 0.0}
  }
  let options = {}
  if cfg.provider != nil {
    options.provider = cfg.provider
  }
  if __missing_tool_call_string(cfg.model) != "" {
    options.model = cfg.model
  }
  const resolved = llm.resolved_options(options)
  return {
    backend: "structured_llm",
    provider: to_string(resolved.provider),
    model: to_string(resolved.model),
    effort: cfg.effort ?? "none",
    temperature: cfg.temperature ?? 0.0,
    threshold: 0.0,
  }
}

fn __missing_tool_call_evaluate(
  harness: {fs: HarnessFs, llm: HarnessLlm},
  cfg: MissingToolCallRecoveryOptions,
  payload: dict,
  candidates: list<MissingToolCallTool>,
  threshold: float,
) -> MissingToolCallVerdict {
  const intended_criterion = harness.fs.render_prompt(
    "std/llm/prompts/missing_tool_call_intended.harn.prompt",
    {},
  )
  let criteria: dict<string, string> = {
    no_tool_call_intended: harness.fs.render_prompt(
      "std/llm/prompts/missing_tool_call_not_intended.harn.prompt",
      {},
    ),
  }
  for entry in candidates {
    criteria["call:" + entry.name] = intended_criterion + " Intended candidate: " + entry.name
      + ": "
      + (entry.description ?? "")
  }
  const state: {assistant_text: string, candidate_tools: list<MissingToolCallTool>} = {
    assistant_text: __missing_tool_call_string(payload?.text ?? payload?.visible_text),
    candidate_tools: candidates,
  }
  const policy = __missing_tool_call_policy(harness.llm, cfg)
  const evaluation = harness.llm.evaluate_request(
    "agent.missing_tool_call.v1",
    state,
    {
      tool: choice(
        harness.fs.render_prompt("std/llm/prompts/missing_tool_call_classifier.harn.prompt", {}),
        criteria,
      ),
    },
    policy,
  )
  const metadata = {classifier_kind: "llm", model: policy.model, evaluation: evaluation}
  if evaluation.kind == "cancelled" {
    throw {category: "cancelled", message: "missing tool call evaluation cancelled"}
  }
  if evaluation.kind != "answered" {
    return __missing_tool_call_fail_open(evaluation.kind + ": " + evaluation.receipt, threshold)
      + metadata
  }
  const target = evaluation.value.tool
  if target.kind != "choice" {
    return __missing_tool_call_fail_open("invalid target evaluation answer shape", threshold)
      + metadata
  }
  const intended = target.choice != "no_tool_call_intended"
  const tool_name = intended ? target.choice[5:] : ""
  return __missing_tool_call_normalize(
    {
      action: intended ? "tool_call_intended" : "no_tool_call_intended",
      tool_name: tool_name,
      confidence: target.confidence,
      evidence: target.evidence,
    },
    candidates,
    threshold,
  )
    + metadata
}

fn __missing_tool_call_action(value: any) -> MissingToolCallAction {
  const action = __missing_tool_call_string(value)
  if action == "tool_call_intended" || action == "no_tool_call_intended" || action == "ambiguous" {
    return action
  }
  return "ambiguous"
}

fn __missing_tool_call_normalize(
  raw: any,
  candidate_tools: list<MissingToolCallTool>,
  threshold: float,
) -> MissingToolCallVerdict {
  if type_of(raw) != "dict" {
    return {
      action: "ambiguous",
      original_action: "invalid",
      tool_name: "",
      confidence: 0.0,
      confidence_threshold: threshold,
      evidence: "classifier returned " + type_of(raw) + ", not a dict",
    }
  }
  const original_action = __missing_tool_call_action(raw?.action)
  const confidence = __missing_tool_call_float(raw?.confidence, 0.0)
  const tool_name = __missing_tool_call_tool_name(raw?.tool_name ?? raw?.tool, candidate_tools)
  const action = if original_action == "tool_call_intended" && confidence >= threshold
    && tool_name
      != "" {
    "tool_call_intended"
  } else if original_action == "no_tool_call_intended" && confidence >= threshold {
    "no_tool_call_intended"
  } else {
    "ambiguous"
  }
  const evidence = __missing_tool_call_string(raw?.evidence ?? raw?.reason ?? raw?.reasoning)
  return raw
    + {
      action: action,
      original_action: original_action,
      tool_name: tool_name,
      confidence: confidence,
      confidence_threshold: threshold,
      evidence: if evidence == "" {
        "no evidence provided"
      } else {
        evidence
      },
    }
}

fn __missing_tool_call_fail_open(error: any, threshold: float) -> MissingToolCallVerdict {
  return {
    action: "ambiguous",
    original_action: "error",
    tool_name: "",
    confidence: 0.0,
    confidence_threshold: threshold,
    evidence: "missing tool call classifier failed: " + to_string(error),
    error: to_string(error),
  }
}

/**
 * missing_tool_call_classifier returns the post-turn classifier used by
 * agent_loop text-mode recovery. It decides whether a turn with no parsed tool
 * calls was probably meant to call one, without language-specific substring
 * lists.
 *
 * The agent loop constructs this classifier by default for real provider-backed
 * text-mode loops and passes through the active loop provider/model unless this
 * config overrides them. Pass `missing_tool_call_recovery: false` to disable it
 * or `missing_tool_call_recovery: { ... }` to configure classifier-specific
 * settings. Mock/custom-caller tests can pass `classifier` inside that config
 * for deterministic behavior. The live path evaluates one closed choice over
 * no intent and each candidate's explicit intent criterion. One shared
 * evaluator request owns both decisions. Unanswered calls fail open to `ambiguous`.
 *
 * @effects: [llm.call]
 * @errors: []
 * @api_stability: experimental
 */
pub fn missing_tool_call_classifier(
  harness: Harness,
  opts: MissingToolCallRecoveryOptions? = nil,
) -> MissingToolCallClassifier {
  const cfg = opts ?? {}
  if type_of(cfg) != "dict" {
    throw __missing_tool_call_config_error(
      "missing_tool_call.invalid_options",
      "opts must be a dict or nil; got " + type_of(cfg),
      {field: "opts", expected: "dict", actual_type: type_of(cfg)},
    )
  }
  const enabled = cfg.enabled ?? true
  if type_of(enabled) != "bool" {
    throw __missing_tool_call_config_error(
      "missing_tool_call.invalid_enabled",
      "enabled must be a bool",
      {field: "enabled", expected: "bool", actual_type: type_of(enabled)},
    )
  }
  const model = __missing_tool_call_string(cfg.model)
  const threshold = __missing_tool_call_threshold(
    cfg.confidence_threshold ?? cfg?.evaluation?.threshold,
  )
  const classifier = cfg.classifier
  if classifier != nil && type_of(classifier) != "closure" {
    throw __missing_tool_call_config_error(
      "missing_tool_call.invalid_classifier",
      "classifier must be a closure or nil; got " + type_of(classifier),
      {field: "classifier", expected: "closure|nil", actual_type: type_of(classifier)},
    )
  }
  return { payload ->
    if !enabled {
      return nil
    }
    const candidate_tools = __missing_tool_call_candidate_tools(payload)
    if len(candidate_tools) == 0 {
      return nil
    }
    const classifier_payload = payload
      + {
        candidate_tools: candidate_tools,
        tool_names: __missing_tool_call_tool_names(candidate_tools),
        confidence_threshold: threshold,
      }
    if classifier != nil {
      const custom = try {
        classifier(classifier_payload)
      }
      if is_err(custom) {
        const err = unwrap_err(custom)
        if error_category(err) == "cancelled" {
          throw err
        }
        return __missing_tool_call_fail_open(err, threshold) + {classifier_kind: "custom"}
      }
      return __missing_tool_call_normalize(unwrap(custom), candidate_tools, threshold)
        + {classifier_kind: "custom"}
    }
    const attempted = try {
      __missing_tool_call_evaluate(
        {fs: harness.fs, llm: harness.llm},
        cfg,
        classifier_payload,
        candidate_tools,
        threshold,
      )
    }
    if is_err(attempted) {
      const error = unwrap_err(attempted)
      if error_category(error) == "cancelled" {
        throw error
      }
      return __missing_tool_call_fail_open(error, threshold)
        + {classifier_kind: "llm", model: model}
    }
    return unwrap(attempted)
  }
}
