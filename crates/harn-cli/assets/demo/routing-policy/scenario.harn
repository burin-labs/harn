/**
 * routing-policy demo: drive the `routing_policy` primitive through a
 * cheap→frontier failover chain on two mocked tasks, then surface the
 * per-attempt routing receipt the v0.8.40 primitive emits on every
 * `llm_call`.
 *
 * Scenarios per task:
 *   - "smoke"     — cheap link succeeds, frontier is never tried
 *   - "rate-lim"  — cheap link returns 429 rate_limit, chain advances
 *                   to the frontier link, which succeeds
 *
 * Designed to run fully offline against the bundled `tape.jsonl`
 * fixture. The tape preloads three entries (one cheap success and one
 * 429-then-success pair for rate-lim). Invoke `harn demo routing-policy --live` to race the
 * configured providers instead.
 *
 * Why a demo for this primitive: routing_policy is the trust-receipt
 * surface that downstream observability (cost attribution,
 * per-attempt token counts) consumes from `llm_call`. The
 * demo gate (#2437) flagged it as previously uncovered.
 */
/** One routed task: the prompt to send and the failover story it exercises. */
type RoutedTask = {id: string, prompt: string, story: string}

fn tasks() -> list<RoutedTask> {
  return [
    {
      id: "smoke",
      prompt: "[routing_policy][task=smoke] Reply with the single word OK.",
      story: "cheap link succeeds; frontier is never invoked",
    },
    {
      id: "rate-lim",
      prompt: "[routing_policy][task=rate-lim] One sentence: what does a 429 mean?",
      story: "cheap link 429s; chain advances to frontier",
    },
  ]
}

pipeline default(harness: Harness) {
  // Single routing policy reused across both tasks: status-based failover
  // from the cheap link to the frontier link.
  const policy = harness.llm.routing_policy(
    {
      chain: [
        {provider: "mock", model: "mock-cheap", label: "cheap"},
        {provider: "mock", model: "mock-strong", label: "frontier"},
      ],
      failover: {max_attempts: 2, on_status: [429, 500, 502, 503]},
      label: "cheap-then-frontier",
    },
  )
  let rows = []
  let total_attempts = 0
  let escalated = 0
  for task in tasks() {
    harness.stdio.println("=== task ${task.id} ===")
    harness.stdio.println("story: ${task.story}")
    const envelope = harness.llm.call(task.prompt, "Be concise.", {routing: policy})
    const attempts = envelope.routing.attempts
    total_attempts = total_attempts + len(attempts)
    if len(attempts) > 1 {
      escalated = escalated + 1
    }
    harness.stdio.println("answer:   ${envelope.text}")
    harness.stdio.println("selected: ${envelope.routing.selected}")
    harness.stdio.println("attempts: ${len(attempts)}")
    for a in attempts {
      harness.stdio.println("  - label=${a.label} status=${a.status}")
    }
    harness.stdio.println("")
    const row = {
      attempts: len(attempts),
      escalated: len(attempts) > 1,
      selected: envelope.routing.selected,
      task: task.id,
      text: envelope.text,
    }
    rows = rows + [row]
  }
  const receipt = {
    escalations: escalated,
    persona: "routing_policy",
    policy_label: "cheap-then-frontier",
    receipt_kind: "routing_supervision_receipt",
    tasks: rows,
    total_attempts: total_attempts,
  }
  harness.stdio.println("=== routing_policy receipt ===")
  harness.stdio.println(json_stringify(receipt))
  return receipt
}
