/**
 * agent-edit-tools demo: the canonical default mutation toolset every
 * embedder used to hand-roll.
 *
 * `std/agent/host_tools.agent_edit_tools(...)` ships root-scoped `write_file`,
 * `edit_file`, `create_directory`, and `delete_path` tools that wrap the
 * existing hostlib filesystem primitives. They reuse the same root resolution,
 * path-scope enforcement, and rendering plumbing as `agent_read_tools`, and are
 * annotated honestly as mutating (`kind: edit|delete`,
 * `side_effect_level: workspace_write`) so the read-only stance hides them and
 * tool-surface narrowing classifies them correctly.
 *
 * This scenario drives each tool through `agent_dispatch_tool_call` under a
 * temporary root: the happy paths, the deliberate guardrails (edit_file refuses
 * an ambiguous match; delete_path refuses a non-empty directory unless
 * recursive), and the middleware seam — the same named tools wrapped with
 * `with_consent` + `with_audit_log` so an embedder gets approval and receipts
 * for free. Fully offline: no LLM, no subprocess, no network.
 */
import { agent_edit_tools } from "std/agent/host_tools"
import {
  compose_tool_callers,
  default_tool_caller,
  with_audit_log,
  with_consent,
} from "std/llm/tool_middleware"

fn dispatch(harness: Harness, tools, name, args) {
  return agent_dispatch_tool_call(harness, {id: name + "-call", name: name, arguments: args}, tools)
}

pipeline default(harness: Harness, _task) {
  harness.stdio.println("=== agent-edit-tools demo ===")
  harness.stdio.println("")
  const root = path_join(harness.fs.runtime_paths().execution_root, "edit-demo-" + harness.random.uuid())
  harness.fs.mkdir(root, true)
  const tools = agent_edit_tools(harness, nil, {root: root, cwd: root})
  // 1. write_file: create a file wholesale (parent dirs are created).
  const wrote = dispatch(harness, 
    tools,
    "write_file",
    {path: "src/config.txt", content: "mode = draft\nretries = 3\n"},
  )
  const wrote_data = json_parse(wrote.rendered_result)
  harness.stdio.println(
    "write_file -> created=" + to_string(wrote_data.created) + " path=" + wrote_data.path,
  )
  // 2. edit_file: exact-string replacement, unique match required.
  const edited = dispatch(harness, 
    tools,
    "edit_file",
    {path: "src/config.txt", old_string: "mode = draft", new_string: "mode = live"},
  )
  const edited_data = json_parse(edited.rendered_result)
  harness.stdio.println("edit_file -> replacements=" + to_string(edited_data.replacements))
  harness.stdio.println(
    "  file now: " + json_stringify(harness.fs.read_text(path_join(root, "src/config.txt"))),
  )
  // 3. edit_file guardrail: an ambiguous match is refused, not silently applied.
  harness.fs.write_text(path_join(root, "src/dupes.txt"), "todo\ntodo\n")
  const ambiguous = dispatch(harness, 
    tools,
    "edit_file",
    {path: "src/dupes.txt", old_string: "todo", new_string: "done"},
  )
  harness.stdio.println("edit_file (2 matches, no replace_all) -> ok=" + to_string(ambiguous.ok))
  harness.stdio.println("  error: " + ambiguous.error)
  const all = dispatch(harness, 
    tools,
    "edit_file",
    {path: "src/dupes.txt", old_string: "todo", new_string: "done", replace_all: true},
  )
  const all_data = json_parse(all.rendered_result)
  harness.stdio.println("edit_file (replace_all) -> replacements=" + to_string(all_data.replacements))
  harness.stdio.println("")
  // 4. create_directory: mkdir -p semantics.
  const made = dispatch(harness, tools, "create_directory", {path: "build/artifacts/logs"})
  harness.stdio.println(
    "create_directory -> ok=" + to_string(made.ok) + " is_dir="
      + to_string(
      harness.fs.stat(path_join(root, "build/artifacts/logs")).is_dir,
    ),
  )
  // 5. delete_path guardrail: a non-empty directory needs recursive:true.
  const refuse = dispatch(harness, tools, "delete_path", {path: "src"})
  harness.stdio.println("delete_path (non-empty dir) -> ok=" + to_string(refuse.ok))
  harness.stdio.println("  error: " + refuse.error)
  const purge = dispatch(harness, tools, "delete_path", {path: "src", recursive: true})
  const purge_data = json_parse(purge.rendered_result)
  harness.stdio.println(
    "delete_path (recursive) -> removed=" + to_string(purge_data.removed) + " exists="
      + to_string(
      harness.fs.exists(path_join(root, "src")),
    ),
  )
  harness.stdio.println("")
  // 6. Middleware seam: the SAME named tools, wrapped with consent + audit.
  //    The embedder composes tool callers; nothing tool-specific is needed.
  const consent_hits = harness.runtime.atomic(0)
  const audit_hits = harness.runtime.atomic(0)
  const caller = compose_tool_callers(harness,  harness, [
      with_audit_log(harness,  harness, { _receipt ->
          harness.runtime.atomic_add(audit_hits, 1)
          return nil
        },
      ),
      with_consent(harness,  harness, { _call ->
          harness.runtime.atomic_add(consent_hits, 1)
          return true
        },
      ),
      default_tool_caller(),
    ],
  )
  const next = { call -> dispatch(harness, tools, call.tool_name, call.tool_args) }
  const envelope = {
    call_id: "mw1",
    declared_executor: "harn",
    description: "",
    schema: nil,
    tool_args: {content: "audited write\n", path: "audited/note.txt"},
    tool_name: "write_file",
    turn: {iteration: 0, session_id: ""},
  }
  const mw_result = caller(envelope, next)
  harness.stdio.println("wrapped write_file -> status=" + mw_result.status)
  harness.stdio.println(
    "  consent fired=" + to_string(harness.runtime.atomic_get(consent_hits)) + " audit fired="
      + to_string(
      harness.runtime.atomic_get(audit_hits),
    ),
  )
  harness.stdio.println(
    "  wrote: " + json_stringify(harness.fs.read_text(path_join(root, "audited/note.txt"))),
  )
  harness.stdio.println("")
  const receipt = {
    receipt_kind: "agent_edit_tools_receipt",
    ambiguous_edit_refused: !ambiguous.ok,
    audit_fired: harness.runtime.atomic_get(audit_hits) == 1,
    consent_fired: harness.runtime.atomic_get(consent_hits) == 1,
    created_directory: harness.fs.stat(path_join(root, "build/artifacts/logs")).is_dir,
    delete_dir_needs_recursive: !refuse.ok,
    recursive_delete_removed: purge_data.removed,
    replace_all_count: all_data.replacements,
    tools: ["write_file", "edit_file", "create_directory", "delete_path"],
    write_created: wrote_data.created,
  }
  harness.stdio.println(json_stringify(receipt))
  return receipt
}
