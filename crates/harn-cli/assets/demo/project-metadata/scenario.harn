/**
 * project-metadata demo: `HarnessProject` uses Harn's
 * built-in metadata store when no product host bridge handles them.
 *
 * This exercises the typed `harness.project.metadata_*` operations directly:
 * set a namespace on a parent directory, read it from a child directory via
 * inheritance, inspect the origin, refresh structure hashes, and flush the
 * store. Product embedders such as Burin can still override these operations
 * through their host bridge; this offline demo covers the standalone CLI path.
 */
pipeline default(harness: Harness, _task: unknown) {
  harness.fs.mkdir("demo", true)
  harness.fs.mkdir("demo/src", true)
  harness.fs.write_text("demo/src/lib.harn", "pipeline default(_) { return 1 }\n")
  harness.project.metadata_set(
    {
      dir: "demo",
      namespace: "learning",
      value: {
        gotchas: [
          "prefer relative imports for sibling modules",
          "refresh hashes after structural edits",
        ],
        source: "demo",
      },
    },
  )
  const exact = harness.project.metadata_get({dir: "demo", namespace: "learning"})
  const inherited = harness.project.metadata_get({dir: "demo/src", namespace: "learning"})
  const all = harness.project.metadata_get({dir: "demo/src"})
  const before = harness.project.metadata_inspect(
    {dir: "demo/src", namespace: "learning", key: "gotchas"},
  )
  require exact.gotchas[0] == "prefer relative imports for sibling modules"
  require inherited.gotchas[1] == "refresh hashes after structural edits"
  require all.learning.source == "demo"
  require before.origin_dir == "demo"
  require before.missing_structure_hash
  const stale_before = harness.project.metadata_stale({dir: "demo"})
  require type_of(stale_before.tier1) == "list"
  require type_of(stale_before.tier2) == "list"
  harness.project.metadata_refresh_hashes({dir: "demo"})
  const after = harness.project.metadata_inspect(
    {dir: "demo/src", namespace: "learning", key: "gotchas"},
  )
  require after.origin_dir == "demo"
  require !after.missing_structure_hash
  require !after.stale_tier1
  harness.project.metadata_save({})
  const receipt = {
    receipt_kind: "project_metadata_receipt",
    origin_dir: after.origin_dir,
    inherited_import_rule: inherited.gotchas[0],
    all_namespace_source: all.learning.source,
    stale_lists_present: type_of(stale_before.tier1) == "list"
      && type_of(stale_before.tier2) == "list",
    hash_refreshed: !after.missing_structure_hash,
  }
  harness.stdio.println("=== project-metadata receipt ===")
  harness.stdio.println(json_stringify(receipt))
  return receipt
}
