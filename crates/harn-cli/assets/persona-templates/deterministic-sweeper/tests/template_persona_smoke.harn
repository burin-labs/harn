import { template_persona } from "../src/template_persona"

pipeline test_template_persona_smoke(harness: Harness, task) {
  const fixture = json_parse(harness.fs.read_text("../fixtures/happy_path.json"))
  const result = template_persona(harness.clock, harness.fs, {fixture: fixture})
  assert_eq(result.status, "completed")
  assert_eq(len(result.state.processed), 2)
  assert_eq(result.receipt.schema, "harn.receipt.v1")
  harness.stdio.println(true)
  harness.stdio.println(result.receipt.schema)
}
