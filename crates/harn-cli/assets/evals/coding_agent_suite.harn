  llm_mock(
    {
      text: "<tool_call>\nrun_command({ argv: [" + python_literal
        + ", \"app.py\", \"--shout\", \"Ada\"], capture: { max_inline_bytes: 4000 } })\n</tool_call>",
    },
  )
  llm_mock(
