// Tenant-admin trial sandbox telemetry route. This lives in its own normal-class
// script so it keeps the gateway API-key middleware, unlike public `/try/*`
// routes in `api/try_logic.harn`.
fn admin_trial_telemetry_api(req: dict, operation: string) {
  const result = host_call("harn_cloud.agent_api", {operation: operation, request: req})
  return http_reply_from(result)
}

@scopes("usage:read")
@route("GET", "/admin/trials/telemetry")
pub fn get_admin_trial_telemetry(harness: Harness, req: dict) -> dict {
  return admin_trial_telemetry_api(req, "try_sandbox.admin_telemetry")
}
