import { command_run } from "std/command"

fn main(harness: Harness) {
  harness.runtime.with_execution_policy({tools: ["run_command"]}, { -> probe(harness) })
}

fn probe(harness: Harness) {
  const sign = command_run(
    harness.tools,
    ["git", "commit", "--allow-empty", "-S", "-m", "Socket grant proof"],
  )
  const read = command_run(
    harness.tools,
    ["sh", "-c", "cat \"$1\" >/dev/null", "key-read-control", argv[0]],
  )
  const other = command_run(harness.tools, ["ssh-add", "-l"], {env: {SSH_AUTH_SOCK: argv[1]}})
  const sign_sandbox = sign.sandbox
  const read_sandbox = read.sandbox
  const other_sandbox = other.sandbox
  if sign_sandbox == nil {
    throw "signing command did not report its sandbox"
  }
  if read_sandbox == nil {
    throw "key-read control did not report its sandbox"
  }
  if other_sandbox == nil {
    throw "other-agent control did not report its sandbox"
  }
  harness.stdio.println(
    json_stringify(
      {
        sign_exit: sign.exit_code,
        key_read_exit: read.exit_code,
        key_read_denied: contains(read.stderr, "Permission denied")
          || contains(read.stderr, "Operation not permitted"),
        other_agent_exit: other.exit_code,
        other_agent_denied: contains(other.stderr, "Permission denied")
          || contains(other.stderr, "Operation not permitted"),
        confinement_fired: sign_sandbox.enforced && read_sandbox.enforced && other_sandbox.enforced,
      },
    ),
  )
}
