fn main(harness: Harness) {
  const env = harness.env
  const clock = harness.clock
  let i = 0
  let hits = 0
  while i < 25000 {
    if env.get_or("__HARN_VM_BENCH_MISSING__", "fallback") == "fallback" {
      hits = hits + 1
    }
    const _ = clock.monotonic_ms()
    i = i + 1
  }
  return hits
}
