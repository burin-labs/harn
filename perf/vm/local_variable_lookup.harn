pipeline default(task) {
  const a = 1
  const b = 2
  const c = 3
  const d = 4
  const e = 5
  const f = 6
  const g = 7
  const h = 8
  let i = 0
  let total = 0
  while i < 200000 {
    total = total + a + b + c + d + e + f + g + h
    i = i + 1
  }
  if total < 0 {
    log("unreachable")
  }
}
