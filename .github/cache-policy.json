{
  "schema_version": 4,
  "rust_cache_action": "./.github/actions/rust-cache",
  "node_cache_action": "./.github/actions/node-cache",
  "persistent_ref": "refs/heads/main",
  "storage_limit_bytes": 10737418240,
  "remote_sccache": false,
  "nextest_version": "0.9.132",
  "windows_workspace_warm": {
    "artifact_name": "workspace-windows-warm",
    "manifest_schema": "harn.windows_workspace_warm.v1",
    "workflow": "windows-nightly.yml",
    "job": "nextest",
    "retention_days": 3,
    "max_bytes": 8589934592,
    "dev_drive_size_default": "25GB",
    "dev_drive_size_release_certify": "50GB"
  },
  "writers": [
    {
      "workflow": "build-release-binaries.yml",
      "job": "build",
      "shared_key": "release-${{ matrix.target }}"
    },
    {
      "workflow": "windows-nightly.yml",
      "job": "nextest",
      "shared_key": "workspace-windows"
    },
    {
      "workflow": "macos-nightly.yml",
      "job": "nextest",
      "shared_key": "workspace-macos"
    },
    {
      "workflow": "ci.yml",
      "job": "package-audit",
      "shared_key": "package-audit"
    },
    {
      "workflow": "ci.yml",
      "job": "rust-check-inputs",
      "shared_key": "workspace-tests"
    },
    {
      "workflow": "ci.yml",
      "job": "rust-cache-refresh",
      "shared_key": "workspace-tests"
    },
    {
      "workflow": "ci.yml",
      "job": "rust-cache-refresh",
      "shared_key": "package-audit"
    }
  ]
}
