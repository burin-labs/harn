{
  "schema_version": 2,
  "pricing": {
    "as_of": "2026-08-09",
    "sources": {
      "blacksmith": "https://www.blacksmith.sh/pricing",
      "github": "https://docs.github.com/en/billing/reference/actions-runner-pricing"
    },
    "blacksmith_linux_16vcpu_usd_per_minute": 0.032,
    "blacksmith_macos_12vcpu_usd_per_minute": 0.16,
    "github_macos_xlarge_usd_per_minute": 0.102
  },
  "jobs": {
    "cli_aot": {
      "primary": "blacksmith-16vcpu-ubuntu-2404",
      "standard": "ubuntu-latest"
    }
  },
  "targets": [
    {
      "target": "x86_64-apple-darwin",
      "release_codegen_units": 16,
      "use_sccache": "true",
      "sccache_backend": "sticky",
      "runners": {
        "warm": "macos-15-intel",
        "primary": "blacksmith-12vcpu-macos-15",
        "recovery": "macos-15-xlarge",
        "standard": "macos-15-intel",
        "fast": "blacksmith-12vcpu-macos-15"
      }
    },
    {
      "target": "aarch64-apple-darwin",
      "release_codegen_units": 16,
      "use_sccache": "true",
      "sccache_backend": "local",
      "runners": {
        "warm": "macos-latest",
        "primary": "macos-latest",
        "recovery": "macos-latest",
        "standard": "macos-latest",
        "fast": "macos-15-xlarge"
      }
    },
    {
      "target": "x86_64-unknown-linux-gnu",
      "release_codegen_units": 8,
      "use_sccache": "true",
      "sccache_backend": "install",
      "runners": {
        "warm": "ubuntu-latest",
        "primary": "ubuntu-latest",
        "recovery": "ubuntu-latest",
        "standard": "ubuntu-latest",
        "fast": "ubuntu-latest"
      }
    },
    {
      "target": "aarch64-unknown-linux-gnu",
      "release_codegen_units": 16,
      "use_sccache": "true",
      "sccache_backend": "install",
      "runners": {
        "warm": "ubuntu-24.04-arm",
        "primary": "ubuntu-24.04-arm",
        "recovery": "ubuntu-24.04-arm",
        "standard": "ubuntu-24.04-arm",
        "fast": "ubuntu-24.04-arm"
      }
    },
    {
      "target": "x86_64-pc-windows-msvc",
      "release_codegen_units": 16,
      "use_sccache": "true",
      "sccache_backend": "local",
      "runners": {
        "warm": "windows-latest",
        "primary": "windows-latest",
        "recovery": "windows-latest",
        "standard": "windows-latest",
        "fast": "windows-latest"
      }
    }
  ]
}
