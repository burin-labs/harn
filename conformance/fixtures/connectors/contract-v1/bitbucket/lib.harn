pub fn provider_id() {
  return "bitbucket"
}

pub fn kinds() {
  return ["webhook"]
}

pub fn payload_schema() {
  return {
    harn_schema_name: "BitbucketEventPayload",
    json_schema: {type: "object", additionalProperties: true},
  }
}

pub fn init(_harness: Harness, ctx: dict) {
  if ctx.provider_id != "bitbucket" {
    throw "unexpected provider id"
  }
}

pub fn activate(harness: Harness, bindings: string | bytes | list | dict | set | range | nil) {
  harness.obs.metrics_inc("bitbucket_contract_activations", len(bindings))
}

fn header(headers: any, name: any) {
  return headers[name] ?? headers[lowercase(name)] ?? ""
}

pub fn normalize_inbound(_harness: Harness, raw: dict) {
  const body = raw.body_json ?? json_parse(raw.body_text)
  const event = header(raw.headers, "X-Event-Key")
  const delivery = header(raw.headers, "X-Hook-UUID")
  return {
    type: "event",
    event: {
      kind: event,
      dedupe_key: delivery,
      payload: body,
      signature_status: {state: "verified"},
    },
  }
}

pub fn call(_harness: Harness, method: string, _args: unknown) {
  throw "method_not_found:" + method
}
