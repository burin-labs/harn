pipeline default() {
  // The point is the missing file, not where it is missing from. A literal
  // `/tmp` sits outside the case's write root on macOS, where the system
  // temp dir lives under `/var/folders`, so it would fail as a sandbox
  // violation and never reach the delete.
  delete_file(path_join(temp_dir(), "harn_this_file_does_not_exist_9999"))
}
