fn list_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "list_directory",
    "List directory contents",
    {
      handler: { _args -> "" },
      parameters: {path: {type: "string", description: "Directory path"}},
      returns: {type: "string"},
    },
  )
  return tools
}

pipeline test(harness: Harness, task) {
  const result = agent_loop(harness, "Inspect the workspace",
    "You are helpful",
    {
      provider: "mock",
      tools: list_tools(),
      tool_format: "native",
      max_iterations: 1,
      policy: {tool_arg_constraints: [{tool: "list_directory", arg_key: "path", arg_patterns: ["src/*"]}]},
    },
  )
  harness.stdio.println(result?.tools?.rejected[0])
  harness.stdio.println(
    json_stringify(transcript_messages(result?.transcript)).contains("is outside your allowed scope"),
  )
}
