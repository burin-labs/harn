          "required": ["approved"]
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": "elicit-server-bound",
      "error": {
        "code": -32601,
        "message": "Unsupported MCP client-bound method: elicitation/create",
        "data": {
          "type": "mcp.unsupportedFeature",
          "protocolVersion": "2025-11-25",
          "method": "elicitation/create",
          "feature": "elicitation",
          "role": "client",
          "status": "unsupported",
