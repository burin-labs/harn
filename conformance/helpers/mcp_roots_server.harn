pipeline default(harness: Harness) {
  harness.tools.mcp_server_metadata({name: "roots-test-server", version: "1.0.0"})
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "roots_report",
    "Return roots reported by the connected MCP client.",
    {
      parameters: {},
      handler: { _args ->
        const roots = harness.tools.mcp_client_roots()
        return json_stringify({roots_count: roots.count, roots: roots})
      },
      annotations: {
        title: "Roots Report",
        readOnlyHint: true,
        destructiveHint: false,
        idempotentHint: true,
        openWorldHint: false,
      },
    },
  )
  harness.tools.mcp_tools(tools)
}
