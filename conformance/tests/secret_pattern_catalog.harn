fn main(harness: Harness) {
  const catalog = secret_pattern_catalog()
  const high = catalog.filter({ row -> row.precision == "high" }).to_list()
  const aws = high.filter({ row -> row.detector == "aws-access-key-id" })[0]
  require aws != nil, "missing AWS detector"
  require len(high) >= 10, "empty or partial secret token catalog"
  const token = "AKIA" + "ABCDEFGHIJKLMNOP"
  require regex_match(aws.regex, token) != nil, "catalog regex did not detect a token"
  require regex_match(aws.regex, "ordinary text") == nil, "catalog regex matched ordinary text"
  const finding = secret_scan(token)[0]
  require finding?.detector == aws.detector, "scanner and exported catalog disagree"
  harness.stdio.println("catalog matches scanner")
}
