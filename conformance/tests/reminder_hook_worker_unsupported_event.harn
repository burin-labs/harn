import { agent_reminder_providers_fire } from "std/agent/state"

pipeline main() {
  clear_reminder_providers()
  register_reminder_provider(
    {
      id: "worker_spawn_reminder",
      subscribes_to: ["WorkerSpawned"],
      evaluate: { _ctx -> return {reminder: {body: "worker spawned"}} },
    },
  )
  let session = agent_session_open("reminder-hook-worker-unsupported-event")
  agent_session_reset(session)
  agent_reminder_providers_fire(session, "WorkerSpawned", {session: {id: session}}, {})
  clear_reminder_providers()
}
