pipeline main() {
  clear_session_hooks()
  const session = agent_session_open("hook-session-idle-emits-reminder")
  agent_session_reset(session)
  register_session_hook(
    "session_idle",
    { _event ->
      return {
        reminder: {
          body: "idle hook reminder",
          tags: ["session_idle"],
          dedupe_key: "session-idle-hook",
        },
      }
    },
  )
  // Fire the session_idle hook directly without relying on real timers.
  __host_fire_session_hook(
    "session_idle",
    {session: {id: session}, iteration: 1, wake_interval_ms: 0},
  )
  const events = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  __io_println(len(events))
  __io_println(events[0].reminder.body)
  __io_println(events[0].reminder.tags[0])
  __io_println(events[0].reminder.source)
  clear_session_hooks()
}
