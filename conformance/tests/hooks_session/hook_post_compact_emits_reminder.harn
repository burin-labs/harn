pipeline main(harness: Harness) {
  harness.agent.clear_session_hooks()
  const session = harness.agent.open("hook-post-compact-emits-reminder")
  harness.agent.reset(session)
  harness.agent.inject(session, {role: "user", content: "one"})
  harness.agent.inject(session, {role: "assistant", content: "two"})
  harness.agent.inject(session, {role: "user", content: "three"})
  harness.agent.inject(session, {role: "assistant", content: "four"})
  harness.agent.register_session_hook(
    "post_compact",
    { _event ->
      return {
        reminder: {
          body: "compaction observed",
          tags: ["post_compact"],
          dedupe_key: "post-compact-hook",
        },
      }
    },
  )
  const snapshot = harness.agent.snapshot(session) ?? {}
  harness.agent.compact_transcript(snapshot, {strategy: "truncate", keep_last: 1, target_tokens: 1})
  const events = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  // Two reminders fire post-compact: our hook reminder plus the built-in
  // compaction recap. Assert ours is present and tagged correctly.
  const hook_event = if events[0].reminder.dedupe_key == "post-compact-hook" {
    events[0]
  } else {
    events[1]
  }
  harness.stdio.println(len(events) >= 1)
  harness.stdio.println(hook_event.reminder.body)
  harness.stdio.println(hook_event.reminder.tags[0])
  harness.stdio.println(hook_event.reminder.source)
  harness.agent.clear_session_hooks()
}
