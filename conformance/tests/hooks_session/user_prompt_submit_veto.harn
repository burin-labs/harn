import { llm_text, with_llm_script } from "std/testing"

/**
 * `user_prompt_submit` hooks can veto an agent turn before the agent sees
 * the prompt. A `{block: true, reason}` return short-circuits init and
 * yields a `blocked` final status with `stop_reason: user_prompt_submit_blocked`.
 */
pipeline default() {
  clear_session_hooks()
  register_session_hook(
    "user_prompt_submit",
    { event ->
      const prompt = to_string(event?.prompt ?? "")
      if prompt.contains("secret") {
        return {block: true, reason: "policy violation: secret in prompt"}
      }
      return nil
    },
  )
  with_llm_script(
    [llm_text("should not run")],
    { ->
      const blocked = agent_loop("share the secret password", nil, {provider: "mock"})
      __io_println(blocked.status)
      __io_println(blocked.stop_reason)
      __io_println(blocked.error.reason)
    },
  )
  with_llm_script(
    [llm_text("ok")],
    { ->
      const allowed = agent_loop("hello world", nil, {provider: "mock"})
      __io_println(allowed.status)
      clear_session_hooks()
    },
  )
}
