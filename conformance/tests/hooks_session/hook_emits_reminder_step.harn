import { llm_text, with_llm_script } from "std/testing"

@step(name: "watched_step")
fn watched_step(input) -> string {
  return "step:" + input
}

@persona(name: "step_hook_persona")
fn step_hook_persona(input) -> string {
  return watched_step(input)
}

fn step_hook_tools() {
  const registry = tool_registry()
  return tool_define(
    registry,
    "step_hook_tool",
    "Call a Harn step",
    {parameters: {}, handler: { _args -> step_hook_persona("tool") }},
  )
}

pipeline main(harness: Harness) {
  harness.agent.clear_persona_hooks()
  harness.agent.register_step_hook(
    "step_hook_persona",
    "watched_step",
    "PreStep",
    { _ctx -> return {reminder: {body: "step hook reminder", tags: ["step"]}} },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "step_1", name: "step_hook_tool", arguments: {}}]},
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      const result = agent_loop(harness, "call the step hook tool",
        nil,
        {
          provider: "mock",
          tools: step_hook_tools(),
          tool_format: "native",
          max_iterations: 2,
          loop_until_done: true,
          session_id: "hook-reminder-step",
        },
      )
      const events = transcript_events_by_kind(result.transcript, "system_reminder")
      harness.stdio.println(result.status)
      harness.stdio.println(len(events))
      harness.stdio.println(events[0].reminder.body)
      harness.stdio.println(events[0].reminder.source)
      harness.stdio.println(events[0].reminder.tags[0])
      harness.agent.clear_persona_hooks()
    },
  )
}
