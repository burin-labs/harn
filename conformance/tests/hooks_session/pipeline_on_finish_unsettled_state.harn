/**
 * P-04 foundation: an on_finish callback can enumerate the harness
 * unsettled-state shape and make deterministic per-category decisions.
 */
import { counts, is_empty, summary, unsettled_state } from "std/lifecycle"

pipeline default() {
  pipeline_on_finish(
    { harness, return_value ->
      const state = harness.unsettled_state()
      const helper_state = unsettled_state(harness)
      const direct_counts = harness.counts(state)
      const helper_counts = counts(helper_state)
      harness.stdio.println(
        "empty=" + to_string(harness.is_empty(state)) + "/" + to_string(is_empty(state)),
      )
      harness.stdio.println(
        "counts=" + to_string(direct_counts.suspended) + "," + to_string(helper_counts.queued)
          + ","
          + to_string(helper_counts.partial)
          + ","
          + to_string(direct_counts.in_flight),
      )
      const suspended_decision = if direct_counts.suspended == 0 {
        "none"
      } else {
        "resume"
      }
      const trigger_decision = if helper_counts.queued == 0 {
        "none"
      } else {
        "ack"
      }
      const handoff_decision = if helper_counts.partial == 0 {
        "none"
      } else {
        "ack"
      }
      const llm_decision = if direct_counts.in_flight == 0 {
        "none"
      } else {
        "wait"
      }
      harness.stdio.println("suspended_decision=" + suspended_decision)
      harness.stdio.println("trigger_decision=" + trigger_decision)
      harness.stdio.println("handoff_decision=" + handoff_decision)
      harness.stdio.println("llm_decision=" + llm_decision)
      harness.stdio.println("summary=" + summary(state))
      const ack = harness.acknowledge_trigger("missing-trigger")
      const wait = harness.wait_for_any_settlement(0)
      harness.stdio.println("ack=" + ack.status)
      harness.stdio.println("wait=" + wait.status)
      return return_value
    },
  )
  return 5
}
