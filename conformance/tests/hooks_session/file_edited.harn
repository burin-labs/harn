/**
 * `file_edited` hooks fire when std fs builtins record an edit, plus
 * any explicit `notify_file_edited` calls. They batch through a
 * thread-local queue and drain at agent-loop turn boundaries so VM
 * closures invoke inside an async builtin context.
 */
let edits_seen = atomic(0)

pipeline default() {
  clear_session_hooks()
  register_session_hook(
    "file_edited",
    { event ->
      let op = to_string(event?.metadata?.operation ?? "")
      if op == "write" || op == "append" {
        atomic_add(edits_seen, 1)
      }
      return nil
    },
  )
  let tmp = path_join(temp_dir(), "hooks_session_file_edited.txt")
  write_file(tmp, "hello")
  append_file(tmp, " world")
  notify_file_edited(tmp, {operation: "append", bytes: 11})
  llm_mock_clear()
  llm_mock({text: "ok"})
  let result = agent_loop("touch some files", nil, {provider: "mock"})
  __io_println(result.status)
  __io_println(atomic_get(edits_seen))
  delete_file(tmp)
  clear_session_hooks()
}
