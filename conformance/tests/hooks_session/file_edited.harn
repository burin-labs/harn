import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

/**
 * `file_edited` hooks fire when std fs builtins record an edit, plus
 * any explicit `notify_file_edited` calls. They batch through a
 * thread-local queue and drain at agent-loop turn boundaries so VM
 * closures invoke inside an async builtin context.
 */
pipeline default(harness: Harness) {
  const edits_seen = harness.runtime.atomic(0)
  harness.agent.clear_session_hooks()
  harness.agent.register_session_hook(
    "file_edited",
    { event ->
      const op = to_string(event?.metadata?.operation ?? "")
      if op == "write" || op == "append" {
        harness.runtime.atomic_add(edits_seen, 1)
      }
      return nil
    },
  )
  const tmp = path_join(harness.fs.workspace_temp_dir(), "hooks_session_file_edited-" + harness.random.uuid() + ".txt")
  harness.fs.write_text(tmp, "hello")
  harness.fs.append(tmp, " world")
  harness.agent.notify_file_edited(tmp, {operation: "append", bytes: 11})
  with_llm_script(
    harness.llm, [llm_text("ok")],
    { ->
      const result = agent_loop(harness, "touch some files", nil, {provider: "mock"})
      harness.stdio.println(result.status)
      harness.stdio.println(harness.runtime.atomic_get(edits_seen))
      if harness.fs.exists(tmp) {
        harness.fs.delete(tmp)
      }
      harness.agent.clear_session_hooks()
    },
  )
}
