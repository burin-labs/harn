import { llm_text, with_llm_script } from "std/testing"

/**
 * Hook invocations capture deterministic tape entries on the transcript:
 * `hook_call` before the closure runs, `hook_returned` after, and a
 * `hook_vetoed` entry when the hook blocks the operation. Replay
 * tooling consumes these so the same tape reproduces the same control
 * flow.
 */
fn count_kind(events, kind) {
  let n = 0
  for ev in events {
    if to_string(ev?.kind ?? "") == kind {
      n = n + 1
    }
  }
  return n
}

pipeline default() {
  clear_session_hooks()
  register_session_hook(
    "user_prompt_submit",
    { event ->
      const prompt = to_string(event?.prompt ?? "")
      if prompt.contains("vetome") {
        return {block: true, reason: "captured by tape"}
      }
      return nil
    },
  )
  register_session_hook("session_start", { _event -> return nil })
  with_llm_script(
    [llm_text("ok")],
    { ->
      const result = agent_loop("hello vetome please", nil, {provider: "mock"})
      const events = transcript_events(result?.transcript)
      __io_println(result.status)
      __io_println(count_kind(events, "hook_call") > 0)
      __io_println(count_kind(events, "hook_returned") > 0)
      __io_println(count_kind(events, "hook_vetoed") > 0)
      clear_session_hooks()
    },
  )
}
