import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

/**
 * `permission_asked` hooks can short-circuit the dynamic permission
 * policy by returning a `{decision: "allow"|"deny", reason}` dict.
 * `permission_replied` is advisory and observes the final decision.
 */
fn make_tools() {
  const registry = tool_registry()
  return tool_define(
    registry,
    "guarded_tool",
    "A tool that needs permission",
    {parameters: {}, handler: { _args -> "guarded-output" }},
  )
}

pipeline default(harness: Harness) {
  const replies = harness.runtime.atomic(0)
  harness.agent.clear_session_hooks()
  harness.agent.register_session_hook(
    "permission_asked",
    { event ->
      if to_string(event?.tool?.name ?? "") == "guarded_tool" {
        return {decision: "deny", reason: "session hook says no"}
      }
      return nil
    },
  )
  harness.agent.register_session_hook(
    "permission_replied",
    { event ->
      if to_string(event?.decision ?? "") == "deny" {
        harness.runtime.atomic_add(replies, 1)
      }
      return nil
    },
  )
  with_llm_script(
    harness.llm, [{tool_calls: [{id: "call_1", name: "guarded_tool", arguments: {}}]}, llm_text("done")],
    { ->
      const result = agent_loop(harness, "use guarded tool",
        nil,
        {
          provider: "mock",
          tools: make_tools(),
          tool_format: "native",
          max_iterations: 2,
          permissions: {deny: ["guarded_tool"], on_escalation: { _req -> return false }},
        },
      )
      harness.stdio.println(result.status)
      harness.stdio.println(harness.runtime.atomic_get(replies))
      harness.agent.clear_session_hooks()
    },
  )
}
