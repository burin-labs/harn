/**
 * `pipeline_on_finish` registers a callback that runs between PreFinish
 * and PostFinish, receives `(harness, return_value)`, and can transform
 * the pipeline's return value. PreFinish and PostFinish are emitted by
 * the runtime around the callback boundary. OnUnsettledDetected stays
 * silent until P-04 wires the unsettled-state producers.
 *
 * Tracking: harn#1854.
 */
pipeline default(harness: Harness) {
  harness.agent.clear_session_hooks()
  harness.agent.register_session_hook(
    "pre_finish",
    { _hook_harness, event ->
      harness.stdio.println(
        "pre_finish: has_on_finish=" + to_string(event.has_on_finish) + " return_value="
          + to_string(event.return_value),
      )
      return nil
    },
  )
  harness.agent.register_session_hook(
    "post_finish",
    { _hook_harness, event ->
      harness.stdio.println("post_finish: return_value=" + to_string(event.return_value))
      return nil
    },
  )
  harness.agent.register_session_hook(
    "on_unsettled_detected",
    { _hook_harness, event ->
      harness.stdio.println("on_unsettled_detected fired (unexpected for P-01)")
      return nil
    },
  )
  harness.agent.pipeline_on_finish(
    { _harness, return_value ->
      harness.stdio.println("on_finish: return_value=" + to_string(return_value))
      return return_value + 100
    },
  )
  harness.stdio.println("body done")
  return 7
}
