pipeline main() {
  let topic = "transcript.reminder.lifecycle"
  let cursor = event_log.latest(topic)
  let first = transcript
    .inject_reminder(transcript(), {body: "old reminder", dedupe_key: "context-slot", ttl_turns: 2})
  let second = transcript
    .inject_reminder(
    first.transcript,
    {body: "new reminder", dedupe_key: "context-slot", ttl_turns: 3},
  )
  let stream = event_log.subscribe({topic: topic, from_cursor: cursor})
  let logged = stream.next().value
  println(second.deduped_count)
  println(logged.kind)
  println(logged.payload.dedupe_key)
  println(logged.payload.reminder_id == second.reminder_id)
  println(logged.payload.dropped_count)
  println(len(logged.payload.dropped_reminder_ids))
}
