import { agent_reminder_providers_fire } from "std/agent/state"

pipeline main(harness: Harness) {
  const enabled_session = harness.agent.open("provider-opt-out-enabled")
  harness.agent.reset(enabled_session)
  const payload = {session: {id: enabled_session}, iteration: 1, wake_interval_ms: 65000}
  const enabled = agent_reminder_providers_fire(harness, enabled_session,
    "session_idle",
    payload,
    {reminders: {config: {idle_nudge: {idle_seconds: 60}}}},
  )
  const enabled_reminders = transcript_events_by_kind(
    harness.agent.snapshot(enabled_session),
    "system_reminder",
  )
  // Opt out by listing the negated provider name.
  const opted_out_session = harness.agent.open("provider-opt-out-disabled")
  harness.agent.reset(opted_out_session)
  const opted_out = agent_reminder_providers_fire(harness, opted_out_session,
    "session_idle",
    {session: {id: opted_out_session}, iteration: 1, wake_interval_ms: 65000},
    {reminders: {providers: ["-idle_nudge"], config: {idle_nudge: {idle_seconds: 60}}}},
  )
  const opted_out_reminders = transcript_events_by_kind(
    harness.agent.snapshot(opted_out_session),
    "system_reminder",
  )
  harness.stdio.println(enabled.fired_count)
  harness.stdio.println(len(enabled_reminders))
  harness.stdio.println(opted_out.fired_count)
  harness.stdio.println(len(opted_out_reminders))
}
