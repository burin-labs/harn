/**
 * routing_policy validates the config dict and throws clear errors
 * when shape is wrong.
 */
pipeline test(harness: Harness, task) {
  const r1 = try {
    harness.llm.routing_policy({chain: []})
    "no_error"
  } catch (e) {
    "empty_chain"
  }
  harness.stdio.println(r1)
  const r2 = try {
    harness.llm.routing_policy({chain: [{provider: "mock"}]})
    "no_error"
  } catch (e) {
    "missing_model"
  }
  harness.stdio.println(r2)
  const r3 = try {
    harness.llm.routing_policy(
      {chain: [{provider: "mock", model: "mock"}], failover: {on_status: [99]}},
    )
    "no_error"
  } catch (e) {
    "bad_status"
  }
  harness.stdio.println(r3)
  const r4 = try {
    harness.llm.routing_policy(
      {chain: [{provider: "mock", model: "mock"}], budget: {on_exceed: "explode"}},
    )
    "no_error"
  } catch (e) {
    "bad_on_exceed"
  }
  harness.stdio.println(r4)
}
