import "../_common"

pipeline default() {
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(harness.fs.temp_dir(), "harn_pack_basic_" + uuid_v7())
  harness.fs.mkdir(root)
  harness.fs.write_text(path_join(root, "hello.harn"), "__io_println(\"hi\")\n")
  const pack = exec_at(
    root,
    harn_bin,
    "pack",
    "hello.harn",
    "--unsigned",
    "--out",
    path_join(root, "hello.harnpack"),
    "--json",
  )
  __io_println(pack.success)
  const pack_data = json_parse(pack.stdout)
  __io_println(pack_data.schemaVersion >= 1)
  __io_println(pack_data.ok)
  __io_println(starts_with(pack_data.data.bundle_hash, "blake3:"))
  __io_println(pack_data.data.signature.present)
  __io_println(harness.fs.exists(path_join(root, "hello.harnpack")))
  const verify = exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--allow-unsigned",
    "--json",
  )
  __io_println(verify.success)
  const verify_data = json_parse(verify.stdout)
  __io_println(verify_data.ok)
  __io_println(verify_data.data.bundle_hash == pack_data.data.bundle_hash)
  __io_println(verify_data.data.signature_present)
  __io_println(verify_data.data.signature_verified)
  __io_println(verify_data.data.module_count)
}
