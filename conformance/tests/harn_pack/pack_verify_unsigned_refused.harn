import "../_common"

pipeline default(harness: Harness) {
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(harness.fs.temp_dir(), "harn_pack_unsigned_" + harness.random.uuid_v7())
  harness.fs.mkdir(root)
  harness.fs.write_text(path_join(root, "hello.harn"), "harness.stdio.println(\"hi\")\n")
  const pack = exec_at(
    root,
    harn_bin,
    "pack",
    "hello.harn",
    "--unsigned",
    "--out",
    path_join(root, "hello.harnpack"),
  )
  harness.stdio.println(pack.success)
  const strict = exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--json",
  )
  // Strict verify on an unsigned bundle MUST exit non-zero.
  harness.stdio.println(strict.success)
  const strict_data = json_parse(strict.stdout)
  harness.stdio.println(strict_data.ok)
  harness.stdio.println(strict_data.error.code)
  const lenient = exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--allow-unsigned",
    "--json",
  )
  harness.stdio.println(lenient.success)
  const lenient_data = json_parse(lenient.stdout)
  harness.stdio.println(lenient_data.ok)
  harness.stdio.println(lenient_data.data.signature_present)
  harness.stdio.println(lenient_data.data.signature_verified)
}
