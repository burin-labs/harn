import "../_common"

pipeline default(harness: Harness) {
  const repo_root = harness.process.exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(harness.fs.workspace_temp_dir(), "harn_pack_secret_" + harness.random.uuid_v7())
  harness.fs.mkdir(root)
  // Entrypoint whose name matches the .env-style secret heuristic.
  harness.fs.write_text(
    path_join(root, ".env.harn"),
    "harness.stdio.println(\"secret-bearing entrypoint\")\n",
  )
  const blocked = harness.process.exec_at(
    root,
    harn_bin,
    "pack",
    ".env.harn",
    "--unsigned",
    "--exclude-secrets",
    "--out",
    path_join(root, "blocked.harnpack"),
    "--json",
  )
  harness.stdio.println(blocked.success)
  const blocked_data = json_parse(blocked.stdout)
  harness.stdio.println(blocked_data.ok)
  harness.stdio.println(blocked_data.error.code)
  harness.stdio.println(harness.fs.exists(path_join(root, "blocked.harnpack")))
  // Same entrypoint without --exclude-secrets must pack successfully.
  const ok = harness.process.exec_at(
    root,
    harn_bin,
    "pack",
    ".env.harn",
    "--unsigned",
    "--include-secrets",
    "--out",
    path_join(root, "ok.harnpack"),
    "--json",
  )
  harness.stdio.println(ok.success)
  const ok_data = json_parse(ok.stdout)
  harness.stdio.println(ok_data.ok)
  harness.stdio.println(harness.fs.exists(path_join(root, "ok.harnpack")))
}
