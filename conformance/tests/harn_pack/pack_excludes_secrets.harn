import "../_common"

pipeline default() {
  let repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  let harn_bin = env_or("HARN_CONFORMANCE_HARN_BIN", resolve_harn_bin(repo_root))
  let root = path_join(temp_dir(), "harn_pack_secret_" + uuid_v7())
  mkdir(root)
  // Entrypoint whose name matches the .env-style secret heuristic.
  write_file(path_join(root, ".env.harn"), "println(\"secret-bearing entrypoint\")\n")

  let blocked = exec_at(
    root,
    harn_bin,
    "pack",
    ".env.harn",
    "--unsigned",
    "--exclude-secrets",
    "--out",
    path_join(root, "blocked.harnpack"),
    "--json",
  )
  println(blocked.success)
  let blocked_data = json_parse(blocked.stdout)
  println(blocked_data.ok)
  println(blocked_data.error.code)
  println(file_exists(path_join(root, "blocked.harnpack")))

  // Same entrypoint without --exclude-secrets must pack successfully.
  let ok = exec_at(
    root,
    harn_bin,
    "pack",
    ".env.harn",
    "--unsigned",
    "--include-secrets",
    "--out",
    path_join(root, "ok.harnpack"),
    "--json",
  )
  println(ok.success)
  let ok_data = json_parse(ok.stdout)
  println(ok_data.ok)
  println(file_exists(path_join(root, "ok.harnpack")))
}
