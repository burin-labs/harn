import "../_common"

pipeline default() {
  let repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  let harn_bin = harness.env.get_or("HARN_CONFORMANCE_HARN_BIN", resolve_harn_bin(repo_root))
  let root = path_join(harness.fs.temp_dir(), "harn_pack_secret_" + uuid_v7())
  harness.fs.mkdir(root)
  // Entrypoint whose name matches the .env-style secret heuristic.
  harness.fs.write_text(path_join(root, ".env.harn"), "__io_println(\"secret-bearing entrypoint\")\n")
  let blocked = exec_at(
    root,
    harn_bin,
    "pack",
    ".env.harn",
    "--unsigned",
    "--exclude-secrets",
    "--out",
    path_join(root, "blocked.harnpack"),
    "--json",
  )
  __io_println(blocked.success)
  let blocked_data = json_parse(blocked.stdout)
  __io_println(blocked_data.ok)
  __io_println(blocked_data.error.code)
  __io_println(harness.fs.exists(path_join(root, "blocked.harnpack")))
  // Same entrypoint without --exclude-secrets must pack successfully.
  let ok = exec_at(
    root,
    harn_bin,
    "pack",
    ".env.harn",
    "--unsigned",
    "--include-secrets",
    "--out",
    path_join(root, "ok.harnpack"),
    "--json",
  )
  __io_println(ok.success)
  let ok_data = json_parse(ok.stdout)
  __io_println(ok_data.ok)
  __io_println(harness.fs.exists(path_join(root, "ok.harnpack")))
}
