import "../_common"

pipeline default(harness: Harness) {
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(harness.fs.temp_dir(), "harn_pack_json_" + harness.random.uuid_v7())
  harness.fs.mkdir(root)
  harness.fs.write_text(path_join(root, "hello.harn"), "harness.stdio.println(\"json\")\n")
  const pack = exec_at(
    root,
    harn_bin,
    "pack",
    "hello.harn",
    "--unsigned",
    "--out",
    path_join(root, "hello.harnpack"),
    "--json",
  )
  harness.stdio.println(pack.success)
  const pack_data = json_parse(pack.stdout)
  harness.stdio.println(pack_data.ok)
  // schemaVersion is monotonically bumped; assert it's at least the
  // baseline that shipped with #1781.
  harness.stdio.println(pack_data.schemaVersion >= 2)
  harness.stdio.println(starts_with(pack_data.data.bundle_hash, "blake3:"))
  harness.stdio.println(pack_data.data.signature.algorithm)
  const verify = exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--allow-unsigned",
    "--json",
  )
  harness.stdio.println(verify.success)
  const verify_data = json_parse(verify.stdout)
  harness.stdio.println(verify_data.ok)
  harness.stdio.println(verify_data.schemaVersion >= 1)
  harness.stdio.println(verify_data.data.bundle_hash == pack_data.data.bundle_hash)
}
