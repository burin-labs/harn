import "../_common"

pipeline default(harness: Harness) {
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(harness.fs.temp_dir(), "harn_pack_untrusted_signer_" + harness.random.uuid_v7())
  harness.fs.mkdir(root)
  harness.fs.write_text(path_join(root, "hello.harn"), "harness.stdio.println(\"signed\")\n")
  harness.fs.write_text(
    path_join(root, "release-key.pem"),
    "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIDmsNDO8iZqiMmA/b7I7lwGXNKe68o+gDno6R5riUcDC\n-----END PRIVATE KEY-----\n",
  )
  const pack = exec_at(
    root,
    harn_bin,
    "pack",
    "hello.harn",
    "--sign",
    "--key",
    path_join(root, "release-key.pem"),
    "--out",
    path_join(root, "hello.harnpack"),
  )
  harness.stdio.println(pack.success)
  const permissive = exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--json",
  )
  const permissive_data = json_parse(permissive.stdout)
  const signer = permissive_data.data.key_id
  const signers = path_join(root, "signers")
  harness.fs.mkdir(signers)
  harness.stdio.println(
    exec_at(
      root,
      "openssl",
      "pkey",
      "-in",
      path_join(root, "release-key.pem"),
      "-pubout",
      "-out",
      path_join(signers, signer + ".pub"),
    ).success,
  )
  harness.fs.write_text(
    path_join(root, "trust-policy.json"),
    json_stringify({signer_registry_url: signers, trusted_signers: ["not-the-real-signer"]}),
  )
  const verify = exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--require-trusted-signer",
    "--trust-policy",
    path_join(root, "trust-policy.json"),
    "--json",
  )
  harness.stdio.println(verify.success)
  const verify_data = json_parse(verify.stdout)
  harness.stdio.println(verify_data.ok)
  harness.stdio.println(verify_data.error.code)
}
