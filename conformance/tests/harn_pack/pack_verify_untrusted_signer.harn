import "../_common"

pipeline default(harness: Harness) {
  const repo_root = harness.process.exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn_pack_untrusted_signer_" + harness.random.uuid_v7(),
  )
  harness.fs.mkdir(root)
  harness.fs.write_text(
    path_join(root, "hello.harn"),
    "fn main(harness: Harness) { harness.stdio.println(\"signed\") }\n",
  )
  // Ed25519 test fixture generated with openssl genpkey on 2026-08-16 solely as a
  // test prop. Despite the file name this signs nothing real, is enrolled in no
  // trust store, and is safe to be public; the trust policy below deliberately
  // excludes it so verification reports an untrusted signer.
  harness.fs.write_text(
    path_join(root, "release-key.pem"),
    "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIIzGEtl10MUJbWnniBSN7o0kL2NJSVoev7Ct/1my+9/q\n-----END PRIVATE KEY-----\n",
  )
  const pack = harness.process.exec_at(
    root,
    harn_bin,
    "pack",
    "hello.harn",
    "--sign",
    "--key",
    path_join(root, "release-key.pem"),
    "--out",
    path_join(root, "hello.harnpack"),
  )
  harness.stdio.println(pack.success)
  const permissive = harness.process.exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--json",
  )
  const permissive_data = json_parse(permissive.stdout)
  const signer = permissive_data.data.key_id
  const signers = path_join(root, "signers")
  harness.fs.mkdir(signers)
  const public_key = harness.process.exec_at(
    root,
    "openssl",
    "pkey",
    "-in",
    path_join(root, "release-key.pem"),
    "-pubout",
    "-out",
    path_join(signers, signer + ".pub"),
  )
  harness.stdio.println(public_key.success)
  require public_key.success, "failed to derive fixture public key: " + public_key.stderr
  harness.fs.write_text(
    path_join(root, "trust-policy.json"),
    json_stringify({signer_registry_url: signers, trusted_signers: ["not-the-real-signer"]}),
  )
  const verify = harness.process.exec_at(
    root,
    harn_bin,
    "pack",
    "verify",
    path_join(root, "hello.harnpack"),
    "--require-trusted-signer",
    "--trust-policy",
    path_join(root, "trust-policy.json"),
    "--json",
  )
  harness.stdio.println(verify.success)
  const verify_data = json_parse(verify.stdout)
  harness.stdio.println(verify_data.ok)
  harness.stdio.println(verify_data.error.code)
}
