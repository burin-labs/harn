/**
 * Verify the per-platform sandbox backend dispatched at compile time
 * matches the host OS, and that the platform mechanism it relies on
 * is reachable. Acts as a smoke check that the SandboxBackend trait
 * stays wired up across refactors — if a future change breaks
 * platform selection, this fixture flips before any of the
 * behavior-level fixtures notice.
 */
pipeline default(harness: Harness) {
  const backend = harness.system.sandbox_active_backend()
  // Harn `harness.system.platform().os` returns the underlying OS slug (`darwin`,
  // `linux`, `windows`, `openbsd`); the sandbox backend names map
  // 1:1 to those except `darwin` → `macos` to keep the docs and
  // marketing material aligned with how Apple brands the OS.
  const expected = if harness.system.platform().os == "linux" {
    "linux"
  } else if harness.system.platform().os == "darwin" {
    "macos"
  } else if harness.system.platform().os == "windows" {
    "windows"
  } else if harness.system.platform().os == "openbsd" {
    "openbsd"
  } else {
    "noop"
  }
  harness.stdio.println(backend == expected)
  // The conformance runner confines each case to the directories it owns,
  // which is the path axis only: cases are first-party code and several
  // legitimately shell out. `harn run` installs the stricter `worktree`
  // default, covered in CLI-specific coverage.
  harness.stdio.println(harness.system.sandbox_active_profile())
  // Each shipped backend reports availability as `true` on its host.
  // (Linux Landlock/seccomp are runtime-detected by the per-mechanism
  // setup, so the backend reports `true` even on kernels missing one
  // or both — the per-mechanism unavailability surfaces as a
  // structured warning rather than a backend-availability flip.)
  harness.stdio.println(harness.system.sandbox_backend_available())
}
