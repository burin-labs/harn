/**
 * Structured path visibility keeps missing, out-of-scope, and read-only
 * denials distinguishable under a restricted worktree policy.
 */
pipeline default(harness: Harness) {
  const base = path_join(
    harness.fs.temp_dir(),
    "harn_fs_path_status_scope_" + to_string(harness.random.range(100000, 999999)),
  )
  const root = path_join(base, "workspace")
  const readonly = path_join(base, "readonly")
  harness.fs.mkdir(root)
  harness.fs.mkdir(readonly)
  const in_path = path_join(root, "in.txt")
  const out_path = path_join(base, "outside.txt")
  const readonly_path = path_join(readonly, "read-only.txt")
  harness.fs.write_text(in_path, "ok\n")
  harness.fs.write_text(out_path, "secret\n")
  harness.fs.write_text(readonly_path, "readonly\n")
  harness.runtime.with_execution_policy(
    {sandbox_profile: "worktree", workspace_roots: [root], read_only_roots: [readonly]},
    { ->
      const in_status = harness.fs.status(in_path)
      harness.stdio.println(in_status.status)
      harness.stdio.println(in_status.visible)
      harness.stdio.println(in_status.exists)
      const missing_status = harness.fs.status(path_join(root, "missing.txt"))
      harness.stdio.println(missing_status.status)
      harness.stdio.println(missing_status.visible)
      harness.stdio.println(missing_status.exists)
      const out_status = harness.fs.status(out_path)
      harness.stdio.println(out_status.status)
      harness.stdio.println(out_status.visible)
      harness.stdio.println(out_status.exists == nil)
      harness.stdio.println(contains(out_status.message, "outside workspace_roots"))
      const readonly_read = harness.fs.status(readonly_path)
      harness.stdio.println(readonly_read.status)
      harness.stdio.println(readonly_read.exists)
      const readonly_write = harness.fs.status(readonly_path, "write")
      harness.stdio.println(readonly_write.status)
      harness.stdio.println(readonly_write.visible)
      harness.stdio.println(readonly_write.exists == nil)
      harness.stdio.println(readonly_write.read_only)
    },
  )
  harness.fs.delete(base)
}
