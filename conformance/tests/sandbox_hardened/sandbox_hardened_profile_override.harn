/**
 * Verify the per-call sandbox_profile parameter on
 * host_call("process.exec", ...) parses the documented profile names
 * and rejects unknown values with a typed error rather than silently
 * running the command unsandboxed.
 */
pipeline default() {
  const argv = if platform() == "windows" {
    ["cmd", "/C", "echo|set /p=ok"]
  } else {
    ["printf", "ok"]
  }
  const result = host_call("process.exec", {mode: "argv", argv: argv, sandbox_profile: "worktree"})
  __io_println(result?.success)
  __io_println(result?.stdout)
  const unrestricted = host_call("process.exec", {mode: "argv", argv: argv, sandbox_profile: "unrestricted"})
  __io_println(unrestricted?.success)
  const bad = try {
    host_call("process.exec", {mode: "argv", argv: argv, sandbox_profile: "wide_open"})
    nil
  } catch (e) {
    e
  }
  __io_println(bad != nil)
}
