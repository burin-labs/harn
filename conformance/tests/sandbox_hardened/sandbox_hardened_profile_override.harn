/**
 * Verify the per-call sandbox_profile parameter on
 * harness.process.run( ...) parses the documented profile names
 * and rejects unknown values with a typed error rather than silently
 * running the command unsandboxed.
 */
pipeline default(harness: Harness) {
  const argv = if harness.system.platform().os == "windows" {
    ["cmd", "/C", "echo|set /p=ok"]
  } else {
    ["printf", "ok"]
  }
  const result = harness.process.run(
    {program: argv[0], args: argv[1:len(argv)], sandbox_profile: "worktree"},
  )
  harness.stdio.println(result.success)
  harness.stdio.println(result.stdout)
  const unrestricted = harness.process.run(
    {program: argv[0], args: argv[1:len(argv)], sandbox_profile: "unrestricted"},
  )
  harness.stdio.println(unrestricted.success)
  const workspace_paths = harness.process.run(
    {program: argv[0], args: argv[1:len(argv)], sandbox_profile: "workspace_paths"},
  )
  harness.stdio.println(workspace_paths.success)
  const bad = try {
    harness.process.run({program: argv[0], args: argv[1:len(argv)], sandbox_profile: "wide_open"})
    nil
  } catch (e) {
    e
  }
  harness.stdio.println(bad != nil)
}
