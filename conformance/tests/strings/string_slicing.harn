pipeline test(harness: Harness, task: unknown) {
  // Basic slicing
  harness.stdio.log("hello"[1:3])
  // Full string
  harness.stdio.log("hello"[0:5])
  // From start
  harness.stdio.log("hello"[:3])
  // To end
  harness.stdio.log("hello"[2:])
  // Negative indices
  harness.stdio.log("hello"[-2:])
  harness.stdio.log("hello"[:-1])
  // Empty slice produces empty string
  assert_eq("hello"[2:2], "")
  // Single char index
  harness.stdio.log("hello"[0])
  harness.stdio.log("hello"[-1])
  // Unicode slicing
  const emoji = "ab"
  harness.stdio.log(emoji[0])
  harness.stdio.log(emoji[1])
  harness.stdio.log(len(emoji))
  // Empty string slice
  assert_eq(""[:], "")
  harness.stdio.log("slicing ok")
}
