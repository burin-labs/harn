pipeline test(harness: Harness, task) {
  // Basic slicing
  harness.stdio.println("hello"[1:3])
  // Full string
  harness.stdio.println("hello"[0:5])
  // From start
  harness.stdio.println("hello"[:3])
  // To end
  harness.stdio.println("hello"[2:])
  // Negative indices
  harness.stdio.println("hello"[-2:])
  harness.stdio.println("hello"[:-1])
  // Empty slice produces empty string
  assert_eq("hello"[2:2], "")
  // Single char index
  harness.stdio.println("hello"[0])
  harness.stdio.println("hello"[-1])
  // Unicode slicing
  const emoji = "ab"
  harness.stdio.println(emoji[0])
  harness.stdio.println(emoji[1])
  harness.stdio.println(len(emoji))
  // Empty string slice
  assert_eq(""[:], "")
  harness.stdio.println("slicing ok")
}
