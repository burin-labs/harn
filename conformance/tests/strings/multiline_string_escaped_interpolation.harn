pipeline test(harness: Harness, task) {
  const name = "world"
  const single = "\${VAR}"
  harness.stdio.println("single=${single}")
  const multi = """
    shell \${VAR:-default}
    harn ${name}
    """
  harness.stdio.println(multi)
  const escaped_only = """
    only \${VAR}
    """
  harness.stdio.println(escaped_only)
}
