/** Unicode string operations: slicing, contains, split, replace, interpolation */
pipeline default(harness: Harness, task) {
  const emoji = "Hello 🌍🔥 World"
  // len counts characters, not bytes
  harness.stdio.println(len(emoji))
  // contains with multi-byte
  harness.stdio.println(emoji.contains("🌍"))
  harness.stdio.println(emoji.contains("🎉"))
  // replace multi-byte
  harness.stdio.println(emoji.replace("🔥", "💧"))
  // split around multi-byte
  harness.stdio.println("a🔥b🔥c".split("🔥"))
  // starts_with / ends_with
  harness.stdio.println("café".starts_with("caf"))
  harness.stdio.println("café".ends_with("fé"))
  // interpolation with multi-byte
  const name = "André"
  harness.stdio.println("Hello ${name}!")
  // CJK characters
  const cjk = "中文测试"
  harness.stdio.println(len(cjk))
  harness.stdio.println(cjk.contains("文"))
  // Accented characters
  const accented = "naïve résumé"
  harness.stdio.println(accented.replace("é", "e"))
}
