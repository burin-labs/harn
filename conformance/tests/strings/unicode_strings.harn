/** Unicode string operations: slicing, contains, split, replace, interpolation */
pipeline default(harness: Harness, task: unknown) {
  const emoji = "Hello 🌍🔥 World"
  // len counts characters, not bytes
  harness.stdio.log(len(emoji))
  // contains with multi-byte
  harness.stdio.log(emoji.contains("🌍"))
  harness.stdio.log(emoji.contains("🎉"))
  // replace multi-byte
  harness.stdio.log(emoji.replace("🔥", "💧"))
  // split around multi-byte
  harness.stdio.log("a🔥b🔥c".split("🔥"))
  // starts_with / ends_with
  harness.stdio.log("café".starts_with("caf"))
  harness.stdio.log("café".ends_with("fé"))
  // interpolation with multi-byte
  const name = "André"
  harness.stdio.log("Hello ${name}!")
  // CJK characters
  const cjk = "中文测试"
  harness.stdio.log(len(cjk))
  harness.stdio.log(cjk.contains("文"))
  // Accented characters
  const accented = "naïve résumé"
  harness.stdio.log(accented.replace("é", "e"))
}
