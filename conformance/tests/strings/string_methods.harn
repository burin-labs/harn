pipeline test(harness: Harness, task) {
  harness.stdio.println("hello world".replace("world", "harn"))
  harness.stdio.println("a,b,c".split(","))
  harness.stdio.println("  hello  ".trim())
  harness.stdio.println("hello".starts_with("hel"))
  harness.stdio.println("hello".starts_with("xyz"))
  harness.stdio.println("hello".ends_with("lo"))
  harness.stdio.println("hello".ends_with("xy"))
  harness.stdio.println("hello".substring(1, 3))
  // Negative / out-of-range indices clamp to [0, len]; end < start yields "".
  harness.stdio.println("[" + "hello world".substring(0, -1) + "]")
  harness.stdio.println("[" + "hello world".substring(-3, 5) + "]")
  harness.stdio.println("[" + "hello world".substring(2, -3) + "]")
  harness.stdio.println("[" + "hello world".substring(0, 100) + "]")
}
