pipeline test(task) {
  // repeat
  assert_eq(repeat("ab", 3), "ababab", "repeat triples a string")
  assert_eq(repeat("x", 0), "", "repeat with zero gives empty")
  assert_eq(repeat("", 5), "", "empty input stays empty")
  // indent
  const multi = "first\nsecond\n\nfourth"
  const bumped = indent(multi, "  ")
  assert_eq(bumped, "  first\n  second\n\n  fourth", "indent preserves blank lines")
  // dedent: strip the longest common prefix
  const heredoc = "    line one\n      line two\n    line three"
  const flush = dedent(heredoc)
  assert_eq(flush, "line one\n  line two\nline three", "dedent strips minimum common prefix")
  // word_wrap
  const wrapped = word_wrap("the quick brown fox jumps over the lazy dog", 15)
  assert_eq(
    wrapped,
    "the quick brown\nfox jumps over\nthe lazy dog",
    "word_wrap breaks at word boundary",
  )
  assert_eq(
    word_wrap("alpha beta\ngamma delta", 20),
    "alpha beta\ngamma delta",
    "word_wrap preserves paragraphs under the limit",
  )
  // word_wrap measures terminal columns, not graphemes: a CJK glyph and an
  // emoji each occupy two columns, so fewer fit per line than a grapheme
  // count would have allowed. This is a deliberate behavior change.
  assert_eq(
    word_wrap("日 本 語 で", 5),
    "日 本\n語 で",
    "word_wrap counts CJK glyphs as two columns",
  )
  assert_eq(word_wrap("🚀 🚀 🚀", 5), "🚀 🚀\n🚀", "word_wrap counts an emoji as two columns")
  // A combining mark adds no width: "café" is e + a combining acute,
  // five code points but four columns, so both words share a nine-column
  // line where a naive code-point count (five each) would have split them.
  assert_eq(word_wrap("café café", 9), "café café", "word_wrap ignores zero-width combining marks")
  log("string helpers: all tests passed")
}
