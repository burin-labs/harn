pipeline test(harness: Harness, task: unknown) {
  const _missing = nil
  // A nested string literal inside an interpolation hole uses bare double
  // quotes; its contents — including `}` and `{` — must not end the hole.
  harness.stdio.log("fallback: ${_missing ?? "unknown"}")
  harness.stdio.log("brace in string: ${_missing ?? "a}b{c"}")
  const _d = {"a}b": 7}
  harness.stdio.log("dict key with brace: ${_d["a}b"]}")
  harness.stdio.log("call with brace arg: ${["x}y", "z"].count}")
}
