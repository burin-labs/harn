fn fail(message) {
  throw message
}

fn identity(value) {
  return value
}

fn return_value(stdio: HarnessStdio) {
  try {
    return "value"
  } finally {
    stdio.println("cleanup:value")
  }
}

fn return_failed_call(stdio: HarnessStdio) {
  try {
    return fail("direct")
  } finally {
    stdio.println("cleanup:direct")
  }
}

fn return_nested_failed_call(stdio: HarnessStdio) {
  try {
    return identity(fail("nested"))
  } finally {
    stdio.println("cleanup:nested")
  }
}

fn return_with_failed_cleanup() {
  try {
    return fail("original")
  } finally {
    throw "cleanup"
  }
}

fn throw_failed_call(stdio: HarnessStdio) {
  try {
    throw fail("throw operand")
  } finally {
    stdio.println("cleanup:throw operand")
  }
}

fn continue_and_break() {
  let events = []
  for i in [1, 2, 3] {
    try {
      if i == 1 {
        continue
      }
      if i == 3 {
        break
      }
      events = events + ["body:${i}"]
    } finally {
      events = events + ["cleanup:${i}"]
    }
  }
  return events
}

pipeline default(harness: Harness) {
  harness.stdio.println(return_value(harness.stdio))
  const direct = try {
    return_failed_call(harness.stdio)
  } catch (error) {
    "caught:${error}"
  }
  harness.stdio.println(direct)
  const nested = try {
    return_nested_failed_call(harness.stdio)
  } catch (error) {
    "caught:${error}"
  }
  harness.stdio.println(nested)
  const precedence = try {
    return_with_failed_cleanup()
  } catch (error) {
    "caught:${error}"
  }
  harness.stdio.println(precedence)
  const throw_operand = try {
    throw_failed_call(harness.stdio)
  } catch (error) {
    "caught:${error}"
  }
  harness.stdio.println(throw_operand)
  harness.stdio.println(continue_and_break())
}
