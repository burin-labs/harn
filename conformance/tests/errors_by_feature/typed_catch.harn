pipeline test(harness: Harness, task) {
  enum AppError {
    NotFound(msg)
    Forbidden(msg)
  }
  // Typed catch only catches matching enum errors
  fn may_fail() {
    throw AppError.NotFound("page not found")
  }
  try {
    may_fail()
  } catch (e: AppError) {
    harness.stdio.println("caught: ${e.variant}")
    harness.stdio.println(e.fields[0])
  }
}
