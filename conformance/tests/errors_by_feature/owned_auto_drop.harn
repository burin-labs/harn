pipeline test(task) {
  // `owned<channel>` auto-drops at lexical block exit.
  fn block_scope_drop() {
    let observable = channel("obs", 4)
    if true {
      let inner: owned<channel> = observable
      log("inside: closed?")
      log(channel_is_closed(inner))
    }
    // `observable` is the same Arc-shared handle — auto-drop on the inner
    // binding closes the underlying channel.
    log("after block: closed?")
    log(channel_is_closed(observable))
  }
  block_scope_drop()
  // Auto-drop fires on early return.
  fn early_return_drop() {
    let ch = channel("ret", 4)
    if true {
      let owned_ch: owned<channel> = ch
      log("before return: closed?")
      log(channel_is_closed(owned_ch))
      return ch
    }
    return ch
  }
  let after_return = early_return_drop()
  log("after return: closed?")
  log(channel_is_closed(after_return))
  // User-written defer runs before the synthetic auto-drop (LIFO: auto-drop
  // was pushed at the let-binding, user defer pushed later, runs first).
  fn lifo_with_user_defer() {
    let visible = channel("lifo", 4)
    if true {
      let h: owned<channel> = visible
      defer {
        log("user defer: closed before me?")
        log(channel_is_closed(h))
      }
      log("block body")
    }
    log("after block: closed?")
    log(channel_is_closed(visible))
  }
  lifo_with_user_defer()
  // Multiple owned bindings drop in LIFO order. Open three channels at
  // module scope so we can observe each one after the inner scope exits.
  fn multi_lifo() {
    let a = channel("a", 4)
    let b = channel("b", 4)
    let c = channel("c", 4)
    if true {
      let oa: owned<channel> = a
      let ob: owned<channel> = b
      let oc: owned<channel> = c
      log("inside: a, b, c closed?")
      log(channel_is_closed(oa))
      log(channel_is_closed(ob))
      log(channel_is_closed(oc))
    }
    log("after: a, b, c closed?")
    log(channel_is_closed(a))
    log(channel_is_closed(b))
    log(channel_is_closed(c))
  }
  multi_lifo()
}
