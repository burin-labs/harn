pipeline test(harness: Harness, task) {
  // Defer runs on explicit return
  fn with_cleanup() {
    defer {
      harness.stdio.println("cleanup done")
    }
    harness.stdio.println("doing work")
    return "result"
  }
  const r = with_cleanup()
  harness.stdio.println(r)
  // Multiple defers run in LIFO order
  fn lifo_order() {
    defer {
      harness.stdio.println("first registered")
    }
    defer {
      harness.stdio.println("second registered")
    }
    defer {
      harness.stdio.println("third registered")
    }
    harness.stdio.println("body")
  }
  lifo_order()
  // Defer runs on implicit return (no explicit return statement)
  fn implicit_return() {
    defer {
      harness.stdio.println("implicit cleanup")
    }
    harness.stdio.println("implicit body")
  }
  implicit_return()
  // Defer runs on throw
  fn throws_with_defer() {
    defer {
      harness.stdio.println("throw cleanup")
    }
    harness.stdio.println("before throw")
    throw "boom"
  }
  const err = try {
    throws_with_defer()
  }
  harness.stdio.println(is_err(err))
  harness.stdio.println(unwrap_err(err))
}
