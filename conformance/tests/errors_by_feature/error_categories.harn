/** Test structured error categories */
pipeline default(harness: Harness, task) {
  // throw_error creates categorized errors
  const r1 = try {
    throw_error("connection timed out", "timeout")
  }
  harness.stdio.println(is_err(r1))
  harness.stdio.println(error_category(unwrap_err(r1)))
  // is_timeout helper
  harness.stdio.println(is_timeout(unwrap_err(r1)))
  // rate limit
  const r2 = try {
    throw_error("too many requests", "rate_limit")
  }
  harness.stdio.println(error_category(unwrap_err(r2)))
  harness.stdio.println(is_rate_limited(unwrap_err(r2)))
  // generic error
  const r3 = try {
    throw "some error"
  }
  harness.stdio.println(error_category(unwrap_err(r3)))
}
