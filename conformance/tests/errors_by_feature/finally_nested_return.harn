pipeline test(harness: Harness, task) {
  // Test that finally runs even with return in nested try
  fn outer() {
    try {
      try {
        return "early"
      } finally {
        harness.stdio.println("inner finally")
      }
    } finally {
      harness.stdio.println("outer finally")
    }
    harness.stdio.println("unreachable")
  }
  const r = outer()
  harness.stdio.println("result: ${r}")
  // Finally with empty body should not crash
  fn with_empty_finally() {
    try {
      return 42
    } finally {
    }
  }
  harness.stdio.println(with_empty_finally())
}
