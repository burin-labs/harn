/**
 * Nested list/dict patterns in match arms are rejected with a clear compile
 * error rather than being silently miscompiled to an equality comparison
 * (which bound nothing and threw "undefined variable" at runtime, or matched
 * by structural equality and bound the wrong values).
 */
pipeline test(task) {
  const xs = [[1, 2], [3, 4]]
  const out = match xs {
    [[a, b], [c, d]] -> { a + b + c + d }
    _ -> { -1 }
  }
  log(out)
}
