import { agent_loop } from "std/agent/loop"
fn main(harness: Harness) {
  let opts = {
    provider: "mock",
    llm_caller: { _call -> return {text: "custom caller must not mask removed keys"} },
  }
  opts["output_schema"] = {type: "object"}
  agent_loop(harness, "Validate options before invoking the custom caller.", nil, opts)
}
