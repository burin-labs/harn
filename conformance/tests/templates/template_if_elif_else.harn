  harness.stdio.println(harness.fs.render_prompt("fixtures/template/if_elif_else.prompt", {n: 2}))
  harness.stdio.println(harness.fs.render_prompt("fixtures/template/if_elif_else.prompt", {n: 3}))
  harness.stdio.println(harness.fs.render_prompt("fixtures/template/if_elif_else.prompt", {n: 99}))
}
