pipeline default(harness: Harness) {
  const data = {
    name: "alice",
    NAME: "BOB",
    items: ["x", "y", "z"],
    phrase: "hello world",
    obj: {a: 1, b: 2},
    block: "line1\nline2\nline3",
  }
  harness.stdio.println(harness.fs.render_prompt("fixtures/template/filters.prompt", data))
}
