pipeline default(harness: Harness) {
  const tmpl = "{{ if llm }}has-context{{ else }}bare-render{{ end }}"
  harness.stdio.println(harness.fs.render_template(tmpl, {}))
  const tmpl2 = "fallback={{ llm.provider }}/{{ llm.capabilities.native_tools }}"
  harness.stdio.println(harness.fs.render_template(tmpl2, {}))
}
