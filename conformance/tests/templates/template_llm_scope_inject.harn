pipeline default(harness: Harness) {
  harness.agent.push_llm_render_context("anthropic", "claude-3-5-sonnet")
  defer {
    harness.agent.pop_llm_render_context()
  }
  const tmpl =
    "provider={{ llm.provider }} family={{ llm.family }} native_tools={{ llm.capabilities.native_tools }}"
  harness.stdio.println(harness.fs.render_template(tmpl, {}))
  const tmpl2 = "{{ if llm.capabilities.native_tools }}native{{ else }}text{{ end }}"
  harness.stdio.println(harness.fs.render_template(tmpl2, {}))
}
