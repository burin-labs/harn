pipeline default() {
  __push_llm_render_context("anthropic", "claude-3-5-sonnet")
  defer {
    __pop_llm_render_context()
  }
  const tmpl =
    "provider={{ llm.provider }} family={{ llm.family }} native_tools={{ llm.capabilities.native_tools }}"
  __io_println(render_string(tmpl, {}))
  const tmpl2 = "{{ if llm.capabilities.native_tools }}native{{ else }}text{{ end }}"
  __io_println(render_string(tmpl2, {}))
}
