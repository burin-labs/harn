pipeline main() {
  let a = transcript
    .inject_reminder(transcript(), {body: "tagged", tags: ["watchlist"], dedupe_key: "a"})
  let b = transcript
    .inject_reminder(a.transcript, {body: "untagged", tags: ["other"], dedupe_key: "b"})
  let cleared = transcript.clear_reminders(b.transcript, {tag: "watchlist"})
  let events = transcript_events_by_kind(cleared.transcript, "system_reminder")
  println(cleared.removed_count)
  println(len(events))
  println(events[0].reminder.body)
  println(events[0].reminder.tags[0])
}
