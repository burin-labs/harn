import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"

pipeline main() {
  clear_reminder_providers()
  register_reminder_provider(
    {
      id: "render_openai",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx -> return {reminder: {body: "openai reminder", role_hint: "user_block"}} },
    },
  )
  let session = agent_session_open("reminder-render-openai")
  agent_session_reset(session)
  agent_session_inject(session, {role: "user", content: "hello"})
  agent_reminder_providers_fire(session, "session_idle", {session: {id: session}}, {})
  llm_mock_clear()
  llm_mock({text: "ok"})
  llm_call(
    "ignored",
    nil,
    {provider: "mock", model: "o3", messages: agent_session_messages(session), session_id: session},
  )
  let call = llm_mock_calls()[0]
  println(call.messages[0].role)
  println(contains(call.messages[0].content, "openai reminder"))
  println(call.messages[1].role)
  println(call.system == nil || !contains(call.system, "openai reminder"))
  clear_reminder_providers()
}
