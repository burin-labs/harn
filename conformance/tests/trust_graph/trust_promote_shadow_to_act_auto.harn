import "std/triggers"

fn gated_handler(event: TriggerEvent) -> dict {
  let context = handler_context()
  let file_path = path_join(".harn", "trust_graph_shadow_" + context?.agent ?? "unknown" + ".txt")
  harness.fs.write_text(file_path, "approved:" + event.kind)
  return {autonomy_tier: context?.autonomy_tier, file_path: file_path}
}

pipeline test(task) {
  let unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.gen_range(100000, 999999))
  let agent_id = "shadow-bot-" + unique
  let file_path = path_join(".harn", "trust_graph_shadow_" + agent_id + ".txt")
  harness.fs.mkdir(".harn")
  let handle: TriggerHandle = trigger_register(
    {
      id: agent_id,
      kind: "issue.opened",
      provider: "github",
      autonomy_tier: "shadow",
      handler: gated_handler,
      when: nil,
      retry: nil,
      match: {events: ["issue.opened"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: "runtime://trust-graph",
      package_name: "conformance",
    },
  )
  let first: DispatchHandle = trigger_fire(
    handle,
    {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-shadow-" + unique}},
  )
  let denied: list<TrustRecord> = trust_query({agent: agent_id, action: "fs.write", outcome: "denied"})
  let file_after_first = harness.fs.exists(file_path)
  let promoted: TrustRecord = trust_record(agent_id, "trust.promote", "tester", "success", "act_auto")
  let promote_records: list<TrustRecord> = trust_query({agent: agent_id, action: "trust.promote"})
  let second: DispatchHandle = trigger_fire(
    handle,
    {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-auto-" + unique}},
  )
  let successes: list<TrustRecord> = trust_query({agent: agent_id, action: "github.issue.opened", outcome: "success", tier: "act_auto"})
  __io_println(first.status == "dispatched" && first.result?.autonomy_tier == "shadow")
  __io_println(!file_after_first)
  __io_println(len(denied) == 1 && denied[0].autonomy_tier == "shadow")
  __io_println(promoted.action == "trust.promote" && promoted.autonomy_tier == "act_auto")
  __io_println(len(promote_records) == 1)
  __io_println(second.status == "dispatched" && second.error == nil)
  __io_println(second.result?.autonomy_tier == "act_auto")
  __io_println(harness.fs.exists(file_path))
  harness.fs.delete(file_path)
  __io_println(len(successes) == 1 && successes[0].autonomy_tier == "act_auto")
}
