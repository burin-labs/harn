import "std/trust"

pipeline test(harness: Harness, task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.range(100000, 999999))
  const actor_id = "trust-namespace-" + unique
  const trace_id = "trace-" + unique
  const entry_id: TrustEntryId = record(
    harness.runtime,
    {
      actor_id: actor_id,
      action: "merge_pr",
      approver: "maintainer-1",
      outcome: "success",
      trace_id: trace_id,
      autonomy_tier_at_time: "act_with_approval",
      evidence_refs: [{kind: "pull_request", uri: "https://example.invalid/pr/927"}],
    },
  )
  const records: list<TrustGraphRecord> = query(
    harness.runtime,
    {actor: actor_id, action: "merge_pr", outcome: "success"},
  )
  const namespaced: list<TrustGraphRecord> = harness.runtime.trust_query_alias(
    {actor_id: actor_id, since: "2000-01-01T00:00:00Z"},
  )
  harness.stdio.println(len(records) == 1)
  harness.stdio.println(records[0]?.actor_id == actor_id)
  harness.stdio.println(records[0]?.autonomy_tier_at_time == "act_with_approval")
  harness.stdio.println(records[0]?.evidence_refs?.[0].uri == "https://example.invalid/pr/927")
  harness.stdio.println(len(namespaced) == 1 && namespaced[0]?.trace_id == trace_id)
  harness.stdio.println(entry_id != "")
  harness.stdio.println(harness.obs.event_log_latest("trust_graph.records") != nil)
}
