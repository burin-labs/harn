import "std/triggers"

pipeline test(harness: Harness, task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.range(100000, 999999))
  const agent_id = "trust-graph-api-" + unique
  const entry_id: TrustEntryId = harness.runtime.trust_graph_record(
    {
      agent: agent_id,
      action: "deploy.prod",
      approver: "reviewer-1",
      outcome: "success",
      trace_id: "trace-" + unique,
      autonomy_tier: "suggest",
      cost_usd: 0.25,
      metadata: {ticket: "INC-1"},
    },
  )
  const score: TrustScore = harness.runtime.trust_graph_query(agent_id, "deploy.prod")
  const policy: CapabilityPolicy = harness.runtime.trust_graph_policy_for(agent_id)
  const report: TrustChainReport = harness.runtime.trust_graph_verify_chain()
  const records: list<TrustRecord> = harness.runtime.trust_query(
    {agent: agent_id, action: "deploy.prod"},
  )
  harness.stdio.println(len(records) == 1)
  harness.stdio.println(entry_id == records[0]?.record_id)
  harness.stdio.println(records[0]?.chain_index > 0 && records[0]?.entry_hash != "")
  harness.stdio.println(records[0]?.previous_hash == nil || records[0]?.previous_hash != "")
  harness.stdio.println(score.total == 1 && score.successes == 1 && score.success_rate == 1.0)
  // A fresh agent resolves to the default `act_auto` (full-autonomy) tier, whose
  // ceiling is the TOP of the side-effect ladder — now `desktop_control` (added
  // above `network`). This is a ceiling/upper-bound, not a grant: a tool is only
  // admitted if it advertises that level AND is present, so a normal agent with
  // no desktop-capable tool is unaffected. If the ladder top changes, update this
  // deliberately — the full-autonomy ceiling must track the ladder top.
  harness.stdio.println(score.policy.side_effect_level == "desktop_control")
  harness.stdio.println(policy.side_effect_level == "desktop_control")
  harness.stdio.println(report.verified && report.root_hash != nil)
}
