import "std/triggers"

fn handle_issue(harness: Harness, event: TriggerEvent) -> dict {
  const context = harness.runtime.handler_context()
  return {
    agent: context?.agent,
    action: context?.action,
    autonomy_tier: context?.autonomy_tier,
    trace_id: context?.trace_id,
    event_kind: event.kind,
  }
}

pipeline test(harness: Harness, task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.range(100000, 999999))
  const agent_id = "github-triage-bot-" + unique
  const handle: TriggerHandle = harness.runtime.trigger_register(
    {
      id: agent_id,
      kind: "issue.opened",
      provider: "webhook",
      autonomy_tier: "act_auto",
      handler: handle_issue,
      when: nil,
      retry: nil,
      match: {events: ["issue.opened"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: "runtime://trust-graph",
      package_name: "conformance",
    },
  )
  const fired: DispatchHandle = harness.runtime.trigger_fire(
    handle,
    {provider: "webhook", kind: "issue.opened", headers: {x_delivery: "evt-" + unique}},
  )
  const records: list<TrustRecord> = harness.runtime.trust_query(
    {agent: agent_id, action: "webhook.issue.opened"},
  )
  harness.stdio.println(fired.status == "dispatched" && fired.error == nil)
  harness.stdio.println(fired.result?.agent == agent_id)
  harness.stdio.println(fired.result?.action == "webhook.issue.opened")
  harness.stdio.println(fired.result?.autonomy_tier == "act_auto")
  harness.stdio.println(len(records) == 1)
  harness.stdio.println(records[0]?.schema == "opentrustgraph/v0.1")
  harness.stdio.println(records[0]?.outcome == "success" && records[0]?.autonomy_tier == "act_auto")
  harness.stdio.println(records[0]?.trace_id == fired.result?.trace_id)
}
