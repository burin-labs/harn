import "std/triggers"

pipeline test(task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const agent_id = "trust-grouped-" + unique
  const handle: TriggerHandle = trigger_register(
    {
      id: agent_id,
      kind: "issue.opened",
      provider: "github",
      autonomy_tier: "act_auto",
      handler: { event ->
        let _ = trust_record(agent_id, "audit.note", nil, "success", "suggest")
        return handler_context()
      },
      when: nil,
      retry: nil,
      match: {events: ["issue.opened"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: "runtime://trust-graph",
      package_name: "conformance",
    },
  )
  const first: DispatchHandle = trigger_fire(
    handle,
    {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-a-" + unique}},
  )
  const second: DispatchHandle = trigger_fire(
    handle,
    {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-b-" + unique}},
  )
  const flat: list<TrustRecord> = trust_query({agent: agent_id, limit: 2})
  const grouped: list<TrustTraceGroup> = trust_query(
    {agent: agent_id, limit: 2, grouped_by_trace: true},
  )
  __io_println(first.status == "dispatched")
  __io_println(second.status == "dispatched")
  __io_println(len(flat) == 2)
  __io_println(flat[0]?.action == "audit.note")
  __io_println(flat[1]?.action == "github.issue.opened")
  __io_println(len(grouped) == 1)
  __io_println(grouped[0]?.trace_id == second.result?.trace_id)
  __io_println(len(grouped[0]?.records) == 2)
  __io_println(grouped[0]?.records?.[0]?.trace_id == grouped[0]?.records?.[1]?.trace_id)
}
