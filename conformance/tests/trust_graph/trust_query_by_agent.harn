import "std/triggers"

pipeline test(task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.gen_range(100000, 999999))
  const agent_a = "trust-alpha-" + unique
  const agent_b = "trust-beta-" + unique
  const first = trust_record(agent_a, "issue.label", "reviewer-1", "success", "suggest")
  const second = trust_record(agent_a, "deploy.prod", nil, "failure", "act_with_approval")
  const third = trust_record(agent_b, "pr.merge", "reviewer-2", "denied", "shadow")
  const alpha_records: list<TrustRecord> = trust_query({agent: agent_a})
  const failures: list<TrustRecord> = trust_query({agent: agent_a, outcome: "failure"})
  const denied: list<TrustRecord> = trust_query({agent: agent_b, outcome: "denied"})
  const suggest_records: list<TrustRecord> = trust_query({agent: agent_a, tier: "suggest"})
  __io_println(first.schema == "opentrustgraph/v0.1")
  __io_println(second.outcome == "failure")
  __io_println(third.autonomy_tier == "shadow")
  __io_println(len(alpha_records) == 2)
  __io_println(len(failures) == 1 && failures[0]?.action == "deploy.prod")
  __io_println(len(denied) == 1 && denied[0]?.agent == agent_b)
  __io_println(len(suggest_records) == 1 && suggest_records[0]?.agent == agent_a)
}
