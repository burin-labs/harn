pipeline main() {
  let topic = "transcript.reminder.lifecycle"
  let cursor = event_log.latest(topic)
  let base = transcript_from_messages(
    [
      {role: "user", content: "one"},
      {role: "assistant", content: "two"},
      {role: "user", content: "three"},
      {role: "assistant", content: "four"},
    ],
  )
  let with_reminder = transcript
    .inject_reminder(
    base,
    {body: "expire now", dedupe_key: "ttl", ttl_turns: 1, preserve_on_compact: true},
  ).transcript
  let compacted = transcript_compact(with_reminder, {strategy: "truncate", keep_last: 1, target_tokens: 1})
  let reminders = transcript_events_by_kind(compacted, "system_reminder")
  let stream = event_log.subscribe({topic: topic, from_cursor: cursor})
  let injected = stream.next().value
  let logged = stream.next().value
  __io_println(len(reminders))
  __io_println(injected.kind)
  __io_println(logged.kind)
  __io_println(logged.payload.reminder_id != "")
  __io_println(logged.payload.reason)
  __io_println(logged.payload.ttl_turns_before)
  __io_println(logged.payload.expired_at_boundary)
}
