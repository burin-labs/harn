import { missing_tool_call_classifier } from "std/llm/missing_tool_call"
import { llm_calls, llm_text, with_llm_script } from "std/testing"

/**
 * The missing-tool-call classifier's `action` label set is a schema enum, so
 * the typed-output checkpoint refuses an out-of-set label instead of mapping
 * it to `ambiguous` after the fact. The refusal fails open to `ambiguous` with
 * `original_action: "error"`, which is distinguishable from a genuine
 * `ambiguous` answer.
 */
pipeline test(harness: Harness) {
  const request = {
    session_id: "missing-tool-call-enum",
    iteration: 1,
    text: "Opaque fixture input.",
    visible_text: nil,
    tools: [{name: "edit", description: "Update an existing file"}],
    tool_names: ["edit"],
  }
  with_llm_script(
    harness.llm,
    [
      llm_text(
        "{\"action\":\"maybe_later\",\"tool_name\":\"\",\"confidence\":0.99,\"evidence\":\"out of set\"}",
      ),
    ],
    { ->
      const classify = missing_tool_call_classifier(harness, {provider: "mock"})
      const result = classify(request)
      const schema = llm_calls(harness.llm)[0].output_format.schema
      harness.stdio.println(json_stringify(schema.properties.action.enum))
      harness.stdio.println(result.classifier_kind)
      harness.stdio.println(result.action)
      harness.stdio.println(result.original_action)
      harness.stdio.println(result.typed_checkpoint.ok)
    },
  )
}
