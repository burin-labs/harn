import { stream_validate_chunk, stream_validate_create, stream_validate_finalize } from "std/json"

pipeline default(task) {
  let validator = stream_validate_create(
    {type: "dict", required: ["name", "age"], properties: {name: {type: "string"}, age: {type: "int"}}},
  )
  let r1 = stream_validate_chunk(validator, "{\"name\":")
  println(r1.verdict)
  let r2 = stream_validate_chunk(validator, "\"Alice\",\"age\":")
  println(r2.verdict)
  let r3 = stream_validate_chunk(validator, "30}")
  println(r3.verdict)
  let r4 = stream_validate_finalize(validator)
  println(r4.verdict)
}
