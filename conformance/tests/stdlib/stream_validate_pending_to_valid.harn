import { stream_validate_chunk, stream_validate_create, stream_validate_finalize } from "std/json"

pipeline default(task) {
  const validator = stream_validate_create(
    {type: "dict", required: ["name", "age"], properties: {name: {type: "string"}, age: {type: "int"}}},
  )
  const r1 = stream_validate_chunk(validator, "{\"name\":")
  __io_println(r1.verdict)
  const r2 = stream_validate_chunk(validator, "\"Alice\",\"age\":")
  __io_println(r2.verdict)
  const r3 = stream_validate_chunk(validator, "30}")
  __io_println(r3.verdict)
  const r4 = stream_validate_finalize(validator)
  __io_println(r4.verdict)
}
