import { render } from "std/disclosure"

pipeline default(harness: Harness) {
  const chain = {sub: "user:kenneth", act: {sub: "agent:merge-captain"}}
  const config = {
    identities: {
      "user:kenneth": {
        name: "Kenneth Sinder",
        email: "kenneth@example.com",
        github: "kennethsinder",
      },
      "agent:merge-captain": {
        name: "Merge Captain",
        email: "merge-captain@bots.example",
        github: "merge-captain-bot",
      },
    },
  }
  const options = {project: false, env: false, config: config}
  const human = render(harness, chain, "github", options)
  harness.stdio.println(human.author_mode)
  harness.stdio.println(human.mode)
  harness.stdio.println(human.required_auth_identity)
  harness.stdio.println(human.commit_auth_identity)
  harness.stdio.println(human.pull_request_auth_identity)
  harness.stdio.println(human.author.subject)
  harness.stdio.println(human.co_author.subject)
  harness.stdio.println(human.commit_author.name)
  harness.stdio.println(human.commit_author.email)
  harness.stdio.println(to_string(human.commit_committer == nil))
  harness.stdio.println(to_string(human.append_git_trailers))
  harness.stdio.println(human.trailers)
  const root = path_join(harness.fs.workspace_temp_dir(), "harn-disclosure-github-mode-" + harness.random.uuid())
  harness.fs.mkdir(root)
  const project_config = "[disclosure.surfaces.github]\n" + "author_mode = \"bot\"\n"
  harness.fs.write_text(path_join(root, "harn.toml"), project_config)
  const bot = render(harness, chain, "github", options + {project: true, project_root: root})
  harness.stdio.println(bot.author_mode)
  harness.stdio.println(bot.mode)
  harness.stdio.println(bot.required_auth_identity)
  harness.stdio.println(bot.commit_auth_identity)
  harness.stdio.println(bot.pull_request_auth_identity)
  harness.stdio.println(bot.author.subject)
  harness.stdio.println(to_string(bot.co_author == nil))
  harness.stdio.println(to_string(bot.commit_author == nil))
  harness.stdio.println(to_string(bot.omit_custom_commit_author))
  harness.stdio.println(to_string(bot.append_git_trailers))
  const invalid = try {
    render(harness, chain, "github", options + {config: {surfaces: {github: {author_mode: "robot"}}}})
  }
  require is_err(invalid), "invalid github author_mode must fail"
  harness.stdio.println(unwrap_err(invalid))
}
