pipeline test(harness: Harness, task) {
  const parts = url_parse("https://user:pass@api.example.com:8080/v1/items?q=hello&page=2#frag")
  harness.stdio.println(parts["scheme"])
  harness.stdio.println(parts["host"])
  harness.stdio.println(parts["port"])
  harness.stdio.println(parts["path"])
  harness.stdio.println(parts["query"])
  harness.stdio.println(parts["fragment"])
  harness.stdio.println(parts["username"])
  const built = url_build({scheme: "https", host: "example.com", path: "/api", query: "x=1&y=2"})
  harness.stdio.println(built)
  const normalized_path = url_build({scheme: "https", host: "example.com", path: "api"})
  harness.stdio.println(normalized_path)
  const userinfo = url_build(
    {scheme: "https", host: "example.com", path: "/", username: "a@b", password: "p:q"},
  )
  harness.stdio.println(userinfo)
  const pairs = query_parse("?key=alpha&key=beta&other=42")
  harness.stdio.println(len(pairs))
  harness.stdio.println(pairs[0]["key"])
  harness.stdio.println(pairs[0]["value"])
  harness.stdio.println(pairs[1]["value"])
  const qs = query_stringify([{key: "name", value: "ali ce"}, {key: "ids", value: "1,2,3"}])
  harness.stdio.println(qs)
}
