pipeline test(harness: Harness, task) {
  // Structural equality vs identity
  const a = [1, 2, 3]
  const b = [1, 2, 3]
  const c = a
  harness.stdio.println(a == b)
  harness.stdio.println(is_same(a, b))
  harness.stdio.println(is_same(a, c))
  harness.stdio.println(is_same(a, a))
  // Primitives: identity == structural equality
  harness.stdio.println(is_same(42, 42))
  harness.stdio.println(is_same("hi", "hi"))
  harness.stdio.println(is_same(nil, nil))
  // addr_of produces stable identity string
  harness.stdio.println(addr_of(42))
  const d = {k: 1}
  harness.stdio.println(is_same(addr_of(d), addr_of(d)))
  // hash_value is stable for equal values
  harness.stdio.println(hash_value(42) == hash_value(42))
  harness.stdio.println(hash_value("foo") == hash_value("foo"))
  harness.stdio.println(hash_value([1, 2, 3]) == hash_value([1, 2, 3]))
  harness.stdio.println(hash_value({a: 1, b: 2}) == hash_value({a: 1, b: 2}))
  harness.stdio.println(hash_value(42) == hash_value("42"))
  // sha variants
  harness.stdio.println(sha256("abc"))
  harness.stdio.println(sha512("abc"))
}
