/**
 * CH-03 (#1874): emits to one tenant scope MUST NOT leak into another
 * tenant's read view. The resolver routes both writes and reads through
 * `tenant:<id>:<name>`, so `channel_events(...)` against a different
 * `tenant_id` reads an entirely different topic.
 */
pipeline default() {
  const _ = emit_channel("pr.merged", {who: "alice"}, {id: "ten-A-1", tenant_id: "tenant-A"})
  const _ = emit_channel("pr.merged", {who: "bob"}, {id: "ten-B-1", tenant_id: "tenant-B"})
  const tenant_a = channel_events("pr.merged", {tenant_id: "tenant-A"})
  const tenant_b = channel_events("pr.merged", {tenant_id: "tenant-B"})
  const tenant_c = channel_events("pr.merged", {tenant_id: "tenant-C"})
  __io_println(len(tenant_a))
  __io_println(tenant_a[0].payload.who)
  __io_println(tenant_a[0].scope)
  __io_println(tenant_a[0].scope_id)
  __io_println(len(tenant_b))
  __io_println(tenant_b[0].payload.who)
  __io_println(tenant_b[0].scope_id)
  // Tenant C never emitted — its view is empty.
  __io_println(len(tenant_c))
}
