import { github_repo, github_slug_from_remote } from "std/connectors/github"

pipeline test(task) {
  assert_eq(
    github_slug_from_remote("git@github.com:octo-org/octo-repo.git"),
    "octo-org/octo-repo",
    "scp-like SSH remotes parse",
  )
  assert_eq(
    github_slug_from_remote("https://github.com/octo-org/octo-repo.git"),
    "octo-org/octo-repo",
    "HTTPS remotes parse",
  )
  assert_eq(
    github_slug_from_remote("ssh://git@github.com/octo-org/octo-repo.git"),
    "octo-org/octo-repo",
    "ssh:// remotes parse",
  )
  assert_eq(
    github_slug_from_remote("ssh://git@github.com:22/octo-org/octo-repo.git"),
    "octo-org/octo-repo",
    "ssh:// remotes with ports parse",
  )
  assert_eq(
    github_slug_from_remote("https://example.com/octo-org/octo-repo.git"),
    nil,
    "non-GitHub remotes do not parse",
  )
  let repo = github_repo("git@github.com:octo-org/octo-repo.git")
  assert_eq(repo.owner, "octo-org", "repo owner")
  assert_eq(repo.name, "octo-repo", "repo name")
  assert_eq(repo.full_name, "octo-org/octo-repo", "repo full name")
  log("github stdlib ok")
}
