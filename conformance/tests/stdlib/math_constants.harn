pipeline default(harness: Harness, task: unknown) {
  // pi and e are now values, not functions
  harness.stdio.println(pi > 3.14)
  harness.stdio.println(pi < 3.15)
  harness.stdio.println(e > 2.71)
  harness.stdio.println(e < 2.72)
  // Use in expressions
  const area = pi * pow(5, 2)
  harness.stdio.println(area > 78)
  harness.stdio.println(area < 79)
}
