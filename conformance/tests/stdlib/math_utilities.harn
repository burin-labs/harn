/** Test sign, is_nan, is_infinite, atan2 */
pipeline default(task) {
  // sign
  __io_println(sign(42))
  __io_println(sign(-7))
  __io_println(sign(0))
  __io_println(sign(3.14))
  __io_println(sign(-0.5))
  __io_println(sign(0.0))
  // is_nan: sqrt(-1) produces NaN
  __io_println(is_nan(1.0))
  __io_println(is_nan(sqrt(-1.0)))
  // is_infinite on normal values
  __io_println(is_infinite(1.0))
  __io_println(is_infinite(0.0))
  // atan2
  let result = atan2(1.0, 1.0)
  // atan2(1,1) = pi/4 ~ 0.785
  __io_println(result > 0.78)
  __io_println(result < 0.79)
}
