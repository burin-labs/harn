/** Test sign, is_nan, is_infinite, atan2 */
pipeline default(harness: Harness, task: unknown) {
  // sign
  harness.stdio.println(sign(42))
  harness.stdio.println(sign(-7))
  harness.stdio.println(sign(0))
  harness.stdio.println(sign(3.14))
  harness.stdio.println(sign(-0.5))
  harness.stdio.println(sign(0.0))
  // is_nan: sqrt(-1) produces NaN
  harness.stdio.println(is_nan(1.0))
  harness.stdio.println(is_nan(sqrt(-1.0)))
  // is_infinite on normal values
  harness.stdio.println(is_infinite(1.0))
  harness.stdio.println(is_infinite(0.0))
  // atan2
  const result = atan2(1.0, 1.0)
  // atan2(1,1) = pi/4 ~ 0.785
  harness.stdio.println(result > 0.78)
  harness.stdio.println(result < 0.79)
}
