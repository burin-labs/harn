/**
 * run_command (std/command → hostlib run_command builtin) honors host mocks.
 *
 * The hostlib run_command builtin consults host mocks before spawning: a
 * `("process", "run_command")` mock matches directly, and a legacy
 * `("process", "exec")` mock matches as a fallback — so suites that mock the
 * process.exec host-call seam transparently cover commands routed through
 * hostlib run_command without being rewritten.
 */
import { command_run } from "std/command"
import { clear_host_mocks, mock_host_result } from "std/testing"

pipeline default() {
  // Direct run_command mock.
  clear_host_mocks()
  let _direct = mock_host_result(
    "process",
    "run_command",
    {stdout: "MOCKED-RUN-COMMAND\n", stderr: "", exit_code: 0},
    nil,
  )
  let direct = command_run({mode: "shell", command: "echo would-print-if-not-mocked"})
  require trim(direct.stdout) == "MOCKED-RUN-COMMAND", "command_run should return the run_command host mock, not spawn"
  // Legacy process.exec mock covers run_command as a fallback.
  clear_host_mocks()
  let _fallback = mock_host_result(
    "process",
    "exec",
    {stdout: "MOCKED-VIA-PROCESS-EXEC\n", stderr: "", exit_code: 0},
    nil,
  )
  let fallback = command_run({mode: "shell", command: "echo would-print-if-not-mocked"})
  require trim(fallback.stdout) == "MOCKED-VIA-PROCESS-EXEC", "command_run should fall back to the legacy process.exec host mock"
  clear_host_mocks()
  __io_println("ok")
}
