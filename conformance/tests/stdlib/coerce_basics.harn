// Verifies std/coerce defensive coercion helpers handle the LLM/JSON shapes
// harnesses repeatedly hand-roll: lossy stringification, list normalization,
// int/float/bool fallbacks, nested case-insensitive lookup, and "first
// non-nil / first present" reductions.
import {
  dict_path_ci,
  first_non_nil,
  first_present,
  to_bool_or,
  to_float_or,
  to_int_or,
  to_string_list,
  to_string_lossy,
} from "std/coerce"

pipeline default(harness: Harness) {
  harness.stdio.println(to_string_lossy(nil))
  harness.stdio.println(to_string_lossy("hi"))
  harness.stdio.println(to_string_lossy(["a", "b", "c"]))
  harness.stdio.println(to_string_lossy({k: 1}))
  harness.stdio.println(to_string_list(nil))
  harness.stdio.println(to_string_list(""))
  harness.stdio.println(to_string_list("solo"))
  harness.stdio.println(to_string_list([1, "two", 3.0]))
  harness.stdio.println(to_int_or("42", -1))
  harness.stdio.println(to_int_or("not-a-number", -1))
  harness.stdio.println(to_float_or("1.5", -1.0))
  harness.stdio.println(to_float_or(nil, -1.0))
  harness.stdio.println(to_bool_or("YES", false))
  harness.stdio.println(to_bool_or("0", true))
  harness.stdio.println(to_bool_or("", true))
  harness.stdio.println(to_bool_or(0, true))
  harness.stdio.println(to_bool_or([1], false))
  const nested = {Outer: {INNER: {Final: "ok"}}}
  harness.stdio.println(dict_path_ci(nested, ["outer", "inner", "final"]))
  harness.stdio.println(dict_path_ci(nested, ["outer", "missing"]) == nil)
  harness.stdio.println(first_non_nil([nil, nil, "first", "second"]))
  harness.stdio.println(first_non_nil([], "fallback"))
  harness.stdio.println(first_present([nil, "", [], "real"]))
  harness.stdio.println(first_present([nil, "", []], "fallback"))
}
