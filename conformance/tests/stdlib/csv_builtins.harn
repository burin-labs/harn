import { assert_error_contains } from "std/testing"

pipeline test(harness: Harness, task: unknown) {
  const text = "name,age\nalice,30\nbob,25\n"
  // No headers: list of lists
  const rows = csv_parse(text)
  harness.stdio.log(len(rows))
  harness.stdio.log(rows[0])
  harness.stdio.log(rows[1][1])
  // With headers: list of dicts
  const header_rows = csv_parse(text, {headers: true})
  harness.stdio.log(len(header_rows))
  harness.stdio.log(header_rows[0]["name"])
  harness.stdio.log(header_rows[1]["age"])
  // round-trip dict rows back to csv
  const out = csv_stringify(header_rows, {headers: true})
  harness.stdio.log(out)
  // round-trip list rows
  const listy = csv_stringify([["a", "b"], ["c", "d"]])
  harness.stdio.log(listy)
  // ragged rows from csv_parse round-trip, and nil cells are empty
  assert_eq(csv_stringify(csv_parse("a,b\nc\n")), "a,b\nc\n")
  assert_eq(csv_stringify([["a", nil]]), "a,\n")
  assert_error_contains({ -> csv_parse("a||b\n", {delimiter: "||"}) }, "exactly one ASCII")
  assert_error_contains({ -> csv_stringify([["a", "b"]], {delimiter: "é"}) }, "exactly one ASCII")
}
