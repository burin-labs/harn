/**
 * Verifies that `mock_time` unifies all stdlib timing primitives:
 *   - `sleep(...)` advances the mock instead of suspending the runtime
 *   - `harness.clock.sleep_ms(...)` advances the mock
 *   - `harness.clock.now_ms()` / `monotonic_ms()` / `timestamp()` / `elapsed()` all
 *     read from the same mocked source of truth
 *   - `harness.runtime.yield_now()` is a no-op for time but lets sibling tasks poll
 *
 * Before unification, `sleep` always called `tokio::time::sleep` while
 * only `sleep_ms` honored the mock — leaving conformance fixtures with
 * two different timing models depending on which builtin they used.
 */
pipeline test(harness: Harness, task) {
  mock_time(1700000000000)
  const start_wall = harness.clock.now_ms()
  const start_mono = harness.clock.monotonic_ms()
  const start_ts = harness.clock.timestamp()
  const start_elapsed = harness.clock.elapsed()
  // sleep with an integer (ms) argument advances the mock.
  harness.clock.sleep_ms(50)
  // sleep with a duration literal also advances the mock.
  harness.clock.sleep_ms(125ms)
  // yield_now does not advance time but is async.
  harness.runtime.yield_now()
  const end_wall = harness.clock.now_ms()
  const end_mono = harness.clock.monotonic_ms()
  const end_ts = harness.clock.timestamp()
  const end_elapsed = harness.clock.elapsed()
  harness.stdio.println(end_wall - start_wall)
  harness.stdio.println(end_mono - start_mono)
  // timestamp() returns float seconds; assert it advanced by the same
  // 175 ms (within fp rounding) rather than logging a flaky derived ms.
  const ts_delta_ms = end_ts * 1000.0 - start_ts * 1000.0
  harness.stdio.println(ts_delta_ms > 174.0 && ts_delta_ms < 176.0)
  harness.stdio.println(end_elapsed - start_elapsed)
  unmock_time()
}
