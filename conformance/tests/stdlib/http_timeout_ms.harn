pipeline test(harness: Harness, task) {
  try {
    const _r = harness.net.get("http://127.0.0.1:1", {timeout_ms: 100})
    harness.stdio.println("unexpected_timeout_ms_success")
  } catch (e) {
    harness.stdio.println("caught_timeout_ms")
  }
  try {
    const _r = harness.net.get("http://127.0.0.1:1", {timeout: 100})
    harness.stdio.println("unexpected_timeout_alias_success")
  } catch (e2) {
    harness.stdio.println("caught_timeout_alias")
  }
}
