import "std/memory"

pipeline default(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "harn-memory-vector-" + harness.random.uuid())
  host_mock_clear()
  // Fixed-vector mock so any text → same embedding. Cosine similarity is
  // then 1.0 across all records and order falls through to the
  // newest-first tiebreak, which is enough to verify the wire-up.
  host_mock("memory", "embed", {result: {vector: [0.5, 0.5, 0.5], dim: 3, model: "test"}})
  const opened = memory_open(
    harness.memory, "agent/vector",
    {backend: "vector", embed_dim: 3, embed_model_hint: "test", root: root},
  )
  harness.stdio.println(opened._type)
  harness.stdio.println(opened.backend)
  harness.stdio.println(opened.embed_dim)
  harness.stdio.println(opened.embed_model_hint)
  memory_store(
    harness.memory, "agent/vector",
    "alice",
    "Alice prefers Rust examples",
    ["profile"],
    {root: root, now: "2026-05-15T00:00:00Z"},
  )
  memory_store(
    harness.memory, "agent/vector",
    "bob",
    "Bob prefers TypeScript",
    ["profile"],
    {root: root, now: "2026-05-15T00:00:01Z"},
  )
  const recalled = memory_recall(harness.memory, "agent/vector", "preferences", 5, {root: root})
  harness.stdio.println(len(recalled))
  harness.stdio.println(recalled[0]._type)
  harness.stdio.println(recalled[0].score >= 0.999)
  harness.stdio.println(recalled[1].score >= 0.999)
  // Newer record wins on tie.
  harness.stdio.println(recalled[0].key)
  // Explicit lexical override should ignore embeddings entirely.
  const lexical = memory_recall(harness.memory, "agent/vector", "rust profile", 5, {root: root, mode: "lexical"})
  harness.stdio.println(lexical[0].key)
  // The embedding cache should now contain both stored records plus the
  // last query. Verify entries exist for the configured model.
  const cache_entries = harness.fs.list_dir(path_join(root, "agent", "vector", "vectors", "test"))
  harness.stdio.println(len(cache_entries) >= 3)
  harness.fs.delete(root)
}
