import {
  assert_error_contains,
  assert_no_throw,
  assert_throws,
  llm_call_count,
  llm_done,
  llm_error,
  llm_text,
  llm_tool_call,
  llm_tool_calls,
  with_capability_fixtures,
  with_fs,
  with_llm_script,
  with_scenario,
  with_temp_dir,
} from "std/testing"

pipeline test_testing_toolkit(harness: Harness, task: unknown) {
  // Optional fixture controls are genuinely optional record fields, not
  // required fields whose values happen to admit nil.
  const fixture_result = with_capability_fixtures(
    harness.testing,
    [{capability: "runtime", method: "pipeline_input", result: {fixture: "minimal"}}],
    { ->
      const first = harness.runtime.pipeline_input()
      const second = harness.runtime.pipeline_input()
      const calls = harness.testing.calls()
      assert_eq(len(calls), 2)
      assert_eq(calls[0].method, "pipeline_input")
      assert_eq(calls[0].args, [])
      // Legacy host-mock readers see mechanically projected aliases while
      // migrations move to the canonical method/args fields.
      assert_eq(calls[0].operation, calls[0].method)
      assert_eq(calls[0].params, nil)
      assert_eq(first, second)
      first
    },
  )
  assert_eq(fixture_result.fixture, "minimal")
  const scripted_results = with_capability_fixtures(
    harness.testing,
    [
      {capability: "runtime", method: "pipeline_input", result: {step: 1}},
      {capability: "runtime", method: "pipeline_input", result: {step: 2}},
    ],
    { -> [harness.runtime.pipeline_input(), harness.runtime.pipeline_input()] },
  )
  assert_eq(scripted_results, [{step: 1}, {step: 2}])
  with_capability_fixtures(
    harness.testing,
    [{capability: "runtime", method: "pipeline_input", result: {once: true}, repeat: false}],
    { ->
      assert_eq(harness.runtime.pipeline_input(), {once: true})
      assert_throws(
        { -> harness.runtime.pipeline_input() },
        "repeat: false must override the reusable singleton default",
      )
    },
  )
  with_capability_fixtures(
    harness.testing,
    [{capability: "net", method: "get", result: {status: 200}}],
    { ->
      assert_eq(harness.net.get("https://example.invalid"), {status: 200})
      assert_throws(
        { -> harness.net.get("https://example.invalid") },
        "volatile reads must remain one-shot unless repeat is explicit",
      )
    },
  )
  // === LLM turn builders produce the shapes `llm_mock` accepts ===
  assert_eq(llm_text("hi"), {text: "hi"})
  assert_eq(llm_done(), {text: "##DONE##"})
  assert_eq(llm_done("<<END>>"), {text: "<<END>>"})
  assert_eq(llm_error("boom"), {error: {category: "generic", message: "boom"}})
  const scripted_error = try {
    with_llm_script(
      harness.llm,
      [llm_error("boom")],
      { _ -> harness.llm.call("fail", nil, {provider: "mock", model: "mock"}) },
    )
  }
  assert(is_err(scripted_error), "llm_error must fail the call, not fixture installation")
  assert(contains(to_string(unwrap_err(scripted_error)), "boom"), "the safe message must survive")
  // Single tool call: id defaults to the tool name.
  assert_eq(
    llm_tool_call("write_note", {path: "n.txt"}),
    {tool_calls: [{id: "write_note", name: "write_note", arguments: {path: "n.txt"}}]},
  )
  // Explicit id is honored; missing args default to {}.
  assert_eq(
    llm_tool_call("read", nil, "c1"),
    {tool_calls: [{id: "c1", name: "read", arguments: {}}]},
  )
  // Parallel tool calls auto-index ids when absent and honor explicit ones.
  const multi = llm_tool_calls([{name: "a", args: {x: 1}}, {name: "b", id: "bb"}])
  assert_eq(len(multi.tool_calls), 2)
  assert_eq(multi.tool_calls[0], {id: "a_0", name: "a", arguments: {x: 1}})
  assert_eq(multi.tool_calls[1], {id: "bb", name: "b", arguments: {}})
  // === with_llm_script drives a scoped, ordered mock script ===
  harness.llm.mock_clear()
  const scripted = with_llm_script(
    harness.llm,
    [llm_text("scoped")],
    fn() {
      const r = harness.llm.call("ask", nil, {provider: "mock"})
      return {text: r.text, count: llm_call_count(harness.llm)}
    },
  )
  assert_eq(scripted.text, "scoped")
  assert_eq(scripted.count, 1)
  // Scope restored after the body.
  assert_eq(llm_call_count(harness.llm), 0)
  // === assert_throws returns the thrown error ===
  const err = assert_throws(
    { ->
      throw "kaboom"
    },
  )
  assert_eq(err, "kaboom")
  // assert_throws itself fails when the body does NOT throw.
  const no_throw_caught = try {
    assert_throws({ -> 42 })
    "unreachable"
  } catch (e) {
    e
  }
  assert(contains(no_throw_caught, "expected the body to throw"))
  // === assert_error_contains matches a substring of the rendered error ===
  const matched = assert_error_contains(
    { ->
      throw "url is required"
    },
    "url is required",
  )
  assert_eq(matched, "url is required")
  // Mismatched substring fails.
  const mismatch_caught = try {
    assert_error_contains(
      { ->
        throw "other"
      },
      "url is required",
    )
    "unreachable"
  } catch (e) {
    e
  }
  assert(contains(mismatch_caught, "expected thrown error to contain"))
  // === assert_no_throw returns the body's value, fails on throw ===
  assert_eq(assert_no_throw({ -> 7 }), 7)
  const unexpected_throw = try {
    assert_no_throw(
      { ->
        throw "surprise"
      },
    )
    "unreachable"
  } catch (e) {
    e
  }
  assert(contains(unexpected_throw, "expected the body not to throw"))
  // NB: closures capture outer vars by value, so these blocks return the
  // temp dir from the body and assert on the returned value rather than a
  // captured variable.
  // === with_temp_dir: workspace exists in body, removed after ===
  const temp_result = with_temp_dir(
    harness.fs,
    { dir ->
      assert(harness.fs.exists(dir))
      harness.fs.write_text(dir + "/x.txt", "1")
      assert_eq(harness.fs.read_text(dir + "/x.txt"), "1")
      {dir: dir, result: "done"}
    },
  )
  assert_eq(temp_result.result, "done")
  // The directory is gone once the scope exits.
  assert_eq(harness.fs.exists(temp_result.dir), false)
  // === with_fs: seeds files (incl. nested + JSON), reads back, cleans up ===
  const fs_result = with_fs(
    harness.fs,
    {"in.txt": "hello", "nested/deep/cfg.json": {a: 1}},
    { dir ->
      assert_eq(harness.fs.read_text(dir + "/in.txt"), "hello")
      assert_eq(harness.fs.read_text(dir + "/nested/deep/cfg.json"), json_stringify({a: 1}))
      dir
    },
  )
  assert_eq(harness.fs.exists(fs_result), false)
  // === with_temp_dir cleans up even when the body throws ===
  // Throw the dir itself so we can assert it was removed after the throw.
  const leaked_dir = try {
    with_temp_dir(
      harness.fs,
      { dir ->
        throw dir
      },
    )
    "unreachable"
  } catch (e) {
    e
  }
  assert(contains(leaked_dir, "harn-test-"))
  assert_eq(harness.fs.exists(leaked_dir), false)
  // === with_scenario: fs + scripted llm in one declarative block ===
  harness.llm.mock_clear()
  const scenario_out = with_scenario(
    harness,
    {llm: [llm_text("answer")], fs: {"seed.txt": "ok"}},
    { s ->
      let seed = harness.fs.read_text(s.dir + "/seed.txt")
      let reply = harness.llm.call("go", nil, {provider: "mock"})
      {dir: s.dir, seed: seed, reply: reply.text}
    },
  )
  assert_eq(scenario_out.seed, "ok")
  assert_eq(scenario_out.reply, "answer")
  assert_eq(harness.fs.exists(scenario_out.dir), false)
  assert_eq(llm_call_count(harness.llm), 0)
  // with_scenario without fs/temp_dir passes a nil dir but still mocks.
  harness.llm.mock_clear()
  const no_fs = with_scenario(
    harness,
    {llm: [llm_text("plain")]},
    { s ->
      let reply = harness.llm.call("x", nil, {provider: "mock"})
      {dir: s.dir, reply: reply.text}
    },
  )
  assert_eq(no_fs.dir, nil)
  assert_eq(no_fs.reply, "plain")
  harness.stdio.println("ok")
}
