// `safe_structured_call` owns its judge-friendly defaults. A default is not
// caller intent, so it must stay absent when the resolved route declares that
// the option cannot be sent. Explicit caller options remain subject to Harn's
// normal capability-admission error.
import { safe_structured_call } from "std/llm/safe"

pipeline test(harness: Harness, task: unknown) {
  const schema = {
    type: "object",
    additionalProperties: false,
    required: ["verdict"],
    properties: {verdict: {type: "string"}},
  }
  const envelope = safe_structured_call(
    harness.llm,
    "Grade this output.",
    schema,
    {
      provider: "openai",
      model: "gpt-5.6-luna",
      max_tokens: 512,
      schema_retries: 0,
      repair: {enabled: true},
    },
  )
  harness.stdio.println(envelope.ok)
  harness.stdio.println(envelope.status)
  harness.stdio.println(envelope.value.verdict)
  const calls = harness.llm.mock_calls()
  harness.stdio.println("repair_attempted=" + to_string(envelope.repaired))
  harness.stdio.println("call_count=" + to_string(len(calls)))
  harness.stdio.println("main_temperature_omitted=" + to_string(calls[0].temperature == nil))
  harness.stdio.println("repair_temperature_omitted=" + to_string(calls[1].temperature == nil))
}
