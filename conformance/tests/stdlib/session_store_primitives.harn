import "std/session-store"

/**
 * Exercises the std/session-store substrate: append (hash chain), mutation
 * projection (upsert/delete), value projection, and chain verification. All
 * fields printed are deterministic (record_hash covers only
 * {session_id, event_id, payload, prev_hash}; ts is pinned via options.now).
 */
pipeline default() {
  let root = path_join(".harn", "tmp", "harn-session-store-" + uuid())
  let sid = "burin.agent_context.memories.project"
  let opts = {root: root, now: "2026-04-29T00:00:00Z", kind_type: "AgentMemory"}
  let first = session_store_append(sid, {operation: "upsert", record: {id: "m1", title: "one"}}, opts)
  let second = session_store_append(sid, {operation: "upsert", record: {id: "m2", title: "two"}}, opts)
  session_store_append(sid, {operation: "upsert", record: {id: "m1", title: "one-v2"}}, opts)
  session_store_append(sid, {operation: "delete", id: "m2"}, opts)
  // Hash chain: 1-based event_id, genesis prev_hash is nil, then links.
  __io_println(first.event_id)
  __io_println(first.prev_hash == nil)
  __io_println(second.prev_hash == first.record_hash)
  __io_println(starts_with(first.record_hash, "sha256:"))
  __io_println(first.kind.type)
  // Projection: m1 updated to v2, m2 deleted → only m1 survives.
  let records = session_store_project(sid, {root: root})
  __io_println(len(records))
  __io_println(records[0].id)
  __io_println(records[0].title)
  // Verification of the on-disk chain.
  let report = session_store_verify(sid, {root: root})
  __io_println(report.ok)
  __io_println(report.count)
  // Value stream projection (replace / clear fold).
  let vsid = "example.value.stream"
  session_store_append(
    vsid,
    {operation: "replace", value: "hello"},
    {root: root, now: "2026-04-29T00:00:00Z"},
  )
  __io_println(session_store_project_value(vsid, "fallback", {root: root}))
  __io_println(
    ends_with(session_store_path(sid, {root: root}), "/.harn/session-store/" + sid + ".jsonl"),
  )
  harness.fs.delete(root)
}
