import { stream_validator } from "std/json"

pipeline default(harness: Harness, task) {
  const validator = stream_validator(
    {
      type: "dict",
      required: ["name", "age"],
      properties: {name: {type: "string"}, age: {type: "int"}},
    },
  )
  const status = validator.feed("{\"name\":\"Ada\",\"age\":\"")
  harness.stdio.println(status.variant)
  harness.stdio.println(status.fields[0].path)
  harness.stdio.println(contains(status.fields[0].reason, "expected type 'int'"))
  harness.stdio.println(validator.value() == nil)
  harness.stdio.println(validator.feed("42}").variant)
}
