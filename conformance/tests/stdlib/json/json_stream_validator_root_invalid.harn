import { stream_validator } from "std/json"

pipeline default(harness: Harness, task: unknown) {
  const validator = stream_validator(harness.runtime, {type: "list", items: {type: "int"}})
  const status = validator.feed("{")
  harness.stdio.println(status.variant)
  harness.stdio.println(status.fields[0].path)
  harness.stdio.println(contains(status.fields[0].reason, "expected type 'list'"))
  harness.stdio.println(validator.value() == nil)
}
