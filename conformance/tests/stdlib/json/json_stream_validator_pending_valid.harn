import { stream_validator } from "std/json"

pipeline default(task) {
  const validator = stream_validator(
    {
      type: "dict",
      required: ["name", "age"],
      properties: {name: {type: "string"}, age: {type: "int"}},
    },
  )
  __io_println(validator.feed("{\"name\"").variant)
  __io_println(validator.value() == nil)
  __io_println(validator.feed(":\"Ada\",\"age\":").variant)
  __io_println(validator.feed("42}").variant)
  __io_println(validator.value().name)
  __io_println(validator.value().age)
}
