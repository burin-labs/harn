import { stream_validator } from "std/json"

pipeline default(harness: Harness, task: unknown) {
  const validator = stream_validator(
    harness.runtime,
    {type: "dict", required: ["ok"], properties: {ok: {type: "bool"}}},
  )
  harness.stdio.println(validator.feed(bytes_from_string("{\"ok\":true}")).variant)
  harness.stdio.println(validator.value().ok)
}
