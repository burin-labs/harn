import { stream_validator } from "std/json"

pipeline default(harness: Harness, task) {
  const validator = stream_validator(harness.runtime, {type: "list", items: {type: "int"}})
  harness.stdio.println(validator.feed("[1,").variant)
  harness.stdio.println(validator.feed("2,3]").variant)
  harness.stdio.println(validator.value()[2])
}
