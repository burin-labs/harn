import { coord_post, coord_subscribe } from "std/coordination"

pipeline default(harness: Harness) {
  const stream = coord_subscribe(harness.channels, "task", "handoff", {task_id: "task-1", session_id: "sess-1"})
  const receipt = coord_post(
    harness.channels, "task",
    "handoff",
    {kind: "decision", subject: "proceed", body: "Proceed with non-overlapping work."},
    {id: "coord-task-1", task_id: "task-1", session_id: "sess-1"},
  )
  const entry = stream.next().value
  harness.stdio.println(receipt.scope)
  harness.stdio.println(receipt.scope_id)
  harness.stdio.println(receipt.channel.name_resolved)
  harness.stdio.println(entry.kind)
  harness.stdio.println(entry.payload.schema)
  harness.stdio.println(entry.payload.kind)
  harness.stdio.println(entry.payload.subject)
}
