// Verifies std/settled aggregation helpers correctly partition, count,
// and tally a list of Result values produced by `parallel settle` (or
// any other code path that emits Ok/Err).
import {
  count_errs,
  count_oks,
  enumerate_settled,
  errs,
  map_settled,
  oks,
  partition,
  summary,
  tally_by,
} from "std/settled"

pipeline default() {
  const results = [Ok({status: "pass"}), Err("bad-input"), Ok({status: "fail"}), Err("timeout"), Ok({status: "pass"})]
  const parts = partition(results)
  __io_println(parts.ok_count)
  __io_println(parts.err_count)
  __io_println(len(parts.oks))
  __io_println(len(parts.errs))
  __io_println(len(oks(results)))
  __io_println(len(errs(results)))
  __io_println(count_oks(results))
  __io_println(count_errs(results))
  const summarized = summary(results)
  __io_println(summarized.total)
  __io_println(summarized.any_failed)
  __io_println(summarized.all_ok)
  const mapped = map_settled(
    results,
    fn(value, idx) { return "ok#" + to_string(idx) + ":" + value.status },
    fn(error, idx) { return "err#" + to_string(idx) + ":" + to_string(error) },
  )
  for row in mapped {
    __io_println(row)
  }
  const by_status = tally_by(
    results,
    fn(payload, was_ok) {
      if was_ok {
        return payload.status
      }
      return "error"
    },
  )
  __io_println(by_status?.pass)
  __io_println(by_status?.fail)
  __io_println(by_status?.error)
  const rows = enumerate_settled(results)
  __io_println(rows[0].ok)
  __io_println(rows[1].ok)
  __io_println(rows[1].error)
}
