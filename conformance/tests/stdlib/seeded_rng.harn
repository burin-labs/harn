pipeline test(harness: Harness, task) {
  const rng_a = harness.random.seed(42)
  const rng_b = harness.random.seed(42)
  assert_eq(harness.random.f64(rng_a), harness.random.f64(rng_b))
  assert_eq(harness.random.range(rng_a, 10, 99), harness.random.range(rng_b, 10, 99))
  assert_eq(
    harness.random.choice(rng_a, ["alpha", "beta", "gamma"]),
    harness.random.choice(rng_b, ["alpha", "beta", "gamma"]),
  )
  assert_eq(harness.random.shuffle(rng_a, [1, 2, 3, 4, 5]), harness.random.shuffle(rng_b, [1, 2, 3, 4, 5]))
  assert_eq(harness.random.choice(["only"]), "only")
  harness.stdio.log("seeded rng ok")
}
