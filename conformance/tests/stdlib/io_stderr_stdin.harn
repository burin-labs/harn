/** Verifies eprint/eprintln/read_stdin/read_line and the stdin/tty mocks. */
fn legacy_line() {
  const line = __io_read_line({})
  if line.ok {
    return line.value
  }
  return nil
}

pipeline test(harness: Harness, task) {
  // mock stdin with three lines and read them back individually
  mock_stdin("alpha\nbeta\ngamma\n")
  harness.stdio.println(legacy_line())
  harness.stdio.println(legacy_line())
  harness.stdio.println(legacy_line())
  // queue is now drained — next read_line returns nil
  harness.stdio.println(legacy_line())
  unmock_stdin()
  // bulk read
  mock_stdin("hello\nworld\n")
  harness.stdio.println(read_stdin())
  // after bulk read, the stream is consumed
  harness.stdio.println(legacy_line())
  unmock_stdin()
  // capture stderr produced by eprint / eprintln
  capture_stderr_start()
  harness.stdio.eprint("warn: ")
  harness.stdio.eprintln("disk full")
  harness.stdio.eprintln("retry in 5s")
  const captured = capture_stderr_take()
  harness.stdio.println(captured)
  // tty mocks are honored by is_*_tty
  mock_tty("stdin", true)
  mock_tty("stdout", false)
  harness.stdio.println(is_stdin_tty())
  harness.stdio.println(is_stdout_tty())
  unmock_tty()
}
