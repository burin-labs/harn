/** Verifies eprint/eprintln/read_stdin/read_line and the stdin/tty mocks. */
fn legacy_line(stdio: HarnessStdio) {
  const line = stdio.read_line({})
  if line.ok {
    return line.value
  }
  return nil
}

pipeline test(harness: Harness, task: unknown) {
  // mock stdin with three lines and read them back individually
  harness.testing.stdin_set("alpha\nbeta\ngamma\n")
  harness.stdio.println(legacy_line(harness.stdio))
  harness.stdio.println(legacy_line(harness.stdio))
  harness.stdio.println(legacy_line(harness.stdio))
  // queue is now drained — next read_line returns nil
  harness.stdio.println(legacy_line(harness.stdio))
  harness.testing.stdin_reset()
  // bulk read
  harness.testing.stdin_set("hello\nworld\n")
  harness.stdio.println(harness.stdio.read_stdin())
  // after bulk read, the stream is consumed
  harness.stdio.println(legacy_line(harness.stdio))
  harness.testing.stdin_reset()
  // capture stderr produced by eprint / eprintln
  harness.testing.capture_stderr_start()
  harness.stdio.eprint("warn: ")
  harness.stdio.eprintln("disk full")
  harness.stdio.eprintln("retry in 5s")
  const captured = harness.testing.capture_stderr_take()
  harness.stdio.log(captured)
  // tty mocks are honored by is_*_tty
  harness.testing.tty_set("stdin", true)
  harness.testing.tty_set("stdout", false)
  harness.stdio.println(harness.stdio.is_stdin_tty())
  harness.stdio.println(harness.stdio.is_stdout_tty())
  harness.testing.tty_reset()
}
