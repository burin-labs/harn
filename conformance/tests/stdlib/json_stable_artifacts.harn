import { write_json } from "std/fs"

pipeline default(harness: Harness) {
  const value = {z: 1, a: {d: 4, b: 2}, items: [{y: 2, x: 1}]}
  harness.stdio.println(json_stringify(value))
  const parsed = json_parse("{\"z\":1,\"a\":2,\"nested\":{\"y\":2,\"x\":1}}")
  harness.stdio.println(json_stringify(parsed))
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-json-stability-" + harness.random.uuid_v7(),
  )
  const compact_path = path_join(root, "compact.json")
  write_json(harness.fs, compact_path, {b: 2, a: 1}, {pretty: false})
  harness.stdio.println(json_stringify(harness.fs.read_text(compact_path)))
  const pretty_path = path_join(root, "pretty.json")
  write_json(harness.fs, pretty_path, {b: 2, a: 1}, {pretty: true})
  harness.stdio.println(json_stringify(harness.fs.read_text(pretty_path)))
  harness.fs.delete(root)
}
