import "std/agents"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const normalized = action_graph(
    {
      task: "Fix parser diagnostics",
      summary: "Inspect first, then patch, then verify.",
      steps: [
        {
          id: "inspect",
          kind: "research",
          title: "Inspect parser and tests",
          tools: ["read", "search"],
        },
        {id: "patch", title: "Patch parser error text", tools: ["edit"]},
        {id: "docs", title: "Update release notes", tools: ["edit"]},
        {id: "qa", kind: "verify", title: "Run verification", dependsOn: ["patch"], tools: ["run"]},
      ],
    },
  )
  harness.stdio.println(normalized?._type == "action_graph")
  harness.stdio.println(len(normalized.actions) == 4)
  harness.stdio.println(normalized.actions[1].phase == "execute")
  harness.stdio.println(normalized.actions[1].depends_on[0] == "action-1")
  harness.stdio.println(normalized.actions[3].depends_on[0] == "action-2")
  const batches = action_graph_batches(normalized)
  harness.stdio.println(len(batches) == 3)
  harness.stdio.println(batches[1].count == 2)
  harness.stdio.println(batches[1].tool_class == "write")
  const rendered = action_graph_render(normalized)
  harness.stdio.println(contains(rendered, "## RESEARCH"))
  harness.stdio.println(contains(rendered, "depends on: action-1"))
  const execution_plan = action_graph(
    {
      task: "Fix parser diagnostics",
      steps: [
        {
          id: "inspect",
          kind: "research",
          title: "Inspect parser and tests",
          tools: ["read", "search"],
        },
        {id: "patch", title: "Patch parser error text", tools: ["edit"]},
        {id: "docs", title: "Update release notes", tools: ["edit"]},
      ],
    },
  )
  const config = {
    name: "action_graph_runtime",
    research: {mode: "llm", model_policy: {provider: "mock"}},
    execute: {mode: "llm", model_policy: {provider: "mock"}},
    verify: {command: "printf verified", assert_text: "verified"},
    evaluate: {mode: "llm", model_policy: {provider: "mock"}},
  }
  const flow = action_graph_flow(execution_plan, config)
  const report = workflow_validate(flow)
  harness.stdio.println(report.valid)
  with_llm_script(
    harness.llm, [
      llm_text("Research complete."),
      llm_text("Implementation batch complete."),
      llm_text("Evaluation complete."),
    ],
    { ->
      const result = action_graph_run(
        harness, "Fix parser diagnostics",
        execution_plan,
        config,
        {max_steps: 8, persist_path: "/tmp/harn-action-graph-runtime.json"},
      )
      harness.stdio.println(result.status == "completed")
      harness.stdio.println(result.run?._type == "run_record")
      harness.stdio.println(len(result.run.stages) == 4)
      harness.stdio.println(result.run.stages[2].kind == "verify")
      harness.stdio.println(result.batches[1].count == 2)
    },
  )
}
