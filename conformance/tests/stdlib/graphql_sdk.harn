import {
  graphql_execute_operation,
  graphql_generate_client,
  graphql_next_page_variables,
  graphql_normalize_response,
  graphql_operation,
  graphql_page_info,
  graphql_parse_schema,
  graphql_persisted_query,
  graphql_schema_from_introspection,
} from "std/graphql"

pipeline test(task) {
  const root = project_root() ?? cwd()
  const schema_text = harness.fs.read_text(path_join(root, "conformance/fixtures/graphql/linear_fixture.graphql"))
  const parsed = graphql_parse_schema(schema_text)
  const issue = parsed.types.find({ entry -> return entry.name == "Issue" })
  const identifier = issue.fields.find({ field -> return field.name == "identifier" })
  __io_println(identifier.type)
  const introspected = graphql_schema_from_introspection(
    {data: {__schema: {queryType: {name: "Query"}, types: [{kind: "OBJECT", name: "Issue"}]}}},
  )
  __io_println(introspected.query_type)
  const endpoint = "https://linear.example/graphql"
  const query = "query Viewer($id: String!) { viewer(id: $id) { id name } }"
  const operation = graphql_operation(
    "viewer",
    query,
    {
      root_field: "viewer",
      variables_schema: {type: "dict", required: ["id"], properties: {id: {type: "string"}}},
    },
  )
  const generated = graphql_generate_client([operation])
  __io_println(contains(generated, "pub fn viewer"))
  http_mock(
    "POST",
    endpoint,
    {
      status: 200,
      body: json_stringify({data: {viewer: {id: "user-1", name: "Ada"}}, extensions: {cost: 1}}),
      headers: {"X-Complexity": "7", "X-RateLimit-Requests-Remaining": "49", "X-Request-Id": "req-1"},
    },
  )
  const envelope = graphql_execute_operation(
    {endpoint: endpoint, auth: {access_token: "linear-token"}},
    operation,
    {id: "user-1"},
  )
  __io_println(envelope.ok)
  __io_println(envelope.result.name)
  __io_println(envelope.meta.rate_limit.requests_remaining)
  __io_println(envelope.meta.rate_limit.complexity)
  __io_println(envelope.meta.request_id)
  __io_println(envelope.result.meta.status)
  const calls = http_mock_calls({include_sensitive: true})
  __io_println(json_parse(calls[0].body).operationName)
  __io_println(calls[0].headers.authorization)
  const page = graphql_page_info({nodes: [{id: "ISS-1"}], pageInfo: {hasNextPage: true, endCursor: "cursor-1"}})
  __io_println(page.nodes[0].id)
  __io_println(
    graphql_next_page_variables({first: 1}, {pageInfo: {hasNextPage: true, endCursor: "cursor-1"}}).after,
  )
  const persisted = graphql_persisted_query(query)
  __io_println(len(persisted.sha256_hash))
  const normalized = graphql_normalize_response(
    {status: 200, headers: {}, body: "{\"data\":{\"ok\":true},\"errors\":[{\"message\":\"partial\"}]}"},
  )
  __io_println(normalized.partial)
}
