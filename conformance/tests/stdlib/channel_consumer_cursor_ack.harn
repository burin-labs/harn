pipeline default(harness: Harness) {
  harness.testing.clock_set(3000)
  const opts = {scope: "tenant", tenant_id: "coord-tenant"}
  const first = harness.channels.append("coord.ack.demo", {seq: 1}, opts + {id: "coord-ack-1"})
  const second = harness.channels.append("coord.ack.demo", {seq: 2}, opts + {id: "coord-ack-2"})
  const before = harness.channels.consumer_cursor("coord.ack.demo", "worker-A", opts)
  harness.stdio.println(before == nil)
  const all = harness.channels.events("coord.ack.demo", opts)
  harness.stdio.println(len(all))
  harness.stdio.println(all[0].cursor == first.cursor)
  harness.stdio.println(all[1].cursor == second.cursor)
  const acked = harness.channels.ack("coord.ack.demo", "worker-A", first.cursor, opts)
  harness.stdio.println(acked.consumer_id)
  harness.stdio.println(acked.cursor == first.cursor)
  harness.stdio.println(
    harness.channels.consumer_cursor("coord.ack.demo", "worker-A", opts) == first.cursor,
  )
  const unread = harness.channels.events(
    "coord.ack.demo",
    opts + {from_cursor: harness.channels.consumer_cursor("coord.ack.demo", "worker-A", opts)},
  )
  harness.stdio.println(len(unread))
  harness.stdio.println(unread[0].id)
  harness.testing.clock_reset()
}
