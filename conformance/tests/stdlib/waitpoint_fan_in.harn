import "std/waitpoint"

pipeline test(task) {
  const wp: Waitpoint = create("fan-in-" + uuid())
  const first = spawn {
    wait(wp).value + "-1"
  }
  const second = spawn {
    wait(wp).value + "-2"
  }
  const third = spawn {
    wait(wp).value + "-3"
  }
  const fourth = spawn {
    wait(wp).value + "-4"
  }
  const fifth = spawn {
    wait(wp).value + "-5"
  }
  complete(wp, "go")
  __io_println(await(first))
  __io_println(await(second))
  __io_println(await(third))
  __io_println(await(fourth))
  __io_println(await(fifth))
}
