import "std/waitpoint"

pipeline test(harness: Harness, task: unknown) {
  const wp: Waitpoint = create(harness.runtime, "fan-in-" + harness.random.uuid())
  const first = spawn {
    wait(harness.runtime, wp).value + "-1"
  }
  const second = spawn {
    wait(harness.runtime, wp).value + "-2"
  }
  const third = spawn {
    wait(harness.runtime, wp).value + "-3"
  }
  const fourth = spawn {
    wait(harness.runtime, wp).value + "-4"
  }
  const fifth = spawn {
    wait(harness.runtime, wp).value + "-5"
  }
  complete(harness.runtime, wp, "go")
  harness.stdio.println(await(first))
  harness.stdio.println(await(second))
  harness.stdio.println(await(third))
  harness.stdio.println(await(fourth))
  harness.stdio.println(await(fifth))
}
