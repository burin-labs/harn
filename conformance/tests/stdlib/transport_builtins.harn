pipeline test(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.transport_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.test/session",
    {status: 200, body: "pooled", headers: {}},
  )
  const session = harness.net.session({timeout_ms: 100})
  const response = harness.net.session_request(
    session,
    "GET",
    "https://api.example.test/session",
    {},
  )
  assert_eq(response.status, 200)
  assert_eq(response.body, "pooled")
  assert(harness.net.session_close(session))
  harness.testing.sse_mock(
    "https://events.example.test/stream",
    [{event: "hello", data: "one", id: "1"}, "two"],
  )
  const stream = harness.net.sse_connect("GET", "https://events.example.test/stream", {})
  const opened = harness.net.sse_receive(stream, 0)
  const first = harness.net.sse_receive(stream, 0)
  const second = harness.net.sse_receive(stream, 0)
  const done = harness.net.sse_receive(stream, 0)
  assert_eq(opened.type, "open")
  assert_eq(first.type, "event")
  assert_eq(first.event, "hello")
  assert_eq(first.data, "one")
  assert_eq(second.data, "two")
  assert_eq(done, nil)
  harness.testing.websocket_mock("wss://socket.example.test/app", {messages: ["hello"], echo: true})
  const socket = harness.net.websocket_connect("wss://socket.example.test/app", {})
  const greeting = harness.net.websocket_receive(socket, 0)
  assert_eq(greeting.type, "text")
  assert_eq(greeting.data, "hello")
  assert(harness.net.websocket_send(socket, "ack", {}))
  const echoed = harness.net.websocket_receive(socket, 0)
  assert_eq(echoed.data, "ack")
  assert(harness.net.websocket_close(socket))
  harness.testing.websocket_mock("wss://socket.example.test/limited", ["too-long"])
  const limited = harness.net.websocket_connect(
    "wss://socket.example.test/limited",
    {max_message_bytes: 3},
  )
  const limit_result = try {
    harness.net.websocket_receive(limited, 0)
  }
  assert(is_err(limit_result))
  assert(harness.net.websocket_close(limited))
  assert_eq(len(harness.testing.transport_mock_calls()), 6)
  harness.stdio.println("transport_builtins_ok")
}
