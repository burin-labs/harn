pipeline test(harness: Harness, task) {
  // Simple verdicts
  const allow = flow_invariant_allow()
  harness.stdio.println(flow_invariant_kind(allow))
  harness.stdio.println(flow_invariant_is_blocking(allow))
  harness.stdio.println(flow_invariant_confidence(allow))
  const warn = flow_invariant_warn("untested helper")
  harness.stdio.println(flow_invariant_kind(warn))
  harness.stdio.println(warn.verdict.reason)
  const block = flow_invariant_block("missing_test", "no test covers this atom")
  harness.stdio.println(flow_invariant_kind(block))
  harness.stdio.println(flow_invariant_is_blocking(block))
  harness.stdio.println(block.verdict.error.code)
  harness.stdio.println(block.verdict.error.message)
  const principal = flow_invariant_require_approval("principal", "user:alice")
  harness.stdio.println(flow_invariant_kind(principal))
  harness.stdio.println(principal.verdict.approver.kind)
  harness.stdio.println(principal.verdict.approver.id)
  const role = flow_invariant_require_approval("role", "security-reviewer")
  harness.stdio.println(role.verdict.approver.kind)
  harness.stdio.println(role.verdict.approver.name)
  // Evidence + remediation + confidence builders
  const atom_hex = "0101010101010101010101010101010101010101010101010101010101010101"
  const atom_evidence = flow_evidence_atom(atom_hex, 0, 64)
  const metadata_evidence = flow_evidence_metadata("src/auth", "policy", "min_review_count")
  const transcript_evidence = flow_evidence_transcript("transcript-0001", 128, 256)
  const citation_evidence = flow_evidence_citation(
    "https://harnlang.com/spec",
    "verdicts may grade",
    "2026-04-26T00:00:00Z",
  )
  const evidence = [atom_evidence, metadata_evidence, transcript_evidence, citation_evidence]
  const remediation = flow_remediation("strip trailing whitespace")
  const with_evidence = flow_with_evidence(warn, evidence)
  harness.stdio.println(len(with_evidence.evidence))
  harness.stdio.println(with_evidence.evidence[0].kind)
  harness.stdio.println(with_evidence.evidence[1].kind)
  harness.stdio.println(with_evidence.evidence[2].kind)
  harness.stdio.println(with_evidence.evidence[3].kind)
  const with_remediation = flow_with_remediation(block, remediation)
  harness.stdio.println(with_remediation.remediation.description)
  const with_confidence = flow_with_confidence(warn, 0.42)
  harness.stdio.println(flow_invariant_confidence(with_confidence))
  // Confidence clamps to [0.0, 1.0]
  const too_high = flow_with_confidence(warn, 2.0)
  harness.stdio.println(flow_invariant_confidence(too_high))
}
