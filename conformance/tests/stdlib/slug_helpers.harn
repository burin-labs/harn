import "std/slug"

pipeline test(harness: Harness, task) {
  const random_name = random_slug(harness.random, {segments: 3, separator: "_"})
  const random_parts = split(random_name, "_")
  harness.stdio.println(len(random_parts) == 3)
  harness.stdio.println(random_parts[0] != "" && random_parts[1] != "" && random_parts[2] != "")
  const a = slug_from(
    "agent",
    {segments: 4, separator: ".", pattern: ["adjective", "noun", "verb", "noun"]},
  )
  const b = slug_from(
    "agent",
    {segments: 4, separator: ".", pattern: ["adjective", "noun", "verb", "noun"]},
  )
  harness.stdio.println(a == b)
  harness.stdio.println(len(split(a, ".")) == 4)
  const custom = slug_from(
    "x",
    {
      segments: 3,
      dictionary: {adjectives: ["red"], nouns: ["box"], verbs: ["runs"]},
      pattern: ["adjective", "noun", "verb"],
    },
  )
  harness.stdio.println(custom)
  harness.stdio.println(slugify("Hello, Harn Agents!"))
  harness.stdio.println(slugify("Hello, Harn Agents!", {separator: "_"}))
  const prefixed = random_slug(harness.random, {segments: 2, prefix: "Agent 007"})
  harness.stdio.println(substring(prefixed, 0, len("agent-007-")) == "agent-007-")
}
