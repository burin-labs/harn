pipeline test(task) {
  const parsed = cookie_parse("sid=abc; theme=light; sid=old; badsegment")
  assert_eq(parsed.cookies.sid, "abc")
  assert_eq(parsed.cookies.theme, "light")
  assert_eq(parsed.duplicates.sid[0], "abc")
  assert_eq(parsed.duplicates.sid[1], "old")
  assert_eq(len(parsed.invalid), 1)
  log("parsed")
  const serialized = cookie_serialize(
    "theme",
    "dark",
    {path: "/", max_age: 60, http_only: true, secure: true, same_site: "Strict"},
  )
  assert(starts_with(serialized, "theme=dark"), "serialized prefix")
  assert(contains(serialized, "Path=/"), "serialized path")
  assert(contains(serialized, "Max-Age=60"), "serialized max age")
  assert(contains(serialized, "HttpOnly"), "serialized http only")
  assert(contains(serialized, "Secure"), "serialized secure")
  assert(contains(serialized, "SameSite=Strict"), "serialized same site")
  const deleted = cookie_delete("sid", {secure: false})
  assert(starts_with(deleted, "sid="), "delete prefix")
  assert(contains(deleted, "Path=/"), "delete path")
  assert(contains(deleted, "Max-Age=0"), "delete max age")
  assert(contains(deleted, "Expires=Thu, 01 Jan 1970 00:00:00 GMT"))
  assert(contains(deleted, "HttpOnly"))
  assert(contains(deleted, "SameSite=Lax"))
  const bad_name = try {
    cookie_serialize("bad name", "value")
  }
  assert(is_err(bad_name))
  const cross_site = try {
    cookie_serialize("sid", "value", {same_site: "None"})
  }
  assert(is_ok(cross_site), "cross site succeeds")
  assert(contains(unwrap(cross_site), "SameSite=None"), "cross site none")
  assert(contains(unwrap(cross_site), "Secure"), "cross site secure")
  log("serialized")
  const secret = "0123456789abcdef0123456789abcdef"
  const short_secret = try {
    cookie_sign("plain-value", "secret")
  }
  assert(is_err(short_secret), "short secret")
  const signed = cookie_sign("plain-value", secret)
  const verified = cookie_verify(signed, secret)
  assert(verified.ok)
  assert_eq(verified.value, "plain-value")
  const forged = cookie_verify(signed + "x", secret)
  assert(!forged.ok)
  assert_eq(forged.error, "invalid_signature")
  log("signed-cookie")
  const token = session_sign({user: "alice", roles: ["operator"]}, secret)
  const session = session_verify(token, secret)
  assert(session.ok)
  assert_eq(session.payload.user, "alice")
  assert_eq(session.payload.roles[0], "operator")
  const bad_session = session_verify(token + "x", secret)
  assert(!bad_session.ok)
  assert_eq(bad_session.error, "invalid_signature")
  const set_cookie = session_cookie("harn_session", {user: "alice"}, secret)
  assert(starts_with(set_cookie, "harn_session="), "session cookie prefix")
  assert(contains(set_cookie, "Path=/"), "session cookie path")
  assert(contains(set_cookie, "HttpOnly"), "session cookie http only")
  assert(contains(set_cookie, "Secure"), "session cookie secure")
  assert(contains(set_cookie, "SameSite=Lax"), "session cookie same site")
  log("session")
  const round_trip = cookie_round_trip(
    "sid=old; theme=light",
    [set_cookie, cookie_delete("sid", {secure: false})],
  )
  assert_eq(round_trip.cookies.theme, "light")
  assert_eq(round_trip.cookies.sid, nil)
  const from_cookie = session_from_cookies(round_trip.cookie_header, "harn_session", secret)
  assert(from_cookie.ok)
  assert_eq(from_cookie.payload.user, "alice")
  log("round-trip")
}
