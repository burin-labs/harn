/**
 * read_file_result returns Result.Ok(content) on success and
 * Result.Err(message) on failure (instead of throwing like read_file).
 */
pipeline default(task) {
  // Write a known file, then read it back via read_file_result.
  harness.fs.write_text("rfr_fixture.txt", "hello result")
  const ok = harness.fs.read_text_result("rfr_fixture.txt")
  __io_println(is_ok(ok))
  __io_println(unwrap(ok))
  harness.fs.delete("rfr_fixture.txt")
  // Missing path returns Result.Err with a descriptive message.
  const bad = harness.fs.read_text_result("does_not_exist_7f3a.txt")
  __io_println(is_err(bad))
  match bad {
    Result.Err(msg) -> { __io_println(msg.contains("Failed to read")) }
    Result.Ok(_) -> { __io_println("unexpected") }
  }
}
