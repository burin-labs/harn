import "std/run_artifacts"

pipeline test(task) {
  const root = path_join(harness.fs.temp_dir(), "harn-run-artifacts-" + uuid_v7())
  const open_options: RunArtifactsOpenOptions = {root: root, run_id: "run-a"}
  const run: RunArtifactsRun = run_artifacts_open("eval", open_options)
  const paths: RunArtifactPaths = run.paths
  __io_println(run.kind)
  __io_println(run.run_id)
  __io_println(run.root == path_normalize(root))
  __io_println(harness.fs.exists(run.dir))
  __io_println(path_relative_to(paths.facts, run.dir))
  run_artifact_write_json(run, "facts.json", {status: "ok", count: 2}, {pretty: true})
  const facts = run_artifact_read_json(run, "facts.json")
  __io_println(facts.status)
  __io_println(facts.count)
  __io_println(run_artifact_read_json(run, "missing.json", {status: "missing"}).status)
  harness.fs.write_text(run_artifact_path(run, "bad.json"), "{bad")
  __io_println(run_artifact_read_json(run, "bad.json", {status: "malformed"}).status)
  run_artifact_write_text(run, "review.md", "hello")
  __io_println(run_artifact_read_text(run, "review.md", "") == "hello\n")
  __io_println(path_relative_to(run_artifact_transcript_dir(run), run.dir))
  __io_println(path_relative_to(run_artifact_transcript_path(run, "chat-llm"), run.dir))
  const reopened: RunArtifactsRun = run_artifacts_from_dir("eval", run.dir)
  __io_println(reopened.run_id)
  __io_println(path_relative_to(reopened.paths.agent_result, reopened.dir))
  const escaped = try {
    run_artifact_path(run, "../secret.json")
  }
  __io_println(!is_ok(escaped))
  const missing_root = path_join(root, "missing-root")
  __io_println(len(run_artifacts_list("eval", {root: missing_root})) == 0)
  const empty_root = path_join(root, "empty-root")
  harness.fs.mkdir(path_join(empty_root, "eval"))
  __io_println(len(run_artifacts_list("eval", {root: empty_root})) == 0)
  const run_b = run_artifacts_open("eval", {root: root, run_id: "run-b"})
  run_artifact_write_json(run_b, "facts.json", {status: "ok"})
  const listed: list<RunArtifactsRun> = run_artifacts_list("eval", {root: root, limit: 10})
  __io_println(len(listed))
  __io_println(listed[0].modified >= listed[1].modified)
  __io_println(len(run_artifacts_list("eval", {root: root, limit: 1})))
  __io_println(len(run_artifacts_list("eval", {root: root, limit: 0})))
  const namespaced = run_artifacts_open("eval", {root: root, namespace: "fleet", run_id: "run-c"})
  __io_println(path_relative_to(namespaced.dir, root))
  harness.fs.delete(root)
}
