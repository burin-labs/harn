import {
  worktree_prune_classify,
  worktree_prune_default_disposable_paths,
  worktree_prune_default_min_age_seconds,
  worktree_prune_normalize_disposable_path,
  worktree_prune_reason_label,
  worktree_prune_status_has_real_edits,
} from "std/worktree"

fn base_entry() {
  return {
    path: "/tmp/wt-old-merged",
    branch: "feat/done",
    is_main: false,
    is_current: false,
    has_process: false,
    dirty: false,
    unpushed: false,
    merged: true,
    abandoned: false,
    age_seconds: 2 * 60 * 60,
    size_bytes: 3 * 1073741824,
  }
}

fn verdict_reason(entry) {
  return worktree_prune_classify(entry).reason
}

pipeline default(harness: Harness) {
  const base = base_entry()
  harness.stdio.println(worktree_prune_default_min_age_seconds() == 3600)
  harness.stdio.println(worktree_prune_reason_label("dirty") == "dirty (uncommitted edits)")
  harness.stdio.println(worktree_prune_default_disposable_paths().any({ path -> path == "target" }))
  harness.stdio.println(worktree_prune_classify(base).reclaimable)
  harness.stdio.println(
    worktree_prune_classify(base + {branch: nil, merged: false, abandoned: true}).reclaimable,
  )
  harness.stdio.println(verdict_reason(base + {is_main: true}) == "main_checkout")
  harness.stdio.println(verdict_reason(base + {is_current: true}) == "current_worktree")
  harness.stdio.println(verdict_reason(base + {has_process: true}) == "in_use")
  harness.stdio.println(verdict_reason(base + {dirty: true}) == "dirty")
  harness.stdio.println(verdict_reason(base + {unpushed: true}) == "unpushed")
  harness.stdio.println(verdict_reason(base + {merged: false, abandoned: false}) == "not_merged")
  harness.stdio.println(verdict_reason(base + {age_seconds: 10 * 60}) == "too_young")
  harness.stdio.println(worktree_prune_classify(base + {age_seconds: 10 * 60}, 5 * 60).reclaimable)
  harness.stdio.println(
    verdict_reason(base + {has_process: true, age_seconds: 10 * 24 * 60 * 60}) == "in_use",
  )
  harness.stdio.println(!worktree_prune_status_has_real_edits(""))
  harness.stdio.println(
    !worktree_prune_status_has_real_edits(
      " M target/debug/foo\n?? .build/x\n M .harn/state.json\n?? node_modules/pkg/\n",
    ),
  )
  harness.stdio.println(
    !worktree_prune_status_has_real_edits(
      "?? frontend/node_modules/react/index.js\n?? ios/Pods/Alamofire\n",
      {disposable_paths: ["frontend/node_modules", "ios/Pods"]},
    ),
  )
  harness.stdio.println(worktree_prune_status_has_real_edits(" M src/main.rs\n M target/debug/foo\n"))
  harness.stdio.println(!worktree_prune_status_has_real_edits("R  old.rs -> target/old.rs\n"))
  harness.stdio.println(worktree_prune_status_has_real_edits("R  target/x -> src/x.rs\n"))
  harness.stdio.println(
    worktree_prune_status_has_real_edits(
      "?? target-notes.md\n?? .DS_Store.backup\n",
      {disposable_paths: [".DS_Store", "target"]},
    ),
  )
  harness.stdio.println(
    worktree_prune_normalize_disposable_path("./frontend/node_modules/") == "frontend/node_modules",
  )
  harness.stdio.println(worktree_prune_normalize_disposable_path("ios\\Pods") == "ios/Pods")
  harness.stdio.println(worktree_prune_normalize_disposable_path("/tmp/cache") == nil)
  harness.stdio.println(worktree_prune_normalize_disposable_path("../outside") == nil)
  harness.stdio.println(worktree_prune_normalize_disposable_path(".git/hooks") == nil)
}
