import "std/math"
import { assert_error_contains } from "std/testing"

pipeline test(task) {
  assert_eq(clamp(5, 0, 10), 5)
  assert_eq(clamp(-1, 0, 10), 0)
  assert_eq(clamp(99, 0, 10), 10)
  assert_eq(lerp(0, 100, 0.5), 50.0)
  assert_eq(sum([1, 2, 3, 4]), 10)
  assert_eq(sum([1, nil, 2.5, nil]), 3.5)
  assert_eq(sum([nil, nil]), 0)
  assert_eq(sum([]), 0)
  assert_error_contains({ -> sum([1, "2"]) }, "items must contain only numbers or nil")
  assert_eq(avg([2, 4, 6]), 4)
  log("stdlib math ok")
}
