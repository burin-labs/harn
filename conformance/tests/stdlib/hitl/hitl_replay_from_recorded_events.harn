import "std/hitl"
import { clear_host_mocks, mock_host_response } from "std/testing"
import "std/triggers"

pub fn hitl_handler(event: TriggerEvent) -> dict {
  const answer = ask_user("Should we continue handling " + event.kind + "?")
  const approval: {approved: bool, reviewers: list<string>, approved_at: string, reason: string?, signatures: list<{reviewer: string, signed_at: string, signature: string}>} = request_approval("approve " + event.kind, {quorum: 2, reviewers: ["alice", "bob", "carol"]})
  return {
    verdict: answer.verdict,
    event_id: event.id,
    first_reviewer: approval.signatures[0]?.reviewer,
    first_signed_at: approval.signatures[0]?.signed_at,
    first_signature: approval.signatures[0]?.signature,
  }
}

pipeline test(task) {
  clear_host_mocks()
  mock_host_response("hitl", "question", {answer: {verdict: "approved"}})
  mock_host_response(
    "hitl",
    "approval",
    [
      {approved: true, reviewer: "alice", responded_at: "2026-04-20T12:00:00Z"},
      {approved: true, reviewer: "bob", responded_at: "2026-04-20T12:00:01Z"},
    ],
  )
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.gen_range(100000, 999999))
  const handle: TriggerHandle = trigger_register(
    {
      id: "hitl-replay-" + unique,
      kind: "issue.opened",
      provider: "github",
      handler: hitl_handler,
      retry: {max: 1, backoff: "immediate"},
      when: nil,
      match: nil,
      events: ["issue.opened"],
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: nil,
      package_name: nil,
    },
  )
  const fired: DispatchHandle = trigger_fire(
    handle,
    {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-hitl-replay"}},
  )
  __io_println(fired.status == "dispatched")
  __io_println(contains(json_stringify(fired.result ?? {}), "\"verdict\":\"approved\""))
  clear_host_mocks()
  const replay: DispatchHandle = trigger_replay(fired.event_id)
  __io_println(replay.status == "dispatched")
  __io_println(contains(json_stringify(replay.result ?? {}), "\"verdict\":\"approved\""))
  __io_println(replay.result?.first_reviewer == "alice")
  __io_println(replay.result?.first_signed_at == fired.result?.first_signed_at)
  __io_println(replay.result?.first_signature == fired.result?.first_signature)
}
