// Escalation is explicit on the interaction capability and returns a typed
// `EscalationHandle` envelope.
import "std/hitl"
import { clear_host_mocks, mock_host_response } from "std/testing"

pipeline test(harness: Harness, task) {
  clear_host_mocks()
  mock_host_response(
    "hitl",
    "escalation",
    {accepted: true, reviewer: "oncall-primary", reason: "took over"},
  )
  const handle = harness.interaction.escalate_to("oncall", "deploy failed during maintenance window")
  harness.stdio.println(handle.role)
  harness.stdio.println(handle.reason)
  harness.stdio.println(handle.status)
  harness.stdio.println(handle.reviewer)
}
