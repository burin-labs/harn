// First-class HITL syntax: `escalate_to` as a reserved keyword. Named
// args (`role:`, `reason:`) and the typed `EscalationHandle` envelope
// returned by the runtime.
import "std/hitl"
import { clear_host_mocks, mock_host_response } from "std/testing"

pipeline test(task) {
  clear_host_mocks()
  mock_host_response(
    "hitl",
    "escalation",
    {accepted: true, reviewer: "oncall-primary", reason: "took over"},
  )
  let handle = escalate_to(role: "oncall", reason: "deploy failed during maintenance window")
  __io_println(handle.role)
  __io_println(handle.reason)
  __io_println(handle.status)
  __io_println(handle.reviewer)
}
