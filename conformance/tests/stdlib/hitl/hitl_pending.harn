import "std/hitl"

pipeline test(harness: Harness, task: unknown) {
  const prompt = "Need a human " + harness.random.uuid()
  const cursor = harness.obs.event_log_latest("hitl.questions")
  const requests = harness.obs.event_log_subscribe(
    {topic: "hitl.questions", from_cursor: cursor, kind_prefix: "hitl.question_asked"},
  )
  const handle = spawn {
    harness.interaction.ask_user(prompt, {timeout: 5m})
  }
  const requested = requests.next().value
  const rows: list<HitlPendingRequest> = harness.interaction.hitl_pending({}).filter(
    { row -> row.request_id == requested.payload.request_id && row.prompt == prompt },
  )
    .to_list()
  harness.stdio.println(len(rows))
  harness.stdio.println(rows[0]?.request_kind)
  harness.stdio.println(starts_with(rows[0]?.prompt, "Need a human "))
  harness.stdio.println(len(rows[0]?.approvers))
  cancel(handle)
}
