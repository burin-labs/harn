import "std/hitl"

pipeline test(task) {
  let prompt = "Need a human " + uuid()
  let handle = spawn {
    ask_user(prompt, {timeout: 5m})
  }
  sleep(10ms)
  let rows: list<HitlPendingRequest> = hitl_pending({})
    .filter({ row -> row.prompt == prompt }).to_list()
  __io_println(len(rows))
  __io_println(rows[0].request_kind)
  __io_println(starts_with(rows[0].prompt, "Need a human "))
  __io_println(len(rows[0].approvers))
  cancel(handle)
}
