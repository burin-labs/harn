pipeline test(harness: Harness, task) {
  // snake ↔ camel
  harness.stdio.println(snake_to_camel("test_file_patterns"))
  harness.stdio.println(snake_to_camel("a"))
  harness.stdio.println("empty:" + snake_to_camel(""))
  harness.stdio.println(camel_to_snake("testFilePatterns"))
  harness.stdio.println(camel_to_snake("HTTPServer"))
  harness.stdio.println(camel_to_snake("already_snake"))
  harness.stdio.println("empty:" + camel_to_snake(""))
  // snake ↔ pascal
  harness.stdio.println(snake_to_pascal("test_file_patterns"))
  harness.stdio.println(pascal_to_snake("TestFilePatterns"))
  harness.stdio.println(pascal_to_snake("HTTPServer"))
  // kebab variants
  harness.stdio.println(kebab_to_camel("test-file-patterns"))
  harness.stdio.println(camel_to_kebab("testFilePatterns"))
  harness.stdio.println(snake_to_kebab("test_file_patterns"))
  harness.stdio.println(kebab_to_snake("test-file-patterns"))
  // case-first helpers
  harness.stdio.println(uppercase_first("hello"))
  harness.stdio.println(lowercase_first("Hello"))
  harness.stdio.println(title_case("hello world from harn"))
  // round-trip
  harness.stdio.println(camel_to_snake(snake_to_camel("abc_def_ghi")))
  harness.stdio.println(snake_to_camel(camel_to_snake("fooBarBaz")))
}
