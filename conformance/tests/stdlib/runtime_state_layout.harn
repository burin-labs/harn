import { pattern_learning_ensure_migrated } from "std/agent/pattern_knowledge"
import { runtime_state_paths_under } from "std/runtime"
import { with_temp_dir } from "std/testing"
import { worktree_default_path, worktree_prune_default_disposable_paths } from "std/worktree"

pipeline default(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const ambient = harness.fs.runtime_paths()
      const repo_a = path_join(root, "repo-a")
      const repo_b = path_join(root, "repo-b")
      const layout_a = runtime_state_paths_under(repo_a)
      const layout_b = runtime_state_paths_under(repo_b)
      harness.stdio.println(path_is_absolute(ambient.state_root))
      harness.stdio.println(layout_a.state_root != ambient.state_root)
      harness.stdio.println(layout_a.state_root != layout_b.state_root)
      harness.stdio.println(
        worktree_default_path(repo_a, "task") != worktree_default_path(repo_b, "task"),
      )
      harness.stdio.println(
        worktree_default_path(repo_a, "task") == path_join(layout_a.worktree_root, "task"),
      )
      harness.stdio.println(
        worktree_prune_default_disposable_paths().any(
          { path -> path == runtime_state_paths_under(".").state_root },
        ),
      )
      const ambient_namespace = "runtime-state-layout-ambient-" + harness.random.uuid()
      pattern_learning_ensure_migrated(harness, {namespace: ambient_namespace})
      harness.stdio.println(
        harness.fs.exists(
          path_join(
            ambient.state_root,
            "memory",
            ambient_namespace,
            ".burin-session-store-migrated-v1.json",
          ),
        ),
      )
      const explicit_namespace = "runtime-state-layout-explicit-" + harness.random.uuid()
      pattern_learning_ensure_migrated(
        harness,
        {project_root: repo_a, namespace: explicit_namespace},
      )
      harness.stdio.println(
        harness.fs.exists(
          path_join(
            layout_a.state_root,
            "memory",
            explicit_namespace,
            ".burin-session-store-migrated-v1.json",
          ),
        ),
      )
    },
  )
}
