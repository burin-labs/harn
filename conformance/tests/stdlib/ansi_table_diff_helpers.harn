import { ansi_bg, ansi_strip, ansi_style, ansi_visible_len } from "std/ansi"
import { diff_summary, unified_diff } from "std/diff"
import { render_markdown_table, render_table } from "std/table"

pipeline test(harness: Harness, task: unknown) {
  const styled = ansi_style("hi", {fg: "red", bold: true}, {mode: "always"})
  harness.stdio.println(json_stringify(styled))
  harness.stdio.println(ansi_strip(styled))
  harness.stdio.println(ansi_visible_len(styled))
  harness.stdio.println(contains(ansi_bg("x", "bright_red", {mode: "always"}), "[101m"))
  const table = render_table(
    [{name: "api", status: "ok", count: 12}, {name: "web", status: "fail", count: 3}],
    {
      columns: [
        {key: "name", header: "Name"},
        {key: "status", header: "Status"},
        {key: "count", header: "Count", align: "right"},
      ],
    },
  )
  harness.stdio.println(table)
  harness.stdio.println(
    render_markdown_table([{name: "api"}], {columns: [{key: "name", header: "Name"}]}),
  )
  const before = "a\nb\nc"
  const after = "a\nB\nc\nd"
  const summary = diff_summary(before, after)
  harness.stdio.println(summary.changed)
  harness.stdio.println(summary.insertions)
  harness.stdio.println(summary.deletions)
  harness.stdio.println(unified_diff(before, after, {path: "demo.txt"}))
}
