import { ansi_bg, ansi_strip, ansi_style, ansi_visible_len } from "std/ansi"
import { diff_summary, unified_diff } from "std/diff"
import { render_markdown_table, render_table } from "std/table"

pipeline test(task) {
  let styled = ansi_style("hi", {fg: "red", bold: true}, {mode: "always"})
  println(json_stringify(styled))
  println(ansi_strip(styled))
  println(ansi_visible_len(styled))
  println(contains(ansi_bg("x", "bright_red", {mode: "always"}), "[101m"))
  let table = render_table(
    [{name: "api", status: "ok", count: 12}, {name: "web", status: "fail", count: 3}],
    {
      columns: [
        {key: "name", header: "Name"},
        {key: "status", header: "Status"},
        {key: "count", header: "Count", align: "right"},
      ],
    },
  )
  println(table)
  println(render_markdown_table([{name: "api"}], {columns: [{key: "name", header: "Name"}]}))
  let before = "a\nb\nc"
  let after = "a\nB\nc\nd"
  let summary = diff_summary(before, after)
  println(summary.changed)
  println(summary.insertions)
  println(summary.deletions)
  println(unified_diff(before, after, {path: "demo.txt"}))
}
