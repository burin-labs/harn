/** Verifies structured path visibility probes for hard preflight callers. */
pipeline test(harness: Harness, task) {
  const root = path_join(harness.fs.temp_dir(), "harn-fs-status-" + harness.random.uuid())
  if harness.fs.exists(root) {
    harness.fs.delete(root)
  }
  harness.fs.mkdir(path_join(root, "dir"))
  harness.fs.write_text(path_join(root, "file.txt"), "ok\n")
  const file_status = harness.fs.status(path_join(root, "file.txt"))
  harness.stdio.println(file_status.status)
  harness.stdio.println(file_status.kind)
  harness.stdio.println(file_status.exists)
  harness.stdio.println(file_status.visible)
  harness.stdio.println(file_status.is_file)
  harness.stdio.println(file_status.is_dir)
  const dir_status = harness.fs.status(path_join(root, "dir"))
  harness.stdio.println(dir_status.status)
  harness.stdio.println(dir_status.kind)
  harness.stdio.println(dir_status.exists)
  harness.stdio.println(dir_status.visible)
  harness.stdio.println(dir_status.is_file)
  harness.stdio.println(dir_status.is_dir)
  const missing_status = harness.fs.status(path_join(root, "missing.txt"))
  harness.stdio.println(missing_status.status)
  harness.stdio.println(missing_status.kind)
  harness.stdio.println(missing_status.exists)
  harness.stdio.println(missing_status.visible)
  const write_probe = harness.fs.status(path_join(root, "file.txt"), "write")
  harness.stdio.println(write_probe.status)
  harness.stdio.println(write_probe.access)
  harness.fs.delete(root)
}
