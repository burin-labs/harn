import "std/text"

pipeline default() {
  // conversion helpers
  __io_println(int_to_string(42))
  __io_println(int_to_string(-7))
  __io_println(float_to_string(3.5))
  __io_println(parse_int_or("12", 0))
  __io_println(parse_int_or("oops", 9))
  __io_println(parse_float_or("2.25", 0.0))
  __io_println(parse_float_or("oops", 1.5))
  // extract_paths
  const paths = extract_paths("Error in /src/main.rs at line 5\nAlso see ./lib/test.go\n// /ignored/comment.txt")
  __io_println(len(paths))
  __io_println(paths[0])
  __io_println(paths[1])
  const punctuated = extract_paths(
    "Touch internal/manifest/parser.go. Then create internal/manifest/parser_extra_test.go, not validation.",
  )
  __io_println(len(punctuated))
  __io_println(punctuated[0])
  __io_println(punctuated[1])
  // parse_cells
  const response = "Here is code:\n```go\nfmt.Println(\"hi\")\n```\nAnd a call:\n```call python\nwrite_file(\"test.py\", code)\n```\nDone"
  const cells = parse_cells(response)
  __io_println(len(cells))
  __io_println(cells[0].type)
  __io_println(cells[0].lang)
  __io_println(cells[0].code)
  __io_println(cells[1].type)
  __io_println(cells[1].lang)
  // filter_test_cells
  const filtered = filter_test_cells(cells, nil)
  __io_println(len(filtered))
  const filtered2 = filter_test_cells(cells, "test.py")
  __io_println(len(filtered2))
  // truncate_head_tail
  const long_text = join(["a", "b", "c", "d", "e", "f", "g", "h"], "\n")
  const short = truncate_head_tail(long_text, 2)
  __io_println(contains(short, "4 lines omitted"))
  const no_trunc = truncate_head_tail("one\ntwo\nthree", 2)
  __io_println(no_trunc)
  // detect_compile_error
  __io_println(detect_compile_error("SyntaxError: unexpected EOF"))
  __io_println(detect_compile_error("all tests passed"))
  __io_println(detect_compile_error("error: cannot find module"))
  // has_got_want
  __io_println(has_got_want("got: 5\nwant: 10"))
  __io_println(has_got_want("Got: foo\nExpected: bar"))
  __io_println(has_got_want("just got: something"))
  // format_test_errors
  const output = "ok test1\nFAIL test2\nerror: bad input\nok test3\nassert failed"
  const formatted = format_test_errors(output)
  __io_println(formatted)
  // pad_right / pad_left
  __io_println("[" + pad_right("api", 6) + "]")
  __io_println("[" + pad_right("already-wider", 4) + "]")
  __io_println("[" + pad_left("7", 4, "0") + "]")
  __io_println("[" + pad_left(42, 4, "0") + "]")
  __io_println("[" + pad_left(nil, 3) + "]")
  // repeat_string
  __io_println(repeat_string("-", 5))
  __io_println("[" + repeat_string("ab", 3) + "]")
  __io_println("[" + repeat_string("-", 0) + "]")
  __io_println("[" + repeat_string("-", -2) + "]")
  // regex_first_capture / regex_capture_groups / regex_all_first_captures
  __io_println(regex_first_capture("v(\\d+\\.\\d+\\.\\d+)", "release v1.2.3 ready"))
  __io_println(regex_first_capture("does-not-(\\d+)", "no match here"))
  __io_println(json_stringify(regex_capture_groups("(\\d+)\\.(\\d+)\\.(\\d+)", "1.2.3")))
  __io_println(json_stringify(regex_capture_groups("(\\d+)", "no digits")))
  __io_println(json_stringify(regex_all_first_captures("#(\\d+)", "fixes #12 and #34, refs #56")))
  __io_println(json_stringify(regex_all_first_captures("#(\\d+)", "no issue refs")))
  // truncate_middle: ensure head/tail bias goes to head (regression for the
  // pre-fix `ceil(int / 2)` no-op that biased the tail instead).
  __io_println(truncate_middle("0123456789", 6))
  __io_println(truncate_middle("0123456789", 7))
}
