import { verification_diagnostic_delta } from "std/verification"

pipeline test(task) {
  const prior_shifted = {
    diagnostics: [{path: "src/a.tx", line: 10, column: 2, code: "E1", message: "error E1: missing Foo"}],
  }
  const current_shifted = {
    diagnostics: [{path: "src/a.tx", line: 99, column: 7, code: "E1", message: "error E1: missing Foo"}],
  }
  const same = verification_diagnostic_delta(
    prior_shifted,
    current_shifted,
    {row: {diagnosticDelta: {include_path: true}}},
  )
  assert_eq(same.status, "unchanged")
  assert_eq(same.progress_credit, false)
  assert_eq(same.same_signature_set, true)
  const location_sensitive = verification_diagnostic_delta(
    prior_shifted,
    current_shifted,
    {row: {diagnosticDelta: {include_path: true, strip_locations: false}}},
  )
  assert_eq(location_sensitive.status, "advanced")
  assert_eq(location_sensitive.progress_credit, true)
  assert_eq(len(location_sensitive.removed), 1)
  assert_eq(len(location_sensitive.added), 1)
  const removed_one = verification_diagnostic_delta({diagnostics: ["A", "B"]}, {diagnostics: ["B"]})
  assert_eq(removed_one.status, "advanced")
  assert_eq(removed_one.progress_credit, true)
  assert_eq(removed_one.removed, ["a"])
  assert_eq(removed_one.added, [])
  assert_eq(removed_one.persisted, ["b"])
  const changed = verification_diagnostic_delta("A", "C")
  assert_eq(changed.status, "advanced")
  assert_eq(changed.progress_credit, true)
  assert_eq(changed.removed, ["a"])
  assert_eq(changed.added, ["c"])
  const cleared = verification_diagnostic_delta({diagnostics: ["A"]}, {success: true})
  assert_eq(cleared.status, "cleared")
  assert_eq(cleared.progress_credit, true)
  assert_eq(cleared.current.signatures, [])
  const advisory = verification_diagnostic_delta({diagnostics: ["A"]}, {diagnostics: [], feedsGates: false})
  assert_eq(advisory.status, "advisory")
  assert_eq(advisory.progress_credit, false)
  assert_eq(advisory.feedsGates, false)
  const previous_advisory = verification_diagnostic_delta({failureSignature: "A", feedsGates: false}, {failureSignature: "B"})
  assert_eq(previous_advisory.status, "initialized")
  assert_eq(previous_advisory.progress_credit, false)
  const replaced = verification_diagnostic_delta(
    "ERR123 value",
    "ERR999 value",
    {row: {diagnosticDelta: {replacements: [{pattern: "ERR[0-9]+", replacement: "ERRX"}]}}},
  )
  assert_eq(replaced.status, "unchanged")
  assert_eq(replaced.progress_credit, false)
  const regressed = verification_diagnostic_delta({diagnostics: ["A"]}, {diagnostics: ["A", "C"]})
  assert_eq(regressed.status, "regressed")
  assert_eq(regressed.progress_credit, false)
  assert_eq(regressed.persisted, ["a"])
  assert_eq(regressed.added, ["c"])
  __io_println("verification diagnostic delta ok")
}
