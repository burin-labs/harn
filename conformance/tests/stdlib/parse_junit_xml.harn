pipeline test(harness: Harness, task: unknown) {
  // Mixed pass/fail/skip with classname qualification, time attribute,
  // and embedded system-out/system-err.
  const xml =
    "<?xml version=\"1.0\"?>\n<testsuites>\n  <testsuite name=\"suite\">\n    <testcase classname=\"pkg.Suite\" name=\"passes\" time=\"0.001\"/>\n    <testcase classname=\"pkg.Suite\" name=\"fails\" time=\"0.250\">\n      <failure message=\"boom\">stack trace here</failure>\n    </testcase>\n    <testcase classname=\"pkg.Suite\" name=\"skipped\"><skipped/></testcase>\n    <testcase classname=\"pkg.Suite\" name=\"errored\">\n      <error message=\"segfault\">core dumped</error>\n      <system-out>hello</system-out>\n      <system-err>warn: x</system-err>\n    </testcase>\n  </testsuite>\n</testsuites>"
  const cases = parse_junit_xml(xml)
  harness.stdio.log(len(cases))
  harness.stdio.log(cases[0].name)
  harness.stdio.log(cases[0].status)
  harness.stdio.log(cases[0].duration_ms)
  harness.stdio.log(cases[1].status)
  harness.stdio.log(cases[1].duration_ms)
  harness.stdio.log(cases[1].message)
  harness.stdio.log(cases[2].status)
  harness.stdio.log(cases[3].status)
  harness.stdio.log(cases[3].message)
  harness.stdio.log(cases[3].stdout)
  harness.stdio.log(cases[3].stderr)
  // Lenient: malformed input yields an empty list, no exception.
  const empty = parse_junit_xml("not xml at all")
  harness.stdio.log(len(empty))
  // Bytes input is accepted alongside strings.
  const from_bytes = parse_junit_xml(
    bytes_from_string("<testsuite><testcase name=\"only\"/></testsuite>"),
  )
  harness.stdio.log(len(from_bytes))
  harness.stdio.log(from_bytes[0].name)
  harness.stdio.log(from_bytes[0].status)
}
