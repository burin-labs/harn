import { memory_open, memory_recall } from "std/memory"
import {
  bulletin_accept,
  bulletin_memory_namespace,
  bulletin_propose,
} from "std/personas/bulletins"

pipeline default(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-bulletin-embed-" + harness.random.uuid(),
  )
  harness.testing.clear()
  harness.testing.respond(
    "embed",
    "text_response",
    {vector: [0.4, 0.6, 0.7], dim: 3, model: "fake"},
    nil,
    true,
  )
  const proposed = bulletin_propose(
    harness.clock,
    {
      scope: "user",
      scope_key: "kenneth",
      subject: "kenneth",
      assertion: "prefers concise replies without trailing summaries",
      confidence: 0.85,
      evidence: [{kind: "user_msg", ref: "msg-1"}],
      source: {agent: "curator"},
      proposed_at: "2026-05-15T00:00:00Z",
    },
  )
  const namespace = bulletin_memory_namespace(proposed)
  harness.stdio.println(namespace)
  // Open the bulletin's memory namespace with the vector backend so the
  // accept path picks the right defaults.
  memory_open(
    harness.memory,
    namespace,
    {backend: "vector", embed_dim: 3, embed_model_hint: "fake", root: root},
  )
  const receipt = bulletin_accept(
    harness,
    proposed,
    {
      embed: true,
      memory_root: root,
      embed_model_hint: "fake",
      decided_by: "user",
      decided_at: "2026-05-15T00:01:00Z",
      topic: "personas.bulletins.test.decisions",
    },
  )
  harness.stdio.println(receipt.decision.action)
  harness.stdio.println(receipt.decision.status)
  // Accepted bulletin should be recallable from the bulletin memory
  // namespace.
  const hits = memory_recall(harness.memory, namespace, "preferences", 5, {root: root})
  harness.stdio.println(len(hits))
  harness.stdio.println(hits[0].key == proposed.id)
  harness.stdio.println(hits[0].provenance.bulletin_id == proposed.id)
  harness.stdio.println(hits[0].tags[0])
  harness.fs.delete(root)
}
