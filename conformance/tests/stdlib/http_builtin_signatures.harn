pipeline test(harness: Harness, task: unknown) {
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/users",
    {status: 200, body: "alice", headers: {}},
  )
  harness.testing.http_mock(
    "POST",
    "https://api.example.com/users",
    {status: 201, body: "created", headers: {}},
  )
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/stream",
    {status: 206, body: "abcdef", headers: {"content-type": "application/octet-stream"}},
  )
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/download",
    {status: 200, body: "payload", headers: {"content-type": "text/plain"}},
  )
  const get_resp: dict = harness.net.get("https://api.example.com/users")
  const post_resp: dict = harness.net.post("https://api.example.com/users", "{}")
  const stream: string = harness.net.stream_open("https://api.example.com/stream")
  const info: dict = harness.net.stream_info(stream)
  const chunk = harness.net.stream_read(stream, 3)
  const closed: bool = harness.net.stream_close(stream)
  const dst = harness.fs.workspace_temp_dir() + "/http-signature-download.txt"
  const download_resp: dict = harness.net.download("https://api.example.com/download", dst)
  harness.stdio.log(get_resp.status)
  harness.stdio.log(get_resp.body)
  harness.stdio.log(post_resp.status)
  harness.stdio.log(post_resp.body)
  harness.stdio.log(info.status)
  if chunk != nil {
    harness.stdio.log(bytes_to_string(chunk))
  }
  harness.stdio.log(closed)
  harness.stdio.log(download_resp.bytes_written)
}
