import { coord_post, coord_read } from "std/coordination"
import { fleet_claim, fleet_done, fleet_project } from "std/fleet/coordination"

pipeline default() {
  mock_time(2000)
  const room = {session_id: "fleet-conflict"}
  const first = fleet_claim(
    "session",
    "ops",
    "repo#7",
    room + {id: "claim-a", from: {agent: "lane-a"}},
  )
  const _ = fleet_claim("session", "ops", "repo#7", room + {id: "claim-b", from: {agent: "lane-b"}})
  const _ = coord_post(
    "session",
    "ops",
    {
      kind: "heartbeat",
      subject: "future heartbeat",
      from: {agent: "future-lane"},
      data: {schema: "harn.fleet.heartbeat.v2", state: "busy"},
    },
    room + {id: "future-heartbeat"},
  )
  const _ = coord_post(
    "session",
    "ops",
    {
      kind: "heartbeat",
      subject: "malformed heartbeat",
      from: {agent: "malformed-lane"},
      data: {schema: "harn.fleet.heartbeat.v1", state: "busy"},
    },
    room + {id: "malformed-heartbeat"},
  )
  const conflicted = fleet_project(
    coord_read("session", "ops", room + {include_events: true}),
    {now_ms: 2000},
  )
  __io_println(len(conflicted.conflicts))
  __io_println(conflicted.claims[0]?.state)
  __io_println(conflicted.claims[1]?.state)
  __io_println(conflicted.unknown_messages[0]?.id)
  __io_println(len(conflicted.unknown_messages))
  const _ = fleet_done(
    "session",
    "ops",
    first.id,
    "different-work",
    "completed",
    room + {id: "done-wrong-key", from: {agent: "lane-a"}},
  )
  const wrong_key = fleet_project(
    coord_read("session", "ops", room + {include_events: true}),
    {now_ms: 2000},
  )
  __io_println(wrong_key.claims[0]?.state)
  const _ = fleet_done(
    "session",
    "ops",
    first.id,
    "repo#7",
    "completed",
    room + {id: "done-a", from: {agent: "lane-a"}},
  )
  const resolved = fleet_project(
    coord_read("session", "ops", room + {include_events: true}),
    {now_ms: 2000},
  )
  __io_println(len(resolved.conflicts))
  __io_println(resolved.claims[0]?.state)
  __io_println(resolved.claims[1]?.state)
  unmock_time()
}
