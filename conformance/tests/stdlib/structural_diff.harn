import { changeset_summary, structural_diff } from "std/diff"

fn write_fixture(fs: HarnessFs, dir: string, name: string, body: string) -> string {
  const path = path_join(dir, name)
  fs.write_text(path, body)
  return path
}

pipeline default(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn_structural_diff_" + to_string(harness.random.range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  const reformat_a = write_fixture(
    harness.fs,
    root,
    "reformat_before.rs",
    "fn add(a:i32,b:i32)->i32{a+b}\n",
  )
  const reformat_b = write_fixture(
    harness.fs,
    root,
    "reformat_after.rs",
    "fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n",
  )
  const reformat = structural_diff(harness.ast, reformat_a, reformat_b, "rust")
  harness.stdio.println(reformat.result == "ok")
  harness.stdio.println(reformat.structural)
  harness.stdio.println(!reformat.changed && len(reformat.changes) == 0)
  const rename_a = write_fixture(
    harness.fs,
    root,
    "rename_before.rs",
    "fn value() -> i32 {\n    1\n}\n",
  )
  const rename_b = write_fixture(
    harness.fs,
    root,
    "rename_after.rs",
    "fn total() -> i32 {\n    1\n}\n",
  )
  const rename = structural_diff(harness.ast, rename_a, rename_b, {language: "rust"})
  harness.stdio.println(rename.summary.replacements == 1)
  harness.stdio.println(rename.changes[0].node_kind == "identifier")
  harness.stdio.println(
    rename.changes[0].before_text == "value" && rename.changes[0].after_text == "total",
  )
  const move_a = write_fixture(
    harness.fs,
    root,
    "move_before.rs",
    "fn first() -> i32 {\n    1\n}\n\nfn second() -> i32 {\n    2\n}\n",
  )
  const move_b = write_fixture(
    harness.fs,
    root,
    "move_after.rs",
    "fn second() -> i32 {\n    2\n}\n\nfn first() -> i32 {\n    1\n}\n",
  )
  const moved = structural_diff(harness.ast, move_a, move_b, "rust")
  harness.stdio.println(moved.summary.moves >= 1)
  harness.stdio.println(moved.changes[0].kind == "move")
  const logic_a = write_fixture(
    harness.fs,
    root,
    "logic_before.rs",
    "fn answer() -> i32 {\n    41\n}\n",
  )
  const logic_b = write_fixture(
    harness.fs,
    root,
    "logic_after.rs",
    "fn answer() -> i32 {\n    42\n}\n",
  )
  const logic = structural_diff(harness.ast, logic_a, logic_b, "rust")
  harness.stdio.println(logic.summary.replacements == 1)
  harness.stdio.println(logic.changes[0].node_kind == "integer_literal")
  harness.stdio.println(logic.changes[0].before_text == "41" && logic.changes[0].after_text == "42")
  const fallback = structural_diff(harness.ast, logic_a, logic_b, {language: "rust", max_bytes: 8})
  harness.stdio.println(fallback.result == "fallback" && fallback.mode == "line")
  harness.stdio.println(contains(fallback.fallback_reason, "byte_limit_exceeded"))
  harness.stdio.println(
    contains(fallback.line_diff.diff, "-    41") && contains(fallback.line_diff.diff, "+    42"),
  )
  const changeset = changeset_summary(
    harness.ast,
    [
      {
        path: "src/lib.rs",
        before: "pub fn greet(name: &str) -> String { name.to_string() }\n",
        after: "pub fn greet(name: &str, loud: bool) -> String { name.to_string() }\n",
      },
      {
        path: "src/format.rs",
        before: "fn add(a:i32,b:i32)->i32{a+b}\n",
        after: "fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n",
      },
    ],
  )
  harness.stdio.println(changeset.schema == "harn.review_changeset.v1")
  harness.stdio.println(changeset.counts.signatures_changed == 1)
  harness.stdio.println(changeset.counts.exported_signatures_changed == 1)
  harness.stdio.println(changeset.counts.files_reshaped_only == 1)
  harness.stdio.println(
    len(changeset.changes.filter({ change -> change.after?.name == "greet" })) == 1,
  )
}
