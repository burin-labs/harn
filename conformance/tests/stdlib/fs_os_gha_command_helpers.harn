import {
  argv_label,
  command_failure_text,
  command_output_text,
  command_result_fail,
} from "std/command"
import { append_line, read_json, relative_path, write_json } from "std/fs"
import { gha_annotation, gha_env_block, gha_write_output } from "std/gha"
import { env_bool } from "std/os"
import { prefix_lines, single_line_or, truncate_middle, truncate_text } from "std/text"

pipeline test(task) {
  let root = path_join(temp_dir(), "harn-utility-helpers-" + uuid_v7())
  let json_path = path_join(root, "nested/data.json")
  write_json(json_path, {name: "harn", count: 2}, {pretty: true})
  let parsed = read_json(json_path)
  println(parsed.name)
  println(parsed.count)
  println(relative_path(root, json_path))
  let lines_path = path_join(root, "lines.txt")
  append_line(lines_path, "x")
  println(read_file(lines_path))
  let output_path = path_join(root, "github-output.txt")
  println(gha_env_block("answer", "42", "EOF"))
  println(gha_write_output("name", "harn", output_path))
  let output_file = read_file(output_path)
  println(contains(output_file, "name<<harn_"))
  println(contains(output_file, "\nharn\n"))
  println(
    gha_annotation("warning", "line1\nline2", {file: "src/main.rs", line: 7, title: "Heads, up"}),
  )
  println(env_bool("HARN_TEST_UNSET_BOOL_FOR_STDLIB", true))
  println(argv_label(["git", "status", "--short"]))
  let failed = command_result_fail(2, "bad", {stdout: "out"})
  println(command_output_text(failed, "stderr"))
  println(contains(command_failure_text(failed), "exit=2"))
  println(single_line_or(" a\n b\tc ", "fallback"))
  println(prefix_lines("a\nb", "> "))
  println(truncate_middle("abcdef", 5))
  println(contains(truncate_text("abcdef", 3), "truncated"))
  delete_file(root)
}
