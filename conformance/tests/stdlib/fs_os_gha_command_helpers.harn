import {
  argv_label,
  command_failure_text,
  command_output_text,
  command_result_fail,
} from "std/command"
import { append_line, read_json, relative_path, write_json } from "std/fs"
import { gha_annotation, gha_env_block, gha_write_output } from "std/gha"
import { env_bool } from "std/os"
import { prefix_lines, single_line_or, truncate_middle, truncate_text } from "std/text"

pipeline test(task) {
  const root = path_join(harness.fs.temp_dir(), "harn-utility-helpers-" + uuid_v7())
  const json_path = path_join(root, "nested/data.json")
  write_json(json_path, {name: "harn", count: 2}, {pretty: true})
  const parsed = read_json(json_path)
  __io_println(parsed.name)
  __io_println(parsed.count)
  __io_println(relative_path(root, json_path))
  const lines_path = path_join(root, "lines.txt")
  append_line(lines_path, "x")
  __io_println(harness.fs.read_text(lines_path))
  const output_path = path_join(root, "github-output.txt")
  __io_println(gha_env_block("answer", "42", "EOF"))
  __io_println(gha_write_output("name", "harn", output_path))
  const output_file = harness.fs.read_text(output_path)
  __io_println(contains(output_file, "name<<harn_"))
  __io_println(contains(output_file, "\nharn\n"))
  __io_println(
    gha_annotation("warning", "line1\nline2", {file: "src/main.rs", line: 7, title: "Heads, up"}),
  )
  __io_println(env_bool("HARN_TEST_UNSET_BOOL_FOR_STDLIB", true))
  __io_println(argv_label(["git", "status", "--short"]))
  const failed = command_result_fail(2, "bad", {stdout: "out"})
  __io_println(command_output_text(failed, "stderr"))
  __io_println(contains(command_failure_text(failed), "exit=2"))
  __io_println(single_line_or(" a\n b\tc ", "fallback"))
  __io_println(prefix_lines("a\nb", "> "))
  __io_println(truncate_middle("abcdef", 5))
  __io_println(contains(truncate_text("abcdef", 3), "truncated"))
  harness.fs.delete(root)
}
