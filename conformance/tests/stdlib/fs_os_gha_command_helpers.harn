import {
  argv_label,
  command_failure_text,
  command_output_text,
  command_result_fail,
} from "std/command"
import { command_output_text_impl } from "std/command/output"
import { argv_label_impl } from "std/command/shell"
import { append_line, read_json, relative_path, write_json } from "std/fs"
import { gha_annotation, gha_env_block, gha_write_output } from "std/gha"
import { env_bool } from "std/os"
import { prefix_lines, single_line_or, truncate_middle, truncate_text } from "std/text"

pipeline test(harness: Harness, task) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-utility-helpers-" + harness.random.uuid_v7(),
  )
  const json_path = path_join(root, "nested/data.json")
  write_json(harness.fs, json_path, {name: "harn", count: 2}, {pretty: true})
  const parsed = read_json(harness.fs, json_path)
  harness.stdio.println(parsed.name)
  harness.stdio.println(parsed.count)
  harness.stdio.println(relative_path(root, json_path))
  const lines_path = path_join(root, "lines.txt")
  append_line(harness.fs, lines_path, "x")
  harness.stdio.println(harness.fs.read_text(lines_path))
  const output_path = path_join(root, "github-output.txt")
  harness.stdio.println(gha_env_block(harness.random, "answer", "42", "EOF"))
  harness.stdio.println(gha_write_output(harness, "name", "harn", output_path))
  const output_file = harness.fs.read_text(output_path)
  harness.stdio.println(contains(output_file, "name<<harn_"))
  harness.stdio.println(contains(output_file, "\nharn\n"))
  harness.stdio.println(
    gha_annotation("warning", "line1\nline2", {file: "src/main.rs", line: 7, title: "Heads, up"}),
  )
  harness.stdio.println(env_bool(harness.env, "HARN_TEST_UNSET_BOOL_FOR_STDLIB", true))
  harness.stdio.println(argv_label(["git", "status", "--short"]))
  assert_eq(argv_label(["git", "status", "--short"]), argv_label_impl(["git", "status", "--short"]))
  const failed = command_result_fail(2, "bad", {stdout: "out"})
  harness.stdio.println(command_output_text(failed, "stderr"))
  assert_eq(command_output_text(failed, "stderr"), command_output_text_impl(failed, "stderr"))
  harness.stdio.println(contains(command_failure_text(harness.agent, failed), "exit=2"))
  harness.stdio.println(single_line_or(" a\n b\tc ", "fallback"))
  harness.stdio.println(prefix_lines("a\nb", "> "))
  harness.stdio.println(truncate_middle("abcdef", 5))
  harness.stdio.println(contains(truncate_text("abcdef", 3), "truncated"))
  harness.fs.delete(root)
}
