import {
  StructuredDataFormat,
  StructuredReadFailure,
  TypedReadFailure,
  TypedReadResult,
  read_json,
  read_json_result,
  read_json_typed,
  read_json_typed_result,
  read_toml_result,
  read_toml_typed,
  read_toml_typed_result,
  read_yaml_result,
  read_yaml_typed,
  read_yaml_typed_result,
  write_json,
} from "std/fs"
import "std/schema"

type User = {name: string, role?: string}

type Owner = {name: string, active: bool}

type Settings = {enabled: bool}

type Manifest = {
  name: string,
  mode: "strict" | "relaxed",
  owners: list<Owner>,
  settings: Settings,
  retries?: int,
  note?: string,
}

type StructuredCase = {
  format: StructuredDataFormat,
  extension: string,
  valid: string,
  invalid: string,
  malformed: string,
}

fn manifest_schema() -> Schema<Manifest> {
  return schema_refine(
    schema_of(Manifest),
    schema_closed_object(
      {
        name: schema_field(schema_string()),
        mode: schema_field(schema_enum(["strict", "relaxed"])),
        owners: schema_field(
          schema_list(
            schema_closed_object(
              {name: schema_field(schema_string()), active: schema_field(schema_bool())},
            ),
          ),
        ),
        settings: schema_field(schema_closed_object({enabled: schema_field(schema_bool())})),
        retries: schema_default(schema_int(), 3),
        note: schema_field(schema_string(), false),
      },
    ),
  )
}

fn read_structured_result(
  fs: HarnessFs,
  format: StructuredDataFormat,
  path: string,
) -> Result<unknown, StructuredReadFailure> {
  if format == "json" {
    return read_json_result(fs, path)
  }
  if format == "yaml" {
    return read_yaml_result(fs, path)
  }
  return read_toml_result(fs, path)
}

fn read_manifest_result(
  fs: HarnessFs,
  format: StructuredDataFormat,
  path: string,
  schema: Schema<Manifest>,
  apply_defaults: bool = false,
) -> TypedReadResult<Manifest> {
  if format == "json" {
    return read_json_typed_result(fs, path, schema, apply_defaults)
  }
  if format == "yaml" {
    return read_yaml_typed_result(fs, path, schema, apply_defaults)
  }
  return read_toml_typed_result(fs, path, schema, apply_defaults)
}

fn read_manifest_required(
  fs: HarnessFs,
  format: StructuredDataFormat,
  path: string,
  schema: Schema<Manifest>,
) -> Manifest {
  if format == "json" {
    return read_json_typed(fs, path, schema)
  }
  if format == "yaml" {
    return read_yaml_typed(fs, path, schema)
  }
  return read_toml_typed(fs, path, schema)
}

fn format_typed_read_failure(failure: TypedReadFailure) -> string {
  return failure.format + ":" + failure.kind + ":" + to_string(failure.path != "")
}

pipeline default(harness: Harness, task: unknown) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-fs-structured-results-" + harness.random.uuid_v7(),
  )
  harness.fs.mkdir(root)
  const object_path = path_join(root, "object.json")
  write_json(harness.fs, object_path, {})
  harness.stdio.println(type_of(read_json(harness.fs, object_path)))
  const array_path = path_join(root, "array.json")
  harness.fs.write_text(array_path, "[1,2,3]")
  harness.stdio.println(len(unwrap(read_json_result(harness.fs, array_path))))
  const scalar_path = path_join(root, "scalar.json")
  harness.fs.write_text(scalar_path, "\"hello\"")
  harness.stdio.println(unwrap(read_json_result(harness.fs, scalar_path)))
  const number_path = path_join(root, "number.json")
  harness.fs.write_text(number_path, "42")
  harness.stdio.println(unwrap(read_json_result(harness.fs, number_path)))
  const bool_path = path_join(root, "bool.json")
  harness.fs.write_text(bool_path, "true")
  harness.stdio.println(unwrap(read_json_result(harness.fs, bool_path)))
  const null_path = path_join(root, "null.json")
  harness.fs.write_text(null_path, "null")
  const null_result = read_json_result(harness.fs, null_path)
  harness.stdio.println(is_ok(null_result))
  harness.stdio.println(unwrap(null_result) == nil)
  const absent = read_json_result(harness.fs, path_join(root, "missing.json"))
  harness.stdio.println(unwrap_err(absent).kind)
  const required_absent = try {
    read_json(harness.fs, path_join(root, "missing.json"))
  }
  harness.stdio.println(unwrap_err(required_absent).kind)
  const directory = read_json_result(harness.fs, root)
  harness.stdio.println(unwrap_err(directory).kind)
  const malformed_path = path_join(root, "malformed.json")
  harness.fs.write_text(malformed_path, "{bad")
  const malformed = unwrap_err(read_json_result(harness.fs, malformed_path))
  harness.stdio.println(malformed.kind)
  harness.stdio.println(malformed.line > 0 && malformed.column > 0)
  const depth_127_path = path_join(root, "depth-127.json")
  harness.fs.write_text(depth_127_path, "[".repeat(127) + "0" + "]".repeat(127))
  harness.stdio.println(is_ok(read_json_result(harness.fs, depth_127_path)))
  const depth_128_path = path_join(root, "depth-128.json")
  harness.fs.write_text(depth_128_path, "[".repeat(128) + "0" + "]".repeat(128))
  const too_deep = unwrap_err(read_json_result(harness.fs, depth_128_path))
  harness.stdio.println(too_deep.kind)
  harness.stdio.println(too_deep.line > 0 && too_deep.column > 0)
  const deep_malformed_path = path_join(root, "deep-malformed.json")
  harness.fs.write_text(deep_malformed_path, "[".repeat(128) + "x" + "]".repeat(128))
  const deep_malformed = unwrap_err(read_json_result(harness.fs, deep_malformed_path))
  harness.stdio.println(deep_malformed.kind)
  const typed_path = path_join(root, "typed.json")
  harness.fs.write_text(typed_path, "{\"name\":\"Ada\"}")
  const user_schema = schema_refine(
    schema_of(User),
    schema_closed_object(
      {name: schema_field(schema_string()), role: schema_default(schema_string(), "user")},
    ),
  )
  const typed = read_json_typed_result(harness.fs, typed_path, user_schema, true)
  harness.stdio.println(unwrap(typed).name)
  harness.stdio.println(unwrap(typed).role)
  const invalid_path = path_join(root, "invalid.json")
  harness.fs.write_text(invalid_path, "{\"name\":42}")
  const invalid = unwrap_err(read_json_typed_result(harness.fs, invalid_path, schema_of(User)))
  harness.stdio.println(invalid.kind)
  harness.stdio.println(len(invalid.issues) > 0)
  harness.stdio.println(format_typed_read_failure(invalid))
  const typed_absent: TypedReadFailure = unwrap_err(absent)
  harness.stdio.println(format_typed_read_failure(typed_absent))
  const required_invalid = try {
    read_json_typed(harness.fs, invalid_path, schema_of(User))
  }
  harness.stdio.println(unwrap_err(required_invalid).kind)
  const manifest_schema = manifest_schema()
  const cases: list<StructuredCase> = [
    {
      format: "json",
      extension: "json",
      valid:
        "{\"name\":\"Ada\",\"mode\":\"strict\",\"owners\":[{\"name\":\"Lin\",\"active\":true}],\"settings\":{\"enabled\":true}}",
      invalid:
        "{\"name\":\"Ada\",\"mode\":\"unsafe\",\"owners\":[{\"name\":\"Lin\",\"active\":true}],\"settings\":{\"enabled\":true,\"extra\":\"no\"}}",
      malformed: "{bad",
    },
    {
      format: "yaml",
      extension: "yaml",
      valid:
        "name: Ada\nmode: strict\nowners:\n  - name: Lin\n    active: true\nsettings:\n  enabled: true\n",
      invalid:
        "name: Ada\nmode: unsafe\nowners:\n  - name: Lin\n    active: true\nsettings:\n  enabled: true\n  extra: no\n",
      malformed: "name: [\n",
    },
    {
      format: "toml",
      extension: "toml",
      valid:
        "name = \"Ada\"\nmode = \"strict\"\nowners = [{ name = \"Lin\", active = true }]\n[settings]\nenabled = true\n",
      invalid:
        "name = \"Ada\"\nmode = \"unsafe\"\nowners = [{ name = \"Lin\", active = true }]\n[settings]\nenabled = true\nextra = \"no\"\n",
      malformed: "name = [\n",
    },
  ]
  for case in cases {
    const valid_path = path_join(root, "manifest-valid." + case.extension)
    harness.fs.write_text(valid_path, case.valid)
    const manifest = unwrap(
      read_manifest_result(harness.fs, case.format, valid_path, manifest_schema, true),
    )
    harness.stdio.println(
      "${case.format}:"
        + manifest.name
        + ":"
        + manifest.mode
        + ":"
        + manifest.owners[0].name
        + ":"
        + to_string(manifest.settings.enabled)
        + ":"
        + to_string(manifest.retries)
        + ":"
        + (manifest.note ?? "none"),
    )
    const invalid_manifest_path = path_join(root, "manifest-invalid." + case.extension)
    harness.fs.write_text(invalid_manifest_path, case.invalid)
    const schema_failure = unwrap_err(
      read_manifest_result(harness.fs, case.format, invalid_manifest_path, manifest_schema),
    )
    const issue_json = json_stringify(schema_failure.issues)
    harness.stdio.println(
      schema_failure.format
        + ":"
        + schema_failure.kind
        + ":"
        + to_string(contains(issue_json, "\"path\":\"mode\""))
        + ":"
        + to_string(contains(issue_json, "\"path\":\"settings\""))
        + ":"
        + to_string(contains(issue_json, "\"code\":\"schema.validation\"")),
    )
    const thrown_schema = try {
      read_manifest_required(harness.fs, case.format, invalid_manifest_path, manifest_schema)
    }
    const thrown_failure = unwrap_err(thrown_schema)
    harness.stdio.println(
      thrown_failure.format
        + ":"
        + thrown_failure.kind
        + ":"
        + to_string(thrown_failure.path == invalid_manifest_path),
    )
    const absent_failure = unwrap_err(
      read_structured_result(harness.fs, case.format, path_join(root, "missing." + case.extension)),
    )
    harness.stdio.println(absent_failure.format + ":" + absent_failure.kind)
    const unreadable_failure = unwrap_err(read_structured_result(harness.fs, case.format, root))
    harness.stdio.println(unreadable_failure.format + ":" + unreadable_failure.kind)
    const malformed_structured_path = path_join(root, "malformed." + case.extension)
    harness.fs.write_text(malformed_structured_path, case.malformed)
    const parse_failure = unwrap_err(
      read_structured_result(harness.fs, case.format, malformed_structured_path),
    )
    harness.stdio.println(
      parse_failure.format
        + ":"
        + parse_failure.kind
        + ":"
        + to_string((parse_failure.line ?? 0) > 0)
        + ":"
        + to_string((parse_failure.column ?? 0) > 0),
    )
  }
  harness.fs.delete(root)
}
