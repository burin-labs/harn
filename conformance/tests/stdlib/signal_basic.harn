import "std/signal"

pipeline default(harness: Harness) {
  const first = on_interrupt({ -> harness.stdio.println("a") }, {once: false})
  const second = on_interrupt({ -> harness.stdio.println("b") }, {once: false})
  __signal_raise("SIGINT")
  off_interrupt(second)
  __signal_raise("SIGINT")
  harness.stdio.println(interrupted())
  off_interrupt(first)
  const raised = try {
    __signal_raise("SIGINT")
    "not interrupted"
  } catch (e) {
    "interrupted"
  }
  harness.stdio.println(raised)
  on_interrupt(
    { ->
      let spin = 0
      while true {
        spin = spin + 1
      }
    },
    {graceful_timeout_ms: 0},
  )
  const timed_out = try {
    __signal_raise("SIGINT")
    "missed timeout"
  } catch (e) {
    e
  }
  harness.stdio.println(timed_out)
}
