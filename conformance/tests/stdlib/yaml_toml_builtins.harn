pipeline test(harness: Harness, task) {
  const yaml = yaml_parse("name: Ada\nage: 37\n")
  const toml_data = toml_parse("name = \"Ada\"\nage = 37\n")
  harness.stdio.println(yaml.name)
  harness.stdio.println(toml_data.age)
  harness.stdio.println(json_stringify(yaml_parse(yaml_stringify({name: "Ada", age: 37}))))
  harness.stdio.println(json_stringify(toml_parse(toml_stringify({name: "Ada", age: 37}))))
}
