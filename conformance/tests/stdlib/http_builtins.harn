pipeline test(task) {
  // Test error handling: connection refused should throw, caught by try/catch
  try {
    let _r = http_get("http://127.0.0.1:1", {timeout: 100})
    __io_println("unexpected success")
  } catch (e) {
    // Should get a connection error
    __io_println("caught_error")
  }
  // Test http_request exists and validates args
  try {
    let _r = http_request("GET", "", {timeout: 100})
    __io_println("unexpected success")
  } catch (e2) {
    __io_println("caught_empty_url")
  }
  __io_println("http_builtins_ok")
}
