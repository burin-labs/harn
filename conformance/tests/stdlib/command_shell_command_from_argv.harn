import { shell_command_from_argv, shell_command_from_value } from "std/command"

pipeline default(harness: Harness) {
  harness.stdio.println(shell_command_from_argv(["bash", "-lc", "ls -R"]))
  harness.stdio.println(shell_command_from_argv(["bash", "lc", "go test ./..."]))
  harness.stdio.println(shell_command_from_argv(["python", "-c", "print('a b')"]))
  harness.stdio.println(shell_command_from_argv(["echo", ""]))
  harness.stdio.println(shell_command_from_value(["sh", "-c", "printf hi"]))
  harness.stdio.println(shell_command_from_value("  cargo test  "))
  harness.stdio.println(shell_command_from_value({command: "  cargo nextest run  "}))
  harness.stdio.println(shell_command_from_value({command: ["bash", "-lc", "zig build test"]}))
  harness.stdio.println(shell_command_from_value({cmd: ["echo", "two words"]}))
  harness.stdio.println(shell_command_from_value({argv: ["printf", "a b"], command: "ignored"}))
  harness.stdio.println(shell_command_from_value({other: "ignored"}))
}
