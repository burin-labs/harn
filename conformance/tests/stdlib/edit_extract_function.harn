import { edit_extract_function } from "std/edit"

/**
 * End-to-end exercise of `edit_extract_function` over the
 * `code_index.extract_function` builtin: parameters come from the region's
 * free names bound in the enclosing function (so a module-level callee is
 * not one), a dry run writes nothing, Rust without a signature reports the
 * types it needs, and a region outside any function is refused.
 */
fn write_fixture(fs: HarnessFs, dir: string, name: string, body: string) -> string {
  const path = path_join(dir, name)
  fs.write_text(path, body)
  return path
}

pipeline default(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn_edit_extract_function_" + to_string(harness.random.range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  // 1) Python: lines 2-4 of `render` become `prepare(base, qty)`.
  const py_body =
    "def render(harness, base, qty):\n    scaled = base * qty\n    shifted = scaled + qty\n    cache_scaled(scaled, shifted)\n    final = base - qty\n    return final\n"
  const py_path = write_fixture(harness.fs, root, "render.py", py_body)
  const py = edit_extract_function(
    harness.code_index,
    {path: py_path, start_line: 2, end_line: 4, new_name: "prepare"},
  )
  harness.stdio.println(py.result)
  harness.stdio.println(py.applied)
  harness.stdio.println(py.inputs)
  const py_after = harness.fs.read_text(py_path)
  harness.stdio.println(contains(py_after, "    prepare(base, qty)\n    final = base - qty"))
  harness.stdio.println(
    contains(py_after, "\n\n\ndef prepare(base, qty):\n    scaled = base * qty\n"),
  )
  harness.stdio.println(contains(py_after, "    cache_scaled(scaled, shifted)"))
  // 2) TypeScript dry run: the plan comes back and the file is untouched.
  const ts_body =
    "function render(harness, base: number, qty: number) {\n  const scaled = base * qty\n  const shifted = scaled + qty\n  cacheScaled(scaled, shifted)\n  const total = base - qty\n  return total\n}\n"
  const ts_path = write_fixture(harness.fs, root, "render.ts", ts_body)
  const ts = edit_extract_function(
    harness.code_index,
    {path: ts_path, start_line: 2, end_line: 4, new_name: "prepare", dry_run: true},
  )
  harness.stdio.println(ts.result)
  harness.stdio.println(ts.dry_run)
  harness.stdio.println(ts.call)
  harness.stdio.println(starts_with(ts.helper, "function prepare(base, qty) {"))
  harness.stdio.println(harness.fs.read_text(ts_path) == ts_body)
  // 3) Rust needs types: the refusal names the inputs and outputs to type.
  const rs = edit_extract_function(
    harness.code_index,
    {
      path: write_fixture(
        harness.fs,
        root,
        "x.rs",
        "fn f(x: i32) -> i32 {\n    let a = x + 1;\n    a * 2\n}\n",
      ),
      start_line: 2,
      new_name: "g",
    },
  )
  harness.stdio.println(rs.result)
  harness.stdio.println(rs.inputs)
  harness.stdio.println(rs.outputs)
  // 4) A region outside any function is refused.
  const mod_path = write_fixture(harness.fs, root, "mod.py", "x = 1\ny = 2\n")
  const outside = edit_extract_function(
    harness.code_index,
    {path: mod_path, start_line: 1, new_name: "z"},
  )
  harness.stdio.println(outside.result)
  harness.stdio.println(harness.fs.read_text(mod_path) == "x = 1\ny = 2\n")
}
