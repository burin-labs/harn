import { edit_extract_function } from "std/edit"

/**
 * End-to-end exercise of `edit_extract_function` (issue #2520). Verifies
 * capture detection (block free-names minus enclosing-function free-names,
 * so module-level callees are NOT parameterized), function synthesis +
 * placement, and the per-language capability matrix.
 */
fn write_fixture(dir: string, name: string, body: string) -> string {
  const path = path_join(dir, name)
  harness.fs.write_text(path, body)
  return path
}

pipeline default() {
  hostlib_enable("tools:deterministic")
  const root = path_join(
    harness.fs.temp_dir(),
    "harn_edit_extract_function_" + to_string(harness.random.gen_range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  // 1) Python: extract lines 1..3 of `render` into `prepare`. `base`/`qty`
  //    are enclosing params used in the block -> captured. `cache_scaled`
  //    is a module-level free name in both block and enclosing -> NOT a
  //    parameter.
  const py_body = "def render(base, qty):\n    scaled = base * qty\n    shifted = scaled + qty\n    cache_scaled(scaled, shifted)\n    final = base - qty\n    return final\n"
  const py_path = write_fixture(root, "render.py", py_body)
  const py = edit_extract_function({path: py_path, range: {start_line: 1, end_line: 3}, new_name: "prepare"})
  __io_println(py.result)
  __io_println(py.applied)
  const py_after = harness.fs.read_text(py_path)
  __io_println(contains(py_after, "    prepare(base, qty)"))
  __io_println(contains(py_after, "def prepare(base, qty):"))
  __io_println(contains(py_after, "    scaled = base * qty"))
  __io_println(contains(py_after, "    cache_scaled(scaled, shifted)"))
  __io_println(contains(py_after, "    final = base - qty"))
  __io_println(py_after.index_of("def render") < py_after.index_of("def prepare"))
  // 2) TypeScript dry-run: same shape, untyped synthesized params.
  const ts_body = "function render(base: number, qty: number) {\n  const scaled = base * qty\n  const shifted = scaled + qty\n  cacheScaled(scaled, shifted)\n  const total = base - qty\n  return total\n}\n"
  const ts_path = write_fixture(root, "render.ts", ts_body)
  const ts = edit_extract_function(
    {path: ts_path, range: {start_line: 1, end_line: 3}, new_name: "prepare", dry_run: true},
  )
  __io_println(ts.result)
  __io_println(ts.dry_run)
  __io_println(contains(ts.unified_diff[0].diff, "function prepare(base, qty) {"))
  __io_println(contains(ts.unified_diff[0].diff, "prepare(base, qty);"))
  __io_println(harness.fs.read_text(ts_path) == ts_body)
  // 3) Unsupported language (Rust has no capture analysis for this op).
  const rs = edit_extract_function(
    {
      path: write_fixture(root, "x.rs", "fn f() {\n    let a = 1;\n}\n"),
      range: {start_line: 1, end_line: 1},
      new_name: "g",
    },
  )
  __io_println(rs.result)
  // 4) Range not inside a top-level function -> unsupported.
  const mod_path = write_fixture(root, "mod.py", "x = 1\ny = 2\n")
  const outside = edit_extract_function({path: mod_path, range: {start_line: 0, end_line: 0}, new_name: "z"})
  __io_println(outside.result)
  __io_println(outside.errors[0].code)
}
