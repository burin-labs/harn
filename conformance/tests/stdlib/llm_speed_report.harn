import { LlmSpeedUsage, decode_rate, format_speed_line, format_speed_report } from "std/llm/speed"

/**
 * Speed reporting against a realistic llama.cpp `usage` dict: the provider
 * reported its own load, prefill, and generation timings, so every rate must
 * come from those rather than from the caller's wall clock.
 */
fn __served_usage() -> LlmSpeedUsage {
  return {
    input_tokens: 18,
    output_tokens: 143,
    provider_telemetry: {
      source: "llamacpp_timings",
      server_load_ms: 41,
      server_prompt_eval_ms: 62,
      server_prompt_tokens: 18,
      server_generation_ms: 2900,
      server_output_tokens: 143,
      client_wall_ms: 3104,
    },
  }
}

pipeline default(harness: Harness) {
  const served = __served_usage()
  harness.stdio.println(format_speed_line(served, 210, 3104))
  for line in format_speed_report(served, 210, 3104) {
    harness.stdio.println(line)
  }
  harness.stdio.println("---")
  // A provider that reported token counts but no timings: the decode rate
  // falls back to wall time, and every server-timing line disappears rather
  // than printing zeros.
  const untimed: LlmSpeedUsage = {input_tokens: 18, output_tokens: 100}
  harness.stdio.println(format_speed_line(untimed, nil, 2000))
  for line in format_speed_report(untimed, nil, 2000) {
    harness.stdio.println(line)
  }
  harness.stdio.println("---")
  // A streamed call with no server timings: the meter's decode rate wins over
  // wall time, which would include the 1.2s wait for the first token.
  const metered: LlmSpeedUsage = {
    input_tokens: 18,
    output_tokens: 100,
    provider_telemetry: {
      inference_speed: {time_to_first_token_ms: 1200, output_tokens_per_second: 125.0},
    },
  }
  harness.stdio.println(format_speed_line(metered, 1200, 2000))
  harness.stdio.println("---")
  // Nothing reported at all: no rate, no counts, just the wall clock.
  const unreported: LlmSpeedUsage = {}
  harness.stdio.println(format_speed_line(unreported, nil, 850))
  for line in format_speed_report(unreported, nil, 850) {
    harness.stdio.println(line)
  }
  assert_eq(
    decode_rate({output_tokens: 10, provider_telemetry: {server_generation_ms: 1000}}, 2000),
    "10.0 tok/s",
  )
  assert_eq(decode_rate({provider_telemetry: {server_generation_ms: 1000}}, 2000), nil)
  assert_eq(
    decode_rate({output_tokens: 0, provider_telemetry: {server_generation_ms: 1000}}, 2000),
    nil,
  )
  const duration_only = format_speed_report(
    {provider_telemetry: {server_prompt_eval_ms: 1000}},
    nil,
    2000,
  )
  assert(!duration_only.any({ line -> line.contains("prompt eval rate:") }))
  const zero_count = format_speed_report({output_tokens: 0}, nil, 1000)
  assert(zero_count.any({ line -> line.contains("eval count:") && line.contains("0 token(s)") }))
}
