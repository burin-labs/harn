import { format_speed_line, format_speed_report } from "std/llm/speed"

/**
 * Speed reporting against a realistic llama.cpp `usage` dict: the provider
 * reported its own load, prefill, and generation timings, so every rate must
 * come from those rather than from the caller's wall clock.
 */
fn __served_usage() -> dict {
  return {
    input_tokens: 18,
    output_tokens: 143,
    provider_telemetry: {
      source: "llamacpp_timings",
      server_load_ms: 41,
      server_prompt_eval_ms: 62,
      server_prompt_tokens: 18,
      server_generation_ms: 2900,
      server_output_tokens: 143,
      client_wall_ms: 3104,
    },
  }
}

pipeline default(harness: Harness) {
  const served = __served_usage()
  harness.stdio.println(format_speed_line(served, 210, 3104))
  for line in format_speed_report(served, 210, 3104) {
    harness.stdio.println(line)
  }
  harness.stdio.println("---")
  // A provider that reported token counts but no timings: the decode rate
  // falls back to wall time, and every server-timing line disappears rather
  // than printing zeros.
  const untimed = {input_tokens: 18, output_tokens: 100}
  harness.stdio.println(format_speed_line(untimed, nil, 2000))
  for line in format_speed_report(untimed, nil, 2000) {
    harness.stdio.println(line)
  }
  harness.stdio.println("---")
  // Nothing reported at all: no rate, no counts, just the wall clock.
  harness.stdio.println(format_speed_line({}, nil, 850))
  for line in format_speed_report({}, nil, 850) {
    harness.stdio.println(line)
  }
}
