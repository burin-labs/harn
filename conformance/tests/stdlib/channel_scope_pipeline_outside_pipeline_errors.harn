/**
 * CH-03 (#1874): emitting a `pipeline:`-scoped channel outside any pipeline
 * context returns HARN-CHN-001. The `pipeline default()` body itself does
 * not establish a pipeline runtime overlay (only orchestrator workflows do),
 * so this is the conformance signal for the missing-context guard.
 */
pipeline default() {
  let pipeline_emit = try {
    emit_channel("pipeline:stage.done", {n: 1}, {id: "outside-pipeline"})
  }
  __io_println(is_err(pipeline_emit))
  __io_println(contains(to_string(unwrap_err(pipeline_emit)), "HARN-CHN-001"))
}
