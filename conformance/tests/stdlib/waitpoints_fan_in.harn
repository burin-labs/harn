import "std/waitpoints"

pipeline test(task) {
  const id = "fan-in-" + uuid()
  waitpoint_create(id)
  const completed = atomic(0)
  const w1 = spawn {
    let result = waitpoint_wait(id, {wait_id: id + "-1"})
    if result.status == "completed" {
      atomic_add(completed, 1)
    }
  }
  const w2 = spawn {
    let result = waitpoint_wait(id, {wait_id: id + "-2"})
    if result.status == "completed" {
      atomic_add(completed, 1)
    }
  }
  const w3 = spawn {
    let result = waitpoint_wait(id, {wait_id: id + "-3"})
    if result.status == "completed" {
      atomic_add(completed, 1)
    }
  }
  const w4 = spawn {
    let result = waitpoint_wait(id, {wait_id: id + "-4"})
    if result.status == "completed" {
      atomic_add(completed, 1)
    }
  }
  const w5 = spawn {
    let result = waitpoint_wait(id, {wait_id: id + "-5"})
    if result.status == "completed" {
      atomic_add(completed, 1)
    }
  }
  const signal = waitpoint_complete(id)
  await(w1)
  await(w2)
  await(w3)
  await(w4)
  await(w5)
  __io_println(signal.status == "completed")
  __io_println(atomic_get(completed) == 5)
}
