import "std/waitpoint"

pipeline test(harness: Harness, task: unknown) {
  const id = "fan-in-" + harness.random.uuid()
  harness.runtime.waitpoint_create(id)
  const completed = harness.runtime.atomic(0)
  const w1 = spawn {
    let result = harness.runtime.waitpoint_wait(id, {wait_id: id + "-1"})
    if result.status == "completed" {
      harness.runtime.atomic_add(completed, 1)
    }
  }
  const w2 = spawn {
    let result = harness.runtime.waitpoint_wait(id, {wait_id: id + "-2"})
    if result.status == "completed" {
      harness.runtime.atomic_add(completed, 1)
    }
  }
  const w3 = spawn {
    let result = harness.runtime.waitpoint_wait(id, {wait_id: id + "-3"})
    if result.status == "completed" {
      harness.runtime.atomic_add(completed, 1)
    }
  }
  const w4 = spawn {
    let result = harness.runtime.waitpoint_wait(id, {wait_id: id + "-4"})
    if result.status == "completed" {
      harness.runtime.atomic_add(completed, 1)
    }
  }
  const w5 = spawn {
    let result = harness.runtime.waitpoint_wait(id, {wait_id: id + "-5"})
    if result.status == "completed" {
      harness.runtime.atomic_add(completed, 1)
    }
  }
  const signal = harness.runtime.waitpoint_complete(id)
  await(w1)
  await(w2)
  await(w3)
  await(w4)
  await(w5)
  harness.stdio.println(signal.status == "completed")
  harness.stdio.println(harness.runtime.atomic_get(completed) == 5)
}
