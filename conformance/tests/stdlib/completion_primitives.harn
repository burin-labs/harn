import {
  completion_context,
  completion_decision_event,
  completion_policy,
  completion_policy_decision,
  completion_proposal,
  completion_shown_event,
  completion_trust_record,
  completion_usage_record,
} from "std/agent/completions"

pipeline test(harness: Harness, task) {
  const context = completion_context(
    {
      surface: "editor",
      file_path: "Sources/App.swift",
      language: "Swift",
      stack: ["swift", "swiftui"],
      trigger_kind: "automatic",
      cursor_offset: 42,
      prefix: "let name = user.",
      suffix: "\nprint(name)",
      symbols: [{name: "user", kind: "variable"}],
      diagnostics: [],
      codebase_context: [{path: "Sources/User.swift", text: "struct User { let name: String }"}],
    },
  )
  const policy = completion_policy(
    {
      disabled_languages: ["markdown"],
      allowed_providers: ["ollama"],
      allow_remote_models: false,
      prompt_recording: "metadata",
    },
  )
  const allowed = completion_policy_decision(
    context,
    {provider: "ollama", model_id: "qwen"},
    policy,
  )
  const blocked = completion_policy_decision(context, {provider: "openai", model_id: "gpt"}, policy)
  const camel_policy = completion_policy(
    {
      allowedProviders: ["ollama"],
      allowRemoteModels: false,
      promptRecording: "off",
      maxPromptChars: 12,
    },
  )
  const camel_blocked = completion_policy_decision(
    context,
    {provider: "openai", modelID: "gpt"},
    camel_policy,
  )
  const proposal = completion_proposal(
    {
      kind: "inline_replace",
      provider: "ollama",
      model_id: "qwen",
      suggestion: "name",
      replacement_range: {location: 42, length: 0},
    },
  )
  const shown = completion_shown_event(
    harness.clock,
    proposal,
    context,
    {input_tokens: 100, output_tokens: 4, cost_usd: 0.0},
    {record_id: "rec-1", session_id: "session-1", prompt: "private prompt", policy: policy},
  )
  const decision = completion_decision_event(
    harness.clock,
    shown,
    "accepted",
    {decision_latency_ms: 120},
  )
  const trust = completion_trust_record(harness.clock, harness.random, decision)
  const usage = completion_usage_record(shown, {recorded_at_ms: 12345})
  harness.stdio.log(context.schema)
  harness.stdio.log(context.language)
  harness.stdio.log(policy.prompt_recording)
  harness.stdio.log(allowed.allowed)
  harness.stdio.log(blocked.reason_code)
  harness.stdio.log(camel_policy.prompt_recording)
  harness.stdio.log(camel_blocked.reason_code)
  harness.stdio.log(proposal.kind)
  harness.stdio.log(starts_with(shown.context_hash, "sha256:"))
  harness.stdio.log(shown.prompt == nil)
  harness.stdio.log(starts_with(shown.prompt_hash, "sha256:"))
  harness.stdio.log(decision.accepted)
  harness.stdio.log(trust.actor_id)
  harness.stdio.log(trust.outcome)
  harness.stdio.log(usage.surface)
  harness.stdio.log(usage.input_tokens)
}
