import { triage_emit, triage_normalize, triage_start_my_day } from "std/triage"

fn fixture(name) {
  let root = project_root() ?? cwd()
  return json_parse(read_file(path_join(root, "examples/triage/fixtures/" + name + ".json")))
}

pipeline default() {
  let github = fixture("github_issue")
  let slack = fixture("slack_message")
  let notion = fixture("notion_page")
  let github_retry = github
    + {
    dedupe_key: "github-delivery-1507-retry",
    provider_payload: github.provider_payload + {delivery_id: "github-delivery-1507-retry"},
  }
  let github_event = triage_normalize(github)
  let slack_event = triage_normalize(slack)
  let notion_event = triage_normalize(notion)
  let github_retry_event = triage_normalize(github_retry)
  println(github_event.schema)
  println(github_event.provider + ":" + github_event.source_kind)
  println(slack_event.source_url.starts_with("slack://channel"))
  println(notion_event.source_url.starts_with("https://www.notion.so/"))
  println(github_event.dedupe_key == github_retry_event.dedupe_key)
  println(github_event.id == github_retry_event.id)
  println(github_event.raw_payload.issue.title)
  println(
    github_event.action_intents.find({ intent -> intent.kind == "convert_to_task" }).requires_approval,
  )
  let missing_source = try {
    triage_normalize(
      {provider: "slack", kind: "message", provider_payload: {provider: "slack", event: "message"}},
    )
  }
  println(is_err(missing_source))
  let ungated_write = try {
    triage_normalize(
      github,
      {
        action_intents: [
          {
            kind: "convert_to_task",
            label: "Convert to task",
            target: {},
            effect: "host_task_write",
            requires_approval: false,
          },
        ],
      },
    )
  }
  println(is_err(ungated_write))
  let feed = triage_start_my_day(
    [github, slack, notion, github_retry],
    {emit: true, topic: "triage.inbox.test", generated_at: "fixture"},
  )
  println(len(feed.events))
  println(len(feed.receipts))
  let receipt = triage_emit(github_event, {topic: "triage.inbox.test.single"})
  let stream = event_log.subscribe({topic: "triage.inbox.test.single", from_cursor: receipt.event_log_id - 1})
  let logged = stream.next().value
  println(logged.kind)
  println(logged.payload.provider)
  println(logged.headers.schema)
}
