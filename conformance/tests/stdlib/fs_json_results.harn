import {
  read_json,
  read_json_result,
  read_json_typed,
  read_json_typed_result,
  write_json,
} from "std/fs"
import "std/schema"

type User = {name: string, role?: string}

pipeline default(task) {
  const root = path_join(harness.fs.temp_dir(), "harn-fs-json-results-" + uuid_v7())
  harness.fs.mkdir(root)
  const object_path = path_join(root, "object.json")
  write_json(object_path, {})
  __io_println(type_of(read_json(object_path)))
  const array_path = path_join(root, "array.json")
  harness.fs.write_text(array_path, "[1,2,3]")
  __io_println(len(unwrap(read_json_result(array_path))))
  const scalar_path = path_join(root, "scalar.json")
  harness.fs.write_text(scalar_path, "\"hello\"")
  __io_println(unwrap(read_json_result(scalar_path)))
  const number_path = path_join(root, "number.json")
  harness.fs.write_text(number_path, "42")
  __io_println(unwrap(read_json_result(number_path)))
  const bool_path = path_join(root, "bool.json")
  harness.fs.write_text(bool_path, "true")
  __io_println(unwrap(read_json_result(bool_path)))
  const null_path = path_join(root, "null.json")
  harness.fs.write_text(null_path, "null")
  const null_result = read_json_result(null_path)
  __io_println(is_ok(null_result))
  __io_println(unwrap(null_result) == nil)
  const absent = read_json_result(path_join(root, "missing.json"))
  __io_println(unwrap_err(absent).kind)
  const required_absent = try {
    read_json(path_join(root, "missing.json"))
  }
  __io_println(unwrap_err(required_absent).kind)
  const directory = read_json_result(root)
  __io_println(unwrap_err(directory).kind)
  const malformed_path = path_join(root, "malformed.json")
  harness.fs.write_text(malformed_path, "{bad")
  const malformed = unwrap_err(read_json_result(malformed_path))
  __io_println(malformed.kind)
  __io_println(malformed.line > 0 && malformed.column > 0)
  const depth_127_path = path_join(root, "depth-127.json")
  harness.fs.write_text(depth_127_path, "[".repeat(127) + "0" + "]".repeat(127))
  __io_println(is_ok(read_json_result(depth_127_path)))
  const depth_128_path = path_join(root, "depth-128.json")
  harness.fs.write_text(depth_128_path, "[".repeat(128) + "0" + "]".repeat(128))
  const too_deep = unwrap_err(read_json_result(depth_128_path))
  __io_println(too_deep.kind)
  __io_println(too_deep.line > 0 && too_deep.column > 0)
  const deep_malformed_path = path_join(root, "deep-malformed.json")
  harness.fs
    .write_text(deep_malformed_path, "[".repeat(128) + "x" + "]".repeat(128))
  const deep_malformed = unwrap_err(read_json_result(deep_malformed_path))
  __io_println(deep_malformed.kind)
  const typed_path = path_join(root, "typed.json")
  harness.fs.write_text(typed_path, "{\"name\":\"Ada\"}")
  const user_schema = schema_closed_object(
    {name: schema_field(schema_string()), role: schema_default(schema_string(), "user")},
  )
  const typed = read_json_typed_result(typed_path, user_schema, true)
  __io_println(unwrap(typed).name)
  __io_println(unwrap(typed).role)
  const invalid_path = path_join(root, "invalid.json")
  harness.fs.write_text(invalid_path, "{\"name\":42}")
  const invalid = unwrap_err(read_json_typed_result(invalid_path, schema_of(User)))
  __io_println(invalid.kind)
  __io_println(len(invalid.issues) > 0)
  const required_invalid = try {
    read_json_typed(invalid_path, schema_of(User))
  }
  __io_println(unwrap_err(required_invalid).kind)
  harness.fs.delete(root)
}
