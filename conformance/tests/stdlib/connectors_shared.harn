import {
  git_forge_pull_request_event,
  git_forge_pull_request_topic,
  git_forge_writeback_request,
  oauth2_token_refresh,
  paginate_cursor,
  rate_limit_token_bucket,
  verify_hmac_signature,
  verify_jwt,
} from "std/connectors/shared"

pipeline test(task) {
  let signature = "sha256=" + hmac_sha256("secret", "payload")
  __io_println(verify_hmac_signature("payload", signature, "secret", "sha256"))
  __io_println(verify_hmac_signature("payload", signature, "wrong", "sha256"))
  let legacy_signature = "sha1=" + hmac_sha1("secret", "payload")
  __io_println(verify_hmac_signature("payload", legacy_signature, "secret", "sha1"))
  __io_println(
    verify_hmac_signature("payload", legacy_signature, "secret", "sha1", {allow_legacy_sha1: true}),
  )
  let root = project_root() ?? cwd()
  let private_key = harness.fs.read_text(path_join(root, "conformance/helpers/github_app_test_key.pem"))
  let token = jwt_sign("RS256", {iss: "issuer", aud: "audience", exp: 4102444800}, private_key)
  let jwt_result = verify_jwt(
    token,
    nil,
    {
      issuer: "issuer",
      audience: "audience",
      inline_jwks: {
        keys: [
          {
            kty: "RSA",
            n: "-g_nRee8veA57dDDv-MV0XO3YcFwdhBjZ4Md5Z_V6WpoSRLQRydJ_PXKdOO4Nlv519ugR5RIxYeyqc3kc1gEYTS_ct_TOLEXR8j9vDvOXQRJWkwAJOdtAFxYSxxdr_PuKSUg7O_LaEiaEXxTVpn3hWLBcwJOMvIJ6HGCZYf9WJBjxKFpb7A5arSZbxNJqfLDauQYot_bThGdhEBpVhYBvr6olX5EOONL6h2zAK1n7mT0-zOxCsKh2vO5LRUGKnsfb074Z7fuzbRNsaY8Q1vk75vvNKupd6wYjgbzaLJY7l9GEdWsK_cQrcmyBno9yWvjU-JpEzURJvcRO62Rj6lGew",
            e: "AQAB",
          },
        ],
      },
    },
  )
  __io_println(jwt_result.ok)
  __io_println(jwt_result.claims.iss)
  let config = {capacity: 1, refill_tokens: 1, refill_interval_ms: 1000}
  let first = rate_limit_token_bucket(nil, config, 1000)
  let second = rate_limit_token_bucket(first.state, config, 1000)
  let third = rate_limit_token_bucket(second.state, config, 2000)
  __io_println(first.allowed)
  __io_println(second.allowed)
  __io_println(second.retry_after_ms)
  __io_println(third.allowed)
  let pages = [{results: [{id: "a"}], next_cursor: "page-2"}, {results: [{id: "b"}], next_cursor: nil}]
  let paged = paginate_cursor(
    "https://api.example/items",
    { _url, cursor ->
      if cursor == nil {
        return pages[0]
      }
      return pages[1]
    },
    "/next_cursor",
  )
  __io_println(len(paged.items))
  __io_println(paged.items[1].id)
  __io_println(paged.complete)
  let github_forge = unwrap(
    git_forge_pull_request_event(
      "github",
      {
        action: "closed",
        repository: {full_name: "octo-org/octo-repo", id: 99, html_url: "https://github.com/octo-org/octo-repo"},
        pull_request: {
          number: 17,
          title: "Preview me",
          merged: true,
          html_url: "https://github.com/octo-org/octo-repo/pull/17",
          user: {login: "mona"},
          head: {ref: "feature/preview", sha: "abc123"},
          base: {ref: "main", sha: "def456"},
        },
      },
    ),
  )
  __io_println(github_forge.topic == git_forge_pull_request_topic())
  __io_println(github_forge.lifecycle)
  __io_println(github_forge.repository.full_name)
  __io_println(github_forge.pull_request.head_ref)
  let github_writeback = git_forge_writeback_request(github_forge, "Preview ready")
  __io_println(github_writeback.method)
  __io_println(github_writeback.params.owner + "/" + github_writeback.params.repo)
  __io_println(github_writeback.params.issue_number)
  let gitlab_forge = unwrap(
    git_forge_pull_request_event(
      "gitlab",
      {
        object_kind: "merge_request",
        user: {username: "alex"},
        project: {id: 42, path_with_namespace: "group/project", web_url: "https://gitlab.example/group/project"},
        object_attributes: {
          iid: 9,
          action: "update",
          title: "Preview me",
          source_branch: "preview",
          target_branch: "main",
          last_commit: {id: "feedface"},
          url: "https://gitlab.example/group/project/-/merge_requests/9",
        },
      },
    ),
  )
  __io_println(gitlab_forge.lifecycle)
  __io_println(gitlab_forge.repository.full_name)
  __io_println(gitlab_forge.pull_request.number)
  let gitea_forge = unwrap(
    git_forge_pull_request_event(
      "gitea",
      {
        action: "closed",
        repository: {full_name: "team/repo", id: 7, html_url: "https://gitea.example/team/repo"},
        pull_request: {
          number: 3,
          merged: false,
          html_url: "https://gitea.example/team/repo/pulls/3",
          user: "sam",
          head: {ref: "preview", sha: "aaaa"},
          base: {ref: "main", sha: "bbbb"},
        },
      },
    ),
  )
  __io_println(gitea_forge.lifecycle)
  __io_println(gitea_forge.writeback.provider)
  assert_eq(gitea_forge.pull_request.author, "sam", "forge author string")
  http_mock(
    "POST",
    "https://auth.example/token",
    {status: 200, body: "{\"access_token\":\"new-token\",\"expires_in\":3600}", headers: {}},
  )
  let refreshed = oauth2_token_refresh("client-id", "client-secret", "refresh-token", "https://auth.example/token")
  __io_println(refreshed.ok)
  __io_println(refreshed.access_token)
  let calls = http_mock_calls({include_sensitive: true})
  __io_println(contains(calls[0].body, "grant_type=refresh_token"))
  __io_println(calls[0].headers["content-type"])
}
