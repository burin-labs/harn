import {
  connector_http_header,
  connector_http_json,
  connector_http_rate_limit,
  connector_http_request,
  git_forge_pull_request_event,
  git_forge_pull_request_topic,
  git_forge_writeback_request,
  oauth2_token_refresh,
  paginate_cursor,
  rate_limit_token_bucket,
  verify_hmac_signature,
  verify_jwt,
} from "std/connectors/shared"

pipeline test(harness: Harness, task) {
  const signature = "sha256=" + hmac_sha256("secret", "payload")
  harness.stdio.println(verify_hmac_signature("payload", signature, "secret", "sha256"))
  harness.stdio.println(verify_hmac_signature("payload", signature, "wrong", "sha256"))
  const legacy_signature = "sha1=" + hmac_sha1("secret", "payload")
  harness.stdio.println(verify_hmac_signature("payload", legacy_signature, "secret", "sha1"))
  harness.stdio.println(
    verify_hmac_signature("payload", legacy_signature, "secret", "sha1", {allow_legacy_sha1: true}),
  )
  const root = harness.fs.workspace_root()
  const shared_source = harness.fs.read_text(
    path_join(root, "crates/harn-stdlib/src/stdlib/stdlib_connectors_shared.harn"),
  )
  assert_eq(
    contains(shared_source, "pub fn connector_http_"),
    false,
    "shared projects connector HTTP policy instead of duplicating it",
  )
  const private_key = harness.fs.read_text(
    path_join(root, "conformance/helpers/github_app_test_key.pem"),
  )
  const token = jwt_sign("RS256", {iss: "issuer", aud: "audience", exp: 4102444800}, private_key)
  const jwt_result = verify_jwt(
    harness.net,
    token,
    nil,
    {
      issuer: "issuer",
      audience: "audience",
      inline_jwks: {
        keys: [
          {
            kty: "RSA",
            n:
              "nDJTSIZrbYjwjjX4HHUU-1naXuPQ_65e1mJzk1xt3zKXU9Qt-A0cfj5riE-TDGRE7vBR_9yqMspg2b1ihUx-r2AqufRxUMMW7eNECTvR4JycbIAyTUkREzjMD-3mXpVy8sKcuwvpQraDMgPZ9MPGI2aphKKk0ADzXbDHyvXP-7BcytJrSfDI5la9FksDknpP6e6PW4NaFfqFtoiovclVx_xoxm0nSsWFZa87mW_EIgqp9lneJQruGl6txmzXFSRrjCip9TkRhXNPsCMgqdKakAbcZdzZQEnjbVpnogg0gYenkwCzcWd_8MhMWkzU7Dtndbey4MfUPqAP3EPaq3e7dw",
            e: "AQAB",
          },
        ],
      },
    },
  )
  harness.stdio.println(jwt_result.ok)
  harness.stdio.println(jwt_result.claims.iss)
  const config = {capacity: 1, refill_tokens: 1, refill_interval_ms: 1000}
  const first = rate_limit_token_bucket(harness.clock, nil, config, 1000)
  const second = rate_limit_token_bucket(harness.clock, first.state, config, 1000)
  const third = rate_limit_token_bucket(harness.clock, second.state, config, 2000)
  harness.stdio.println(first.allowed)
  harness.stdio.println(second.allowed)
  harness.stdio.println(second.retry_after_ms)
  harness.stdio.println(third.allowed)
  const pages = [
    {results: [{id: "a"}], next_cursor: "page-2"},
    {results: [{id: "b"}], next_cursor: nil},
  ]
  const paged = paginate_cursor(
    "https://api.example/items",
    { _url, cursor ->
      if cursor == nil {
        return pages[0]
      }
      return pages[1]
    },
    "/next_cursor",
  )
  harness.stdio.println(len(paged.items))
  harness.stdio.println(paged.items[1].id)
  harness.stdio.println(paged.complete)
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/shared/request-compat",
    {status: 204, body: "", headers: {"X-Compat": "shared"}},
  )
  const shared_request = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/shared/request-compat",
  )
  assert_eq(shared_request.ok, true, "shared re-export request succeeds")
  assert_eq(
    connector_http_header(shared_request, "x-compat"),
    "shared",
    "shared re-export header lookup is case insensitive",
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/shared/json-compat",
    {status: 200, body: "{\"ok\":true}", headers: {"Retry-After": "2"}},
  )
  const shared_json = connector_http_json(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/shared/json-compat",
  )
  assert_eq(shared_json.json.ok, true, "shared re-export parses JSON")
  assert_eq(
    connector_http_rate_limit(harness.clock, shared_json).retry_after_ms,
    2000,
    "shared re-export exposes rate-limit metadata",
  )
  const github_forge = unwrap(
    git_forge_pull_request_event(
      "github",
      {
        action: "closed",
        repository: {
          full_name: "octo-org/octo-repo",
          id: 99,
          html_url: "https://github.com/octo-org/octo-repo",
        },
        pull_request: {
          number: 17,
          title: "Preview me",
          merged: true,
          html_url: "https://github.com/octo-org/octo-repo/pull/17",
          user: {login: "mona"},
          head: {ref: "feature/preview", sha: "abc123"},
          base: {ref: "main", sha: "def456"},
        },
      },
    ),
  )
  harness.stdio.println(github_forge.topic == git_forge_pull_request_topic())
  harness.stdio.println(github_forge.lifecycle)
  harness.stdio.println(github_forge.repository.full_name)
  harness.stdio.println(github_forge.pull_request.head_ref)
  const github_writeback = git_forge_writeback_request(github_forge, "Preview ready")
  harness.stdio.println(github_writeback.method)
  harness.stdio.println(github_writeback.params.owner + "/" + github_writeback.params.repo)
  harness.stdio.println(github_writeback.params.issue_number)
  const gitlab_forge = unwrap(
    git_forge_pull_request_event(
      "gitlab",
      {
        object_kind: "merge_request",
        user: {username: "alex"},
        project: {
          id: 42,
          path_with_namespace: "group/project",
          web_url: "https://gitlab.example/group/project",
        },
        object_attributes: {
          iid: 9,
          action: "update",
          title: "Preview me",
          source_branch: "preview",
          target_branch: "main",
          last_commit: {id: "feedface"},
          url: "https://gitlab.example/group/project/-/merge_requests/9",
        },
      },
    ),
  )
  harness.stdio.println(gitlab_forge.lifecycle)
  harness.stdio.println(gitlab_forge.repository.full_name)
  harness.stdio.println(gitlab_forge.pull_request.number)
  const gitea_forge = unwrap(
    git_forge_pull_request_event(
      "gitea",
      {
        action: "closed",
        repository: {full_name: "team/repo", id: 7, html_url: "https://gitea.example/team/repo"},
        pull_request: {
          number: 3,
          merged: false,
          html_url: "https://gitea.example/team/repo/pulls/3",
          user: "sam",
          head: {ref: "preview", sha: "aaaa"},
          base: {ref: "main", sha: "bbbb"},
        },
      },
    ),
  )
  harness.stdio.println(gitea_forge.lifecycle)
  harness.stdio.println(gitea_forge.writeback.provider)
  assert_eq(gitea_forge.pull_request.author, "sam", "forge author string")
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    "https://auth.example/token",
    {status: 200, body: "{\"access_token\":\"new-token\",\"expires_in\":3600}", headers: {}},
  )
  const refreshed = oauth2_token_refresh(
    harness.net,
    "client-id",
    "client-secret",
    "refresh-token",
    "https://auth.example/token",
  )
  harness.stdio.println(refreshed.ok)
  harness.stdio.println(refreshed.access_token)
  const calls = harness.testing.http_mock_calls({include_sensitive: true})
  harness.stdio.println(contains(calls[0].body, "grant_type=refresh_token"))
  harness.stdio.println(calls[0].headers["content-type"])
}
