import { stream_validate_chunk, stream_validate_create } from "std/json"

pipeline default(harness: Harness, task: unknown) {
  const validator = stream_validate_create(
    harness.runtime,
    {type: "dict", required: ["age"], properties: {age: {type: "int"}}},
  )
  const r1 = stream_validate_chunk(validator, "{\"age\":\"")
  harness.stdio.println(r1.verdict)
  harness.stdio.println(r1.path)
  harness.stdio.println(starts_with(r1.reason, "expected type 'int'"))
}
