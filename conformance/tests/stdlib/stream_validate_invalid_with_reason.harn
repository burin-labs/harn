import { stream_validate_chunk, stream_validate_create } from "std/json"

pipeline default(task) {
  let validator = stream_validate_create({type: "dict", required: ["age"], properties: {age: {type: "int"}}})
  let r1 = stream_validate_chunk(validator, "{\"age\":\"")
  __io_println(r1.verdict)
  __io_println(r1.path)
  __io_println(starts_with(r1.reason, "expected type 'int'"))
}
