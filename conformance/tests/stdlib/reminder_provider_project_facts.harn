import { store_fact } from "std/agent/fact"
import {
  agent_reminder_providers_fire,
  agent_session_apply_reminder_post_turn,
} from "std/agent/state"

pipeline default(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "harn-reminder-project-facts-" + harness.random.uuid())
  const namespace = "project/facts"
  const store_opts = {root: root, namespace: namespace}
  store_fact(harness,  harness, harness.memory, {
      kind: "Decision",
      claim: "Memory module reuses the BM25 scorer for fact recall",
      confidence: 0.91,
      evidence: [{kind: "FileRange", ref: "crates/harn-vm/src/stdlib/memory.rs:688"}],
    },
    store_opts + {now: "2026-05-23T10:00:00Z"},
  )
  store_fact(harness,  harness, harness.memory, {
      kind: "Constraint",
      claim: "Project facts reminder runs synchronously inside the provider",
      confidence: 0.74,
      evidence: [{kind: "FileRange", ref: "crates/harn-vm/src/llm/reminder_providers.rs:1"}],
    },
    store_opts + {now: "2026-05-23T10:00:01Z"},
  )
  store_fact(harness,  harness, harness.memory, {
      kind: "Hypothesis",
      claim: "Low-confidence facts should not auto-inject",
      confidence: 0.2,
      evidence: [{kind: "ToolOutput", ref: "tool:guess"}],
    },
    store_opts + {now: "2026-05-23T10:00:02Z"},
  )
  const provider_opts = {
    reminders: {
      config: {
        project_facts: {root: root, namespace: namespace, max_facts: 5, min_confidence: 0.5},
      },
    },
  }
  const session = harness.agent.open("reminder-provider-project-facts")
  harness.agent.reset(session)
  const first = agent_reminder_providers_fire(harness, session,
    "session_start",
    {session: {id: session}, task: "project facts recall", iteration: 1},
    provider_opts,
  )
  harness.stdio.println(first.fired_count)
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  harness.stdio.println(len(reminders))
  const reminder = reminders[0].reminder
  harness.stdio.println(reminder.tags[0])
  harness.stdio.println(reminder.dedupe_key)
  harness.stdio.println(reminder.ttl_turns)
  harness.stdio.println(reminder.preserve_on_compact)
  harness.stdio.println(reminder.propagate)
  harness.stdio.println(reminder.source)
  harness.stdio.println(reminder.role_hint)
  harness.stdio.println(contains(reminder.body, "Memory module reuses the BM25 scorer for fact recall"))
  harness.stdio.println(
    contains(reminder.body, "Project facts reminder runs synchronously inside the provider"),
  )
  harness.stdio.println(contains(reminder.body, "Low-confidence facts"))
  harness.stdio.println(contains(reminder.body, "decision"))
  harness.stdio.println(contains(reminder.body, "confidence 0.91"))
  const refresh_opts = provider_opts
    + {
    reminders: provider_opts.reminders + {providers: ["-token_pressure"]},
  }
  const below_refresh = agent_reminder_providers_fire(harness, session,
    "on_budget_threshold",
    {
      session: {id: session},
      task: "project facts recall",
      tokens_used: 50,
      context_window: 100,
      iteration: 2,
    },
    refresh_opts,
  )
  harness.stdio.println(below_refresh.fired_count)
  const refresh = agent_reminder_providers_fire(harness, session,
    "on_budget_threshold",
    {
      session: {id: session},
      task: "project facts recall",
      tokens_used: 80,
      context_window: 100,
      iteration: 3,
    },
    refresh_opts,
  )
  harness.stdio.println(refresh.fired_count)
  harness.stdio.println(refresh.reports[0].deduped_count)
  harness.stdio.println(refresh.reports[0].provider)
  const post_turn = agent_session_apply_reminder_post_turn(harness, session, 3)
  const after_post = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  harness.stdio.println(post_turn.expired_count)
  harness.stdio.println(len(after_post))
  const kind_session = harness.agent.open("reminder-provider-project-facts-kind")
  harness.agent.reset(kind_session)
  const kind_only = agent_reminder_providers_fire(harness, kind_session,
    "session_start",
    {session: {id: kind_session}, task: "constraints only"},
    {
      reminders: {
        config: {
          project_facts: {
            root: root,
            namespace: namespace,
            max_facts: 5,
            min_confidence: 0.0,
            kind_filter: ["constraint"],
          },
        },
      },
    },
  )
  harness.stdio.println(kind_only.fired_count)
  const kind_reminder = transcript_events_by_kind(
    harness.agent.snapshot(kind_session),
    "system_reminder",
  )[0].reminder
  harness.stdio.println(contains(kind_reminder.body, "Project facts reminder runs synchronously"))
  harness.stdio.println(contains(kind_reminder.body, "Memory module reuses the BM25 scorer"))
  const disabled_session = harness.agent.open("reminder-provider-project-facts-disabled")
  harness.agent.reset(disabled_session)
  const disabled = agent_reminder_providers_fire(harness, disabled_session,
    "session_start",
    {session: {id: disabled_session}, task: "irrelevant"},
    {
      reminders: {
        providers: ["-project_facts"],
        config: {project_facts: {root: root, namespace: namespace}},
      },
    },
  )
  harness.stdio.println(disabled.fired_count)
  const empty_root = path_join(harness.fs.temp_dir(), "harn-reminder-project-facts-empty-" + harness.random.uuid())
  const empty_session = harness.agent.open("reminder-provider-project-facts-empty")
  harness.agent.reset(empty_session)
  const empty = agent_reminder_providers_fire(harness, empty_session,
    "session_start",
    {session: {id: empty_session}, task: "no facts yet"},
    {reminders: {config: {project_facts: {root: empty_root, namespace: namespace}}}},
  )
  harness.stdio.println(empty.fired_count)
  harness.fs.delete(root)
}
