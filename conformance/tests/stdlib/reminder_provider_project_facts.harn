import { store_fact } from "std/agent/fact"
import {
  agent_reminder_providers_fire,
  agent_session_apply_reminder_post_turn,
} from "std/agent/state"

pipeline default() {
  const root = path_join(harness.fs.temp_dir(), "harn-reminder-project-facts-" + uuid())
  const namespace = "project/facts"
  const store_opts = {root: root, namespace: namespace}
  store_fact(
    {
      kind: "Decision",
      claim: "Memory module reuses the BM25 scorer for fact recall",
      confidence: 0.91,
      evidence: [{kind: "FileRange", ref: "crates/harn-vm/src/stdlib/memory.rs:688"}],
    },
    store_opts + {now: "2026-05-23T10:00:00Z"},
  )
  store_fact(
    {
      kind: "Constraint",
      claim: "Project facts reminder runs synchronously inside the provider",
      confidence: 0.74,
      evidence: [{kind: "FileRange", ref: "crates/harn-vm/src/llm/reminder_providers.rs:1"}],
    },
    store_opts + {now: "2026-05-23T10:00:01Z"},
  )
  store_fact(
    {
      kind: "Hypothesis",
      claim: "Low-confidence facts should not auto-inject",
      confidence: 0.2,
      evidence: [{kind: "ToolOutput", ref: "tool:guess"}],
    },
    store_opts + {now: "2026-05-23T10:00:02Z"},
  )
  const provider_opts = {
    reminders: {
      config: {
        project_facts: {root: root, namespace: namespace, max_facts: 5, min_confidence: 0.5},
      },
    },
  }
  const session = agent_session_open("reminder-provider-project-facts")
  agent_session_reset(session)
  const first = agent_reminder_providers_fire(
    session,
    "session_start",
    {session: {id: session}, task: "project facts recall", iteration: 1},
    provider_opts,
  )
  __io_println(first.fired_count)
  const reminders = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  __io_println(len(reminders))
  const reminder = reminders[0].reminder
  __io_println(reminder.tags[0])
  __io_println(reminder.dedupe_key)
  __io_println(reminder.ttl_turns)
  __io_println(reminder.preserve_on_compact)
  __io_println(reminder.propagate)
  __io_println(reminder.source)
  __io_println(reminder.role_hint)
  __io_println(contains(reminder.body, "Memory module reuses the BM25 scorer for fact recall"))
  __io_println(
    contains(reminder.body, "Project facts reminder runs synchronously inside the provider"),
  )
  __io_println(contains(reminder.body, "Low-confidence facts"))
  __io_println(contains(reminder.body, "decision"))
  __io_println(contains(reminder.body, "confidence 0.91"))
  const refresh_opts = provider_opts
    + {
    reminders: provider_opts.reminders + {providers: ["-token_pressure"]},
  }
  const below_refresh = agent_reminder_providers_fire(
    session,
    "on_budget_threshold",
    {
      session: {id: session},
      task: "project facts recall",
      tokens_used: 50,
      context_window: 100,
      iteration: 2,
    },
    refresh_opts,
  )
  __io_println(below_refresh.fired_count)
  const refresh = agent_reminder_providers_fire(
    session,
    "on_budget_threshold",
    {
      session: {id: session},
      task: "project facts recall",
      tokens_used: 80,
      context_window: 100,
      iteration: 3,
    },
    refresh_opts,
  )
  __io_println(refresh.fired_count)
  __io_println(refresh.reports[0].deduped_count)
  __io_println(refresh.reports[0].provider)
  const post_turn = agent_session_apply_reminder_post_turn(session, 3)
  const after_post = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  __io_println(post_turn.expired_count)
  __io_println(len(after_post))
  const kind_session = agent_session_open("reminder-provider-project-facts-kind")
  agent_session_reset(kind_session)
  const kind_only = agent_reminder_providers_fire(
    kind_session,
    "session_start",
    {session: {id: kind_session}, task: "constraints only"},
    {
      reminders: {
        config: {
          project_facts: {
            root: root,
            namespace: namespace,
            max_facts: 5,
            min_confidence: 0.0,
            kind_filter: ["constraint"],
          },
        },
      },
    },
  )
  __io_println(kind_only.fired_count)
  const kind_reminder = transcript_events_by_kind(
    agent_session_snapshot(kind_session),
    "system_reminder",
  )[0].reminder
  __io_println(contains(kind_reminder.body, "Project facts reminder runs synchronously"))
  __io_println(contains(kind_reminder.body, "Memory module reuses the BM25 scorer"))
  const disabled_session = agent_session_open("reminder-provider-project-facts-disabled")
  agent_session_reset(disabled_session)
  const disabled = agent_reminder_providers_fire(
    disabled_session,
    "session_start",
    {session: {id: disabled_session}, task: "irrelevant"},
    {
      reminders: {
        providers: ["-project_facts"],
        config: {project_facts: {root: root, namespace: namespace}},
      },
    },
  )
  __io_println(disabled.fired_count)
  const empty_root = path_join(harness.fs.temp_dir(), "harn-reminder-project-facts-empty-" + uuid())
  const empty_session = agent_session_open("reminder-provider-project-facts-empty")
  agent_session_reset(empty_session)
  const empty = agent_reminder_providers_fire(
    empty_session,
    "session_start",
    {session: {id: empty_session}, task: "no facts yet"},
    {reminders: {config: {project_facts: {root: empty_root, namespace: namespace}}}},
  )
  __io_println(empty.fired_count)
  harness.fs.delete(root)
}
