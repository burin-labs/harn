import { command_run } from "std/command"

fn nonzero_command(harness: Harness) -> list<string> {
  if harness.system.platform().os == "windows" {
    return ["cmd", "/C", "exit", "71"]
  }
  return ["sh", "-c", "exit 71"]
}

pipeline default(harness: Harness) {
  const direct = try {
    harness.process.exec("harn-command-that-does-not-exist-5662")
  } catch (error) {
    error
  }
  harness.stdio.println(direct.error)
  harness.stdio.println(direct.kind)
  harness.stdio.println(direct.category)
  const command = try {
    command_run(harness.tools, ["harn-command-that-does-not-exist-5662"])
  } catch (error) {
    error
  }
  harness.stdio.println(command.error)
  harness.stdio.println(command.kind)
  harness.stdio.println(command.category)
  require command.requested_cwd == nil, "omitted cwd remains structurally distinct"
  require trim(command.cwd) != "", "spawn error carries effective cwd"
  const nonzero = command_run(harness.tools, nonzero_command(harness))
  harness.stdio.println(nonzero.exit_code)
  harness.stdio.println(nonzero.success)
  require trim(nonzero.cwd) != "", "nonzero command result carries effective cwd"
}
