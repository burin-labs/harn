import "std/context"

pipeline default(harness: Harness) {
  const ctx = context(
    [
      section("repo", "Use Rust.", nil),
      context_attach("file", "src/lib.rs", "fn " + "main() {}", {max_chars: 12}),
    ],
    {separator: "\n--\n"},
  )
  const rendered = context_render(ctx)
  harness.stdio.println(rendered)
  const prompt = prompt_compose("Fix it", ctx, {system: "You are helpful", task_label: "Work"})
  harness.stdio.println(prompt?.system)
  harness.stdio.println(contains(prompt?.prompt, "[repo]"))
  // The prompt wraps the task in a <workflow_task> / <label> /
  // <instructions> block. Assert both pieces are present.
  harness.stdio.println(
    contains(prompt?.prompt, "<label>Work</label>") && contains(prompt?.prompt, "Fix it"),
  )
  const raw = context_render({sections: [{name: "raw", content: "Visible"}]})
  harness.stdio.println(raw)
  const added = context_add(context([section("one", "1")]), section("two", "2"))
  harness.stdio.println(len(added?.sections))
}
