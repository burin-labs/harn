import "std/git"
import "std/triggers"

fn run_git(cwd, argv) {
  const result = host_call("process.exec", {mode: "argv", argv: argv, cwd: cwd})
  if !result?.success {
    throw "git command failed: " + (result?.stderr ?? result?.stdout ?? "")
  }
  return result
}

pipeline default() {
  const root = path_join(
    harness.fs.temp_dir(),
    "harn_git_stdlib_" + to_string(harness.random.gen_range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  run_git(root, ["git", "init", "-b", "main"])
  run_git(root, ["git", "config", "user.email", "harn@example.test"])
  run_git(root, ["git", "config", "user.name", "Harn Test"])
  harness.fs.write_text(path_join(root, "README.md"), "initial\n")
  run_git(root, ["git", "add", "README.md"])
  run_git(root, ["git", "commit", "-m", "initial"])
  run_git(root, ["git", "tag", "v1.0.0"])
  harness.fs.write_text(path_join(root, "README.md"), "changed\n")
  const status: GitReceipt = git.status(root)
  const status_fn: GitReceipt = git_status(root)
  const records: list<TrustRecord> = trust_query({action: "git.status"})
  const remove: GitReceipt = git.worktree_remove(path_join(root, "missing-worktree"), {force: true})
  __io_println(status.schema == "harn-stdlib-git-receipt-v1")
  __io_println(status.operation == "git.status" && status.success)
  __io_println(status.data.dirty && status.data.entries[0].path == "README.md")
  __io_println(status_fn.operation == "git.status" && status_fn.data.dirty)
  __io_println(len(records) >= 1 && records[len(records) - 1]?.action == "git.status")
  __io_println(remove.status == "no_op" && remove.data.idempotent)
  run_git(root, ["git", "checkout", "--", "README.md"])
  const branch = git_current_branch(root)
  __io_println(branch.success && branch.branch == "main")
  const log_result = git_log(root, {max_count: 1})
  __io_println(log_result.success && contains(log_result.stdout, "initial"))
  const tags = git_tag_list(root, {pattern: "v*", sort: "-v:refname"})
  __io_println(tags.success && tags.data.tags == ["v1.0.0"])
  const described = git_describe(root, {tags: true, match: "v*"})
  __io_println(
    described.success
      && described.data.tag == "v1.0.0"
      && described.data.distance == 0
      && described.data.dirty,
  )
  const switch_result = git_switch("feature/std-git", root, {create: true})
  __io_println(switch_result.success)
  __io_println(git_current_branch(root).branch == "feature/std-git")
  __io_println(git_switch("main", root).success)
  const remote = path_join(
    harness.fs.temp_dir(),
    "harn_git_remote_" + to_string(harness.random.gen_range(100000, 999999)) + ".git",
  )
  run_git(root, ["git", "init", "--bare", remote])
  run_git(root, ["git", "remote", "add", "origin", remote])
  run_git(root, ["git", "push", "-u", "origin", "main"])
  run_git(root, ["git", "push", "origin", "v1.0.0"])
  const remote_refs = git_ls_remote("origin", {repo: root, tags: true, refs: ["refs/tags/v*"]})
  __io_println(
    remote_refs.success
      && remote_refs.data.remote == "origin"
      && remote_refs.data.refs.any({ row -> row.ref == "refs/tags/v1.0.0" }),
  )
  const pull = git_pull_ff_only(root, "origin", "main", {quiet: true})
  __io_println(pull.success)
  const read_tools = git_tools(
    nil,
    {repo: root, enabled_tools: ["git_status", "git_log"], names: {git_log: "release_git_log"}},
  )
  const read_surface = tool_surface_validate({tools: read_tools, policy: {side_effect_level: "read_only"}})
  __io_println(read_surface.valid)
  const status_call = agent_dispatch_tool_call({id: "status", name: "git_status", arguments: {}}, read_tools)
  __io_println(status_call.ok)
  const log_call = agent_dispatch_tool_call(
    {id: "log", name: "release_git_log", arguments: {max_count: 1}},
    read_tools,
  )
  __io_println(log_call.ok)
  const switch_tools = git_tools(nil, {repo: root, enabled_tools: ["git_switch"]})
  const switch_surface = tool_surface_validate({tools: switch_tools, policy: {side_effect_level: "process_exec"}})
  __io_println(switch_surface.valid)
  const deferred_tools = git_tools(nil, {repo: root, defer_loading: true, tool_config: {git_status: {defer_loading: false}}})
  __io_println(tool_find(deferred_tools, "git_log").defer_loading)
  __io_println(!tool_find(deferred_tools, "git_status").defer_loading)
  const found = git_find_tool("recent commits", {})
  __io_println(found.operations[0] == "log")
  const blocked_switch = try {
    git_run_tool("switch", {repo: root, branch: "main"})
  }
  __io_println(is_err(blocked_switch))
  const toolbox = git_toolbox_tools(nil, {repo: root, include_mutations: true})
  const toolbox_surface = tool_surface_validate({tools: toolbox, policy: {side_effect_level: "process_exec"}})
  __io_println(toolbox_surface.valid)
  const find_call = agent_dispatch_tool_call(
    {id: "find", name: "find_git_tool", arguments: {query: "what branch am I on"}},
    toolbox,
  )
  __io_println(find_call.ok)
  const run_call = agent_dispatch_tool_call(
    {id: "run", name: "run_git_tool", arguments: {operation: "current_branch"}},
    toolbox,
  )
  __io_println(run_call.ok && contains(run_call.rendered_result, "main"))
}
