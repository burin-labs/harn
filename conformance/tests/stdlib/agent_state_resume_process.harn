import "../_common"

pipeline default() {
  const root = path_join(harness.fs.temp_dir(), "harn-agent-state-process-" + uuid())
  const script_dir = path_join(root, "scripts")
  harness.fs.mkdir(script_dir)
  const writer = script_dir + "/writer.harn"
  const reader = script_dir + "/reader.harn"
  harness.fs
    .write_text(
    writer,
    "import \"std/agent_state\"\n\npipeline default() {\n  let root = argv[0]\n  let handle = agent_state_init(root, {session_id: \"resume-session\", writer_id: \"writer-a\"})\n  agent_state_write(handle, \"plan.md\", \"persisted plan\")\n  agent_state_handoff(handle, {status: \"ready\", source: \"writer\"})\n  __io_println(agent_state_read(handle, \"plan.md\"))\n}\n",
  )
  harness.fs
    .write_text(
    reader,
    "import \"std/agent_state\"\n\npipeline default() {\n  let root = argv[0]\n  let handle = agent_state_resume(root, \"resume-session\", nil)\n  __io_println(agent_state_read(handle, \"plan.md\"))\n  let handoff = json_parse(agent_state_read(handle, agent_state_handoff_key()))\n  __io_println(handoff.summary.status)\n  __io_println(handoff.session_id)\n}\n",
  )
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = resolve_harn_bin(harness, repo_root)
  const first = exec(harn_bin, "run", writer, "--", root)
  __io_println(first.success)
  __io_println(first.stdout.contains("persisted plan"))
  const second = exec(harn_bin, "run", reader, "--", root)
  __io_println(second.success)
  __io_println(second.stdout.contains("persisted plan"))
  __io_println(second.stdout.contains("ready"))
  __io_println(second.stdout.contains("resume-session"))
  harness.fs.delete(root)
}
