import "../_common"

pipeline default(harness: Harness) {
  const root = path_join(harness.fs.workspace_temp_dir(), "harn-agent-state-process-" + harness.random.uuid())
  const script_dir = path_join(root, "scripts")
  harness.fs.mkdir(script_dir)
  const writer = script_dir + "/writer.harn"
  const reader = script_dir + "/reader.harn"
  harness.fs.write_text(
    writer,
    "import \"std/agent_state\"\n\npipeline default(harness: Harness) {\n  let root = argv[0]\n  let handle = agent_state_init(harness.agent, root, {session_id: \"resume-session\", writer_id: \"writer-a\"})\n  agent_state_write(harness.agent, handle, \"plan.md\", \"persisted plan\")\n  agent_state_handoff(harness.agent, handle, {status: \"ready\", source: \"writer\"})\n  harness.stdio.println(agent_state_read(harness.agent, handle, \"plan.md\"))\n}\n",
  )
  harness.fs.write_text(
    reader,
    "import \"std/agent_state\"\n\npipeline default(harness: Harness) {\n  let root = argv[0]\n  let handle = agent_state_resume(harness.agent, root, \"resume-session\", nil)\n  harness.stdio.println(agent_state_read(harness.agent, handle, \"plan.md\"))\n  let handoff = json_parse(agent_state_read(harness.agent, handle, agent_state_handoff_key()))\n  harness.stdio.println(handoff.summary.status)\n  harness.stdio.println(handoff.session_id)\n}\n",
  )
  const repo_root = harness.process.exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = resolve_harn_bin(harness, repo_root)
  const first = harness.process.exec(harn_bin, "run", writer, "--", root)
  harness.stdio.println(first.success)
  harness.stdio.println(first.stdout.contains("persisted plan"))
  const second = harness.process.exec(harn_bin, "run", reader, "--", root)
  harness.stdio.println(second.success)
  harness.stdio.println(second.stdout.contains("persisted plan"))
  harness.stdio.println(second.stdout.contains("ready"))
  harness.stdio.println(second.stdout.contains("resume-session"))
  harness.fs.delete(root)
}
