import { llm_text, with_llm_script } from "std/testing"
import { preset_run_command } from "std/tool_hooks"

/**
 * LLM classifier — sub-threshold verdict and cache replay (TH-05 #1898).
 *
 * Three scenarios in one fixture:
 *   1. Confidence below threshold → audit + passthrough to `inner`.
 *   2. Explicit `allow` verdict → audit + passthrough.
 *   3. Cache hit replays the prior verdict without re-querying the model.
 */
pipeline default(harness: Harness) {
  harness.obs.pipeline_lifecycle_audit_log_take()
  harness.tools.classifier_cache_clear()
  /* Scenario 1: below-threshold rewrite. The classifier says rewrite but
   * confidence (0.4) < threshold (0.8) so the wrapper falls through to
   * `inner` with the original command. */
  with_llm_script(
    harness.llm, [
      llm_text(
        "{\"kind\": \"rewrite\", \"confidence\": 0.4,"
          + " \"rewritten\": \"never-applied\", \"explanation\": \"low confidence\"}",
      ),
      llm_text("{\"kind\": \"allow\", \"confidence\": 0.99, \"explanation\": \"safe\"}"),
    ],
    { ->
      const inner = { args -> {ok: true, ran: args.command} }
      const wrapper = preset_run_command(harness,  harness, {
          llm_classifier: {
            model: "haiku",
            provider: "mock",
            threshold: 0.8,
            cache: {ttl_ms: 60000},
          },
          inner: inner,
        },
      )
      const r1 = wrapper({command: "echo hello"})
      harness.stdio.println(r1.ok)
      harness.stdio.println(r1.ran)
      const r2 = wrapper({command: "ls -la"})
      harness.stdio.println(r2.ok)
      harness.stdio.println(r2.ran)
      const calls_before = len(harness.llm.mock_calls())
      const r3 = wrapper({command: "echo   hello"})
      harness.stdio.println(r3.ok)
      harness.stdio.println(r3.ran)
      const calls_after = len(harness.llm.mock_calls())
      harness.stdio.println(calls_after - calls_before)
      const log = harness.obs.pipeline_lifecycle_audit_log_take()
      harness.stdio.println(len(log))
      harness.stdio.println(log[0].payload.action)
      harness.stdio.println(log[0].payload.cache_hit)
      harness.stdio.println(log[1].payload.action)
      harness.stdio.println(log[1].payload.cache_hit)
      harness.stdio.println(log[2].payload.action)
      harness.stdio.println(log[2].payload.cache_hit)
    },
  )
}
