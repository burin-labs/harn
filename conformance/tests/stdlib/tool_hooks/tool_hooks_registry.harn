/**
 * `ToolRule` + `Catalogue` + `tool_hooks_registry` foundation (TH-01).
 *
 * Demonstrates the value-type tagging, registry register/unregister/list,
 * linear catalogue×rule matching for both regex and closure patterns, and
 * the stack `applies_to` filter. Acts as the executable spec for the
 * primitive epic #1884 builds on.
 */
pipeline default() {
  let rule = tool_rule(
    {
      id: "rust.cargo.target_dir_conflict",
      pattern: "^cargo (build|test)\\b",
      applies_to: ["rust"],
      severity: "warning",
      explanation: "Concurrent cargo runs without --target-dir thrash the lockfile",
      references: ["https://github.com/rust-lang/cargo/issues/4282"],
    },
  )
  __io_println(rule._type)
  __io_println(rule.id)
  __io_println(rule.priority)
  let predicate_rule = tool_rule(
    {
      id: "shell.dangerous_rm",
      pattern: { command, _context -> contains(command, "rm -rf /") },
      applies_to: [],
      severity: "error",
      explanation: "Refusing recursive root deletion",
    },
  )
  __io_println(predicate_rule._type)
  let rust_cat = catalogue(
    {id: "harn-canon/rust", stack: "rust", version: "0.1.0", source: "harn-canon", rules: [rule]},
  )
  __io_println(rust_cat._type)
  let shell_cat = catalogue({id: "harn-canon/shell", stack: "shell", version: "0.1.0", rules: [predicate_rule]})
  /* Round-trip catalogue through JSON to satisfy the serde criterion. */
  let json = json_stringify(rust_cat)
  let decoded = json_parse(json)
  __io_println(decoded._type)
  __io_println(decoded.id)
  __io_println(len(decoded.rules))
  /* register / list / unregister */
  let registry = tool_hooks_registry()
  let r1 = tool_hooks_register(registry, rust_cat)
  let r2 = tool_hooks_register(r1, shell_cat)
  let listed = tool_hooks_list(r2)
  __io_println(len(listed))
  __io_println(listed[0].id)
  __io_println(listed[0].rule_count)
  /* Re-registering the same id replaces in place. */
  let r3 = tool_hooks_register(r2, rust_cat)
  __io_println(len(tool_hooks_list(r3)))
  /* Unregistering by id prunes the catalogue. */
  let pruned = tool_hooks_unregister(r3, "harn-canon/shell")
  __io_println(len(tool_hooks_list(pruned)))
  /* Regex match (rust stack scoped). */
  let matches = tool_hooks_match(r3, "cargo build --release", {stacks: ["rust"]})
  __io_println(len(matches))
  __io_println(matches[0].rule_id)
  __io_println(matches[0].catalogue_id)
  __io_println(matches[0].severity)
  /* applies_to filter rejects non-matching stacks. */
  let py_matches = tool_hooks_match(r3, "cargo build --release", {stacks: ["python"]})
  __io_println(len(py_matches))
  /* Empty stack context — `applies_to: []` rule (shell) still matches. */
  let shell_matches = tool_hooks_match(r3, "rm -rf / now", nil)
  __io_println(len(shell_matches))
  __io_println(shell_matches[0].rule_id)
  /* Non-matching command produces no hits. */
  __io_println(len(tool_hooks_match(r3, "echo hello", {stacks: ["rust"]})))
  /* Priority sorting: higher rule priority sorts first across catalogues. */
  let low = tool_rule({id: "low", pattern: "git push", priority: 1})
  let high = tool_rule({id: "high", pattern: "git push", priority: 9})
  let pri_cat = catalogue({id: "pri", stack: "general", rules: [low, high]})
  let pri_reg = tool_hooks_register(tool_hooks_registry(), pri_cat)
  let pri_matches = tool_hooks_match(pri_reg, "git push --force", nil)
  __io_println(pri_matches[0].rule_id)
  __io_println(pri_matches[1].rule_id)
}
