import { preset_run_command, tool_hooks_mode_deny_with_explanation } from "std/tool_hooks"

/**
 * Auto-seed wiring (TH-04 #1897). When `preset_run_command(config)` is
 * called without an explicit `registry`, the seed catalogues for each
 * opt-in stack are registered automatically, and the universal
 * catalogue is always registered so cross-cutting denies (force-push
 * to main, `rm -rf /`) fire regardless of stack opt-in.
 */
fn run(wrapper, cmd) {
  let result = wrapper({command: cmd})
  let rid = result?.rule_id ?? ""
  __io_println(result.action + " " + rid)
}

pipeline default() {
  /* No registry override — auto-seed picks up rust + universal. */
  let inner = { args -> return {ok: true, ran: args.command} }
  let rust_wrapper = preset_run_command({stacks: ["rust"], inner: inner})
  /* Rust rule fires (rewrite). */
  run(rust_wrapper, "cargo build --release")
  /* Universal deny fires even though we only opted into rust. */
  let deny_wrapper = preset_run_command({stacks: ["rust"], mode: tool_hooks_mode_deny_with_explanation, inner: inner})
  run(deny_wrapper, "git push --force origin main")
  run(deny_wrapper, "rm -rf /")
  /* Sibling-of-deny command passes through unscathed. */
  let pt = rust_wrapper({command: "echo hello"})
  __io_println(pt.ok)
  __io_println(pt.ran)
}
