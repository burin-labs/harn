import { tool_hooks_seed_registry } from "std/tool_hooks_catalogues"

/**
 * Swift seed catalogue (TH-04 #1897). The shipped rule warns on bulk
 * cache wipes (`swift build --clean`, `swift package clean`) and stays
 * quiet on the targeted forms.
 */
fn probe(harness: Harness, reg, cmd) {
  const m = harness.tools.hooks_match(reg, cmd, {stacks: ["swift"]})
  if len(m) > 0 {
    harness.stdio.println(m[0].rule_id + " " + m[0].severity)
  } else {
    harness.stdio.println("miss")
  }
}

pipeline default(harness: Harness) {
  const reg = tool_hooks_seed_registry(["swift"])
  probe(harness, reg, "swift build --clean")
  probe(harness, reg, "swift package clean")
  /* Targeted build is allowed. */
  probe(harness, reg, "swift build --product MyApp")
  /* `swift test` is a different subcommand entirely. */
  probe(harness, reg, "swift test")
}
