import { tool_hooks_seed_registry } from "std/tool_hooks_catalogues"

/**
 * TypeScript seed catalogue (TH-04 #1897). Verifies find/npm rules
 * fire on real-world invocations and respect their negative cases.
 */
fn probe(harness: Harness, reg, cmd) {
  const m = harness.tools.hooks_match(reg, cmd, {stacks: ["typescript"]})
  if len(m) > 0 {
    harness.stdio.println(m[0].rule_id + " " + m[0].severity)
  } else {
    harness.stdio.println("miss")
  }
}

pipeline default(harness: Harness) {
  const reg = tool_hooks_seed_registry(harness, ["typescript"])
  /* find_versus_rg: covers .ts/.tsx/.js/.jsx/.mjs/.cjs. */
  probe(harness, reg, "find . -name '*.ts'")
  probe(harness, reg, "find . -name '*.tsx'")
  probe(harness, reg, "find . -name '*.mjs'")
  /* Negative: .json files aren't covered by the TS family rule. */
  probe(harness, reg, "find . -name '*.json'")
  /* npm_install_force_resolution: --force or --legacy-peer-deps fire. */
  probe(harness, reg, "npm install --force lodash")
  probe(harness, reg, "npm i --legacy-peer-deps")
  probe(harness, reg, "npm add some-pkg --force")
  /* Negative: vanilla `npm install` is fine. */
  probe(harness, reg, "npm install lodash")
}
