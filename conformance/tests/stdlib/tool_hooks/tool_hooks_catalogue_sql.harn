import { tool_hooks_seed_registry } from "std/tool_hooks_catalogues"

/**
 * SQL seed catalogue (TH-04 #1897). Warns on unbounded `SELECT *`
 * scans; stays quiet when a WHERE / LIMIT / aggregate caps the result
 * set or when the literal text appears in a non-leading context.
 */
fn probe(harness: Harness, reg, cmd) {
  const m = harness.tools.hooks_match(reg, cmd, {stacks: ["sql"]})
  if len(m) > 0 {
    harness.stdio.println(m[0].rule_id + " " + m[0].severity)
  } else {
    harness.stdio.println("miss")
  }
}

pipeline default(harness: Harness) {
  const reg = tool_hooks_seed_registry(["sql"])
  /* Unbounded scans — fire. */
  probe(harness, reg, "SELECT * FROM users")
  probe(harness, reg, "select * from logs")
  /* Bounded — quiet. */
  probe(harness, reg, "SELECT * FROM users WHERE id = 1")
  probe(harness, reg, "SELECT * FROM users LIMIT 10")
  probe(harness, reg, "SELECT COUNT(*) FROM users")
  /* Non-leading usage (e.g. inside a shell echo) — quiet. */
  probe(harness, reg, "echo SELECT * FROM users")
}
