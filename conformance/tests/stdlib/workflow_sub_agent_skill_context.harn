import { sub_agent_run } from "std/agent/workers"
import { llm_text, with_llm_script } from "std/testing"
import { workflow_execute } from "std/workflow/execute"

fn child_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "read_file",
    "Read a file",
    {
      parameters: {path: {type: "string"}},
      namespace: "read",
      handler: { args -> "read " + args.path },
    },
  )
  tools = tool_define(
    tools,
    "write_file",
    "Write a file",
    {
      parameters: {path: {type: "string"}, content: {type: "string"}},
      namespace: "write",
      handler: { args -> "wrote " + args.path },
    },
  )
  return tools
}

fn workflow_tools(harness: Harness) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_readonly",
    "Delegate a read-only investigation",
    {
      parameters: {task: {type: "string"}},
      handler: { args ->
        sub_agent_run(
          harness,
          args.task,
          {provider: "mock", tools: child_tools(), tool_format: "native", max_iterations: 1},
        )
      },
    },
  )
  return tools
}

pipeline test(harness: Harness, task) {
  skill only_look {
    description "Investigate the codebase safely"
    when_to_use "User asks to inspect or read files"
    prompt "Stay read only and inspect the code carefully."
    allowed_tools ["delegate_readonly", "namespace:read"]
  }
  const flow = workflow_graph(
    {
      name: "workflow-sub-agent-skill-context",
      entry: "delegate",
      nodes: {
        delegate: {
          kind: "stage",
          mode: "agent",
          model_policy: {provider: "mock", tool_format: "native", max_iterations: 2},
          tools: workflow_tools(harness),
        },
      },
      edges: [],
    },
  )
  with_llm_script(
    harness.llm,
    [
      {
        tool_calls: [
          {id: "stage_1", name: "delegate_readonly", arguments: {task: "Inspect the config file"}},
        ],
      },
      llm_text("I inspected the config path."),
      llm_text("Delegation finished."),
    ],
    { ->
      const result = workflow_execute(
        harness,
        "Inspect the config file",
        flow,
        [],
        {max_steps: 2, skills: only_look, skill_match: {strategy: "metadata"}},
      )
      const calls = harness.llm.mock_calls()
      const child_tool_schemas = calls[1].tools
      let seen_read = false
      let seen_write = false
      if child_tool_schemas != nil {
        for t in child_tool_schemas {
          if t?.function?.name == "read_file" {
            seen_read = true
          }
          if t?.function?.name == "write_file" {
            seen_write = true
          }
        }
      }
      harness.stdio.println(result?.status == "completed")
      harness.stdio.println(len(calls) == 3)
      harness.stdio.println(contains(calls[1].system, "## Active skills"))
      harness.stdio.println(seen_read)
      harness.stdio.println(!seen_write)
    },
  )
}
