import {
  external_action_activity,
  external_action_execute,
  external_action_fake_adapter,
  external_action_grant,
  external_action_intent,
  external_action_managed_policy,
  external_action_reconcile,
} from "std/external_action"

fn grant(intent, amount_minor = 20000, expires_at_ms = 9999999999999) {
  return external_action_grant(
    intent,
    {
      authorized_by: {kind: "user", id: "user-1"},
      authorization_method: "test_fixture",
      authentication_assurance: "session",
      issued_at_ms: 0,
      expires_at_ms: expires_at_ms,
      max_external_spend: {currency: "USD", amount_minor: amount_minor},
    },
  )
}

pipeline test(harness: Harness) {
  harness.runtime.checkpoint_clear()
  const intent = external_action_intent(
    {
      actor: {kind: "user", id: "user-1"},
      provider: "DUFFEL",
      capability: "Flights.Book",
      operation: "Create_Order",
      environment: "test",
      payload: {offer_id: "off_test_123", passengers: [{id: "pas_1"}]},
      external_spend: {currency: "usd", amount_minor: 12345},
      display: {summary: "Book the selected flight"},
    },
  )
  const exact_grant = grant(intent)
  const confirmed = external_action_fake_adapter(
    harness.runtime,
    "duffel-test",
    {
      outcome: "confirmed",
      provider_action_id: "ord_test_123",
      evidence_refs: ["duffel:orders/ord_test_123"],
    },
  )
  const first = external_action_execute(harness, intent, exact_grant, confirmed.adapter)
  const replay = external_action_execute(harness, intent, exact_grant, confirmed.adapter)
  assert(first.status == "confirmed", "first dispatch must confirm")
  assert(replay.id == first.id, "replay must return the durable receipt")
  assert(confirmed.dispatch_calls() == 1, "replay must not dispatch twice")
  const activity = external_action_activity(
    intent,
    first,
    {
      requester: {
        actor: intent.actor,
        agent_id: "assistant",
        model_provider: "test",
        model_id: "fixture-model",
        session_id: "session-1",
        run_id: "run-1",
      },
      policy_evaluations: [
        {layer: "user_policy", outcome: "allowed", reason_code: "test_action_allowed"},
        {layer: "adversarial_reviewer", outcome: "allowed", reason_code: "review_passed"},
      ],
      decision: {
        outcome: "approved",
        decider: "test_fixture",
        decided_at_ms: 10,
        reason_code: "fixture_approval",
      },
      authorization: {
        method: "test_fixture",
        authentication_assurance: "session",
        issued_at_ms: 0,
        expires_at_ms: 9999999999999,
      },
    },
    20,
  )
  assert(activity.status == "confirmed", "activity follows the terminal receipt")
  assert(activity.dispatch.attempted, "activity records provider dispatch")
  assert(activity.policy_evaluations[1]?.layer == "adversarial_reviewer", "policy chain is typed")
  assert(activity.authorization?.expires_at_ms == 9999999999999, "expiry is auditable")
  assert(activity.receipt?.id == first.id, "activity retains the exact receipt")
  assert(activity.receipt?.schema == "harn.external_action_receipt.v1", "receipt stays canonical")
  assert(!json_stringify(activity).contains("offer_id"), "activity structurally excludes payloads")
  harness.stdio.println("confirmed_once:" + to_string(confirmed.dispatch_calls()))
  const changed = external_action_intent(
    intent + {payload: {offer_id: "off_test_changed", passengers: [{id: "pas_1"}]}},
  )
  const changed_receipt = external_action_execute(harness, changed, exact_grant, confirmed.adapter)
  assert(changed_receipt.status == "denied", "changed payload must invalidate the grant")
  assert(changed_receipt.error?.code == "grant_binding_mismatch", "denial must be typed")
  assert(confirmed.dispatch_calls() == 1, "denied mutation must not reach the adapter")
  harness.stdio.println("changed_denied:" + to_string(changed_receipt.error?.code ?? ""))
  const rejected_intent = external_action_intent(
    intent + {payload: {offer_id: "off_test_provider_rejected"}},
  )
  const rejected = external_action_fake_adapter(
    harness.runtime,
    "duffel-test",
    {outcome: "rejected", error_code: "validation_required"},
  )
  const rejected_receipt = external_action_execute(
    harness,
    rejected_intent,
    grant(rejected_intent),
    rejected.adapter,
  )
  const rejected_replay = external_action_execute(
    harness,
    rejected_intent,
    grant(rejected_intent),
    rejected.adapter,
  )
  assert(rejected_receipt.status == "rejected", "provider rejection must be distinct")
  assert(rejected_receipt.dispatch_attempted, "provider rejection must record dispatch")
  assert(rejected_receipt.next_action == "none", "definite rejection must not reconcile")
  assert(!rejected_receipt.error?.retryable, "definite rejection must not invite a retry")
  assert(rejected_replay.id == rejected_receipt.id, "rejection replay must use its checkpoint")
  assert(rejected.dispatch_calls() == 1, "rejection replay must not dispatch twice")
  harness.stdio.println("provider_rejected_after_dispatch:" + to_string(rejected.dispatch_calls()))
  const forged_intent = external_action_intent(
    intent + {payload: {offer_id: "off_test_forged_grant"}},
  )
  const forged_grant = grant(forged_intent)
    + {authorized_by: {kind: "user", id: "different-user"}}
  const forged_receipt = external_action_execute(
    harness,
    forged_intent,
    forged_grant,
    confirmed.adapter,
  )
  assert(forged_receipt.status == "denied", "changed grant fields must invalidate its digest")
  assert(
    forged_receipt.error?.code == "grant_integrity_mismatch",
    "forged grant denial must be typed",
  )
  harness.stdio.println("forged_grant_denied:" + to_string(forged_receipt.error?.code ?? ""))
  const raised_spend = external_action_intent(
    intent + {external_spend: {currency: "USD", amount_minor: 25000}},
  )
  const spend_receipt = external_action_execute(
    harness,
    raised_spend,
    grant(raised_spend, 20000),
    confirmed.adapter,
  )
  assert(spend_receipt.status == "denied", "spend above the grant ceiling must be denied")
  assert(spend_receipt.error?.code == "external_spend_exceeds_grant", "spend denial must be typed")
  harness.stdio.println("spend_denied:" + to_string(spend_receipt.error?.code ?? ""))
  const managed_intent = external_action_intent(
    intent + {payload: {offer_id: "off_test_managed_denial"}},
  )
  const managed_adapter = external_action_fake_adapter(
    harness.runtime,
    "duffel-managed-test",
    {outcome: "confirmed", provider_action_id: "must_not_dispatch_managed"},
  )
  const managed_policy = external_action_managed_policy(
    {
      automatic_approval_forbidden: true,
      live_actions_forbidden: true,
      minimum_authentication_assurance: "biometric",
      max_external_spend: [{currency: "USD", amount_minor: 10000}],
      allowed_providers: ["duffel"],
      allowed_capabilities: ["flights.book"],
      allowed_environments: ["test"],
    },
  )
  const automatic_grant = external_action_grant(
    managed_intent,
    {
      authorized_by: {kind: "reviewer", id: "safety-reviewer"},
      authorization_method: "adversarial_auto",
      authentication_assurance: "managed",
      issued_at_ms: 0,
      expires_at_ms: 9999999999999,
      max_external_spend: {currency: "USD", amount_minor: 20000},
    },
  )
  const managed_denial = external_action_execute(
    harness,
    managed_intent,
    automatic_grant,
    managed_adapter.adapter,
    managed_policy,
  )
  assert(managed_denial.status == "denied", "managed policy must deny forbidden auto approval")
  assert(
    managed_denial.error?.code == "automatic_approval_forbidden",
    "managed policy denial must be typed",
  )
  assert(managed_adapter.dispatch_calls() == 0, "managed denial must not reach the adapter")
  harness.stdio.println(
    "managed_denied_without_dispatch:" + to_string(managed_adapter.dispatch_calls()),
  )
  const expired_intent = external_action_intent(
    intent + {payload: {offer_id: "off_test_expired_grant"}},
  )
  const expired = external_action_fake_adapter(
    harness.runtime,
    "duffel-test-expired",
    {outcome: "confirmed", provider_action_id: "must_not_dispatch"},
  )
  const receipt_cursor = harness.obs.event_log_latest("external_actions.receipts")
  harness.testing.clock_set(2000)
  const expired_receipt = external_action_execute(
    harness,
    expired_intent,
    grant(expired_intent, 20000, 1000),
    expired.adapter,
  )
  harness.testing.clock_reset()
  assert(expired_receipt.status == "denied", "expired grants must be denied")
  assert(expired_receipt.error?.code == "grant_expired", "expiry denial must be typed")
  assert(expired.dispatch_calls() == 0, "expired grants must not reach the adapter")
  const receipt_stream = harness.obs.event_log_subscribe(
    {topic: "external_actions.receipts", from_cursor: receipt_cursor},
  )
  const expired_event = receipt_stream.next().value
  assert(
    expired_event.kind == "external_action_receipt",
    "expiry denial must use the canonical receipt event",
  )
  assert(expired_event.payload.id == expired_receipt.id, "emitted expiry receipt must be exact")
  harness.stdio.println(
    "expired_denied_without_dispatch:"
      + to_string(expired.dispatch_calls())
      + ":"
      + to_string(expired_event.payload.error?.code ?? ""),
  )
  const ambiguous_intent = external_action_intent(
    intent + {payload: {offer_id: "off_test_ambiguous"}},
  )
  const ambiguous = external_action_fake_adapter(
    harness.runtime,
    "duffel-test",
    {outcome: "indeterminate", error_code: "connection_lost_after_send"},
    [
      {
        outcome: "confirmed",
        provider_action_id: "ord_test_reconciled",
        evidence_refs: ["duffel:orders/ord_test_reconciled"],
      },
    ],
  )
  const uncertain = external_action_execute(
    harness,
    ambiguous_intent,
    grant(ambiguous_intent),
    ambiguous.adapter,
  )
  assert(uncertain.outcome == "indeterminate", "ambiguous dispatch must remain indeterminate")
  assert(
    uncertain.status == "reconciliation_required",
    "ambiguous dispatch must require reconciliation",
  )
  const reconciled = external_action_reconcile(
    harness,
    ambiguous_intent,
    grant(ambiguous_intent),
    uncertain,
    ambiguous.adapter,
    "poll-1",
  )
  const reconciled_replay = external_action_reconcile(
    harness,
    ambiguous_intent,
    grant(ambiguous_intent),
    uncertain,
    ambiguous.adapter,
    "poll-1",
  )
  assert(reconciled.status == "confirmed", "reconciliation must resolve the receipt")
  assert(reconciled_replay.id == reconciled.id, "reconciliation replay must use its checkpoint")
  assert(ambiguous.dispatch_calls() == 1, "reconciliation must not redispatch")
  assert(ambiguous.reconcile_calls() == 1, "one reconciliation attempt must query once")
  harness.stdio.println(
    "reconciled_without_redispatch:"
      + to_string(ambiguous.dispatch_calls())
      + ":"
      + to_string(ambiguous.reconcile_calls()),
  )
  const malformed_intent = external_action_intent(
    intent + {payload: {offer_id: "off_test_malformed"}},
  )
  const malformed = external_action_fake_adapter(
    harness.runtime,
    "malformed-test",
    {outcome: "confirmed", evidence_refs: ["not a reference\nraw provider body"]},
  )
  const bounded = external_action_execute(
    harness,
    malformed_intent,
    grant(malformed_intent),
    malformed.adapter,
  )
  assert(bounded.status == "reconciliation_required", "malformed provider evidence must fail safe")
  assert(
    !json_stringify(bounded).contains("raw provider body"),
    "receipt must not retain raw provider text",
  )
  harness.stdio.println("malformed_bounded:" + to_string(bounded.error?.code ?? ""))
  const protected_sentinel = "HarnProtectedSentinel"
  const protected_intent = external_action_intent(
    {
      actor: {kind: "user", id: "user-1"},
      provider: "duffel",
      capability: "flights.book",
      operation: "create_order",
      environment: "test",
      payload: {offer_id: "off_test_protected"},
      protected_disclosure: {
        field_classes: ["legal_identity", "birth_date"],
        recipient: "Duffel test mode",
        purpose: "Create the exact approved test order.",
        source: "fictional_test_fixture",
        require_reauthentication: true,
      },
      external_spend: {currency: "USD", amount_minor: 12345},
      display: {summary: "Create one Duffel test order"},
    },
  )
  const protected_grant = grant(protected_intent)
  const disclosure_calls = harness.runtime.atomic(0)
  const protected_resolver = {
    id: "burin-protected-profile",
    disclose: { _harness, request ->
      harness.runtime.atomic_add(disclosure_calls, 1)
      assert(
        request.intent_fingerprint == protected_intent.fingerprint,
        "disclosure must bind intent",
      )
      assert(request.provider == protected_intent.provider, "disclosure provider must bind intent")
      assert(
        request.operation == protected_intent.operation,
        "disclosure operation must bind intent",
      )
      assert(
        request.recipient == protected_intent.protected_disclosure?.recipient,
        "disclosure recipient must bind intent",
      )
      assert(
        request.purpose == protected_intent.protected_disclosure?.purpose,
        "disclosure purpose must bind intent",
      )
      assert(
        request.field_classes == protected_intent.protected_disclosure?.field_classes,
        "disclosure field classes must bind intent",
      )
      assert(
        request.source == protected_intent.protected_disclosure?.source,
        "disclosure source must bind intent",
      )
      return {
        schema: "harn.external_action_disclosure.v1",
        intent_fingerprint: request.intent_fingerprint,
        provider: request.provider,
        operation: request.operation,
        recipient: request.recipient,
        purpose: request.purpose,
        field_classes: request.field_classes,
        source: request.source,
        authentication_assurance: "biometric",
        protected_values: {
          legal_identity: {
            given_name: protected_sentinel,
            family_name: "Traveler",
            title: "ms",
            gender: "f",
          },
          birth_date: "1990-01-01",
        },
      }
    },
  }
  const protected_dispatch_calls = harness.runtime.atomic(0)
  const protected_adapter = {
    id: "duffel-protected-test",
    dispatch: { _harness, request ->
      harness.runtime.atomic_add(protected_dispatch_calls, 1)
      assert(
        request.protected_disclosure?.protected_values?.legal_identity?.given_name
          == protected_sentinel,
        "the adapter must receive the transient requested fields",
      )
      assert(
        request.protected_disclosure?.protected_values?.legal_identity?.gender == "f",
        "the adapter must receive the transient passenger marker",
      )
      return {outcome: "confirmed", provider_action_id: "ord_test_protected"}
    },
    reconcile: { _harness, _request -> return {outcome: "indeterminate"} },
  }
  const protected_cursor = harness.obs.event_log_latest("external_actions.receipts")
  const protected_receipt = external_action_execute(
    harness,
    protected_intent,
    protected_grant,
    protected_adapter,
    nil,
    protected_resolver,
  )
  const protected_replay = external_action_execute(
    harness,
    protected_intent,
    protected_grant,
    protected_adapter,
    nil,
    protected_resolver,
  )
  assert(
    protected_receipt.status == "confirmed",
    "protected dispatch must confirm: " + json_stringify(protected_receipt),
  )
  assert(protected_replay.id == protected_receipt.id, "protected replay must use its receipt")
  assert(harness.runtime.atomic_get(disclosure_calls) == 1, "replay must not disclose twice")
  assert(
    harness.runtime.atomic_get(protected_dispatch_calls) == 1,
    "replay must not dispatch twice",
  )
  assert(
    protected_receipt.disclosure?.field_classes == ["legal_identity", "birth_date"],
    "receipt must retain value-free disclosure classes",
  )
  assert(
    protected_receipt.disclosure?.authentication_assurance == "biometric",
    "receipt must retain the disclosure host's actual authentication assurance",
  )
  for durable in [protected_intent, protected_grant, protected_receipt] {
    const encoded = json_stringify(durable)
    assert(
      !encoded.contains(protected_sentinel),
      "durable action state must exclude protected values",
    )
    assert(
      !encoded.contains("protected_values"),
      "durable action state must exclude value containers",
    )
  }
  for checkpoint_key in harness.runtime.checkpoint_list() {
    assert(
      !json_stringify(harness.runtime.checkpoint_get(checkpoint_key)).contains(protected_sentinel),
      "checkpoints must exclude protected values",
    )
  }
  const protected_event = harness.obs.event_log_subscribe(
    {topic: "external_actions.receipts", from_cursor: protected_cursor},
  )
    .next().value
  assert(
    !json_stringify(protected_event).contains(protected_sentinel),
    "receipt events must exclude protected values",
  )
  const unavailable_intent = external_action_intent(
    protected_intent + {payload: {offer_id: "off_test_profile_unavailable"}},
  )
  const unavailable = external_action_execute(
    harness,
    unavailable_intent,
    grant(unavailable_intent),
    protected_adapter,
  )
  assert(unavailable.status == "denied", "missing disclosure resolver must deny")
  assert(
    unavailable.error?.code == "protected_disclosure_unavailable",
    "missing resolver denial must be typed",
  )
  assert(
    harness.runtime.atomic_get(protected_dispatch_calls) == 1,
    "missing profile must not dispatch",
  )
  const refused_intent = external_action_intent(
    protected_intent + {payload: {offer_id: "off_test_profile_refused"}},
  )
  const refused_resolver = {
    id: "burin-protected-profile-refused",
    disclose: { _harness, _request ->
      throw protected_sentinel
    },
  }
  const refused = external_action_execute(
    harness,
    refused_intent,
    grant(refused_intent),
    protected_adapter,
    nil,
    refused_resolver,
  )
  assert(refused.status == "denied", "refused disclosure must deny")
  assert(refused.error?.code == "protected_disclosure_refused", "refusal must be typed")
  assert(
    !json_stringify(refused).contains(protected_sentinel),
    "refusal errors must not leak values",
  )
  assert(harness.runtime.atomic_get(protected_dispatch_calls) == 1, "refusal must not dispatch")
  harness.stdio.println("protected_disclosure_once_without_persistence:1")
  harness.runtime.checkpoint_clear()
}
