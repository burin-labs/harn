/** Verifies set_color_mode controls ANSI emission. */
pipeline test(harness: Harness, task) {
  harness.term.set_color_mode("never")
  harness.stdio.log(json_stringify(color("hi", "red")))
  harness.stdio.log(json_stringify(bold("hi")))
  harness.term.set_color_mode("always")
  harness.stdio.log(json_stringify(color("hi", "red")))
  harness.stdio.log(json_stringify(bold("hi")))
}
