import {
  ModelJobRequest,
  ModelJobRunOptions,
  ModelOutputSpec,
  ModelTask,
  OpenAiImageBackendOptions,
  OpenAiImageQuality,
  model_job_run_result,
  openai_responses_image_backend,
} from "std/model_job"

pipeline test(harness: Harness, task) {
  const endpoint = "https://openai.example.test/v1"
  harness.testing.http_mock(
    "POST",
    endpoint + "/responses",
    {
      responses: [
        {
          status: 200,
          body:
            "{\"id\":\"resp-1\",\"status\":\"completed\",\"output\":[{\"type\":\"image_generation_call\",\"id\":\"image-1\",\"result\":\"iVBORw0KGgo=\"}],\"usage\":{\"total_tokens\":12}}",
        },
        {
          status: 200,
          body:
            "{\"id\":\"resp-2\",\"status\":\"completed\",\"output\":[{\"type\":\"image_generation_call\",\"id\":\"image-2\",\"result\":\"not-base64!\"}]}",
        },
      ],
    },
  )
  const task_kind: ModelTask = "image.generate"
  const output_spec: ModelOutputSpec = {mime_type: "image/png", width: 1024, height: 1024}
  const request: ModelJobRequest = {
    id: "request-1",
    task: task_kind,
    prompt: "A blue flower",
    output: output_spec,
  }
  const root = harness.fs.mkdtemp_in_workspace("openai-assets-")
  const options: ModelJobRunOptions = {interval_ms: 0, max_attempts: 1, asset_root: root}
  const quality: OpenAiImageQuality = "low"
  const backend_options: OpenAiImageBackendOptions = {
    api_key: "fixture-key",
    endpoint: endpoint,
    quality: quality,
  }
  const backend = openai_responses_image_backend(backend_options)
  const receipt = unwrap(model_job_run_result(harness, backend, request, options))
  harness.stdio.log(receipt.job.state)
  harness.stdio.log(receipt.assets[0]?.mime_type ?? "missing")
  harness.stdio.log(to_string(receipt.assets[0]?.size_bytes ?? 0))
  const calls = harness.testing.http_mock_calls()
  harness.stdio.log(to_string(len(calls)))
  harness.stdio.log(to_string(contains(calls[0]?.body ?? "", "gpt-5.6-sol")))
  harness.stdio.log(to_string(contains(calls[0]?.body ?? "", "image_generation")))
  const malformed = model_job_run_result(harness, backend, request + {id: "request-2"}, options)
  harness.stdio.log(to_string(is_err(malformed)))
  harness.stdio.log(unwrap_err(malformed).kind)
}
