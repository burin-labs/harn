/** Test that date_parse validates month/day ranges */
pipeline default(harness: Harness, task: unknown) {
  // Valid date should work
  const ts = date_parse("2024-06-15")
  harness.stdio.println(ts > 0)
  // Invalid month
  const r1 = try {
    date_parse("2024-13-01")
  }
  harness.stdio.println(is_err(r1))
  // Invalid day
  const r2 = try {
    date_parse("2024-01-32")
  }
  harness.stdio.println(is_err(r2))
}
