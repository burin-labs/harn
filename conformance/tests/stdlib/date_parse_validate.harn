pipeline default(harness: Harness) {
  const ts = date_parse("2024-06-15")
  harness.stdio.println(ts > 0)
  for invalid in [
    "2024-13-01",
    "2024-01-32",
    "2024-02-31",
    "2026-04-25T17:32:09+25:00",
    "2026-04-25T17:32+25:00",
    "2026-04-25T17:32+02:",
    "2026-04-25T17:32:09.123Zjunk",
    "2026/04/25",
  ] {
    const result = try {
      date_parse(invalid)
    }
    assert(is_err(result))
  }
}
