pipeline test(task) {
  transport_mock_clear()
  const server = websocket_server("127.0.0.1:0", {})
  // 10s instead of 2s gives the WebSocket handshake enough headroom when the
  // conformance suite runs alongside release-harn's other cargo audit lanes;
  // local solo runs still complete in milliseconds.
  const ws_timeout_ms = 10000
  assert(websocket_route(server, "/acp", {idle_timeout_ms: 1000}))
  assert(websocket_route(server, "/secure", {auth: {bearer: "secret"}}))
  assert(websocket_route(server, "/limited", {max_message_bytes: 3}))
  assert(websocket_route(server, "/backpressure", {send_buffer_messages: 0}))
  const missing = try {
    websocket_connect(server.url + "/missing", {timeout_ms: ws_timeout_ms})
  }
  assert(is_err(missing), "unregistered routes reject upgrades")
  const unauthorized = try {
    websocket_connect(server.url + "/secure", {timeout_ms: ws_timeout_ms})
  }
  assert(is_err(unauthorized), "bearer route rejects missing auth")
  const secure_client = websocket_connect(
    server.url + "/secure",
    {timeout_ms: ws_timeout_ms, auth: {bearer: "secret"}},
  )
  const secure_server = websocket_accept(server, ws_timeout_ms) ?? {}
  assert_eq(secure_server.path, "/secure")
  assert(websocket_close(secure_client))
  assert(websocket_close(secure_server))
  const client = websocket_connect(server.url + "/acp", {timeout_ms: ws_timeout_ms})
  const conn = websocket_accept(server, ws_timeout_ms) ?? {}
  assert_eq(conn.path, "/acp")
  assert(conn.headers["sec-websocket-key"] != nil)
  assert(websocket_send(client, "hello", {}))
  const text = websocket_receive(conn, ws_timeout_ms)
  assert_eq(text.type, "text")
  assert_eq(text.data, "hello")
  assert(websocket_send(conn, bytes_from_string("bin"), {}))
  const binary = websocket_receive(client, ws_timeout_ms)
  assert_eq(binary.type, "binary")
  assert_eq(binary.data_base64, "Ymlu")
  assert(websocket_send(client, "p", {type: "ping"}))
  const ping = websocket_receive(conn, ws_timeout_ms)
  assert_eq(ping.type, "ping")
  const auto_pong = websocket_receive(client, ws_timeout_ms)
  assert_eq(auto_pong.type, "pong")
  assert(websocket_send(client, "q", {type: "pong"}))
  const pong = websocket_receive(conn, ws_timeout_ms)
  assert_eq(pong.type, "pong")
  assert(websocket_send(conn, "", {type: "close", code: 1000, reason: "done"}))
  const closed = websocket_receive(client, ws_timeout_ms)
  assert_eq(closed.type, "close")
  assert_eq(closed.code, 1000)
  assert_eq(closed.reason, "done")
  const limited_client = websocket_connect(server.url + "/limited", {timeout_ms: ws_timeout_ms})
  const limited_conn = websocket_accept(server, ws_timeout_ms) ?? {}
  assert(websocket_send(limited_client, "toolong", {}))
  const limited = try {
    websocket_receive(limited_conn, ws_timeout_ms)
  }
  assert(is_err(limited), "server max_message_bytes rejects large frames")
  assert(websocket_close(limited_client))
  const backpressure_client = websocket_connect(
    server.url + "/backpressure",
    {timeout_ms: ws_timeout_ms},
  )
  const backpressure_conn = websocket_accept(server, ws_timeout_ms) ?? {}
  const saturated = try {
    websocket_send(backpressure_conn, "blocked", {})
  }
  assert(is_err(saturated), "full outbound buffers reject sends")
  assert(websocket_close(backpressure_client))
  assert(websocket_close(backpressure_conn))
  assert(websocket_server_close(server))
  __io_println("websocket_server_builtins_ok")
}
