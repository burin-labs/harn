/** Verifies sleep_ms/monotonic_ms/now_ms honor mock_time + advance_time. */
pipeline test(harness: Harness, task) {
  mock_time(1700000000000)
  harness.stdio.println(harness.clock.now_ms())
  harness.stdio.println(harness.clock.monotonic_ms())
  // sleep advances mocked time instantly
  harness.clock.sleep_ms(250)
  harness.stdio.println(harness.clock.now_ms())
  harness.stdio.println(harness.clock.monotonic_ms())
  advance_time(1000)
  harness.stdio.println(harness.clock.now_ms())
  harness.stdio.println(harness.clock.monotonic_ms())
  unmock_time()
}
