/** Verifies the structured std/io terminal helpers. */
import { is_tty, read_line, read_password, write_stderr } from "std/io"

pipeline test(task) {
  capture_stderr_start()
  write_stderr("warn")
  let written = capture_stderr_take()
  log(written)
  mock_tty("stdin", true)
  mock_tty("stdout", false)
  mock_tty("stderr", true)
  log(is_tty())
  log(is_tty(0))
  log(is_tty(1))
  log(is_tty(2))
  unmock_tty()
  mock_stdin("  alpha  \nsecret\n")
  set_color_mode("always")
  capture_stderr_start()
  let first = read_line({prompt: color("Q?", "cyan") + " ", timeout_ms: 50, trim: false})
  let second = read_password("pw: ")
  let prompts = capture_stderr_take()
  log(first.ok)
  log(first.status)
  log("[" + first.value + "]")
  log(second.ok)
  log(second.status)
  log(second.value)
  log(contains(json_stringify(prompts), "\\u001b[36mQ?\\u001b[0m "))
  log(contains(prompts, "pw: "))
  let eof = read_line()
  log(eof.ok)
  log(eof.status)
  unmock_stdin()
}
