/** Verifies the structured std/io terminal helpers. */
import { is_tty, read_line, read_password, write_stderr } from "std/io"

pipeline test(harness: Harness, task) {
  capture_stderr_start()
  write_stderr(harness.stdio, "warn")
  const written = capture_stderr_take()
  harness.stdio.println(written)
  mock_tty("stdin", true)
  mock_tty("stdout", false)
  mock_tty("stderr", true)
  harness.stdio.println(is_tty())
  harness.stdio.println(is_tty(harness.term, 0))
  harness.stdio.println(is_tty(harness.term, 1))
  harness.stdio.println(is_tty(harness.term, 2))
  unmock_tty()
  mock_stdin("  alpha  \nsecret\n")
  set_color_mode("always")
  capture_stderr_start()
  const first = read_line(harness.stdio, {prompt: color("Q?", "cyan") + " ", timeout_ms: 50, trim: false})
  const second = read_password(harness.stdio, "pw: ")
  const prompts = capture_stderr_take()
  harness.stdio.println(first.ok)
  harness.stdio.println(first.status)
  harness.stdio.println("[" + (first.value ?? "") + "]")
  harness.stdio.println(second.ok)
  harness.stdio.println(second.status)
  harness.stdio.println(second.value)
  harness.stdio.println(contains(json_stringify(prompts), "\\u001b[36mQ?\\u001b[0m "))
  harness.stdio.println(contains(prompts, "pw: "))
  const eof = read_line()
  harness.stdio.println(eof.ok)
  harness.stdio.println(eof.status)
  unmock_stdin()
}
