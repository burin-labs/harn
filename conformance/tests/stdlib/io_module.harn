/** Verifies the structured std/io terminal helpers. */
import { is_tty, read_line, read_password, write_stderr } from "std/io"

pipeline test(harness: Harness, task: unknown) {
  harness.testing.capture_stderr_start()
  write_stderr(harness.stdio, "warn")
  const written = harness.testing.capture_stderr_take()
  harness.stdio.log(written)
  harness.testing.tty_set("stdin", true)
  harness.testing.tty_set("stdout", false)
  harness.testing.tty_set("stderr", true)
  harness.stdio.println(is_tty(harness.term))
  harness.stdio.println(is_tty(harness.term, 0))
  harness.stdio.println(is_tty(harness.term, 1))
  harness.stdio.println(is_tty(harness.term, 2))
  harness.testing.tty_reset()
  harness.testing.stdin_set("  alpha  \nsecret\n")
  harness.term.set_color_mode("always")
  harness.testing.capture_stderr_start()
  const first = read_line(
    harness.stdio,
    {prompt: color("Q?", "cyan") + " ", timeout_ms: 50, trim: false},
  )
  const second = read_password(harness.stdio, "pw: ")
  const prompts = harness.testing.capture_stderr_take()
  harness.stdio.log(first.ok)
  harness.stdio.log(first.status)
  harness.stdio.log("[" + (first.value ?? "") + "]")
  harness.stdio.log(second.ok)
  harness.stdio.log(second.status)
  harness.stdio.log(second.value)
  harness.stdio.log(contains(json_stringify(prompts), "\\u001b[36mQ?\\u001b[0m "))
  harness.stdio.log(contains(prompts, "pw: "))
  const eof = read_line(harness.stdio)
  harness.stdio.log(eof.ok)
  harness.stdio.log(eof.status)
  harness.testing.stdin_reset()
}
