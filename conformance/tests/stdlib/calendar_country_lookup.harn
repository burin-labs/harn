import "std/calendar"

pipeline default(harness: Harness) {
  const us: CalendarCountry = country_info("us")
    ?? {
      code: "US",
      name: "missing",
      timezones: [],
      default_timezone_ambiguous: true,
      currency_code: "USD",
      currency_name: "United States dollar",
      holiday_calendars: [],
    }
  harness.stdio.println(us.name)
  harness.stdio.println(us.default_timezone == nil)
  harness.stdio.println(country_timezones("US")?.[0])
  harness.stdio.println(default_timezone_for_country("GB"))
  harness.stdio.println(default_timezone_for_country("US") == nil)
  harness.stdio.println(country_info("ZZ") == nil)
  const all_countries: list<CalendarCountry> = countries()
  harness.stdio.println(
    all_countries.find({ country -> country.code == "JP" })?.currency_code ?? "missing",
  )
}
