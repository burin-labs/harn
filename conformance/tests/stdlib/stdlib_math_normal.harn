import "std/math"

pipeline test(task) {
  const pdf0 = normal_pdf(0)
  assert(pdf0 > 0.3989)
  assert(pdf0 < 0.399)
  const cdf0 = normal_cdf(0)
  assert(cdf0 > 0.4999)
  assert(cdf0 < 0.5001)
  const q50 = normal_quantile(0.5)
  assert(abs(q50) < 0.000001)
  const q95 = normal_quantile(0.95)
  assert(q95 > 1.64)
  assert(q95 < 1.65)
  const roundtrip = normal_cdf(normal_quantile(0.95))
  assert(roundtrip > 0.9499)
  assert(roundtrip < 0.9501)
  const shifted = normal_quantile(0.5, 10, 2)
  assert(abs(shifted - 10) < 0.000001)
  log("stdlib math normal ok")
}
