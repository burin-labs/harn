import { command_run, command_run_streaming, command_wait } from "std/command"

fn mixed_command(system: HarnessSystem) {
  if system.platform().os == "windows" {
    return ["cmd", "/C", "echo out&&echo err 1>&2"]
  }
  return ["sh", "-c", "printf out; printf err >&2"]
}

fn timeout_command(system: HarnessSystem) {
  if system.platform().os == "windows" {
    return ["cmd", "/C", "echo before & ping -n 30 127.0.0.1 >NUL"]
  }
  return ["sh", "-c", "printf before; sleep 30 & wait"]
}

fn expect_eq(actual, expected, label: string) {
  if actual != expected {
    throw label + ": expected " + to_string(expected) + ", got " + to_string(actual)
  }
}

fn expect_true(actual, label: string) {
  if !actual {
    throw label + ": expected true"
  }
}

pipeline default(harness: Harness) {
  const started = command_run(
    harness.tools,
    mixed_command(harness.system),
    {background: true, capture: {max_inline_bytes: 100}},
  )
  const waited = command_wait(harness.tools, started, {timeout_ms: 5000})
  expect_eq(waited.status, "completed", "waited.status")
  expect_eq(waited.exit_code, 0, "waited.exit_code")
  expect_eq(waited.stdout, "out", "waited.stdout")
  expect_eq(waited.stderr, "err", "waited.stderr")
  const streamed = command_run_streaming(
    harness.tools,
    harness.stdio,
    mixed_command(harness.system),
    {tee: false, poll_interval_ms: 10, capture: {max_inline_bytes: 100}},
  )
  expect_eq(streamed.status, "completed", "streamed.status")
  expect_eq(streamed.exit_code, 0, "streamed.exit_code")
  expect_eq(streamed.stdout, "out", "streamed.stdout")
  expect_eq(streamed.stderr, "err", "streamed.stderr")
  const timed = command_run_streaming(
    harness.tools,
    harness.stdio,
    timeout_command(harness.system),
    {tee: false, timeout_ms: 200, poll_interval_ms: 50, capture: {max_inline_bytes: 100}},
  )
  expect_eq(timed.status, "timed_out", "timed.status")
  expect_eq(timed.timed_out, true, "timed.timed_out")
  expect_true(len(timed.stdout) > 0, "timed.stdout")
  if harness.system.platform().os != "windows" && timed?.process_group_id != nil {
    const probe = command_run(
      harness.tools,
      ["sh", "-c", "kill -0 -" + to_string(timed.process_group_id) + " 2>/dev/null"],
      {capture: {max_inline_bytes: 100}},
    )
    expect_eq(probe.success, false, "timeout process group alive")
  }
  harness.stdio.println("ok")
}
