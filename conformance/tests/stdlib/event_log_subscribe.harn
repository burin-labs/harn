pipeline default(harness: Harness) {
  const first_id = harness.obs.event_log_emit("tests.events", "one", {n: 1})
  const second_id = harness.obs.event_log_emit("tests.events", "two", {n: 2})
  const replay = harness.obs.event_log_subscribe({topic: "tests.events", from_cursor: first_id})
  const replayed = replay.next()
  harness.stdio.println(replayed.value.kind)
  harness.stdio.println(replayed.value.payload.n)
  const live = harness.obs.event_log_subscribe({topic: "tests.events", from_cursor: second_id})
  harness.obs.event_log_emit("tests.events", "three", {n: 3})
  const live_event = live.next()
  harness.stdio.println(live_event.value.kind)
  harness.stdio.println(live_event.value.cursor)
  const filtered = harness.obs.event_log_subscribe(
    {
      topic: "tests.events",
      from_cursor: live_event.value.cursor,
      kind_prefix: "transcript.reminder.",
    },
  )
  harness.obs.event_log_emit("tests.events", "other", {n: 4})
  harness.obs.event_log_emit("tests.events", "transcript.reminder.injected", {n: 5})
  const filtered_event = filtered.next()
  harness.stdio.println(filtered_event.value.kind)
  harness.stdio.println(filtered_event.value.payload.n)
}
