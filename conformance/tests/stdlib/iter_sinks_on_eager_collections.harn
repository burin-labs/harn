/**
 * Iter-style sink methods (`.to_list()`, `.to_set()`, `.to_dict()`)
 * also work on already-realized collections so that
 * `xs.filter(...).to_list()` round-trips uniformly whether `filter`
 * stayed eager (`list` → `list`) or went lazy (`iter` → `iter`).
 */
pipeline test(_task) {
  const xs = [1, 2, 3, 4]
  const allowed = [2, 4]
  const filtered = xs.filter({ x -> allowed.contains(x) }).to_list()
  assert_eq(filtered, [2, 4])
  // Identity on lists.
  const same = xs.to_list()
  assert_eq(same, xs)
  // List → set deduplicates.
  const dups = [1, 1, 2, 2, 3]
  const s = dups.to_set()
  assert_eq(len(s), 3)
  // Set → set is identity.
  const s2 = s.to_set()
  assert_eq(len(s2), 3)
  assert_eq(len(s2.to_list()), 3)
  // Dict → dict is identity; dict → list yields key/value entries.
  const d = {a: 1, b: 2}
  const same_d = d.to_dict()
  assert_eq(same_d.a, 1)
  assert_eq(same_d.b, 2)
  const entries = d.to_list()
  assert_eq(len(entries), 2)
}
