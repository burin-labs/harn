import "std/memory"

pipeline default(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-memory-hybrid-" + harness.random.uuid(),
  )
  harness.testing.clear()
  // Give distinct unit vectors per record by matching on the
  // record-key line that searchable_text emits first. The mocks are
  // checked newest-first so the more specific one wins.
  const alice_text =
    "alice\nAlice prefers Rust examples\nprofile rust\n\"Alice prefers Rust examples\""
  const bob_text = "bob\nBob prefers TypeScript\nprofile typescript\n\"Bob prefers TypeScript\""
  harness.testing.respond(
    "embed",
    "text_response",
    {vector: [0.5, 0.5], dim: 2, model: "fake"},
    nil,
    true,
  )
  harness.testing.respond(
    "embed",
    "text_response",
    {vector: [1.0, 0.0], dim: 2, model: "fake"},
    {text: alice_text},
    true,
  )
  harness.testing.respond(
    "embed",
    "text_response",
    {vector: [0.0, 1.0], dim: 2, model: "fake"},
    {text: bob_text},
    true,
  )
  harness.testing.respond(
    "embed",
    "text_response",
    {vector: [1.0, 0.0], dim: 2, model: "fake"},
    {text: "rust"},
    true,
  )
  harness.testing.respond(
    "embed",
    "text_response",
    {vector: [0.0, 1.0], dim: 2, model: "fake"},
    {text: "typescript"},
    true,
  )
  memory_open(
    harness.memory,
    "agent/hybrid",
    {
      backend: "hybrid",
      embed_dim: 2,
      embed_model_hint: "fake",
      bm25_weight: 0.0,
      cosine_weight: 1.0,
      root: root,
    },
  )
  memory_store(
    harness.memory,
    "agent/hybrid",
    "alice",
    "Alice prefers Rust examples",
    ["profile", "rust"],
    {root: root, now: "2026-05-15T00:00:00Z"},
  )
  memory_store(
    harness.memory,
    "agent/hybrid",
    "bob",
    "Bob prefers TypeScript",
    ["profile", "typescript"],
    {root: root, now: "2026-05-15T00:00:01Z"},
  )
  // Cosine-only weights → query "rust" routes to alice via the explicit
  // mocked vector.
  const rust_hits = memory_recall(harness.memory, "agent/hybrid", "rust", 5, {root: root})
  harness.stdio.println(rust_hits[0].key)
  harness.stdio.println(rust_hits[0].score >= 0.999)
  // Semantic override picks the same record regardless of namespace
  // hybrid config.
  const semantic_only = memory_recall(
    harness.memory,
    "agent/hybrid",
    "typescript",
    5,
    {root: root, mode: "semantic"},
  )
  harness.stdio.println(semantic_only[0].key)
  // Lexical override drops cosine entirely; BM25 on "rust" matches alice
  // by tag boost.
  const lexical = memory_recall(
    harness.memory,
    "agent/hybrid",
    "rust",
    5,
    {root: root, mode: "lexical"},
  )
  harness.stdio.println(lexical[0].key)
  // Re-open with a different default mode flips the default behavior.
  memory_open(harness.memory, "agent/hybrid", {backend: "bm25", root: root})
  const default_now_lexical = memory_recall(
    harness.memory,
    "agent/hybrid",
    "typescript",
    5,
    {root: root},
  )
  harness.stdio.println(default_now_lexical[0].key)
  harness.fs.delete(root)
}
