import "std/postgres"

/**
 * pg_notify routes through execute_stmt, which the mock pool intercepts.
 * The test asserts pg_notify serializes its payload as JSON and binds
 * (channel, payload) into the synthesized SQL `SELECT pg_notify($1, $2)`.
 */
pipeline default(harness: Harness) {
  const db = pg_mock_pool(
    [
      {
        sql: "SELECT pg_notify($1, $2)",
        params: ["receipts_updated", "{\"id\":\"r1\"}"],
        rows_affected: 0,
      },
      {sql: "SELECT pg_notify($1, $2)", params: ["greetings", "hello"], rows_affected: 0},
    ],
  )
  harness.stdio.println(pg_notify(db, "receipts_updated", {id: "r1"}))
  harness.stdio.println(pg_notify(db, "greetings", "hello"))
  const calls = pg_mock_calls(db)
  harness.stdio.println(len(calls))
  for call in calls {
    harness.stdio.println(call.params[0])
  }
}
