pipeline test(task) {
  host_call(
    "project.metadata_set",
    {
      dir: "zig",
      namespace: "build_gotchas",
      value: {gotchas: ["use .map.count() on ArrayHashMap"]},
    },
  )
  const exact = host_call("project.metadata_get", {dir: "zig", namespace: "build_gotchas"})
  assert_eq(exact.gotchas[0], "use .map.count() on ArrayHashMap")
  const inherited = host_call("project.metadata_get", {dir: "zig/src", namespace: "build_gotchas"})
  assert_eq(inherited.gotchas[0], "use .map.count() on ArrayHashMap")
  const all = host_call("project.metadata_get", {dir: "zig/src"})
  assert_eq(all.build_gotchas.gotchas[0], "use .map.count() on ArrayHashMap")
  const inspect = host_call(
    "project.metadata_inspect",
    {dir: "zig/src", namespace: "build_gotchas", key: "gotchas"},
  )
  assert_eq(inspect.origin_dir, "zig")
  assert_eq(inspect.inspected_dir, "zig")
  assert_eq(inspect.resolved.gotchas[0], "use .map.count() on ArrayHashMap")
  assert_eq(inspect.origin.gotchas[0], "use .map.count() on ArrayHashMap")
  assert_eq(inspect.missing_structure_hash, true)
  assert_eq(inspect.missing_content_hash, true)
  assert_eq(inspect.stale_tier1, false)
  assert_eq(inspect.stale_tier2, false)
  const all_inspect = host_call("project.metadata_inspect", {dir: "zig/src"})
  assert_eq(all_inspect.resolved.build_gotchas.gotchas[0], "use .map.count() on ArrayHashMap")
  assert_eq(all_inspect.origin, nil)
  host_call("project.metadata_set", {dir: ".", namespace: "note", value: "standalone"})
  const bare = host_call("project.metadata_get", {dir: ".", namespace: "note"})
  assert_eq(bare.note, "standalone")
  const direct = metadata_get("zig/src", "build_gotchas")
  assert_eq(direct.gotchas[0], "use .map.count() on ArrayHashMap")
  const stale = host_call("project.metadata_stale", {dir: "zig"})
  assert_eq(type_of(stale.tier1), "list")
  assert_eq(type_of(stale.tier2), "list")
  host_call("project.metadata_refresh_hashes", {dir: "zig"})
  host_call("project.metadata_save", {})
  log("host project metadata fallback ok")
}
