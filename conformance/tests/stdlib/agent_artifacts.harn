import "std/agent/artifacts"
import "std/artifacts/typed"

// Runtime-produced agent-result.json bytes (legacy: no schema_version field).
const LEGACY_RESULT =
  "{\"final_status\":\"done\",\"session_id\":\"s-1\",\"status\":\"done\",\"stop_reason\":\"end_turn\"}"

const V2_RESULT =
  "{\"final_status\":\"done\",\"schema_version\":2,\"session_id\":\"s-2\",\"status\":\"done\",\"stop_reason\":\"end_turn\"}"

const WRONG_VERSION_RESULT =
  "{\"final_status\":\"done\",\"schema_version\":99,\"session_id\":\"s-9\",\"status\":\"done\",\"stop_reason\":\"end_turn\"}"

// Valid JSON, legacy version, but missing the required session_id field.
const INVALID_RESULT =
  "{\"final_status\":\"done\",\"status\":\"done\",\"stop_reason\":\"end_turn\"}"

// llm_transcript.jsonl lines mirroring the runtime observability writer.
const EVENT_SYSTEM =
  "{\"content\":\"you are helpful\",\"content_hash\":\"c1\",\"hash\":\"h1\",\"timestamp\":\"1.0\",\"type\":\"system_prompt\"}"

const EVENT_CONTEXT_MANIFEST =
  "{\"content_hash\":\"cm1\",\"hash\":1,\"manifest\":{\"boundary\":\"observed_llm_call_pre_egress\",\"call_role\":\"agent.main\",\"join_separator\":\"\\n\\n\",\"join_separator_bytes\":2,\"join_separator_count\":0,\"messages\":\"served_context_digest_only\",\"root\":\"composed\",\"schema\":\"harn.llm.context_manifest.v1\",\"scope\":\"system_prompt\",\"segments\":[{\"bucket\":\"before\",\"bytes\":15,\"digest\":\"blake3:segment\",\"id\":\"primary\",\"included\":true,\"producer\":\"agent_loop\",\"reason\":\"unconditional\"}],\"system_prompt_bytes\":15,\"whole_prompt_digest\":\"blake3:whole\"},\"timestamp\":\"1.5\",\"type\":\"context_manifest\"}"

const EVENT_REQUEST =
  "{\"call_id\":\"c1\",\"call_role\":\"agent.main\",\"iteration\":1,\"message_count\":2,\"model\":\"m\",\"provider\":\"p\",\"timestamp\":\"2.0\",\"tool_format\":\"native\",\"type\":\"provider_call_request\"}"

const EVENT_RESPONSE =
  "{\"call_id\":\"c1\",\"input_tokens\":10,\"iteration\":1,\"model\":\"m\",\"output_tokens\":5,\"provider\":\"p\",\"stop_reason\":\"end_turn\",\"text\":\"hi\",\"timestamp\":\"3.0\",\"type\":\"provider_call_response\"}"

const EVENT_FUTURE = "{\"payload\":123,\"timestamp\":\"4.0\",\"type\":\"future_event\"}"

const EVENT_MALFORMED = "{bad"

const EVENT_BAD_SCHEMA =
  "{\"call_id\":\"c2\",\"input_tokens\":\"lots\",\"iteration\":2,\"model\":\"m\",\"output_tokens\":5,\"provider\":\"p\",\"timestamp\":\"6.0\",\"type\":\"provider_call_response\"}"

const EVENT_BAD_VERSION =
  "{\"content\":\"x\",\"content_hash\":\"c\",\"hash\":\"h\",\"schema_version\":99,\"timestamp\":\"7.0\",\"type\":\"system_prompt\"}"

pipeline test(harness: Harness, task) {
  const root = path_join(harness.fs.workspace_temp_dir(), "harn-agent-artifacts-" + harness.random.uuid_v7())
  harness.fs.mkdir(root)
  // ---- Agent result JSON reader: the six distinct outcomes + byte round trip.
  const legacy_path = path_join(root, "agent-result.json")
  harness.fs.write_text(legacy_path, LEGACY_RESULT)
  const legacy = read_agent_result_result(harness, legacy_path)
  harness.stdio.println(is_ok(legacy))
  harness.stdio.println(to_string(unwrap(legacy).version))
  harness.stdio.println(unwrap(legacy).value.status)
  harness.stdio.println(unwrap(legacy).value.session_id)
  harness.stdio.println(unwrap(legacy).raw == LEGACY_RESULT)
  const v2_path = path_join(root, "v2.json")
  harness.fs.write_text(v2_path, V2_RESULT)
  harness.stdio.println(to_string(unwrap(read_agent_result_result(harness, v2_path)).version))
  const wrong_path = path_join(root, "wrong.json")
  harness.fs.write_text(wrong_path, WRONG_VERSION_RESULT)
  const wrong = read_agent_result_result(harness, wrong_path)
  harness.stdio.println(unwrap_err(wrong).kind)
  harness.stdio.println(to_string(unwrap_err(wrong).found_version))
  const invalid_path = path_join(root, "invalid.json")
  harness.fs.write_text(invalid_path, INVALID_RESULT)
  harness.stdio.println(unwrap_err(read_agent_result_result(harness, invalid_path)).kind)
  const malformed_path = path_join(root, "malformed.json")
  harness.fs.write_text(malformed_path, EVENT_MALFORMED)
  harness.stdio.println(unwrap_err(read_agent_result_result(harness, malformed_path)).kind)
  harness.stdio.println(unwrap_err(read_agent_result_result(harness, path_join(root, "missing.json"))).kind)
  // ---- Transcript JSONL: recognized families, unknown envelope, per-record issues.
  const transcript_path = path_join(root, "llm_transcript.jsonl")
  harness.fs.write_text(
    transcript_path,
    EVENT_SYSTEM
      + "\n"
      + EVENT_CONTEXT_MANIFEST
      + "\n"
      + EVENT_REQUEST
      + "\n"
      + EVENT_RESPONSE
      + "\n"
      + EVENT_FUTURE
      + "\n"
      + EVENT_MALFORMED
      + "\n"
      + EVENT_BAD_SCHEMA
      + "\n"
      + EVENT_BAD_VERSION
      + "\n",
  )
  const page = unwrap(read_transcript_events_page_result(harness, transcript_path))
  harness.stdio.println(to_string(len(page.events)))
  harness.stdio.println(to_string(len(page.issues)))
  harness.stdio.println(to_string(page.events[0].recognized) + ":" + page.events[0].tag)
  harness.stdio.println(to_string(page.events[0].version))
  harness.stdio.println(page.events[0].raw == EVENT_SYSTEM)
  harness.stdio.println(to_string(page.events[1].recognized) + ":" + page.events[1].tag)
  harness.stdio.println(page.events[1].value.manifest.call_role)
  harness.stdio.println(to_string(page.events[4].recognized) + ":" + page.events[4].tag)
  harness.stdio.println(page.events[4].raw == EVENT_FUTURE)
  harness.stdio.println(page.issues[0].kind + ":" + to_string(page.issues[0].line))
  harness.stdio.println(page.issues[1].kind + ":" + to_string(page.issues[1].line))
  harness.stdio.println(
    page.issues[2].kind
      + ":"
      + to_string(page.issues[2].line)
      + ":"
      + to_string(page.issues[2].found_version),
  )
  harness.stdio.println(to_string(page.done))
  // ---- Derived transcript context, folded from the same stream.
  const context = unwrap(read_transcript_context_result(harness, transcript_path))
  harness.stdio.println(to_string(context.version))
  harness.stdio.println(to_string(context.value.event_count))
  harness.stdio.println(context.value.system_prompt)
  harness.stdio.println(to_string(context.value.provider) + ":" + to_string(context.value.model))
  harness.stdio.println(context.value.tool_format)
  harness.stdio.println(
    to_string(context.value.request_count)
      + ":"
      + to_string(context.value.response_count)
      + ":"
      + to_string(context.value.unknown_count),
  )
  // ---- Pure contract check surfaces the same distinct kinds without a file.
  const parsed_ok = check_versioned(json_parse(LEGACY_RESULT), agent_result_contract())
  harness.stdio.println(is_ok(parsed_ok))
  const parsed_bad = check_versioned(json_parse(WRONG_VERSION_RESULT), agent_result_contract())
  harness.stdio.println(unwrap_err(parsed_bad).kind)
  harness.fs.delete(root)
}
