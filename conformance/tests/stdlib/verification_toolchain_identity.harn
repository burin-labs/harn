import { verification_toolchain_facts } from "std/verification"

pipeline test(task) {
  let facts = verification_toolchain_facts(
    [
      {
        id: "go/unit",
        name: "go",
        versionProbe: {
          spec: {mode: "shell", command: "echo go version go1.23.4 darwin/arm64"},
          versionPattern: "go([0-9]+\\.[0-9]+\\.[0-9]+)",
        },
        cacheIdentity: {GOFLAGS: "-buildvcs=false", GOCACHE: "/tmp/harn-go-cache"},
      },
      {
        id: "zig/unit",
        name: "zig",
        versionProbe: {spec: {mode: "shell", command: "echo 0.16.0"}, versionPattern: "([0-9]+\\.[0-9]+\\.[0-9]+)"},
        cacheIdentity: {ZIG_LOCAL_CACHE_DIR: "/tmp/harn-zig-cache"},
      },
      {
        id: "missing/unit",
        name: "missing-tool",
        versionProbe: {spec: {mode: "shell", command: "exit 7"}},
        cacheIdentity: {cache: "none"},
      },
    ],
    {command_options: {capture: {max_inline_bytes: 4096}}},
  )
  assert_eq(len(facts), 3)
  assert_eq(facts[0].id, "go/unit")
  assert_eq(facts[0].available, true)
  assert_eq(facts[0].version, "1.23.4")
  assert_eq(facts[0].cache_identity.GOFLAGS, "-buildvcs=false")
  assert_eq(facts[1].name, "zig")
  assert_eq(facts[1].available, true)
  assert_eq(facts[1].version, "0.16.0")
  assert_eq(facts[1].cache_identity.ZIG_LOCAL_CACHE_DIR, "/tmp/harn-zig-cache")
  assert_eq(facts[2].available, false)
  assert_eq(facts[2].version, nil)
  assert_eq(facts[2].probe.exit, 7)
  __io_println("verification toolchain identity ok")
}
