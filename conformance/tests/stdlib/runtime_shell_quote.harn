import { process_result_success, shell_quote } from "std/runtime"

pipeline default() {
  println(shell_quote("simple"))
  println(shell_quote("two words"))
  println(shell_quote("can't"))
  println(shell_quote(""))
  println(shell_quote(nil))
  println(process_result_success({status: "completed", exit_code: 0}))
  println(process_result_success({status: "failed", exit_code: 0}))
  println(process_result_success({success: false, status: "completed", exit_code: 0}))
}
