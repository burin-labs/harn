/**
 * CH-08 (#1879): pipeline-scoped emits with an explicit `pipeline_id` route
 * through the same `channels.pipeline.<id>.<name>` topic, so sibling
 * readers in the same pipeline see each others' emits. Distinct
 * `pipeline_id` values are isolated — the resolver namespaces by id, so a
 * sibling reader on pipeline P2 cannot see emits made on P1.
 */
pipeline default() {
  const _ = emit_channel(
    "stage.done",
    {stage: "build"},
    {scope: "pipeline", pipeline_id: "pipe-A", id: "pA-1"},
  )
  const _ = emit_channel(
    "stage.done",
    {stage: "test"},
    {scope: "pipeline", pipeline_id: "pipe-A", id: "pA-2"},
  )
  const _ = emit_channel(
    "stage.done",
    {stage: "build"},
    {scope: "pipeline", pipeline_id: "pipe-B", id: "pB-1"},
  )
  const pipe_a = channel_events("stage.done", {scope: "pipeline", pipeline_id: "pipe-A"})
  const pipe_b = channel_events("stage.done", {scope: "pipeline", pipeline_id: "pipe-B"})
  const pipe_c = channel_events("stage.done", {scope: "pipeline", pipeline_id: "pipe-C"})
  __io_println(len(pipe_a))
  __io_println(pipe_a[0].payload.stage)
  __io_println(pipe_a[1].payload.stage)
  __io_println(pipe_a[0].scope)
  __io_println(pipe_a[0].scope_id)
  __io_println(len(pipe_b))
  __io_println(pipe_b[0].payload.stage)
  // Pipeline C never emitted — its sibling view is empty.
  __io_println(len(pipe_c))
}
