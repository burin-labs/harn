import "std/edit"

/**
 * End-to-end exercise of `edit_insert_at_anchor` (issue #2507). Drives
 * `hostlib_ast_insert_at_anchor` through the std/edit wrapper across
 * Rust + TypeScript fixtures plus every position + failure mode.
 */
fn write_fixture(dir: string, name: string, body: string) -> string {
  let path = path_join(dir, name)
  harness.fs.write_text(path, body)
  return path
}

pipeline default() {
  let root = path_join(
    harness.fs.temp_dir(),
    "harn_edit_insert_at_anchor_" + to_string(harness.random.gen_range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  // 1) Rust: append a sibling function after `alpha`.
  let rs_path = write_fixture(root, "rs_lib.rs", "fn alpha() {\n    1\n}\n\nfn gamma() {\n    3\n}\n")
  let rs_after = edit_insert_at_anchor(
    {
      path: rs_path,
      query: "(function_item name: (identifier) @name (#eq? @name \"alpha\")) @anchor",
      position: "after",
      content: "fn beta() {\n    2\n}",
    },
  )
  __io_println(rs_after.applied && rs_after.result == "applied")
  __io_println(rs_after.position == "after")
  let rs_text = harness.fs.read_text(rs_path)
  let alpha_idx = rs_text.index_of("fn alpha()")
  let beta_idx = rs_text.index_of("fn beta()")
  let gamma_idx = rs_text.index_of("fn gamma()")
  __io_println(alpha_idx >= 0 && beta_idx >= 0 && gamma_idx >= 0)
  __io_println(alpha_idx < beta_idx && beta_idx < gamma_idx)
  // 2) TypeScript: insert a new import before an existing one (before
  //    position at the file's top level).
  let ts_path = write_fixture(
    root,
    "ts_lib.ts",
    "import { a } from \"./a\";\nimport { b } from \"./b\";\n\nconst x = 1;\n",
  )
  let ts_before = edit_insert_at_anchor(
    {
      path: ts_path,
      query: "(import_statement source: (string (string_fragment) @src) (#eq? @src \"./b\")) @anchor",
      position: "before",
      content: "import { aa } from \"./aa\";",
    },
  )
  __io_println(ts_before.applied)
  let ts_text = harness.fs.read_text(ts_path)
  let aa_idx = ts_text.index_of("./aa")
  let b_idx = ts_text.index_of("./b\"")
  __io_println(aa_idx >= 0 && b_idx >= 0 && aa_idx < b_idx)
  // 3) Rust: append a new test as last_child of a `mod tests` body.
  let mod_path = write_fixture(root, "mod_tests.rs", "#[cfg(test)]\nmod tests {\n    #[test]\n    fn one() {}\n}\n")
  let mod_after = edit_insert_at_anchor(
    {
      path: mod_path,
      query: "(mod_item name: (identifier) @name (#eq? @name \"tests\") body: (declaration_list) @anchor)",
      position: "last_child",
      content: "#[test]\nfn two() {}",
    },
  )
  __io_println(mod_after.applied && mod_after.position == "last_child")
  let mod_text = harness.fs.read_text(mod_path)
  let one_idx = mod_text.index_of("fn one()")
  let two_idx = mod_text.index_of("fn two()")
  __io_println(one_idx >= 0 && two_idx >= 0 && one_idx < two_idx)
  __io_println(contains(mod_text, "    #[test]\n    fn two() {}"))
  // 4) TypeScript: first_child on an empty body inserts at child depth.
  let noop_path = write_fixture(root, "noop.ts", "function noop() {}\n")
  let noop_after = edit_insert_at_anchor(
    {
      path: noop_path,
      query: "(function_declaration body: (statement_block) @anchor)",
      position: "first_child",
      content: "return 1;",
    },
  )
  __io_println(noop_after.applied)
  __io_println(contains(harness.fs.read_text(noop_path), "return 1;"))
  // 5) Ambiguous anchor (multi-match) is rejected — the issue spec
  //    requires uniqueness.
  let multi_path = write_fixture(root, "multi.rs", "fn a() { 1 }\nfn b() { 2 }\n")
  let ambiguous = edit_insert_at_anchor(
    {path: multi_path, query: "(function_item) @anchor", position: "after", content: "fn c() {}"},
  )
  __io_println(!ambiguous.applied && ambiguous.result == "ambiguous")
  __io_println(ambiguous.match_count == 2)
  // 6) Syntax-error rejection: file is left untouched on validation
  //    failure (e.g. unbalanced braces in the inserted content).
  let broken_path = write_fixture(root, "broken.rs", "fn one() {}\n")
  let broken_before = harness.fs.read_text(broken_path)
  let broken = edit_insert_at_anchor(
    {
      path: broken_path,
      query: "(function_item name: (identifier) @name (#eq? @name \"one\")) @anchor",
      position: "after",
      content: "fn busted( {",
    },
  )
  __io_println(!broken.applied && broken.result == "syntax_error")
  __io_println(harness.fs.read_text(broken_path) == broken_before)
  // 7) Invalid tree-sitter query surfaces a structured error.
  let bad_query = edit_insert_at_anchor({path: rs_path, query: "((((", position: "after", content: "fn x() {}"})
  __io_println(!bad_query.applied && bad_query.result == "invalid_query")
  // 8) Dry-run leaves the file untouched but returns a preview.
  let dry_path = write_fixture(root, "dry.rs", "fn alpha() {}\n")
  let dry_before = harness.fs.read_text(dry_path)
  let dry = edit_insert_at_anchor(
    {
      path: dry_path,
      query: "(function_item name: (identifier) @name (#eq? @name \"alpha\")) @anchor",
      position: "after",
      content: "fn beta() {}",
      dry_run: true,
    },
  )
  __io_println(dry.applied && dry.dry_run)
  __io_println(contains(dry.preview, "fn beta()"))
  __io_println(harness.fs.read_text(dry_path) == dry_before)
}
