import "std/edit"

/**
 * End-to-end exercise of `edit_insert_at_anchor` (issue #2507). Drives
 * `hostlib_ast_insert_at_anchor` through the std/edit wrapper across
 * Rust + TypeScript fixtures plus every position + failure mode.
 */
fn write_fixture(fs: HarnessFs, dir: string, name: string, body: string) -> string {
  const path = path_join(dir, name)
  fs.write_text(path, body)
  return path
}

pipeline default(harness: Harness) {
  // `hostlib_ast_insert_at_anchor` writes edited source to disk, so it
  // requires the deterministic-tools feature gate (issue #2548).
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn_edit_insert_at_anchor_" + to_string(harness.random.range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  // 1) Rust: append a sibling function after `alpha`.
  const rs_path = write_fixture(
    harness.fs,
    root,
    "rs_lib.rs",
    "fn alpha() {\n    1\n}\n\nfn gamma() {\n    3\n}\n",
  )
  const rs_after = edit_insert_at_anchor(
    harness.ast,
    {
      path: rs_path,
      query: "(function_item name: (identifier) @name (#eq? @name \"alpha\")) @anchor",
      position: "after",
      content: "fn beta() {\n    2\n}",
    },
  )
  harness.stdio.println(rs_after.applied && rs_after.result == "applied")
  harness.stdio.println(rs_after.position == "after")
  const rs_text = harness.fs.read_text(rs_path)
  const alpha_idx = rs_text.index_of("fn alpha()")
  const beta_idx = rs_text.index_of("fn beta()")
  const gamma_idx = rs_text.index_of("fn gamma()")
  harness.stdio.println(alpha_idx >= 0 && beta_idx >= 0 && gamma_idx >= 0)
  harness.stdio.println(alpha_idx < beta_idx && beta_idx < gamma_idx)
  // 2) TypeScript: insert a new import before an existing one (before
  //    position at the file's top level).
  const ts_path = write_fixture(
    harness.fs,
    root,
    "ts_lib.ts",
    "import { a } from \"./a\";\nimport { b } from \"./b\";\n\nconst x = 1;\n",
  )
  const ts_before = edit_insert_at_anchor(
    harness.ast,
    {
      path: ts_path,
      query:
        "(import_statement source: (string (string_fragment) @src) (#eq? @src \"./b\")) @anchor",
      position: "before",
      content: "import { aa } from \"./aa\";",
    },
  )
  harness.stdio.println(ts_before.applied)
  const ts_text = harness.fs.read_text(ts_path)
  const aa_idx = ts_text.index_of("./aa")
  const b_idx = ts_text.index_of("./b\"")
  harness.stdio.println(aa_idx >= 0 && b_idx >= 0 && aa_idx < b_idx)
  // 3) Rust: append a new test as last_child of a `mod tests` body.
  const mod_path = write_fixture(
    harness.fs,
    root,
    "mod_tests.rs",
    "#[cfg(test)]\nmod tests {\n    #[test]\n    fn one() {}\n}\n",
  )
  const mod_after = edit_insert_at_anchor(
    harness.ast,
    {
      path: mod_path,
      query:
        "(mod_item name: (identifier) @name (#eq? @name \"tests\") body: (declaration_list) @anchor)",
      position: "last_child",
      content: "#[test]\nfn two() {}",
    },
  )
  harness.stdio.println(mod_after.applied && mod_after.position == "last_child")
  const mod_text = harness.fs.read_text(mod_path)
  const one_idx = mod_text.index_of("fn one()")
  const two_idx = mod_text.index_of("fn two()")
  harness.stdio.println(one_idx >= 0 && two_idx >= 0 && one_idx < two_idx)
  harness.stdio.println(contains(mod_text, "    #[test]\n    fn two() {}"))
  // 4) TypeScript: first_child on an empty body inserts at child depth.
  const noop_path = write_fixture(harness.fs, root, "noop.ts", "function noop() {}\n")
  const noop_after = edit_insert_at_anchor(
    harness.ast,
    {
      path: noop_path,
      query: "(function_declaration body: (statement_block) @anchor)",
      position: "first_child",
      content: "return 1;",
    },
  )
  harness.stdio.println(noop_after.applied)
  harness.stdio.println(contains(harness.fs.read_text(noop_path), "return 1;"))
  // 5) Ambiguous anchor (multi-match) is rejected — the issue spec
  //    requires uniqueness.
  const multi_path = write_fixture(harness.fs, root, "multi.rs", "fn a() { 1 }\nfn b() { 2 }\n")
  const ambiguous = edit_insert_at_anchor(
    harness.ast,
    {path: multi_path, query: "(function_item) @anchor", position: "after", content: "fn c() {}"},
  )
  harness.stdio.println(!ambiguous.applied && ambiguous.result == "ambiguous")
  harness.stdio.println(ambiguous.match_count == 2)
  // 6) Syntax-error rejection: file is left untouched on validation
  //    failure (e.g. unbalanced braces in the inserted content).
  const broken_path = write_fixture(harness.fs, root, "broken.rs", "fn one() {}\n")
  const broken_before = harness.fs.read_text(broken_path)
  const broken = edit_insert_at_anchor(
    harness.ast,
    {
      path: broken_path,
      query: "(function_item name: (identifier) @name (#eq? @name \"one\")) @anchor",
      position: "after",
      content: "fn busted( {",
    },
  )
  harness.stdio.println(!broken.applied && broken.result == "syntax_error")
  harness.stdio.println(harness.fs.read_text(broken_path) == broken_before)
  // 7) Invalid tree-sitter query surfaces a structured error.
  const bad_query = edit_insert_at_anchor(
    harness.ast,
    {path: rs_path, query: "((((", position: "after", content: "fn x() {}"},
  )
  harness.stdio.println(!bad_query.applied && bad_query.result == "invalid_query")
  // 8) Dry-run leaves the file untouched but returns a preview.
  const dry_path = write_fixture(harness.fs, root, "dry.rs", "fn alpha() {}\n")
  const dry_before = harness.fs.read_text(dry_path)
  const dry = edit_insert_at_anchor(
    harness.ast,
    {
      path: dry_path,
      query: "(function_item name: (identifier) @name (#eq? @name \"alpha\")) @anchor",
      position: "after",
      content: "fn beta() {}",
      dry_run: true,
    },
  )
  harness.stdio.println(dry.applied && dry.dry_run)
  harness.stdio.println(contains(dry.preview, "fn beta()"))
  harness.stdio.println(harness.fs.read_text(dry_path) == dry_before)
}
