import { coord_cursor, coord_reply, coord_request, coord_wait_reply } from "std/coordination"

pipeline default(harness: Harness) {
  mock_time(5000)
  const opts = {workspace_id: "workspace-A", tenant_id: "tenant-A"}
  const q1 = coord_request(
    harness.channels, "workspace",
    "peer-intent",
    "agent-A",
    {
      subject: "intent_query",
      body: "Do you still need these paths?",
      from: {session_id: "agent-B"},
      data: {paths: ["src/**"]},
    },
    opts + {id: "coord-request-1"},
  )
  const q2 = coord_request(
    harness.channels, "workspace",
    "peer-intent",
    "agent-A",
    {
      subject: "intent_query",
      body: "Do you still need these paths?",
      from: {session_id: "agent-B"},
      data: {paths: ["tests/**"]},
    },
    opts + {id: "coord-request-2"},
  )
  harness.stdio.println(q1.message.kind)
  harness.stdio.println(q1.message.subject)
  harness.stdio.println(q1.message.thread_id)
  harness.stdio.println(q1.message.to)
  harness.stdio.println(q1.message.from.session_id)
  harness.stdio.println(q1.message.data.paths[0])
  const _ = coord_reply(
    harness.channels, "workspace",
    "peer-intent",
    q1,
    {
      kind: "decision",
      subject: "not_the_verdict",
      body: "Wrong subject.",
      from: {session_id: "agent-A"},
      data: {verdict: "keep"},
    },
    opts + {id: "coord-unrelated-reply"},
  )
  const _ = coord_reply(
    harness.channels, "workspace",
    "peer-intent",
    q1,
    {
      kind: "decision",
      subject: "intent_verdict",
      body: "The paths are released.",
      from: {session_id: "agent-A"},
      data: {verdict: "release"},
    },
    opts + {id: "coord-reply-1"},
  )
  const _ = coord_reply(
    harness.channels, "workspace",
    "peer-intent",
    q2,
    {
      kind: "decision",
      subject: "intent_verdict",
      body: "Still using those paths.",
      from: {session_id: "agent-A"},
      data: {verdict: "keep"},
    },
    opts + {id: "coord-reply-2"},
  )
  const wait1 = coord_wait_reply(
    harness.channels, "workspace",
    "peer-intent",
    q1,
    opts
      + {
      response_kind: "decision",
      response_subject: "intent_verdict",
      response_from: "agent-A",
      timeout_ms: 0,
      ack: true,
    },
  )
  harness.stdio.println(wait1.status)
  harness.stdio.println(wait1.consumer_id)
  harness.stdio.println(wait1.reply.subject)
  harness.stdio.println(wait1.reply.data.verdict)
  harness.stdio.println(wait1.acknowledged.consumer_id)
  harness.stdio.println(
    coord_cursor(harness.channels, "workspace", "peer-intent", "reply.coord-request-1", opts) == wait1.next_cursor,
  )
  const after_ack = coord_wait_reply(
    harness.channels, "workspace",
    "peer-intent",
    q1,
    opts
      + {
      response_kind: "decision",
      response_subject: "intent_verdict",
      response_from: "agent-A",
      timeout_ms: 0,
    },
  )
  harness.stdio.println(after_ack.status)
  const wait2 = coord_wait_reply(
    harness.channels, "workspace",
    "peer-intent",
    q2,
    opts
      + {
      response_kind: "decision",
      response_subject: "intent_verdict",
      response_from: "agent-A",
      timeout_ms: 0,
    },
  )
  harness.stdio.println(wait2.status)
  harness.stdio.println(wait2.consumer_id)
  harness.stdio.println(wait2.reply.data.verdict)
  const timeout = coord_wait_reply(
    harness.channels, "workspace",
    "peer-intent",
    "coord-missing",
    opts + {timeout_ms: 120, poll_interval_ms: 50},
  )
  harness.stdio.println(timeout.status)
  harness.stdio.println(timeout.consumer_id)
  harness.stdio.println(timeout.elapsed_ms >= 120)
  unmock_time()
}
