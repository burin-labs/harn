import {
  connector_http_header,
  connector_http_json,
  connector_http_rate_limit,
  connector_http_request,
} from "std/connectors/http"

pipeline test(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/get-retry",
    {responses: [{status: 503, body: "busy"}, {status: 200, body: "ok"}]},
  )
  const get_retry = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/get-retry",
    {retry: {max_attempts: 2, base_ms: 0, cap_ms: 1}},
  )
  const get_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(get_retry.ok, true)
  assert_eq(get_retry.status, 200)
  assert_eq(len(get_calls), 2)
  harness.stdio.println(
    "get_retry:" + to_string(get_retry.status) + ":" + to_string(len(get_calls)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    "https://api.example.com/connector/post-no-idempotency",
    {responses: [{status: 503, body: "busy"}, {status: 201, body: "created"}]},
  )
  const post_no_idem = connector_http_request(
    harness.clock,
    harness.net,
    "POST",
    "https://api.example.com/connector/post-no-idempotency",
    {body: "{}", retry: {max_attempts: 2, base_ms: 0, cap_ms: 1}},
  )
  const post_no_idem_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(post_no_idem.ok, false)
  assert_eq(post_no_idem.error.category, "overloaded")
  assert_eq(len(post_no_idem_calls), 1)
  harness.stdio.println(
    "post_no_idem:" + post_no_idem.error.category + ":" + to_string(len(post_no_idem_calls)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    "https://api.example.com/connector/post-idempotency",
    {responses: [{status: 503, body: "busy"}, {status: 201, body: "created"}]},
  )
  const post_idem = connector_http_request(
    harness.clock,
    harness.net,
    "POST",
    "https://api.example.com/connector/post-idempotency",
    {body: "{}", idempotency_key: "idem-1", retry: {max_attempts: 2, base_ms: 0, cap_ms: 1}},
  )
  const post_idem_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(post_idem.ok, true)
  assert_eq(post_idem.status, 201)
  assert_eq(len(post_idem_calls), 2)
  assert_eq(post_idem_calls[0].headers["idempotency-key"], "idem-1")
  harness.stdio.println(
    "post_idem:"
      + to_string(post_idem.status)
      + ":"
      + to_string(len(post_idem_calls))
      + ":"
      + post_idem_calls[0].headers["idempotency-key"],
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    "https://api.example.com/connector/post-preserve-idempotency",
    {status: 200, body: "ok"},
  )
  const preserved = connector_http_request(
    harness.clock,
    harness.net,
    "POST",
    "https://api.example.com/connector/post-preserve-idempotency",
    {
      body: "{}",
      headers: {"idempotency-key": "caller-key"},
      idempotency_key: "ignored",
      retry: {max_attempts: 1},
    },
  )
  const preserved_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(preserved.ok, true)
  assert_eq(preserved_calls[0].headers["idempotency-key"], "caller-key")
  harness.stdio.println("preserve_idem:" + preserved_calls[0].headers["idempotency-key"])
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/retry-after-cap",
    {
      responses: [
        {status: 429, body: "limited", headers: {"Retry-After": "5"}},
        {status: 200, body: "ok"},
      ],
    },
  )
  const capped = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/retry-after-cap",
    {retry: {max_attempts: 2, base_ms: 0, cap_ms: 1}},
  )
  const capped_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(capped.ok, false)
  assert_eq(capped.error.category, "rate_limit")
  assert_eq(capped.error.retry_after_ms, 5000)
  assert_eq(len(capped_calls), 1)
  harness.stdio.println(
    "retry_after_cap:" + to_string(capped.error.retry_after_ms) + ":"
      + to_string(len(capped_calls)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/json-invalid",
    {status: 200, body: "not json"},
  )
  const invalid_json = connector_http_json(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/json-invalid",
    {provider: "example", operation: "parse"},
  )
  assert_eq(invalid_json.ok, false)
  assert_eq(invalid_json.error.category, "invalid_json")
  assert_eq(invalid_json.error.status, 200)
  assert_eq(invalid_json.error.provider, "example")
  harness.stdio.println(
    "invalid_json:" + invalid_json.error.category + ":" + invalid_json.error.provider,
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/json-empty",
    {status: 204, body: ""},
  )
  const empty_json = connector_http_json(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/json-empty",
  )
  assert_eq(empty_json.ok, true)
  assert_eq(empty_json.body, "")
  assert_eq(empty_json.json, nil)
  harness.stdio.println(
    "empty_json:" + to_string(empty_json.status) + ":" + to_string(empty_json.body == ""),
  )
  const headers = {
    "Retry-After": "2",
    "RateLimit-Limit": "100",
    "X-RateLimit-Remaining": "0",
    "X-RateLimit-Reset": "4102444800",
  }
  const rate = connector_http_rate_limit(harness.clock, {headers: headers})
  harness.testing.clock_set(0)
  const http_date_rate = connector_http_rate_limit(
    harness.clock,
    {headers: {"Retry-After": "Thu, 01 Jan 1970 00:00:03 GMT"}},
  )
  harness.testing.clock_reset()
  assert_eq(connector_http_header(headers, "retry-after"), "2")
  assert_eq(rate.retry_after_ms, 2000)
  assert_eq(rate.limit, "100")
  assert_eq(rate.remaining, "0")
  assert_eq(http_date_rate.retry_after_ms, 3000)
  harness.stdio.println(
    "rate_limit:"
      + to_string(rate.retry_after_ms)
      + ":"
      + (rate.limit ?? "")
      + ":"
      + (rate.remaining ?? "")
      + ":"
      + to_string(http_date_rate.retry_after_ms),
  )
  harness.testing.http_mock_clear()
  const oversized_error_body = "x".repeat(1030)
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/full-success-envelope",
    {status: 200, body: oversized_error_body, headers: {"Set-Cookie": "session=response-value"}},
  )
  const full_success = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/full-success-envelope",
  )
  assert_eq(full_success.ok, true)
  const full_success_headers = full_success.headers ?? {}
  assert_eq(full_success_headers["Set-Cookie"], "session=response-value")
  assert_eq(full_success.body, oversized_error_body)
  harness.stdio.println(
    "full_success:"
      + full_success_headers["Set-Cookie"]
      + ":"
      + to_string(len(full_success.body)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/safe-error-envelope",
    {
      status: 500,
      body: oversized_error_body,
      headers: {
        Authorization: "Bearer response-secret",
        "Set-Cookie": "session=response-secret",
        "X-Provider-Secret": "provider-response-secret",
        "X-Request-Id": "request-123",
      },
    },
  )
  const safe_error = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/safe-error-envelope",
  )
  assert_eq(safe_error.ok, false)
  const safe_error_headers = safe_error.headers ?? {}
  assert_eq(safe_error_headers["Authorization"], "[redacted]")
  assert_eq(safe_error_headers["Set-Cookie"], "[redacted]")
  assert_eq(safe_error_headers["X-Provider-Secret"], "[redacted]")
  assert_eq(safe_error_headers["X-Request-Id"], "request-123")
  assert_eq(safe_error.body, "x".repeat(1024) + "…[truncated 6 chars]")
  assert_eq(safe_error.error.body, safe_error.body)
  harness.stdio.println(
    "safe_error:"
      + safe_error_headers["Authorization"]
      + ":"
      + safe_error_headers["X-Request-Id"]
      + ":"
      + to_string(len(safe_error.body)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/retry-after-opt-out",
    {
      responses: [
        {status: 429, body: "limited", headers: {"Retry-After": "60"}},
        {status: 200, body: "ok"},
      ],
    },
  )
  // `respect_retry_after` inside the documented `retry` sub-dict must be
  // honored like every other knob there: the caller opted out of the header
  // exactly so a 60s Retry-After cannot abort the retry loop via cap_ms.
  const opt_out = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/retry-after-opt-out",
    {retry: {max_attempts: 2, base_ms: 0, cap_ms: 1, respect_retry_after: false}},
  )
  const opt_out_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(opt_out.ok, true)
  assert_eq(opt_out.status, 200)
  assert_eq(len(opt_out_calls), 2)
  harness.stdio.println(
    "retry_after_opt_out:" + to_string(opt_out.status) + ":" + to_string(len(opt_out_calls)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/retry-on-policy",
    {responses: [{status: 404, body: "eventually"}, {status: 200, body: "ok"}]},
  )
  const retry_on_policy = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/retry-on-policy",
    {retry: {max_attempts: 2, base_ms: 0, cap_ms: 1, retry_on: [404]}},
  )
  const retry_on_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(retry_on_policy.ok, true)
  assert_eq(retry_on_policy.status, 200)
  assert_eq(len(retry_on_calls), 2)
  harness.stdio.println(
    "retry_on_policy:" + to_string(retry_on_policy.status) + ":" + to_string(len(retry_on_calls)),
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/connector/redacted-error",
    {status: 500, body: "provider secret payload"},
  )
  const redacted = connector_http_request(
    harness.clock,
    harness.net,
    "GET",
    "https://api.example.com/connector/redacted-error",
    {provider: "example", operation: "list", redact_error_body: true},
  )
  assert_eq(redacted.ok, false)
  assert_eq(redacted.error.provider, "example")
  assert_eq(redacted.error.operation, "list")
  assert_eq(redacted.error.status, 500)
  assert_eq(redacted.error.body, nil)
  harness.stdio.println(
    "redacted:"
      + redacted.error.provider
      + ":"
      + redacted.error.operation
      + ":"
      + to_string(redacted.error.status)
      + ":"
      + to_string(redacted.error.body == nil),
  )
}
