import { edit_inline, edit_move_decl } from "std/edit"

/**
 * End-to-end exercise of `edit_inline` and `edit_move_decl` (issue #2520).
 * Inline covers the zero-parameter / single-return safe subset plus its
 * unsupported gates; move_decl drives `code_index.move_symbol` through its
 * std/edit wrapper.
 */
fn write_fixture(fs: HarnessFs, dir: string, name: string, body: string) -> string {
  const path = path_join(dir, name)
  fs.write_text(path, body)
  return path
}

pipeline default(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn_edit_inline_move_" + to_string(harness.random.range(100000, 999999)),
  )
  harness.fs.mkdir(root)
  // 1) Rust inline: replace both calls with the body expr, delete the def.
  const rs_path = write_fixture(
    harness.fs,
    root,
    "answer.rs",
    "fn answer() -> i64 {\n    return 42\n}\nfn user() {\n    let a = answer();\n    let b = answer();\n}\n",
  )
  const rs_inline = edit_inline(
    harness.fs,
    harness.random,
    harness.ast,
    {path: rs_path, symbol: {name: "answer"}},
  )
  harness.stdio.println(rs_inline.result)
  const rs_after = harness.fs.read_text(rs_path)
  harness.stdio.println(contains(rs_after, "let a = (42);"))
  harness.stdio.println(contains(rs_after, "let b = (42);"))
  harness.stdio.println(!contains(rs_after, "fn answer"))
  // 2) Python inline.
  const py_path = write_fixture(
    harness.fs,
    root,
    "answer.py",
    "def answer():\n    return 42\n\nx = answer()\n",
  )
  const py_inline = edit_inline(
    harness.fs,
    harness.random,
    harness.ast,
    {path: py_path, symbol: {name: "answer"}},
  )
  harness.stdio.println(py_inline.result)
  harness.stdio.println(contains(harness.fs.read_text(py_path), "x = (42)"))
  harness.stdio.println(!contains(harness.fs.read_text(py_path), "def answer"))
  // 3) Unsupported: parameterized function.
  const inc_path = write_fixture(
    harness.fs,
    root,
    "inc.py",
    "def inc(n):\n    return n + 1\n\ny = inc(1)\n",
  )
  harness.stdio.println(
    edit_inline(harness.fs, harness.random, harness.ast, {path: inc_path, symbol: {name: "inc"}})
      .result,
  )
  // 4) Unsupported: multi-statement body.
  const two_path = write_fixture(
    harness.fs,
    root,
    "two.py",
    "def two():\n    a = 1\n    return a\n",
  )
  harness.stdio.println(
    edit_inline(harness.fs, harness.random, harness.ast, {path: two_path, symbol: {name: "two"}})
      .result,
  )
  // 5) move_decl: lift `helper` from a.py into b.py through the code index.
  //    `main` still calls it, so a.py imports it back from b.
  write_fixture(
    harness.fs,
    root,
    "a.py",
    "import os\n\n\ndef helper(x):\n    return x + 1\n\n\ndef main():\n    return helper(2)\n",
  )
  write_fixture(harness.fs, root, "b.py", "# target\n")
  const constants_path = write_fixture(
    harness.fs,
    root,
    "constants.harn",
    "const API_URL: string = \"https://api.example.com\"\n",
  )
  write_fixture(harness.fs, root, "config.harn", "")
  harness.code_index.rebuild({root: root})
  const mv = edit_move_decl(
    harness.code_index,
    {path: "a.py", symbol: {name: "helper"}, to_path: "b.py"},
  )
  harness.stdio.println(mv.result)
  harness.stdio.println(len(mv.touched_files) == 2)
  const a_after = harness.fs.read_text(path_join(root, "a.py"))
  const b_after = harness.fs.read_text(path_join(root, "b.py"))
  harness.stdio.println(!contains(a_after, "def helper"))
  harness.stdio.println(contains(a_after, "from b import helper"))
  harness.stdio.println(contains(b_after, "def helper(x):"))
  harness.stdio.println(contains(b_after, "    return x + 1"))
  // 6) Harn bindings are outside move_symbol's languages: refused, unchanged.
  const moved_constant = edit_move_decl(
    harness.code_index,
    {path: "constants.harn", symbol: "API_URL", to_path: "config.harn"},
  )
  harness.stdio.println(moved_constant.result)
  harness.stdio.println(contains(harness.fs.read_text(constants_path), "const API_URL"))
  // 7) An unknown symbol is not found.
  harness.stdio.println(
    edit_move_decl(harness.code_index, {path: "a.py", symbol: "nope", to_path: "b.py"}).result,
  )
}
