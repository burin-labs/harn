/** Verifies native repo-scale text search from the harness filesystem surface. */
pipeline test(task) {
  const root = path_join(harness.fs.temp_dir(), "find_text_test")
  if harness.fs.exists(root) {
    harness.fs.delete(root)
  }
  harness.fs.mkdir(path_join(root, "src"))
  harness.fs.mkdir(path_join(root, "docs"))
  harness.fs.mkdir(path_join(root, "node_modules"))
  harness.fs.write_text(path_join(root, "src", "main.harn"), "first\nsecret_token = 1\n")
  harness.fs.write_text(path_join(root, "src", "other.txt"), "SECRET_TOKEN = 2\n")
  harness.fs.write_text(path_join(root, "docs", "note.md"), "secret_token docs\n")
  harness.fs.write_text(path_join(root, "node_modules", "ignored.harn"), "secret_token ignored\n")
  const hits = harness.fs.find_text(
    root,
    "secret_token",
    {include: "**/*.harn", case_insensitive: true, preset: "source"},
  )
  log(len(hits))
  log(hits[0].line)
  log(hits[0].col)
  log(contains(hits[0].path, "src/main.harn"))
  log(hits[0].text)
  const limited = harness.fs.find_text(root, "secret_token", {case_insensitive: true, max_matches: 2})
  log(len(limited))
  log(harness.fs.find_text(root, "secret_token", {mode: "exists", parallel: true}))
  log(
    harness.fs.find_text(
      root,
      "secret_token",
      {mode: "count", preset: "source", case_insensitive: true, parallel: true},
    ),
  )
  harness.fs.delete(root)
}
