import { coord_post, coord_read } from "std/coordination"

pipeline default() {
  const _ = coord_post(
    "session",
    "ops",
    {kind: "status", subject: "A"},
    {id: "coord-A", session_id: "sess-A"},
  )
  const _ = coord_post(
    "session",
    "ops",
    {kind: "status", subject: "B"},
    {id: "coord-B", session_id: "sess-B"},
  )
  const _ = coord_post(
    "workspace",
    "ops",
    {kind: "status", subject: "workspace"},
    {id: "coord-W", tenant_id: "tenant-1", workspace_id: "workspace-1"},
  )
  const sess_a = coord_read("session", "ops", {session_id: "sess-A"})
  const sess_b = coord_read("session", "ops", {session_id: "sess-B"})
  const sess_c = coord_read("session", "ops", {session_id: "sess-C"})
  const workspace = coord_read(
    "workspace",
    "ops",
    {tenant_id: "tenant-1", workspace_id: "workspace-1"},
  )
  const other_tenant_workspace = coord_read(
    "workspace",
    "ops",
    {tenant_id: "tenant-2", workspace_id: "workspace-1"},
  )
  __io_println(len(sess_a))
  __io_println(sess_a[0].subject)
  __io_println(sess_a[0].scope_id)
  __io_println(len(sess_b))
  __io_println(sess_b[0].subject)
  __io_println(sess_b[0].scope_id)
  __io_println(len(sess_c))
  __io_println(len(workspace))
  __io_println(workspace[0].scope)
  __io_println(workspace[0].scope_id)
  __io_println(len(other_tenant_workspace))
}
