import { coord_post, coord_read } from "std/coordination"

pipeline default(harness: Harness) {
  const _ = coord_post(
    harness.channels, "session",
    "ops",
    {kind: "status", subject: "A"},
    {id: "coord-A", session_id: "sess-A"},
  )
  const _ = coord_post(
    harness.channels, "session",
    "ops",
    {kind: "status", subject: "B"},
    {id: "coord-B", session_id: "sess-B"},
  )
  const _ = coord_post(
    harness.channels, "workspace",
    "ops",
    {kind: "status", subject: "workspace"},
    {id: "coord-W", tenant_id: "tenant-1", workspace_id: "workspace-1"},
  )
  const sess_a = coord_read(harness.channels, "session", "ops", {session_id: "sess-A"})
  const sess_b = coord_read(harness.channels, "session", "ops", {session_id: "sess-B"})
  const sess_c = coord_read(harness.channels, "session", "ops", {session_id: "sess-C"})
  const workspace = coord_read(
    harness.channels, "workspace",
    "ops",
    {tenant_id: "tenant-1", workspace_id: "workspace-1"},
  )
  const other_tenant_workspace = coord_read(
    harness.channels, "workspace",
    "ops",
    {tenant_id: "tenant-2", workspace_id: "workspace-1"},
  )
  harness.stdio.println(len(sess_a))
  harness.stdio.println(sess_a[0].subject)
  harness.stdio.println(sess_a[0].scope_id)
  harness.stdio.println(len(sess_b))
  harness.stdio.println(sess_b[0].subject)
  harness.stdio.println(sess_b[0].scope_id)
  harness.stdio.println(len(sess_c))
  harness.stdio.println(len(workspace))
  harness.stdio.println(workspace[0].scope)
  harness.stdio.println(workspace[0].scope_id)
  harness.stdio.println(len(other_tenant_workspace))
}
