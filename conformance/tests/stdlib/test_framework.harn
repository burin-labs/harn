pipeline test(harness: Harness, task: unknown) {
  // Test mock LLM provider returns deterministic responses
  const result = harness.llm.call("hello world", nil, {provider: "mock"})
  assert(contains(result.text, "Mock"))
  assert(contains(result.text, "2-word prompt"))
  harness.stdio.log("mock llm works")
}
