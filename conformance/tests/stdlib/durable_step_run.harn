import "../_common"

pipeline default(harness: Harness) {
  const repo_root = harness.process.exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-durable-step-" + harness.random.uuid_v7(),
  )
  const state = path_join(root, "state")
  const script = path_join(root, "durable_step_child.harn")
  harness.fs.mkdir(root)
  harness.fs.write_text(
    script,
    "fn main(harness: Harness) {\n"
      + "  let counter = path_join(harness.fs.cwd(), \"counter.txt\")\n"
      + "  let user_id = argv[0]\n"
      + "  let value = harness.runtime.step_run(\"load-user\", {user_id: user_id}, { ->\n"
      + "    let current = if harness.fs.exists(counter) { to_int(harness.fs.read_text(counter).trim()) ?? 0 } else { 0 }\n"
      + "    let next = current + 1\n"
      + "    harness.fs.write_text(counter, to_string(next))\n"
      + "    return {loaded: user_id, counter: next}\n"
      + "  }, {namespace: \"conformance-durable-step\"})\n"
      + "  let stored = harness.fs.read_text(counter).trim()\n"
      + "  let records = harness.runtime.step_inspect({namespace: \"conformance-durable-step\"})\n"
      + "  harness.stdio.println(\"loaded=\" + value.loaded)\n"
      + "  harness.stdio.println(\"value_counter=\" + to_string(value.counter))\n"
      + "  harness.stdio.println(\"stored_counter=\" + stored)\n"
      + "  harness.stdio.println(\"records=\" + to_string(len(records)))\n"
      + "}\n",
  )
  const first = harness.process.exec_at(
    root,
    "env",
    "HARN_STATE_DIR=" + state,
    harn_bin,
    "run",
    script,
    "--",
    "alice",
  )
  const second = harness.process.exec_at(
    root,
    "env",
    "HARN_STATE_DIR=" + state,
    harn_bin,
    "run",
    script,
    "--",
    "alice",
  )
  const mismatch = harness.process.exec_at(
    root,
    "env",
    "HARN_STATE_DIR=" + state,
    harn_bin,
    "run",
    script,
    "--",
    "bob",
  )
  harness.stdio.println(first.success)
  harness.stdio.println(contains(first.stdout, "loaded=alice"))
  harness.stdio.println(contains(first.stdout, "value_counter=1"))
  harness.stdio.println(contains(first.stdout, "stored_counter=1"))
  harness.stdio.println(contains(first.stdout, "records=1"))
  harness.stdio.println(second.success)
  harness.stdio.println(contains(second.stdout, "loaded=alice"))
  harness.stdio.println(contains(second.stdout, "value_counter=1"))
  harness.stdio.println(contains(second.stdout, "stored_counter=1"))
  harness.stdio.println(contains(second.stdout, "records=1"))
  harness.stdio.println(!contains(second.stdout, "value_counter=2"))
  harness.stdio.println(!mismatch.success)
  harness.stdio.println(contains(mismatch.stderr, "step.run: deterministic input mismatch"))
}
