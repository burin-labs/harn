import { append_git_trailers, git_trailers } from "std/disclosure"

pipeline default(harness: Harness) {
  const chain = {sub: "user:kenneth", act: {sub: "agent:merge-captain"}}
  const nested_chain = {
    sub: "user:kenneth",
    act: {sub: "agent:merge-captain", act: {sub: "agent:burin"}},
  }
  const config = {
    identities: {
      "user:kenneth": {name: "Kenneth Sinder", email: "kenneth@example.com"},
      "agent:merge-captain": {name: "Merge Captain", email: "merge-captain@bots.example"},
      "agent:burin": {name: "Burin", email: "burin@bots.example"},
    },
    surfaces: {
      git: {
        kind: "text",
        template:
          "Co-Authored-By: {{ current.name }} <{{ current.email }}>\nSigned-off-by: Human Merge Captain <{{ origin.email }}>\nSigned-off-by: {{ current.name }} <{{ current.email }}>\nSigned-off-by: {{ origin.name }} <{{ origin.email }}>",
      },
    },
  }
  const options = {project: false, env: false, config: config}
  const trailers = git_trailers(harness.env, harness.fs, chain, options)
  require !contains(trailers, "Signed-off-by: Merge Captain"),
    "agent actor must not receive DCO sign-off"
  require contains(trailers, "Signed-off-by: Human Merge Captain"),
    "human sign-off must not be filtered by name substring"
  const suppressed_message = "Fix identity trailers\n"
  require append_git_trailers(
    harness.env,
    harness.fs,
    suppressed_message,
    chain,
    options + {enabled: false},
  )
    == suppressed_message,
    "suppressed append must preserve the original message"
  harness.stdio.println(trailers)
  harness.stdio.println("--- default ---")
  harness.stdio.println(
    git_trailers(
      harness.env,
      harness.fs,
      nested_chain,
      {project: false, env: false, config: {identities: config.identities}},
    ),
  )
  harness.stdio.println("--- assembled ---")
  harness.stdio.println(
    append_git_trailers(
      harness.env,
      harness.fs,
      "Fix identity trailers\n\nUse the actor chain.",
      chain,
      options,
    ),
  )
  harness.stdio.println("--- suppressed ---")
  harness.stdio.println(
    append_git_trailers(
      harness.env,
      harness.fs,
      "Fix identity trailers",
      chain,
      options + {enabled: false},
    ),
  )
  harness.stdio.println("--- config suppressed ---")
  harness.stdio.println(
    append_git_trailers(
      harness.env,
      harness.fs,
      "Fix identity trailers",
      chain,
      {
        project: false,
        env: false,
        config: {identities: config.identities, surfaces: {git: {enabled: false}}},
      },
    ),
  )
}
