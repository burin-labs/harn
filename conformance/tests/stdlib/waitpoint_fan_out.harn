import "std/waitpoint"

pipeline test(task) {
  const points: list<Waitpoint> = [
    create("fan-out-1"),
    create("fan-out-2"),
    create("fan-out-3"),
    create("fan-out-4"),
    create("fan-out-5"),
  ]
  const waiter = spawn {
    let resolved = wait(points)
    return {count: len(resolved), first: resolved[0].value, last: resolved[4].value}
  }
  sleep(10ms)
  complete(points[0], "a")
  complete(points[1], "b")
  complete(points[2], "c")
  complete(points[3], "d")
  complete(points[4], "e")
  const result = await(waiter)
  __io_println(result.count)
  __io_println(result.first)
  __io_println(result.last)
}
