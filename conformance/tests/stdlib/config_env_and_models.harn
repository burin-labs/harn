// Verifies std/config typed env-var readers and the model-id parser.
// Uses unlikely-to-exist env var names so the fallback path is exercised
// deterministically across machines.
import {
  env_bool,
  env_float,
  env_int,
  env_list,
  env_str,
  model_from_env,
  parse_model_id,
} from "std/config"

pipeline default() {
  __io_println(env_str("HARN_TEST_UNSET_VAR_29X") == nil)
  __io_println(env_int("HARN_TEST_UNSET_VAR_29X", 7))
  __io_println(env_float("HARN_TEST_UNSET_VAR_29X", 1.5))
  __io_println(env_bool("HARN_TEST_UNSET_VAR_29X", true))
  __io_println(env_list("HARN_TEST_UNSET_VAR_29X"))
  __io_println(model_from_env("HARN_TEST_UNSET_VAR_29X", "claude-sonnet-4-6"))
  let ollama = parse_model_id("ollama:qwen2.5:32b")
  __io_println(ollama.provider)
  __io_println(ollama.model)
  let local = parse_model_id("local:gpt-oss")
  __io_println(local.provider)
  __io_println(local.model)
  let openrouter = parse_model_id("openai/gpt-5")
  __io_println(openrouter.provider)
  __io_println(openrouter.model)
  let anthropic = parse_model_id("anthropic:claude-haiku-4-5")
  __io_println(anthropic.provider)
  let bare = parse_model_id("claude-sonnet-4-6")
  __io_println(bare.provider)
  __io_println(bare.model)
  let blank = parse_model_id("")
  __io_println(blank.provider)
  __io_println(blank.model == "")
}
