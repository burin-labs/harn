// Verifies std/config typed env-var readers and the model-id parser.
// Uses unlikely-to-exist env var names so the fallback path is exercised
// deterministically across machines.
import {
  env_bool,
  env_float,
  env_int,
  env_list,
  env_str,
  model_from_env,
  parse_model_id,
} from "std/config"
import { PROVIDER_NAMES } from "std/llm/provider_names"

pipeline default(harness: Harness) {
  harness.stdio.println(env_str(harness.env, "HARN_TEST_UNSET_VAR_29X") == nil)
  harness.stdio.println(env_int(harness.env, "HARN_TEST_UNSET_VAR_29X", 7))
  harness.stdio.println(env_float(harness.env, "HARN_TEST_UNSET_VAR_29X", 1.5))
  harness.stdio.println(env_bool(harness.env, "HARN_TEST_UNSET_VAR_29X", true))
  harness.stdio.println(env_list(harness.env, "HARN_TEST_UNSET_VAR_29X"))
  harness.stdio.println(model_from_env(harness.env, "HARN_TEST_UNSET_VAR_29X", "claude-sonnet-4-6"))
  const ollama = parse_model_id("ollama:qwen2.5:32b")
  harness.stdio.println(ollama.provider)
  harness.stdio.println(ollama.model)
  const local = parse_model_id("local:gpt-oss")
  harness.stdio.println(local.provider)
  harness.stdio.println(local.model)
  const openrouter = parse_model_id("openai/gpt-5")
  harness.stdio.println(openrouter.provider)
  harness.stdio.println(openrouter.model)
  const anthropic = parse_model_id("anthropic:claude-haiku-4-5")
  harness.stdio.println(anthropic.provider)
  const bare = parse_model_id("claude-sonnet-4-6")
  harness.stdio.println(bare.provider)
  harness.stdio.println(bare.model)
  const blank = parse_model_id("")
  harness.stdio.println(blank.provider)
  harness.stdio.println(blank.model == "")
  // Recent provider additions (minimax/zai/cerebras/huggingface/mlx/vllm/
  // tgi/dashscope) used to silently downgrade to provider: "auto" because
  // the allowlist drifted from `crates/harn-vm/src/llm/provider.rs`.
  const minimax = parse_model_id("minimax:M2.5")
  harness.stdio.println(minimax.provider)
  harness.stdio.println(minimax.model)
  const zai = parse_model_id("zai:GLM-5")
  harness.stdio.println(zai.provider)
  harness.stdio.println(zai.model)
  const cerebras = parse_model_id("cerebras:gpt-oss-120b")
  harness.stdio.println(cerebras.provider)
  harness.stdio.println(cerebras.model)
  const dashscope = parse_model_id("dashscope:qwen-max")
  harness.stdio.println(dashscope.provider)
  // Every named provider in the shipped LLM catalog must remain an explicit
  // selector here. This catches the user-visible failure where a valid
  // `provider:model` selector silently degrades to `provider: "auto"`.
  for expected_provider in PROVIDER_NAMES {
    const selector = "${expected_provider}:catalog-native-model"
    const parsed = parse_model_id(selector)
    require parsed.provider == expected_provider,
      "${selector} resolved to ${parsed.provider}, expected ${expected_provider}"
  }
  harness.stdio.println("provider-prefixes-ok")
}
