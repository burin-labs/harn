pipeline default(harness: Harness) {
  const hashes = [sha256("synthetic.private")]
  const findings = secret_scan("λ SYNTHETIC.PRIVATE\nclean synthetic.private", hashes)
  assert_eq(len(findings), 2)
  const first = unwrap(findings[0])
  assert_eq(first.line, 1)
  assert_eq(first.column_start, 3)
  assert_eq(first.column_end, 20)
  assert_eq(first.start_offset, 3)
  assert_eq(first.end_offset, 20)
  assert_eq(first.redacted, "[hash match]")
  assert_eq(first.fingerprint, hashes[0])
  assert(!json_stringify(findings).lower().contains("synthetic.private"))
  assert_eq(
    secret_scan("synthetic.private.invalid xsynthetic.private synthetic.private.", hashes),
    [],
  )
  assert_eq(secret_scan("clean", hashes), [])
  for invalid in [[], ["invalid"], [sha256("synthetic.private").upper()]] {
    const result = try {
      secret_scan("clean", invalid)
    }
    assert(is_err(result))
  }
  assert_eq(secret_scan("clean"), secret_scan("clean", nil))
  assert_eq(len(secret_scan("synthetic.private")), 0)
  harness.stdio.println("hashed secret scan passed")
}
