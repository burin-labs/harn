pipeline test(harness: Harness, task) {
  // Existing duration suffixes
  harness.stdio.println(500ms)
  harness.stdio.println(5s)
  harness.stdio.println(30m)
  harness.stdio.println(2h)
  // New: days and weeks
  harness.stdio.println(1d)
  harness.stdio.println(2d)
  harness.stdio.println(1w)
  harness.stdio.println(2w)
}
