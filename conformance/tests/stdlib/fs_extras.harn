/** Verifies move_file, read_lines, walk_dir, and glob. */
pipeline test(harness: Harness, task) {
  const root = path_join(harness.fs.workspace_temp_dir(), "fs_extras_test")
  if harness.fs.exists(root) {
    harness.fs.delete(root)
  }
  harness.fs.mkdir(path_join(root, "sub"))
  harness.fs.write_text(path_join(root, "a.txt"), "alpha\nbeta\ngamma\n")
  harness.fs.write_text(path_join(root, "b.txt"), "one\ntwo\n")
  harness.fs.write_text(path_join(root, "sub", "c.md"), "deeper\n")
  // read_lines splits without the trailing empty line
  const lines = harness.fs.read_lines(path_join(root, "a.txt"))
  harness.stdio.log(len(lines))
  harness.stdio.log(lines[0])
  harness.stdio.log(lines[2])
  // move_file across the same dir
  harness.fs.rename(path_join(root, "b.txt"), path_join(root, "renamed.txt"))
  harness.stdio.log(harness.fs.exists(path_join(root, "b.txt")))
  harness.stdio.log(harness.fs.exists(path_join(root, "renamed.txt")))
  // glob "*.txt" only finds top-level .txt files (a.txt and renamed.txt)
  const txts = harness.fs.glob("*.txt", root)
  harness.stdio.log(len(txts))
  // glob "**/*.md" finds the nested md
  const mds = harness.fs.glob("**/*.md", root)
  harness.stdio.log(len(mds))
  // walk_dir returns dicts with path/is_dir/depth
  const walked = harness.fs.walk(root)
  // 1 root dir + a.txt + renamed.txt + sub dir + sub/c.md = 5 entries
  harness.stdio.log(len(walked))
  harness.fs.delete(root)
}
