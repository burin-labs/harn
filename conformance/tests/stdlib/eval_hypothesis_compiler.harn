import { check_versioned } from "std/artifacts/typed"
import {
  compile_experiment_intent,
  experiment_intent_contract,
  validate_compiled_hypothesis_plan,
} from "std/eval/hypothesis"
import {
  hypothesis_fixture_budget,
  hypothesis_fixture_capabilities,
  hypothesis_fixture_context,
  hypothesis_fixture_intent,
  hypothesis_fixture_intent_v2,
  hypothesis_fixture_intervention,
  hypothesis_fixture_placement,
} from "./hypothesis_fixture_lib.harn"

fn test_versioned_intent_normalization() {
  const legacy = hypothesis_fixture_intent()
  const current = hypothesis_fixture_intent_v2()
  require is_ok(check_versioned(legacy, experiment_intent_contract())),
    "the current reader keeps accepting v1 intent"
  require is_ok(check_versioned(current, experiment_intent_contract())),
    "the same contract accepts v2 intent"
  const legacy_receipt = compile_experiment_intent(legacy, hypothesis_fixture_context())
  const current_receipt = compile_experiment_intent(current, hypothesis_fixture_context())
  require legacy_receipt.ok && current_receipt.ok, "both supported versions compile"
  require legacy_receipt.plan_fingerprint == current_receipt.plan_fingerprint,
    "v1 and equivalent v2 intent normalize to one plan identity"
  if legacy_receipt.plan == nil {
    throw "v1 normalization omitted the compiled plan"
  }
  require legacy_receipt.plan.intent.schema == "harn.experiment.intent.v2",
    "compiled plans retain only the canonical current intent"
  const unsupported = current + {schema: "harn.experiment.intent.v3", schema_version: 3}
  const rejected = compile_experiment_intent(unsupported, hypothesis_fixture_context())
  require !rejected.ok, "future intent versions fail closed"
  require rejected.failure?.diagnostics?.[0]?.code == "experiment.intent_schema_version",
    "version rejection is distinct from structural schema repair"
  require rejected.failure?.diagnostics?.[0]?.repair?.owner == "intent",
    "version rejection carries a typed intent repair"
}

fn test_quasi_experiment_contract() {
  const missing = hypothesis_fixture_intent_v2()
    + {
      requested_lane: "quasi_experimental",
      requested_evidence: "observational",
      intervention: nil,
      comparator: nil,
    }
  const missing_receipt = compile_experiment_intent(missing, hypothesis_fixture_context())
  require !missing_receipt.ok, "a quasi-experimental label cannot omit its identifying design"
  require missing_receipt.failure?.diagnostics?.[0]?.code
    == "experiment.quasi_design_required",
    "the missing contract has a stable repair code"
  require missing_receipt.failure?.diagnostics?.[0]?.repair?.operation == "set",
    "the missing contract names a typed repair operation"
  const quasi = missing
    + {
      quasi_experiment: {
        design: "matched_comparison",
        assignment_mechanism: "Operators choose rollout eligibility before measurement.",
        identifying_assumptions: ["No unmeasured confounding after matching."],
        matching: {
          method: "exact",
          covariates: ["team", "baseline_volume"],
          caliper: nil,
          with_replacement: false,
        },
      },
    }
  const receipt = compile_experiment_intent(quasi, hypothesis_fixture_context())
  require receipt.ok && receipt.plan?.kind == "observe_only",
    "supported quasi-experimental intent compiles without manufacturing randomization"
  if receipt.plan == nil {
    throw "quasi-experimental compilation omitted its plan"
  }
  require receipt.plan.design.lane == "quasi_experimental", "the plan retains the classified lane"
  require receipt.plan.design.claim_strength == "associational",
    "the compiler does not overclaim causal identification"
}

fn test_explicit_capability_policy() {
  const context = hypothesis_fixture_context()
  const candidate = hypothesis_fixture_intervention("candidate", 1)
  const excessive = candidate
    + {
      capabilities: candidate.capabilities
        + {
          customer_state: {access: "reversible_write", scopes: ["tenant:customer-1"]},
          models: {model_ids: ["mock", "unregistered-model"], dynamic_routing: true},
          privacy: {data_classes: ["personal"], retention: "durable", cross_tenant: true},
        },
    }
  const receipt = compile_experiment_intent(
    hypothesis_fixture_intent_v2(),
    context
      + {catalog: context.catalog + {interventions: [context.catalog.interventions[0], excessive]}},
  )
  require !receipt.ok && receipt.failure?.kind == "unsafe_plan",
    "customer, model, and privacy authority stay below the host ceiling"
  require receipt.failure?.diagnostics?.[0]?.code == "experiment.capability_ceiling",
    "the existing capability refusal owns the expanded policy"
  require receipt.failure?.diagnostics?.[0]?.repair?.owner == "catalog"
    && receipt.failure?.diagnostics?.[0]?.repair?.operation
      == "reduce",
    "over-capability execution returns a typed least-authority repair"
}

fn test_executable_compile() {
  const first = compile_experiment_intent(hypothesis_fixture_intent(), hypothesis_fixture_context())
  require first.ok, "a registered randomized design compiles"
  if first.plan == nil || first.plan.kind != "registered_experiment" {
    throw "the compiler did not emit a registered experiment"
  }
  const plan = first.plan
  require plan.design.lane == "randomized_offline", "auto chooses the preferred common lane"
  require plan.design.claim_strength == "randomized_causal", "the claim ceiling follows the design"
  require plan.manifest.assignment.mode == "randomized_block",
    "lowering uses the canonical experiment assignment owner"
  require plan.execution_status == "requires_registered_host_adapter",
    "registration does not pretend a host intervention already exists"
  require plan.design.evidence.delta == 0.05,
    "a named evidence mode resolves to transparent thresholds"
  require plan.design.evidence.promotion == "explicit_gate",
    "the evidence policy preserves canonical explicit gate promotion"
  require plan.design.capabilities.placement
    == hypothesis_fixture_capabilities().placement,
    "the executable plan preserves its registered placement policy"
  require validate_compiled_hypothesis_plan(plan), "the compiled placement validates on replay"
  const candidate = plan.design.intervention
  if candidate == nil {
    throw "the executable plan omitted its candidate"
  }
  const drifted = plan
    + {
      design: plan.design
        + {
          intervention: candidate
            + {
              capabilities: candidate.capabilities
                + {placement: hypothesis_fixture_placement() + {platform: "macos"}},
            },
        },
    }
  const replay = try {
    validate_compiled_hypothesis_plan(drifted)
  }
  require is_err(replay), "replay refuses arm-specific placement drift"
  require unwrap_err(replay).contains("placement policies differ"),
    "replay names the placement invariant"
  const reordered = compile_experiment_intent(
    hypothesis_fixture_intent(),
    hypothesis_fixture_context(true),
  )
  require reordered.plan_fingerprint == first.plan_fingerprint,
    "catalog ordering cannot change plan identity"
}

fn test_honest_non_experimental_compile() {
  const research = hypothesis_fixture_intent()
    + {
      requested_lane: "non_experimental_research",
      requested_evidence: "observational",
      intervention: nil,
      comparator: nil,
      assignment_unit: nil,
      population_id: nil,
      outcome_ids: [],
    }
  const receipt = compile_experiment_intent(research, hypothesis_fixture_context())
  require receipt.ok, "a non-experimental question still compiles"
  if receipt.plan == nil || receipt.plan.kind != "observe_only" {
    throw "the compiler manufactured an A/B test"
  }
  const plan = receipt.plan
  require plan.design.claim_strength == "none",
    "research without observations makes no evidence claim"
  require len(plan.instrumentation_questions) >= 4, "the plan names missing instrumentation"
}

fn test_fail_closed_boundaries() {
  const trusted_risk = hypothesis_fixture_context()
    + {
      risk_floor: hypothesis_fixture_context().risk_floor + {touches_production: true},
      approval_id: "approval-native-1",
    }
  const approval = compile_experiment_intent(hypothesis_fixture_intent(), trusted_risk)
  require approval.ok, "risk escalation still compiles for review"
  if approval.plan == nil || approval.plan.kind != "registered_experiment" {
    throw "high-risk intent did not compile to a registered review plan"
  }
  require approval.plan.design.approval_required, "risk escalation requires approval"
  require approval.plan.design.approval_id == "approval-native-1",
    "the compiler preserves the host approval identity"
  require approval.plan.execution_status == "requires_registered_host_adapter",
    "approval remains an external execution precondition"
  const unknown = compile_experiment_intent(
    hypothesis_fixture_intent()
      + {intervention: {adapter_id: "prompt", variant_id: "missing"}},
    hypothesis_fixture_context(),
  )
  require !unknown.ok, "unregistered executable references fail closed"
  if unknown.failure == nil {
    throw "unknown adapter failure omitted diagnostics"
  }
  const unknown_diagnostic = unknown.failure.diagnostics[0]
  if unknown_diagnostic == nil {
    throw "unknown adapter failure emitted no diagnostic"
  }
  require unknown_diagnostic.code == "experiment.unknown_intervention",
    "the deterministic diagnostic supports bounded planner repair"
  const over_budget = hypothesis_fixture_context()
    + {budget_request: hypothesis_fixture_budget() + {max_spend_usd: 3.0}}
  const budget_receipt = compile_experiment_intent(hypothesis_fixture_intent(), over_budget)
  require !budget_receipt.ok, "host budget ceilings are enforced during compilation"
  if budget_receipt.failure == nil {
    throw "budget failure omitted diagnostics"
  }
  const budget_diagnostic = budget_receipt.failure.diagnostics[0]
  if budget_diagnostic == nil {
    throw "budget failure emitted no diagnostic"
  }
  require budget_diagnostic.code == "experiment.budget_ceiling",
    "budget rejection is machine-readable"
  const missing_capability = hypothesis_fixture_context()
    + {capability_ceiling: hypothesis_fixture_capabilities() + {tools: []}}
  const capability_receipt = compile_experiment_intent(
    hypothesis_fixture_intent(),
    missing_capability,
  )
  require !capability_receipt.ok, "unenforceable host capabilities fail closed"
  if capability_receipt.failure == nil {
    throw "capability failure omitted diagnostics"
  }
  require capability_receipt.failure.kind == "unsafe_plan",
    "capability refusal is distinct from invalid model data"
  const placement_ceiling = hypothesis_fixture_context()
    + {
      capability_ceiling: hypothesis_fixture_capabilities()
        + {placement: hypothesis_fixture_placement() + {platform: "macos"}},
    }
  const placement_receipt = compile_experiment_intent(
    hypothesis_fixture_intent(),
    placement_ceiling,
  )
  require !placement_receipt.ok, "an incompatible host placement fails closed"
  require placement_receipt.failure?.diagnostics?.[0]?.code
    == "experiment.placement_ceiling",
    "placement refusal is machine-readable"
  const baseline = hypothesis_fixture_intervention("baseline", 0)
  const candidate = hypothesis_fixture_intervention("candidate", 1)
  const rollback_context = hypothesis_fixture_context()
    + {
      catalog: hypothesis_fixture_context().catalog
        + {
          interventions: [
            baseline
              + {
                capabilities: baseline.capabilities
                  + {
                    mutation: baseline.capabilities.mutation
                      + {rollback_adapter_id: "rollback-baseline"},
                  },
              },
            candidate
              + {
                capabilities: candidate.capabilities
                  + {
                    mutation: candidate.capabilities.mutation
                      + {rollback_adapter_id: "rollback-candidate"},
                  },
              },
          ],
        },
    }
  const rollback_receipt = compile_experiment_intent(hypothesis_fixture_intent(), rollback_context)
  require !rollback_receipt.ok, "different rollback owners fail closed"
  require rollback_receipt.failure?.diagnostics?.[0]?.code
    == "experiment.rollback_owner_mismatch",
    "rollback-owner rejection is machine-readable"
  const placement_context = hypothesis_fixture_context()
    + {
      catalog: hypothesis_fixture_context().catalog
        + {
          interventions: [
            baseline,
            candidate
              + {
                capabilities: candidate.capabilities
                  + {placement: hypothesis_fixture_placement() + {resource_class: "gpu-large"}},
              },
          ],
        },
    }
  const placement_mismatch = compile_experiment_intent(
    hypothesis_fixture_intent(),
    placement_context,
  )
  require !placement_mismatch.ok, "arm-specific placement confounding fails closed"
  require placement_mismatch.failure?.diagnostics?.[0]?.code
    == "experiment.placement_mismatch",
    "arm placement mismatch is machine-readable"
  const malformed_context = hypothesis_fixture_context()
    + {
      catalog: hypothesis_fixture_context().catalog
        + {
          interventions: [
            baseline
              + {
                capabilities: baseline.capabilities
                  + {placement: hypothesis_fixture_placement() + {resource_class: "  "}},
              },
            candidate,
          ],
        },
    }
  const malformed_placement = compile_experiment_intent(
    hypothesis_fixture_intent(),
    malformed_context,
  )
  require !malformed_placement.ok, "blank placement resource classes fail closed"
  require malformed_placement.failure?.diagnostics?.[0]?.code
    == "experiment.invalid_placement",
    "malformed placement is machine-readable"
}

pipeline default(harness: Harness, _task) {
  test_versioned_intent_normalization()
  test_quasi_experiment_contract()
  test_explicit_capability_policy()
  test_executable_compile()
  test_honest_non_experimental_compile()
  test_fail_closed_boundaries()
  harness.stdio.println("hypothesis-compiler-ok")
}
