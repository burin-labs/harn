/**
 * CH-03 (#1874): session-scoped emits from one session MUST NOT fan out to
 * readers in another session. The resolver produces topic
 * `channels.session.<session-id>.<name>`, so distinct `session_id` values
 * own distinct topics.
 */
pipeline default() {
  const _ = emit_channel("agent.done", {turn: 1}, {scope: "session", session_id: "sess-A", id: "A-1"})
  const _ = emit_channel("agent.done", {turn: 99}, {scope: "session", session_id: "sess-B", id: "B-1"})
  const sess_a = channel_events("agent.done", {scope: "session", session_id: "sess-A"})
  const sess_b = channel_events("agent.done", {scope: "session", session_id: "sess-B"})
  const sess_c = channel_events("agent.done", {scope: "session", session_id: "sess-C"})
  __io_println(len(sess_a))
  __io_println(sess_a[0].payload.turn)
  __io_println(sess_a[0].scope_id)
  __io_println(len(sess_b))
  __io_println(sess_b[0].payload.turn)
  __io_println(sess_b[0].scope_id)
  // Session C is empty — no leakage.
  __io_println(len(sess_c))
}
