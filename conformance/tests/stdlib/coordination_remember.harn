import { coord_post, coord_remember } from "std/coordination"
import { memory_recall } from "std/memory"

pipeline default(harness: Harness) {
  const receipt = coord_post(harness.runtime, harness.channels, harness.random, "tenant",
    "facts",
    {kind: "fact", subject: "release published", body: "Harn release assets are published."},
    {id: "coord-fact-1"},
  )
  const remembered = coord_remember(
    harness.memory,
    receipt,
    {namespace: "coordination-test", tags: ["coordination", "release"]},
  )
  const hits = memory_recall(harness.memory, "coordination-test", "release assets", 3)
  harness.stdio.println(remembered.namespace)
  harness.stdio.println(remembered.key)
  harness.stdio.println(len(hits) > 0)
  harness.stdio.println(hits[0].value.subject)
}
