import { debate } from "std/llm/ensemble"
import { llm_call_count, llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const topic = "llm.ensemble.debate"
  const cursor = harness.obs.event_log_latest(topic)
  const events = if cursor == nil {
    harness.obs.event_log_subscribe({topic: topic})
  } else {
    harness.obs.event_log_subscribe({topic: topic, from_cursor: cursor})
  }
  with_llm_script(
    harness.llm,
    [
      llm_text("Paris is the capital of France."),
      llm_text("The answer is Paris, France."),
      llm_text("Paris is the capital of France."),
      llm_text("The answer is Paris, France."),
      llm_text("Paris is the capital of France."),
      llm_text("The answer is Paris, France."),
      llm_text("unused round four a"),
      llm_text("unused round four b"),
    ],
    { ->
      const result = debate(
        harness.llm,
        harness.obs,
        {
          prompt: "What is the capital of France?",
          debaters: ["alpha", "beta"],
          n_rounds: 5,
          adaptive_stop: true,
          stability_threshold: 0.15,
          provider: "mock",
        },
      )
      const event = events.next().value
      harness.stdio.println(result.completed_rounds)
      harness.stdio.println(result.stopped_early)
      harness.stdio.println(result.stop_reason)
      harness.stdio.println(llm_call_count(harness.llm))
      harness.stdio.println(event.kind)
      harness.stdio.println(event.payload.round)
      harness.stdio.println(event.payload.requested_rounds)
      harness.stdio.println(event.payload.consecutive_stable_rounds)
      harness.stdio.println(event.payload.max_round_drift < 0.15)
    },
  )
}
