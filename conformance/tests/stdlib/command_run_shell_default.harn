import { command_run } from "std/command"

pipeline default(harness: Harness) {
  const result = command_run(harness.tools, {mode: "shell", command: "echo command-run-default"})
  require result.success, "shell command should succeed"
  require trim(result.stdout) == "command-run-default", "shell command should use default shell"
  harness.stdio.println("ok")
}
