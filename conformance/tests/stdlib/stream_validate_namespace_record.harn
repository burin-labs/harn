import { stream_validate } from "std/json"

pipeline default(task) {
  let sv = stream_validate()
  let validator = sv.create({type: "list", items: {type: "int"}})
  __io_println(sv.chunk(validator, "[1,").verdict)
  __io_println(sv.chunk(validator, "2,3]").verdict)
  __io_println(sv.finalize(validator).verdict)
}
