import { stream_validate } from "std/json"

pipeline default(harness: Harness, task) {
  const sv = stream_validate()
  const validator = sv.create({type: "list", items: {type: "int"}})
  harness.stdio.println(sv.chunk(validator, "[1,").verdict)
  harness.stdio.println(sv.chunk(validator, "2,3]").verdict)
  harness.stdio.println(sv.finalize(validator).verdict)
}
