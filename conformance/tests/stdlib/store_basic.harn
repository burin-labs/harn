pipeline default(harness: Harness) {
  // Start clean
  store_clear()
  // Set and get
  store_set("name", "alice")
  store_set("age", 30)
  harness.stdio.println(store_get("name"))
  harness.stdio.println(store_get("age"))
  // Get missing key
  harness.stdio.println(store_get("missing"))
  // List keys
  const keys = store_list()
  harness.stdio.println(len(keys))
  // Delete
  store_delete("age")
  harness.stdio.println(store_get("age"))
  harness.stdio.println(len(store_list()))
  // Complex values
  store_set("config", {theme: "dark", size: 14})
  const cfg = store_get("config")
  harness.stdio.println(cfg.theme)
  harness.stdio.println(cfg.size)
  // Clear
  store_clear()
  harness.stdio.println(len(store_list()))
}
