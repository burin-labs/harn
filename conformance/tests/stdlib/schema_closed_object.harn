import "std/schema"

type NestedRecord = {request: {note: string}}

type RecordWithMap = {metadata: dict}

type PropertiesNamedField = {properties: {note: string}}

type AliasRecord = {payload: dict}

pipeline test(harness: Harness, task: unknown) {
  const user_schema = schema_closed_object(
    {
      name: schema_field(schema_string() + {min_length: 2}),
      role: schema_default(schema_string(), "user"),
    },
    {title: "ClosedUser"},
  )
  const validator = schema_validator(user_schema, {apply_defaults: true})
  harness.stdio.println(validator.is({name: "Ada"}))
  harness.stdio.println(!validator.is({name: "Ada", extra: true}))
  const bad_report = validator.report({name: "Ada", extra: true})
  harness.stdio.println(!bad_report.ok)
  harness.stdio.println(
    contains(
      join(bad_report.errors, "\n"),
      "Additional properties are not allowed ('extra' was unexpected)",
    ),
  )
  harness.stdio.println(validator.expect({name: "Ada"}).role)
  harness.stdio.println(validator.json_schema().additionalProperties)
  const alias_schema = schema_strict_object(
    {mode: schema_enum(["fast", "safe"])},
    {additional_properties: schema_string()},
  )
  const alias_validator = schema_validator(alias_schema)
  harness.stdio.println(alias_validator.is({mode: "fast"}))
  harness.stdio.println(!alias_validator.is({mode: "fast", extra: "disallowed"}))
  harness.stdio.println(alias_validator.json_schema().additionalProperties)
  const nested_raw = schema_of(NestedRecord)
  const explicitly_open_nested = schema_refine(
    nested_raw,
    schema_strict_object({request: nested_raw.properties.request + {additional_properties: true}}),
  )
  const nested_validator = schema_validator(schema_deep_closed(explicitly_open_nested))
  harness.stdio.println(nested_validator.is({request: {note: "safe"}}))
  harness.stdio.println(!nested_validator.is({request: {note: "safe", shadow: true}}))
  const map_validator = schema_validator(schema_deep_closed(schema_of(RecordWithMap)))
  harness.stdio.println(map_validator.is({metadata: {region: "test", attempt: 2}}))
  const properties_named_validator = schema_validator(
    schema_deep_closed(schema_of(PropertiesNamedField)),
  )
  harness.stdio.println(properties_named_validator.is({properties: {note: "safe"}}))
  harness.stdio.println(!properties_named_validator.is({properties: {note: "safe", shadow: true}}))
  const alias_raw = schema_of(AliasRecord)
  const alias_record_schema = schema_refine(
    alias_raw,
    schema_strict_object(
      {
        payload: {
          anyOf: [
            {
              type: "dict",
              properties: {note: {type: "string"}},
              required: ["note"],
              additionalProperties: true,
            },
          ],
        },
      },
    ),
  )
  const alias_record_validator = schema_validator(schema_deep_closed(alias_record_schema))
  harness.stdio.println(alias_record_validator.is({payload: {note: "safe"}}))
  harness.stdio.println(!alias_record_validator.is({payload: {note: "safe", shadow: true}}))
}
