import "std/project"

pipeline test(task) {
  harness.fs.mkdir("project_scan_catalog")
  harness.fs.write_text("project_scan_catalog/go.mod", "module github.com/acme/catalog-go\n")
  harness.fs.write_text("project_scan_catalog/go.sum", "example v0.0.0 h1:abc\n")
  const ev = project_scan("project_scan_catalog", {tiers: ["ambient"]})
  const catalog = project_catalog()
  const go_entry = catalog.filter({ entry -> entry.id == "go" })[0]
  __io_println(ev.languages[0] == "go")
  __io_println(ev.confidence.go >= 0.95)
  __io_println(go_entry.anchors[0] == "go.mod")
  __io_println(go_entry.default_test_cmd == "go test ./...")
}
