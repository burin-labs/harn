import "std/project"
import { llm_text, with_llm_script } from "std/testing"

pipeline test(harness: Harness, task: unknown) {
  const namespace = "coding-enrichment-${harness.random.uuid()}"
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "project-deep-scan-invalidation-" + harness.random.uuid(),
  )
  harness.fs.mkdir(root)
  harness.fs.write_text(path_join(root, "README.md"), "# repo\n")
  with_llm_script(
    harness.llm,
    [llm_text("{\"purpose\":\"root\"}"), llm_text("{\"purpose\":\"root changed\"}")],
    { ->
      const first = project_deep_scan(
        harness.project,
        harness.clock,
        root,
        {
          namespace: namespace,
          tiers: ["ambient", "config", "enriched"],
          incremental: true,
          depth: nil,
          enrichment: {
            prompt: "Return valid JSON only.",
            provider: "mock",
            schema: {purpose: "string"},
            budget_tokens_per_dir: 256,
          },
        },
      )
      harness.fs.write_text(path_join(root, "README.md"), "# repo changed\n")
      const second = project_deep_scan(
        harness.project,
        harness.clock,
        root,
        {
          namespace: namespace,
          tiers: ["ambient", "config", "enriched"],
          incremental: true,
          depth: nil,
          enrichment: {
            prompt: "Return valid JSON only.",
            provider: "mock",
            schema: {purpose: "string"},
            budget_tokens_per_dir: 256,
          },
        },
      )
      const second_status = project_deep_scan_status(harness.project, namespace, root)
      harness.stdio.println(first["."].enriched.purpose == "root")
      harness.stdio.println(second["."].enriched.purpose == "root changed")
      harness.stdio.println(second_status.cache_hits == 0)
      harness.stdio.println(len(harness.llm.mock_calls()) == 2)
      harness.fs.delete(root)
    },
  )
}
