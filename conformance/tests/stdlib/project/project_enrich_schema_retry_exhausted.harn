import "std/project"

pipeline test(task) {
  const base_dir = path_join(harness.fs.temp_dir(), "harn-project-enrich-envelope-" + uuid())
  harness.fs.mkdir(path_join(base_dir, "src"))
  harness.fs.write_text(
    path_join(base_dir, "Cargo.toml"),
    "[package]\nname = \"project-enrich-envelope\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text(path_join(base_dir, "Cargo.lock"), "# lock\n")
  harness.fs.write_text(
    path_join(base_dir, "src/lib.rs"),
    "pub struct UserName;\npub fn greet_name() -> &'static str { \"hi\" }\n",
  )
  const base = project_scan(base_dir, {tiers: ["ambient", "config"]})
  const prompt = "Project path: {{path}}\n{{ for file in files }}FILE {{file.path}}\n{{file.content}}\n{{ end }}\nReturn JSON."
  const schema = {
    type: "object",
    required: ["framework", "indent_style", "naming_conventions", "test_runner"],
    properties: {
      framework: {type: "string"},
      indent_style: {type: "string"},
      naming_conventions: {type: "array", items: {type: "string"}},
      test_runner: {type: "string"},
    },
  }
  const result = project_enrich(
    base_dir,
    {
      base_evidence: base,
      prompt: prompt,
      schema: schema,
      budget_tokens: 4000,
      provider: "mock",
      model: "mock-model",
      cache_key: "retry-v1",
      schema_retries: 1,
      include_operator_meta: false,
    },
  )
  __io_println(contains(result.validation_error, "schema"))
  __io_println(result.base_evidence.package_name == "project-enrich-envelope")
  __io_println(!result._provenance.cached)
  __io_println(len(llm_mock_calls()) == 2)
}
