import "std/project"

pipeline test(harness: Harness, task) {
  const root = path_join(harness.fs.workspace_temp_dir(), "polyglot_tree")
  harness.fs.mkdir(path_join(root, "frontend/src"))
  harness.fs.mkdir(path_join(root, "backend/src"))
  harness.fs.write_text(path_join(root, "frontend/package.json"), "{\"name\":\"frontend\"}\n")
  harness.fs.write_text(path_join(root, "frontend/package-lock.json"), "{}\n")
  harness.fs.write_text(path_join(root, "frontend/tsconfig.json"), "{ }\n")
  harness.fs.write_text(path_join(root, "frontend/src/app.tsx"), "export const App = () => null\n")
  harness.fs.write_text(
    path_join(root, "backend/Cargo.toml"),
    "[package]\nname = \"backend\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text(path_join(root, "backend/Cargo.lock"), "# lock\n")
  harness.fs.write_text(path_join(root, "backend/src/main.rs"), "fn " + "main() {}\n")
  const tree = project_scan_tree(harness.project, root, {tiers: ["ambient"], depth: 3})
  const tree_keys = keys(tree)
  harness.stdio.println(tree_keys[0] == ".")
  harness.stdio.println(tree_keys[1] == "backend")
  harness.stdio.println(tree_keys[2] == "frontend")
  harness.stdio.println(len(tree["."].languages) == 0)
  harness.stdio.println(tree.backend.languages[0] == "rust")
  harness.stdio.println(tree.frontend.languages[0] == "typescript")
  harness.stdio.println(tree.frontend.build_systems[0] == "npm")
}
