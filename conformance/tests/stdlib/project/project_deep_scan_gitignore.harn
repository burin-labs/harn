import "std/project"

pipeline test(task) {
  const root = path_join(harness.fs.temp_dir(), "project_deep_scan_ignore")
  const namespace = "ambient-${uuid()}"
  harness.fs.mkdir(path_join(root, "app/src"))
  harness.fs.mkdir(path_join(root, "ignored/src"))
  harness.fs.mkdir(path_join(root, "target/tooling"))
  harness.fs.mkdir(path_join(root, "node_modules/pkg"))
  harness.fs.write_text(path_join(root, ".gitignore"), "ignored/\n")
  harness.fs.write_text(
    path_join(root, "app/Cargo.toml"),
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text(path_join(root, "app/Cargo.lock"), "# lock\n")
  harness.fs.write_text(path_join(root, "app/src/main.rs"), "fn " + "main() {}\n")
  harness.fs.write_text(path_join(root, "ignored/go.mod"), "module ignored\n")
  harness.fs.write_text(
    path_join(root, "target/tooling/Cargo.toml"),
    "[package]\nname = \"tooling\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text(path_join(root, "node_modules/pkg/package.json"), "{\"name\":\"pkg\"}\n")
  const tree = project_deep_scan(
    root,
    {namespace: namespace, tiers: ["ambient"], incremental: true, depth: nil},
  )
  __io_println(tree.app.ambient.languages[0] == "rust")
  __io_println(tree["ignored"] == nil)
  __io_println(tree["target/tooling"] == nil)
  __io_println(tree["node_modules/pkg"] == nil)
}
