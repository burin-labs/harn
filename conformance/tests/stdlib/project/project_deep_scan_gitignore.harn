import "std/project"

pipeline test(task) {
  const namespace = "ambient-${uuid()}"
  harness.fs.mkdir("project_deep_scan_ignore/app/src")
  harness.fs.mkdir("project_deep_scan_ignore/ignored/src")
  harness.fs.mkdir("project_deep_scan_ignore/target/tooling")
  harness.fs.mkdir("project_deep_scan_ignore/node_modules/pkg")
  harness.fs.write_text("project_deep_scan_ignore/.gitignore", "ignored/\n")
  harness.fs.write_text(
    "project_deep_scan_ignore/app/Cargo.toml",
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text("project_deep_scan_ignore/app/Cargo.lock", "# lock\n")
  harness.fs.write_text("project_deep_scan_ignore/app/src/main.rs", "fn " + "main() {}\n")
  harness.fs.write_text("project_deep_scan_ignore/ignored/go.mod", "module ignored\n")
  harness.fs.write_text(
    "project_deep_scan_ignore/target/tooling/Cargo.toml",
    "[package]\nname = \"tooling\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text(
    "project_deep_scan_ignore/node_modules/pkg/package.json",
    "{\"name\":\"pkg\"}\n",
  )
  const tree = project_deep_scan(
    "project_deep_scan_ignore",
    {namespace: namespace, tiers: ["ambient"], incremental: true, depth: nil},
  )
  __io_println(tree.app.ambient.languages[0] == "rust")
  __io_println(tree["ignored"] == nil)
  __io_println(tree["target/tooling"] == nil)
  __io_println(tree["node_modules/pkg"] == nil)
}
