import "std/project"

pipeline test(task) {
  harness.fs.mkdir("project_scan_ignored/app/src")
  harness.fs.mkdir("project_scan_ignored/ignored")
  harness.fs.mkdir("project_scan_ignored/node_modules/pkg/src")
  harness.fs.mkdir("project_scan_ignored/target/tooling")
  harness.fs.write_text("project_scan_ignored/.gitignore", "ignored/\n")
  harness.fs.write_text(
    "project_scan_ignored/app/Cargo.toml",
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text("project_scan_ignored/app/Cargo.lock", "# lock\n")
  harness.fs.write_text("project_scan_ignored/app/src/main.rs", "fn " + "main() {}\n")
  harness.fs.write_text("project_scan_ignored/ignored/go.mod", "module ignored\n")
  harness.fs.write_text("project_scan_ignored/node_modules/pkg/package.json", "{\"name\":\"pkg\"}\n")
  harness.fs.write_text("project_scan_ignored/node_modules/pkg/package-lock.json", "{}\n")
  harness.fs.write_text("project_scan_ignored/node_modules/pkg/src/index.js", "export const x = 1\n")
  harness.fs.write_text(
    "project_scan_ignored/target/tooling/Cargo.toml",
    "[package]\nname = \"tooling\"\nversion = \"0.1.0\"\n",
  )
  const default_tree = project_scan_tree("project_scan_ignored", {tiers: ["ambient"], depth: 4})
  const expanded_tree = project_scan_tree(
    "project_scan_ignored",
    {tiers: ["ambient"], depth: 4, respect_gitignore: false, include_vendor: true},
  )
  __io_println(default_tree.app.languages[0] == "rust")
  __io_println(!contains(keys(default_tree), "ignored"))
  __io_println(!contains(keys(default_tree), "node_modules/pkg"))
  __io_println(!contains(keys(default_tree), "target/tooling"))
  __io_println(expanded_tree.ignored.languages[0] == "go")
  __io_println(expanded_tree["node_modules/pkg"].languages[0] == "javascript")
  __io_println(expanded_tree["target/tooling"].languages[0] == "rust")
}
