import "std/project"

pipeline test(harness: Harness, task: unknown) {
  const root = path_join(harness.fs.workspace_temp_dir(), "project_scan_ignored")
  harness.fs.mkdir(path_join(root, "app/src"))
  harness.fs.mkdir(path_join(root, "ignored"))
  harness.fs.mkdir(path_join(root, "node_modules/pkg/src"))
  harness.fs.mkdir(path_join(root, "target/tooling"))
  harness.fs.write_text(path_join(root, ".gitignore"), "ignored/\n")
  harness.fs.write_text(
    path_join(root, "app/Cargo.toml"),
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
  )
  harness.fs.write_text(path_join(root, "app/Cargo.lock"), "# lock\n")
  harness.fs.write_text(path_join(root, "app/src/main.rs"), "fn " + "main() {}\n")
  harness.fs.write_text(path_join(root, "ignored/go.mod"), "module ignored\n")
  harness.fs.write_text(path_join(root, "node_modules/pkg/package.json"), "{\"name\":\"pkg\"}\n")
  harness.fs.write_text(path_join(root, "node_modules/pkg/package-lock.json"), "{}\n")
  harness.fs.write_text(path_join(root, "node_modules/pkg/src/index.js"), "export const x = 1\n")
  harness.fs.write_text(
    path_join(root, "target/tooling/Cargo.toml"),
    "[package]\nname = \"tooling\"\nversion = \"0.1.0\"\n",
  )
  const default_tree = project_scan_tree(harness.project, root, {tiers: ["ambient"], depth: 4})
  const expanded_tree = project_scan_tree(
    harness.project,
    root,
    {tiers: ["ambient"], depth: 4, ignore_policy: "none", include_vendor: true},
  )
  harness.stdio.println(default_tree.app.languages[0] == "rust")
  harness.stdio.println(!contains(keys(default_tree), "ignored"))
  harness.stdio.println(!contains(keys(default_tree), "node_modules/pkg"))
  harness.stdio.println(!contains(keys(default_tree), "target/tooling"))
  harness.stdio.println(expanded_tree.ignored.languages[0] == "go")
  harness.stdio.println(expanded_tree["node_modules/pkg"].languages[0] == "javascript")
  harness.stdio.println(expanded_tree["target/tooling"].languages[0] == "rust")
}
