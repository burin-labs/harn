import "std/agent_state"

pipeline default(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "harn-agent-state-two-writer-" + harness.random.uuid())
  const first = agent_state_init(root, {session_id: "conflict-session", writer_id: "stage-a"})
  agent_state_write(first, "ledger.md", "from-a")
  const second = agent_state_resume(
    root,
    "conflict-session",
    {writer_id: "stage-b", conflict_policy: "ignore"},
  )
  agent_state_write(second, "ledger.md", "from-b")
  harness.stdio.println(agent_state_read(second, "ledger.md"))
  const strict = agent_state_resume(
    root,
    "conflict-session",
    {writer_id: "stage-c", conflict_policy: "error"},
  )
  const message = try {
    agent_state_write(strict, "ledger.md", "from-c")
    "no error"
  } catch (e) {
    to_string(e)
  }
  harness.stdio.println(contains(message, "previously written by"))
  harness.stdio.println(contains(message, "stage-b") && contains(message, "stage-c"))
  harness.stdio.println(agent_state_read(strict, "ledger.md"))
  harness.fs.delete(root)
}
