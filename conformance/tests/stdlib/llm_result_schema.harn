import { with_result_schema } from "std/llm/handlers"

/**
 * Instructor-style validation + bounded repair of a caller's structured RETURN
 * value: the first attempt is missing a required field, the repair attempt is
 * valid; a permanently-invalid caller throws after exhausting its attempts.
 */
pipeline default(harness: Harness) {
  const schema = {
    type: "object",
    required: ["verdict", "score"],
    properties: {verdict: {type: "string"}, score: {type: "number"}},
  }
  const call = {
    prompt: "grade the answer",
    system: nil,
    opts: {},
    turn: {iteration: 0, session_id: "", attempt: 1},
  }
  // Case 1 — repair-then-succeed. Attempt 1 omits `score` (invalid); attempt 2
  // returns a valid object.
  const seen = harness.runtime.atomic(0)
  const flaky = { _ ->
    const prior = harness.runtime.atomic_get(seen)
    const _ = harness.runtime.atomic_add(seen, 1)
    if prior == 0 {
      return {ok: true, value: {data: {verdict: "pass"}}}
    }
    return {ok: true, value: {data: {verdict: "pass", score: 0.9}}}
  }
  const caller1 = with_result_schema(harness, flaky, schema, {max_attempts: 3})
  const r1 = caller1(call)
  harness.stdio.println(r1.result_schema.valid)
  harness.stdio.println(r1.result_schema.attempts)
  harness.stdio.println(r1.value.data.score)
  // Case 2 — always invalid → throws `result_schema` after max_attempts.
  const broken = { _ -> {ok: true, value: {data: {verdict: "pass"}}} }
  const caller2 = with_result_schema(harness, broken, schema, {max_attempts: 2})
  const thrown = try {
    caller2(call)
  }
  harness.stdio.println(is_err(thrown))
  harness.stdio.println(unwrap_err(thrown).kind)
  harness.stdio.println(unwrap_err(thrown).attempts)
}
