import { command_output_tail, command_step } from "std/command"

fn no_newline_echo(text) {
  if platform() == "windows" {
    return ["cmd", "/C", "echo|set /p=" + text]
  }
  return ["printf", text]
}

fn failing_command() {
  if platform() == "windows" {
    return ["cmd", "/C", "echo out&&echo err 1>&2&&exit /b 7"]
  }
  return ["sh", "-c", "printf out; printf err >&2; exit 7"]
}

pipeline default() {
  const step = command_step(
    "say hello",
    no_newline_echo("hello"),
    {capture: {max_inline_bytes: 100}, tail_bytes: 100},
  )
  assert_eq(step.name, "say hello")
  assert_eq(step.success, true)
  assert_eq(step.ok, true)
  assert_eq(step.status, "completed")
  assert_eq(step.exit_code, 0)
  assert_eq(step.stdout, "hello")
  assert_eq(step.tail, "hello")
  assert(step.command_id != nil)
  assert(step.output_path != nil)
  assert_eq(step.artifacts.combined, step.output_path)
  const tail = command_output_tail(step, {length: 3})
  assert_eq(tail.content, "llo")
  assert_eq(tail.eof, true)
  const failed = command_step(
    "fail",
    failing_command(),
    {capture: {max_inline_bytes: 100}, tail_bytes: 100},
  )
  assert_eq(failed.success, false)
  assert_eq(failed.ok, false)
  assert_eq(failed.status, "completed")
  assert_eq(failed.exit_code, 7)
  assert(contains(failed.stdout, "out"))
  assert(contains(failed.stderr, "err"))
  assert(contains(failed.failure_tail, "out"))
  assert(contains(failed.failure_tail, "err"))
  assert(failed.output_path != nil)
  assert(failed.stdout_path != nil)
  assert(failed.stderr_path != nil)
  assert_eq(len(failed.attempts), 1)
  assert_eq(failed.attempts[0].exit_code, 7)
  __io_println("ok")
}
