// Contract test for the `harness.secrets`-backed OAuth storage factory.
// The conformance harness has no writable secret host bound, so this test
// exercises everything that does NOT touch the secret host: handle shape,
// option validation, and the in-process refresh lock. Full get/set/delete
// behavior against an in-process secret-host fake lives in the harn-vm
// Rust fixture (`secrets_backed_oauth_storage_*`).
import { secrets, storage } from "std/oauth/storage"

fn assert_eq(label, got, want) {
  if got != want {
    throw label + ": expected " + to_string(want) + ", got " + to_string(got)
  }
}

fn assert_closure(label, value) {
  const kind = type_of(value)
  if kind != "closure" && kind != "builtin" {
    throw label + ": expected a function, got " + kind
  }
}

fn assert_throws(label, body) {
  let threw = false
  try {
    const _ = body()
  } catch (_err) {
    threw = true
  }
  if !threw {
    throw label + ": expected a throw"
  }
}

fn exercise_handle_shape() {
  const store = secrets({provider: "github"})
  assert_eq("secrets.kind", store.kind, "secrets")
  assert_eq("secrets.provider", store.provider, "github")
  assert_closure("secrets.get", store.get)
  assert_closure("secrets.set", store.set)
  assert_closure("secrets.delete", store.delete)
  assert_closure("secrets.with_refresh_lock", store.with_refresh_lock)
  // The in-process refresh lock runs the body without any secret host.
  const locked = store.with_refresh_lock("github", { -> "ran-under-lock" })
  assert_eq("secrets.with_refresh_lock", locked, "ran-under-lock")
}

fn exercise_namespace() {
  const ns = storage()
  const store = ns.secrets({provider: "linear", token_name: "access-token", key_prefix: "acct-"})
  assert_eq("namespace.secrets.kind", store.kind, "secrets")
  assert_eq("namespace.secrets.provider", store.provider, "linear")
  assert_closure("namespace.secrets.get", store.get)
}

fn exercise_validation() {
  assert_throws("secrets(non-dict)", { -> secrets("nope") })
  assert_throws("secrets(missing provider)", { -> secrets({}) })
  assert_throws("secrets(blank provider)", { -> secrets({provider: "   "}) })
  assert_throws("secrets(blank token_name)", { -> secrets({provider: "github", token_name: ""}) })
}

pipeline test(task) {
  exercise_handle_shape()
  exercise_namespace()
  exercise_validation()
  log("oauth storage secrets ok")
}
