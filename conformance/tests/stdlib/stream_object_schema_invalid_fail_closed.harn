import { stream_object } from "std/json"

pipeline default(harness: Harness) {
  const schema = {
    type: "dict",
    required: ["name", "age"],
    properties: {name: {type: "string"}, age: {type: "int"}},
  }
  let emitted = []
  for obj in stream_object(harness, ["{\"name\":\"Ada\",\"age\":\"not-an-int\"}"], schema) {
    emitted = emitted.appending(obj)
  }
  harness.stdio.println(len(emitted))
}
