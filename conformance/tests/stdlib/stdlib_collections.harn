import "std/collections"

pipeline default() {
  // filter_nil: removes nil, empty string, and "null" string
  const d = {name: "alice", age: 30, empty: "", nothing: nil, fake_null: "null", valid: "ok"}
  const cleaned = filter_nil(d)
  __io_println(cleaned.name)
  __io_println(cleaned.age)
  __io_println(cleaned.valid)
  __io_println(len(cleaned.keys()))
  const picked = pick_keys({a: 1, b: nil, c: 3}, ["c", "missing", "b"], {drop_nil: true})
  __io_println(picked.c)
  __io_println(contains(picked.keys(), "missing"))
  __io_println(contains(picked.keys(), "b"))
  const rows = [{tokens: 3, ok: true}, {tokens: nil, ok: false}, {ok: true}, {tokens: 7, ok: true}]
  __io_println(sum_by(rows, { row -> row?.tokens }))
  __io_println(sum_by([], { row -> row?.tokens }))
  __io_println(count_where(rows, { row -> row.ok }))
  __io_println(count_where([], { row -> row.ok }))
}
