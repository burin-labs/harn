pipeline default() {
  event_log.emit("tests.read", "alpha.one", {n: 1})
  const second = event_log.emit("tests.read", "beta.two", {n: 2})
  event_log.emit("tests.read", "alpha.three", {n: 3})
  const description = event_log.describe()
  __io_println(description.queue_depth > 0)
  const topics = event_log.topics()
  __io_println(topics.contains("tests.read"))
  const after_first = event_log.read("tests.read", 1, 10)
  __io_println(len(after_first))
  __io_println(after_first[0].kind)
  __io_println(after_first[0].payload.n)
  const filtered = event_log.read(
    {topic: "tests.read", from_cursor: second - 1, kind_prefix: "alpha.", limit: 10},
  )
  __io_println(len(filtered))
  __io_println(filtered[0].kind)
  __io_println(filtered[0].cursor)
}
