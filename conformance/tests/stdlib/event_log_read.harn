pipeline default(harness: Harness) {
  harness.obs.event_log_emit("tests.read", "alpha.one", {n: 1})
  const second = harness.obs.event_log_emit("tests.read", "beta.two", {n: 2})
  harness.obs.event_log_emit("tests.read", "alpha.three", {n: 3})
  const description = harness.obs.event_log_describe()
  harness.stdio.println(description.queue_depth > 0)
  const topics = harness.obs.event_log_topics()
  harness.stdio.println(topics.contains("tests.read"))
  const after_first = harness.obs.event_log_read("tests.read", 1, 10)
  harness.stdio.println(len(after_first))
  harness.stdio.println(after_first[0].kind)
  harness.stdio.println(after_first[0].payload.n)
  const filtered = harness.obs.event_log_read(
    {topic: "tests.read", from_cursor: second - 1, kind_prefix: "alpha.", limit: 10},
  )
  harness.stdio.println(len(filtered))
  harness.stdio.println(filtered[0].kind)
  harness.stdio.println(filtered[0].cursor)
}
