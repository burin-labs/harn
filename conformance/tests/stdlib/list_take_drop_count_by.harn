pipeline test(task) {
  // take_while stops at the first falsy predicate result.
  const xs = [1, 2, 3, 4, 5, 6]
  const taken = xs.take_while({ x -> x < 4 })
  __io_println(len(taken) == 3)
  __io_println(taken[0] == 1 && taken[2] == 3)
  const none_taken = xs.take_while({ x -> x > 10 })
  __io_println(len(none_taken) == 0)
  const all_taken = xs.take_while({ x -> x < 100 })
  __io_println(len(all_taken) == 6)
  // drop_while skips the leading run, keeps everything else.
  const dropped = xs.drop_while({ x -> x < 4 })
  __io_println(len(dropped) == 3)
  __io_println(dropped[0] == 4 && dropped[2] == 6)
  const nothing_dropped = xs.drop_while({ x -> x > 10 })
  __io_println(len(nothing_dropped) == 6)
  const all_dropped = xs.drop_while({ x -> x < 100 })
  __io_println(len(all_dropped) == 0)
  // count_by groups by the callback's key and tallies.
  const words = ["apple", "ant", "banana", "blueberry", "cherry"]
  const by_letter = words.count_by({ w -> substring(w, 0, 1) })
  __io_println(by_letter["a"] == 2)
  __io_println(by_letter["b"] == 2)
  __io_println(by_letter["c"] == 1)
  __io_println(len(by_letter.keys()) == 3)
  // count_by requires a string discriminator (v0.8.43+) — int returns
  // used to silently collide with string returns through display(), so
  // a non-string callback result is now a clear TypeError.
  const int_error = try {
    [1, 2, 3].count_by({ x -> x })
    "no error"
  } catch (e) {
    to_string(e)
  }
  __io_println(contains(int_error, "count_by") && contains(int_error, "string discriminator"))
  // group_by has the same contract.
  const bool_error = try {
    [1, 2, 3].group_by({ x -> x % 2 == 0 })
    "no error"
  } catch (e) {
    to_string(e)
  }
  __io_println(contains(bool_error, "group_by") && contains(bool_error, "string discriminator"))
  // Coercing to string works as documented.
  const by_parity = [1, 2, 3, 4].count_by({ x -> to_string(x % 2) })
  __io_println(by_parity["0"] == 2 && by_parity["1"] == 2)
  // tally inherits the same strict-string contract: ints used to collapse
  // into the same bucket as their stringified form via `display()`.
  const tally_error = try {
    // Called for its error, not its value: discard the result explicitly so
    // HARN-LNT-066 can tell this apart from an accidental no-op.
    const _ = [1, 2, 3].tally()
    "no error"
  } catch (e) {
    to_string(e)
  }
  __io_println(contains(tally_error, "tally") && contains(tally_error, "expected a list of strings"))
  // Explicit coercion still tallies.
  const by_string = [1, 2, 1, 1, 3].map({ x -> to_string(x) }).tally()
  __io_println(by_string["1"] == 3 && by_string["2"] == 1 && by_string["3"] == 1)
}
