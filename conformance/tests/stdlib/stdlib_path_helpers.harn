pipeline test(harness: Harness, task: unknown) {
  harness.stdio.log(path_normalize("a/b/../c"))
  harness.stdio.log(path_normalize("/a/b/../c"))
  harness.stdio.log(path_normalize("a\\b\\c"))
  harness.stdio.log(path_normalize("/"))
  harness.stdio.log(path_parent("a/b/c.rs"))
  harness.stdio.log(path_parent("/a/b"))
  harness.stdio.log(path_basename("a/b/c.rs"))
  harness.stdio.log(path_stem("a/b/c.rs"))
  harness.stdio.log(path_extension("a/b/c.rs"))
  harness.stdio.log(path_extension("a/b/c.tar.gz"))
  harness.stdio.log(path_with_extension("a/b/c.rs", "txt"))
  harness.stdio.log(path_with_extension("a/b/c.rs", ".txt"))
  harness.stdio.log(path_with_stem("a/b/c.rs", "main"))
  harness.stdio.log(path_is_absolute("/a/b"))
  harness.stdio.log(path_is_absolute("C:/a"))
  harness.stdio.log(path_is_absolute("a/b"))
  harness.stdio.log(path_is_relative("a/b"))
  harness.stdio.log(path_to_posix("a\\b\\c"))
  harness.stdio.log(path_relative_to("/a/b/c", "/a/b"))
  harness.stdio.log(path_relative_to("/a/c", "/a/b"))
  const parts = path_parts("src/main.rs")
  harness.stdio.log(parts["dir"])
  harness.stdio.log(parts["stem"])
  harness.stdio.log(parts["ext"])
  harness.stdio.log(parts["file"])
  harness.stdio.log(len(path_segments("a/b/c")))
  const root = path_join(harness.fs.workspace_temp_dir(), "harn_stdlib_path_workspace")
  const nested = path_join(root, "packages/demo")
  harness.fs.mkdir(nested)
  harness.fs.write_text(path_join(nested, "file.txt"), "ok")
  const recovered = harness.fs.workspace_info("/packages/demo/file.txt", root)
  harness.stdio.log(recovered.kind)
  harness.stdio.log(recovered.workspace_path)
  harness.stdio.log(recovered.recovered_root_drift)
  harness.stdio.log(path_workspace_normalize("/packages/demo/file.txt", root))
  harness.stdio.println(harness.fs.workspace_canonicalize_existing("packages/demo/file.txt", root))
  harness.stdio.println(harness.fs.workspace_canonicalize_existing("missing.txt", root) == nil)
  const absolute = harness.fs.workspace_info(path_join(root, "packages/demo/file.txt"), root)
  harness.stdio.log(absolute.kind)
  harness.stdio.log(absolute.workspace_path)
  const invalid = harness.fs.workspace_info("../secret.txt", root)
  harness.stdio.log(invalid.kind)
  harness.stdio.log(invalid.reason != nil)
  harness.fs.delete(root)
}
