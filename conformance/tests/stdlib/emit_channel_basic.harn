pipeline default(harness: Harness) {
  mock_time(1000)
  const receipt = harness.channels.append("demo.created", {n: 1}, {id: "demo-1", ttl: 5s})
  const events = harness.channels.events("demo.created")
  harness.stdio.println(receipt.name_resolved)
  harness.stdio.println(receipt.scope)
  harness.stdio.println(receipt.event_id)
  harness.stdio.println(receipt.duplicate)
  harness.stdio.println(receipt.emitted_at.at_ms)
  harness.stdio.println(starts_with(receipt.emitted_at.signature, "sha256:"))
  harness.stdio.println(receipt.ttl_ms)
  harness.stdio.println(len(events))
  harness.stdio.println(events[0].payload.n)
  harness.stdio.println(events[0].id)
  harness.stdio.println(events[0].ttl_ms)
  const duplicate = harness.channels.append("demo.created", {n: 2}, {id: "demo-1"})
  harness.stdio.println(duplicate.event_id == receipt.event_id)
  harness.stdio.println(duplicate.duplicate)
  harness.stdio.println(harness.channels.events("demo.created")[0].payload.n)
  unmock_time()
}
