import { stream_validator } from "std/json"

pipeline default(task) {
  let validator = stream_validator(
    {type: "dict", required: ["name", "age"], properties: {name: {type: "string"}, age: {type: "int"}}},
  )
  println(validator.feed("{\"name\"").variant)
  println(validator.value() == nil)
  println(validator.feed(":\"Ada\",\"age\":").variant)
  println(validator.feed("42}").variant)
  println(validator.value().name)
  println(validator.value().age)
}
