// Verifies std/llm/safe::safe_structured_call applies judge-friendly
// defaults, drives the structured retry loop, and surfaces a normalized
// envelope with `value` (lowercase keys) and `status` populated.
import { safe_structured_call } from "std/llm/safe"

pipeline test(task) {
  const schema = {
    type: "object",
    required: ["verdict", "bullets"],
    properties: {verdict: {type: "string"}, bullets: {type: "array", items: {type: "string"}}},
  }
  const envelope = safe_structured_call(
    "Grade this output.",
    schema,
    {provider: "mock", model: "mock-model", system: "you are a judge", max_tokens: 200},
  )
  __io_println(envelope.ok)
  __io_println(envelope.status)
  __io_println(envelope.value.verdict)
  __io_println(len(envelope.value.bullets))
  __io_println(envelope.value.bullets[0])
  __io_println(envelope.attempts)
}
