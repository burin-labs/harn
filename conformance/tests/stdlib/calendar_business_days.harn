import "std/calendar"

pipeline default(harness: Harness) {
  const calendar = "US-FEDERAL"
  const timezone = "America/New_York"
  harness.stdio.println(is_holiday("2026-07-03", calendar, timezone))
  harness.stdio.println(is_business_day("2026-07-03", calendar, timezone))
  harness.stdio.println(
    date_format(next_business_day("2026-07-03", calendar, timezone), "%Y-%m-%d", timezone),
  )
  harness.stdio.println(
    date_format(add_business_days("2026-07-01", 3, calendar, timezone), "%Y-%m-%d", timezone),
  )
  harness.stdio.println(business_days_between("2026-07-01", "2026-07-08", calendar, timezone))
  harness.stdio.println(holidays(2026, calendar)[5]?.date)
  harness.stdio.println(len(holidays(2020, calendar)))
  const options: CalendarBusinessWindowOptions = {timezone: timezone, start: "09:00", end: "17:00"}
  harness.stdio.println(is_business_time(date_parse("2026-07-06T14:00:00-04:00"), calendar, options))
  const window: CalendarBusinessWindow = business_window(
    date_parse("2026-07-06T22:00:00Z"),
    calendar,
    options,
  )
  harness.stdio.println(window.reason)
  const custom: CalendarBusinessCalendar = {timezone: "UTC", holidays: ["2026-01-02"]}
  harness.stdio.println(is_business_day("2026-01-02", custom))
  const custom_weekend: CalendarBusinessCalendar = {timezone: "UTC", weekends: [5]}
  harness.stdio.println(is_business_day("2026-01-02", custom_weekend))
  const unsupported = try {
    is_business_day("2026-01-02", "ZZ")
  }
  harness.stdio.println(is_err(unsupported))
}
