import "std/calendar"

pipeline default() {
  const calendar = "US-FEDERAL"
  const timezone = "America/New_York"
  __io_println(is_holiday("2026-07-03", calendar, timezone))
  __io_println(is_business_day("2026-07-03", calendar, timezone))
  __io_println(date_format(next_business_day("2026-07-03", calendar, timezone), "%Y-%m-%d", timezone))
  __io_println(
    date_format(add_business_days("2026-07-01", 3, calendar, timezone), "%Y-%m-%d", timezone),
  )
  __io_println(business_days_between("2026-07-01", "2026-07-08", calendar, timezone))
  __io_println(holidays(2026, calendar)[5].date)
  __io_println(len(holidays(2020, calendar)))
  const options: CalendarBusinessWindowOptions = {timezone: timezone, start: "09:00", end: "17:00"}
  __io_println(is_business_time(date_parse("2026-07-06T14:00:00-04:00"), calendar, options))
  const window: CalendarBusinessWindow = business_window(date_parse("2026-07-06T22:00:00Z"), calendar, options)
  __io_println(window.reason)
  const custom: CalendarBusinessCalendar = {timezone: "UTC", holidays: ["2026-01-02"]}
  __io_println(is_business_day("2026-01-02", custom))
  const custom_weekend: CalendarBusinessCalendar = {timezone: "UTC", weekends: [5]}
  __io_println(is_business_day("2026-01-02", custom_weekend))
  const unsupported = try {
    is_business_day("2026-01-02", "ZZ")
  }
  __io_println(is_err(unsupported))
}
