pipeline default() {
  let tmp = temp_dir()
  let test_dir = path_join(tmp, "harn_test_fileops")
  mkdir(test_dir)
  // path_join
  let p = path_join(test_dir, "hello.txt")
  __io_println(p != "")
  // write and read
  write_file(p, "hello world")
  __io_println(file_exists(p))
  let content = read_file(p)
  __io_println(content)
  // append
  append_file(p, " appended")
  __io_println(read_file(p))
  // stat
  let info = stat(p)
  __io_println(info.is_file)
  __io_println(info.is_dir)
  // copy
  let p2 = path_join(test_dir, "copy.txt")
  copy_file(p, p2)
  __io_println(file_exists(p2))
  __io_println(read_file(p2))
  // list_dir
  let files = list_dir(test_dir)
  __io_println(files.count)
  // delete
  delete_file(p)
  __io_println(file_exists(p))
  // cleanup
  delete_file(test_dir)
}
