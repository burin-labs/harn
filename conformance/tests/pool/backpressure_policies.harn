import { Backpressure, pool_create, pool_wait } from "std/lifecycle/pool"

fn gated(gate, value) {
  return { ->
    harness.runtime.receive(gate)
    return value
  }
}

fn constant(value) {
  return { -> value }
}

fn drop_oldest_case(harness: Harness, bp) {
  const gate = harness.runtime.channel(nil, 1)
  const pool = pool_create(
    {name: "bp-drop-oldest", max_concurrent: 1, backpressure: bp.queue(1, "drop_oldest")},
  )
  const warmup = pool.submit(gated(gate, "warmup"))
  const old = pool.submit(constant("old"))
  const newest = pool.submit(constant("newest"))
  const saturated = pool.snapshot()
  harness.stdio.println(saturated.backpressure.on_full)
  harness.stdio.println(saturated.rejected)
  harness.stdio.println(saturated.queued)
  harness.runtime.send(gate, "go")
  const results = pool_wait([warmup, old, newest])
  harness.stdio.println(results[1].status)
  harness.stdio.println(results[1].rejection_policy)
  harness.stdio.println(results[2].status)
  harness.stdio.println(results[2].result)
}

fn drop_newest_case(harness: Harness, bp) {
  const gate = harness.runtime.channel(nil, 1)
  const pool = pool_create(
    {name: "bp-drop-newest", max_concurrent: 1, backpressure: bp.queue(1, "drop_newest")},
  )
  const warmup = pool.submit(gated(gate, "warmup"))
  const old = pool.submit(constant("old"))
  const newest = pool.submit(constant("newest"))
  const saturated = pool.snapshot()
  harness.stdio.println(saturated.backpressure.on_full)
  harness.stdio.println(saturated.rejected)
  harness.stdio.println(saturated.queued)
  harness.runtime.send(gate, "go")
  const results = pool_wait([warmup, old, newest])
  harness.stdio.println(results[1].status)
  harness.stdio.println(results[1].result)
  harness.stdio.println(results[2].status)
  harness.stdio.println(results[2].rejection_policy)
}

fn ring_buffer_case(harness: Harness, bp) {
  const gate = harness.runtime.channel(nil, 1)
  const pool = pool_create(
    {name: "bp-ring-buffer", max_concurrent: 1, backpressure: bp.ring_buffer(1)},
  )
  const warmup = pool.submit(gated(gate, "warmup"))
  const old = pool.submit(constant("old"))
  const newest = pool.submit(constant("newest"))
  const saturated = pool.snapshot()
  harness.stdio.println(saturated.backpressure.kind)
  harness.stdio.println(saturated.backpressure.max_depth)
  harness.stdio.println(saturated.rejected)
  harness.runtime.send(gate, "go")
  const results = pool_wait([warmup, old, newest])
  harness.stdio.println(results[1].status)
  harness.stdio.println(results[1].rejection_policy)
  harness.stdio.println(results[2].status)
  harness.stdio.println(results[2].result)
}

fn fail_submitter_case(harness: Harness, bp) {
  const gate = harness.runtime.channel(nil, 1)
  const pool = pool_create(
    {name: "bp-fail-submitter", max_concurrent: 1, backpressure: bp.queue(1, "fail_submitter")},
  )
  const warmup = pool.submit(gated(gate, "warmup"))
  const queued = pool.submit(constant("queued"))
  const failed = try {
    pool.submit(constant("overflow"))
  }
  harness.stdio.println(is_err(failed))
  harness.stdio.println(contains(to_string(unwrap_err(failed)), "HARN-POL-001"))
  harness.runtime.send(gate, "go")
  const results = pool_wait([warmup, queued])
  harness.stdio.println(results[0].status)
  harness.stdio.println(results[1].result)
}

fn fail_fast_case(harness: Harness, bp) {
  const gate = harness.runtime.channel(nil, 1)
  const pool = pool_create({name: "bp-fail-fast", max_concurrent: 1, backpressure: bp.fail_fast})
  const warmup = pool.submit(gated(gate, "warmup"))
  const failed = try {
    pool.submit(constant("overflow"))
  }
  harness.stdio.println(is_err(failed))
  harness.stdio.println(contains(to_string(unwrap_err(failed)), "HARN-POL-002"))
  harness.runtime.send(gate, "go")
  const result = pool_wait(warmup)
  harness.stdio.println(result.status)
  harness.stdio.println(result.result)
}

fn block_submitter_case(harness: Harness, bp) {
  const gate = harness.runtime.channel(nil, 1)
  const started = harness.runtime.channel(nil, 1)
  const returned = harness.runtime.channel(nil, 1)
  const pool = pool_create(
    {name: "bp-block-submitter", max_concurrent: 1, backpressure: bp.queue(1)},
  )
  const warmup = pool.submit(gated(gate, "warmup"))
  const queued = pool.submit(constant("queued"))
  const submitter = spawn {
    harness.runtime.send(started, "started")
    let late = pool.submit(constant("late"))
    harness.runtime.send(returned, "returned")
    return late
  }
  harness.runtime.receive(started)
  harness.stdio.println(harness.runtime.try_receive(returned) == nil)
  harness.runtime.send(gate, "go")
  const late = await(submitter)
  harness.stdio.println(harness.runtime.receive(returned))
  const results = pool_wait([warmup, queued, late])
  harness.stdio.println(results[0].status)
  harness.stdio.println(results[1].result)
  harness.stdio.println(results[2].result)
}

fn audit_case(harness: Harness) {
  // Filter to drop receipts so the assertion ignores the `pool_submit`
  // and `pool_dequeue` receipts emitted on the same topic by PL-06.
  const stream = harness.obs.event_log_subscribe({topic: "lifecycle.pool.audit", kind_prefix: "pool_drop"})
  const first = stream.next().value
  const second = stream.next().value
  const third = stream.next().value
  harness.stdio.println(first.kind)
  harness.stdio.println(first.payload.policy)
  harness.stdio.println(first.headers.schema)
  harness.stdio.println(second.payload.policy)
  harness.stdio.println(third.payload.policy)
}

pipeline default(harness: Harness) {
  const bp = Backpressure()
  harness.stdio.println(bp.fail_fast.kind)
  harness.stdio.println(bp.queue(2, "block_submitter").max_depth)
  drop_oldest_case(harness, bp)
  drop_newest_case(harness, bp)
  ring_buffer_case(harness, bp)
  fail_submitter_case(harness, bp)
  fail_fast_case(harness, bp)
  block_submitter_case(harness, bp)
  audit_case(harness)
}
