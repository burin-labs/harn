import { pool_create, pool_wait } from "std/lifecycle/pool"

/**
 * Verifies that with max_concurrent=1, submission priority controls
 * dequeue order: higher priority runs sooner, equal priorities tie-break
 * by submission order (FIFO).
 *
 * The "gate" channel parks the warmup task until all subsequent
 * submissions have landed in the queue — otherwise the warmup could
 * complete before later submits arrive, freeing the slot and racing the
 * priority order.
 */
pipeline default(harness: Harness) {
  const pool = pool_create({name: "priority-demo", max_concurrent: 1})
  const order = harness.runtime.atomic(0)
  const gate = harness.runtime.channel(nil, 1)
  const warmup_body = { ->
    harness.runtime.receive(gate)
    return harness.runtime.atomic_add(order, 1)
  }
  const stamp = { -> harness.runtime.atomic_add(order, 1) }
  const warmup = pool.submit(warmup_body)
  const low = pool.submit(stamp, {priority: 0})
  const mid = pool.submit(stamp, {priority: 5})
  const high = pool.submit(stamp, {priority: 10})
  const mid_second = pool.submit(stamp, {priority: 5})
  // All five tasks are now resident: warmup is parked, the others wait
  // in priority order behind it. Open the gate so warmup completes.
  harness.runtime.send(gate, "go")
  const results = pool_wait([warmup, low, mid, high, mid_second])
  // Expected dispatch order:
  //   warmup     (occupied the slot first)
  //   high       (priority 10)
  //   mid        (priority 5, submitted before mid_second)
  //   mid_second (priority 5, FIFO tiebreak)
  //   low        (priority 0)
  harness.stdio.println(results[0].result)  // warmup     -> 0
  harness.stdio.println(results[3].result)  // high       -> 1
  harness.stdio.println(results[2].result)  // mid        -> 2
  harness.stdio.println(results[4].result)  // mid_second -> 3
  harness.stdio.println(results[1].result)  // low        -> 4
}
