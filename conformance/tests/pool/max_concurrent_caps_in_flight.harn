import { pool_create, pool_wait } from "std/lifecycle/pool"

/**
 * Verifies that max_concurrent caps the number of tasks running at any
 * instant. Each task atomically tracks the peak in-flight count; for
 * max_concurrent=2 the peak must never exceed 2 regardless of how many
 * tasks are submitted. The gate parks every running task until the main
 * pipeline releases it, so concurrent siblings race against the cap
 * instead of completing serially.
 */
pipeline default(harness: Harness) {
  const pool = pool_create(harness.agent, {name: "cap-demo", max_concurrent: 2})
  const in_flight = harness.runtime.atomic(0)
  const peak = harness.runtime.atomic(0)
  const gate = harness.runtime.channel(nil, 8)
  const body = { ->
    let now = harness.runtime.atomic_add(in_flight, 1) + 1
    if now > harness.runtime.atomic_get(peak) {
      harness.runtime.atomic_set(peak, now)
    }
    harness.runtime.receive(gate)
    harness.runtime.atomic_add(in_flight, -1)
    return now
  }
  let handles = []
  for _i in 0 to 6 exclusive {
    handles = handles.appending(pool.submit(body))
  }
  for _i in 0 to 6 exclusive {
    harness.runtime.send(gate, "go")
  }
  pool_wait(harness.agent, handles)
  harness.stdio.println(harness.runtime.atomic_get(peak) <= 2)
  harness.stdio.println(harness.runtime.atomic_get(in_flight))
  harness.stdio.log(pool.size())
}
