import { agent_completion_gate, agent_completion_gate_veto_counts } from "std/agent/completion_gate"
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"
import { contract_effect, contract_negative } from "./lib/mechanism_contract.harn"

fn run_case(harness: Harness, green: bool) -> nil {
  const sid = "completion-budget-${harness.random.uuid()}"
  with_llm_script(
    harness.llm,
    [llm_text("Finished. ##DONE##"), llm_text("Finished. ##DONE##")],
    fn() {
      const captured = agent_capture_events(
        harness.agent,
        sid,
        fn() { return agent_loop(
          harness,
          "Implement the change",
          nil,
          {
            provider: "mock",
            session_id: sid,
            loop_until_done: true,
            max_iterations: 4,
            max_nudges: 10,
          }
            + agent_completion_gate(
              harness.runtime,
              {
                exhaustion: "stop_unverified",
                max_vetoes: 1,
                facts: fn(_ctx) { return {
                  source_write_count: 1,
                  verify: {ok: green, command: "check"},
                } },
              },
            ),
        ) },
      )
      const counts = agent_completion_gate_veto_counts(harness.runtime, sid)
      if green {
        assert_eq(captured.result.status, "done")
        assert_eq(counts.total, 0)
        assert(
          contract_negative(
            harness.stdio,
            "green_never_exhausts",
            captured.result.terminal.kind == "completion_unverified",
          ),
        )
      } else {
        assert_eq(captured.result.terminal.reason, "veto_budget_exhausted")
        assert_eq(captured.result.terminal.kind, "completion_unverified")
        assert_eq(len(harness.llm.mock_calls()), 2)
        assert_eq(counts.total, 1)
        const receipts = captured.events.filter(
          { event -> event?.checkpoint?.schema == "harn.completion_directive_receipt.v1" },
        )
        assert_eq(receipts[-1].checkpoint.verification.observed, "failed")
        assert(contract_effect(harness.stdio, "red_ends_unverified", true))
      }
    },
  )
}

pipeline default(harness: Harness) {
  run_case(harness, false)
  run_case(harness, true)
}
