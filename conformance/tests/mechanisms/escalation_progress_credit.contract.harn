import { agent_tool_handler_result } from "std/agent/tool_lifecycle"
import { stall_checkpoint_fixture } from "../../../tests/agent/stall_checkpoint_fixture"
import { contract_effect } from "./lib/mechanism_contract"

/** Actual verifier dispatch distinguishes complete progress from partial observations. */
fn repair_budget_case(harness: Harness, mode: string) {
  const session = harness.agent.open()
  let verifications = 0
  let reads = 0
  let tools = tool_define(
    tool_registry(),
    "verify",
    "Verify source",
    {
      parameters: {count: {type: "int"}},
      annotations: {kind: "verify", completion_evidence_role: "verification"},
      handler: { args ->
        verifications += 1
        return agent_tool_handler_result(
          "Opaque failed verification",
          {
            run_outcome: {command_status: "failed", exit_code: 1},
            diagnostics_complete: mode != "partial",
            diagnostics: range(args.count).map({ n -> {message: "error-${n}", severity: "error"} })
              .to_list(),
          },
        )
      },
    },
  )
  tools = tool_define(
    tools,
    "look",
    "Inspect source",
    {
      parameters: {},
      annotations: {kind: "read"},
      handler: { _ ->
        reads += 1
        return "source"
      },
    },
  )
  const step = stall_checkpoint_fixture(
    harness,
    session,
    tools,
    {
      no_net_progress_hard_cap_after: 2,
      shrinking_failure_set_resets_budget: mode == "shrinking" || mode == "partial",
      fresh_failure_grace: mode == "fresh",
    },
  )
  try {
    step("verify", {count: 3})
    step("verify", {count: mode == "constant" ? 3 : 2})
    const boundary = step("look", {}).stall_checkpoint.state
    require verifications == 2, "both declared verification producers must execute"
    if mode == "shrinking" {
      contract_effect(
        harness.stdio,
        "complete_shrink_restarts_budget",
        !boundary.hard_stop && boundary.failing_verify_turns == 0 && reads == 1,
      )
      step("verify", {count: 2})
      step("verify", {count: 2})
      contract_effect(
        harness.stdio,
        "constant_failures_exhaust_restarted_budget",
        step("look", {}).stall_checkpoint.state.hard_stop && verifications == 4 && reads == 1,
      )
    } else if mode == "fresh" {
      contract_effect(
        harness.stdio,
        "fresh_failure_defers_cap",
        !boundary.hard_stop && boundary.verification_cap_deferred && reads == 1,
      )
      const following = step("look", {}).stall_checkpoint.state
      require !following.hard_stop && reads == 2, "fresh grace permits the following turn"
      contract_effect(
        harness.stdio,
        "deferred_cap_fires_once_grace_expires",
        step("look", {}).stall_checkpoint.state.hard_stop && reads == 2,
      )
    } else {
      contract_effect(
        harness.stdio,
        "${mode}_does_not_earn_progress",
        boundary.hard_stop && reads == 0,
      )
    }
  } finally {
    harness.agent.close(session)
  }
}

pipeline default(harness: Harness) {
  for mode in ["shrinking", "constant", "partial", "disabled", "fresh"] {
    repair_budget_case(harness, mode)
  }
}
