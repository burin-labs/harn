fn check_method(ast: HarnessAst, existing: string, inserted: string) -> dict {
  return ast.check_member_insertion(
    {
      content: "class Store {\n${existing}\n${inserted}\n}\n",
      language: "java",
      name: "read",
      container_line: 1,
      start_line: 3,
      end_line: 3,
    },
  )
}

pipeline default(harness: Harness) {
  const duplicate = check_method(
    harness.ast,
    "int read(int key) { return 1; }",
    "long read(int renamed) { return 2; }",
  )
  assert(duplicate.status == "duplicate" && duplicate.compared_members == 1)
  assert(len(duplicate.conflicts) == 1 && duplicate.conflicts[0].line == 2)
  harness.stdio.println("duplicate=refused")
  const overload = check_method(
    harness.ast,
    "int read(int key) { return 1; }",
    "int read(int key, boolean strict) { return 2; }",
  )
  assert(overload.status == "clear" && overload.compared_members == 1)
  assert(len(overload.conflicts) == 0)
  harness.stdio.println("overload=clear")
  const uncertain = check_method(
    harness.ast,
    "<T> int read(T key) { return 1; }",
    "int read(Object key) { return 2; }",
  )
  assert(uncertain.status == "unresolved" && uncertain.compared_members == 1)
  harness.stdio.println("uncertain=refused")
}
