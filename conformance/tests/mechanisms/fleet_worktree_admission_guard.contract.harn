// MECHANISM CONTRACT: Fleet worktree admission shell guard.
//
// Contract = {trigger, effect, negative}:
//   trigger  — an agent shell payload contains parser-recognized raw
//              `git worktree add`, including behind a nested shell, in a
//              repository the wrapper measured as owning an admission command;
//   effect   — the guard denies the call and names the owning command;
//   negative — the owning admission command and read-only worktree inventory
//              stay available, and a repository with no admission command is
//              not refused at all.
//
// The refusal is CONDITIONAL on measurement, which is what this contract pins.
// The wrapper reports two values: whether it looked, and what it found. Three
// arms follow, and each one has its own control here:
//   looked + found a known command  -> refuse, naming that command;
//   looked + found nothing          -> allow, because the rule has no owner;
//   did not look                    -> refuse, because an unreadable census
//                                      must never read as an absent one.
import { decision, worktree_admission_reported } from "../../../scripts/agent_shell_guard"
import { contract_effect, contract_negative } from "./lib/mechanism_contract"

fn payload(command: string) -> string {
  return json_stringify({tool_name: "Bash", tool_input: {command: command}})
}

pipeline default(harness: Harness) {
  // The wrapper looked and found this repository's admission command.
  const owned = worktree_admission_reported("1", "scripts/fleet-worktree-admit.ts")
  // The wrapper looked and this repository owns no admission command.
  const unowned = worktree_admission_reported("1", "")
  // No wrapper reported anything: the census is unreadable, not empty.
  const unmeasured = worktree_admission_reported("", "")
  // The wrapper named a command this policy does not know: drift, not absence.
  const drifted = worktree_admission_reported("1", "scripts/renamed-admit.ts")
  const direct = decision(payload("git -C /workspace worktree add ../lane origin/main"), owned)
  const nested = decision(payload("bash -lc 'git worktree add ../lane origin/main'"), owned)
  contract_effect(harness.stdio, "trigger_raw_worktree_add", !direct.allow && !nested.allow)
  contract_effect(
    harness.stdio,
    "effect_denial_names_admission_owner",
    direct.reason.contains("fleet-worktree-admit")
      && nested.reason.contains("fleet-worktree-admit"),
  )
  // Falsifier for the refusing arm: the same payload in a repository that owns
  // no admission command must be allowed, or the fix did nothing.
  const in_unowned_repo = decision(
    payload("git -C /workspace worktree add ../lane origin/main"),
    unowned,
  )
  contract_negative(
    harness.stdio,
    "negative_unowned_repository_is_not_refused",
    !in_unowned_repo.allow,
  )
  // Falsifier for the allowing arm: absence of a measurement is not absence of
  // a command, so an unmeasured repository refuses and says why.
  const in_unmeasured_repo = decision(
    payload("git -C /workspace worktree add ../lane origin/main"),
    unmeasured,
  )
  contract_effect(
    harness.stdio,
    "effect_unmeasured_repository_refuses_by_name",
    !in_unmeasured_repo.allow
      && in_unmeasured_repo.reason.contains("could not tell"),
  )
  // A renamed command must refuse rather than silently turning the rule off.
  const in_drifted_repo = decision(
    payload("git -C /workspace worktree add ../lane origin/main"),
    drifted,
  )
  contract_effect(
    harness.stdio,
    "effect_unknown_admission_command_refuses",
    !in_drifted_repo.allow && in_drifted_repo.reason.contains("does not know"),
  )
  const live_control = decision(payload("cargo build"), owned)
  contract_effect(
    harness.stdio,
    "live_control_raw_cargo_is_also_denied",
    !live_control.allow && live_control.reason.contains("make build"),
  )
  const wrapper = decision(
    payload("./scripts/fleet-worktree-admit --issue-url https://github.com/acme/repo/issues/1"),
    owned,
  )
  const inventory = decision(payload("git worktree list --porcelain"), owned)
  contract_negative(
    harness.stdio,
    "negative_admission_and_inventory_not_denied",
    !wrapper.allow || !inventory.allow,
  )
}
