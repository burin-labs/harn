// MECHANISM CONTRACT (onramp tier): TYPED GREEN TERMINAL.
//
//   CONTRACT: when the deterministic completion gate has watched the declared
//   verifier run and pass over a source write, and the turn is the sealed final
//   answer, the completion judge is not called at all. On every other boundary
//   it is called exactly as before.
//
// WHY THIS EXISTS. The gate already returns `verified_after_write`, which is the
// one ladder reason carrying both halves: source changed, and the task's own
// oracle then passed over that change. The completion judge was invoked anyway.
// Three outcomes were observed from that call and none of them is worth its
// price. It agrees, and the run pays a provider call and its latency for an
// answer already held. It disagrees, and proven success is overwritten: a
// measured hard-cell run took a `verified_after_write` done at iteration 12,
// had it turned into `continue` by a judge whose refusal named no gap class at
// all, and arrived at the identical done at iteration 15, three iterations and
// roughly a fifth of the run later, on a cell that passed every downstream
// authority. Or it never returns, and a headless run that had already succeeded
// dies on the wall clock with no run record. See harn#8110.
//
//   trigger  — a run whose gate observed a PASSING verifier after a source
//              write, ending on the sentinel;
//   effect   — no judge call is made: zero `judge_started` events, the directive
//              seals `accept` with outcome `skipped_verified_after_write`, and
//              the provider call count drops by exactly the judge's call;
//   negative — (a) the same green reading with NO source write behind it
//              (`verified`) still calls the judge and its refusal stands;
//              (b) an unrun verifier still calls the judge; (c) a run with
//              no deterministic gate at all still calls the judge; (d) the
//              same holds with BOTH judge seams declared, so the skip is keyed
//              on the reading rather than on which seam asked; and (e) a run
//              declaring an acceptance row nothing has established still calls
//              the judge, because the pending-requirements check lives behind
//              it and a skip would take the ledger with it.
//
// Clause (a) is the load-bearing one. `verified` and `verified_after_write`
// differ by one derived fact and read almost identically, and a mechanism keyed
// on the weaker of the two would skip the judge on ordinary prose completions
// where nothing was written and nothing was proven — which is precisely the path
// the issue asks to preserve.
//
// The clauses read the judge-call count and the receipt's own outcome rather
// than the terminal's label. A stop that is relabelled elsewhere on this path
// would otherwise report this mechanism working when only a name moved.
import { agent_capture_events } from "std/agent/events"
import { agent_completion_adjudicator_declared } from "std/agent/judge"
import { agent_loop } from "std/agent/loop"
import { llm_done, with_llm_script } from "std/testing"
import { contract_effect, contract_negative } from "./lib/mechanism_contract"

const SKIP_OUTCOME = "skipped_verified_after_write"

fn toolset() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Write a source file.",
    {
      handler: { _args -> "write applied" },
      parameters: {content: {type: "string", description: "New contents"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  tools = tool_define(
    tools,
    "verify",
    "Run the project checks.",
    {
      handler: { _args -> "0 failed" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
    },
  )
  return tools
}

/**
 * A gate that reports exactly one reading. The real `agent_completion_gate` owns
 * deriving these from host facts; a case that needs a specific reading states it
 * directly so the clause under test is the skip and not the ladder.
 */
fn gate_observing(observed: string, reason: string) {
  return { _payload ->
    {
      confirm: true,
      reason: reason,
      verification: {
        oracle_expected: true,
        command: "run the project checks",
        observed: observed,
        observed_at_evidence_index: nil,
      },
    }
  }
}

/**
 * A judge scripted to REFUSE. A case where it is called is then visible twice
 * over: in the call count, and in a directive that did not accept.
 */
fn judge_refusing(detail: string) {
  return {
    text: json_stringify({verdict: "continue", detail: detail, gap_class: "missing_artifact"}),
  }
}

fn completion_receipts(events: list) {
  return events.filter(
    { event ->
      event.type == "typed_checkpoint"
        && event?.checkpoint?.schema
          == "harn.completion_directive_receipt.v1"
    },
  )
    .map({ event -> event.checkpoint })
    .to_list()
}

/**
 * How many times a completion judge was actually asked.
 *
 * Counted from `judge_started`, which is emitted immediately before the model
 * call and never for a skip. Counting receipts or verdicts instead would also
 * be satisfied by a judge that ran and happened to agree, which is exactly the
 * outcome this mechanism must be told apart from.
 */
fn judge_calls(events: list) -> int {
  return len(events.filter({ event -> event.type == "judge_started" }).to_list())
}

fn base_opts(session: string) {
  return {
    provider: "mock",
    session_id: session,
    tools: toolset(),
    tool_format: "native",
    loop_until_done: true,
    done_sentinel: "##DONE##",
    max_iterations: 3,
    final_wrapup: false,
    turn_end_condition: {provider: "mock", max_invocations: 1},
  }
}

/**
 * A completion judge declaring one acceptance row nothing has measured.
 *
 * The skip does not only skip the judge, it skips everything behind it, and the
 * pending-requirements check that turns a done into a continue lives inside the
 * structured invocation.
 */
fn completion_judge_with_open_ledger() -> dict {
  return {
    turn_end_condition: {
      provider: "mock",
      max_invocations: 1,
      requirement_contract: {
        requirements: [
          {
            requirement_id: "unmet-row",
            name: "The acceptance row nobody measured.",
            evidence_roles: ["deterministic_verification"],
          },
        ],
      },
    },
  }
}

/** The other judge seam, which runs BEFORE the completion one. */
fn verification_judge() -> dict {
  return {verify_completion_judge: {provider: "mock", max_invocations: 1}}
}

fn run_case(harness: Harness, label: string, script: list, extra: dict) {
  return with_llm_script(
    harness.llm,
    script,
    { ->
      const session = label + "-" + harness.random.uuid()
      const opts = base_opts(session) + extra
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Apply the requested change.", nil, opts) },
      )
      const receipts = completion_receipts(captured.events)
      const first = receipts[0]
      return {
        declared: agent_completion_adjudicator_declared(opts, "sentinel"),
        accepted: len(receipts) > 0 && to_string(first?.action ?? "") == "accept",
        outcome: to_string(first?.outcome ?? ""),
        judge_calls: judge_calls(captured.events),
        judge_invoked: first?.invoked?.turn_end_condition ?? false,
        provider_calls: len(harness.llm.mock_calls()),
        // Read off the receipt, which is the runtime's own reading of the
        // declared contract. A fixture that restated its own row count would
        // pass with the contract under an unrecognized key and no ledger
        // configured at all.
        ledger_recorded: first?.requirements != nil,
        ledger_required: first?.requirements?.required_count ?? -1,
      }
    },
  )
}

/** Edit, then verify, then propose completion. */
fn working_script(judge_turn: dict) -> list {
  return [
    {text: "", tool_calls: [{id: "edit-1", name: "edit", arguments: {content: "the change"}}]},
    {text: "", tool_calls: [{id: "verify-1", name: "verify", arguments: {}}]},
    llm_done(),
    judge_turn,
    llm_done(),
  ]
}

pipeline default(harness: Harness) {
  const refusal = "the fixture does not satisfy the required case"
  const green = run_case(
    harness,
    "typed-green",
    working_script(judge_refusing(refusal)),
    {verify_completion: gate_observing("passed", "verified_after_write")},
  )
  harness.stdio.println("green_accepted=" + to_string(green.accepted))
  harness.stdio.println("green_judge_calls=" + to_string(green.judge_calls))
  harness.stdio.println("green_outcome=" + green.outcome)
  harness.stdio.println("green_judge_invoked=" + to_string(green.judge_invoked))
  harness.stdio.println("green_provider_calls=" + to_string(green.provider_calls))
  const no_write = run_case(
    harness,
    "no-write",
    working_script(judge_refusing(refusal)),
    {verify_completion: gate_observing("passed", "verified")},
  )
  harness.stdio.println("no_write_accepted=" + to_string(no_write.accepted))
  harness.stdio.println("no_write_judge_calls=" + to_string(no_write.judge_calls))
  // The saved call, as a number. The two runs are the same three scripted turns;
  // they differ only in whether the judge was asked a fourth time.
  harness.stdio.println("no_write_provider_calls=" + to_string(no_write.provider_calls))
  const not_run = run_case(
    harness,
    "not-run",
    working_script(judge_refusing(refusal)),
    {verify_completion: gate_observing("not_run", "no_workspace_write")},
  )
  harness.stdio.println("not_run_accepted=" + to_string(not_run.accepted))
  harness.stdio.println("not_run_judge_calls=" + to_string(not_run.judge_calls))
  const no_gate = run_case(harness, "no-gate", working_script(judge_refusing(refusal)), {})
  harness.stdio.println("no_gate_accepted=" + to_string(no_gate.accepted))
  harness.stdio.println("no_gate_judge_calls=" + to_string(no_gate.judge_calls))
  // THE OTHER SEAM. `verify_completion_judge` is evaluated first and had its own
  // skip rule, catalog-declared and blind to the verification. One predicate now
  // answers for both, so declaring both spends no call at all.
  const both = run_case(
    harness,
    "both-judges",
    working_script(judge_refusing(refusal)),
    {verify_completion: gate_observing("passed", "verified_after_write")} + verification_judge(),
  )
  harness.stdio.println("both_accepted=" + to_string(both.accepted))
  harness.stdio.println("both_judge_calls=" + to_string(both.judge_calls))
  harness.stdio.println("both_provider_calls=" + to_string(both.provider_calls))
  const both_no_write = run_case(
    harness,
    "both-no-write",
    working_script(judge_refusing(refusal)),
    {verify_completion: gate_observing("passed", "verified")} + verification_judge(),
  )
  harness.stdio.println("both_no_write_accepted=" + to_string(both_no_write.accepted))
  harness.stdio.println("both_no_write_judge_calls=" + to_string(both_no_write.judge_calls))
  // THE ACCEPTANCE LEDGER. Same typed green terminal, plus one declared row
  // nothing has established. A green verifier answers "did the declared command
  // pass"; it is not an answer to "was each thing the task asked for delivered".
  const open_ledger = run_case(
    harness,
    "open-ledger",
    working_script(judge_refusing(refusal)),
    {verify_completion: gate_observing("passed", "verified_after_write")}
      + completion_judge_with_open_ledger(),
  )
  harness.stdio.println("open_ledger_required=" + to_string(open_ledger.ledger_required))
  harness.stdio.println("open_ledger_accepted=" + to_string(open_ledger.accepted))
  harness.stdio.println("open_ledger_judge_calls=" + to_string(open_ledger.judge_calls))
  harness.stdio.println("green_ledger_recorded=" + to_string(green.ledger_recorded))
  harness.stdio.println("green_ledger_required=" + to_string(green.ledger_required))
  // Every case declares an adjudicator, so the cases differ by ONE variable.
  contract_effect(
    harness.stdio,
    "every_case_declares_an_adjudicator",
    green.declared && no_write.declared && not_run.declared && no_gate.declared,
  )
  // EFFECT: the judge is never asked, and the receipt says why.
  contract_effect(harness.stdio, "typed_green_terminal_calls_no_judge", green.judge_calls == 0)
  contract_effect(harness.stdio, "typed_green_terminal_accepts", green.accepted)
  contract_effect(harness.stdio, "skip_is_receipted", green.outcome == SKIP_OUTCOME)
  contract_effect(
    harness.stdio,
    "a_judge_that_never_ran_is_not_recorded_as_invoked",
    !green.judge_invoked,
  )
  // NEGATIVE (a): a green verifier with no source write is an ordinary prose
  // completion, and the judge keeps its full authority there.
  contract_negative(
    harness.stdio,
    "green_without_a_write_skips_the_judge",
    no_write.judge_calls == 0,
  )
  contract_negative(harness.stdio, "green_without_a_write_accepts", no_write.accepted)
  // NEGATIVE (b): an unverified path keeps the judge.
  contract_negative(harness.stdio, "unrun_verifier_skips_the_judge", not_run.judge_calls == 0)
  contract_negative(harness.stdio, "unrun_verifier_accepts", not_run.accepted)
  // NEGATIVE (c): with no gate the judge is the only authority there is.
  contract_negative(harness.stdio, "no_gate_skips_the_judge", no_gate.judge_calls == 0)
  contract_negative(harness.stdio, "no_gate_accepts", no_gate.accepted)
  // EFFECT on the other seam: both judges declared, neither asked.
  contract_effect(harness.stdio, "both_seams_skip_on_a_typed_green", both.judge_calls == 0)
  contract_effect(harness.stdio, "both_seams_accept", both.accepted)
  // NEGATIVE: the same pair on a green verifier with no write behind it still
  // spends a call, so the skip is keyed on the reading and not on the seam.
  contract_negative(
    harness.stdio,
    "both_seams_skip_without_a_write",
    both_no_write.judge_calls == 0,
  )
  contract_negative(harness.stdio, "both_seams_accept_without_a_write", both_no_write.accepted)
  // NON-VACUITY for the ledger clauses. If the contract were declared under an
  // unrecognized key the run would configure no ledger, the skip would fire,
  // and the two negatives below would pass while measuring nothing.
  contract_effect(
    harness.stdio,
    "the_open_ledger_case_really_declares_one_row",
    open_ledger.ledger_required == 1,
  )
  // NEGATIVE (e): an outstanding acceptance row is the judge's question, so
  // the terminal reading does not get to answer it.
  contract_negative(
    harness.stdio,
    "an_open_ledger_row_skips_the_judge",
    open_ledger.judge_calls == 0,
  )
  contract_negative(harness.stdio, "an_open_ledger_row_accepts", open_ledger.accepted)
  // EFFECT: a done sealed with no judge still says what the ledger held. `nil`
  // reads the same for "no rows were declared" and "rows were declared and
  // nobody looked", and only the second is a false completion.
  contract_effect(
    harness.stdio,
    "a_skipped_done_records_its_ledger_explicitly",
    green.ledger_recorded && green.ledger_required == 0,
  )
}
