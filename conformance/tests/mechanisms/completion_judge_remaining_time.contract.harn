import { agent_capture_events } from "std/agent/events"
import { __judge_run_checkpoint } from "std/agent/judge_internals"
import { llm_text, with_llm_script } from "std/testing"
import { contract_effect, contract_negative } from "./lib/mechanism_contract"

fn request(session: string, deadline_at_ms: int) {
  return {
    checkpoint_name: "agent.completion_judge",
    judge_cfg: {provider: "mock", model: "deadline-judge", operation_timeout_ms: 60000},
    opts: {provider: "mock", _deadline_at_ms: deadline_at_ms},
    payload: {session_id: session},
    system: "Judge the completion",
    user: "Evidence is ready",
    schema: {type: "object", properties: {verdict: {type: "string"}}, required: ["verdict"]},
  }
}

pipeline default(harness: Harness) {
  harness.testing.clock_set(0)
  try {
    const session = "remaining-time-" + harness.random.uuid()
    harness.agent.open(session)
    with_llm_script(
      harness.llm,
      [llm_text("{\"verdict\":\"done\"}")],
      { ->
        const captured = agent_capture_events(
          harness.agent,
          session,
          { -> return __judge_run_checkpoint(harness, request(session, 15581)) },
        )
        const admission = captured.result.admission
        contract_effect(
          harness.stdio,
          "late_judge_runs_with_remaining_budget",
          captured.result.checkpoint.ok && len(harness.llm.mock_calls()) == 1
            && admission.admitted
            && admission.operation_budget_ms == 10581
            && admission.provider_timeout_ms == 10581
            && admission.requested_operation_budget_ms == 60000,
        )
        const receipts = captured.events.filter(
          { event ->
            event.type == "typed_checkpoint"
              && event?.checkpoint?.schema == "harn.completion_judge_admission.v1"
          },
        )
          .to_list()
        assert(len(receipts) >= 1 && receipts[0].checkpoint.operation_budget_ms == 10581)
      },
    )
    with_llm_script(
      harness.llm,
      [llm_text("must not run")],
      { ->
        const refused = __judge_run_checkpoint(harness, request(session, 5000))
        contract_negative(
          harness.stdio,
          "terminal_reserve_prevents_dispatch",
          refused.admission.admitted || len(harness.llm.mock_calls()) != 0
            || refused.checkpoint.status != "admission_refused",
        )
      },
    )
    harness.agent.close(session)
  } finally {
    harness.testing.clock_reset()
  }
}
