// A comment delimiter inside a substitution must not hide an executed stash
// mutation. Read-only substitutions remain available.
import {
  NO_CONFIG_ALIASES,
  NO_GIT_BUILTINS,
  UNMEASURED_MAKE_TARGETS,
  decision,
} from "../../../scripts/agent_shell_guard"
import { contract_effect, contract_negative } from "./lib/mechanism_contract"

fn payload(command: string) -> string {
  return json_stringify({tool_name: "Bash", tool_input: {command: command}})
}

pipeline default(harness: Harness) {
  const write = decision(
    payload("echo \"$( # )\ngit stash drop\n)\""),
    UNMEASURED_MAKE_TARGETS,
  )
  const read = decision(
    payload("echo \"$( # )\ngit stash list\n)\""),
    UNMEASURED_MAKE_TARGETS,
  )
  contract_effect(harness.stdio, "trigger_stash_mutation_is_denied", !write.allow)
  contract_effect(harness.stdio, "effect_denial_names_stash", write.reason.contains("git stash"))
  contract_negative(harness.stdio, "negative_read_only_substitution_is_not_denied", !read.allow)
  const parse = { source, query ->
    harness.ast.search({source: source, language: "bash", query: query})
  }
  const literal = decision(
    payload("printf '%s' '$(git stash drop)'\ncat <<EOF\nhello\nEOF"),
    UNMEASURED_MAKE_TARGETS,
    NO_CONFIG_ALIASES,
    NO_GIT_BUILTINS,
    parse,
  )
  const expanding = decision(
    payload("cat <<EOF\n'`git stash drop`'\nEOF"),
    UNMEASURED_MAKE_TARGETS,
    NO_CONFIG_ALIASES,
    NO_GIT_BUILTINS,
    parse,
  )
  const incomplete = decision(
    payload("printf '%s' '$(git stash drop)'\ncat <<EOF\nhello\nEOF"),
    UNMEASURED_MAKE_TARGETS,
    NO_CONFIG_ALIASES,
    NO_GIT_BUILTINS,
    { source, query ->
      {result: "ok", had_errors: false, truncated: false, match_count: 1, matches: []}
    },
  )
  contract_effect(harness.stdio, "trigger_expanding_heredoc_mutation_is_denied", !expanding.allow)
  contract_negative(harness.stdio, "negative_literal_outside_heredoc_is_allowed", !literal.allow)
  contract_effect(harness.stdio, "effect_incomplete_parse_keeps_the_denial", !incomplete.allow)
}
