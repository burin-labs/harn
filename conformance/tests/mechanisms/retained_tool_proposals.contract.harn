// Trigger: one response proposes an edit beside an observation.
// Effect: explicit confirmation executes the original body through ordinary dispatch.
// Negative: discard or a newer observation cannot execute the stale proposal.
import { retained_proposal_trial } from "../../testlib/tool_batch_proposals"
import { contract_effect, contract_negative } from "./lib/mechanism_contract"

pipeline default(harness: Harness) {
  const confirmed = retained_proposal_trial(harness, "resume")
  contract_effect(
    harness.stdio,
    "trigger_mixed_batch_retains_edit_after_observation",
    confirmed.observations == 1 && confirmed.deferred == 1,
  )
  contract_effect(
    harness.stdio,
    "effect_explicit_confirmation_executes_original_body_once",
    confirmed.confirmed == 1 && confirmed.mutations == 1 && confirmed.requests == 3
      && confirmed.body_copies == 1
      && confirmed.attempted == 2
      && confirmed.succeeded == 2,
  )
  contract_effect(
    harness.stdio,
    "effect_confirmation_preserves_served_tool_prefix",
    confirmed.stable_tools,
  )
  const discarded = retained_proposal_trial(harness, "discard")
  contract_negative(
    harness.stdio,
    "negative_discard_never_executes_retained_edit",
    discarded.mutations != 0 || discarded.discarded != 1 || discarded.attempted != 1,
  )
  const reread = retained_proposal_trial(harness, "reread")
  contract_negative(
    harness.stdio,
    "negative_new_observation_requires_fresh_confirmation",
    reread.mutations != 0 || reread.observations != 2 || reread.deferred != 2
      || reread.confirmed != 1
      || reread.discarded != 1,
  )
}
