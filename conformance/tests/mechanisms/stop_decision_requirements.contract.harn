// Trigger: a declared response requirement lacks supporting observations.
// Effect: the live stop decision remains incomplete and names the pending row.
// Negative: a supported read-only answer completes without invented tool calls.
import { CompletionFacts, agent_completion_gate } from "std/agent/completion_gate"
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

const RESPONSE_REQUIREMENT = {
  requirements: [
    {requirement_id: "answer", name: "Answer the question", evidence_roles: ["assistant_output"]},
  ],
}

const ANSWER_EVIDENCE = {
  evidence_index: -1,
  role: "assistant_output",
  supports_completion: true,
  summary: "The requested answer was provided.",
  representative_artifact_ids: [],
}

fn check_requirement_case(
  harness: Harness,
  extra: CompletionFacts,
  expected_pending: int,
  model_judge: bool = false,
) {
  const session_id = "stop-requirements-" + harness.random.uuid()
  const calls_key = session_id + ".facts_calls"
  harness.runtime.store_set(calls_key, 0)
  with_llm_script(
    harness.llm,
    [
      llm_text("The answer.\n##DONE##"),
      if model_judge {
        llm_text(json_stringify({verdict: "done", detail: "The answer meets the request."}))
      } else {
        llm_text("The answer.\n##DONE##")
      },
    ],
    { ->
      const captured = agent_capture_events(
        harness.agent,
        session_id,
        fn() { return agent_loop(
          harness,
          "Answer the question.",
          nil,
          {
            provider: "mock",
            session_id: session_id,
            max_iterations: 2,
            loop_until_done: true,
            verify_completion_judge: if model_judge {
              {provider: "mock", max_invocations: 1}
            } else {
              nil
            },
          }
            + agent_completion_gate(
              harness.runtime,
              {
                max_vetoes: 1,
                requirement_contract: RESPONSE_REQUIREMENT,
                facts: fn(ctx) {
                  assert_eq(ctx.session_id, session_id)
                  assert(len(ctx.messages) > 0)
                  harness.runtime.store_set(calls_key, harness.runtime.store_get(calls_key) + 1)
                  return {source_write_count: 0, requires_write: false, verify: {ok: true}}
                    + extra
                },
              },
            ),
        ) },
      )
      assert(harness.runtime.store_get(calls_key) > 0, "The live loop must consult the facts")
      if model_judge {
        assert_eq(len(harness.llm.mock_calls()), 2, "The later model judge must run")
      }
      assert_eq(captured.result.status == "done", expected_pending == 0)
      const receipts = captured.events.filter(
        fn(event) { return event.type == "typed_checkpoint"
          && event?.checkpoint?.schema == "harn.completion_directive_receipt.v1" },
      )
        .to_list()
      assert(len(receipts) > 0, "The live stop decision must publish its evidence")
      for event in receipts {
        const report = event.checkpoint.requirements
        assert(report != nil, "A required roster cannot disappear from the decision")
        assert_eq(report.required_count, 1)
        assert_eq(report.pending_count, expected_pending)
        assert_eq(len(report.pending_names), expected_pending)
      }
    },
  )
}

fn check_three_adjudicators(harness: Harness, delivery_met: bool) {
  const sid = "stop-three-adjudicators-" + harness.random.uuid()
  const review_contract = {
    requirements: [
      {requirement_id: "review", name: "Review", evidence_roles: ["assistant_output"]},
    ],
  }
  const delivery_contract = {
    requirements: [
      {requirement_id: "delivery", name: "Delivery", evidence_roles: ["assistant_output"]},
    ],
  }
  with_llm_script(
    harness.llm,
    [
      llm_text("The answer.\n##DONE##"),
      llm_text(
        json_stringify(
          {
            verdict: "done",
            detail: "The answer is reviewed.",
            requirement_report: [{requirement_id: "review", met: true, evidence_refs: [-1]}],
          },
        ),
      ),
      llm_text(
        json_stringify(
          {
            verdict: "done",
            detail: "The delivery was assessed.",
            requirement_report: [
              {requirement_id: "delivery", met: delivery_met, evidence_refs: [-1]},
            ],
          },
        ),
      ),
    ],
    fn() {
      const captured = agent_capture_events(
        harness.agent,
        sid,
        fn() { return agent_loop(
          harness,
          "Answer the question.",
          nil,
          {
            provider: "mock",
            session_id: sid,
            max_iterations: 1,
            loop_until_done: true,
            final_wrapup: false,
            verify_completion_judge: {provider: "mock", requirement_contract: review_contract},
            turn_end_condition: {provider: "mock", requirement_contract: delivery_contract},
          }
            + agent_completion_gate(
              harness.runtime,
              {
                requirement_contract: RESPONSE_REQUIREMENT,
                facts: fn(ctx) {
                  assert_eq(ctx.session_id, sid)
                  return {
                    source_write_count: 0,
                    requires_write: false,
                    verify: {ok: true},
                    requirement_assessments: [
                      {requirement_id: "answer", met: true, evidence_refs: [-1]},
                    ],
                    requirement_evidence: [ANSWER_EVIDENCE],
                  }
                },
              },
            ),
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 3, "Both model adjudicators must run")
      assert_eq(captured.result.status == "done", delivery_met)
      const receipts = captured.events.filter(
        fn(event) { return event.type == "typed_checkpoint"
          && event?.checkpoint?.schema == "harn.completion_directive_receipt.v1" },
      )
        .to_list()
      assert_eq(len(receipts), 1)
      const report = receipts[0].checkpoint.requirements
      assert_eq(report.required_count, 3)
      assert_eq(
        report.pending_count,
        if delivery_met {
          0
        } else {
          1
        },
      )
      assert_eq(
        report.pending_names,
        if delivery_met {
          []
        } else {
          ["Delivery"]
        },
      )
    },
  )
}

fn check_unassessed_scheduled_judge(harness: Harness) {
  const sid = "stop-scheduled-requirements-" + harness.random.uuid()
  with_llm_script(
    harness.llm,
    [llm_text("The answer.\n##DONE##")],
    fn() {
      const captured = agent_capture_events(
        harness.agent,
        sid,
        fn() { return agent_loop(
          harness,
          "Answer the question.",
          nil,
          {
            provider: "mock",
            session_id: sid,
            max_iterations: 1,
            loop_until_done: true,
            final_wrapup: false,
            turn_end_condition: {
              provider: "mock",
              cadence: {every: 10},
              requirement_contract: RESPONSE_REQUIREMENT,
            },
            verify_completion: fn(_ctx) { return {confirm: true, reason: "verified"} },
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 1, "The scheduled judge must not be due yet")
      assert(captured.result.status != "done", "A scheduled but unassessed requirement is pending")
      const receipts = captured.events.filter(
        fn(event) { return event.type == "typed_checkpoint"
          && event?.checkpoint?.schema == "harn.completion_directive_receipt.v1" },
      )
        .to_list()
      assert_eq(len(receipts), 1)
      assert_eq(receipts[0].checkpoint.action, "continue")
      assert_eq(receipts[0].checkpoint.requirements.required_count, 1)
      assert_eq(receipts[0].checkpoint.requirements.pending_count, 1)
    },
  )
}

pipeline default(harness: Harness) {
  // Missing and empty observations cannot pass because an unrelated verifier did.
  check_requirement_case(harness, {}, 1)
  check_requirement_case(harness, {requirement_assessments: [], requirement_evidence: []}, 1)
  check_requirement_case(
    harness,
    {
      requirement_assessments: [{requirement_id: "answer", met: true, evidence_refs: [-1]}],
      requirement_evidence: [ANSWER_EVIDENCE + {supports_completion: false}],
    },
    1,
  )
  // A read-only answer can complete without invented tool calls or artifacts.
  check_requirement_case(
    harness,
    {
      requirement_assessments: [{requirement_id: "answer", met: true, evidence_refs: [-1]}],
      requirement_evidence: [ANSWER_EVIDENCE],
    },
    0,
  )
  // A later judge with no separate roster must preserve the gate's evidence.
  check_requirement_case(
    harness,
    {
      requirement_assessments: [{requirement_id: "answer", met: true, evidence_refs: [-1]}],
      requirement_evidence: [ANSWER_EVIDENCE],
    },
    0,
    true,
  )
  check_three_adjudicators(harness, true)
  check_three_adjudicators(harness, false)
  check_unassessed_scheduled_judge(harness)
  harness.stdio.println("stop requirement cases passed")
}
