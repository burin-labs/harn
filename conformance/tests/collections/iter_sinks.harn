pipeline test(harness: Harness, task: unknown) {
  harness.stdio.log(iter([1, 2, 3, 4]).count())
  harness.stdio.log(iter([1, 2, 3, 4]).sum())
  harness.stdio.log(iter([3, 1, 4, 1, 5]).min())
  harness.stdio.log(iter([3, 1, 4, 1, 5]).max())
  harness.stdio.log(iter([1, 2, 3, 4]).reduce(0, { acc, x -> acc + x }))
  harness.stdio.log(iter([10, 20, 30]).first())
  harness.stdio.log(iter([10, 20, 30]).last())
  harness.stdio.log(iter([]).first())
  harness.stdio.log(iter([]).last())
  harness.stdio.log(iter([]).min())
  harness.stdio.log(iter([]).sum())
  harness.stdio.log(iter([1, 2, 3]).any({ x -> x > 2 }))
  harness.stdio.log(iter([1, 2, 3]).any({ x -> x > 99 }))
  harness.stdio.log(iter([1, 2, 3]).all({ x -> x > 0 }))
  harness.stdio.log(iter([1, 2, 3]).all({ x -> x > 1 }))
  harness.stdio.log(iter([1, 2, 3, 4]).find({ x -> x > 2 }))
  harness.stdio.log(iter([1, 2, 3]).find({ x -> x > 99 }))
  iter([1, 2, 3]).for_each({ x -> harness.stdio.log("v=${x}") })
  harness.stdio.log(iter([1, 1, 2, 2, 3]).to_set())
  const d = iter([pair("a", 1), pair("b", 2)]).to_dict()
  harness.stdio.log(d.a)
  harness.stdio.log(d.b)
}
