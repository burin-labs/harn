pipeline test(harness: Harness, task) {
  // `to` is inclusive by default
  const nums = 1 to 5
  harness.stdio.println(nums)
  // trailing `exclusive` makes it half-open
  const half = 0 to 3 exclusive
  harness.stdio.println(half)
  // Works in for-in
  for i in 1 to 3 {
    harness.stdio.println(i)
  }
}
