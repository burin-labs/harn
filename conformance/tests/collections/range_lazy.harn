pipeline test(harness: Harness, task) {
  // A million-element range must cost O(1) memory (no list allocation).
  // If this were eager the test would OOM or be extremely slow.
  const r = 1 to 1000000
  harness.stdio.println(r.len())
  // `range(n)` is also lazy.
  const r2 = range(1000000)
  harness.stdio.println(r2.len())
}
