pipeline test(harness: Harness, task) {
  // r[k] is O(1) and computes start + k with a bounds check.
  const r = 1 to 10
  harness.stdio.log(r[0])
  harness.stdio.log(r[3])
  harness.stdio.log(r[9])
  // Negative indices count from the end (Python-style).
  harness.stdio.log(r[-1])
  harness.stdio.log(r[-10])
  // Exclusive ranges index the same way
  const e = 0 to 5 exclusive
  harness.stdio.log(e[0])
  harness.stdio.log(e[4])
}
