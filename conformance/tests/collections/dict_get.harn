pipeline test(harness: Harness, task: unknown) {
  const d = {name: "Alice", age: 30, active: true}
  // 1-arg: key exists
  harness.stdio.log(d.get("name"))
  harness.stdio.log(d.get("age"))
  harness.stdio.log(d.get("active"))
  // 1-arg: key missing -> nil
  harness.stdio.log(d.get("missing"))
  // 2-arg: key exists -> value (ignores default)
  harness.stdio.log(d.get("name", "fallback"))
  // 2-arg: key missing -> default
  harness.stdio.log(d.get("missing", 0))
  harness.stdio.log(d.get("missing", "default_val"))
  harness.stdio.log(d.get("missing", false))
  // 0-arg: no key -> nil
  harness.stdio.log(d.get())
}
