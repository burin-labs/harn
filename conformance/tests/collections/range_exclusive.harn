pipeline test(task) {
  // `to ... exclusive` is the half-open form. `.to_list()` is the
  // explicit path to materialize a range into a list for printing.
  const xs = 0 to 4 exclusive
  log(xs.to_list())
  // used in a for loop
  let sum = 0
  for i in 1 to 5 exclusive {
    sum += i
  }
  log(sum)
  // empty when end <= start
  const empty = 5 to 5 exclusive
  log(len(empty))
}
