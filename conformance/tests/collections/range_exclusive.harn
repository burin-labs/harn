pipeline test(harness: Harness, task: unknown) {
  // `start..end` is the half-open form. `.to_list()` is the
  // explicit path to materialize a range into a list for printing.
  const xs = 0..4
  harness.stdio.log(xs.to_list())
  // used in a for loop
  let sum = 0
  for i in 1..5 {
    sum += i
  }
  harness.stdio.log(sum)
  // empty when end <= start
  const empty = 5..5
  harness.stdio.log(len(empty))
}
