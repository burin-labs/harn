pipeline test(harness: Harness, task) {
  const xs = [1, 2, 3, 4]
  harness.stdio.log(stream.collect(stream.map(xs, { x -> x * 10 })))
  harness.stdio.log(stream.collect(stream.filter(xs, { x -> x % 2 == 0 })))
  const tapped = harness.runtime.atomic(0)
  const tapped_values = stream.collect(
    stream.tap([1, 2], { x -> harness.runtime.atomic_add(tapped, x * 10) }),
  )
  harness.stdio.log(tapped_values)
  harness.stdio.println(harness.runtime.atomic_get(tapped))
  harness.stdio.log(stream.collect(stream.scan([1, 2, 3], 0, { acc, x -> acc + x })))
  harness.stdio.log(stream.fold([1, 2, 3, 4], 0, { acc, x -> acc + x }))
  harness.stdio.log(stream.collect([], 5))
  harness.stdio.log(stream.first([]))
  harness.stdio.log(stream.first([7, 8]))
  harness.stdio.log(stream.collect(stream.take(xs, 2)))
  harness.stdio.log(stream.collect(stream.take(xs, 0)))
  harness.stdio.log(stream.collect(stream.take_until(xs, { x -> x == 3 })))
  harness.stdio.log(stream.collect(stream.zip([1, 2, 3], ["a", "b"])))
  harness.stdio.log(stream.collect(stream.merge([1, 3], [2, 4])))
  harness.stdio.log(stream.collect(stream.interleave(["a", "c"], ["b", "d"])))
  harness.stdio.log(stream.collect(stream.race([], [9, 10], [11])))
  const copies = stream.broadcast([1, 2, 3], 2)
  harness.stdio.log(stream.collect(copies[0]))
  harness.stdio.log(stream.collect(copies[1]))
  harness.stdio.log(stream.collect(stream.throttle([1], 1000)))
  harness.stdio.log(stream.collect(stream.debounce([1, 2, 3], 0)))
  const cap_error = try {
    stream.collect([1, 2, 3], {max: 2})
    "missing"
  } catch (e) {
    "cap"
  }
  harness.stdio.log(cap_error)
  const mid_error = try {
    stream.collect(
      stream.map(
        [1, 2, 3],
        { x ->
          if x == 2 {
            throw "boom"
          }
          return x
        },
      ),
    )
    "missing"
  } catch (e) {
    "mid"
  }
  harness.stdio.log(mid_error)
  harness.stdio.log("stream_operators_core tests passed")
}
