/** Test Ruby-inspired list methods */
pipeline default(task) {
  const nums = [1, 2, 3, 4, 5, 6, 7, 8]
  // none
  __io_println(nums.none({ x -> x > 100 }))
  __io_println(nums.none({ x -> x > 5 }))
  // every (alias for all)
  __io_println(nums.every({ x -> x > 0 }))
  __io_println(nums.every({ x -> x > 5 }))
  // find_index
  __io_println(nums.find_index({ x -> x > 3 }))
  __io_println(nums.find_index({ x -> x > 100 }))
  // first / last
  __io_println(nums.first())
  __io_println(nums.last())
  __io_println(nums.first(3))
  __io_println(nums.last(2))
  // partition
  const parts = nums.partition({ x -> x % 2 == 0 })
  __io_println(parts.first())
  __io_println(parts.last())
  // chunk
  __io_println([1, 2, 3, 4, 5].chunk(2))
  // compact
  __io_println([1, nil, 2, nil, 3].compact())
  // tally
  __io_println(["a", "b", "a", "c", "b", "a"].tally())
  // min_by / max_by
  const words = ["hello", "hi", "hey"]
  __io_println(words.min_by({ w -> len(w) }))
  __io_println(words.max_by({ w -> len(w) }))
  // group_by — discriminator must be a string (v0.8.43+); coerce explicitly.
  const grouped = [1, 2, 3, 4, 5, 6].group_by({ x -> to_string(x % 2 == 0) })
  __io_println(grouped)
  // each_cons (sliding window)
  __io_println([1, 2, 3, 4].each_cons(2))
}
