pipeline test(harness: Harness, task) {
  harness.stdio.println(iter([1, 2]).chain([3, 4]).to_list())
  harness.stdio.println(iter([]).chain([1, 2, 3]).to_list())
  harness.stdio.println(iter([1, 2, 3]).chain([]).to_list())
  harness.stdio.println(iter([]).chain([]).to_list())
  harness.stdio.println(iter([1, 2]).chain([3, 4]).chain([5, 6]).to_list())
}
