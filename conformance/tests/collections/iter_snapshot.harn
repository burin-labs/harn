pipeline test(harness: Harness, task) {
  // Iter snapshots the source: reassigning the source binding to a new
  // list does not affect what the already-constructed iter yields.
  let xs = [1, 2, 3]
  const it = iter(xs)
  xs = xs + [99]
  harness.stdio.log(it.to_list())
  harness.stdio.log(xs)
}
