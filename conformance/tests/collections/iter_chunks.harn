pipeline test(harness: Harness, task) {
  const a = iter([1, 2, 3, 4, 5]).chunks(2).to_list()
  harness.stdio.log(a)
  const b = iter([1, 2, 3, 4, 5, 6]).chunks(3).to_list()
  harness.stdio.log(b)
  const c = iter([1, 2, 3]).chunks(10).to_list()
  harness.stdio.log(c)
  const d = iter([]).chunks(2).to_list()
  harness.stdio.log(d)
  harness.stdio.log(len(d))
}
