/** Test set method syntax and new operations */
pipeline default(task) {
  const a = set([1, 2, 3, 4])
  const b = set([3, 4, 5, 6])
  // Basic methods
  __io_println(a.count())
  __io_println(a.contains(2))
  __io_println(a.contains(9))
  __io_println(a.empty())
  // add / remove (return new sets)
  const c = a.add(5)
  __io_println(c.count())
  const d = a.remove(1)
  __io_println(d.count())
  // Set operations
  __io_println(a.union(b).count())
  __io_println(a.intersect(b).count())
  __io_println(a.difference(b).count())
  __io_println(a.symmetric_difference(b).count())
  // Subset / superset / disjoint
  const small = set([2, 3])
  __io_println(small.is_subset(a))
  __io_println(a.is_superset(small))
  __io_println(a.is_disjoint(b))
  __io_println(set([10, 20]).is_disjoint(a))
  // to_list
  const lst = set([3, 1, 2]).to_list()
  __io_println(len(lst))
  // map / filter
  const doubled = set([1, 2, 3]).map({ x -> x * 2 })
  __io_println(doubled.count())
  const evens = a.filter({ x -> x % 2 == 0 })
  __io_println(evens.count())
  // any / all
  __io_println(a.any({ x -> x > 3 }))
  __io_println(a.all({ x -> x > 0 }))
  __io_println(a.all({ x -> x > 2 }))
}
