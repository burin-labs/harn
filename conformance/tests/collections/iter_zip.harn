pipeline test(harness: Harness, task) {
  const pairs = iter([1, 2, 3]).zip([10, 20, 30]).to_list()
  for p in pairs {
    harness.stdio.log("${p.first}=${p.second}")
  }
  const short = iter([1, 2, 3, 4]).zip([10, 20]).to_list()
  harness.stdio.log(len(short))
  for (a, b) in iter([1, 2, 3, 4]).zip([10, 20]) {
    harness.stdio.log("${a}|${b}")
  }
}
