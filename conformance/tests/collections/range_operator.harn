pipeline test(harness: Harness, task: unknown) {
  // `..=` creates an inclusive range
  const r = 1..=5
  harness.stdio.log(r)
  // `..=` in a for loop
  let sum = 0
  for i in 1..=4 {
    sum += i
  }
  harness.stdio.log(sum)
  // compare with the half-open `..` form
  const inc = 1..=3
  const exc = 1..3
  harness.stdio.log(len(inc))
  harness.stdio.log(len(exc))
}
