pipeline test(harness: Harness, task: unknown) {
  const nums = [3, 1, 4, 1, 5, 9]
  harness.stdio.log(nums.sorted())
  harness.stdio.log(nums.reversed())
  harness.stdio.log([1, 2, 3].join(", "))
  harness.stdio.log([1, 2, 3].contains(2))
  harness.stdio.log([1, 2, 3].index_of(2))
  harness.stdio.log([1, 2, 3, 2, 1].unique())
  harness.stdio.log([1, 2, 3, 4, 5].take(3))
  harness.stdio.log([1, 2, 3, 4, 5].skip(2))
  harness.stdio.log([1, 2, 3, 4, 5].slice(1, 3))
  harness.stdio.log([1, 2, 3].sum())
}
