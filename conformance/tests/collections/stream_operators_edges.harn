pipeline test(harness: Harness, task) {
  harness.stdio.println(stream.collect(stream.map([], { x -> x })))
  harness.stdio.println(stream.collect(stream.filter([1], { x -> x == 1 })))
  harness.stdio.println(
    stream.collect(
      stream.tap(
        [],
        { x ->
          throw "tap should not run"
        },
      ),
    ),
  )
  harness.stdio.println(stream.collect(stream.scan([5], 1, { acc, x -> acc + x })))
  harness.stdio.println(stream.fold([], "seed", { acc, x -> acc + x }))
  harness.stdio.println(stream.collect(stream.take([1], 5)))
  harness.stdio.println(stream.collect(stream.take_until([1], { x -> x == 9 })))
  harness.stdio.println(stream.first([42]))
  harness.stdio.println(stream.collect(stream.merge([], [1])))
  harness.stdio.println(stream.collect(stream.interleave([], [1])))
  harness.stdio.println(stream.collect(stream.zip([], [1])))
  harness.stdio.println(stream.collect(stream.race([], [2])))
  const copies = stream.broadcast([], 1)
  harness.stdio.println(stream.collect(copies[0]))
  harness.stdio.println(stream.collect(stream.throttle([], 1000)))
  harness.stdio.println(stream.collect(stream.debounce([], 0)))
  const empty_channel = harness.runtime.channel("empty", 1)
  const ready_channel = harness.runtime.channel("ready", 1)
  harness.runtime.send(ready_channel, "ready")
  harness.stdio.println(stream.first(stream.merge(empty_channel, ready_channel)))
  const slow_channel = harness.runtime.channel("slow", 1)
  const winner_channel = harness.runtime.channel("winner", 1)
  harness.runtime.send(winner_channel, "winner")
  harness.stdio.println(stream.first(stream.race(slow_channel, winner_channel)))
  const source_error = stream.map(
    [1, 2],
    { x ->
      if x == 2 {
        throw "source failed"
      }
      return x
    },
  )
  const propagated = try {
    stream.collect(stream.merge(source_error, [3]))
    "missing"
  } catch (e) {
    "propagated"
  }
  harness.stdio.println(propagated)
  harness.stdio.println("stream_operators_edges tests passed")
}
