pipeline test(harness: Harness, task: unknown) {
  const d = {a: 1, b: 2, c: 3}
  harness.stdio.log(d.entries().map({ x -> x.key }))
  harness.stdio.log(d.entries().map({ x -> x.value }))
  harness.stdio.log(d.count)
  const mapped_values = d.map_values({ v -> v * 2 })
  harness.stdio.log(mapped_values.a)
  harness.stdio.log(mapped_values.b)
  harness.stdio.log(mapped_values.c)
  const filtered_dict = d.filter({ v -> v > 1 })
  harness.stdio.log(filtered_dict.has("a"))
  harness.stdio.log(filtered_dict.has("b"))
  harness.stdio.log(filtered_dict.has("c"))
  const d_remove = {a: 1, b: 2, c: 3}
  const without_b = d_remove.removing("b")
  harness.stdio.log(d_remove.has("a"))
  harness.stdio.log(d_remove.has("b"))
  harness.stdio.log(d_remove.has("c"))
  harness.stdio.log(without_b.has("a"))
  harness.stdio.log(without_b.has("b"))
  harness.stdio.log(without_b.has("c"))
  harness.stdio.log(d.get("a"))
  harness.stdio.log(d.get("z", "default_value"))
  harness.stdio.log(d.get("z"))
  const dynamic_key = "b"
  const computed = {a: 1, [dynamic_key]: 2}
  harness.stdio.log(computed.get("a"))
  harness.stdio.log(computed.get("b"))
}
// Should be nil
