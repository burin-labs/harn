pipeline default() {
  const input = "b"
  const label = match input {
    "a" -> { "alpha" }
    "b" -> { "bravo" }
    _ -> { "other" }
  }
  __io_println(label)
  const n = 7
  const size = match n {
    0 -> { "zero" }
    x if x > 5 -> {
      let prefix = "large"
      prefix + ":" + to_string(x)
    }
    _ -> { "small" }
  }
  __io_println(size)
  const pair = [10, 20]
  const second = match pair {
    [_, value] -> { value }
    _ -> { 0 }
  }
  __io_println(second)
}
