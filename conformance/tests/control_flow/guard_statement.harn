pipeline test(harness: Harness, task) {
  fn check_positive(x) {
    guard x > 0 else {
      return "not positive"
    }
    return "positive: ${x}"
  }
  harness.stdio.log(check_positive(5))
  harness.stdio.log(check_positive(-1))
  fn check_string(val) {
    guard type_of(val) == "string" else {
      return "not a string"
    }
    return "string: ${val}"
  }
  harness.stdio.log(check_string("hello"))
  harness.stdio.log(check_string(42))
}
