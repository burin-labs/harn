pipeline test(harness: Harness, task) {
  // A `retry` expression evaluates to its body's success value, like if/match/try.
  const r = retry 3 {
    42
  }
  harness.stdio.log(r)
  let attempts = 0
  const r2 = retry 3 {
    attempts = attempts + 1
    if attempts < 2 {
      throw "transient"
    }
    "ok at ${attempts}"
  }
  harness.stdio.log(r2)
}
