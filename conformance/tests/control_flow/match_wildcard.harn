pipeline default() {
  // Wildcard pattern
  const x = 42
  let result = ""
  match x {
    1 -> { result = "one" }
    2 -> { result = "two" }
    _ -> { result = "other" }
  }
  __io_println(result)
  // Wildcard with strings
  const s = "hello"
  let r2 = ""
  match s {
    "bye" -> { r2 = "farewell" }
    _ -> { r2 = "catch-all" }
  }
  __io_println(r2)
}
