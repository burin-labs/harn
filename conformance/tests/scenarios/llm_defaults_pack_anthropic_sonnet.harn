// pack_for(claude-sonnet-4-5, agent, reasoning_policy="medium") layers:
//   1. catalog defaults
//   2. scale calibration → {temperature: 0.7, max_tokens: 4096}
//   3. reasoning policy → {thinking: {enabled: true, budget_tokens: 4096}}
//   4. task overlay (agent) fills only unset fields
import { pack_for } from "std/llm/defaults"

pipeline test(task) {
  const r = pack_for(
    {model: "claude-sonnet-4-5", reasoning_policy: "medium", reasoning_task: "agent"},
  )
  assert_eq(type_of(r), "dict")
  assert_eq(r.model, "claude-sonnet-4-5")
  assert_eq(r.provider, "anthropic")
  // Policy lowering produces the lineage-specific low-level setting.
  assert_eq(type_of(r.thinking), "dict")
  assert_eq(r.thinking.enabled, true)
  assert_eq(r.thinking.budget_tokens, 4096)
  // Medium scale sets temperature 0.7 and max_tokens 4096.
  assert_eq(r.temperature, 0.7)
  assert_eq(r.max_tokens, 4096)
  // Task overlay fills the unset agent slots.
  assert_eq(r.top_p, 0.95)
  assert_eq(r.schema_retries, 0)
  assert_eq(r.output, "text")
  // Canonical policy fields survive for introspection.
  assert_eq(r.reasoning_policy, "medium")
  assert_eq(r.reasoning_task, "agent")
  log("llm_defaults_pack_anthropic_sonnet passed")
}
