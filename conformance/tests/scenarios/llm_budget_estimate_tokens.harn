// std/llm/budget.estimate_text_tokens uses heuristics keyed off content
// shape. We assert each branch returns a token count within ~20% of
// the expected value.
import { estimate_text_tokens } from "std/llm/budget"

fn in_range(name, actual, low, high) {
  if actual < low || actual > high {
    __io_println(
      name + " out of range: " + to_string(actual) + " not in [" + to_string(low) + ", "
        + to_string(high)
        + "]",
    )
    return false
  }
  return true
}

pipeline default() {
  // English: ~98 chars → ~25 tokens. Allow 20-30.
  const english = "the quick brown fox jumps over the lazy dog and then keeps on running through fields and trees end"
  __io_println(in_range("english", estimate_text_tokens(english, "any"), 20, 30))
  // Code: braces and parens push it into the code branch (length/3.5).
  const code = "fn foo() { let bar = (1 + 2) * 3; if (bar > 0) { return bar } else { return 0 } }"
  __io_println(in_range("code", estimate_text_tokens(code, "any"), 20, 30))
  // CJK: 10 chars all in U+4E00..U+9FFF → ~10 tokens (length * 1.0).
  const cjk = "你好世界一二三四五六"
  __io_println(in_range("cjk", estimate_text_tokens(cjk, "any"), 8, 12))
  // empty
  __io_println(estimate_text_tokens("", "any"))
  __io_println(estimate_text_tokens(nil, "any"))
}
