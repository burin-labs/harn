import { execution_contract } from "std/llm/catalog"

pipeline test(harness: Harness, task: unknown) {
  const selector = "claude-sonnet-4-20250514"
  const contract = execution_contract(harness.llm, selector)
  assert_eq(contract.schema, "harn.llm.execution-contract/v2")
  assert_eq(contract.requested_model, selector)
  assert_eq(contract.alias_chain, [])
  assert_eq(contract.resolved_model, selector)
  assert_eq(contract.resolved_provider, "anthropic")
  assert_eq(type_of(contract.catalog_version), "string")
  assert_eq(type_of(contract.wire_model), "string")
  assert_eq(type_of(contract.tool_format), "string")
  assert_eq(type_of(contract.generation_defaults), "dict")
  harness.stdio.log("llm_execution_contract_basic passed")
}
