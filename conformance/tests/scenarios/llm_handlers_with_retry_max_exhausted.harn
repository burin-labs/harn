// Conformance test for std/llm/handlers::with_retry — exhausting
// max_attempts surfaces the last envelope plus retries_attempted.
import { with_retry } from "std/llm/handlers"

pipeline default(harness: Harness) {
  const counter = harness.runtime.atomic(0)
  const synthetic = { _call ->
    let _ = harness.runtime.atomic_add(counter, 1)
    return {ok: false, status: "transient", error: "always blips"}
  }
  const caller = with_retry(harness, synthetic, {max_attempts: 3, base_ms: 1})
  const env = caller(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  harness.stdio.println(env.ok)
  harness.stdio.println(env.status)
  harness.stdio.println(env.retries_attempted)
  harness.stdio.println(harness.runtime.atomic_get(counter))
}
