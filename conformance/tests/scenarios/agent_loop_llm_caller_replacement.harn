/**
 * Custom llm_caller short-circuits llm_call with a hardcoded value;
 * agent_loop returns the caller's `value` payload as the visible text.
 */
pipeline default() {
  const fake_caller = { _call ->
    return {
      ok: true,
      value: {
        text: "FAKE",
        model: "x",
        provider: "mock",
        input_tokens: 0,
        output_tokens: 0,
        usage: {input_tokens: 0, output_tokens: 0},
      },
    }
  }
  const result = agent_loop("hi", nil, {provider: "mock", llm_caller: fake_caller})
  __io_println(result.status)
  __io_println(result.visible_text)
}
