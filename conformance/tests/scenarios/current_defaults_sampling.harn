import { MissingToolCallRecoveryOptions } from "std/agent/options_types"
import { agent_scratchpad_reorganize } from "std/agent/scratchpad"
import { missing_tool_call_classifier } from "std/llm/missing_tool_call"
import { refine_prompt } from "std/llm/refine"
import { llm_text, with_llm_script } from "std/testing"

fn run_case(harness: Harness, provider: string, model: string) {
  const session = harness.agent.open("current-defaults-" + harness.random.uuid())
  harness.agent.set_scratchpad(
    session,
    {
      schema: "harn.agent_scratchpad.v1",
      goals: [{text: "Inspect a file", source_ref: "user:initial"}],
      open_items: [],
      facts: [],
      refs: [{id: "user:initial", kind: "user_input", label: "Inspect a file"}],
    },
  )
  const request = {
    session_id: session,
    iteration: 1,
    text: "I will inspect the file now.",
    visible_text: nil,
    tools: [{name: "inspect", description: "Inspect a file"}],
    tool_names: ["inspect"],
  }
  with_llm_script(
    harness.llm,
    [
      llm_text("Write a concise welcome.\nDIFF: shortened.")
        + {provider: provider, model: model},
      llm_text(
        json_stringify(
          {
            schema: "harn.agent_scratchpad.v1",
            goals: [{text: "Inspect a file", source_ref: "user:initial"}],
            open_items: [],
            facts: [],
            refs: [{id: "user:initial", kind: "user_input", label: "Inspect a file"}],
          },
        ),
      )
        + {provider: provider, model: model},
      llm_text(
        json_stringify(
          {
            answers: {
              intended: {verdict: true, confidence: 0.95, evidence: "explicit inspection intent"},
              tool: {choice: "inspect", confidence: 0.95, evidence: "inspection tool"},
            },
          },
        ),
      )
        + {provider: provider, model: model},
    ],
    { ->
      const refined = refine_prompt(
        harness.llm,
        {provider: provider, user_prompt: "Write a concise welcome message."},
      )
      assert(refined.ok, "refinement must reach the current provider default")
      assert_eq(refined.model, model)
      const reorganized = agent_scratchpad_reorganize(
        harness.agent,
        harness.llm,
        {session_id: session, task: "Inspect a file"},
        {provider: provider, scratchpad: {enabled: true}},
        1,
      )
      assert(reorganized.ok, "scratchpad reorganization must reach the provider")
      const classified = missing_tool_call_classifier(harness, {provider: provider})(request)
      assert(classified != nil)
      assert_eq(classified.action, "tool_call_intended")
      assert_eq(classified.tool_name, "inspect")
      assert_eq(classified.decision?.kind, "answered")
      assert_eq(len(harness.llm.mock_calls()), 3, "all three public callers must dispatch")
    },
  )
  with_llm_script(
    harness.llm,
    [],
    { ->
      const explicit_refine = try {
        refine_prompt(harness.llm, "Write a welcome.", {provider: provider, temperature: 0.0})
      }
      assert(is_err(explicit_refine), "explicit unsupported sampling must refuse")
      const explicit_scratchpad = agent_scratchpad_reorganize(
        harness.agent,
        harness.llm,
        {session_id: session, task: "Inspect a file"},
        {provider: provider, scratchpad: {enabled: true, reorganizer: {temperature: 0.0}}},
        2,
      )
      assert_eq(explicit_scratchpad.status, "llm_error")
      const explicit_classified = missing_tool_call_classifier(
        harness,
        {provider: provider, temperature: 0.0},
      )(
        request,
      )
      assert(explicit_classified != nil)
      const decision = explicit_classified.decision
      if decision != nil && decision.kind == "unavailable" {
        assert_eq(decision.reason, "unsupported_options")
      } else {
        throw "explicit classifier sampling must refuse before dispatch"
      }
      assert_eq(len(harness.llm.mock_calls()), 0, "explicit refusals precede dispatch")
    },
  )
}

fn unknown_effort_case(harness: Harness, effort: string?) {
  const model = "deepseek-ai/DeepSeek-V4-Pro-0813"
  const capabilities = harness.llm.provider_capabilities("together", model)
  assert_eq(capabilities.reasoning_effort_levels, [])
  let config: MissingToolCallRecoveryOptions = {provider: "together", model: model}
  if effort != nil {
    config = config + {effort: effort}
  }
  with_llm_script(
    harness.llm,
    [
      llm_text(
        json_stringify(
          {
            answers: {
              intended: {verdict: true, confidence: 0.95, evidence: "explicit inspection intent"},
              tool: {choice: "inspect", confidence: 0.95, evidence: "inspection tool"},
            },
          },
        ),
      )
        + {provider: "together", model: model},
    ],
    { ->
      const result = missing_tool_call_classifier(harness, config)(
        {
          session_id: "unknown-effort-" + harness.random.uuid(),
          iteration: 1,
          text: "I will inspect the file now.",
          visible_text: nil,
          tools: [{name: "inspect", description: "Inspect a file"}],
          tool_names: ["inspect"],
        },
      )
      assert_eq(result?.decision?.kind, "answered")
      assert_eq(result?.tool_name, "inspect")
      const calls = harness.llm.mock_calls()
      assert_eq(len(calls), 1, "unknown effort still dispatches")
      assert_eq(
        calls[0].thinking,
        if effort == nil {
          {mode: "disabled"}
        } else {
          {mode: "effort", level: effort}
        },
        "unknown ladder preserves omitted or explicit effort",
      )
      assert_eq(calls[0].max_tokens, 192)
    },
  )
}

pipeline test(harness: Harness) {
  run_case(harness, "openai", "gpt-6-luna")
  run_case(harness, "anthropic", "claude-sonnet-5-5")
  unknown_effort_case(harness, "low")
  unknown_effort_case(harness, nil)
  harness.stdio.println("current defaults dispatch; explicit unsupported sampling refuses")
}
