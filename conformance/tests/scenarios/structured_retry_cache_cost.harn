import { assert_approx, assert_eq, with_llm_script } from "std/testing"

pipeline test_structured_retry_cache_cost(harness: Harness) {
  const schema = {
    type: "object",
    additionalProperties: false,
    required: ["decision"],
    properties: {decision: {type: "string", enum: ["merge", "wait"]}},
  }
  with_llm_script(
    harness.llm,
    [
      {
        text: "{\"decision\":42}",
        provider: "anthropic",
        model: "claude-sonnet-4-20250514",
        input_tokens: 1000,
        output_tokens: 100,
        cache_read_tokens: 800,
        simulated_cost_usd: 0.00234,
      },
      {
        text: "{\"decision\":\"merge\"}",
        provider: "anthropic",
        model: "claude-sonnet-4-20250514",
        input_tokens: 1200,
        output_tokens: 200,
        cache_read_tokens: 1000,
        simulated_cost_usd: 0.0039,
      },
    ],
    { ->
      const before = harness.llm.session_cost().total_cost
      const result = harness.llm.call_structured_result(
        "Choose an action.",
        schema,
        {provider: "mock", schema_retries: 1, repair: {enabled: false}},
      )
      const charged = harness.llm.session_cost().total_cost - before
      assert_eq(result.ok, true)
      assert_eq(result.attempts, 2)
      assert_eq(result.usage.input_tokens, 2200)
      assert_eq(result.usage.output_tokens, 300)
      assert_eq(result.usage.cache_read_tokens, 1800)
      assert_eq(result.usage.provider_call_count, 2)
      assert_eq(result.usage.unpriced_calls, 0)
      assert_eq(result.usage.usage_unknown_calls, 0)
      assert_eq(result.usage.accounting_status, "reported")
      assert_approx(result.usage.cost_usd, 0.00624)
      assert_approx(result.usage.known_cost_usd, 0.00624)
      assert_approx(charged, 0.00624)
      harness.stdio.println("ok")
    },
  )
}
