// User-supplied opts always win over family/task calibration.
// reasoning_task: "judge" defaults to temperature: 0.0; user override 0.42 must win.
import { pack_for } from "std/llm/defaults"

pipeline test(task) {
  const r = pack_for({model: "claude-sonnet-4-5", reasoning_task: "judge", temperature: 0.42})
  assert_eq(r.temperature, 0.42)
  assert_eq(r.reasoning_task, "judge")
  // Canonical low-level pins are request fields, not pack policy aliases.
  const direct_effort = pack_for({model: "gpt-5", effort: "high"})
  assert_eq(direct_effort.effort, "high")
  const direct_thinking = pack_for({model: "claude-sonnet-4-5", thinking: {budget_tokens: 2048}})
  assert_eq(direct_thinking.thinking.budget_tokens, 2048)
  log("llm_defaults_pack_user_wins passed")
}
