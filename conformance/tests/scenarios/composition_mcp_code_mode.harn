import {
  composition_mcp_api,
  composition_mcp_execute,
  composition_mcp_search,
} from "std/composition"

pipeline main() {
  let tools = {
    _type: "tool_registry",
    tools: [
      {
        name: "docs__search",
        description: "Search runtime documentation",
        inputSchema: {
          type: "object",
          required: ["query"],
          properties: {query: {type: "string"}, limit: {type: "integer"}},
        },
        annotations: {kind: "search", side_effect_level: "read_only", inline_result: true},
        executor: "mcp_server",
        mcp_server: "docs",
        _mcp_server: "docs",
        _mcp_tool_name: "search",
        defer_loading: true,
        handler: { args -> return json_stringify({items: [{title: "Harn docs", query: args.query}], total: 1}) },
      },
      {
        name: "local_echo",
        description: "Not an MCP tool",
        parameters: {type: "object"},
        handler: { args -> return args },
      },
    ],
  }
  let api = composition_mcp_api(tools)
  __io_println(api.tool_count)
  __io_println(api.servers[0])
  __io_println(api.manifest.bindings[0].source)
  __io_println(api.manifest.bindings[0].deferred)
  __io_println(contains(api.harn_api, "type DocsSearchArgs = {limit?: int, query: string}"))
  __io_println(contains(api.harn_api, "fn docs_search(args: DocsSearchArgs)"))
  let searched = composition_mcp_search(tools, "runtime documentation", {limit: 1})
  __io_println(searched.manifest.bindings[0].name)
  let report = composition_mcp_execute(
    "let hits = json_parse(docs_search({query: \"runtime\"}))\nreturn {title: hits.items[0].title, total: hits.total}",
    tools,
    {run_id: "mcp-code-mode"},
  )
  __io_println(report.ok)
  __io_println(report.child_call_count)
  __io_println(report.child_results == nil)
  __io_println(report.result.title)
  __io_println(report.result.total)
  let full_report = composition_mcp_execute(
    "let hits = json_parse(docs_search({query: \"runtime\"}))\nreturn {title: hits.items[0].title, total: hits.total}",
    tools,
    {run_id: "mcp-code-mode-report", include_report: true},
  )
  __io_println(full_report.child_calls[0].tool_name)
  __io_println(contains(full_report.child_results[0].raw_output, "Harn docs"))
}
