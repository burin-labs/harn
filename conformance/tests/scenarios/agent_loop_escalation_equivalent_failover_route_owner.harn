import { agent_loop } from "std/agent/loop"
/**
 * Escalated agent-loop turns do not synthesize equivalent_failover over a
 * caller-owned routing surface.
 */
import { AgentSpec } from "std/agent/options"

fn tools() {
  const r = tool_registry()
  return tool_define(
    r,
    "echo",
    "Echo back the message",
    {
      handler: { args -> return "echoed:" + to_string(args?.msg ?? "") },
      parameters: {msg: {type: "string"}},
    },
  )
}

pipeline default(harness: Harness) {
  const calls = harness.runtime.atomic(0)
  const caller = { call ->
    let _ = harness.runtime.atomic_add(calls, 1)
    let n = harness.runtime.atomic_get(calls)
    if n == 1 {
      return {
        ok: true,
        value: {
          text: "",
          tool_calls: [{id: "c1", name: "echo", arguments: {msg: "first"}}],
          provider: to_string(call.opts?.provider ?? ""),
          model: to_string(call.opts?.model ?? ""),
          stop_reason: "tool_calls",
          input_tokens: 0,
          output_tokens: 0,
          usage: {input_tokens: 0, output_tokens: 0},
        },
      }
    }
    harness.stdio.println("provider=" + to_string(call.opts?.provider ?? ""))
    harness.stdio.println("model=" + to_string(call.opts?.model ?? ""))
    harness.stdio.println("route_policy=" + to_string(call.opts?.route_policy ?? "nil"))
    harness.stdio.println("failover.nil=" + to_string(call.opts?.equivalent_failover == nil))
    return {
      ok: true,
      value: {
        text: "##DONE##",
        provider: to_string(call.opts?.provider ?? ""),
        model: to_string(call.opts?.model ?? ""),
        input_tokens: 0,
        output_tokens: 0,
        usage: {input_tokens: 0, output_tokens: 0},
      },
    }
  }
  const opts: AgentSpec = {
    provider: "fireworks",
    model: "gpt-oss-120b",
    tools: tools(),
    tool_format: "native",
    max_iterations: 3,
    loop_until_done: true,
    done_sentinel: "##DONE##",
    llm_caller: caller,
    post_turn_callback: { info ->
      if info?.iteration == 0 {
        return {
          message: "Escalating to the stronger route with caller-owned routing.",
          llm_options: {provider: "anthropic", model: "claude-sonnet-4-6", route_policy: "manual"},
        }
      }
      return ""
    },
  }
  const result = agent_loop(harness, "do it", nil, opts)
  harness.stdio.println(result.status)
  harness.stdio.println("visible=" + to_string(result.visible_text ?? ""))
}
