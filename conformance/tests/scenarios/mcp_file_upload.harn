import { ensure_parent_dir } from "std/fs"
import "../_common"

pipeline default(harness: Harness) {
  const root = harness.process.exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or("HARN_CONFORMANCE_HARN_BIN", resolve_harn_bin(harness, root))
  const server_path = path_join(root, "conformance/helpers/mcp_file_input_server.harn")
  const sample_path = path_join(harness.fs.workspace_temp_dir(), "mcp-file-upload.txt")
  ensure_parent_dir(harness.fs, sample_path)
  harness.fs.write_text(sample_path, "hello upload")
  const config = harness.tools.mcp_configure(
    {
      experimental: {
        file_upload: {spec_revision: "modelcontextprotocol/modelcontextprotocol#2356"},
      },
    },
  )
  harness.stdio.println(config.experimental.file_upload.enabled)
  const client = harness.tools.mcp_connect(harn_bin, ["serve", "mcp", server_path])
  const tools = harness.tools.mcp_list_tools(client)
  harness.stdio.println(json_stringify(tools[0].inputSchema).contains("\"x-mcp-file\""))
  const uri = harness.tools.mcp_upload_file(client, sample_path, {accept: ["text/*"], max_size: 64})
  harness.stdio.println(uri.starts_with("data:text/plain;base64,"))
  const result = harness.tools.mcp_call(client, "inspect_upload", {upload: uri})
  harness.stdio.println(result)
  harness.tools.mcp_disconnect(client)
}
