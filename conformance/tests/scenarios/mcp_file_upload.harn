import { ensure_parent_dir } from "std/fs"

pipeline default() {
  const root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const server_path = path_join(root, "conformance/helpers/mcp_file_input_server.py")
  const sample_path = path_join(root, ".harn", "mcp-file-upload.txt")
  ensure_parent_dir(sample_path)
  harness.fs.write_text(sample_path, "hello upload")
  const config = harn.mcp
    .configure(
    {experimental: {file_upload: {spec_revision: "modelcontextprotocol/modelcontextprotocol#2356"}}},
  )
  __io_println(config.experimental.file_upload.enabled)
  const client = mcp_connect("python3", [server_path])
  const tools = mcp_list_tools(client)
  __io_println(json_stringify(tools[0].inputSchema).contains("\"x-mcp-file\""))
  const uri = harn.mcp.upload_file(client, sample_path, {accept: ["text/*"], max_size: 64})
  __io_println(uri.starts_with("data:text/plain;base64,"))
  const result = mcp_call(client, "inspect_upload", {upload: uri})
  __io_println(result)
  mcp_disconnect(client)
}
