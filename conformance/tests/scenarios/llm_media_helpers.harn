import { image_content, image_message, media_type_for_path } from "std/llm/media"

pipeline test(task) {
  let png_path = "media_helper_fixture.png"
  harness.fs
    .write_bytes(
    png_path,
    bytes_from_hex(
      "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000a49444154789c63000100000500010d0a2db40000000049454e44ae426082",
    ),
  )
  let block = image_content(png_path, {detail: "low"})
  harness.fs.delete(png_path)
  assert(block.type == "image", "image block type")
  assert(block.media_type == "image/png", "media type inferred")
  assert(block.detail == "low", "detail propagated")
  assert(len(block.base64) > 0, "file was encoded")
  let message = image_message("https://example.com/image.webp", "caption", {})
  assert(message.content[0].text == "caption", "text block created")
  assert(message.content[1].url == "https://example.com/image.webp", "url image kept as url")
  assert(media_type_for_path("clip.mp3") == "audio/mpeg", "audio type inferred")
  log("llm_media_helpers tests passed")
}
