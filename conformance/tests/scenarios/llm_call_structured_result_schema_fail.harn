import { llm_text, with_llm_script } from "std/testing"

/**
 * Schema-validation failure with no repair: ok=false,
 * error_category="schema_validation", raw_text preserved for
 * downstream diagnostics.
 */
pipeline default(harness: Harness) {
  const schema = {type: "object", required: ["verdict"], properties: {verdict: {type: "string"}}}
  with_llm_script(
    harness.llm, [llm_text("{\"verdict\": 42}")],
    { ->
      const r = harness.llm.call_structured_result("Grade", schema, {provider: "mock", retries: 0})
      harness.stdio.println(r.ok)
      harness.stdio.println(r.data == nil)
      harness.stdio.println(r.error_category)
      harness.stdio.println(contains(r.raw_text, "verdict"))
      harness.stdio.println(r.repaired)
      harness.stdio.println(r.attempts)
    },
  )
}
