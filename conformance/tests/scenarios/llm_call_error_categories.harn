import { with_llm_script } from "std/testing"

/**
 * Walk every canonical ErrorCategory string and verify the thrown
 * dict round-trips `category`, `message`, `provider`, and `model` on
 * `llm_call`. The safe-envelope path mirrors the same shape under
 * `r.error`.
 */
pipeline default(task) {
  const categories = [
    "rate_limit",
    "timeout",
    "server_error",
    "transient_network",
    "schema_validation",
    "auth",
    "not_found",
    "circuit_open",
    "budget_exceeded",
    "tool_error",
    "tool_rejected",
    "cancelled",
    "generic",
    "overloaded",
  ]
  for category in categories {
    const model = "mock-" + category
    with_llm_script(
      [{error: {category: category, message: "synthetic-" + category}}],
      { ->
        try {
          llm_call("probe", nil, {provider: "mock", model: model})
        } catch (e) {
          __io_println(
            category + " thrown=" + e.category + " msg=" + e.message + " provider=" + e.provider
              + " model="
              + e.model,
          )
        }
      },
    )
    with_llm_script(
      [{error: {category: category, message: "safe-" + category}}],
      { ->
        const r = llm_call_safe("probe", nil, {provider: "mock", model: model})
        __io_println(
          category + " safe=" + r.error.category + " msg=" + r.error.message + " ok="
            + to_string(r.ok),
        )
      },
    )
  }
}
// Parity: llm_call_safe wraps the exact same fields.
