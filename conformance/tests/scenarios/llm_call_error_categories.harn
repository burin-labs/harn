import { with_llm_script } from "std/testing"

type MockError = {category: string, message: string, status?: int, retry_after_ms?: int}

fn mock_error(category: string, message: string) -> MockError {
  if category == "overloaded" {
    return {category: category, message: message, status: 503, retry_after_ms: 0}
  }
  return {category: category, message: message}
}

/**
 * Walk every canonical ErrorCategory string and verify the thrown
 * dict round-trips `category`, `message`, `provider`, and `model` on
 * `llm_call`. The safe-envelope path mirrors the same shape under
 * `r.error`.
 */
pipeline default(task) {
  const categories = [
    "rate_limit",
    "timeout",
    "server_error",
    "transient_network",
    "schema_validation",
    "auth",
    "not_found",
    "circuit_open",
    "budget_exceeded",
    "tool_error",
    "tool_rejected",
    "cancelled",
    "generic",
    "overloaded",
  ]
  for category in categories {
    const model = "mock-" + category
    with_llm_script(
      [{error: mock_error(category, "synthetic-" + category)}],
      { ->
        try {
          llm_call("probe", nil, {provider: "mock", model: model})
        } catch (e) {
          __io_println(
            category + " thrown=" + e.category + " msg=" + e.message + " provider=" + e.provider
              + " model="
              + e.model,
          )
        }
      },
    )
    with_llm_script(
      [{error: mock_error(category, "safe-" + category)}],
      { ->
        const r = llm_call_safe("probe", nil, {provider: "mock", model: model})
        __io_println(
          category + " safe=" + r.error.category + " msg=" + r.error.message + " ok="
            + to_string(
            r.ok,
          ),
        )
      },
    )
  }
}
// Parity: llm_call_safe wraps the exact same fields.
