// Conformance test for std/llm/handlers::with_coerce — recursively
// lowercases keys on envelope.value.data; preserves the original under
// raw_data; passes failure envelopes through unchanged; optional
// on_text_json parses JSON-shaped value.text into value.data.
import { with_coerce } from "std/llm/handlers"

pipeline default() {
  const synthetic_with_data = { _call ->
    return {
      ok: true,
      value: {
        text: "{}",
        model: "mock",
        provider: "mock",
        input_tokens: 0,
        output_tokens: 0,
        data: {Verdict: "YES", Bullets: ["A", "B"], Nested: {KeyOne: 1}},
      },
    }
  }
  const caller_data = with_coerce(synthetic_with_data, {})
  const env_data = caller_data(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  __io_println(env_data.value.data.verdict)
  __io_println(env_data.value.data.bullets[0])
  __io_println(env_data.value.data.nested.keyone)
  // Original mixed-case data preserved at raw_data.
  __io_println(env_data.value.raw_data.Verdict)
  // Failure envelope passes through unchanged.
  const failing = { _call -> return {ok: false, status: "rate_limited", error: "429"} }
  const failing_caller = with_coerce(failing, {})
  const failing_env = failing_caller(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  __io_println(failing_env.ok)
  __io_println(failing_env.status)
  // on_text_json parses JSON-shaped value.text into value.data.
  const synthetic_text = { _call ->
    return {
      ok: true,
      value: {
        text: "{\"Decision\":\"approve\"}",
        model: "mock",
        provider: "mock",
        input_tokens: 0,
        output_tokens: 0,
      },
    }
  }
  const caller_text = with_coerce(synthetic_text, {on_text_json: true})
  const env_text = caller_text(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  __io_println(env_text.value.data.decision)
}
