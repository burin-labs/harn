// std/harness/policy.require_policy: imperative auth-policy guard composing
// the ambient `harness.auth` principal. In a plain test context no principal
// is bound, so harness.auth is anonymous (kind() == nil, no scopes) and every
// auth-bound guard with a requirement must fail closed with a typed
// missing-auth HTTP 401.
import { require_policy } from "std/harness/policy"

pipeline test(task) {
  // kinds clause: an anonymous principal can never satisfy a non-empty
  // allow-set, so it is denied before kind details are considered.
  const kind_denial = require_policy({kinds: ["operator", "platform_admin"]})
  assert(kind_denial != nil, "unclassified principal must be denied")
  assert_eq(kind_denial.status, 401)
  assert_eq(kind_denial.body.code, "unauthorized")
  assert_eq(kind_denial.body.details.kind, "missing_auth")
  // Tenant-safe: the denial never echoes the caller's own kind.
  assert_eq(kind_denial.body.details["caller_kind"], nil)
  log("kind missing auth ok")
  // scopes clause: anonymous callers fail as missing-auth, not as a
  // principal-specific missing-scope denial.
  const scope_denial = require_policy({scopes: ["secrets:write"]})
  assert(scope_denial != nil, "missing scope must be denied")
  assert_eq(scope_denial.status, 401)
  assert_eq(scope_denial.body.details.kind, "missing_auth")
  log("scope missing auth ok")
  const req = {
    method: "POST",
    path_params: {tenant: "acme"},
    body: "{\"method\":\"doc.write\",\"owner\":\"user_1\"}",
  }
  const mismatch = require_policy(
    {
      matches: [
        {kind: "tenant_mismatch", label: "tenant", left: "req.path_params.tenant", right: {value: "globex"}},
      ],
    },
    req,
  )
  assert_eq(mismatch.status, 403)
  assert_eq(mismatch.body.details.kind, "tenant_mismatch")
  assert_eq(mismatch.body.details.label, "tenant")
  assert_eq(mismatch.body.details.left, "req.path_params.tenant")
  // Mismatch denials describe the failing guard but never echo compared values.
  assert_eq(mismatch.body.details["left_value"], nil)
  assert_eq(mismatch.body.details["right_value"], nil)
  log("tenant mismatch ok")
  assert_eq(require_policy({matches: [{left: "body.owner", right: {value: "user_1"}}]}, req), nil)
  log("body match ok")
  const auth_match = require_policy({matches: [{left: "body.owner", right: "auth.subject"}]}, req)
  assert_eq(auth_match.status, 401)
  assert_eq(auth_match.body.details.kind, "missing_auth")
  log("auth match missing auth ok")
  const method_denial = require_policy(
    {
      method_path: "body.method",
      methods: {
        "doc.write": {
          matches: [{kind: "resource_mismatch", label: "owner", left: "body.owner", right: {value: "user_2"}}],
        },
      },
    },
    req,
  )
  assert_eq(method_denial.status, 403)
  assert_eq(method_denial.body.details.kind, "resource_mismatch")
  assert_eq(method_denial.body.details.label, "owner")
  log("json-rpc method policy ok")
  // No clauses (or an empty allow-set) → nothing to enforce → allowed (nil).
  assert_eq(require_policy({}), nil)
  assert_eq(require_policy({kinds: []}), nil)
  log("noop allow ok")
}
