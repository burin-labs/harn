import { AgentLoopOptions } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

pipeline default() {
  // agent_loop defaults direct callers to bounded transport retry. A single
  // transient provider error is absorbed and the second attempt succeeds.
  with_llm_script(
    [
      {error: {category: "rate_limit", message: "429 transient"}},
      llm_text("recovered by default retry. ##DONE##"),
    ],
    { ->
      const opts: AgentLoopOptions = {provider: "mock"}
      const result = agent_loop("finish", nil, opts)
      __io_println(result.status)
      __io_println(result.text)
      __io_println(len(llm_mock_calls()))
    },
  )
  // Explicit opt-out remains available for fail-fast fixtures and callers.
  with_llm_script(
    [
      {error: {category: "rate_limit", message: "429 transient"}},
      llm_text("unreachable with retry disabled. ##DONE##"),
    ],
    { ->
      const opts: AgentLoopOptions = {provider: "mock", retry: false}
      const result = agent_loop("finish", nil, opts)
      __io_println(result.status)
      __io_println(result.error.kind)
      __io_println(result.error.category)
      __io_println(len(llm_mock_calls()))
    },
  )
}
