import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  // agent_loop defaults direct callers to bounded transport retry. A single
  // transient provider error is absorbed and the second attempt succeeds.
  with_llm_script(
    harness.llm,
    [
      {error: {category: "rate_limit", message: "429 transient"}},
      llm_text("recovered by default retry. ##DONE##"),
    ],
    { ->
      const opts: AgentSpec = {provider: "mock"}
      const result = agent_loop(harness, "finish", nil, opts)
      harness.stdio.println(result.status)
      harness.stdio.println(result.text)
      harness.stdio.println(len(harness.llm.mock_calls()))
      harness.stdio.println(result.provider_call_count)
    },
  )
  // Explicit opt-out remains available for fail-fast fixtures and callers.
  with_llm_script(
    harness.llm,
    [
      {error: {category: "rate_limit", message: "429 transient"}},
      llm_text("unreachable with retry disabled. ##DONE##"),
    ],
    { ->
      const opts: AgentSpec = {provider: "mock", retry: false}
      const result = agent_loop(harness, "finish", nil, opts)
      harness.stdio.println(result.status)
      harness.stdio.println(result.error.kind)
      harness.stdio.println(result.error.category)
      harness.stdio.println(len(harness.llm.mock_calls()))
      harness.stdio.println(result.provider_call_count)
    },
  )
}
