// Conformance test for std/llm/handlers::with_retry — recovers after
// transient failures and reports retries_attempted on success.
import { with_retry } from "std/llm/handlers"

pipeline default(harness: Harness) {
  const counter = harness.runtime.atomic(0)
  const synthetic = { _call ->
    let n = harness.runtime.atomic_add(counter, 1)
    if n < 2 {
      return {ok: false, status: "transient", error: "blip-" + to_string(n)}
    }
    return {
      ok: true,
      value: {text: "ok", model: "mock", provider: "mock", input_tokens: 0, output_tokens: 0},
    }
  }
  const caller = with_retry(harness, synthetic, {max_attempts: 5, base_ms: 1})
  const env = caller(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  harness.stdio.println(env.ok)
  harness.stdio.println(env.value.text)
  harness.stdio.println(env.retries_attempted)
}
