import { agent_loop } from "std/agent/loop"
/**
 * Captain-shaped middleware stack: composes audit + telemetry + summary
 * + consent + required-reason + redaction + handoff + idempotency
 * + rate-limit + dry-run over a registry of
 * read/edit/escalate tools. Exercises the steel thread of the persona
 * governance promise — every tool dispatch produces a structured audit
 * record, callers above the budget short-circuit, and handoff payloads
 * surface as typed records on `audit.handoff`.
 */
// ANCHOR: captain_import
import * as tool_middleware from "std/llm/tool_middleware"
// ANCHOR_END: captain_import
import { llm_text, with_llm_script } from "std/testing"

/**
 * Natural tool schemas omit `reason`. The reason decorator advertises an
 * optional reason and its caller requires and strips it. Redaction removes the
 * token from the recorded arguments only; the handler still receives it.
 */
fn tools() {
  let r = tool_registry()
  r = tool_define(
    r,
    "read",
    "Read a file",
    {
      handler: { args ->
        assert(args?.token == "fixture-secret", "the handler must receive the original token")
        return "contents of " + to_string(args?.path ?? "")
      },
      parameters: {path: {type: "string"}, token: {type: "string", required: false}},
    },
  )
  r = tool_define(
    r,
    "edit",
    "Edit a file",
    {
      handler: { args -> "edited " + to_string(args?.path ?? "") },
      parameters: {path: {type: "string"}, body: {type: "string"}},
    },
  )
  r = tool_define(
    r,
    "escalate",
    "Hand off to another captain",
    {
      handler: { args ->
        return json_stringify(
          {
            __handoff: {
              source_persona: "merge_captain",
              target_persona_or_human: {
                kind: "persona",
                id: "review_captain",
                label: "review_captain",
              },
              task: to_string(args?.task ?? ""),
              reason: "needs human eyes",
              requested_capabilities: ["review"],
            },
          },
        )
      },
      parameters: {task: {type: "string"}},
    },
  )
  return r
}

pipeline default(harness: Harness) {
  const audit_records = harness.runtime.atomic(0)
  const telemetry_records = harness.runtime.atomic(0)
  const handoff_records = harness.runtime.atomic(0)
  const consent_records = harness.runtime.atomic(0)
  const redaction_records = harness.runtime.atomic(0)
  const idempotency_records = harness.runtime.atomic(0)
  with_llm_script(
    harness.llm,
    [
      {
        tool_calls: [
          {
            id: "t1",
            name: "read",
            arguments: {path: "/tmp/a", reason: "inspect target file", token: "fixture-secret"},
          },
          {id: "t2", name: "edit", arguments: {path: "/tmp/a", body: "x", reason: "fix typo"}},
          {id: "t3", name: "escalate", arguments: {task: "Review fix", reason: "needs human eyes"}},
        ],
      },
      llm_text("Done. ##DONE##"),
    ],
    { ->
      const audit_sink = { _record ->
        let _ = harness.runtime.atomic_add(audit_records, 1)
      }
      const telemetry_sink = { _record ->
        let _ = harness.runtime.atomic_add(telemetry_records, 1)
      }
      // This deterministic callback stands in for the host's approval UI.
      const consent_prompt = { _call ->
        let _ = harness.runtime.atomic_add(consent_records, 1)
        return {decision: "approved", decided_by: "fixture"}
      }
      const redactor = { context ->
        let _ = harness.runtime.atomic_add(redaction_records, 1)
        if context.phase == "in" {
          let safe_args = {}
          for key in context.args.keys() {
            if key != "token" {
              safe_args = safe_args + {[key]: context.args[key]}
            }
          }
          return {args: safe_args, redacted_fields: ["token"]}
        }
        return {result: context.result, redacted_fields: []}
      }
      const handoff_sink = { _record, _call ->
        let _ = harness.runtime.atomic_add(handoff_records, 1)
      }
      const idempotency_key = { call ->
        let _ = harness.runtime.atomic_add(idempotency_records, 1)
        return call.turn.session_id + ":" + call.call_id
      }
      const summary_formatter = { call, _result -> call.tool_name + " ran" }
      // ANCHOR: captain_stack
      const reason_options = {schema_required: false}
      const reason_mw = tool_middleware.with_required_reason(reason_options)
      const stack = tool_middleware.compose_tool_callers(
        harness.clock,
        [
          tool_middleware.with_audit_log(harness.clock, harness.fs, audit_sink),
          tool_middleware.with_telemetry(harness, telemetry_sink),
          tool_middleware.with_summary(summary_formatter),
          tool_middleware.with_consent(harness.clock, consent_prompt),
          reason_mw.caller,
          tool_middleware.with_redaction(redactor),
          tool_middleware.with_handoff_artifact({sink: handoff_sink}),
          tool_middleware.with_idempotency(harness.llm, idempotency_key),
          tool_middleware.with_rate_limit(harness.runtime, {max_calls: 10}),
          tool_middleware.with_dry_run({only: ["edit"], message: "preview"}),
        ],
      )
      // ANCHOR_END: captain_stack
      const registry = tool_middleware.tools_use_middleware(tools(), reason_mw.schema_transform)
      const result = agent_loop(
        harness,
        "polish + handoff",
        nil,
        {
          provider: "mock",
          tools: registry,
          tool_format: "native",
          max_iterations: 3,
          loop_until_done: true,
          tool_caller: { call, next ->
            const outcome = stack(call, next)
            if call.tool_name == "read" {
              assert(outcome?.arguments?.token == nil, "the recorded arguments must omit the token")
            }
            return outcome
          },
        },
      )
      assert(harness.runtime.atomic_get(consent_records) == 3, "all calls reach consent")
      assert(
        harness.runtime.atomic_get(redaction_records) == 6,
        "each call reaches both redaction phases",
      )
      assert(harness.runtime.atomic_get(idempotency_records) == 3, "all calls reach idempotency")
      harness.stdio.println(result.status)
      harness.stdio.println(harness.runtime.atomic_get(audit_records))
      harness.stdio.println(harness.runtime.atomic_get(telemetry_records))
      harness.stdio.println(harness.runtime.atomic_get(handoff_records))
      harness.stdio.println(len(result.tools.successful))
      harness.stdio.println(contains(result.tools.successful, "read"))
      harness.stdio.println(contains(result.tools.successful, "edit"))
      harness.stdio.println(contains(result.tools.successful, "escalate"))
    },
  )
}
// Three tool dispatches: each fired audit + telemetry sinks once.
// Exactly one handoff was emitted (the third call).
// All three calls succeeded as far as the agent loop is concerned —
// the dry-run layer returns ok=true with status="dry_run" instead of
// dispatching the underlying handler.
