// pack_for(qwen3:8b, reasoning_policy="off") → no low-level `thinking` key;
// the host-level capability path is responsible for the /no_think directive.
import { pack_for } from "std/llm/defaults"

pipeline test(task) {
  const r = pack_for({model: "qwen3:8b", reasoning_policy: "off"})
  assert_eq(r.provider, "ollama")
  assert_eq(r.has("thinking"), false)
  // No effort or thinkingBudget either — qwen3 path is a no-op.
  assert_eq(r.has("effort"), false)
  assert_eq(r.has("thinkingBudget"), false)
  log("llm_defaults_pack_ollama_qwen passed")
}
