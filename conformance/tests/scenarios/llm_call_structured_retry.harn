import { llm_text, with_llm_script } from "std/testing"

/**
 * `llm_call_structured` reuses the standard schema-retry loop. First
 * mock: invalid (missing `verdict`). Second mock: valid. One retry
 * recovers; the caller gets the parsed data directly.
 */
pipeline default(harness: Harness) {
  const schema = {
    type: "object",
    required: ["verdict"],
    properties: {verdict: {type: "string"}, improvement: {type: "string"}},
  }
  with_llm_script(
    harness.llm,
    [
      llm_text("{\"improvement\": \"try again\"}"),
      llm_text("{\"verdict\": \"YES\", \"improvement\": \"\"}"),
    ],
    { ->
      const result = harness.llm.call_structured("Grade this", schema, {provider: "mock"})
      harness.stdio.println(result.verdict)
      harness.stdio.println(len(harness.llm.mock_calls()))
    },
  )
  with_llm_script(
    harness.llm,
    [llm_text("{\"improvement\": \"still broken\"}")],
    { ->
      const err = try {
        harness.llm.call_structured("Grade again", schema, {provider: "mock", retries: 0})
      }
      harness.stdio.println(is_err(err))
      harness.stdio.println(unwrap_err(err)?.category == "schema_validation")
    },
  )
}
// Exhaust the retry budget by setting `retries: 0` — the helper
// throws because the strict `output` contract is the forced default.
// After #534 the thrown value is a {category, message, ...} dict
// — dispatch on category instead of string-matching the message.
