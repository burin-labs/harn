/**
 * Cache cost-moat receipts on the agent event tape.
 *
 * Verifies the ledger story end-to-end:
 *  - `agent_emit_event(harness, session_id, "cache_hit"|"cache_miss", payload)`
 *    is accepted by the host. Pre-fix the event names weren't
 *    registered as `AgentEvent` variants and the wrapper's `try`
 *    around `agent_emit_event` silently swallowed the rejection.
 *  - The direct-call `with_cache(prompt, system, opts)` form emits
 *    the same `cache_hit` / `cache_miss` receipts as the caller-
 *    wrapper form when `opts.session_id` is set.
 *  - Receipts carry `model_calls_avoided` and `tokens_saved`
 *    derived from the cached LLM envelope's `usage`. (latency_saved_ms
 *    is only populated when the cached envelope includes a `latency_ms`
 *    field; llm_call does not currently surface one.)
 */
import { agent_emit_event } from "std/agent/state"
import { cache_clear, mem_cache } from "std/cache"
import { with_cache } from "std/llm/handlers"
import { with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const session_id = "cache-event-receipts-" + harness.random.uuid()
  const hits = harness.runtime.atomic(0)
  const misses = harness.runtime.atomic(0)
  const last_hit_tokens = harness.runtime.atomic(0)
  const last_hit_calls_avoided = harness.runtime.atomic(0)
  harness.agent.subscribe(
    session_id,
    { ev ->
      if ev?.type == "cache_hit" {
        const _ = harness.runtime.atomic_add(hits, 1)
        const _ = harness.runtime.atomic_set(
          last_hit_tokens,
          to_int(ev?.payload?.metrics?.tokens_saved ?? 0),
        )
        const _ = harness.runtime.atomic_set(
          last_hit_calls_avoided,
          to_int(ev?.payload?.metrics?.model_calls_avoided ?? 0),
        )
      }
      if ev?.type == "cache_miss" {
        const _ = harness.runtime.atomic_add(misses, 1)
      }
    },
  )
  // Direct host emit: pre-fix this returned an "unsupported event type"
  // error that the wrapper silently swallowed. With cache_hit / cache_miss
  // registered as canonical AgentEvent variants, the call succeeds.
  const direct = try {
    agent_emit_event(
      harness,
      session_id,
      "cache_hit",
      {key: "direct", backend: "mem", namespace: "ns", metrics: {model_calls_avoided: 1}},
    )
  }
  harness.stdio.println("direct_emit_ok=" + to_string(!is_err(direct)))
  // Direct-call form: a miss + hit pair should land on the tape with
  // the cost-moat receipts derived from the cached LLM envelope. The
  // mock surfaces `input_tokens` + `output_tokens` at the top level
  // (the LLM result then exposes them through `usage` for the metric
  // reader).
  with_llm_script(
    harness.llm,
    [
      {text: "answer", input_tokens: 11, output_tokens: 7, model: "m", provider: "p"},
      {text: "would-recompute", model: "m", provider: "p"},
    ],
    { ->
      const store = mem_cache({namespace: "cache-event-receipts-direct-" + harness.random.uuid()})
      cache_clear(harness, {store: store})
      const opts = {provider: "p", model: "m", stream: false, store: store, session_id: session_id}
      const first = with_cache(harness, "hello", "sys", opts)
      const second = with_cache(harness, "hello", "sys", opts)
      harness.stdio.println("first.text=" + first.text)
      harness.stdio.println(
        "byte_identical=" + to_string(json_stringify(first) == json_stringify(second)),
      )
      harness.stdio.println("mock_calls=" + to_string(len(harness.llm.mock_calls())))
      harness.stdio.println("hits=" + to_string(harness.runtime.atomic_get(hits)))
      harness.stdio.println("misses=" + to_string(harness.runtime.atomic_get(misses)))
      harness.stdio.println(
        "hit.tokens_saved=" + to_string(harness.runtime.atomic_get(last_hit_tokens)),
      )
      harness.stdio.println(
        "hit.model_calls_avoided=" + to_string(harness.runtime.atomic_get(last_hit_calls_avoided)),
      )
    },
  )
}
// hits counter started at 1 from the direct emit above, so we expect 2.
