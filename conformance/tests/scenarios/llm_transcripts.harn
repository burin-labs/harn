pipeline default() {
  const result = llm_call("hello world", nil, {provider: "mock"})
  __io_println(result.transcript._type)
  // Session-based continuation: open a session, let the first call
  // seed it, then pass the same session_id to the follow-up so the
  // agent loop automatically loads prior messages as prefix.
  const s = agent_session_open()
  const _first = agent_loop("hello world", nil, {provider: "mock", session_id: s, max_iterations: 1})
  const resumed = agent_loop("follow up", nil, {provider: "mock", session_id: s, max_iterations: 1})
  __io_println(len(transcript_messages(resumed?.transcript)))
  const compacted = transcript_compact(resumed?.transcript, {keep_last: 1, summary: "summary"})
  __io_println(transcript_summary(compacted))
  const completion = llm_completion("let x = ", ";", nil, {provider: "mock", model_tier: "small"})
  __io_println(completion.text)
  const picked = llm_pick_model("frontier")
  __io_println(picked?.provider)
  __io_println(picked?.tier)
}
