// std/llm/safe.with_case_insensitive_keys recursively lowercases dict
// keys; idempotent on already-normalized input.
import { with_case_insensitive_keys } from "std/llm/safe"

pipeline default() {
  const nested = {Outer: {Inner: 1, BLOB: [1, 2, {ChildKey: "v"}]}, Top: "ok"}
  const normalized = with_case_insensitive_keys(nested)
  __io_println(normalized.outer.inner)
  __io_println(normalized.outer.blob[2].childkey)
  __io_println(normalized.top)
  const again = with_case_insensitive_keys(normalized)
  __io_println(again.outer.inner)
  __io_println(again.outer.blob[2].childkey == "v")
  // primitives pass through
  __io_println(with_case_insensitive_keys("plain"))
}
