import { __drain_audit_flushes, __spawn_audit_flushes } from "std/agent/loop_resource_dispatch"
import { compose_tool_callers, with_audit_log } from "std/llm/tool_middleware"

fn receipt_call(session_id: string, prefetch: bool = false) {
  return {
    call_id: "receipt-failure",
    tool_name: "receipt_probe",
    tool_args: {},
    turn: {session_id: session_id, iteration: 1, tool_call_index: 0, prefetch_next_turn: prefetch},
  }
}

fn successful_tool_result(_call) {
  return {ok: true, status: "ok", result: {value: "persist me"}, audit: {}}
}

pipeline default(harness: Harness) {
  const receipts_root = path_join(harness.fs.runtime_paths().state_root, "receipts")
  harness.fs.write_text(receipts_root, "block directory creation")
  const local_caller = compose_tool_callers(harness, [with_audit_log(harness, {sink: "local"})])
  const local_result = local_caller(receipt_call("unwritable-local"), successful_tool_result)
  harness.stdio.println(local_result.error_category == "tool_middleware_exception")
  harness.stdio.println(contains(local_result.error, "receipts"))
  harness.stdio.println(local_result?.audit?.receipt_uri == nil)
  const failing_sink = { _receipt ->
    throw "receipt sink refused write"
  }
  const callable_caller = compose_tool_callers(harness, [with_audit_log(harness, {sink: failing_sink})])
  const callable_result = callable_caller(
    receipt_call("unwritable-callable"),
    successful_tool_result,
  )
  harness.stdio.println(callable_result.error_category == "tool_middleware_exception")
  harness.stdio.println(contains(callable_result.error, "receipt sink refused write"))
  const deferred_result = callable_caller(
    receipt_call("unwritable-deferred", true),
    successful_tool_result,
  )
  const tasks = __spawn_audit_flushes([], [deferred_result._audit_flush])
  const drained = try {
    __drain_audit_flushes(tasks)
  }
  harness.stdio.println(is_err(drained))
  harness.stdio.println(contains(to_string(unwrap_err(drained)), "receipt sink refused write"))
}
