pipeline default() {
  const local_roots = harn.mcp.roots()
  require local_roots.count > 0, "harn.mcp.roots should expose at least one root"
  require local_roots[0].uri.starts_with("file://"), "root URI should be a file URI"
  require local_roots[0].path.count > 0, "script root should include a local path"
  const root = project_root() ?? cwd()
  const server_path = path_join(root, "conformance/helpers/mcp_roots_server.py")
  const client = mcp_connect("python3", [server_path])
  const tools = mcp_list_tools(client)
  require tools.count == 1, "roots server should expose one report tool"
  const report = json_parse(mcp_call(client, "roots_report", {}))
  __io_println(report.roots_capability)
  __io_println(report.roots_count > 0)
  __io_println(report.roots[0].uri.starts_with("file://"))
  __io_println(report.list_changed_count > 0)
  mcp_disconnect(client)
}
