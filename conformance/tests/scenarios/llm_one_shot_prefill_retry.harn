import { default_llm_caller } from "std/llm/caller"
import { with_retry } from "std/llm/handlers"
import { llm_arm_one_shot_prefill } from "std/llm/options"
import { llm_text, with_llm_script } from "std/testing"

fn call(options: any) {
  return {
    prompt: "continue",
    system: "",
    opts: options,
    turn: {iteration: 0, session_id: "one-shot-prefill", attempt: 1},
  }
}

fn retry_caller(harness: Harness) {
  return with_retry(
    harness,
    default_llm_caller(harness.agent, harness.llm),
    {max_attempts: 2, base_ms: 0, max_ms: 0},
  )
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [{error: {category: "rate_limit", message: "mock 429 transient"}}, llm_text("recovered")],
    { ->
      const caller = retry_caller(harness)
      const result = caller(
        call(llm_arm_one_shot_prefill("one physical request", {provider: "mock"})),
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(result.ok)
      harness.stdio.println(calls[0].prefill)
      harness.stdio.println(calls[1].prefill == nil)
    },
  )
  // Direct LLM callers can still request a prefill on every retry. Only the
  // private Harn marker opts into one-shot clearing.
  with_llm_script(
    harness.llm,
    [{error: {category: "rate_limit", message: "mock 429 transient"}}, llm_text("recovered")],
    { ->
      const caller = retry_caller(harness)
      const result = caller(call({provider: "mock", prefill: "ordinary prefill"}))
      const calls = harness.llm.mock_calls()
      harness.stdio.println(result.ok)
      harness.stdio.println(calls[0].prefill)
      harness.stdio.println(calls[1].prefill)
    },
  )
}
