/**
 * In-turn parallel tool dispatch (`max_concurrent_tools`).
 *
 * When the planner emits multiple tool calls in a single turn and the
 * loop is configured with a `tool_caller` middleware, the dispatch
 * fans out via `parallel settle` capped at `max_concurrent_tools`.
 * Results are still injected in source order so text tool-call
 * parsers keyed on declaration order keep working.
 *
 * To assert real concurrency (vs serial) we count peak in-flight tool
 * handlers via atomics - the handler bumps the counter, yields a few
 * times so siblings can arrive, then decrements. With cap=1 only one
 * handler is ever in-flight; with cap=4 all four reach in-flight=4.
 */
import { compose_tool_callers, with_audit_log, with_required_reason } from "std/llm/tool_middleware"
import { llm_text, with_llm_script } from "std/testing"

const in_flight = atomic(0)

const peak = atomic(0)

const observed = atomic(0)

fn fanout_tools() {
  const r = tool_registry()
  return tool_define(
    r,
    "fanout_echo",
    "Echo, but track concurrent in-flight handlers",
    {
      handler: { args ->
        const now = atomic_add(in_flight, 1) + 1
        if now > atomic_get(peak) {
          atomic_set(peak, now)
        }
        let spins = 0
        while spins < 20 {
          yield_now()
          spins = spins + 1
        }
        atomic_add(in_flight, -1)
        return "echoed:" + to_string(args?.msg ?? "")
      },
      parameters: {msg: {type: "string"}},
    },
  )
}

fn run(cap) {
  atomic_set(in_flight, 0)
  atomic_set(peak, 0)
  atomic_set(observed, 0)
  return with_llm_script(
    [
      {
        tool_calls: [
          {id: "c1", name: "fanout_echo", arguments: {msg: "alpha", reason: "first"}},
          {id: "c2", name: "fanout_echo", arguments: {msg: "bravo", reason: "second"}},
          {id: "c3", name: "fanout_echo", arguments: {msg: "charlie", reason: "third"}},
          {id: "c4", name: "fanout_echo", arguments: {msg: "delta", reason: "fourth"}},
        ],
      },
      llm_text("##DONE##"),
    ],
    { ->
      const mw = with_required_reason()
      const counting_caller = { call, next ->
        let _ = atomic_add(observed, 1)
        return mw.caller(call, next)
      }
      const result = agent_loop(
        "fan out",
        nil,
        {
          provider: "mock",
          tools: fanout_tools(),
          tool_format: "native",
          max_iterations: 3,
          loop_until_done: true,
          done_sentinel: "##DONE##",
          max_concurrent_tools: cap,
          tool_caller: counting_caller,
        },
      )
      return {status: result.status, observed: atomic_get(observed), peak: atomic_get(peak)}
    },
  )
}

fn run_without_middleware(cap) {
  atomic_set(in_flight, 0)
  atomic_set(peak, 0)
  return with_llm_script(
    [
      {
        tool_calls: [
          {id: "n1", name: "fanout_echo", arguments: {msg: "one"}},
          {id: "n2", name: "fanout_echo", arguments: {msg: "two"}},
          {id: "n3", name: "fanout_echo", arguments: {msg: "three"}},
          {id: "n4", name: "fanout_echo", arguments: {msg: "four"}},
        ],
      },
      llm_text("##DONE##"),
    ],
    { ->
      const result = agent_loop(
        "fan out without middleware",
        nil,
        {
          provider: "mock",
          tools: fanout_tools(),
          tool_format: "native",
          max_iterations: 3,
          loop_until_done: true,
          done_sentinel: "##DONE##",
          max_concurrent_tools: cap,
        },
      )
      return {status: result.status, peak: atomic_get(peak)}
    },
  )
}

const audit_receipt_count = atomic(0)

const audit_emit_order_bitmask = atomic(0)

fn run_with_audit(cap) {
  atomic_set(in_flight, 0)
  atomic_set(peak, 0)
  atomic_set(observed, 0)
  atomic_set(audit_receipt_count, 0)
  atomic_set(audit_emit_order_bitmask, 0)
  return with_llm_script(
    [
      {
        tool_calls: [
          {id: "a1", name: "fanout_echo", arguments: {msg: "first", reason: "r1"}},
          {id: "a2", name: "fanout_echo", arguments: {msg: "second", reason: "r2"}},
          {id: "a3", name: "fanout_echo", arguments: {msg: "third", reason: "r3"}},
        ],
      },
      llm_text("##DONE##"),
    ],
    { ->
      const reason = with_required_reason()
      const audit_sink = { receipt ->
        atomic_add(audit_receipt_count, 1)
        let shifted = 1
        let n = receipt.emit_order
        while n > 0 {
          shifted = shifted * 2
          n = n - 1
        }
        atomic_add(audit_emit_order_bitmask, shifted)
      }
      const caller = compose_tool_callers([with_audit_log({sink: audit_sink}), reason.caller])
      const result = agent_loop(
        "audit fan-out",
        nil,
        {
          provider: "mock",
          tools: fanout_tools(),
          tool_format: "native",
          max_iterations: 3,
          loop_until_done: true,
          done_sentinel: "##DONE##",
          max_concurrent_tools: cap,
          tool_caller: caller,
        },
      )
      return {
        status: result.status,
        receipt_count: atomic_get(audit_receipt_count),
        emit_bitmask: atomic_get(audit_emit_order_bitmask),
      }
    },
  )
}

// Add each receipt's bit (1 << emit_order) to the bitmask atomic.
// For 3 unique calls the bits are disjoint, so atomic_add == OR. The
// expected mask for emit_orders {0, 1, 2} is 1+2+4 = 7.
const prefetch_audit_finished = atomic(0)

const prefetch_second_turn_before_audit = atomic(0)

const prefetch_llm_turns = atomic(0)

fn run_prefetch(prefetch) {
  atomic_set(in_flight, 0)
  atomic_set(peak, 0)
  atomic_set(prefetch_audit_finished, 0)
  atomic_set(prefetch_second_turn_before_audit, 0)
  atomic_set(prefetch_llm_turns, 0)
  const llm_caller = { _call ->
    let turn = atomic_add(prefetch_llm_turns, 1) + 1
    if turn == 1 {
      return {
        ok: true,
        value: {
          tool_calls: [
            {id: "p1", name: "fanout_echo", arguments: {msg: "prefetch-1"}},
            {id: "p2", name: "fanout_echo", arguments: {msg: "prefetch-2"}},
          ],
        },
      }
    }
    if atomic_get(prefetch_audit_finished) < 2 {
      atomic_set(prefetch_second_turn_before_audit, 1)
    }
    return {ok: true, value: {text: "##DONE##"}}
  }
  const audit_sink = { _receipt ->
    let spins = 0
    while spins < 50 {
      yield_now()
      spins = spins + 1
    }
    atomic_add(prefetch_audit_finished, 1)
  }
  const result = agent_loop(
    "prefetch audit flush",
    nil,
    {
      provider: "mock",
      tools: fanout_tools(),
      tool_format: "native",
      max_iterations: 3,
      loop_until_done: true,
      done_sentinel: "##DONE##",
      max_concurrent_tools: 2,
      prefetch_next_turn: prefetch,
      tool_caller: compose_tool_callers([with_audit_log({sink: audit_sink})]),
      llm_caller: llm_caller,
    },
  )
  return {
    status: result.status,
    llm_turns: atomic_get(prefetch_llm_turns),
    second_before_audit: atomic_get(prefetch_second_turn_before_audit),
    audit_finished: atomic_get(prefetch_audit_finished),
  }
}

pipeline default() {
  // Default (cap=1, sequential): peak in-flight is exactly 1.
  const serial = run(1)
  __io_println("serial.status=" + serial.status)
  __io_println("serial.observed=" + to_string(serial.observed))
  __io_println("serial.peak=" + to_string(serial.peak))
  // cap=4: all four handlers reach in_flight simultaneously.
  const concurrent = run(4)
  __io_println("parallel.status=" + concurrent.status)
  __io_println("parallel.observed=" + to_string(concurrent.observed))
  __io_println("parallel.peak=" + to_string(concurrent.peak))
  // Intermediate cap=2: peak in-flight is exactly 2.
  const capped = run(2)
  __io_println("capped.status=" + capped.status)
  __io_println("capped.observed=" + to_string(capped.observed))
  __io_println("capped.peak=" + to_string(capped.peak))
  // The host batch path honors the same cap even without tool middleware.
  const no_middleware = run_without_middleware(4)
  __io_println("no_middleware.status=" + no_middleware.status)
  __io_println("no_middleware.peak=" + to_string(no_middleware.peak))
  // `with_audit_log` receipts carry each call's source-batch position
  // as `emit_order`. With 3 parallel calls we should see all three
  // distinct positions (bits 0, 1, 2 -> bitmask 7), regardless of
  // completion order.
  const audited = run_with_audit(3)
  __io_println("audit.status=" + audited.status)
  __io_println("audit.receipt_count=" + to_string(audited.receipt_count))
  __io_println("audit.emit_bitmask=" + to_string(audited.emit_bitmask))
  const prefetch_off = run_prefetch(false)
  __io_println("prefetch_off.status=" + prefetch_off.status)
  __io_println("prefetch_off.llm_turns=" + to_string(prefetch_off.llm_turns))
  __io_println("prefetch_off.second_before_audit=" + to_string(prefetch_off.second_before_audit))
  __io_println("prefetch_off.audit_finished=" + to_string(prefetch_off.audit_finished))
  const prefetch_on = run_prefetch(true)
  __io_println("prefetch_on.status=" + prefetch_on.status)
  __io_println("prefetch_on.llm_turns=" + to_string(prefetch_on.llm_turns))
  __io_println("prefetch_on.second_before_audit=" + to_string(prefetch_on.second_before_audit))
  __io_println("prefetch_on.audit_finished=" + to_string(prefetch_on.audit_finished))
}
