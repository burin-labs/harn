// std/llm/safe.strip_code_fences removes whole-line code-fence delimiters when
// a model wraps an entire document in a fence. Inline single-backtick code and
// the content between fences are preserved.
import { strip_code_fences } from "std/llm/safe"

pipeline default(harness: Harness) {
  harness.stdio.println(strip_code_fences("```md\n# Title\n\nBody text.\n```"))
  harness.stdio.println("---")
  harness.stdio.println(strip_code_fences("```\nplain\n```"))
  harness.stdio.println("---")
  harness.stdio.println(strip_code_fences("has `inline` code, no fence"))
  harness.stdio.println("---")
  harness.stdio.println("[" + strip_code_fences(nil) + "]")
}
