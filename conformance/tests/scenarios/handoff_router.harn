import "std/agents"
import "std/handoffs"

fn review_captain_mock(harness: Harness, envelope: dict) {
  let _ = harness
  return {
    persona: "review_captain",
    received_handoff_kind: envelope?.handoff?.kind,
    received_source: envelope?.handoff?.source_persona,
    route_target: envelope?.decision?.target,
  }
}

pipeline main(harness: Harness) {
  const routes = [
    {
      id: "merge-receipt-review",
      kind: "merge_receipt",
      from: "merge_captain",
      route: [
        {target: "review_captain", when: "always"},
        {target: "human:maintainers", when: "budget_exhausted"},
      ],
    },
  ]
  const seed = {
    kind: "merge_receipt",
    source_persona: "merge_captain",
    task: "Review the merge receipt",
    reason: "The merge queue requires review before landing",
    requested_capabilities: ["review"],
    allowed_side_effects: ["comment_on_pr"],
  }
  const routed = handoff_routed(harness.clock, seed, routes, {})
  const dispatch = handoff_dispatch(
    harness,
    routed,
    nil,
    {dispatchers: {review_captain: review_captain_mock}},
  )
  const exhausted = handoff_routed(
    harness.clock,
    seed + {budget_remaining: {tokens: 0, tool_calls: 0}},
    routes,
    {budget_exhausted: true},
  )
  const run = workflow_result_run(
    harness.obs,
    "Route merge receipt handoff",
    "merge_captain",
    {visible_text: "handoff routed"},
    [handoff_artifact(routed)],
    {},
  )
  harness.stdio.println(routed?.target_persona_or_human?.id == "review_captain")
  harness.stdio.println(routed?.route_decision?.matched_when == "always")
  harness.stdio.println(dispatch?.dispatch_status == "enqueued")
  harness.stdio.println(dispatch?.dispatch_receipt?.topic == "handoff.persona.invocations")
  harness.stdio.println(dispatch?.dispatch_receipt?.invocation_result?.persona == "review_captain")
  harness.stdio.println(
    dispatch?.dispatch_receipt?.invocation_result?.received_handoff_kind == "merge_receipt",
  )
  harness.stdio.println(exhausted?.target_persona_or_human?.kind == "human")
  harness.stdio.println(exhausted?.target_persona_or_human?.id == "maintainers")
  harness.stdio.println(run?.handoffs[0]?.kind == "merge_receipt")
  harness.stdio.println(run?.handoffs[0]?.route_decision?.target == "review_captain")
}
