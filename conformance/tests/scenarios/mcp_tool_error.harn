pipeline default() {
  let root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  let harn_bin = harness.env.get("HARN_BIN") ?? "harn"
  let server_path = path_join(root, "conformance/helpers/mcp_echo_server.harn")
  let client = mcp_connect(harn_bin, ["serve", "mcp", server_path])
  // Call a tool that reports isError: true
  try {
    mcp_call(client, "fail")
  } catch (e) {
    __io_println(e)
  }
  mcp_disconnect(client)
}
