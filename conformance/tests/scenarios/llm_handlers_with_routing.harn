// Conformance test for std/llm/handlers::with_routing — pre-call
// routing picks the cheap default by default and escalates to a named
// route when its `when` predicate matches. Tags envelopes with
// route_index / route_name and emits llm_routing_decision events.
import { with_routing } from "std/llm/handlers"

pipeline default(harness: Harness) {
  const cheap_calls = harness.runtime.atomic(0)
  const strong_calls = harness.runtime.atomic(0)
  const cheap = { _call ->
    let _ = harness.runtime.atomic_add(cheap_calls, 1)
    return {
      ok: true,
      value: {text: "cheap", model: "mock", provider: "mock", input_tokens: 0, output_tokens: 0},
    }
  }
  const strong = { _call ->
    let _ = harness.runtime.atomic_add(strong_calls, 1)
    return {
      ok: true,
      value: {text: "strong", model: "mock", provider: "mock", input_tokens: 0, output_tokens: 0},
    }
  }
  const router = with_routing(
    harness.agent,
    {
      default: cheap,
      routes: [{name: "frontier", when: { call -> call?.opts?.escalate ?? false }, caller: strong}],
    },
  )
  // Default route — cheap caller wins.
  const default_env = router(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  harness.stdio.println(default_env.value.text)
  harness.stdio.println(default_env.route_index)
  harness.stdio.println(default_env.route_name)
  harness.stdio.println(default_env.used_default ?? false)
  // Escalation predicate matches — frontier route wins.
  const escalated_env = router(
    {
      prompt: "p",
      system: "",
      opts: {escalate: true},
      turn: {iteration: 0, session_id: "", attempt: 1},
    },
  )
  harness.stdio.println(escalated_env.value.text)
  harness.stdio.println(escalated_env.route_index)
  harness.stdio.println(escalated_env.route_name)
  harness.stdio.println(harness.runtime.atomic_get(cheap_calls))
  harness.stdio.println(harness.runtime.atomic_get(strong_calls))
}
