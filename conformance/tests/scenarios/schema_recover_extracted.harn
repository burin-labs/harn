/**
 * `schema_recover` lifts JSON out of a markdown code fence
 * (stage="extracted", attempts=2 — direct parse fails, then the
 * extractor finds the fenced block).
 */
pipeline default() {
  const schema = {
    type: "object",
    required: ["verdict"],
    properties: {verdict: {type: "string"}, note: {type: "string"}},
  }
  const raw =
    "Sure, here's the answer:\n```json\n{\"verdict\": \"pass\", \"note\": \"clean\"}\n```\nLet me know if you need more."
  const r = schema_recover(raw, schema, {repair: false})
  __io_println(r.ok)
  __io_println(r.stage)
  const data = r.data
  if data != nil {
    __io_println(data.verdict)
    __io_println(data.note)
  }
  __io_println(r.attempts)
  __io_println(r.repaired)
}
