import { agent_loop } from "std/agent/loop"

/**
 * When the user's caller throws, agent_loop propagates the thrown value.
 * The test catches it with try {} and asserts the unwrapped reason matches.
 */
pipeline default(harness: Harness) {
  const throwing_caller = { _call ->
    throw "caller boom"
  }
  const result = try {
    agent_loop(harness, "hi", nil, {provider: "mock", llm_caller: throwing_caller})
  }
  harness.stdio.println(is_err(result))
  const error = unwrap_err(result)
  harness.stdio.println(error.cause)
  harness.stdio.println(error.provider_call_count)
}
