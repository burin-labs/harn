// pack_for({model: "gpt-5", provider: "auto"}) → resolves to provider
// "openai" via runtime inference. Canonical policy keys remain visible in
// the returned request.
import { pack_for } from "std/llm/defaults"

pipeline test(harness: Harness, task) {
  // "auto" is treated as a normal user-supplied provider — the runtime
  // catalog overwrites it with the inferred openai entry. (We don't
  // hardcode a special-case for "auto" — resolved_options() just echoes
  // it back, but the model id starts with "gpt-" so the inference rule
  // overrides to "openai" by the time pack_for assembles the result.)
  // For test purposes, omit provider so inference runs cleanly.
  const r = pack_for(harness.agent, harness.llm, {model: "gpt-5"})
  assert_eq(r.model, "gpt-5")
  assert_eq(r.provider, "openai")
  // Auto policy for a chat-sized request resolves to the catalog-supported
  // minimal level while remaining provider-neutral at this boundary.
  assert_eq(r.thinking.mode, "effort")
  assert_eq(r.thinking.level, "minimal")
  harness.stdio.log("llm_defaults_pack_provider_auto passed")
}
