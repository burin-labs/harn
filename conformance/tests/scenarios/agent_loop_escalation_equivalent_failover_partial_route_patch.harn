/**
 * Partial provider/model route patches keep legacy merge behavior, but they do
 * not opt into equivalent_failover around the composed half-stale route.
 */
import { AgentLoopOptions } from "std/agent/options"

let calls = atomic(0)

fn tools() {
  let r = tool_registry()
  return tool_define(
    r,
    "echo",
    "Echo back the message",
    {
      handler: { args -> return "echoed:" + to_string(args?.msg ?? "") },
      parameters: {msg: {type: "string"}},
    },
  )
}

pipeline default() {
  let caller = { call ->
    let _ = atomic_add(calls, 1)
    let n = atomic_get(calls)
    if n == 1 {
      return {
        ok: true,
        value: {
          text: "",
          tool_calls: [{id: "c1", name: "echo", arguments: {msg: "first"}}],
          provider: to_string(call.opts?.provider ?? ""),
          model: to_string(call.opts?.model ?? ""),
          stop_reason: "tool_calls",
          input_tokens: 0,
          output_tokens: 0,
          usage: {input_tokens: 0, output_tokens: 0},
        },
      }
    }
    __io_println("provider=" + to_string(call.opts?.provider ?? ""))
    __io_println("model=" + to_string(call.opts?.model ?? ""))
    __io_println("failover.nil=" + to_string(call.opts?.equivalent_failover == nil))
    return {
      ok: true,
      value: {
        text: "##DONE##",
        provider: to_string(call.opts?.provider ?? ""),
        model: to_string(call.opts?.model ?? ""),
        input_tokens: 0,
        output_tokens: 0,
        usage: {input_tokens: 0, output_tokens: 0},
      },
    }
  }
  let opts: AgentLoopOptions = {
    provider: "fireworks",
    model: "gpt-oss-120b",
    tools: tools(),
    tool_format: "native",
    max_iterations: 3,
    loop_until_done: true,
    done_sentinel: "##DONE##",
    llm_caller: caller,
    post_turn_callback: { info ->
      if info?.iteration == 0 {
        return {message: "Patch only the provider half.", llm_options: {provider: "anthropic"}}
      }
      return ""
    },
  }
  let result = agent_loop("do it", nil, opts)
  __io_println(result.status)
  __io_println("visible=" + to_string(result.visible_text ?? ""))
}
