import { AgentLoopOptions } from "std/agent/options"
import { process_shell } from "std/runtime"
import { llm_text, with_llm_script } from "std/testing"
import { resolve_harn_bin, wait_for_log_match } from "../_common.harn"

fn wait_for_file(harness: Harness, path, attempts) {
  let remaining = attempts
  while !harness.fs.exists(path) && remaining > 0 {
    sleep(50ms)
    remaining = remaining - 1
  }
  require harness.fs.exists(path), "timed out waiting for " + path
}

pipeline default() {
  const root = project_root() ?? cwd()
  const helper_dir = path_join(root, "conformance/helpers")
  const server_script = path_join(helper_dir, "mcp_echo_server.harn")
  const harn_bin = harness.env.get_or("HARN_CONFORMANCE_HARN_BIN", resolve_harn_bin(harness, root))
  const state_dir = path_join(harness.fs.temp_dir(), "harn-agent-loop-mcp-" + uuid())
  const state_path = path_join(state_dir, "state.jsonl")
  const pid_path = path_join(state_dir, "server.pid")
  const log_path = path_join(state_dir, "server.log")
  harness.fs.mkdir(state_dir)
  const start = process_shell(
    "HARN_MCP_ECHO_STATE_FILE=\"" + state_path + "\" \"" + harn_bin
      + "\" serve mcp --transport http --bind 127.0.0.1:0 \""
      + server_script
      + "\" >\""
      + log_path
      + "\" 2>&1 & echo $! > \""
      + pid_path
      + "\"",
  )
  require start?.success, "MCP mock server started"
  const url = wait_for_log_match(harness, log_path, "MCP workflow server ready on (http://[^\\s]+)")
  require url != nil, "timed out waiting for MCP server readiness"
  with_llm_script(
    [
      {
        text: "Calling MCP tools.",
        tool_calls: [
          {id: "mcp1", name: "remote__echo", arguments: {message: "hello from remote"}},
          {id: "mcp2", name: "mirror__echo", arguments: {message: "hello from mirror"}},
        ],
      },
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      const opts: AgentLoopOptions = {
        provider: "mock",
        tool_format: "native",
        max_iterations: 3,
        mcp_servers: [{name: "remote", transport: "http", url: url}, {name: "mirror", transport: "http", url: url}],
      }
      const result = agent_loop("Use both MCP echo tools", nil, opts)
      process_shell("kill $(cat \"" + pid_path + "\") >/dev/null 2>&1 || true")
      wait_for_file(harness, state_path, 100)
      const calls = harness.fs.read_text(state_path).trim().split("\n").map({ line -> json_parse(line) })
      __io_println(result?.tools.successful[0])
      __io_println(result?.tools.successful[1])
      __io_println(len(calls))
      __io_println(calls[0].name)
      __io_println(calls[0].arguments.message)
      __io_println(calls[1].name)
      __io_println(calls[1].arguments.message)
    },
  )
}
