/**
 * with_telemetry + std/llm/tool_telemetry — standardized tool-call span
 * shape and sink resolution.
 *
 * Confirms:
 *   - the span schema documented in tool_call_span(...) survives a real
 *     dispatch (attributes, gen_ai.* mirrors, events, child spans);
 *   - error_category="scope_violation" produces a tool_call.scope_violation
 *     event;
 *   - with_telemetry accepts a callable, a built-in name string, a dict
 *     with `sink:`, and a fan-out `sinks:` list.
 */
import { with_telemetry } from "std/llm/tool_middleware"
import { resolve_telemetry_sink, tool_call_span } from "std/llm/tool_telemetry"

fn ok_next() {
  return { call ->
    return {
      ok: true,
      status: "ok",
      tool_name: call.tool_name,
      tool_call_id: call.call_id,
      arguments: call.tool_args,
      result: {rendered: "hello"},
      rendered_result: "hello",
      observation: "",
      error: nil,
      error_category: nil,
      executor: "harn",
      audit: {
        layers: [
          {name: "with_consent", status: "approved"},
          {name: "with_rate_limit", status: "ok", count: 3, cap: 50},
        ],
      },
    }
  }
}

fn scope_violation_next() {
  return { call ->
    return {
      ok: false,
      status: "error",
      tool_name: call.tool_name,
      tool_call_id: call.call_id,
      arguments: call.tool_args,
      result: nil,
      rendered_result: "",
      observation: "",
      error: "tool 'shell.exec' is outside the configured scope",
      error_category: "scope_violation",
      executor: "harn",
    }
  }
}

fn envelope(name, call_id, session_id) {
  return {
    tool_name: name,
    tool_args: {q: "evidence"},
    call_id: call_id,
    declared_executor: "harn",
    schema: nil,
    description: "",
    turn: {iteration: 2, session_id: session_id},
  }
}

pipeline default() {
  // (1) Callable sink receives the standardized span shape.
  const mw = with_telemetry(
    { s ->
      __io_println(s.name)
      __io_println(s.kind)
      __io_println(s.span_id)
      __io_println(s.trace_id)
      __io_println(s.attributes.tool_name)
      __io_println(s.attributes.tool_call_id)
      __io_println(s.attributes.iteration)
      __io_println(s.attributes.session_id)
      __io_println(s.attributes.executor)
      __io_println(s.attributes.status)
      __io_println(s.attributes.ok)
      __io_println(s.attributes["gen_ai.tool.name"])
      __io_println(s.attributes["gen_ai.tool.call.id"])
      __io_println(s.attributes["gen_ai.tool.executor"])
      __io_println(s.events[0].name)
      __io_println(s.events[1].name)
      __io_println(len(s.child_spans))
      __io_println(s.child_spans[0].name)
      __io_println(s.child_spans[1].name)
      __io_println(s.child_spans[1].attributes.count)
      __io_println(s.child_spans[1].attributes.cap)
    },
  )
  const ok = mw(envelope("read", "call_1", "sess_alpha"), ok_next())
  __io_println(ok.ok)
  __io_println(ok.status)
  // (2) Scope-violation errors raise a tool_call.scope_violation event.
  const scope_mw = with_telemetry(
    { s ->
      __io_println(s.status)
      __io_println(s.attributes.error_category)
      __io_println(len(s.events))
      __io_println(s.events[2].name)
      __io_println(s.events[2].attributes.category)
    },
  )
  const denied = scope_mw(envelope("shell.exec", "call_2", "sess_beta"), scope_violation_next())
  __io_println(denied.ok)
  // (3) When the envelope has no session_id, the trace_id falls back
  // to "tool_call:<call_id>".
  const traceless_mw = with_telemetry({ s -> __io_println(s.trace_id) })
  const _ = traceless_mw(envelope("read", "call_3", ""), ok_next())
  // (4) Dict config: persona + mode + extra_attributes ride along.
  const attr_mw = with_telemetry(
    {
      sink: { s ->
        __io_println(s.attributes.persona)
        __io_println(s.attributes.mode)
        __io_println(s.attributes.env)
      },
      persona: "merge_captain",
      mode: "preview",
      extra_attributes: {env: "dev"},
    },
  )
  const _ = attr_mw(envelope("read", "call_4", "sess_gamma"), ok_next())
  // (5) Fan-out: `sinks: [..]` invokes every sink.
  const left = atomic(0)
  const right = atomic(0)
  const fanout = with_telemetry(
    {
      sinks: [
        { _s ->
          let _ = atomic_add(left, 1)
        },
        { _s ->
          let _ = atomic_add(right, 1)
        },
      ],
    },
  )
  const _ = fanout(envelope("read", "call_5", "sess_delta"), ok_next())
  __io_println(atomic_get(left))
  __io_println(atomic_get(right))
  // (6) Unknown built-in name raises a clear error.
  const bad = try {
    resolve_telemetry_sink("kaboom")
  }
  __io_println(is_err(bad))
  // (7) tool_call_span(...) is callable directly for ad-hoc reporting.
  const direct = tool_call_span(
    envelope("read", "call_6", "sess_epsilon"),
    {ok: true, status: "ok", executor: "harn", result: nil},
    1000,
    1042,
    {persona: "review_captain"},
  )
  __io_println(direct.duration_ms)
  __io_println(direct.attributes.persona)
}
