import { agent_loop } from "std/agent/loop"
import { system_before, with_system_fragments } from "std/llm/prompts"
import { with_llm_script } from "std/testing"

fn occurrences(text: any, needle: string) {
  return len(split(text, needle)) - 1
}

fn events_by_kind(transcript: list | dict | Transcript, kind: string) {
  return transcript_events(transcript).filter({ event -> event.kind == kind })
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [],
    { ->
      const direct = harness.llm.call(
        "direct prompt",
        "Direct base.",
        {provider: "mock", system: [system_before("Direct preamble.", {title: "Direct contract"})]},
      )
      harness.stdio.println(len(transcript_messages(direct.transcript)))
      harness.stdio.println(len(events_by_kind(direct.transcript, "system_prompt")))
      harness.stdio.println(transcript_events(direct.transcript)[0].kind == "system_prompt")
      harness.stdio.println(
        direct.transcript.metadata.system_prompt.content.contains("Direct preamble."),
      )
      harness.stdio.println(occurrences(json_stringify(direct.transcript), "Direct preamble.") == 1)
    },
  )
  with_llm_script(
    harness.llm,
    [],
    { ->
      // Durable session journals outlive a fixture process; isolate the
      // continuation scenario from prior runs with a fresh id.
      const sid = "system-prompt-continuation-session-" + harness.random.uuid()
      const opts = with_system_fragments(
        {provider: "mock", session_id: sid, max_iterations: 1, auto_context_profile: false},
        [
          system_before("Persistent contract.", {title: "Session contract"}),
          {content: "disabled", enabled: false},
        ],
      )
      const first = agent_loop(harness, "hello", "Base system.", opts)
      const resumed = agent_loop(harness, "follow up", "Base system.", opts)
      const resumed_without_prompt = agent_loop(
        harness,
        "resume without prompt options",
        nil,
        {provider: "mock", session_id: sid, max_iterations: 1, auto_context_profile: false},
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(first.status)
      harness.stdio.println(resumed.status)
      harness.stdio.println(resumed_without_prompt.status)
      harness.stdio.println(len(calls))
      harness.stdio.println(occurrences(calls[0].system, "Persistent contract.") == 1)
      harness.stdio.println(occurrences(calls[1].system, "Persistent contract.") == 1)
      harness.stdio.println(occurrences(calls[2].system, "Persistent contract.") == 1)
      harness.stdio.println(!json_stringify(calls[2].messages).contains("Persistent contract."))
      harness.stdio.println(len(transcript_messages(resumed_without_prompt.transcript)))
      harness.stdio.println(len(events_by_kind(resumed_without_prompt.transcript, "system_prompt")))
      harness.stdio.println(
        transcript_events(resumed_without_prompt.transcript)[0].kind == "system_prompt",
      )
      harness.stdio.println(
        occurrences(json_stringify(resumed_without_prompt.transcript), "Persistent contract.") == 1,
      )
      harness.stdio.println(harness.agent.system_prompt(sid)?.contains("Persistent contract."))
      harness.stdio.println(
        resumed_without_prompt.transcript.metadata.system_prompt.content.contains(
          "Persistent contract.",
        ),
      )
    },
  )
}
