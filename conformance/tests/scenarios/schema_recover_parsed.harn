/**
 * `schema_recover` happy path: clean JSON parses on the first stage
 * with attempts=1 and stage="parsed".
 */
pipeline default(harness: Harness) {
  const schema = {
    type: "object",
    required: ["name", "age"],
    properties: {name: {type: "string"}, age: {type: "integer"}},
  }
  const r = harness.llm.recover_schema("{\"name\": \"Ada\", \"age\": 36}", schema)
  harness.stdio.println(r.ok)
  // `r.data` is `T | nil`; bind it to a local and narrow with a
  // nil guard before reading fields.
  const data = r.data
  if data != nil {
    harness.stdio.println(data.name)
    harness.stdio.println(data.age)
  }
  harness.stdio.println(r.stage)
  harness.stdio.println(r.attempts)
  harness.stdio.println(r.repaired)
  harness.stdio.println(r.error_category == nil)
}
