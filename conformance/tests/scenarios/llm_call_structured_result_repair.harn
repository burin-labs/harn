import { llm_text, with_llm_script } from "std/testing"

/**
 * Repair pass success: first call produces malformed-but-salvageable
 * JSON, repair pass returns valid JSON. Envelope marks repaired=true.
 */
pipeline default(harness: Harness) {
  const schema = {type: "object", required: ["verdict"], properties: {verdict: {type: "string"}}}
  with_llm_script(
    harness.llm, [llm_text("{\"note\": \"missing verdict\"}"), llm_text("{\"verdict\": \"PASS\"}")],
    { ->
      const r = harness.llm.call_structured_result(
        "Grade",
        schema,
        {provider: "mock", retries: 0, repair: {enabled: true}},
      )
      harness.stdio.println(r.ok)
      harness.stdio.println(r.data.verdict)
      harness.stdio.println(r.repaired)
      harness.stdio.println(r.attempts)
      harness.stdio.println(len(harness.llm.mock_calls()))
    },
  )
}
// Main call: schema-invalid (missing required key) — burns 1 attempt
// (retries: 0 forces immediate repair fallback).
// Repair call: produces conforming JSON.
// Two underlying LLM calls were made: main (1) + repair (1).
