import { llm_text, with_llm_script } from "std/testing"

fn tools() {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "read",
    "Read a file",
    {
      handler: { args -> "read:" + args.path },
      parameters: {path: {type: "string", description: "Path to read"}},
      returns: {type: "string"},
    },
  )
  return registry
}

pipeline default() {
  with_llm_script(
    [
      llm_text("<tool_call>\nread({ path: \"src/lib.rs\" })\n</tool_call>"),
      llm_text("<tool_call>\nread({ path: \"src/lib.rs\" })\n</tool_call>"),
    ],
    { ->
      const fallback = agent_loop(
        "Inspect the repo",
        "You are helpful",
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          native_tool_fallback: "allow_once",
          loop_until_done: true,
          max_iterations: 2,
        },
      )
      __io_println(fallback?.trace?.native_text_tool_fallbacks == 2)
      __io_println(fallback?.trace?.native_text_tool_fallback_rejections == 1)
      const fallback_events = transcript_events_by_kind(fallback?.transcript, "native_tool_fallback")
      __io_println(len(fallback_events) == 2)
      __io_println(fallback_events[0]?.metadata?.accepted)
      __io_println(!fallback_events[1]?.metadata?.accepted)
    },
  )
  // The built-in empty-completion retry applies to provider-shaped routes
  // only. The mock provider replays scripted turns deterministically, so the
  // thrown empty-completion shape surfaces on the first attempt with no
  // silent retry (pre-v0.10, `llm_retries` could opt mock into a budget).
  with_llm_script(
    [
      {
        error: {
          category: "server_error",
          message: "openai-compatible model mock reported completion_tokens=1 but delivered no content, reasoning, or tool calls",
        },
      },
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      const surfaced = agent_loop(
        "Finish the task",
        "You are helpful",
        {provider: "mock", loop_until_done: true, max_iterations: 1},
      )
      __io_println(surfaced.status)
      __io_println(surfaced?.trace?.empty_completion_retries == 0)
      __io_println(len(llm_mock_calls()) == 1)
    },
  )
}
