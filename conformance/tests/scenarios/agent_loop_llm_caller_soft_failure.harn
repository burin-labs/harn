/**
 * Caller returns {ok: false, status: "budget_exhausted"} → agent_loop
 * finalizes with status budget_exhausted (mirrors the default-caller path
 * when llm_call throws a budget_exceeded reason).
 */
pipeline default(harness: Harness) {
  const budget_caller = { _call -> return {ok: false, status: "budget_exhausted"} }
  const result = agent_loop(harness, "hi", nil, {provider: "mock", llm_caller: budget_caller})
  harness.stdio.println(result.status)
}
