import { llm_text, with_llm_script } from "std/testing"

pipeline default() {
  // llm_call is fail-fast on transient transport errors: there is no hidden
  // in-call retry budget (the pre-v0.10 `llm_retries` / `llm_backoff_ms`
  // options were removed). Retry policy is composed via `with_retry` from
  // std/llm/handlers — see llm_handlers_with_retry*.harn for that surface.
  with_llm_script(
    [
      {error: {category: "server_error", message: "HTTP 503 Service Unavailable"}},
      llm_text("unreachable without a composed retry handler"),
    ],
    { ->
      const fail_fast = try {
        llm_call("transport fail-fast", nil, {provider: "mock"})
      }
      __io_println(is_err(fail_fast))
      __io_println(unwrap_err(fail_fast)?.kind)
      __io_println(unwrap_err(fail_fast)?.reason)
      __io_println(len(llm_mock_calls()))
    },
  )
  const schema = {type: "object", required: ["answer"], properties: {answer: {type: "string"}}}
  // A schema-validation failure is not a transport failure: it consumes the
  // schema_retries budget only, and with schema_retries: 0 it surfaces on
  // the first call.
  with_llm_script(
    [llm_text("{\"wrong\": true}")],
    { ->
      const schema_failure = try {
        llm_call(
          "schema failure is not a transport retry",
          nil,
          {
            provider: "mock",
            response_format: "json",
            output_schema: schema,
            output_validation: "error",
            schema_retries: 0,
          },
        )
      }
      __io_println(is_err(schema_failure))
      __io_println(unwrap_err(schema_failure)?.category)
      __io_println(len(llm_mock_calls()))
    },
  )
  // The schema-retry loop still re-prompts on invalid structured output.
  with_llm_script(
    [llm_text("{\"wrong\": true}"), llm_text("{\"answer\": \"fixed\"}")],
    { ->
      const structured = llm_call(
        "schema retry",
        nil,
        {
          provider: "mock",
          response_format: "json",
          output_schema: schema,
          output_validation: "error",
          schema_retries: 1,
        },
      )
      __io_println(structured.data.answer)
      __io_println(len(llm_mock_calls()))
    },
  )
}
