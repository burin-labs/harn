// std/llm/economics.pricing_for: catalog hit returns full pricing dict
// including cache rates; provider-only fallback drops cache rates; unknown
// commercial pricing returns nil (no silent zero).
import { pricing_for } from "std/llm/economics"

pipeline default() {
  const sonnet = pricing_for("anthropic", "claude-sonnet-4-20250514")
  __io_println("catalog source=" + sonnet.source)
  __io_println("input=" + to_string(sonnet.input_per_mtok))
  __io_println("output=" + to_string(sonnet.output_per_mtok))
  __io_println("cache_read=" + to_string(sonnet.cache_read_per_mtok))
  __io_println("cache_write=" + to_string(sonnet.cache_write_per_mtok))
  const provider_only = pricing_for("openai", "some-bespoke-openai-deployment")
  __io_println("provider source=" + provider_only.source)
  __io_println("provider input=" + to_string(provider_only.input_per_mtok))
  __io_println("provider cache_read=" + to_string(provider_only.cache_read_per_mtok))
  const unknown = pricing_for("nonexistent_provider", "ghost-model")
  __io_println("unknown nil=" + to_string(unknown == nil))
  // Convenient single-arg form: model id only, provider inferred.
  const single = pricing_for("gpt-4o")
  __io_println("single source=" + single.source)
  __io_println("single provider=" + single.provider)
}
