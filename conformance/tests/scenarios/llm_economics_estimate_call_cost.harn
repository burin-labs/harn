// estimate_call_cost: catalog hit returns cost_usd + breakdown; provider
// fallback returns cost using provider-level rates; unknown commercial
// pricing returns pricing_known=false instead of silently zeroing.
import { estimate_call_cost, format_usd } from "std/llm/economics"

pipeline default() {
  // Sonnet 4: 3.00/15.00 per MTok. 10k input + 1k output =
  //   10000 * 3/1e6 + 1000 * 15/1e6 = 0.03 + 0.015 = 0.045.
  const row = estimate_call_cost(
    {provider: "anthropic", model: "claude-sonnet-4-20250514", input_tokens: 10000, output_tokens: 1000},
  )
  __io_println("pricing_known=" + to_string(row.pricing_known))
  __io_println("cost=" + format_usd(row.cost_usd))
  __io_println("input=" + format_usd(row.breakdown.input_usd))
  __io_println("output=" + format_usd(row.breakdown.output_usd))
  // With cache: 8k cache_read, 2k regular input, 1k output.
  //   regular = 2000 * 3/1e6 = 0.006
  //   cache_read = 8000 * 0.3/1e6 = 0.0024
  //   output = 1000 * 15/1e6 = 0.015
  //   total = 0.0234
  const cached = estimate_call_cost(
    {
      provider: "anthropic",
      model: "claude-sonnet-4-20250514",
      input_tokens: 10000,
      output_tokens: 1000,
      cache_read_tokens: 8000,
    },
  )
  __io_println("cached cost=" + format_usd(cached.cost_usd))
  __io_println("cached cache_read=" + format_usd(cached.breakdown.cache_read_usd))
  // 100 calls multiplies total cost.
  const many = estimate_call_cost(
    {
      provider: "anthropic",
      model: "claude-sonnet-4-20250514",
      input_tokens: 1000,
      output_tokens: 100,
      calls: 100,
    },
  )
  __io_println("calls=" + to_string(many.calls))
  __io_println("many cost=" + format_usd(many.cost_usd))
  // Unknown commercial: pricing_known=false, cost_usd nil.
  const unknown = estimate_call_cost(
    {provider: "nonexistent_provider", model: "ghost-model", input_tokens: 1000, output_tokens: 500},
  )
  __io_println("unknown_known=" + to_string(unknown.pricing_known))
  __io_println("unknown_cost_nil=" + to_string(unknown.cost_usd == nil))
  // Free provider (ollama): pricing_known=true, cost=0.
  const free = estimate_call_cost({provider: "ollama", model: "llama3.2", input_tokens: 1000, output_tokens: 500})
  __io_println("free_known=" + to_string(free.pricing_known))
  __io_println("free_cost=" + format_usd(free.cost_usd))
}
