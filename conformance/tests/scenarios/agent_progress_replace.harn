import { agent_capture_events } from "std/agent/events"
import { agent_progress } from "std/agent/progress"
import { agent_session_finalize, agent_session_init } from "std/agent/state"

pipeline default(harness: Harness) {
  const session_id = "agent-progress-replace-" + harness.random.uuid()
  const captured = agent_capture_events(harness,  harness, session_id,
    fn() {
      let session = agent_session_init(harness, "progress replace", nil, {session_id: session_id})
      agent_progress(harness, {message: "initial"})
      agent_progress(harness, {message: "append", replace: false})
      agent_session_finalize(harness, session.session_id, "done")
      return nil
    },
  )
  const events = captured.events.filter({ event -> event.type == "progress_reported" })
  require len(events) == 2, "replace semantics should emit both updates"
  harness.stdio.println("replace_count=" + to_string(len(events)))
  harness.stdio.println("first_replace=" + to_string(events[0].replace))
  harness.stdio.println("second_replace=" + to_string(events[1].replace))
  harness.stdio.println("messages=" + events[0].message + "," + events[1].message)
}
