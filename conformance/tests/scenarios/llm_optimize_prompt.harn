import { parallel_judge } from "std/llm/judge"
import { optimize_prompt } from "std/llm/optimize"
import { propose_instructions } from "std/llm/refine"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const judged = parallel_judge("Prompt", [{id: "one"}], { _ctx -> 0.5 })
  harness.stdio.println(judged.best.score == 0.5)
  const explicit = propose_instructions(harness, "Base", {instruction_proposals: "Tighten the answer."})
  harness.stdio.println(explicit[0] == "Base")
  harness.stdio.println(explicit[1] == "Tighten the answer.")
  with_llm_script(
    harness.llm, [llm_text("{\"instructions\":[\"Plan first.\",\"Plan first.\"]}")],
    { ->
      const proposed = propose_instructions(harness,  harness, "Base",
        {
          provider: "mock",
          proposal_count: 2,
          system: "Proposal sys",
          schema_retries: 0,
          repair: false,
        },
      )
      harness.stdio.println(proposed[0] == "Base")
      harness.stdio.println(proposed[1] == "Plan first.")
      harness.stdio.println(len(proposed) == 2)
      harness.stdio.println(harness.llm.mock_calls()[0].system == "Proposal sys")
      const result = optimize_prompt(
        harness, {
          base_prompt: "Answer the question.",
          eval_set: [
            {id: "add", input: "2 + 2", expected: "4"},
            {id: "mul", input: "3 * 3", expected: "9"},
          ],
          metric: { ctx ->
            let score = 0.0
            if contains(lowercase(ctx.prompt), "calculate") {
              score = score + 0.7
            }
            if len(ctx.candidate.demos) > 0 {
              score = score + 0.3
            }
            if contains(lowercase(ctx.prompt), "verbose") {
              score = score - 0.5
            }
            return {score: score, reason: ctx.case.id}
          },
          trials: 4,
          budget: {max_concurrent: 2},
          instruction_proposals: [
            "Answer the question.",
            "Calculate carefully and answer only with the result.",
            "Be verbose and explain every intermediate thought.",
          ],
          demos: [[], [{input: "1 + 1", output: "2"}]],
        },
      )
      harness.stdio.println(result.best_score == 1.0)
      harness.stdio.println(contains(result.best_prompt, "Calculate carefully"))
      harness.stdio.println(len(result.trace) == 4)
      harness.stdio.println(result.trace[0].candidate.instruction == "Answer the question.")
      harness.stdio.println(result.trace[-1].acquisition.kind == "expected_improvement")
      harness.stdio.println(result.trace[-1].case_scores[0].case_id == "add")
      harness.stdio.println(result.ranked[0].score == 1.0)
    },
  )
}
