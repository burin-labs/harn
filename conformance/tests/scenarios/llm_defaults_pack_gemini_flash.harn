// pack_for(gemini-2.5-flash, reasoning_policy="auto") → typed adaptive thinking.
import { pack_for } from "std/llm/defaults"

pipeline test(harness: Harness, task) {
  const r = pack_for(harness, {model: "gemini-2.5-flash", reasoning_policy: "auto"})
  assert_eq(r.provider, "gemini")
  assert_eq(r.thinking.mode, "adaptive")
  harness.stdio.println("llm_defaults_pack_gemini_flash passed")
}
