import { llm_call_options } from "std/llm/options"

fn main(_harness: Harness) {
  let projected = llm_call_options(
    {output_schema: {type: "object"}, schema_stream_abort: false, internal_only: "drop"},
  )
  __io_println(!projected.schema_stream_abort)
  __io_println(projected.internal_only == nil)
}
