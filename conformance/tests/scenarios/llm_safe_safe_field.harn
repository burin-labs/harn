// std/llm/safe.safe_field returns the first non-nil non-empty value via
// case-insensitive lookup, falling back to the default when nothing is
// present.
import { safe_field } from "std/llm/safe"

pipeline default(harness: Harness) {
  const env = {a: nil, B: "hi"}
  harness.stdio.println(safe_field(env, ["a", "b"], "miss"))
  harness.stdio.println(safe_field({}, ["x"], "miss"))
  harness.stdio.println(safe_field({Verdict: ""}, ["verdict"], "skipped"))
  harness.stdio.println(safe_field({Verdict: "DONE"}, ["verdict", "Verdict"], "skipped"))
  harness.stdio.println(safe_field({nested: {x: 1}}, ["nested"], "miss") == {x: 1})
}
