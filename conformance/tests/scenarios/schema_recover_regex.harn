/**
 * `schema_recover` regex-scrapes top-level `key: value` lines when
 * the model produced YAML-ish output instead of JSON. Stage="regex",
 * attempts=3 (parsed fails, no fenced block to extract, regex
 * succeeds). Booleans accept "yes"/"no" tokens.
 */
pipeline default(harness: Harness) {
  const schema = {
    type: "object",
    required: ["name", "age", "active"],
    properties: {name: {type: "string"}, age: {type: "integer"}, active: {type: "boolean"}},
  }
  const raw = "name: \"Grace Hopper\", age: 85, active: yes"
  const r = harness.llm.recover_schema(raw, schema, {repair: false})
  harness.stdio.println(r.ok)
  harness.stdio.println(r.stage)
  const data = r.data
  if data != nil {
    harness.stdio.println(data.name)
    harness.stdio.println(data.age)
    harness.stdio.println(data.active)
  }
  harness.stdio.println(r.repaired)
}
