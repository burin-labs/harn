import { pairwise_rerank, self_certainty } from "std/llm/rerank"
import { llm_call_count, with_llm_mocks } from "std/testing"

fn run_mock_self_certainty(llm: HarnessLlm) {
  return self_certainty(llm, "calibrated", {provider: "mock"})
}

pipeline default(harness: Harness, task: unknown) {
  const judged = with_llm_mocks(
    harness.llm,
    [
      {text: "{\"winner\":\"A\",\"confidence\":0.9,\"reasoning\":\"best beats ok\"}"},
      {text: "{\"winner\":\"B\",\"confidence\":0.8,\"reasoning\":\"best beats weak\"}"},
      {text: "{\"winner\":\"B\",\"confidence\":0.7,\"reasoning\":\"ok beats weak\"}"},
    ],
    fn() {
      const result = pairwise_rerank(
        harness,
        ["weak", "best", "ok"],
        {task: "Pick the strongest answer.", provider: "mock"},
      )
      return {result: result, calls: llm_call_count(harness.llm)}
    },
  )
  harness.stdio.println(judged.result.ranked[0] == "best")
  harness.stdio.println(judged.result.ranked[1] == "ok")
  harness.stdio.println(judged.result.ranked[2] == "weak")
  harness.stdio.println(judged.calls == 3)
  harness.stdio.println(judged.result.scores[1].wins == 2 && judged.result.scores[1].losses == 0)
  harness.stdio.println(judged.result.scores[0].losses == 2 && judged.result.scores[2].wins == 1)
  harness.stdio.println(
    judged.result.scores[1].avg_confidence > 0.84 && judged.result.scores[1].avg_confidence < 0.86,
  )
  const direct = self_certainty(
    harness.llm,
    "ignored",
    {
      logprobs: [
        {token: "a", logprob: -0.6931471805599453},
        {token: "b", logprob: -0.6931471805599453},
      ],
    },
  )
  harness.stdio.println(direct > 0.49 && direct < 0.51)
  const from_mock = with_llm_mocks(
    harness.llm,
    [{text: "calibrated", logprobs: [{token: "calibrated", logprob: 0.0}]}],
    fn() { return run_mock_self_certainty(harness.llm) },
  )
  harness.stdio.println(from_mock == 1.0)
  const mocked_result = with_llm_mocks(
    harness.llm,
    [{text: "visible", logprobs: [{token: "visible", logprob: 0.0}]}],
    fn() { return harness.llm.call("return visible", nil, {provider: "mock", logprobs: true}) },
  )
  require mocked_result.logprobs != nil && len(mocked_result.logprobs) == 1,
    "mock response must preserve its single logprob"
  harness.stdio.println(mocked_result.logprobs[0].token == "visible")
}
