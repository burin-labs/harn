/**
 * with_scoped_executor — preemptively rejects tool names outside the
 * stage allowlist, decorates approved calls with `audit.scope`, and
 * pushes a CapabilityPolicy that downstream dispatch sees as the top of
 * the policy stack.
 */
import { with_scoped_executor } from "std/llm/tool_middleware"

fn synthetic_next() {
  return { call ->
    return {
      ok: true,
      status: "ok",
      tool_name: call.tool_name,
      tool_call_id: call.call_id,
      arguments: call.tool_args,
      result: "ran " + call.tool_name,
      rendered_result: "ran " + call.tool_name,
      observation: "",
      error: nil,
      error_category: nil,
      executor: "harn",
    }
  }
}

fn envelope(name) {
  return {
    tool_name: name,
    tool_args: {},
    call_id: "call-" + name,
    declared_executor: "harn",
    schema: nil,
    description: "",
    turn: {iteration: 0, session_id: "scope-test"},
  }
}

pipeline default() {
  const next = synthetic_next()
  // Allowed tool passes; audit.scope records the stage + allowlist.
  const research_mw = with_scoped_executor(
    {stage: "research", allowed_tools: ["search_files", "read_file"]},
  )
  const ok = research_mw(envelope("search_files"), next)
  __io_println(ok.ok)
  __io_println(ok.audit.scope.stage)
  __io_println(join(ok.audit.scope.allowed_tools, ","))
  __io_println(ok.audit.layers[0].status)
  // Disallowed tool short-circuits with `scope_violation`.
  const reject = research_mw(envelope("write_file"), next)
  __io_println(reject.ok)
  __io_println(reject.status)
  __io_println(reject.error_category)
  __io_println(reject.error)
  __io_println(reject.audit.layers[0].status)
  // `on_violation: "raise"` throws instead of short-circuiting.
  const raising_mw = with_scoped_executor(
    {stage: "plan", allowed_tools: ["sketch_plan"], on_violation: "raise"},
  )
  try {
    raising_mw(envelope("edit_file"), next)
    __io_println("no-throw")
  } catch (e) {
    __io_println("caught")
    __io_println(e)
  }
  // Missing `allowed_tools` skips the preemptive check; the middleware
  // still pushes a side_effect_level for the duration of `next`.
  const ceiling_mw = with_scoped_executor({stage: "edit", side_effect_level: "workspace_write"})
  const r3 = ceiling_mw(envelope("anything"), next)
  __io_println(r3.ok)
  __io_println(r3.audit.scope.stage)
  __io_println(contains(r3.audit.scope.keys(), "allowed_tools"))
  // Invalid on_violation rejects at middleware-construction time.
  try {
    with_scoped_executor({stage: "x", allowed_tools: ["y"], on_violation: "log"})
    __io_println("no-throw-ctor")
  } catch (e) {
    __io_println("caught-ctor")
  }
  // Defense-in-depth: the pushed CapabilityPolicy is visible to the
  // runtime's `enforce_current_policy_for_tool`, so even if a caller
  // bypasses the preemptive check (e.g. by dispatching a different tool
  // from inside `next`), the runtime still rejects it.
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "read_note",
    "Read a note",
    {
      handler: { args -> "read " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
    },
  )
  tools = tool_define(
    tools,
    "write_note",
    "Write a note",
    {
      handler: { args -> "wrote " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
    },
  )
  const dispatch_next = { call ->
    return agent_dispatch_tool_call(
      {name: "write_note", id: call.call_id, arguments: {path: "notes.txt"}},
      tools,
    )
  }
  const dispatch_mw = with_scoped_executor({stage: "audit", allowed_tools: ["read_note"]})
  // Envelope advertises an allowed name; `next` rewrites to the denied
  // name to simulate a misbehaving inner layer.
  const runtime_deny = dispatch_mw(envelope("read_note"), dispatch_next)
  __io_println(runtime_deny.ok)
  __io_println(runtime_deny.error_category)
}
