import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  // Text mock
  with_llm_script(
    harness.llm, [llm_text("Paris is the capital.")],
    { ->
      const r1 = harness.llm.call("What is the capital?", nil, {provider: "mock"})
      harness.stdio.println(r1.text)
    },
  )
  with_llm_script(
    harness.llm, [{tool_calls: [{name: "read_file", arguments: {path: "main.rs"}}]}],
    { ->
      const r2 = harness.llm.call("Read the file", nil, {provider: "mock"})
      harness.stdio.println(len(r2.tool_calls))
      harness.stdio.println(r2.tool_calls[0].name)
    },
  )
  with_llm_script(
    harness.llm, [{text: "Checking file.", tool_calls: [{name: "search", arguments: {query: "test"}}]}],
    { ->
      const r3 = harness.llm.call("Search", nil, {provider: "mock"})
      harness.stdio.println(r3.text)
      harness.stdio.println(r3.tool_calls[0].name)
    },
  )
  with_llm_script(
    harness.llm, [llm_text("first"), llm_text("second")],
    { ->
      harness.stdio.println(harness.llm.call("a", nil, {provider: "mock"}).text)
      harness.stdio.println(harness.llm.call("b", nil, {provider: "mock"}).text)
      const fb = harness.llm.call("hello world", nil, {provider: "mock"})
      harness.stdio.println(contains(fb.text, "Mock response"))
    },
  )
  with_llm_script(
    harness.llm, [{text: "matched!", match: "*hello*"}],
    { ->
      harness.stdio.println(harness.llm.call("say hello please", nil, {provider: "mock"}).text)
      harness.stdio.println(harness.llm.call("say hello again", nil, {provider: "mock"}).text)
    },
  )
  with_llm_script(
    harness.llm, [
      {text: "first matched", match: "*step*", consume_match: true},
      {text: "second matched", match: "*step*", consume_match: true},
    ],
    { ->
      harness.stdio.println(harness.llm.call("step once", nil, {provider: "mock"}).text)
      harness.stdio.println(harness.llm.call("step twice", nil, {provider: "mock"}).text)
      const calls = harness.llm.mock_calls()
      harness.stdio.println(len(calls) > 0)
    },
  )
  harness.stdio.println(len(harness.llm.mock_calls()))
}
