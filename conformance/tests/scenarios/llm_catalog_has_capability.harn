// std/llm/catalog.has_capability returns true when the model supports
// the given capability per the runtime catalog and false otherwise.
import { has_capability } from "std/llm/catalog"

pipeline default(harness: Harness) {
  const m = "claude-sonnet-4-20250514"
  harness.stdio.println(has_capability(harness, m, "native_tools"))
  harness.stdio.println(has_capability(harness, m, "prompt_caching"))
  harness.stdio.println(has_capability(harness, m, "vision"))
  harness.stdio.println(has_capability(harness, m, "files_api"))
  harness.stdio.println(has_capability(harness, m, "thinking"))
  harness.stdio.println(has_capability(harness, m, "tool_search"))
  // unknown capability name → false
  harness.stdio.println(has_capability(harness, m, "telekinesis"))
  // unknown model → no catalog entry → all defaults false
  harness.stdio.println(has_capability(harness, "totally-unknown-model-xyz", "vision"))
  harness.stdio.println(has_capability(harness, "totally-unknown-model-xyz", "tool_search"))
}
