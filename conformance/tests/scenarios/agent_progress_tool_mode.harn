import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn tool_names(tools: list?) {
  let names = []
  for entry in tools ?? [] {
    names = names.appending(to_string(entry?.name ?? entry?.function?.name ?? ""))
  }
  return names
}

pipeline default(harness: Harness) {
  const session_id = "agent-progress-tool-" + harness.random.uuid()
  with_llm_script(
    harness.llm,
    [
      {
        tool_calls: [
          {
            id: "progress-1",
            name: "report_progress",
            arguments: {
              message: "from tool",
              entries: [{content: "Use progress tool", status: "in_progress", priority: "medium"}],
              replace: false,
              metadata: {source: "mock-tool"},
            },
          },
        ],
      },
      llm_text("<user_response>Progress reported.</user_response>"),
      llm_text(
        json_stringify({verdict: "done", detail: "One structured progress event was emitted."}),
      ),
    ],
    { ->
      const captured = agent_capture_events(
        harness.agent,
        session_id,
        fn() { return agent_loop(
          harness,
          "Report progress with the progress tool.",
          nil,
          {
            provider: "mock",
            progress_tool: {
              name: "report_progress",
              description: "Report structured progress to the host.",
              system_prompt_nudge: "Use report_progress when reporting status.",
            },
            tool_format: "native",
            loop_until_done: true,
            turn_end_condition: {model: "mock-judge"},
            max_iterations: 4,
            session_id: session_id,
          },
        ) },
      )
      const calls = harness.llm.mock_calls()
      const progress_events = captured.events.filter({ event -> event.type == "progress_reported" })
      require len(progress_events) == 1, "tool-mode progress emits one event"
      const event = progress_events[0]
      harness.stdio.println(
        "tool_exposed=" + to_string(contains(tool_names(calls[0].tools), "report_progress")),
      )
      harness.stdio.println("progress_events=" + to_string(len(progress_events)))
      harness.stdio.println("event_message=" + event.message)
      harness.stdio.println("entry_status=" + event.entries[0].status)
      harness.stdio.println("replace=" + to_string(event.replace))
      harness.stdio.println("result_status=" + captured.result.status)
    },
  )
}
