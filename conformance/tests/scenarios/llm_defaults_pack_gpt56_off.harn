// GPT-5.6 removed the older GPT-5 `minimal` effort. The provider-neutral
// `thinking: "off"` preset must lower to the supported `none` value.
import { pack_for } from "std/llm/defaults"

pipeline test(task) {
  const result = pack_for({model: "gpt-5.6-sol", thinking: "off"})
  assert_eq(result.reasoning_effort, "none")
  log("llm_defaults_pack_gpt56_off passed")
}
