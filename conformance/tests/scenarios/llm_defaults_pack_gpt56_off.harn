// GPT-5.6 removed the older GPT-5 `minimal` effort. The provider-neutral
// `reasoning_policy: "off"` must lower to the supported `none` value.
import { pack_for } from "std/llm/defaults"

pipeline test(harness: Harness, task) {
  const result = pack_for(
    harness.agent,
    harness.llm,
    {model: "gpt-5.6-sol", reasoning_policy: "off"},
  )
  assert_eq(result.effort, "none")
  harness.stdio.log("llm_defaults_pack_gpt56_off passed")
}
