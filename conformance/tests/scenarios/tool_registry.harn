/** Test tool registry builtins */
pipeline default(harness: Harness, task) {
  // Create registry
  let tools = tool_registry()
  harness.stdio.println(type_of(tools))
  harness.stdio.println(tool_count(tools))
  // tool_define
  tools = tool_define(
    tools,
    "greet",
    "Say hello",
    {
      handler: { args -> "hi " + args.name },
      parameters: {name: {type: "string", description: "Name to greet"}},
      returns: {type: "string"},
    },
  )
  tools = tool_define(
    tools,
    "add",
    "Add numbers",
    {
      handler: { args -> args.a + args.b },
      parameters: {
        a: {type: "integer", description: "First operand"},
        b: {type: "integer", description: "Second operand"},
      },
      returns: {type: "integer"},
    },
  )
  harness.stdio.println(tool_count(tools))
  // tool_list
  const list = tool_list(tools)
  harness.stdio.println(len(list))
  // tool_find
  const found = tool_find(tools, "greet")
  harness.stdio.println(found != nil)
  const missing = tool_find(tools, "nonexistent")
  harness.stdio.println(missing == nil)
  const selected = tool_select(tools, ["add"])
  harness.stdio.println(tool_count(selected))
  harness.stdio.println(tool_find(selected, "add") != nil)
  harness.stdio.println(tool_find(selected, "greet") == nil)
  // tool_remove
  const smaller = harness.tools.remove(tools, "add")
  harness.stdio.println(tool_count(smaller))
  // tool_describe
  const desc = tool_describe(tools)
  harness.stdio.println(contains(desc, "greet"))
  harness.stdio.println(contains(desc, "add"))
  // tool_schema
  const schema = tool_schema(tools)
  harness.stdio.println(schema.schema_version)
  harness.stdio.println(len(schema.tools))
  // tool_parse_call
  const calls = tool_parse_call(
    "<tool_call>{\"name\": \"greet\", \"arguments\": {\"name\": \"world\"}}</tool_call>",
  )
  harness.stdio.println(len(calls))
  harness.stdio.println(calls[0].name)
  // tool_format_result
  const result = tool_format_result("greet", "hello")
  harness.stdio.println(contains(result, "tool_result"))
  harness.stdio.println(contains(result, "greet"))
  // tool_prompt
  const prompt = tool_prompt(tools)
  harness.stdio.println(contains(prompt, "Available Tools"))
  harness.stdio.println(contains(prompt, "greet"))
}
