pipeline test(harness: Harness, task) {
  // Query with no limit configured -> nil
  const none = harness.llm.rate_limit("test_provider_xyz")
  harness.stdio.log(none)
  // Set a limit
  harness.llm.rate_limit("test_provider_xyz", {rpm: 100})
  const limit = harness.llm.rate_limit("test_provider_xyz")
  harness.stdio.log(limit)
  // Clear it
  harness.llm.rate_limit("test_provider_xyz", {rpm: 0})
  const cleared = harness.llm.rate_limit("test_provider_xyz")
  harness.stdio.log(cleared)
}
