import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { __intra_turn_resource_keys } from "std/agent/loop_resource_dispatch"
import { llm_text, with_llm_script } from "std/testing"

fn member_call(id: string, path: string, fail: bool = false) {
  return {id: id, name: "edit", toolset_name: "computer", arguments: {path: path, fail: fail}}
}

fn main(harness: Harness) {
  const mutations = harness.runtime.atomic(0)
  const observations = harness.runtime.atomic(0)
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Observe state through an ordinary same-named function.",
    {
      handler: { _args ->
        harness.runtime.atomic_add(observations, 1)
        return "observed"
      },
      parameters: {},
      annotations: {kind: "read", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "computer.edit",
    "Mutate an annotated resource through a toolset member.",
    {
      handler: { args ->
        harness.runtime.atomic_add(mutations, 1)
        if args.fail {
          throw "mutation failed after touching the resource"
        }
        return "applied " + args.path
      },
      parameters: {path: {type: "string"}, fail: {type: "boolean"}},
      annotations: {
        kind: "edit",
        side_effect_level: "workspace_write",
        arg_schema: {path_params: ["path"]},
      },
    },
  )
  require len(__intra_turn_resource_keys(member_call("key", "src/a.harn"), tools)) == 1,
    "the member must expose its annotated resource key"
  require len(__intra_turn_resource_keys({name: "edit", arguments: {path: "src/a.harn"}}, tools))
    == 0,
    "the ordinary observation must not inherit the member's resource key"
  const captured = agent_capture_events(
    harness.agent,
    "toolset-resource-" + harness.random.uuid(),
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              member_call("deferred-member", "src/a.harn"),
              {id: "ordinary-observation", name: "edit", arguments: {}},
            ],
          },
          {
            tool_calls: [
              member_call("failed-member", "src/a.harn", true),
              member_call("blocked-member", "src/a.harn"),
              member_call("independent-member", "src/b.harn"),
            ],
          },
          llm_text("##DONE##"),
        ],
        { ->
          return agent_loop(
            harness,
            "Observe before mutation and recover from failed edits.",
            nil,
            {
              provider: "mock",
              tools: tools,
              tool_format: "native",
              max_iterations: 4,
              max_concurrent_tools: 4,
              loop_until_done: true,
              done_sentinel: "##DONE##",
            },
          )
        },
      )
    },
  )
  let deferred = false
  let blocked = false
  for event in captured.events {
    if event?.type == "tool_batch_disposition" {
      const receipt = event.receipt
      if receipt.tool_call_id == "deferred-member" {
        deferred = receipt.disposition == "deferred" && receipt.phase == "mutation"
      }
      if receipt.tool_call_id == "blocked-member" {
        blocked = receipt.disposition == "skipped_after_blocking_result"
          && receipt.blocking_tool_call_id == "failed-member"
      }
    }
  }
  require deferred, "the namespaced mutation must wait for a new inference after observation"
  require blocked, "a failed member must block its same-resource sibling"
  require harness.runtime.atomic_get(observations) == 1, "the ordinary observation must fire"
  require harness.runtime.atomic_get(mutations) == 2,
    "only the failed member and independent-resource member may fire"
  require captured.result.status == "done", "the guarded batch must reach terminal completion"
  harness.stdio.println("qualified phases and resource guards reached")
}
