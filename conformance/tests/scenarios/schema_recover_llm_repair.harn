import { llm_text, with_llm_script } from "std/testing"

/**
 * `schema_recover` falls through to the LLM repair stage when the
 * three deterministic stages can't recover the value, and the mock
 * provider returns valid JSON. Stage="llm_repair", repaired=true,
 * attempts=4 (parsed → regex → llm_repair; the extracted stage is
 * skipped when extract_json_from_text doesn't change the input).
 */
pipeline default(harness: Harness) {
  const schema = {type: "object", required: ["verdict"], properties: {verdict: {type: "string"}}}
  with_llm_script(
    harness.llm, [llm_text("{\"verdict\": \"pass\"}")],
    { ->
      const r = harness.llm.recover_schema(
        "model said pass but failed to format it",
        schema,
        {provider: "mock"},
      )
      harness.stdio.println(r.ok)
      harness.stdio.println(r.stage)
      const data = r.data
      if data != nil {
        harness.stdio.println(data.verdict)
      }
      harness.stdio.println(r.repaired)
    },
  )
}
