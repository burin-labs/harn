// Unknown model id -> pack_for must not throw; final dict carries at least
// model + provider even when catalog-side capability data is absent.
import { pack_for } from "std/llm/defaults"

pipeline test(harness: Harness, task: unknown) {
  const r = pack_for(harness.agent, harness.llm, {model: "totally-fake-model-id"})
  assert_eq(type_of(r), "dict")
  assert_eq(r.model, "totally-fake-model-id")
  assert_eq(type_of(r.provider), "string")
  assert(r.provider != "", "provider must be a non-empty string")
  harness.stdio.log("llm_defaults_pack_unknown_model_minimal passed")
}
