import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const schema = {type: "object", required: ["verdict"], properties: {verdict: {type: "string"}}}
  with_llm_script(
    harness.llm, [llm_text("{\"note\": \"missing verdict\"}"), llm_text("{\"verdict\": \"pass\"}")],
    { ->
      const structured = agent_loop(harness, "grade this",
        nil,
        {
          provider: "mock",
          profile: "verifier",
          output: {schema: schema, strict: true, validation: "error"},
        },
      )
      harness.stdio.println(structured.visible_text)
      const calls = harness.llm.mock_calls()
      harness.stdio.println(len(calls))
      assert(len(calls) == 2, "verifier profile should retry schema-invalid output")
      assert(
        calls[0].output_format.kind == "text",
        "ordinary agent_loop turns must not force provider structured-output mode",
      )
      assert(
        calls[1].output_format.kind == "json_schema",
        "terminal output-schema repair should enforce structured output",
      )
      assert(structured.output_valid, "terminal repair should validate the final output")
      assert(structured.output.verdict == "pass", "terminal repair should surface parsed output")
    },
  )
  with_llm_script(
    harness.llm, [llm_text("Needs another pass.")],
    { ->
      const verifier = agent_loop(harness, "verify this",
        nil,
        {provider: "mock", profile: "verifier", loop_until_done: true},
      )
      harness.stdio.println(verifier.status)
      harness.stdio.println(verifier.llm.iterations)
      assert(verifier.status == "stuck", "verifier max_nudges default should stop immediately")
      assert(
        verifier.llm.iterations == 1,
        "verifier profile should run one text-only turn before stuck",
      )
    },
  )
  with_llm_script(
    harness.llm, [llm_text("Still working."), llm_text("Finished. ##DONE##")],
    { ->
      const overridden = agent_loop(harness, "finish in two",
        nil,
        {
          provider: "mock",
          profile: "completer",
          loop_until_done: true,
          max_iterations: 2,
          max_nudges: 2,
        },
      )
      harness.stdio.println(overridden.status)
      harness.stdio.println(overridden.llm.iterations)
      assert(
        overridden.status == "done",
        "explicit max_iterations/max_nudges should override profile",
      )
      assert(
        overridden.llm.iterations == 2,
        "explicit max_iterations override should allow a second turn",
      )
    },
  )
}
