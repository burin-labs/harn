import { llm_text, with_llm_script } from "std/testing"

/** JSON embedded in plain prose (no code fence): extracted_json: true. */
pipeline default(harness: Harness) {
  const schema = {type: "object", required: ["verdict"], properties: {verdict: {type: "string"}}}
  with_llm_script(
    harness.llm, [llm_text("Here is my judgment: {\"verdict\": \"PASS\"} — looks good to me.")],
    { ->
      const r = harness.llm.call_structured_result("Grade", schema, {provider: "mock"})
      harness.stdio.println(r.ok)
      harness.stdio.println(r.data.verdict)
      harness.stdio.println(r.extracted_json)
      harness.stdio.println(r.attempts)
    },
  )
}
