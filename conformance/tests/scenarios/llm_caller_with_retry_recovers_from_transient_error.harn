import { agent_loop } from "std/agent/loop"
/**
 * Cross-slice integration: agent_loop's llm_caller seam composes with
 * std/llm/handlers::with_retry. Synthetic caller fails twice with
 * {ok: false, status: "transient"} then succeeds; with_retry wraps it; the
 * recovered text becomes agent_loop's visible_text.
 */
import { with_retry } from "std/llm/handlers"

pipeline default(harness: Harness) {
  const counter = harness.runtime.atomic(0)
  const synthetic = { _call ->
    let n = harness.runtime.atomic_add(counter, 1)
    if n < 2 {
      return {ok: false, status: "transient", error: "blip"}
    }
    return {
      ok: true,
      value: {
        text: "all-ok",
        model: "mock",
        provider: "mock",
        input_tokens: 0,
        output_tokens: 0,
        usage: {input_tokens: 0, output_tokens: 0},
      },
    }
  }
  const caller = with_retry(harness, synthetic, {max_attempts: 5, base_ms: 1})
  const result = agent_loop(harness, "hi", nil, {provider: "mock", llm_caller: caller, max_iterations: 1})
  harness.stdio.println(result.status)
  harness.stdio.println(result.visible_text)
}
