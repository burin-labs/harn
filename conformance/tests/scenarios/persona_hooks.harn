import { llm_text, with_llm_script } from "std/testing"

const hook_order = atomic(0)

fn audit_tools() {
  const registry = tool_registry()
  return tool_define(
    registry,
    "audit_tool",
    "Return an audit marker",
    {parameters: {}, handler: { _args -> "audit-output-that-should-be-compacted" }},
  )
}

@persona(name: "merge_captain")
fn merge_captain(ctx) -> string {
  const merged = admin_merge(ctx)
  return "persona:" + merged
}

@step(name: "admin_merge")
fn admin_merge(ctx) -> string {
  return with_llm_script(
    [
      {tool_calls: [{id: "audit_1", name: "audit_tool", arguments: {}}]},
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      const result = agent_loop(
        "Run the audit tool",
        nil,
        {
          provider: "mock",
          tools: audit_tools(),
          tool_format: "native",
          max_iterations: 2,
          loop_until_done: true,
          session_id: "persona-hooks-composition",
        },
      )
      const saw_tool_hook = json_stringify(transcript_messages(result?.transcript)).contains(
        "permission_denied",
      )
      return "merge:" + ctx + ":" + to_string(saw_tool_hook)
    },
  )
}

pipeline default() {
  clear_persona_hooks()
  clear_tool_hooks()
  register_tool_hook({pattern: "audit_tool", deny: "audit blocked by tool hook"})
  register_persona_hook(
    "merge_*",
    "PreStep",
    { ctx ->
      if ctx.step.name == "admin_merge" {
        atomic_add(hook_order, 1)
      }
      return nil
    },
  )
  register_step_hook(
    "merge_captain",
    "admin_merge",
    "PreStep",
    { ctx ->
      if ctx.step.args[0] == "PR-7" && atomic_get(hook_order) == 1 {
        atomic_add(hook_order, 10)
      }
      return {args: [ctx.step.args[0] + ":modified"]}
    },
  )
  register_step_hook(
    "merge_captain",
    "admin_merge",
    "PostStep",
    { ctx ->
      if ctx.output == "merge:PR-7:modified:true" && atomic_get(hook_order) == 11 {
        atomic_add(hook_order, 100)
      }
      return {output: ctx.output + ":post"}
    },
  )
  const result = merge_captain("PR-7")
  __io_println(result)
  __io_println(atomic_get(hook_order))
  clear_persona_hooks()
  clear_tool_hooks()
}
