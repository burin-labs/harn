// Conformance test for std/llm/handlers::with_retry — never retries on
// non-retryable statuses such as schema_validation.
import { with_retry } from "std/llm/handlers"

pipeline default() {
  const counter = atomic(0)
  const synthetic = { _call ->
    let _ = atomic_add(counter, 1)
    return {ok: false, status: "schema_validation", error: "bad shape"}
  }
  const caller = with_retry(synthetic, {max_attempts: 5, base_ms: 1})
  const env = caller(
    {prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}},
  )
  __io_println(env.ok)
  __io_println(env.status)
  __io_println(env.retries_attempted)
  __io_println(atomic_get(counter))
}
