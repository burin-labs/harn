import { agent_capture_events } from "std/agent/events"
import { read_jsonl } from "std/jsonl"
import {
  compose_tool_callers,
  tools_use_middleware,
  with_audit_log,
  with_required_reason,
} from "std/llm/tool_middleware"
import { llm_text, with_llm_script } from "std/testing"

fn receipt_tools() {
  const registry = tool_registry()
  return tool_define(
    registry,
    "echo_receipt",
    "Echo a message",
    {
      handler: { args -> return {echoed: to_string(args?.message ?? "")} },
      parameters: {message: {type: "string"}, secret: {type: "string"}},
    },
  )
}

fn run_receipt_agent(session, audit_options) {
  return with_llm_script(
    [
      {
        tool_calls: [
          {
            id: "receipt-1",
            name: "echo_receipt",
            arguments: {message: "hello", secret: "hide-me", reason: "Need a receipt"},
          },
        ],
      },
      llm_text("Done. ##DONE##"),
    ],
    { ->
      const reason = with_required_reason({schema_required: false})
      const tools = tools_use_middleware(receipt_tools(), reason.schema_transform)
      const caller = compose_tool_callers([with_audit_log(audit_options), reason.caller])
      return agent_loop(
        "emit a tool receipt",
        nil,
        {
          provider: "mock",
          model: "mock",
          session_id: session,
          tools: tools,
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          tool_caller: caller,
        },
      )
    },
  )
}

pipeline default() {
  clear_tool_hooks()
  register_tool_hook(
    {
      pattern: "echo_receipt",
      pre: { _event ->
        return {
          reminder: {
            body: "receipt hook reminder",
            tags: ["receipt"],
            dedupe_key: "receipt-hook",
            ttl_turns: 1,
            role_hint: "developer",
          },
        }
      },
    },
  )
  const local_session = "receipt-local-" + uuid()
  const local_path = path_join(".harn", "receipts", local_session + ".jsonl")
  if harness.fs.exists(local_path) {
    harness.fs.delete(local_path)
  }
  const local_captured = agent_capture_events(
    local_session,
    fn() { return run_receipt_agent(local_session, {sink: "local", redact: ["secret"]}) },
  )
  const local_result = local_captured.result
  const records = read_jsonl(local_path, {strict: true})
  const receipt = records[0]
  const receipt_json = json_stringify(receipt)
  const reminder_audit = receipt?.audit?.reminders ?? {}
  const reminder_lifecycle = reminder_audit?.lifecycle ?? []
  const expected_args_hash = sha256("{\"message\":\"hello\",\"reason\":\"Need a receipt\"}")
  const expected_receipt_uri = "file://" + path_join(cwd(), local_path)
  const local_audit_events = local_captured.events.filter(
    { event -> event.type == "tool_call_audit" },
  )
  const local_audit_uri = to_string(local_audit_events[0]?.audit?.receipt_uri ?? "")
  __io_println("local_status=" + local_result.status)
  __io_println("local_records=" + to_string(len(records)))
  __io_println("schema_version=" + to_string(receipt.schema_version))
  __io_println("reason=" + receipt.reason)
  __io_println("receipt_status=" + receipt.status)
  __io_println("secret_redacted=" + to_string(!contains(receipt_json, "hide-me")))
  __io_println("args_hash_redacted=" + to_string(receipt.args_hash == expected_args_hash))
  __io_println("result_hash_present=" + to_string(len(to_string(receipt.result_hash ?? "")) == 64))
  __io_println(
    "receipt_uri_in_receipt="
      + to_string(
      to_string(receipt?.audit?.receipt_uri ?? "") == expected_receipt_uri,
    ),
  )
  __io_println("receipt_uri_in_audit_event=" + to_string(local_audit_uri == expected_receipt_uri))
  __io_println("reminder_audit_origin=" + to_string(reminder_audit?.origin ?? ""))
  __io_println("reminder_lifecycle_count=" + to_string(len(reminder_lifecycle)))
  __io_println("reminder_hook_event=" + to_string(reminder_lifecycle[0]?.hook_event ?? ""))
  __io_println(
    "reminder_tool_call_id="
      + to_string(reminder_lifecycle[0]?.tool_call_id == receipt.tool_call_id),
  )
  __io_println("reminder_source=" + to_string(reminder_lifecycle[0]?.source ?? ""))
  __io_println("reminder_role_hint=" + to_string(reminder_lifecycle[0]?.role_hint ?? ""))
  __io_println("reminder_tag=" + to_string(reminder_lifecycle[0]?.tags[0] ?? ""))
  const cloud_session = "receipt-cloud-" + uuid()
  const captured = agent_capture_events(
    cloud_session,
    fn() { return run_receipt_agent(cloud_session, {sink: "cloud", redact: ["secret"]}) },
  )
  const receipt_events = captured.events.filter(
    { event -> event.type == "tool_call_audit" && event?.receipt != nil },
  )
  __io_println("cloud_receipts=" + to_string(len(receipt_events)))
  __io_println("cloud_reason=" + receipt_events[0].receipt.reason)
  __io_println(
    "cloud_omits_receipt_uri=" + to_string(receipt_events[0]?.receipt?.audit?.receipt_uri == nil),
  )
  __io_println(
    "cloud_reminder_audit="
      + to_string(
      receipt_events[0]?.receipt?.audit?.reminders?.origin == "tool_hook",
    ),
  )
  clear_tool_hooks()
}
