import { agent_skills_preview } from "std/agent/skills"

fn assert_only_the_declared_skills_field_advertises_loading(agent: HarnessAgent) {
  skill alpha {
    description "Alpha workflow"
    when_to_use "Use alpha for alpha-shaped work"
    prompt "Alpha instructions."
  }
  const canonical = agent_skills_preview(agent, {skills: alpha})
  assert(contains(json_stringify(canonical?.tools), "load_skill"))
  const retired = agent_skills_preview(agent, {skill_registry: alpha})
  assert(retired?.tools == nil)
}

pipeline default(harness: Harness) {
  assert_only_the_declared_skills_field_advertises_loading(harness.agent)
  harness.stdio.println("agent option spellings passed")
}
