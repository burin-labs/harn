pipeline default() {
  let prompt = ""
  for i in range(0, 80) {
    prompt += "stable cacheable prefix line " + to_string(i)
      + ": explain prompt caching usage fields.\n"
  }
  const options = {provider: "mock", model: "claude-sonnet-4-20250514", cache: true}
  const first = llm_call(prompt, nil, options)
  const second = llm_call(prompt, nil, options)
  __io_println(first.usage.cache_read_tokens == 0)
  __io_println(first.usage.cache_write_tokens > 0)
  __io_println(first.usage.cache_creation_input_tokens == first.usage.cache_write_tokens)
  __io_println(second.usage.cache_read_tokens > 0)
  __io_println(second.usage.cache_write_tokens == 0)
  __io_println(second.usage.cache_hit_ratio == 1.0)
  __io_println(second.usage.cache_savings_usd > 0.0)
  __io_println(second.cache_read_tokens == second.usage.cache_read_tokens)
}
