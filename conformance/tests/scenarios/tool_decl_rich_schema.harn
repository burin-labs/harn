pipeline test(task) {
  tool create_user(
    user: {name: string, age?: int},
    tags: list<string>,
    prefs: dict<string, int>,
  ) -> {ok: bool, names: list<string>} {
    return {ok: user.name != "" && prefs["missing"] == nil, names: tags}
  }
  const tool_def = tool_find(create_user, "create_user")
  __io_println(tool_def.parameters.user.type)
  __io_println(tool_def.parameters.user.properties.name.type)
  __io_println(tool_def.parameters.user.required[0])
  __io_println(tool_def.parameters.tags.items.type)
  __io_println(tool_def.parameters.prefs.additionalProperties.type)
  __io_println(tool_def.outputSchema.properties.ok.type)
  __io_println(tool_def.outputSchema.properties.names.items.type)
}
