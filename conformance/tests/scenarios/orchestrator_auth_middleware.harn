import "../_common"

pipeline test(task) {
  const root = path_join(harness.fs.temp_dir(), "harn-orchestrator-auth-" + uuid())
  harness.fs.mkdir(root)
  harness.fs
    .write_text(
    path_join(root, "harn.toml"),
    "[package]\nname = \"fixture\"\n\n[exports]\nhandlers = \"lib.harn\"\n\n[[triggers]]\nid = \"incoming-review-task\"\nkind = \"a2a-push\"\nprovider = \"a2a-push\"\npath = \"/a2a/review\"\nmatch = { events = [\"a2a.task.received\"] }\nhandler = \"handlers::on_task\"\n",
  )
  harness.fs
    .write_text(
    path_join(root, "lib.harn"),
    "import \"std/triggers\"\n\npub fn on_task(event: TriggerEvent) {\n  log(event.kind)\n}\n",
  )
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = resolve_harn_bin(harness, repo_root)
  assert(harness.fs.exists(harn_bin), "missing built harn binary at " + harn_bin)
  const start = shell_at(
    root,
    "nohup env HARN_SECRET_PROVIDERS=env HARN_ORCHESTRATOR_API_KEYS=test-key-1,test-key-2 HARN_ORCHESTRATOR_HMAC_SECRET=shared-secret "
      + harn_bin
      + " orchestrator serve --config harn.toml --state-dir ./state --role single-tenant --bind 127.0.0.1:0 >/dev/null 2>orchestrator.log </dev/null & echo $!",
  )
  const pid = start.stdout.trim()
  assert(start.success, "failed to start orchestrator")
  assert(pid != "", "missing orchestrator pid")
  const url = wait_for_listener_url(harness, path_join(root, "orchestrator.log"))
  assert(url != nil, "listener URL did not appear in log")
  const body = "{\"kind\":\"a2a.task.received\",\"task\":{\"id\":\"task-123\"}}"
  const json_headers = {"Content-Type": "application/json"}
  const unauth = harness.net.request("POST", url + "/a2a/review", {body: body, headers: json_headers})
  __io_println(unauth.status == 401)
  const ts = to_string(to_int(harness.clock.timestamp()))
  const wrong_hmac = harness.net
    .request(
    "POST",
    url + "/a2a/review",
    {
      body: body,
      headers: {
        "Content-Type": "application/json",
        Authorization: "HMAC-SHA256 timestamp=" + ts + ",signature=AAAAAAAAAAAAAAAAAAAAAA==",
      },
    },
  )
  __io_println(wrong_hmac.status == 401)
  const bearer = harness.net
    .request(
    "POST",
    url + "/a2a/review",
    {body: body, headers: {"Content-Type": "application/json", Authorization: "Bearer test-key-2"}},
  )
  __io_println(bearer.status == 200)
  const _ = shell("kill -TERM " + pid)
  wait_for_exit(pid)
  harness.fs.delete(root)
}
