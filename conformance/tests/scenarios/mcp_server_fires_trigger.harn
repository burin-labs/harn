import "../_common"

pipeline default(harness: Harness) {
  const root = harness.fs.mkdtemp("harn-mcp-fire-")
  const log_path = path_join(root, "trigger.log")
  harness.fs.write_text(
    path_join(root, "harn.toml"),
    "[package]\nname = \"fixture\"\n\n[exports]\nhandlers = \"lib.harn\"\n\n[[triggers]]\nid = \"cron-ok\"\nkind = \"cron\"\nprovider = \"cron\"\nschedule = \"* * * * *\"\nmatch = { events = [\"cron.tick\"] }\nhandler = \"handlers::on_ok\"\n",
  )
  harness.fs.write_text(
    path_join(root, "lib.harn"),
    "import \"std/triggers\"\n\nlet log_path = \""
      + log_path
      + "\"\n\npub fn on_ok(harness: Harness, event: TriggerEvent) -> dict {\n  harness.fs.write_text(log_path, \"fired:\" + event.kind + \"\\n\")\n  return {kind: event.kind, event_id: event.id}\n}\n",
  )
  const repo_root = harness.process.exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = resolve_harn_bin(harness, repo_root)
  const result = harness.process.exec(
    harn_bin,
    "mcp",
    "call",
    "--tool",
    "harn.trigger.fire",
    "--arguments",
    "{\"trigger_id\":\"cron-ok\",\"payload\":{}}",
    "--",
    harn_bin,
    "mcp",
    "serve",
    "--config",
    path_join(root, "harn.toml"),
    "--state-dir",
    path_join(root, "state"),
  )
  require result.success, "mcp call failed"
  const payload = json_parse(result.stdout.trim())
  harness.stdio.println(payload.result.status == "dispatched")
  harness.stdio.println(payload.result.binding_id == "cron-ok")
  harness.stdio.println(harness.fs.exists(log_path))
  harness.stdio.println(harness.fs.read_text(log_path).contains("fired:cron.tick"))
}
