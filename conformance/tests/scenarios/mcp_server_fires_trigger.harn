import "../_common"

pipeline default() {
  const root = path_join(harness.fs.temp_dir(), "harn-mcp-fire-" + uuid())
  harness.fs.mkdir(root)
  const log_path = path_join(root, "trigger.log")
  harness.fs
    .write_text(
    path_join(root, "harn.toml"),
    "[package]\nname = \"fixture\"\n\n[exports]\nhandlers = \"lib.harn\"\n\n[[triggers]]\nid = \"cron-ok\"\nkind = \"cron\"\nprovider = \"cron\"\nschedule = \"* * * * *\"\nmatch = { events = [\"cron.tick\"] }\nhandler = \"handlers::on_ok\"\n",
  )
  harness.fs
    .write_text(
    path_join(root, "lib.harn"),
    "import \"std/triggers\"\n\nlet log_path = \""
      + log_path
      + "\"\n\npub fn on_ok(event: TriggerEvent) -> dict {\n  write_file(log_path, \"fired:\" + event.kind + \"\\n\")\n  return {kind: event.kind, event_id: event.id}\n}\n",
  )
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = resolve_harn_bin(harness, repo_root)
  const helper = path_join(repo_root, "conformance/helpers/mcp_stdio_tool.py")
  const result = exec(
    "python3",
    helper,
    harn_bin,
    path_join(root, "harn.toml"),
    path_join(root, "state"),
    "harn.trigger.fire",
    "{\"trigger_id\":\"cron-ok\",\"payload\":{}}",
  )
  assert(result.success, "mcp helper failed")
  const payload = json_parse(result.stdout.trim())
  __io_println(payload.status == "dispatched")
  __io_println(payload.binding_id == "cron-ok")
  __io_println(harness.fs.exists(log_path))
  __io_println(harness.fs.read_text(log_path).contains("fired:cron.tick"))
}
