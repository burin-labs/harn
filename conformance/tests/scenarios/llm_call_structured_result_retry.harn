import { llm_text, with_llm_script } from "std/testing"

/**
 * Schema-retry recovery: first response is missing the required key,
 * second response satisfies the schema. The envelope reports
 * attempts=2 and ok=true.
 */
pipeline default(harness: Harness) {
  const schema = {
    type: "object",
    required: ["verdict"],
    properties: {verdict: {type: "string"}, note: {type: "string"}},
  }
  with_llm_script(
    harness.llm,
    [llm_text("{\"note\": \"hmm\"}"), llm_text("{\"verdict\": \"PASS\", \"note\": \"\"}")],
    { ->
      const r = harness.llm.call_structured_result("Grade", schema, {provider: "mock"})
      harness.stdio.println(r.ok)
      harness.stdio.println(r.data.verdict)
      harness.stdio.println(r.attempts)
      harness.stdio.println(r.repaired)
      harness.stdio.println(r.extracted_json)
    },
  )
}
