import "../_common"

pipeline default(task) {
  const unique = uuid()
  const root = path_join(harness.fs.temp_dir(), "harn-worker-claim-expiry-" + unique)
  const producer_dir = path_join(root, "producer")
  const failing_consumer_dir = path_join(root, "consumer-fail")
  const ok_consumer_dir = path_join(root, "consumer-ok")
  const state_dir = path_join(root, "state")
  harness.fs.mkdir(root)
  harness.fs.mkdir(producer_dir)
  harness.fs.mkdir(failing_consumer_dir)
  harness.fs.mkdir(ok_consumer_dir)
  harness.fs.mkdir(state_dir)
  harness.fs.write_text(
    path_join(producer_dir, "harn.toml"),
    "[package]\nname = \"worker-producer\"\n\n[[triggers]]\nid = \"incoming-review-task\"\nkind = \"a2a-push\"\nprovider = \"a2a-push\"\nmatch = { events = [\"a2a.task.received\"] }\nhandler = \"worker://triage\"\n",
  )
  harness.fs.write_text(
    path_join(failing_consumer_dir, "harn.toml"),
    "[package]\nname = \"worker-consumer-fail\"\n\n[exports]\nhandlers = \"lib.harn\"\n\n[[triggers]]\nid = \"incoming-review-task\"\nkind = \"a2a-push\"\nprovider = \"a2a-push\"\nmatch = { events = [\"a2a.task.received\"] }\nhandler = \"handlers::on_task\"\n",
  )
  harness.fs.write_text(
    path_join(failing_consumer_dir, "lib.harn"),
    "import \"std/triggers\"\n\npub fn on_task(event: TriggerEvent) -> any {\n  throw(\"fail:\" + event.id)\n}\n",
  )
  harness.fs.write_text(
    path_join(ok_consumer_dir, "harn.toml"),
    "[package]\nname = \"worker-consumer-ok\"\n\n[exports]\nhandlers = \"lib.harn\"\n\n[[triggers]]\nid = \"incoming-review-task\"\nkind = \"a2a-push\"\nprovider = \"a2a-push\"\nmatch = { events = [\"a2a.task.received\"] }\nhandler = \"handlers::on_task\"\n",
  )
  harness.fs.write_text(
    path_join(ok_consumer_dir, "lib.harn"),
    "import \"std/triggers\"\n\npub fn on_task(event: TriggerEvent) -> dict {\n  return {ok: true, event_id: event.id}\n}\n",
  )
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  assert(harness.fs.exists(harn_bin), "missing built harn binary at " + harn_bin)
  const fire = exec(
    harn_bin,
    "orchestrator",
    "fire",
    "incoming-review-task",
    "--config",
    path_join(producer_dir, "harn.toml"),
    "--state-dir",
    state_dir,
  )
  assert(fire.success, "producer fire failed: " + fire.stderr)
  const first = exec(
    harn_bin,
    "orchestrator",
    "queue",
    "--config",
    path_join(failing_consumer_dir, "harn.toml"),
    "--state-dir",
    state_dir,
    "drain",
    "triage",
    "--consumer-id",
    "consumer-a",
    "--claim-ttl",
    "50ms",
    "--json",
  )
  const first_data = json_parse(first.stdout)
  __io_println(
    first.success && first_data.drained == 1 && first_data.acked == 0 && first_data.deferred == 1,
  )
  __io_println(
    first_data.summary.in_flight == 1
      && first_data.summary.responses == 1
      && first_data.responses[0].outcome?.status == "dlq"
      && first_data.responses[0].outcome?.error
      != nil,
  )
  // Poll the second drain until the expired claim is reclaimed. A bare
  // `sleep(120ms)` was the original wait, but under heavy parallel
  // cargo load the second subprocess can cold-start and call
  // `claim_next` while the first drain's last 25ms heartbeat is still
  // alive (TTL = 50ms, heartbeat = TTL/2), so the second drain saw
  // zero ready jobs and the assertions tripped. Re-running `drain` is
  // idempotent — a no-op drain returns `drained:0` without consuming
  // state — so retrying until the reclaim lands is safe. Budget is
  // generous enough to absorb GHA-runner stalls without making the
  // happy path slower than the original wait.
  let second = nil
  let second_data = nil
  const claim_reclaim_deadline = harness.clock.now_ms() + 5000
  while harness.clock.now_ms() < claim_reclaim_deadline {
    second = exec(
      harn_bin,
      "orchestrator",
      "queue",
      "--config",
      path_join(ok_consumer_dir, "harn.toml"),
      "--state-dir",
      state_dir,
      "drain",
      "triage",
      "--consumer-id",
      "consumer-b",
      "--json",
    )
    if second.success {
      const parsed = json_parse(second.stdout)
      if parsed.drained == 1 && parsed.acked == 1 && parsed.deferred == 0 {
        second_data = parsed
        break
      }
      second_data = parsed
    }
    sleep(50ms)
  }
  __io_println(
    second.success && second_data.drained == 1 && second_data.acked == 1
      && second_data.deferred == 0,
  )
  const first_has_response = len(first_data.responses ?? []) > 0
  const second_has_response = len(second_data.responses ?? []) > 0
  __io_println(
    first_has_response
      && second_has_response
      && second_data.responses[0].job_event_id
      == first_data.responses[0]
      .job_event_id
      && second_data.responses[0].outcome?.status == "succeeded",
  )
  __io_println(
    second_data.summary.ready == 0 && second_data.summary.in_flight == 0
      && second_data.summary
      .responses
      == 2,
  )
}
