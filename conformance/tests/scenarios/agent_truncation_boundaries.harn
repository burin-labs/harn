import { agent_loop } from "std/agent/loop"
// Model-visible stdlib caps emit the same typed boundary event as Rust-owned
// runtime caps. This exercises the real agent/tool path so the session owner,
// subscriber fanout, and dropped-byte payload are all proven together.
import { command_failure_text } from "std/command"
import { llm_text, with_llm_script } from "std/testing"

fn truncating_tools(agent: HarnessAgent) {
  const with_cap = tool_define(
    tool_registry(),
    "show_failure",
    "Render a bounded command failure",
    {
      parameters: {},
      handler: { _args ->
        command_failure_text(
          agent,
          {status: "failed", exit_code: 1, stdout: "x".repeat(32)},
          {max_stdout_chars: 8},
        )
      },
    },
  )
  // `max_stdout_chars: 0` disables the cap entirely: nothing is dropped, so
  // no boundary event may fire and the full output must survive.
  return tool_define(
    with_cap,
    "show_failure_uncapped",
    "Render an unbounded command failure",
    {
      parameters: {},
      handler: { _args ->
        command_failure_text(
          agent,
          {status: "failed", exit_code: 1, stdout: "y".repeat(32)},
          {max_stdout_chars: 0},
        )
      },
    },
  )
}

pipeline test(harness: Harness, task) {
  const session_id = "agent-truncation-boundary-" + harness.random.uuid()
  const seen = harness.runtime.atomic(0)
  const dropped_bytes = harness.runtime.atomic(0)
  harness.agent.subscribe(
    session_id,
    { event ->
      if event?.type == "boundary_failure" && event?.boundary == "agent_prompt_content" {
        const _ = harness.runtime.atomic_add(seen, 1)
        const _ = harness.runtime.atomic_set(dropped_bytes, event?.dropped_bytes ?? 0)
      }
    },
  )
  with_llm_script(
    harness.llm,
    [
      llm_text("<tool_call>\nshow_failure({})\n</tool_call>"),
      llm_text("<tool_call>\nshow_failure_uncapped({})\n</tool_call>"),
      llm_text("##DONE##"),
    ],
    { ->
      const _ = agent_loop(
        harness,
        "Show the failure once.",
        nil,
        {
          provider: "mock",
          session_id: session_id,
          tools: truncating_tools(harness.agent),
          tool_format: "text",
          loop_until_done: true,
          done_sentinel: "##DONE##",
          max_iterations: 4,
        },
      )
    },
  )
  assert(
    harness.runtime.atomic_get(seen) == 1,
    "only the capped tool emits a typed boundary; a disabled cap drops nothing",
  )
  assert(
    harness.runtime.atomic_get(dropped_bytes) == 24,
    "the boundary carries exact dropped source bytes",
  )
  harness.stdio.log("ok")
}
