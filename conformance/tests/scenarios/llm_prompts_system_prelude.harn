// std/llm/prompts.system_prelude is deterministic for the same input.
import { system_prelude } from "std/llm/prompts"

pipeline default() {
  const opts = {
    persona: "You are a careful research assistant.",
    tools: ["web_search", "fetch"],
    constraints: ["Cite all sources.", "Never speculate."],
    output_contract: {format: "JSON", fields: "title,summary"},
    examples: [{input: "what is rust?", output: "{\"title\":\"Rust\"}"}],
    tone: "professional",
  }
  const first = system_prelude(opts)
  const second = system_prelude(opts)
  __io_println(first == second)
  __io_println(contains(first, "research assistant"))
  __io_println(contains(first, "web_search"))
  __io_println(contains(first, "Cite all sources."))
  __io_println(contains(first, "Output:"))
  __io_println(contains(first, "Examples:"))
  // tone variation
  const terse = system_prelude({persona: "Hi", tone: "terse"})
  __io_println(contains(terse, "terse and direct"))
}
