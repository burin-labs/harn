/**
 * A nilable binding assigned a concrete value (or guarded with `!= nil`) is
 * narrowed to non-nil, so arithmetic on it is accepted — no `?? ` needed.
 */
pipeline default(harness: Harness) {
  let x: int? = nil
  x = 5
  harness.stdio.println(x + 1)
  let y: int? = nil
  y = 10
  if y != nil {
    harness.stdio.println(y + 2)
  }
}
