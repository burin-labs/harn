pipeline test(harness: Harness, task) {
  enum Status {
    Active
    Inactive
    Pending(reason)
  }
  const s = Status.Pending("waiting for approval")
  match s.variant {
    "Active" -> { harness.stdio.println("active") }
    "Inactive" -> { harness.stdio.println("inactive") }
    "Pending" -> { harness.stdio.println("pending: ${s.fields[0]}") }
  }
}
