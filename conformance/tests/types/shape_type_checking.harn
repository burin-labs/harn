pipeline default(harness: Harness) {
  // Basic shape annotation
  const user: {name: string, age: int} = {name: "Alice", age: 30}
  harness.stdio.println(user["name"])
  harness.stdio.println(user["age"])
  // Optional fields — missing optional is fine
  const config: {host: string, port?: int} = {host: "localhost"}
  harness.stdio.println(config["host"])
  // Width subtyping — extra fields allowed
  fn greet(u: {name: string}) -> string {
    return "hi " + u["name"]
  }
  harness.stdio.println(greet({name: "Bob", age: 25, role: "admin"}))
  // Nested shapes
  const data: {user: {name: string}, tags: list} = {user: {name: "X"}, tags: [1, 2]}
  harness.stdio.println(data["user"]["name"])
  // Shape as return type
  fn make_point() -> {x: int, y: int} {
    return {x: 10, y: 20}
  }
  const p = make_point()
  harness.stdio.println(p["x"] + p["y"])
  // Shape assigned to generic dict
  const d: dict = {a: 1, b: 2}
  harness.stdio.println(d["a"])
  // Shape compatible with dict<string, int>
  const typed: dict<string, int> = {x: 1, y: 2}
  harness.stdio.println(typed["x"])
}
