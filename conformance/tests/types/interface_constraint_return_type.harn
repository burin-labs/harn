pipeline test(harness: Harness, task) {
  interface Sizable {
    fn size(self) -> int
  }
  struct Box {
    width: int
  }
  impl Box {
    fn size(self) -> string {
      return to_string(self.width)
    }
  }
  fn measure<T>(item: T) where T: Sizable {
    harness.stdio.println(item.size())
  }
  measure(Box({width: 3}))
}
