/** Test to_int and to_float builtins */
pipeline default(harness: Harness, task) {
  // to_int from int (passthrough)
  harness.stdio.println(42)
  // to_int from float (truncates)
  harness.stdio.println(to_int(3.9))
  harness.stdio.println(to_int(-2.7))
  // to_int from string
  harness.stdio.println(to_int("123"))
  harness.stdio.println(to_int("-5"))
  // to_int from invalid string returns nil
  harness.stdio.println(to_int("abc"))
  // to_int from nil returns nil
  harness.stdio.println(to_int(nil))
  // to_int from bool follows the documented 1/0 conversion
  harness.stdio.println(to_int(true))
  harness.stdio.println(to_int(false))
  // to_int from non-finite floats returns nil
  harness.stdio.println(to_int(to_float("NaN")))
  // to_float from float (passthrough)
  harness.stdio.println(3.14)
  // to_float from int
  harness.stdio.println(to_float(10))
  // to_float from string
  harness.stdio.println(to_float("2.5"))
  harness.stdio.println(to_float("-1.0"))
  // to_float from invalid string returns nil
  harness.stdio.println(to_float("xyz"))
  // to_float from nil returns nil
  harness.stdio.println(to_float(nil))
  // to_string round-trips
  harness.stdio.println(type_of(5))
  harness.stdio.println(type_of(to_float(5)))
}
