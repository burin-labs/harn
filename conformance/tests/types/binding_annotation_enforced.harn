pipeline test(harness: Harness, task: unknown) {
  // A declared type is checked where it is written, exactly as a declared
  // parameter type is checked where it is passed. `json_parse` returns a
  // payload nobody validated, so the annotation is the validation.
  const doc: {name: string} = json_parse("{\"name\": 12345}")
  harness.stdio.log(doc.name)
}
