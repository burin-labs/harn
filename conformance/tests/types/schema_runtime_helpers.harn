import { read_json_typed, read_json_typed_result, write_json } from "std/fs"
import "std/schema"

type AliasReportUser = {name: string}

fn alias_report_user_name(user: AliasReportUser) {
  return user.name
}

pipeline test(task) {
  let user_schema = schema_object(
    {name: schema_field(schema_string()), role: schema_default(schema_string(), "user")},
    {additional_properties: false},
  )
  __io_println(is_type({name: "Ada"}, user_schema))
  let parsed = get_typed_value({name: "Ada"}, user_schema, true)
  __io_println(parsed.role)
  let missing_required = get_typed_report({}, user_schema, true)
  __io_println(!missing_required.ok)
  __io_println(contains(join(missing_required.errors, "\n"), "missing required key 'name'"))
  let openapi = schema_openapi(user_schema)
  __io_println(openapi.type)
  let from_json = from_json_schema({type: "object", properties: {name: {type: "string"}}, required: ["name"]})
  __io_println(is_type({name: "Bob"}, from_json))
  let report_schema = schema_object(
    {
      age: schema_field(schema_int() + {min: 0}),
      name: schema_field(schema_string() + {min_length: 2}),
      role: schema_default(schema_string(), "user"),
    },
    {additional_properties: false},
  )
  let report = get_typed_report({age: -1, name: "A"}, report_schema)
  let issue_text = json_stringify(report.issues)
  let error_text = join(report.errors, "\n")
  __io_println(report.ok)
  __io_println(len(report.issues) == 2)
  __io_println(contains(issue_text, "\"path\":\"age\""))
  __io_println(contains(issue_text, "\"path\":\"name\""))
  __io_println(contains(error_text, "at age: expected value >= 0"))
  __io_println(contains(error_text, "at name: expected length >= 2"))
  let defaulted = get_typed_report({age: 3, name: "Jo"}, report_schema, true)
  __io_println(defaulted.ok)
  __io_println(defaulted.value.role)
  let alias_report = schema_report({name: "Kai"}, AliasReportUser)
  __io_println(alias_report.ok)
  __io_println(alias_report_user_name({name: "Kai"}))
  let parsed_json = parse_json_typed("{\"name\":\"Nia\"}", AliasReportUser)
  __io_println(parsed_json.name)
  let malformed_json = parse_json_typed_report("{bad", AliasReportUser)
  __io_println(!malformed_json.ok)
  __io_println(malformed_json.stage)
  let wrong_shape = parse_json_typed_report("{\"name\": 42}", AliasReportUser)
  __io_println(!wrong_shape.ok)
  __io_println(wrong_shape.stage)
  const root = path_join(harness.fs.temp_dir(), "harn-schema-runtime-" + uuid_v7())
  const json_path = path_join(root, "user.json")
  write_json(json_path, {name: "Mira"})
  __io_println(read_json_typed(json_path, AliasReportUser).name)
  const missing_result = read_json_typed_result(path_join(root, "missing.json"), AliasReportUser)
  __io_println(is_err(missing_result))
  __io_println(unwrap_err(missing_result).kind)
}
