pipeline test(task) {
  let schema = {
    type: "dict",
    required: ["name", "age"],
    properties: {
      name: {type: "string", min_length: 2},
      age: {type: "int", min: 0},
      role: {type: "string", enum: ["admin", "user"], default: "user"},
      tags: {type: "list", min_items: 1, items: {type: "string", pattern: "^[a-z]+$"}},
    },
  }
  let ok = schema_parse({name: "Ada", age: 36, tags: ["core"]}, schema)
  __io_println(is_ok(ok))
  __io_println(unwrap(ok).role)
  let bad = schema_check({name: "A", age: -1, tags: ["Core"]}, schema)
  __io_println(is_err(bad))
  __io_println(len(unwrap_err(bad).errors) >= 2)
  let union_schema = {union: [{type: "string", min_length: 3}, {type: "int", min: 10}]}
  __io_println(is_ok(schema_check(12, union_schema)))
  __io_println(is_err(schema_check("hi", union_schema)))
  let json_schema = schema_to_json_schema(schema)
  __io_println(json_schema.type)
  __io_println(json_schema.properties.role.default)
  let picked = schema_pick(schema, ["name", "role"])
  __io_println(picked.required[0])
  __io_println(len(picked.properties) == 2)
  let partial = schema_partial(schema)
  __io_println(partial.required == nil || len(partial.required) == 0)
  let extended = schema_extend(schema, {title: "User"})
  __io_println(extended.title)
}
