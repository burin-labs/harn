/**
 * The empty literal `{}` is the top object type (like TS/Flow `{}`): it has no
 * fields, so it satisfies an all-optional shape and can be reassigned to any
 * later value. A *bare* `dict` value still may not flow into a specific shape
 * without narrowing — only the precise empty literal does.
 */
type Options = {verbose?: bool, retries?: int}

pipeline default(harness: Harness) {
  // `{}` satisfies an all-optional shape — no required field is missing.
  const opts: Options = {}
  harness.stdio.println(opts.verbose == nil)
  // A shape with only optional fields still accepts an empty literal directly.
  const cfg: {name?: string} = {}
  harness.stdio.println(cfg.name == nil)
  // `{}` is top, so a var initialized empty accepts a later concrete record.
  let acc = {}
  acc = {count: 1}
  harness.stdio.println("ok")
}
