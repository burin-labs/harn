pipeline test(harness: Harness, task) {
  enum Result {
    Ok(value)
    Err(message)
  }
  const success = Result.Ok(42)
  harness.stdio.log(success)
  harness.stdio.log(success.variant)
  const failure = Result.Err("something went wrong")
  harness.stdio.log(failure)
  harness.stdio.log(failure.variant)
  harness.stdio.log(failure.fields)
}
