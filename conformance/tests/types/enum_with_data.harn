pipeline test(harness: Harness, task) {
  enum Result {
    Ok(value)
    Err(message)
  }
  const success = Result.Ok(42)
  harness.stdio.println(success)
  harness.stdio.println(success.variant)
  const failure = Result.Err("something went wrong")
  harness.stdio.println(failure)
  harness.stdio.println(failure.variant)
  harness.stdio.println(failure.fields)
}
