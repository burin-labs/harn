pipeline default() {
  fn area(w: int, h: int) {
    return w * h
  }
  let a: int = area(3, 4)
  __io_println(a)
  fn label() {
    return "hi"
  }
  let s: string = label()
  __io_println(s)
  // Recursive fn: inference must not loop — the self-call resolves to the
  // hoisted placeholder (unknown), so `fact` stays dynamic but still runs.
  fn fact(n: int) {
    if n <= 1 {
      return 1
    }
    return n * fact(n - 1)
  }
  __io_println(to_string(fact(5)))
  // Un-annotated param -> return type cannot be known, so it stays dynamic and
  // binds to any annotation without a static error.
  fn idish(x) {
    return x
  }
  let d: string = idish("ok")
  __io_println(d)
}
