pipeline default() {
  /** Define an interface */
  interface Printable {
    fn to_display() -> string
  }
  // Define a struct
  struct Point {
    x: int
    y: int
  }
  // Create struct instances (dict-style construction)
  let p = {x: 10, y: 20}
  __io_println(p.x)
  __io_println(p.y)
  // Interfaces are declarative type contracts
  __io_println("interfaces work")
}
