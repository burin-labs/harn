// Verifies that std/collections helpers preserve `dict<string, V>` value
// typing through generic projection: a homogeneous int-valued input projects
// back to a dict whose values still flow into `int` slots, and an explicit
// type argument pins the value type at the call site.
import { filter_nil, pick_keys } from "std/collections"

pipeline default(task) {
  let counts: dict<string, int> = {a: 1, b: 2, c: 3}
  let cleaned: dict<string, int> = filter_nil(counts)
  println(cleaned.a)
  println(cleaned.b)
  println(cleaned.c)
  let picked: dict<string, int> = pick_keys(counts, ["a", "c"])
  println(picked.a)
  println(picked.c)
  println(contains(picked.keys(), "b"))
  let dropped = pick_keys<int>({a: 1, b: nil, c: 3}, ["a", "b", "c"], {drop_nil: true})
  println(dropped.a)
  println(dropped.c)
  println(contains(dropped.keys(), "b"))
}
