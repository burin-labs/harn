/**
 * Iterators are read-only, so element-type widening is sound:
 * an `iter<int>` flows into an `iter<float>`-typed slot.
 */
pipeline test(harness: Harness, task) {
  fn sink(ys: iter<float>) -> int {
    return 0
  }
  fn pipe(xs: iter<int>) -> int {
    return sink(xs)
  }
  harness.stdio.println("ok")
}
