pipeline default(harness: Harness) {
  fn answer() -> string {
    return "module"
  }
  fn invoke(answer: fn() -> int) -> int {
    return answer()
  }
  fn registry() {
    return {items: ["x"]}
  }
  // A local that shadows a same-named function must resolve to the local even
  // when its static type is unknown — not fall through to the function (which
  // would mis-type the returned value as a function reference).
  fn build(seed: dict) {
    const registry = seed
    return registry
  }
  assert(invoke(fn() -> int { return 7 }) == 7)
  assert(answer() == "module")
  const r = build({items: ["a", "b"]})
  harness.stdio.println(to_string(len(r.items)))
}
