pipeline default() {
  fn registry() {
    return {items: ["x"]}
  }
  // A local that shadows a same-named function must resolve to the local even
  // when its static type is unknown — not fall through to the function (which
  // would mis-type the returned value as a function reference).
  fn build(seed) {
    let registry = seed
    return registry
  }
  let r = build({items: ["a", "b"]})
  __io_println(to_string(len(r.items)))
}
