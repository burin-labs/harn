pipeline test(harness: Harness, task) {
  struct Point {
    x: int
    y: int
  }
  impl Point {
    fn total(self) {
      return self.x + self.y
    }
  }
  const point = Point {x: 3, y: 4}
  harness.stdio.println(point.x)
  harness.stdio.println(point.y)
  harness.stdio.println(point.total())
}
