/** Test type_of() based narrowing */
pipeline test(harness: Harness, task: unknown) {
  fn describe(x: string | int | nil) -> string {
    if type_of(x) == "string" {
      return "string: ${x}"
    }
    if type_of(x) == "int" {
      return "int: ${x}"
    }
    return "nil"
  }
  fn not_string(x: string | int) -> string {
    if type_of(x) != "string" {
      return "not string: ${x}"
    }
    return "is string: ${x}"
  }
  harness.stdio.log(describe("hello"))
  harness.stdio.log(describe(42))
  harness.stdio.log(describe(nil))
  harness.stdio.log(not_string(99))
  harness.stdio.log(not_string("hi"))
}
