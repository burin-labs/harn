/** Test "did you mean" suggestions on shape validation errors */
pipeline default(harness: Harness, task: unknown) {
  fn process(data: {name: string, email: string}) {
    harness.stdio.println(data.name)
  }
  // Pass boundary data with typo: "emial" instead of "email"
  const bad = json_parse("{\"name\":\"test\",\"emial\":\"foo@bar.com\"}")
  const result = try {
    process(bad)
  }
  harness.stdio.println(is_err(result))
  // The error should mention "email" as a suggestion
  const msg = unwrap_err(result)
  harness.stdio.println(contains(msg, "email"))
}
