/** Test flow-sensitive nil narrowing in both if branches */
pipeline test(harness: Harness, task) {
  fn check_neq(x: string?) -> string {
    if x != nil {
      return x
    }
    return "was nil"
  }
  fn check_eq(x: string?) -> string {
    if x == nil {
      return "was nil"
    }
    return x
  }
  fn check_truthiness(x: string?) -> string {
    if x {
      return x
    }
    return "falsy"
  }
  fn check_negation(x: string?) -> string {
    if !x {
      return "was nil"
    }
    return x
  }
  harness.stdio.println(check_neq("hello"))
  harness.stdio.println(check_neq(nil))
  harness.stdio.println(check_eq("world"))
  harness.stdio.println(check_eq(nil))
  harness.stdio.println(check_truthiness("yes"))
  harness.stdio.println(check_truthiness(nil))
  harness.stdio.println(check_negation(nil))
  harness.stdio.println(check_negation("no"))
}
