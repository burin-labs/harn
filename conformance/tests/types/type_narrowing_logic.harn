/** Test logical operator narrowing (&&, ||, !) */
pipeline test(harness: Harness, task) {
  fn and_check(x: string | int | nil) -> string {
    if x != nil && type_of(x) == "string" {
      return "string: ${x}"
    }
    return "other"
  }
  fn or_falsy(x: string?, y: int?) -> string {
    if x || y {
      return "at least one truthy"
    }
    // Both are nil in else path
    return "both nil"
  }
  harness.stdio.println(and_check("hello"))
  harness.stdio.println(and_check(42))
  harness.stdio.println(and_check(nil))
  harness.stdio.println(or_falsy("a", nil))
  harness.stdio.println(or_falsy(nil, 1))
  harness.stdio.println(or_falsy(nil, nil))
}
