// Verifies that std/json's merge/pick/omit preserve typing through generic
// projection. `merge` is row-polymorphic, so merging two record literals
// infers the precise merged shape (no explicit type arguments needed); `pick`
// and `omit` preserve the `dict<string, V>` value contract.
import { merge, omit, pick } from "std/json"

pipeline default(task) {
  const scores: dict<string, int> = {alice: 1, bob: 2}
  const bonus: dict<string, int> = {bob: 5, carol: 3}
  const combined: dict<string, int> = merge(scores, bonus)
  __io_println(combined.alice)
  __io_println(combined.bob)
  __io_println(combined.carol)
  const kept: dict<string, int> = pick(scores, ["alice"])
  __io_println(kept.alice)
  __io_println(contains(kept.keys(), "bob"))
  const dropped: dict<string, int> = omit(scores, ["bob"])
  __io_println(dropped.alice)
  __io_println(contains(dropped.keys(), "bob"))
  const extras = merge({region: "us"}, {tier: "gold"})
  __io_println(extras.region)
  __io_println(extras.tier)
}
