import "std/schema"

type Payload = {x: string}

pipeline test(task) {
  const dict_schema = {type: "dict", required: ["x"], properties: {x: {type: "string"}}}
  const checked = try {
    schema_check({x: "ok"}, dict_schema)
  }
  if is_ok(checked) {
    __io_println("OK " + json_stringify(unwrap(checked)))
  }
  const direct_checked = schema_check({x: "direct"}, dict_schema)
  __io_println(unwrap(direct_checked).x)
  const object_schema = {type: "object", required: ["x"], properties: {x: {type: "string"}}}
  __io_println(json_stringify(unwrap(schema_check({x: "object"}, object_schema))))
  const list_schema = {type: "list", items: {type: "int"}}
  const checked_list = unwrap(schema_check([1, 2, 3], list_schema))
  __io_println(json_stringify(checked_list))
  const default_schema = {
    type: "dict",
    required: ["name"],
    properties: {name: {type: "string"}, role: {type: "string", default: "user"}},
  }
  const parsed = unwrap(schema_parse({name: "Ada"}, default_schema))
  __io_println(parsed.name + ":" + parsed.role)
  const typed: Payload = unwrap(schema_check({x: "typed"}, schema_of(Payload)))
  __io_println(typed.x)
  const typed_checked: Result<Payload, string> = try {
    schema_check({x: "trytyped"}, schema_of(Payload))
  }
  __io_println(unwrap(typed_checked).x)
  const helper_value = get_typed_value({x: "helper"}, dict_schema)
  __io_println(helper_value.x)
  const failed = schema_check({x: 1}, dict_schema)
  __io_println(is_err(failed))
  __io_println(unwrap_err(failed).value.x)
}
