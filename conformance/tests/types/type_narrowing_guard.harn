/** Test guard statement narrowing applies to outer scope */
pipeline test(harness: Harness, task) {
  fn require_string(x: string?) -> string {
    guard x != nil else {
      return "missing"
    }
    // x is narrowed to string after guard
    return "got: ${x}"
  }
  fn require_typeof(x: string | int) -> string {
    guard type_of(x) == "string" else {
      return "not a string"
    }
    return "string: ${x}"
  }
  harness.stdio.println(require_string("hello"))
  harness.stdio.println(require_string(nil))
  harness.stdio.println(require_typeof("yes"))
  harness.stdio.println(require_typeof(42))
}
