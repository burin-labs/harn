fn main(harness: Harness) {
  const selected = pick(harness, ["env"])
  if true {
    const saved = selected
    const selected = saved
    const final_copy = selected
    assert_eq(final_copy.env.get_or("PICK_ALIAS_TEST_MISSING", "present"), "present")
  }
  harness.stdio.println("record pick: aliases keep the original field contract")
}
