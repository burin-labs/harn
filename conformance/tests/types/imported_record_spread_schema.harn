import { get_typed_report, schema_json } from "std/schema"
import { assert_error_contains } from "std/testing"
import { ImportedEnvelope, ImportedFields } from "../../fixtures/schema/imported_record_fields"

type Request = {label: string, ...ImportedFields}

type OpenRequest = {label: string, ...dict}

type GenericRequest = ImportedEnvelope<ImportedFields>

type GenericOpenRequest = ImportedEnvelope<dict>

fn accepts_request(_value: Request) -> bool {
  return true
}

fn accepts_generic(_value: GenericRequest) -> bool {
  return true
}

fn accepts_open(_value: GenericOpenRequest) -> bool {
  return true
}

fn main(harness: Harness) {
  const contract = schema_of(Request)
  const good = {label: "reached", max_tokens: 8, nested: {name: "actual"}}
  assert(get_typed_report(good, contract).ok)
  assert(accepts_request(good))
  assert(accepts_request(good + {max_tokens: nil}))
  assert(accepts_generic(good))
  assert(accepts_generic(good + {max_tokens: nil}))
  assert(accepts_open({label: "open", extension: {anything: true}}))
  harness.stdio.println("imported spread positive reached")
  for defaults in [false, true] {
    assert(
      !get_typed_report(good + {max_tokens: "invalid"}, contract, defaults).ok,
      "imported optional int must reject a string",
    )
    assert(!get_typed_report({label: "missing nested"}, contract, defaults).ok)
    assert(!get_typed_report(good + {nested: {name: 7}}, contract, defaults).ok)
    assert(get_typed_report(good + {max_tokens: nil}, contract, defaults).ok)
  }
  assert_error_contains(
    fn() { return accepts_request(
      json_parse("{\"label\":\"bad\",\"max_tokens\":\"invalid\",\"nested\":{\"name\":\"ok\"}}"),
    ) },
    "max_tokens",
  )
  for row in [
    {json: "{\"label\":\"missing nested\"}", field: "nested"},
    {
      json: "{\"label\":\"bad\",\"max_tokens\":\"invalid\",\"nested\":{\"name\":\"ok\"}}",
      field: "max_tokens",
    },
    {json: "{\"label\":\"bad\",\"nested\":{\"name\":7}}", field: "name"},
  ] {
    assert_error_contains(fn() { return accepts_generic(json_parse(row.json)) }, row.field)
  }
  assert_error_contains(fn() { return accepts_open(json_parse("{\"extension\":true}")) }, "label")
  const exported = schema_json(contract)
  assert(exported.allOf != nil, "imported fields must survive JSON Schema export")
  assert(get_typed_report(good, exported).ok)
  assert(!get_typed_report(good + {max_tokens: "invalid"}, exported).ok)
  assert(!get_typed_report(good + {nested: {name: 7}}, exported).ok)
  assert(get_typed_report({label: "open", extension: {anything: true}}, schema_of(OpenRequest)).ok)
  const generic = schema_of(GenericRequest)
  assert(get_typed_report(good, generic).ok)
  assert(!get_typed_report(good + {max_tokens: "invalid"}, generic).ok)
  assert(!get_typed_report({label: "missing nested"}, generic).ok)
  assert(!get_typed_report(good + {nested: {name: 7}}, generic).ok)
  assert(get_typed_report(good + {max_tokens: nil}, generic).ok)
  assert(!get_typed_report(good + {max_tokens: "invalid"}, schema_json(generic)).ok)
  const open = schema_of(GenericOpenRequest)
  assert(get_typed_report({label: "open", extension: {anything: true}}, open).ok)
  assert(!get_typed_report({extension: {anything: true}}, open).ok)
  assert(!get_typed_report({label: 7, extension: {anything: true}}, open).ok)
  harness.stdio.println("imported fields enforce validation and parameter constraints")
}
