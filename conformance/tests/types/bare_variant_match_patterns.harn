enum Shape {
  Circle(radius)
  Square(side)
}

fn describe(s: Shape) -> string {
  match s {
    Circle(r) -> { return "circle r=${r}" }
    Square(w) -> { return "square w=${w}" }
  }
}

fn half(v: int) -> Result<int, string> {
  if v % 2 == 0 {
    return Ok(v / 2)
  }
  return Err("odd: ${v}")
}

pipeline test(harness: Harness, task) {
  // Bare call-shaped variant patterns on the builtin Result enum.
  match half(10) {
    Ok(v) -> { harness.stdio.println("ok ${v}") }
    Err(e) -> { harness.stdio.println("err ${e}") }
  }
  match half(7) {
    Ok(v) -> { harness.stdio.println("ok ${v}") }
    Err(e) -> { harness.stdio.println("err ${e}") }
  }
  // Bare patterns on a user-declared enum, via a typed fn.
  harness.stdio.println(describe(Shape.Circle(2)))
  harness.stdio.println(describe(Shape.Square(3)))
  // Guards still apply to bare variant arms.
  match half(10) {
    Ok(v) if v > 100 -> { harness.stdio.println("big ${v}") }
    Ok(v) -> { harness.stdio.println("small ${v}") }
    Err(e) -> { harness.stdio.println("err ${e}") }
  }
  // A call-shaped pattern that is NOT a variant stays an
  // expression-equality pattern.
  fn code_red() -> int {
    return 3
  }
  match 3 {
    code_red() -> { harness.stdio.println("red") }
    _ -> { harness.stdio.println("other") }
  }
}
