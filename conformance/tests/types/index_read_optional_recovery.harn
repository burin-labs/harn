// Index reads are optional: `list[i]` / `dict[k]` yield `T | nil` because an
// out-of-bounds index or a missing key is `nil` at runtime (TypeScript's
// `noUncheckedIndexedAccess`). The `.first()` / `.last()` / `.find()` sequence
// accessors follow the same rule because an empty sequence has no element. This
// fixture exercises recovery with `?? default` and a `for` loop (which binds the
// element type directly, never optional).
pipeline main(harness: Harness) {
  const xs: list<int> = [10, 20, 30]
  // `?? default` recovers the element type on both a present and an absent index.
  const head: int = xs[0] ?? 0
  const past_end: int = xs[9] ?? -1
  harness.stdio.println("head " + to_string(head))
  harness.stdio.println("past_end " + to_string(past_end))
  // A `for` loop binds `int`, never `int?`, so the sum stays fully typed.
  let total = 0
  for x in xs {
    total = total + x
  }
  harness.stdio.println("total " + to_string(total))
  // `dict[k]` is `V | nil`; coalesce to recover the value type.
  const scores: dict<string, int> = {a: 1, b: 2}
  harness.stdio.println("a " + to_string(scores["a"] ?? 0))
  harness.stdio.println("z " + to_string(scores["z"] ?? 0))
}
