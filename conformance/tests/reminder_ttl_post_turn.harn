import { agent_session_apply_reminder_post_turn } from "std/agent/state"

pipeline main() {
  let topic = "transcript.reminder.lifecycle"
  let cursor = event_log.latest(topic)
  let session = agent_session_open("reminder-ttl-post-turn")
  agent_session_reset(session)
  agent_session_inject(session, transcript_reminder_event({body: "expire", ttl_turns: 1}))
  agent_session_inject(session, transcript_reminder_event({body: "stay", ttl_turns: 2}))
  let report = agent_session_apply_reminder_post_turn(session, 7)
  let reminders = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  let stream = event_log.subscribe({topic: topic, from_cursor: cursor})
  let logged = stream.next().value
  __io_println(report.expired_count)
  __io_println(report.decremented_count)
  __io_println(len(reminders))
  __io_println(reminders[0].reminder.body)
  __io_println(reminders[0].reminder.ttl_turns)
  __io_println(logged.kind)
  __io_println(logged.payload.reminder_id != "")
  __io_println(logged.payload.session_id == session)
  __io_println(logged.payload.agent_id == session)
  __io_println(logged.payload.task_id == nil)
  __io_println(logged.payload.reason)
  __io_println(logged.payload.ttl_turns_before)
  __io_println(logged.payload.expired_at_turn)
}
