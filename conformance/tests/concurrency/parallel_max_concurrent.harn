import { atomic_raise_max } from "../_common"

pipeline test(harness: Harness) {
  // Baseline: no `with { max_concurrent }` — existing behavior, all
  // tasks run concurrently. Each task returns its index.
  const nums = [0, 1, 2, 3, 4]
  const doubled = parallel each nums { n ->
    return n * 2
  }
  harness.stdio.println(doubled)
  // With a cap of 2: same result (order preserved), lower peak
  // in-flight count. We can't directly observe peak here but we can
  // assert ordering and total length.
  const capped = parallel each nums with { max_concurrent: 2 } { n ->
    return n + 10
  }
  harness.stdio.println(capped)
  // settle variant also accepts max_concurrent.
  const settled = parallel settle nums with { max_concurrent: 3 } { n ->
    return n
  }
  harness.stdio.println(settled.succeeded)
  harness.stdio.println(settled.failed)
  // count mode: `parallel N with { ... } { i -> ... }`.
  const counted = parallel 4 with { max_concurrent: 1 } { i ->
    return i
  }
  harness.stdio.println(counted)
  // Cap larger than the list — still runs correctly.
  const big_cap = parallel each nums with { max_concurrent: 999 } { n ->
    return n * 3
  }
  harness.stdio.println(big_cap)
  // Two admitted workers must overlap before either can finish.
  const in_flight = harness.runtime.atomic(0)
  const peak = harness.runtime.atomic(0)
  const admitted = harness.runtime.channel("admitted", 8)
  const release = harness.runtime.channel("release", 8)
  const coordinator = spawn {
    for _ in 0..4 {
      harness.runtime.receive(admitted)
      harness.runtime.receive(admitted)
      assert_eq(harness.runtime.atomic_get(in_flight), 2)
      harness.runtime.send(release, true)
      harness.runtime.send(release, true)
    }
  }
  const work = [1, 2, 3, 4, 5, 6, 7, 8]
  parallel each work with { max_concurrent: 2 } { _ ->
    const now = harness.runtime.atomic_add(in_flight, 1) + 1
    atomic_raise_max(harness.runtime, peak, now)
    harness.runtime.send(admitted, true)
    harness.runtime.receive(release)
    harness.runtime.atomic_add(in_flight, -1)
  }
  await(coordinator)
  harness.stdio.println(harness.runtime.atomic_get(peak) <= 2)
  harness.stdio.println(harness.runtime.atomic_get(peak) == 2)
}
