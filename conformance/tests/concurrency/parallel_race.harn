pipeline default(harness: Harness) {
  const finished = harness.runtime.atomic(0)
  fn racer(n: int) {
    if n == 5 {
      return Ok("fast")
    }
    harness.clock.sleep_ms(n)
    harness.runtime.atomic_set(finished, 1)
    return Ok("slow")
  }
  const winner = harness.runtime.parallel_race([50, 5], racer)
  harness.stdio.println(winner)
  harness.clock.sleep_ms(80)
  harness.stdio.println(harness.runtime.atomic_get(finished))
  fn failer(n: int) {
    return Err(n)
  }
  try {
    harness.runtime.parallel_race([1, 2], failer)
  } catch (e) {
    harness.stdio.println("all failed")
  }
}
