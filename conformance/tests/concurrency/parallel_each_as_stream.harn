pipeline default(harness: Harness) {
  const gate = harness.runtime.atomic(0)
  const results = parallel each [30, 5, 10] with { max_concurrent: 2 } { n ->
    if n == 30 {
      while harness.runtime.atomic_get(gate) < 2 {
        harness.runtime.yield_now()
      }
    }
    if n == 5 {
      harness.runtime.atomic_set(gate, 1)
    }
    if n == 10 {
      while harness.runtime.atomic_get(gate) < 1 {
        harness.runtime.yield_now()
      }
      harness.runtime.atomic_set(gate, 2)
    }
    return n
  } as stream
  harness.stdio.println(type_of(results))
  for result in results {
    harness.stdio.println(result)
  }
}
