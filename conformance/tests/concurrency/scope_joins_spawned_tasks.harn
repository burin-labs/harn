pipeline test(harness: Harness, task: unknown) {
  const counter = harness.runtime.atomic(0)
  // The `scope { }` nursery joins every task spawned inside it before the
  // block exits, so both increments are observable afterwards.
  scope {
    spawn {
      harness.runtime.atomic_add(counter, 1)
    }
    spawn {
      harness.runtime.atomic_add(counter, 1)
    }
  }
  harness.stdio.println(harness.runtime.atomic_get(counter))
}
