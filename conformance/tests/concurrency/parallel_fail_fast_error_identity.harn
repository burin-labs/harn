pipeline test(task) {
  // The propagated error is deterministic: branch 0 fails immediately while
  // branch 1 is still sleeping, so branch 0's error is the one reported —
  // the first failure in source order among branches that actually failed.
  // The sleeping sibling is aborted and its error never surfaces.
  parallel each [0, 1] { n ->
    if n == 0 {
      throw "branch zero failed"
    }
    sleep(250)
    throw "branch one failed"
  }
}
