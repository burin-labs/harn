pipeline default() {
  // Create a real atomic
  let counter = atomic(0)
  __io_println(type_of(counter))
  // Basic get/set
  __io_println(atomic_get(counter))
  atomic_set(counter, 10)
  __io_println(atomic_get(counter))
  // Atomic add
  atomic_add(counter, 5)
  __io_println(atomic_get(counter))
  // Compare and swap
  let success = atomic_cas(counter, 15, 20)
  __io_println(success)
  __io_println(atomic_get(counter))
  let fail = atomic_cas(counter, 15, 30)
  __io_println(fail)
  __io_println(atomic_get(counter))
  // Concurrent atomic increments
  let a = atomic(0)
  parallel 10 { i ->
    atomic_add(a, 1)
  }
  __io_println(atomic_get(a))
}
