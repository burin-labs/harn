// The three automatic-abort policies of `settle_with_abort`, all pinned to
// `max_concurrent: 1` so the schedule is exact:
//   - `max_failures` trips the token after that many failures;
//   - `abort_on` decides which failures count, so a transient error can be
//     collected while a terminal one stops the run;
//   - neither option means the form behaves exactly like `parallel settle`.
import { settle_with_abort } from "std/abort"

pipeline default(harness: Harness) {
  const threshold = settle_with_abort(
    harness.random,
    harness.runtime,
    [1, 2, 3, 4],
    { item ->
      if item == 2 {
        throw "boom"
      }
      return item
    },
    {max_concurrent: 1, max_failures: 1},
  )
  harness.stdio.println(threshold.succeeded)
  harness.stdio.println(threshold.failed)
  harness.stdio.println(threshold.abandoned)
  harness.stdio.println(to_string(threshold.aborted))
  const selective = settle_with_abort(
    harness.random,
    harness.runtime,
    [1, 2, 3, 4],
    { item ->
      if item <= 2 {
        return Err({code: "network", message: "blip"})
      }
      if item == 3 {
        return Err({code: "terminal", message: "hard"})
      }
      return item
    },
    {
      max_concurrent: 1,
      abort_on: fn(err, _index) {
        if err?.code == "terminal" {
          return {code: "terminal", message: "decisive failure"}
        }
        return nil
      },
    },
  )
  harness.stdio.println(selective.succeeded)
  harness.stdio.println(selective.failed)
  harness.stdio.println(selective.abandoned)
  harness.stdio.println(to_string(selective.aborted))
  harness.stdio.println(selective.reason?.code)
  const collect = settle_with_abort(
    harness.random,
    harness.runtime,
    [1, 2, 3],
    { item ->
      if item == 2 {
        throw "boom"
      }
      return item
    },
  )
  harness.stdio.println(collect.succeeded)
  harness.stdio.println(collect.failed)
  harness.stdio.println(collect.abandoned)
  harness.stdio.println(to_string(collect.aborted))
}
