pipeline test(task) {
  const held = sync_semaphore_acquire("pool", 1, 1)
  const timed_out = sync_semaphore_acquire("pool", 1, 1, 0)
  __io_println(timed_out == nil)
  __io_println(sync_release(held))
  const reacquired = sync_semaphore_acquire("pool", 1, 1, 0)
  __io_println(reacquired != nil)
  sync_release(reacquired)
}
