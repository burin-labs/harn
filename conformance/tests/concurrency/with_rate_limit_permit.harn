import { llm_text, with_llm_script } from "std/testing"

/**
 * with_rate_limit acquires a sliding-window permit for the provider and
 * invokes the closure. With a high RPM limit, successive calls return
 * immediately.
 */
pipeline default(harness: Harness, task) {
  harness.llm.rate_limit("mock", {rpm: 1000})
  with_llm_script(
    harness.llm, [llm_text("one"), llm_text("two")],
    { ->
      const a = harness.llm.with_rate_limit(
        "mock",
        fn() { harness.llm.call("hello", nil, {provider: "mock"}) },
      )
      const b = harness.llm.with_rate_limit(
        "mock",
        fn() { harness.llm.call("hello", nil, {provider: "mock"}) },
      )
      harness.stdio.println(a.text)
      harness.stdio.println(b.text)
      harness.llm.rate_limit("mock", {rpm: 0})
    },
  )
}
// Clear the rate limit so other tests aren't affected by it.
