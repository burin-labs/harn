pipeline default() {
  const drained = atomic(0)
  const sup = supervisor_start(
    {
      name: "persona",
      strategy: "one_for_one",
      children: [
        {
          name: "continuous-persona",
          kind: "persona_loop",
          restart: "never",
          task: { _ctx ->
            while !is_cancelled() {
              try {
                sleep(1ms)
              } catch (_e) {
                nil
              }
            }
            atomic_set(drained, 1)
            "drained"
          },
        },
      ],
    },
  )
  sleep(1ms)
  const stopped = supervisor_stop(sup, 50ms)
  __io_println(stopped.status)
  __io_println(stopped.children[0].status)
  __io_println(atomic_get(drained))
}
