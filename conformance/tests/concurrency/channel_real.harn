pipeline default(harness: Harness) {
  // Create a real channel
  const ch = harness.runtime.channel("test", 10)
  harness.stdio.println(type_of(ch))
  // Send and receive
  const t = spawn {
    harness.runtime.send(ch, "hello")
    harness.runtime.send(ch, "world")
    harness.runtime.send(ch, 42)
  }
  await(t)
  const v1 = harness.runtime.receive(ch)
  const v2 = harness.runtime.receive(ch)
  const v3 = harness.runtime.receive(ch)
  harness.stdio.println(v1)
  harness.stdio.println(v2)
  harness.stdio.println(v3)
}
