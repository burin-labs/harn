pipeline default(harness: Harness) {
  harness.testing.clock_set(1700000000000)
  const starts = harness.runtime.atomic(0)
  const sup = harness.runtime.supervisor_start(
    {
      name: "circuit",
      strategy: "one_for_one",
      children: [
        {
          name: "probe",
          kind: "workflow_runner",
          restart: {mode: "on_failure", max_restarts: 0, backoff_ms: 1, circuit_open_ms: 60000},
          task: { _ctx ->
            let attempt = harness.runtime.atomic_add(starts, 1) + 1
            if attempt == 1 {
              throw "open-circuit"
            }
            "half-open-success"
          },
        },
      ],
    },
  )
  while harness.runtime.supervisor_state(sup).children[0].status != "circuit_open" {
    harness.runtime.yield_now()
  }
  harness.stdio.println(harness.clock.now_ms())
  harness.stdio.println(harness.runtime.supervisor_state(sup).children[0].next_restart_time)
  harness.testing.clock_advance(60000)
  const state = harness.runtime.supervisor_wait(sup)
  harness.stdio.println(harness.runtime.atomic_get(starts))
  harness.stdio.println(state.children[0].status)
  harness.stdio.println(state.metrics.failed)
  harness.stdio.println(state.metrics.suppressed)
  harness.testing.clock_reset()
}
