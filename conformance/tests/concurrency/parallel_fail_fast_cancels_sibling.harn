pipeline test(harness: Harness, task: unknown) {
  // `parallel` is fail-fast: the first branch error aborts in-flight
  // siblings, so the slow branch never reaches its atomic_set. Use
  // `parallel settle` when every branch must run regardless of failures.
  const survived = harness.runtime.atomic(0)
  const sibling_started = harness.runtime.atomic(0)
  const blocked = harness.runtime.channel("blocked-sibling", 1)
  try {
    parallel 2 { i ->
      if i == 0 {
        while harness.runtime.atomic_get(sibling_started) == 0 {
          harness.runtime.yield_now()
        }
        throw "boom"
      }
      harness.runtime.atomic_set(sibling_started, 1)
      // The handshake makes this an in-flight sibling before the error. The
      // receive is a cancellation point with no sender that could release it.
      harness.runtime.receive(blocked)
      harness.runtime.atomic_set(survived, 1)
      i
    }
  } catch (e) {
    harness.stdio.log("caught: " + e)
  }
  // An uncancelled sibling would keep `parallel` blocked on its receive.
  harness.stdio.println(harness.runtime.atomic_get(survived))
}
