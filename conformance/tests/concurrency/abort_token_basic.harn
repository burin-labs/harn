// A cooperative-abort token is first-writer-wins, so the reported cause is
// stable no matter how many branches trip it at once. Tokens minted without
// an explicit key are independent of each other.
import { abort_reason, abort_requested, abort_token, request_abort } from "std/abort"

pipeline default(harness: Harness) {
  const token = abort_token(harness)
  harness.stdio.println(to_string(abort_requested(harness, token)))
  harness.stdio.println(to_string(abort_reason(harness, token)))
  harness.stdio.println(
    to_string(request_abort(harness, token, {code: "first", message: "won the race"})),
  )
  harness.stdio.println(
    to_string(request_abort(harness, token, {code: "second", message: "lost the race"})),
  )
  harness.stdio.println(to_string(abort_requested(harness, token)))
  harness.stdio.println(abort_reason(harness, token)?.code)
  harness.stdio.println(abort_reason(harness, token)?.message)
  const other = abort_token(harness)
  harness.stdio.println(to_string(abort_requested(harness, other)))
}
