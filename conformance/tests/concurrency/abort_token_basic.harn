// A cooperative-abort token is first-writer-wins, so the reported cause is
// stable no matter how many branches trip it at once. Tokens minted without
// an explicit key are independent of each other.
import { abort_reason, abort_requested, abort_token, request_abort } from "std/abort"

pipeline default(harness: Harness) {
  const token = abort_token(harness)
  harness.stdio.println(to_string(abort_requested(token)))
  harness.stdio.println(to_string(abort_reason(token)))
  harness.stdio.println(to_string(request_abort(token, {code: "first", message: "won the race"})))
  harness.stdio.println(to_string(request_abort(token, {code: "second", message: "lost the race"})))
  harness.stdio.println(to_string(abort_requested(token)))
  harness.stdio.println(abort_reason(token)?.code)
  harness.stdio.println(abort_reason(token)?.message)
  const other = abort_token(harness)
  harness.stdio.println(to_string(abort_requested(other)))
}
