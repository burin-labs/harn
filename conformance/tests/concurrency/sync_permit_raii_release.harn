fn escaped_lock(runtime: HarnessRuntime) {
  return runtime.sync_mutex_acquire("raii-return")
}

pipeline test(harness: Harness, task: unknown) {
  const escaped = escaped_lock(harness.runtime)
  const reacquired = harness.runtime.sync_mutex_acquire("raii-return", 0)
  harness.stdio.println(reacquired != nil)
  harness.stdio.println(harness.runtime.sync_release(escaped))
  harness.stdio.println(harness.runtime.sync_release(reacquired))
}
