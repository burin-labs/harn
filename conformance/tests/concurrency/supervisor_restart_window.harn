pipeline default() {
  let starts = atomic(0)
  let sup = supervisor_start(
    {
      name: "windowed",
      strategy: "one_for_one",
      children: [
        {
          name: "windowed-worker",
          kind: "workflow_runner",
          restart: {mode: "on_failure", max_restarts: 1, window_ms: 1, backoff_ms: 5},
          task: { _ctx ->
            let attempt = atomic_add(starts, 1) + 1
            if attempt < 3 {
              throw "transient"
            }
            "recovered-after-window"
          },
        },
      ],
    },
  )
  var state = supervisor_state(sup)
  let deadline_ms = timestamp() * 1000 + 250
  while state.status != "completed" && timestamp() * 1000 < deadline_ms {
    sleep(5ms)
    state = supervisor_state(sup)
  }
  __io_println(atomic_get(starts))
  __io_println(state.status)
  __io_println(state.children[0].status)
  __io_println(state.children[0].restart_count)
  __io_println(state.metrics.failed)
  __io_println(state.metrics.restarted)
  __io_println(state.metrics.suppressed)
}
