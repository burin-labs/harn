import { elapsed_ms, end_timing, start_timing, timing_event } from "std/timing"

pipeline default() {
  const handle = start_timing("provider.preflight", {provider: "ollama"})
  timing_event(handle, "credentials.checked", {available: true})
  timing_event(handle, "model.warm", {cache: "hit"})
  // elapsed_ms returns monotonic time without closing the span
  __io_println(elapsed_ms(handle) >= 0)
  const timing = end_timing(handle, {status: "ok", extra: "trace"})
  __io_println(timing.name)
  __io_println(timing.status)
  __io_println(timing.attributes.provider)
  __io_println(timing.attributes.extra)
  __io_println(len(timing.events))
  __io_println(timing.events[0].name)
  __io_println(timing.events[1].name)
  // Duplicate close is idempotent — returns the same segment.
  const again = end_timing(handle)
  __io_println(again.span_id == timing.span_id)
  __io_println(again.duration_ms == timing.duration_ms)
}
