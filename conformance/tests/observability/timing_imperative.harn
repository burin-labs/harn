import { elapsed_ms, end_timing, start_timing, timing_event } from "std/timing"

pipeline default(harness: Harness) {
  const handle = start_timing(harness, "provider.preflight", {provider: "ollama"})
  timing_event(harness, handle, "credentials.checked", {available: true})
  timing_event(harness, handle, "model.warm", {cache: "hit"})
  // elapsed_ms returns monotonic time without closing the span
  harness.stdio.println(elapsed_ms(harness, handle) >= 0)
  const timing = end_timing(harness, handle, {status: "ok", extra: "trace"})
  harness.stdio.println(timing.name)
  harness.stdio.println(timing.status)
  harness.stdio.println(timing.attributes.provider)
  harness.stdio.println(timing.attributes.extra)
  harness.stdio.println(len(timing.events))
  harness.stdio.println(timing.events[0].name)
  harness.stdio.println(timing.events[1].name)
  // Duplicate close is idempotent — returns the same segment.
  const again = end_timing(harness, handle)
  harness.stdio.println(again.span_id == timing.span_id)
  harness.stdio.println(again.duration_ms == timing.duration_ms)
}
