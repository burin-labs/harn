import { timed } from "std/timing"

pipeline default() {
  const outcome = timed("work.compute", {phase: "warmup"}, { -> return 42 })
  __io_println(outcome.result)
  __io_println(outcome.timing.name)
  __io_println(outcome.timing.kind)
  __io_println(outcome.timing.status)
  __io_println(outcome.timing.duration_ms >= 0)
  __io_println(outcome.timing.attributes.phase)
}
