import { timed } from "std/timing"

pipeline default(harness: Harness) {
  harness.obs.enable_tracing(true)
  const result = timed(
    harness.clock,
    "outer",
    {},
    { -> return timed(harness.clock, "inner", {}, { -> return "done" }) },
  )
  harness.stdio.println(result.result.result)
  harness.stdio.println(result.timing.span_id != result.result.timing.span_id)
  harness.stdio.println(result.result.timing.parent_span_id == result.timing.span_id)
  const user_timing_spans = harness.obs.trace_spans().filter({ s -> s.kind == "user_timing" })
    .to_list()
  harness.stdio.println(len(user_timing_spans))
}
