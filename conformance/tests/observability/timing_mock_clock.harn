import { timed } from "std/timing"

pipeline default() {
  // Pin the wall clock so wall-start aligns with our fixture.
  mock_time(1700000000000)
  const outcome = timed(
    "clocked",
    {tier: "test"},
    { ->
      advance_time(250)
      return "ok"
    },
  )
  __io_println(outcome.result)
  __io_println(outcome.timing.started_at_ms)
  __io_println(outcome.timing.attributes.tier)
  // Duration is monotonic-derived; advance_time also advances monotonic.
  __io_println(outcome.timing.duration_ms >= 250)
  unmock_time()
}
