import { end_timing, timing_event } from "std/timing"

pipeline default(harness: Harness) {
  let raised = nil
  try {
    end_timing(harness, {span_id: 9999})
  } catch (e) {
    raised = e
  }
  harness.stdio.println(raised != nil)
  // Unknown handles record no events without throwing.
  harness.stdio.println(timing_event(harness, {span_id: 9999}, "ghost"))
}
