import { obs } from "std/observability"

pipeline default() {
  const o = obs()
  o.reset()
  o.configure(
    {
      backend: o.Backend.compose(
        [o.Backend.otel("http://collector.example"), o.Backend.honeycomb("key", "dataset")],
      ),
    },
  )
  o.log("fanout", "info", {component: "compose"})
  const emitted = o.events_take()
  __io_println(len(emitted))
  __io_println(emitted[0].backend)
  __io_println(emitted[1].backend)
  __io_println(emitted[1].payload.component)
}
