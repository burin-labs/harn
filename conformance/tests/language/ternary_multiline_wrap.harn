/**
 * Multi-line ternary forms — exempt from `fmt --check` so the wrapped layout
 * stays in source. The formatter does not yet wrap long ternaries, but the
 * parser must accept either operator-leading or operator-trailing wrap shapes.
 */
pipeline default() {
  let cond = true
  let a = cond ? "yes this is a long enough true branch to force wrapping in the formatter" : "no this is the long false branch text that also forces a multi-line layout"
  println(a)
  let b = cond ? "yes this is a long enough true branch to force wrapping in the formatter" : "no this is the long false branch text that also forces a multi-line layout"
  println(b)
  let c = cond ? false ? "this nested true-true arm is also intentionally long enough to wrap" : "this nested true-false arm is also intentionally long enough to wrap" : "this outer-false arm is also intentionally long enough to wrap nicely"
  println(c)
  // Confirm `?` is still postfix when not followed by a ternary branch.
  let xs = [1, 2, 3]
  println(xs[0])
}
