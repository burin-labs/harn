pipeline test(harness: Harness, task: unknown) {
  // Spread in method calls: obj.method(...args) should work
  struct Calculator {
    base: int
  }
  impl Calculator {
    fn add(self, a: any, b: any) {
      return self.base + a + b
    }
    fn sum_three(self, x: any, y: any, z: any) {
      return self.base + x + y + z
    }
  }
  const calc = Calculator({base: 100})
  const args = [1, 2]
  harness.stdio.log(calc.add(...args))
  const more = [10, 20, 30]
  harness.stdio.log(calc.sum_three(...more))
  // Mixed: regular args + spread
  const pair = [5]
  harness.stdio.log(calc.add(3, ...pair))
}
