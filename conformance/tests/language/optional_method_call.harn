pipeline default(harness: Harness) {
  // Optional method call on nil returns nil
  const x = nil
  harness.stdio.println(x?.split(","))
  harness.stdio.println(x?.contains("a"))
  // Optional method call on non-nil works normally
  const s = "hello world"
  harness.stdio.println(s.split(" "))
  harness.stdio.println(s.contains("world"))
  // Chained optional method call
  const d = nil
  harness.stdio.println(d?.keys())
  // Optional method call on list
  const items = [3, 1, 2]
  harness.stdio.println(items.map({ v -> v }))
  // Optional method call on dict
  const m = {a: 1, b: 2}
  harness.stdio.println(m.keys())
}
