pipeline default() {
  // Optional method call on nil returns nil
  let x = nil
  __io_println(x?.split(","))
  __io_println(x?.contains("a"))
  // Optional method call on non-nil works normally
  let s = "hello world"
  __io_println(s.split(" "))
  __io_println(s.contains("world"))
  // Chained optional method call
  let d = nil
  __io_println(d?.keys())
  // Optional method call on list
  let items = [3, 1, 2]
  __io_println(items.map({ v -> v }))
  // Optional method call on dict
  let m = {a: 1, b: 2}
  __io_println(m.keys())
}
