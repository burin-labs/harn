pipeline test(harness: Harness, task: unknown) {
  fn add(a: any, b: any, c: any) {
    return a + b + c
  }
  // Spread all args
  const args = [1, 2, 3]
  harness.stdio.log(add(...args))
  // Mixed: positional + spread
  harness.stdio.log(add(10, ...[20, 30]))
  // Spread in builtin calls
  const items = ["hello", " ", "world"]
  harness.stdio.log(join(items, ""))
  // Spread with a variable holding a list
  fn sum4(a: any, b: any, c: any, d: any) {
    return a + b + c + d
  }
  const first = [100, 200]
  const second = [300, 400]
  harness.stdio.log(sum4(...first, ...second))
}
