pipeline test(harness: Harness, task) {
  // int vs float comparison
  harness.stdio.println(3 < 3.5)
  harness.stdio.println(3.5 > 3)
  harness.stdio.println(3 <= 3.0)
  harness.stdio.println(3.0 >= 3)
  harness.stdio.println(3 == 3.0)
  harness.stdio.println(3 != 3.1)
  harness.stdio.println(2.0 < 3)
  harness.stdio.println(5 > 4.9)
}
