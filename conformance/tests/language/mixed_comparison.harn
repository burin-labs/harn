pipeline test(harness: Harness, task) {
  // int vs float comparison
  harness.stdio.log(3 < 3.5)
  harness.stdio.log(3.5 > 3)
  harness.stdio.log(3 <= 3.0)
  harness.stdio.log(3.0 >= 3)
  harness.stdio.log(3 == 3.0)
  harness.stdio.log(3 != 3.1)
  harness.stdio.log(2.0 < 3)
  harness.stdio.log(5 > 4.9)
}
