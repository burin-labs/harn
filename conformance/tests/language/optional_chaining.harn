pipeline default() {
  // Optional chaining on nil returns nil
  const x = nil
  __io_println(x?.count)
  __io_println(x?.name)
  // Optional chaining on non-nil works normally
  const d = {name: "Alice", age: 30}
  __io_println(d.name)
  __io_println(d.age)
  // Chained optional access
  const nested = {inner: {value: 42}}
  __io_println(nested.inner.value)
  // Optional on list
  const items = [1, 2, 3]
  __io_println(items.count)
  __io_println(items.first)
  // Nil propagation through chain
  const empty = nil
  __io_println(empty?.inner?.value)
  // Optional chaining on non-dict types returns nil for unknown props
  const n = 42
  __io_println(n?.foo)
  const s = "hello"
  __io_println(s.count)
  __io_println(s?.foo)
}
