/**
 * Domain words such as `to`, `from`, `tool`, `select`, and `require` are
 * ordinary identifiers outside the construct they introduce.
 */
pipeline test(harness: Harness, task: unknown) {
  let to = 1
  let select = 2
  let from = to + select
  let tool = {name: "lookup"}
  let exclusive = true
  let deadline = 3
  let emit = [deadline]
  harness.stdio.log(from)
  harness.stdio.log(tool.name)
  harness.stdio.log(exclusive)
  harness.stdio.log(emit)
  require from == 3, "require still introduces an assertion"
  deadline 5s {
    harness.stdio.log("deadline block")
  }
  to = to + 1
  harness.stdio.log(to)
}
