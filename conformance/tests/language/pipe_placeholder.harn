pipeline default() {
  // Basic pipe placeholder
  const result = "hello world" |> split(_, " ")
  __io_println(result)
  // Chained with placeholder
  const n = "hello world"
    |> split(_, " ")
    |> len(_)
  __io_println(n)
  // Placeholder in second arg
  const msg = "world" |> replace("hello _", "_", _)
  __io_println(msg)
  // Placeholder with method call
  const nums = [3, 1, 2] |> _.sort()
  __io_println(nums)
}
