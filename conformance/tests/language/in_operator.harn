pipeline default(harness: Harness, task: unknown) {
  // List membership
  const items = [1, 2, 3, 4, 5]
  harness.stdio.println(3 in items)
  harness.stdio.println(6 in items)
  harness.stdio.println(6 not in items)
  harness.stdio.println(3 not in items)
  // String containment
  const msg = "hello world"
  harness.stdio.println("world" in msg)
  harness.stdio.println("xyz" in msg)
  harness.stdio.println("xyz" not in msg)
  // Dict key membership
  const data = {name: "Alice", age: 30}
  harness.stdio.println("name" in data)
  harness.stdio.println("email" in data)
  harness.stdio.println("email" not in data)
  // Set membership
  const s = set(1, 2, 3)
  harness.stdio.println(2 in s)
  harness.stdio.println(5 in s)
}
