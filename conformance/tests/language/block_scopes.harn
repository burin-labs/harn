pipeline default() {
  let outer = "outer"
  if true {
    let branch = "if-branch"
    __io_println(branch)
  } else {
    let branch = "else-branch"
    __io_println(branch)
  }
  for item in [1, 2] {
    let loop_label = "loop-${item}"
    __io_println(loop_label)
  }
  try {
    throw "boom"
  } catch (err) {
    __io_println(err)
  }
  __io_println(outer)
}
