pipeline default(harness: Harness) {
  const outer = "outer"
  if true {
    const branch = "if-branch"
    harness.stdio.println(branch)
  } else {
    const branch = "else-branch"
    harness.stdio.println(branch)
  }
  for item in [1, 2] {
    const loop_label = "loop-${item}"
    harness.stdio.println(loop_label)
  }
  try {
    throw "boom"
  } catch (err) {
    harness.stdio.println(err)
  }
  harness.stdio.println(outer)
}
