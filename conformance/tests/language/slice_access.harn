pipeline default(harness: Harness) {
  const items = [10, 20, 30, 40, 50]
  harness.stdio.println(items[1:3])
  harness.stdio.println(items[:2])
  harness.stdio.println(items[3:])
  harness.stdio.println(items[-2:])
  const s = "hello world"
  harness.stdio.println(s[0:5])
  harness.stdio.println(s[6:])
  harness.stdio.println(s[-5:])
}
