/**
 * Copy-returning methods are pure: `sorted` returns a new list rather than
 * modifying the receiver (that is `sort`). Calling one as a statement and
 * dropping the result is therefore a silent no-op, which HARN-LNT-066 rejects.
 */
pipeline main(harness: Harness, task: unknown) {
  const l = [2, 1]
  l.sorted()
}
