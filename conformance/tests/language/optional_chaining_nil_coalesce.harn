pipeline test(harness: Harness, task) {
  // Optional chaining with nil coalescing
  const obj = {name: "Alice", age: 30}
  harness.stdio.println(obj.name ?? "unknown")
  harness.stdio.println(obj?.missing ?? "default")
  // Chained operations
  const nested = {inner: {value: 42}}
  harness.stdio.println(nested.inner.value ?? 0)
  harness.stdio.println(nested?.nonexistent?.value ?? 0)
  // Nil coalescing with nil
  const x = nil
  harness.stdio.println(x ?? "fallback")
  type Doc = {components: {schemas: dict<int>?}?}
  const doc: Doc = {components: nil}
  harness.stdio.println(len(doc.components?.schemas))
  harness.stdio.println(len(doc.components?.schemas ?? {}))
  for entry in doc.components?.schemas {
    harness.stdio.println(entry.key)
  }
}
