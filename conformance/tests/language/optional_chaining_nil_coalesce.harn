pipeline test(harness: Harness, task: unknown) {
  // Optional chaining with nil coalescing
  const obj = {name: "Alice", age: 30}
  harness.stdio.log(obj.name ?? "unknown")
  harness.stdio.log(obj?.missing ?? "default")
  // Chained operations
  const nested = {inner: {value: 42}}
  harness.stdio.log(nested.inner.value ?? 0)
  harness.stdio.log(nested?.nonexistent?.value ?? 0)
  // Nil coalescing with nil
  const x = nil
  harness.stdio.log(x ?? "fallback")
  type Doc = {components: {schemas: dict<int>?}?}
  const doc: Doc = {components: nil}
  harness.stdio.log(len(doc.components?.schemas))
  harness.stdio.log(len(doc.components?.schemas ?? {}))
  for entry in doc.components?.schemas {
    harness.stdio.log(entry.key)
  }
}
