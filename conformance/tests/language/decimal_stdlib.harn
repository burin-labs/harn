pipeline test(harness: Harness, task) {
  // Decimal flows through min/max/sign/round exactly (was silently nil).
  harness.stdio.println(min(decimal("19.99"), decimal("9.99")))
  harness.stdio.println(max(decimal("19.99"), decimal("9.99")))
  harness.stdio.println(sign(decimal("-2.5")))
  harness.stdio.println(sign(decimal("0")))
  harness.stdio.println(sign(decimal("4.2")))
  harness.stdio.println(round(decimal("2.4")))
  // sum() accumulates decimals exactly, promoting int operands.
  harness.stdio.println([decimal("1.50"), decimal("2.50"), decimal("0.99")].sum())
  harness.stdio.println([decimal("10"), 5, decimal("0.50")].sum())
}
