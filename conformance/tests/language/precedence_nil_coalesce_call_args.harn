fn show_three(harness: Harness, a, b, c) {
  harness.stdio.log("a=" + a)
  harness.stdio.log("b=" + b)
  harness.stdio.log("c=" + c)
}

fn tag_for(path) {
  return "tag:" + path
}

pipeline test(harness: Harness, task) {
  const base = "base"
  const path = nil
  show_three(harness, base, path ?? "", tag_for(path ?? ""))
}
