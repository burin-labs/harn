fn last_word(text) {
  return text |> split(_, " ") |> _.last()
}

pipeline default() {
  fn add1(x) {
    return x + 1
  }
  fn double(x) {
    return x * 2
  }
  __io_println(3 |> add1 |> double)
  __io_println("hello world" |> split(_, " ") |> len(_))
  __io_println([3, 1, 2] |> _.sorted())
  const payload = [1, 2, 3] |> {items: _, count: len(_)}
  __io_println(payload.count)
  __io_println(payload.items)
  __io_println({user: {name: "Ada"}} |> _.user?.name)
  __io_println({items: [10, 20]} |> _.items?.[0])
  __io_println(" hi " |> _?.trim())
  __io_println([1, 2, 3, 4] |> _[1:3])
  __io_println(3 |> _ > 2 ? "big" : "small")
  __io_println([1, 2] |> _.map({ x -> x + 1 }))
  __io_println(last_word("hello harn"))
}
