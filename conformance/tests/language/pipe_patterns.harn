fn last_word(text) {
  return text |> split(_, " ") |> _.last()
}

pipeline default(harness: Harness) {
  fn add1(x) {
    return x + 1
  }
  fn double(x) {
    return x * 2
  }
  harness.stdio.println(3 |> add1 |> double)
  harness.stdio.println("hello world" |> split(_, " ") |> len(_))
  harness.stdio.println([3, 1, 2] |> _.sorted())
  const payload = [1, 2, 3] |> {items: _, count: len(_)}
  harness.stdio.println(payload.count)
  harness.stdio.println(payload.items)
  harness.stdio.println({user: {name: "Ada"}} |> _.user?.name)
  harness.stdio.println({items: [10, 20]} |> _.items?.[0])
  harness.stdio.println(" hi " |> _?.trim())
  harness.stdio.println([1, 2, 3, 4] |> _[1:3])
  harness.stdio.println(3 |> (_ > 2 ? "big" : "small"))
  harness.stdio.println([1, 2] |> _.map({ x -> x + 1 }))
  harness.stdio.println(last_word("hello harn"))
}
