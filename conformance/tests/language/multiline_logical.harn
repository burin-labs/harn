pipeline default() {
  // Multiline || should work
  const a = true
  __io_println(a)
  // Multiline && should work
  const b = false
  __io_println(b)
  // Mixed multiline
  const c = false || (true
    && true)
  __io_println(c)
  // Multiline + should work
  const d = "hello"
    + " "
    + "world"
  __io_println(d)
  // Multiline method chaining
  const e = [1, 2, 3, 4, 5]
    .filter({ x -> x > 2 })
    .map({ x -> x * 10 })
  __io_println(e)
  // Multiline |> pipe
  const f = "hello world"
    |> { s -> split(s, " ") }
    |> { parts -> len(parts) }
  __io_println(f)
}
