pipeline test(harness: Harness, task: unknown) {
  // Exactness: the canonical float-rounding counterexample.
  harness.stdio.log(decimal("0.1") + decimal("0.2"))
  // Scale is preserved through addition/subtraction.
  harness.stdio.log(decimal("1.10") + decimal("2.20"))
  harness.stdio.log(decimal("5.00") - decimal("1.50"))
  // Multiplication and division.
  harness.stdio.log(decimal("1.5") * decimal("4"))
  harness.stdio.log(decimal("7") / decimal("2"))
  harness.stdio.log(decimal("7") % decimal("3"))
  // Int promotes into decimal arithmetic (exact, ergonomic).
  harness.stdio.log(decimal("2.50") * 3)
  harness.stdio.log(decimal("10") + 5)
  harness.stdio.log(-decimal("4.25"))
  // Equality ignores scale, but decimal is a distinct type from int/float.
  harness.stdio.log(decimal("1.50") == decimal("1.5"))
  harness.stdio.log(decimal("1") == 1)
  // Ordering.
  harness.stdio.log(decimal("9.99") < decimal("10"))
  harness.stdio.log(decimal("10.00") >= decimal("10"))
  // Reflection + conversions.
  harness.stdio.log(type_of(decimal("3")))
  harness.stdio.log(to_int(decimal("3.9")))
  harness.stdio.log(to_string(decimal("42.50")))
  // Construction from int and from a decimal (identity).
  harness.stdio.log(decimal(7) + decimal("0.5"))
}
