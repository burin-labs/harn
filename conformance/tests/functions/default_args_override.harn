pipeline test(harness: Harness, task: unknown) {
  fn make_config(host: string = "localhost", port: int = 8080, debug: bool = false) {
    return "${host}:${port} debug=${debug}"
  }
  harness.stdio.log(make_config())
  harness.stdio.log(make_config("example.com"))
  harness.stdio.log(make_config("example.com", 3000))
  harness.stdio.log(make_config("example.com", 3000, true))
}
