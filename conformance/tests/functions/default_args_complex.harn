pipeline test(harness: Harness, task: unknown) {
  fn process(items: list = [1, 2, 3]) {
    return items.map({ x -> x * 2 })
  }
  harness.stdio.log(process())
  harness.stdio.log(process([10, 20]))
  fn config(opts: dict = {host: "localhost", port: 8080}) {
    return "${opts.host}:${opts.port}"
  }
  harness.stdio.log(config())
  harness.stdio.log(config({host: "example.com", port: 3000}))
}
