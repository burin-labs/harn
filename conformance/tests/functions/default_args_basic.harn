pipeline test(harness: Harness, task: unknown) {
  fn greet(name: string, greeting: string = "hello") {
    harness.stdio.log("${greeting}, ${name}!")
  }
  greet("world")
  greet("world", "hi")
  fn add(a: int, b: int = 10) {
    return a + b
  }
  harness.stdio.log(add(5))
  harness.stdio.log(add(5, 20))
  fn flag(x: string, enabled: bool = true) {
    if enabled {
      harness.stdio.log("on: ${x}")
    } else {
      harness.stdio.log("off: ${x}")
    }
  }
  flag("test")
  flag("test", false)
}
