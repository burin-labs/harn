pipeline test(harness: Harness, task) {
  // Test that defaults work when called through method dispatch
  const items = [1, 2, 3]
  fn transform(x, multiplier = 10) {
    return x * multiplier
  }
  harness.stdio.println(items.map({ x -> transform(x) }))
  harness.stdio.println(items.map({ x -> transform(x, 5) }))
}
