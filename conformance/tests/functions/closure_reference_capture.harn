pipeline default(harness: Harness) {
  // Harn closures capture the enclosing environment by reference: a mutable
  // `let` reassigned or mutated through a closure is visible at the capture
  // site, and the closure sees the latest value. Immutable `const`/parameter
  // captures and container value semantics are unchanged.
  // 1. Scalar rebind through a closure propagates.
  let n = 0
  const inc = { -> n = n + 1 }
  inc()
  inc()
  harness.stdio.println(n)  // 2
  // 2. In-place subscript mutation through a captured list.
  let xs: list<int> = [0, 0]
  const setit = { -> xs[1] = 9 }
  setit()
  harness.stdio.println(xs[1])  // 9
  // 3. Field mutation through a captured dict.
  let d = {n: 0}
  const bump = { -> d.n = d.n + 1 }
  bump()
  bump()
  harness.stdio.println(d.n)  // 2
  // 4. Compound assignment through a captured let.
  let c = 10
  const addfive = { -> c += 5 }
  addfive()
  harness.stdio.println(c)  // 15
  // 5. A fresh cell per activation: a re-entered function does not share the
  //    previous call's captured state.
  harness.stdio.println(counter())  // 3
  harness.stdio.println(counter())  // 3
  // 6. A capture is a live reference, not a mint-time snapshot: a write after
  //    the closure is created is visible when it runs.
  let later = 1
  const readlater = { -> later }
  later = 42
  harness.stdio.println(readlater())  // 42
  // 7. An uncaptured closure is unaffected (value-semantic parameters).
  const double = { x -> x * 2 }
  harness.stdio.println(double(21))  // 42
  // 8. Shadowing: a closure's own inner `let` never touches the outer binding.
  let s = 100
  const shadow = { ->
    let s = 5
    s = s + 1
    return s
  }
  harness.stdio.println(shadow())  // 6
  harness.stdio.println(s)  // 100
  // 9. Container value semantics still hold: copying then mutating the copy
  //    leaves the captured original untouched.
  let original: list<int> = [1, 2, 3]
  let copy = original
  const mutate_copy = { -> copy[0] = 99 }
  mutate_copy()
  harness.stdio.println(original[0])  // 1
  harness.stdio.println(copy[0])  // 99
  // 10. Escaping closure (counter factory): the captured cell outlives the
  //     defining frame, and each activation gets its own cell.
  const c1 = make_counter()
  const c2 = make_counter()
  harness.stdio.println(c1())  // 1
  harness.stdio.println(c1())  // 2
  harness.stdio.println(c2())  // 1
  harness.stdio.println(c1())  // 3
  // 11. Two closures over one variable share a single cell.
  let shared = 0
  const bump_shared = { -> shared = shared + 1 }
  const read_shared = { -> shared }
  bump_shared()
  bump_shared()
  harness.stdio.println(read_shared())  // 2
}

fn make_counter() {
  let count = 0
  return { ->
    count = count + 1
    return count
  }
}

fn counter() {
  let g = 0
  const b = { -> g = g + 1 }
  b()
  b()
  b()
  return g
}
