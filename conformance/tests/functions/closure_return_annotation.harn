pipeline test(task) {
  const greet = fn(name: string) -> string { return "hello " + name }
  assert(greet("world") == "hello world", "annotated fn expression returns string")
  const no_args = fn() -> int { return 42 }
  assert(no_args() == 42, "zero-arg annotated fn expression parses and runs")
  const implicit_tail = fn(x: int) -> int { x + 1 }
  assert(implicit_tail(4) == 5, "annotated fn expression checks implicit tail")
  log("closure_return_annotation tests passed")
  fn make_adder(base: int) -> fn(int) -> int {
    return { value: int -> base + value }
  }
  assert(make_adder(40)(2) == 42, "call a returned closure")
  assert(make_adder(39)(3) == 42, "call another returned closure")
}
