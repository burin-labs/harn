pipeline test(harness: Harness, task) {
  const add = { x, y = 10 -> x + y }
  harness.stdio.println(add(5))
  harness.stdio.println(add(5, 20))
  const greet = { name, prefix = "Hello" -> "${prefix}, ${name}" }
  harness.stdio.println(greet("world"))
  harness.stdio.println(greet("world", "Hi"))
}
