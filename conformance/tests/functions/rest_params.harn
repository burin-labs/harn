pipeline test(harness: Harness, task) {
  fn sum(...nums) {
    let total = 0
    for n in nums {
      total += n
    }
    return total
  }
  harness.stdio.log(sum(1, 2, 3))
  harness.stdio.log(sum(10))
  harness.stdio.log(sum())
  // Rest param with leading required params
  fn greet(greeting, ...names) {
    for name in names {
      harness.stdio.log("${greeting}, ${name}!")
    }
  }
  greet("Hello", "Alice", "Bob")
  // Rest param is always a list
  fn check_type(...args) {
    harness.stdio.log(type_of(args))
  }
  check_type()
}
