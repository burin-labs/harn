import { agent_dispatch_tool_call } from "std/agent/primitives"

/**
 * Per-stage policy scoping (harn#1701):
 * `@persona(stages: [...])` declares per-stage tool allowlists. While the
 * matching `@step` runs the runtime pushes a CapabilityPolicy whose tool
 * surface equals the stage's `allowed_tools`. Tool calls outside that
 * surface come back as `permission_denied` receipts; in-stage calls
 * dispatch normally. The execution policy stack is empty once every step
 * frame unwinds.
 */
fn stage_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "read",
    "Read",
    {
      handler: { _args -> "read-ok" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  tools = tool_define(
    tools,
    "edit",
    "Edit",
    {
      handler: { _args -> "edit-ok" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "edit"},
    },
  )
  return tools
}

@persona(name: "scoped_persona", stages: [{name: "research", allowed_tools: ["read"]}, {name: "edit_phase", allowed_tools: ["edit"]}])
fn scoped_persona(tools: HarnessTools, ctx: dict) {
  const r = research_step(tools, ctx)
  const e = edit_phase_step(tools, ctx)
  return {research: r, edit: e}
}

@step(name: "research")
fn research_step(tools: HarnessTools, ctx: dict) {
  const registry = ctx.tools
  const in_scope = agent_dispatch_tool_call(tools, {name: "read", arguments: {}}, registry)
  const out_of_scope = agent_dispatch_tool_call(tools, {name: "edit", arguments: {}}, registry)
  return {in_scope: in_scope, out_of_scope: out_of_scope}
}

@step(name: "edit_phase")
fn edit_phase_step(tools: HarnessTools, ctx: dict) {
  const registry = ctx.tools
  const in_scope = agent_dispatch_tool_call(tools, {name: "edit", arguments: {}}, registry)
  const out_of_scope = agent_dispatch_tool_call(tools, {name: "read", arguments: {}}, registry)
  return {in_scope: in_scope, out_of_scope: out_of_scope}
}

pipeline main(harness: Harness) {
  const tools = stage_tools()
  const outcome = scoped_persona(harness.tools, {tools: tools})
  harness.stdio.println(outcome.research.in_scope.ok)
  harness.stdio.println(outcome.research.in_scope.rendered_result)
  harness.stdio.println(outcome.research.out_of_scope.ok)
  harness.stdio.println(outcome.research.out_of_scope.error_category)
  harness.stdio.println(outcome.edit.in_scope.ok)
  harness.stdio.println(outcome.edit.in_scope.rendered_result)
  harness.stdio.println(outcome.edit.out_of_scope.ok)
  harness.stdio.println(outcome.edit.out_of_scope.error_category)
  // After every stage unwinds the per-stage policy is gone, so an ambient
  // dispatch should pass.
  const ambient = agent_dispatch_tool_call(harness.tools, {name: "edit", arguments: {}}, tools)
  harness.stdio.println(ambient.ok)
  harness.stdio.println(ambient.rendered_result)
}
