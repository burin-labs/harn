import { verify_then_act } from "std/personas/prelude"

pipeline test(task) {
  let receipt_options = {
    persona: "merge_captain",
    step: "merge_pr",
    trace_id: "trace-prelude",
    started_at: "2026-05-03T00:00:00Z",
    completed_at: "2026-05-03T00:00:00Z",
  }
  let accepted = verify_then_act(fn() { return Ok({clean: true}) }, fn() { return "merged" }, receipt_options)
  println(accepted.status)
  println(accepted.verified)
  println(accepted.acted)
  println(accepted.result)
  println(accepted.receipt.schema)
  println(accepted.receipt.status)
  println(len(accepted.receipt.tool_calls))
  let blocked = verify_then_act(
    fn() { return false },
    fn() {
      throw "actor should not run"
    },
    receipt_options,
  )
  println(blocked.status)
  println(blocked.acted)
  println(blocked.result == nil)
}
