import { parallel_sweep_with_circuit_breaker } from "std/personas/prelude"

pipeline test(harness: Harness, task: unknown) {
  const result = parallel_sweep_with_circuit_breaker(
    harness,
    [1, 2, 3, 4],
    fn(item) {
      if item == 2 {
        throw "boom"
      }
      return item * 10
    },
    {
      persona: "sweep_captain",
      step: "sweep_prs",
      trace_id: "trace-sweep",
      started_at: "2026-05-03T00:00:00Z",
      completed_at: "2026-05-03T00:00:00Z",
      max_concurrent: 2,
      max_failures: 1,
    },
  )
  harness.stdio.println(result.status)
  harness.stdio.println(result.circuit_open)
  // Siblings may finish before the failing branch trips the circuit, or the
  // failure may win immediately. Assert conservation, not completion order.
  harness.stdio.println(result.failed == 1)
  harness.stdio.println(result.succeeded + result.skipped == 3)
  harness.stdio.println(len(result.results) == result.succeeded + result.failed)
  harness.stdio.println(result.receipt.status)
}
