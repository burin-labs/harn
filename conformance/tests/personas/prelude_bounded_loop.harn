import { bounded_loop } from "std/personas/prelude"

pipeline test(task) {
  const opts = {
    persona: "loop_captain",
    step: "drain_queue",
    trace_id: "trace-loop",
    started_at: "2026-05-03T00:00:00Z",
    completed_at: "2026-05-03T00:00:00Z",
    max_iterations: 5,
    progress_required: true,
  }
  const completed = bounded_loop(
    0,
    fn(state) {
      let next = state + 1
      return {state: next, progress: true, done: next >= 3}
    },
    opts,
  )
  __io_println(completed.status)
  __io_println(completed.state)
  __io_println(completed.iterations)
  __io_println(completed.stopped_reason)
  __io_println(completed.receipt.schema)
  const stalled = bounded_loop(7, fn(state) { return {state: state, progress: false} }, opts)
  __io_println(stalled.status)
  __io_println(stalled.state)
  __io_println(stalled.iterations)
  __io_println(stalled.stopped_reason)
}
