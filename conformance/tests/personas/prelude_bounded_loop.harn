import { bounded_loop } from "std/personas/prelude"

pipeline test(task) {
  let opts = {
    persona: "loop_captain",
    step: "drain_queue",
    trace_id: "trace-loop",
    started_at: "2026-05-03T00:00:00Z",
    completed_at: "2026-05-03T00:00:00Z",
    max_iterations: 5,
    progress_required: true,
  }
  let completed = bounded_loop(
    0,
    fn(state) {
      let next = state + 1
      return {state: next, progress: true, done: next >= 3}
    },
    opts,
  )
  println(completed.status)
  println(completed.state)
  println(completed.iterations)
  println(completed.stopped_reason)
  println(completed.receipt.schema)
  let stalled = bounded_loop(7, fn(state) { return {state: state, progress: false} }, opts)
  println(stalled.status)
  println(stalled.state)
  println(stalled.iterations)
  println(stalled.stopped_reason)
}
