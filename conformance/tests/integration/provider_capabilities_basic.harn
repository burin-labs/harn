/**
 * Data-driven provider capabilities (harn#77).
 *
 * `provider_capabilities(provider, model)` returns a dict describing
 * everything the shipped `capabilities.toml` matrix knows about a
 * (provider, model) pair. Scripts branch on the result without
 * carrying vendor-specific knowledge.
 */
pipeline test(task) {
  // Anthropic Opus 4.7 — full tool-search support.
  let opus = provider_capabilities("anthropic", "claude-opus-4-7")
  assert(opus.native_tools, "Opus 4.7 supports native tools")
  assert(opus.defer_loading, "Opus 4.7 supports defer_loading")
  assert(len(opus.tool_search) == 2, "Opus 4.7 advertises two tool_search variants")
  assert(opus.tool_search[0] == "bm25", "BM25 ordered first")
  assert(opus.tool_search[1] == "regex", "regex second")
  assert(opus.prompt_caching, "Opus 4.7 supports prompt caching")
  assert(opus.thinking, "Opus 4.7 exposes adaptive thinking")
  assert(opus.thinking_modes[0] == "adaptive", "Opus 4.7 exposes adaptive thinking mode")
  assert(opus.vision_supported, "Opus 4.7 accepts image content")
  assert(opus.max_tools == 10000, "Opus 4.7 max_tools cap is 10000")
  assert(opus.prefers_xml_scaffolding, "Opus 4.7 prefers XML prompt sections")
  assert(opus.structured_output_mode == "xml_tagged", "Opus 4.7 prefers XML-tagged output")
  assert(!opus.supports_assistant_prefill, "Opus 4.7 rejects assistant prefill")
  assert(opus.prefers_xml_tools, "Opus 4.7 prefers XML-rendered text tools")
  assert(opus.thinking_block_style == "thinking_blocks", "Opus 4.7 uses thinking blocks")
  // Older Claude — no tool search, still cache + thinking.
  let old = provider_capabilities("anthropic", "claude-opus-3-5")
  assert(old.native_tools, "Claude 3.5 still has native tools")
  assert(!old.defer_loading, "Claude 3.5 has no defer_loading")
  assert(len(old.tool_search) == 0, "Claude 3.5 advertises no tool_search variants")
  assert(old.prompt_caching, "Claude 3.5 still supports prompt caching")
  assert(old.thinking_modes[0] == "enabled", "Claude 3.5 exposes budgeted thinking mode")
  assert(old.supports_assistant_prefill, "Claude 3.5 accepts assistant prefill")
  // Haiku version gate — 4.4 is out, 4.5 is in.
  let haiku_44 = provider_capabilities("anthropic", "claude-haiku-4-4")
  assert(!haiku_44.defer_loading, "Haiku 4.4 has no tool search")
  let haiku_45 = provider_capabilities("anthropic", "claude-haiku-4-5")
  assert(haiku_45.defer_loading, "Haiku 4.5 has tool search")
  // OpenAI Responses API — hosted + client variants from 5.4.
  let gpt = provider_capabilities("openai", "gpt-5.4-preview")
  assert(gpt.defer_loading, "gpt-5.4 supports defer_loading")
  assert(len(gpt.tool_search) == 2, "gpt-5.4 advertises two tool_search modes")
  assert(gpt.tool_search[0] == "hosted", "hosted ordered first")
  assert(gpt.tool_search[1] == "client", "client second")
  assert(gpt.thinking_modes[0] == "effort", "gpt-5.4 exposes effort thinking")
  assert(gpt.reasoning_effort_supported, "gpt-5.4 supports reasoning_effort")
  assert(gpt.reasoning_none_supported, "gpt-5.4 supports reasoning_effort none")
  assert(gpt.prefers_markdown_scaffolding, "gpt-5.4 prefers Markdown prompt sections")
  assert(gpt.structured_output_mode == "native_json", "gpt-5.4 prefers native JSON output")
  assert(gpt.thinking_block_style == "reasoning_summary", "gpt-5.4 uses reasoning summaries")
  let gpt50 = provider_capabilities("openai", "gpt-5")
  assert(gpt50.reasoning_effort_supported, "gpt-5 supports reasoning_effort")
  assert(!gpt50.reasoning_none_supported, "gpt-5 floors reasoning off at minimal")
  // Legacy GPT — native tools only.
  let gpt4o = provider_capabilities("openai", "gpt-4o")
  assert(gpt4o.native_tools, "gpt-4o has native tools")
  assert(gpt4o.vision_supported, "gpt-4o accepts image content")
  assert(!gpt4o.defer_loading, "gpt-4o has no defer_loading")
  let o3 = provider_capabilities("openai", "o3")
  assert(o3.thinking_modes[0] == "effort", "o3 exposes effort thinking mode")
  assert(o3.requires_completion_tokens, "o3 requires max_completion_tokens")
  assert(o3.reasoning_effort_supported, "o3 supports reasoning_effort")
  assert(o3.prefers_role_developer, "o3 prefers developer-role instructions")
  // Ollama Qwen 3.5 advertises native tools on the official model page.
  let qwen35 = provider_capabilities("ollama", "qwen3.5:35b-a3b-coding-nvfp4")
  assert(qwen35.native_tools, "qwen3.5 on ollama has native tools")
  assert(!qwen35.vision_supported, "qwen3.5 is not a vision route")
  assert(qwen35.prefers_markdown_scaffolding, "qwen3.5 prefers Markdown prompt sections")
  assert(qwen35.structured_output_mode == "delimited", "qwen3.5 prefers delimited output")
  assert(!qwen35.prefers_xml_tools, "qwen3.5 does not use XML tool wrappers")
  assert(qwen35.thinking_block_style == "inline", "qwen3.5 uses inline thinking blocks")
  let gemini = provider_capabilities("gemini", "gemini-2.5-flash")
  assert(gemini.native_tools, "gemini native route supports function declarations")
  assert(gemini.message_wire_format == "gemini", "gemini native route uses Gemini message parts")
  assert(gemini.vision_supported, "gemini native route accepts image content")
  assert(gemini.thinking_modes[0] == "enabled", "gemini 2.5 native route exposes typed thinking")
  assert(gemini.structured_output_mode == "native_json", "gemini prefers native JSON output")
  let together_gpt_oss = provider_capabilities("together", "openai/gpt-oss-120b")
  assert(together_gpt_oss.thinking_modes[0] == "effort", "Together GPT-OSS exposes effort thinking")
  assert(together_gpt_oss.reasoning_effort_supported, "Together GPT-OSS accepts reasoning_effort")
  let together_kimi = provider_capabilities("together", "moonshotai/Kimi-K2.5")
  assert(together_kimi.thinking_modes[0] == "enabled", "Together Kimi exposes reasoning.enabled")
  assert(
    !together_kimi.honors_chat_template_kwargs,
    "Together Kimi does not use Qwen chat template kwargs",
  )
  // OpenRouter inherits the openai family.
  let routed = provider_capabilities("openrouter", "gpt-5.4")
  assert(routed.defer_loading, "openrouter inherits openai defer_loading")
  assert(routed.tool_search[0] == "hosted", "openrouter inherits hosted/client variants")
  assert(routed.reasoning_none_supported, "openrouter inherits gpt-5.4 reasoning none support")
  let deepseek32 = provider_capabilities("openrouter", "deepseek/deepseek-v3.2")
  assert(deepseek32.native_tools, "OpenRouter DeepSeek V3.2 exposes native tools")
  assert(deepseek32.text_tool_wire_format_supported, "OpenRouter DeepSeek V3.2 supports text tools")
  assert(
    deepseek32.preferred_tool_format == "text",
    "OpenRouter DeepSeek V3.2 defaults to text tools",
  )
  assert(
    deepseek32.tool_mode_parity == "native_unreliable",
    "OpenRouter DeepSeek V3.2 records native/text non-interchangeability",
  )
  let qwen_coder = provider_capabilities("openrouter", "qwen/qwen3-coder-flash")
  assert(qwen_coder.native_tools, "OpenRouter Qwen Coder advertises native tools")
  assert(qwen_coder.text_tool_wire_format_supported, "OpenRouter Qwen Coder supports text tools")
  assert(qwen_coder.preferred_tool_format == "text", "OpenRouter Qwen Coder defaults to text tools")
  assert(
    qwen_coder.tool_mode_parity == "native_unreliable",
    "OpenRouter Qwen Coder records native/text non-interchangeability",
  )
  // Sibling families: together, groq, deepseek, fireworks, huggingface, local.
  for family in ["together", "groq", "deepseek", "fireworks", "huggingface", "local"] {
    let caps = provider_capabilities(family, "gpt-5.4")
    assert(caps.defer_loading, family + " inherits openai defer_loading")
  }
  // Enterprise providers expose native tool schemas without claiming
  // provider-specific tool_search semantics.
  let azure = provider_capabilities("azure_openai", "gpt-4o-prod")
  assert(azure.native_tools, "Azure OpenAI supports native tools")
  assert(!azure.defer_loading, "Azure chat completions has no Harn tool_search gate")
  assert(azure.prefers_markdown_scaffolding, "Azure OpenAI prefers Markdown prompt sections")
  assert(azure.structured_output_mode == "native_json", "Azure OpenAI prefers native JSON output")
  let bedrock = provider_capabilities("bedrock", "meta.llama3-70b-instruct-v1:0")
  assert(bedrock.native_tools, "Bedrock Converse supports native tools")
  assert(
    bedrock.prefers_markdown_scaffolding,
    "generic Bedrock models prefer Markdown prompt sections",
  )
  let vertex = provider_capabilities("vertex", "gemini-1.5-pro-002")
  assert(vertex.native_tools, "Vertex Gemini supports native tools")
  assert(vertex.structured_output_mode == "native_json", "Vertex Gemini prefers native JSON output")
  // Unknown provider + unknown model: all-default dict.
  let unknown = provider_capabilities("my-custom-proxy", "mystery-7b")
  assert(!unknown.native_tools, "unknown provider has no native_tools")
  assert(!unknown.defer_loading, "unknown provider has no defer_loading")
  assert(len(unknown.tool_search) == 0, "unknown provider has no tool_search")
  assert(len(unknown.thinking_modes) == 0, "unknown provider has no thinking modes")
  assert(unknown.max_tools == nil, "unknown provider has no max_tools cap")
  log("provider_capabilities_basic tests passed")
}
