// std/llm/safe.dict_get_ci performs a single case-insensitive lookup.
import { dict_get_ci } from "std/llm/safe"

pipeline default() {
  let d = {Foo: 1, BAR: "x", baz: nil}
  __io_println(dict_get_ci(d, "foo"))
  __io_println(dict_get_ci(d, "FOO"))
  __io_println(dict_get_ci(d, "bar"))
  __io_println(dict_get_ci(d, "Baz") == nil)
  __io_println(dict_get_ci(d, "missing") == nil)
  __io_println(dict_get_ci(nil, "anything") == nil)
}
