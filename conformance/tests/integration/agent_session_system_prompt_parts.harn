import { system_preamble, with_system_prompt_parts } from "std/llm/prompts"

fn occurrences(text, needle) {
  return len(split(text, needle)) - 1
}

fn events_by_kind(transcript, kind) {
  return transcript_events(transcript).filter({ event -> event.kind == kind })
}

pipeline default() {
  llm_mock_clear()
  let direct = llm_call(
    "direct prompt",
    "Direct base.",
    {provider: "mock", system_preamble: system_preamble("Direct preamble.", {label: "Direct contract"})},
  )
  println(len(transcript_messages(direct.transcript)))
  println(len(events_by_kind(direct.transcript, "system_prompt")))
  println(transcript_events(direct.transcript)[0].kind == "system_prompt")
  println(direct.transcript.metadata.system_prompt.content.contains("Direct preamble."))
  println(occurrences(json_stringify(direct.transcript), "Direct preamble.") == 1)
  llm_mock_clear()
  let sid = "system-prompt-continuation-session"
  let opts = with_system_prompt_parts(
    {provider: "mock", session_id: sid, max_iterations: 1},
    [
      system_preamble("Persistent contract.", {label: "Session contract"}),
      {content: "disabled", enabled: false},
    ],
  )
  let first = agent_loop("hello", "Base system.", opts)
  let resumed = agent_loop("follow up", "Base system.", opts)
  let resumed_without_prompt = agent_loop(
    "resume without prompt options",
    nil,
    {provider: "mock", session_id: sid, max_iterations: 1},
  )
  let calls = llm_mock_calls()
  println(first.status)
  println(resumed.status)
  println(resumed_without_prompt.status)
  println(len(calls))
  println(occurrences(calls[0].system, "Persistent contract.") == 1)
  println(occurrences(calls[1].system, "Persistent contract.") == 1)
  println(occurrences(calls[2].system, "Persistent contract.") == 1)
  println(!json_stringify(calls[2].messages).contains("Persistent contract."))
  println(len(transcript_messages(resumed_without_prompt.transcript)))
  println(len(events_by_kind(resumed_without_prompt.transcript, "system_prompt")))
  println(transcript_events(resumed_without_prompt.transcript)[0].kind == "system_prompt")
  println(occurrences(json_stringify(resumed_without_prompt.transcript), "Persistent contract.") == 1)
  println(agent_session_system_prompt(sid).contains("Persistent contract."))
  println(
    resumed_without_prompt.transcript.metadata.system_prompt.content.contains("Persistent contract."),
  )
}
