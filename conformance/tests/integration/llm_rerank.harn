import { pairwise_rerank, self_certainty } from "std/llm/rerank"
import { llm_call_count, with_llm_mocks } from "std/testing"

fn run_pairwise_rerank() {
  let result = pairwise_rerank(["weak", "best", "ok"], {task: "Pick the strongest answer.", provider: "mock"})
  return {result: result, calls: llm_call_count()}
}

fn run_mock_self_certainty() {
  return self_certainty("calibrated", {provider: "mock"})
}

fn run_mock_logprobs_call() {
  return llm_call("return visible", nil, {provider: "mock", logprobs: true})
}

pipeline default(task) {
  let judged = with_llm_mocks(
    [
      {text: "{\"winner\":\"A\",\"confidence\":0.9,\"reasoning\":\"best beats ok\"}"},
      {text: "{\"winner\":\"B\",\"confidence\":0.8,\"reasoning\":\"best beats weak\"}"},
      {text: "{\"winner\":\"B\",\"confidence\":0.7,\"reasoning\":\"ok beats weak\"}"},
    ],
    run_pairwise_rerank,
  )
  println(judged.result.ranked[0] == "best")
  println(judged.result.ranked[1] == "ok")
  println(judged.result.ranked[2] == "weak")
  println(judged.calls == 3)
  println(judged.result.scores[1].wins == 2 && judged.result.scores[1].losses == 0)
  println(judged.result.scores[0].losses == 2 && judged.result.scores[2].wins == 1)
  println(
    judged.result.scores[1].avg_confidence > 0.84 && judged.result.scores[1].avg_confidence < 0.86,
  )
  let direct = self_certainty(
    "ignored",
    {logprobs: [{token: "a", logprob: -0.6931471805599453}, {token: "b", logprob: -0.6931471805599453}]},
  )
  println(direct > 0.49 && direct < 0.51)
  let from_mock = with_llm_mocks(
    [{text: "calibrated", logprobs: [{token: "calibrated", logprob: 0.0}]}],
    run_mock_self_certainty,
  )
  println(from_mock == 1.0)
  let mocked_result = with_llm_mocks(
    [{text: "visible", logprobs: [{token: "visible", logprob: 0.0}]}],
    run_mock_logprobs_call,
  )
  println(mocked_result.logprobs[0].token == "visible")
}
