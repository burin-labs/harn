import { ensure_parent_dir } from "std/fs"

pipeline default() {
  let root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  let server_path = path_join(root, "conformance/helpers/mcp_file_input_server.py")
  let sample_path = path_join(root, ".harn", "mcp-file-upload.txt")
  ensure_parent_dir(sample_path)
  write_file(sample_path, "hello upload")
  let config = harn.mcp
    .configure(
    {experimental: {file_upload: {spec_revision: "modelcontextprotocol/modelcontextprotocol#2356"}}},
  )
  println(config.experimental.file_upload.enabled)
  let client = mcp_connect("python3", [server_path])
  let tools = mcp_list_tools(client)
  println(json_stringify(tools[0].inputSchema).contains("\"x-mcp-file\""))
  let uri = harn.mcp.upload_file(client, sample_path, {accept: ["text/*"], max_size: 64})
  println(uri.starts_with("data:text/plain;base64,"))
  let result = mcp_call(client, "inspect_upload", {upload: uri})
  println(result)
  mcp_disconnect(client)
}
