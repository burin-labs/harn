// std/llm/safe.with_case_insensitive_keys recursively lowercases dict
// keys; idempotent on already-normalized input.
import { with_case_insensitive_keys } from "std/llm/safe"

pipeline default() {
  let nested = {Outer: {Inner: 1, BLOB: [1, 2, {ChildKey: "v"}]}, Top: "ok"}
  let normalized = with_case_insensitive_keys(nested)
  println(normalized.outer.inner)
  println(normalized.outer.blob[2].childkey)
  println(normalized.top)
  let again = with_case_insensitive_keys(normalized)
  println(again.outer.inner)
  println(again.outer.blob[2].childkey == "v")
  // primitives pass through
  println(with_case_insensitive_keys("plain"))
}
