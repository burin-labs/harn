// @xfail: MCP bootstrap not yet wired through Harn loop — tracked in burin-labs/harn#1238
import { process_shell } from "std/runtime"

fn wait_for_file(path, attempts) {
  var remaining = attempts
  while !file_exists(path) && remaining > 0 {
    sleep(50ms)
    remaining = remaining - 1
  }
  require file_exists(path), "timed out waiting for " + path
}

pipeline default() {
  let root = project_root() ?? cwd()
  let helper = path_join(root, "conformance/helpers/mcp_http_elicit_server.py")
  let state_dir = path_join(temp_dir(), "harn-mcp-http-elicit-" + uuid())
  let port_path = path_join(state_dir, "port")
  let pid_path = path_join(state_dir, "server.pid")
  let log_path = path_join(state_dir, "server.log")
  mkdir(state_dir)
  let start = process_shell(
    "python3 \"" + helper + "\" \"" + state_dir + "\" >\"" + log_path
      + "\" 2>&1 & echo $! > \""
      + pid_path
      + "\"",
  )
  require start?.success, "MCP elicitation mock server started"
  wait_for_file(port_path, 100)
  let base = "http://127.0.0.1:" + read_file(port_path).trim()
  host_mock_clear()
  host_mock("mcp", "elicit", {action: "accept", content: {env: "staging", confirm: true}})
  llm_mock_clear()
  llm_mock(
    {
      text: "Calling MCP elicitation tool.",
      tool_calls: [{id: "mcp-elicit", name: "remote__ask", arguments: {prompt: "Choose deploy target"}}],
    },
  )
  llm_mock({text: "<done>##DONE##</done>"})
  let result = agent_loop(
    "Use the remote ask tool",
    nil,
    {
      provider: "mock",
      tool_format: "native",
      max_iterations: 3,
      mcp_servers: [{name: "remote", transport: "http", url: base + "/mcp"}],
    },
  )
  let state = json_parse(http_get(base + "/__state").body)
  let calls = host_mock_calls()
  let _stop = http_post(base + "/__shutdown", "")
  process_shell("kill $(cat \"" + pid_path + "\") >/dev/null 2>&1 || true")
  println(result?.tools.successful[0])
  println(state.tool_calls[0].name)
  println(state.elicit_response.result.action)
  println(state.elicit_response.result.content.env)
  println(state.elicit_response.result.content.confirm)
  println(calls[0].capability)
  println(calls[0].operation)
  println(calls[0].params.server)
}
