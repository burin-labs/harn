import { agent_capture_events } from "std/agent/events"
import { read_jsonl } from "std/jsonl"
import {
  compose_tool_callers,
  tools_use_middleware,
  with_audit_log,
  with_required_reason,
} from "std/llm/tool_middleware"

fn receipt_tools() {
  let registry = tool_registry()
  return tool_define(
    registry,
    "echo_receipt",
    "Echo a message",
    {
      handler: { args -> return {echoed: to_string(args?.message ?? "")} },
      parameters: {message: {type: "string"}, secret: {type: "string"}},
    },
  )
}

fn run_receipt_agent(session, audit_options) {
  llm_mock_clear()
  llm_mock(
    {
      tool_calls: [
        {
          id: "receipt-1",
          name: "echo_receipt",
          arguments: {message: "hello", secret: "hide-me", reason: "Need a receipt"},
        },
      ],
    },
  )
  llm_mock({text: "Done. ##DONE##"})
  let reason = with_required_reason({schema_required: false})
  let tools = tools_use_middleware(receipt_tools(), reason.schema_transform)
  let caller = compose_tool_callers([with_audit_log(audit_options), reason.caller])
  return agent_loop(
    "emit a tool receipt",
    nil,
    {
      provider: "mock",
      model: "mock",
      session_id: session,
      tools: tools,
      tool_format: "native",
      loop_until_done: true,
      max_iterations: 3,
      tool_caller: caller,
    },
  )
}

pipeline default() {
  clear_tool_hooks()
  register_tool_hook(
    {
      pattern: "echo_receipt",
      pre: { _event -> return {
        reminder: {
          body: "receipt hook reminder",
          tags: ["receipt"],
          dedupe_key: "receipt-hook",
          ttl_turns: 1,
          role_hint: "developer",
        },
      } },
    },
  )
  let local_session = "receipt-local-" + uuid()
  let local_path = path_join(".harn", "receipts", local_session + ".jsonl")
  if file_exists(local_path) {
    delete_file(local_path)
  }
  let local_captured = agent_capture_events(
    local_session,
    fn() { return run_receipt_agent(local_session, {sink: "local", redact: ["secret"]}) },
  )
  let local_result = local_captured.result
  let records = read_jsonl(local_path, {strict: true})
  let receipt = records[0]
  let receipt_json = json_stringify(receipt)
  let reminder_audit = receipt?.audit?.reminders ?? {}
  let reminder_lifecycle = reminder_audit?.lifecycle ?? []
  let expected_args_hash = sha256("{\"message\":\"hello\",\"reason\":\"Need a receipt\"}")
  let expected_receipt_uri = "file://" + path_join(cwd(), local_path)
  let local_audit_events = local_captured.events.filter({ event -> event.type == "tool_call_audit" })
  let local_audit_uri = to_string(local_audit_events[0]?.audit?.receipt_uri ?? "")
  println("local_status=" + local_result.status)
  println("local_records=" + to_string(len(records)))
  println("schema_version=" + to_string(receipt.schema_version))
  println("reason=" + receipt.reason)
  println("receipt_status=" + receipt.status)
  println("secret_redacted=" + to_string(!contains(receipt_json, "hide-me")))
  println("args_hash_redacted=" + to_string(receipt.args_hash == expected_args_hash))
  println("result_hash_present=" + to_string(len(to_string(receipt.result_hash ?? "")) == 64))
  println(
    "receipt_uri_in_receipt="
      + to_string(to_string(receipt?.audit?.receipt_uri ?? "") == expected_receipt_uri),
  )
  println("receipt_uri_in_audit_event=" + to_string(local_audit_uri == expected_receipt_uri))
  println("reminder_audit_origin=" + to_string(reminder_audit?.origin ?? ""))
  println("reminder_lifecycle_count=" + to_string(len(reminder_lifecycle)))
  println("reminder_hook_event=" + to_string(reminder_lifecycle[0]?.hook_event ?? ""))
  println(
    "reminder_tool_call_id="
      + to_string(reminder_lifecycle[0]?.tool_call_id == receipt.tool_call_id),
  )
  println("reminder_source=" + to_string(reminder_lifecycle[0]?.source ?? ""))
  println("reminder_role_hint=" + to_string(reminder_lifecycle[0]?.role_hint ?? ""))
  println("reminder_tag=" + to_string(reminder_lifecycle[0]?.tags[0] ?? ""))
  let cloud_session = "receipt-cloud-" + uuid()
  let captured = agent_capture_events(
    cloud_session,
    fn() { return run_receipt_agent(cloud_session, {sink: "cloud", redact: ["secret"]}) },
  )
  let receipt_events = captured.events.filter({ event -> event.type == "tool_call_audit" && event?.receipt != nil })
  println("cloud_receipts=" + to_string(len(receipt_events)))
  println("cloud_reason=" + receipt_events[0].receipt.reason)
  println(
    "cloud_omits_receipt_uri=" + to_string(receipt_events[0]?.receipt?.audit?.receipt_uri == nil),
  )
  println(
    "cloud_reminder_audit="
      + to_string(receipt_events[0]?.receipt?.audit?.reminders?.origin == "tool_hook"),
  )
  clear_tool_hooks()
}
