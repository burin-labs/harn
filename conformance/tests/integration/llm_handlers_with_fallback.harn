// Conformance test for std/llm/handlers::with_fallback — tries callers in
// order and stamps {fallback_index, fallback_total} on the first success.
import { with_fallback } from "std/llm/handlers"

pipeline default() {
  let a = { _call -> {ok: false, status: "auth", error: "no key"} }
  let b = { _call -> {ok: false, status: "transient", error: "blip"} }
  let c = { _call -> {
    ok: true,
    value: {text: "C-text", model: "mock", provider: "mock", input_tokens: 0, output_tokens: 0},
  } }
  let caller = with_fallback([a, b, c])
  let env = caller({prompt: "p", system: "", opts: {}, turn: {iteration: 0, session_id: "", attempt: 1}})
  println(env.ok)
  println(env.value.text)
  println(env.fallback_index)
  println(env.fallback_total)
}
