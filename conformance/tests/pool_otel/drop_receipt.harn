import { Backpressure, pool_create, pool_wait } from "std/lifecycle/pool"

/**
 * PL-06 (#1891): backpressure-rejected submissions emit a `pool_drop`
 * receipt on `lifecycle.pool.audit` carrying `reason`, `policy`, and the
 * dropped + replacement task ids — alongside the standard `pool_submit`
 * receipt that fires on every accepted submit.
 */
pipeline default() {
  const bp = Backpressure()
  // Filter to drop receipts so the cursor is anchored to backpressure
  // events even though `pool_submit` / `pool_dequeue` receipts also fan
  // out on the same audit topic.
  const drops = event_log
    .subscribe({topic: "lifecycle.pool.audit", kind_prefix: "pool_drop"})
  const gate = channel(nil, 1)
  const pool = pool_create({name: "otel-drop-demo", max_concurrent: 1, backpressure: bp.queue(1, "drop_newest")})
  const warmup = pool
    .submit(
    { ->
      receive(gate)
      return "warmup"
    },
  )
  const queued = pool.submit({ -> "queued" })
  const dropped = pool.submit({ -> "dropped" })
  // The drop_newest policy rejects the third submission immediately.
  const drop_receipt = drops.next().value
  __io_println(drop_receipt.kind)
  __io_println(drop_receipt.headers.schema)
  __io_println(drop_receipt.payload.policy)
  __io_println(drop_receipt.payload.reason)
  __io_println(drop_receipt.payload.pool)
  __io_println(drop_receipt.payload.max_depth)
  __io_println(drop_receipt.payload.queue_depth)
  // Drain so the two surviving tasks finish.
  send(gate, "go")
  const results = pool_wait([warmup, queued, dropped])
  __io_println(results[0].status)
  __io_println(results[1].result)
  __io_println(results[2].status)
  __io_println(results[2].rejection_policy)
}
