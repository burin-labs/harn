import { extract_paths, int_to_string, truncate_head_tail } from "std/text"

pipeline default(harness: Harness) {
  const paths = extract_paths("See /foo/bar.txt for details")
  harness.stdio.println(paths[0])
  harness.stdio.println(int_to_string(17))
  const short = truncate_head_tail("a\nb\nc\nd\ne\nf", 1)
  harness.stdio.println(contains(short, "4 lines omitted"))
}
