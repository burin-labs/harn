// KNOWN-DEFECT fixture — pins harn#5062: cross-module enum-variant
// CONSTRUCTION throws at runtime though `harn check` passes.
//
// `make_cross_module_enum` (in the sibling lib) constructs `CrossModuleEnum.Made`.
// Called from THIS module it currently throws "Undefined variable:
// CrossModuleEnum" at runtime — the enum type name is not resolvable in an
// imported function's runtime environment (struct construction, by contrast,
// works cross-module). `harn check` reports this file `ok`, which is exactly the
// runtime-green/type-red trap this fixture locks.
//
// The construction is wrapped in `try` (the throw IS catchable), so the fixture
// runs cleanly and prints a STABLE marker rather than depending on the exact
// error wording. When the runtime defect is fixed the `try` yields `Ok` and the
// fixture prints the FIXED line instead — the `.expected` no longer matches and
// the fixture flips RED, loudly signalling: fix landed → drop this fixture and
// migrate the tagged-shape-union workarounds (e.g. std/agent/verdict) to `enum`.
import { make_cross_module_enum } from "cross_module_enum_defect_lib"

pipeline default() {
  const result = try {
    make_cross_module_enum(3)
  }
  match result {
    Result.Ok(_v) -> { __io_println("FIXED-5062: cross-module enum construction works") }
    Result.Err(_e) -> { __io_println("KNOWN-DEFECT-5062: cross-module enum construction still throws") }
  }
}
