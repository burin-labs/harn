// Regression coverage for #5281: a `pub import`-ed type alias must be usable as
// a runtime schema value inside the facade that re-exports it, matching the
// downstream behavior of importing the same name through the facade.
import { Contract, contract_kind, validate } from "pub_import_facade_self_schema_facade"

fn downstream_ok(value: unknown) -> bool {
  return schema_is(value, Contract)
}

pipeline default(harness: Harness) {
  // Facade self-use of the re-exported type via `schema_is`.
  harness.stdio.println(validate({label: "ok"}))
  harness.stdio.println(validate({label: 12}))
  // Facade self-use via `schema_of` passed to a local generic `Schema<T>` helper.
  harness.stdio.println(contract_kind())
  // Downstream use of the same re-exported type through the facade.
  harness.stdio.println(downstream_ok({label: "down"}))
  harness.stdio.println(downstream_ok({label: 12}))
}
