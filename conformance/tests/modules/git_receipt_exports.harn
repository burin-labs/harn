import {
  GitCheckoutReceipt,
  GitFetchReceipt,
  GitLsRemoteReceipt,
  GitPushReceipt,
  GitReceipt,
  git_fetch,
  git_ls_remote,
  git_push,
} from "std/git"

type GitAdapters = {
  lookup: fn(string) -> GitLsRemoteReceipt,
  fetch: fn(string) -> GitFetchReceipt,
  push: fn(string, string) -> GitPushReceipt,
  prior_lookup?: GitLsRemoteReceipt,
  prior_sync?: GitCheckoutReceipt,
  prior_mutation?: GitReceipt,
}

fn lookup(process: HarnessProcess, remote: string) -> GitLsRemoteReceipt {
  return git_ls_remote(process, remote)
}

fn adapters(process: HarnessProcess) -> GitAdapters {
  return {
    lookup: { remote -> return lookup(process, remote) },
    fetch: { repo -> return git_fetch(process, "origin", repo) },
    push: { remote, refspec -> return git_push(process, remote, refspec) },
  }
}

pipeline default(harness: Harness) {
  const configured: GitAdapters = adapters(harness.process)
  harness.stdio.println(configured.prior_lookup == nil && configured.prior_sync == nil)
}
