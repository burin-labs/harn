/** Private payload for `CrossModuleEnum.Made`. */
struct Inner {
  n: int
}

/**
 * Library half of the cross-module enum-construction known-defect fixture
 * (harn#5062). Constructing this enum's variant from an IMPORTING module throws
 * at runtime, though `harn check` passes. See cross_module_enum_defect.harn.
 */
pub enum CrossModuleEnum {
  Made(Inner)
  Other(int)
}

/**
 * Cross-module constructor — currently throws "Undefined variable" when called
 *  from another module (harn#5062); works when called within this file.
 */
pub fn make_cross_module_enum(n: int) -> CrossModuleEnum {
  return CrossModuleEnum.Made(Inner {n: n})
}
