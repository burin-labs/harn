pipeline test(harness: Harness, task: unknown) {
  const template = """
// Auto-generated code - do not edit.
pub fn {{ fn_name }}() -> dict {
  return {}
}
"""
  const name = "build"
  const report = """
root:
  title: ${name}
  nested:
    keep: exact  
"""
  harness.stdio.log(template)
  harness.stdio.log(report)
}
