pipeline main() {
  let injected = transcript
    .inject_reminder(
    transcript(),
    {body: "ttl reminder", ttl_turns: 5, preserve_on_compact: true, propagate: "none"},
  )
  let events = transcript_events_by_kind(injected.transcript, "system_reminder")
  println(len(events))
  println(events[0].reminder.body)
  println(events[0].reminder.ttl_turns)
  println(events[0].reminder.preserve_on_compact)
  println(events[0].reminder.propagate)
  println(events[0].reminder.source)
  println(injected.deduped_count)
}
