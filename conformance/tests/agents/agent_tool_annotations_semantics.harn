import {
  agent_tool_calls_are_read_only,
  agent_tool_is_read_only,
  agent_tool_resolve_workspace_write_name,
  agent_tool_single_workspace_write_name,
} from "std/agent/tool_annotations"

fn entry(name: string, annotations: dict) {
  return {name: name, annotations: annotations}
}

pipeline default(harness: Harness) {
  const read = entry("read", {kind: "read"})
  const mcp_read = entry("mcp_read", {readOnlyHint: true, destructiveHint: false})
  const destructive = entry(
    "destructive",
    {kind: "read", readOnlyHint: true, destructiveHint: true},
  )
  const edit = entry("edit", {kind: "edit", side_effect_level: "workspace_write"})
  const network_fetch = entry("network_fetch", {kind: "fetch", side_effect_level: "network"})
  const network_search = entry("network_search", {kind: "search", side_effect_level: "network"})
  const network_action = entry("network_action", {kind: "execute", side_effect_level: "network"})
  const tools = {
    tools: [read, mcp_read, destructive, edit, network_fetch, network_search, network_action],
  }
  harness.stdio.println(agent_tool_is_read_only(read))
  harness.stdio.println(agent_tool_is_read_only(mcp_read))
  harness.stdio.println(agent_tool_is_read_only(destructive))
  harness.stdio.println(agent_tool_is_read_only(network_fetch))
  harness.stdio.println(agent_tool_is_read_only(network_search))
  harness.stdio.println(agent_tool_is_read_only(network_action))
  harness.stdio.println(agent_tool_calls_are_read_only([{name: "read"}, {name: "mcp_read"}], tools))
  harness.stdio.println(agent_tool_calls_are_read_only([{name: "read"}, {name: "edit"}], tools))
  harness.stdio.println(agent_tool_calls_are_read_only([{name: "unknown"}], tools))
  harness.stdio.println(
    !agent_tool_calls_are_read_only(
      [{name: "unknown"}],
      tools,
      {tool_annotations: {unknown: {kind: "read"}}},
    ),
  )
  harness.stdio.println(agent_tool_single_workspace_write_name(tools))
  harness.stdio.println(
    agent_tool_single_workspace_write_name(
      {tools: tools.tools.appending(entry("second_edit", {kind: "edit"}))},
    )
      == "",
  )
  const multiple_writers = {tools: tools.tools.appending(entry("second_edit", {kind: "edit"}))}
  harness.stdio.println(agent_tool_resolve_workspace_write_name(multiple_writers, nil, "edit"))
  harness.stdio.println(
    agent_tool_resolve_workspace_write_name(multiple_writers, nil, "read") == "",
  )
  harness.stdio.println(
    agent_tool_resolve_workspace_write_name(
      {tools: [entry("conflicting", {kind: "edit", side_effect_level: "read_only"})]},
      nil,
      "conflicting",
    )
      == "",
  )
  harness.stdio.println(
    agent_tool_resolve_workspace_write_name(
      {tools: [entry("dangerous", {kind: "edit", destructiveHint: true})]},
      nil,
      "dangerous",
    )
      == "",
  )
}
