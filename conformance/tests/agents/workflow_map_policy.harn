import {
  workflow_map_finalize,
  workflow_map_join_target,
  workflow_map_stage_plan,
  workflow_map_work_items,
} from "std/workflow/map"

fn item_kinds(items: list) {
  let out = []
  for item in items {
    out = out.appending(item.kind)
  }
  return out
}

pipeline default(harness: Harness) {
  const artifact_plan = workflow_map_work_items(
    {
      node: {
        context_policy: {max_artifacts: 2, prioritize_kinds: ["diff"]},
        input_contract: {},
        map_policy: {item_artifact_kind: "diff", max_items: 1},
      },
      artifacts: [
        {id: "summary", kind: "summary", text: "summary", priority: 10},
        {id: "diff-a", kind: "diff", text: "a", priority: 1},
        {id: "diff-b", kind: "diff", text: "b", priority: 2},
      ],
    },
  )
  harness.stdio.println(len(artifact_plan.items))
  harness.stdio.println(artifact_plan.items[0].kind)
  harness.stdio.println(artifact_plan.items[0].artifact.id)
  harness.stdio.println(json_stringify(artifact_plan.selected_artifact_ids))
  const explicit_plan = workflow_map_work_items(
    {
      node: {
        context_policy: {include_kinds: ["summary"]},
        input_contract: {},
        map_policy: {
          items: [{name: "one"}, {name: "two"}, {name: "three"}],
          item_artifact_kind: "work",
          max_items: 2,
        },
      },
      artifacts: [{id: "summary", kind: "summary", text: "s"}],
    },
  )
  harness.stdio.println(len(explicit_plan.items))
  harness.stdio.println(json_stringify(item_kinds(explicit_plan.items)))
  harness.stdio.println(explicit_plan.items[1].value.name)
  harness.stdio.println(explicit_plan.items[0].artifact_kind)
  harness.stdio.println(json_stringify(explicit_plan.selected_artifact_ids))
  harness.stdio.println(workflow_map_join_target({join_policy: {strategy: "all"}, total: 3}))
  harness.stdio.println(workflow_map_join_target({join_policy: {strategy: "first"}, total: 3}))
  harness.stdio.println(
    workflow_map_join_target({join_policy: {strategy: "quorum", min_completed: 2}, total: 3}),
  )
  const direct_plan = workflow_map_stage_plan(
    {node: {map_policy: {output_kind: "work"}, output_contract: {output_kinds: ["summary"]}}},
  )
  harness.stdio.println(direct_plan.runs_stage)
  harness.stdio.println(direct_plan.output_kind)
  harness.stdio.println(direct_plan.stage_node == nil)
  const stage_plan = workflow_map_stage_plan(
    {
      node: {
        kind: "map",
        prompt: "Do the item",
        tools: [{name: "run"}],
        map_policy: {output_kind: "diff"},
        join_policy: {strategy: "first"},
        output_contract: {output_kinds: ["summary"]},
      },
    },
  )
  harness.stdio.println(stage_plan.runs_stage)
  harness.stdio.println(stage_plan.stage_node.kind)
  harness.stdio.println(json_stringify(stage_plan.stage_node.map_policy))
  harness.stdio.println(json_stringify(stage_plan.stage_node.join_policy))
  harness.stdio.println(stage_plan.stage_node.output_contract.output_kinds[0])
  const completed = workflow_map_finalize(
    {
      strategy: "quorum",
      total_items: 3,
      produced_count: 2,
      completed: [{index: 0}, {index: 1}],
      failures: [],
    },
  )
  harness.stdio.println(completed.result.status)
  harness.stdio.println(completed.result.text)
  harness.stdio.println(completed.outcome)
  harness.stdio.println(completed.branch)
  const failed = workflow_map_finalize(
    {
      strategy: "all",
      total_items: 3,
      produced_count: 0,
      completed: [],
      failures: [{status: "failed"}, {status: "failed"}],
    },
  )
  harness.stdio.println(failed.result.status)
  harness.stdio.println(failed.result.text)
  harness.stdio.println(failed.branch)
}
