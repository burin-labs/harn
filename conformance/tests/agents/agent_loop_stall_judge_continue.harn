import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { agent_session_messages, agent_session_visible_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

fn events_of(events: any, kind: string) {
  return events.filter({ event -> event.type == kind })
}

fn tool_message_count(agent: HarnessAgent, session_id: any) {
  let count = 0
  for message in agent_session_messages(agent, session_id) {
    if message?.role == "tool_result" && message?.name == "noop" {
      count = count + 1
    }
  }
  return count
}

pipeline default(harness: Harness) {
  let dispatches = 0
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "noop",
    "Return the same harmless result",
    {
      handler: { _args ->
        dispatches = dispatches + 1
        return "noop"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "noop1", name: "noop", arguments: {}}]},
      {text: "", tool_calls: [{id: "noop2", name: "noop", arguments: {}}]},
      {text: "", tool_calls: [{id: "noop3", name: "noop", arguments: {}}]},
      llm_text("{\"verdict\":\"continue\",\"detail\":\"Change approach on the next turn.\"}"),
      llm_text("still working"),
    ],
    { ->
      const session = "stall-judge-continue-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Continue when the stall judge vetoes.",
          nil,
          {
            provider: "mock",
            tools: tools,
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 4,
            session_id: session,
            stall_diagnostics: {threshold: 3, inject_feedback: true, max_feedback: 1},
            verify_completion_judge: {model: "mock-judge", max_invocations: 1},
            turn_end_condition: {model: "mock-judge", cadence: {when: "stalled"}},
          },
        ) },
      )
      const stalls = events_of(captured.events, "agent_loop_stall_warning")
      const judges = events_of(captured.events, "judge_decision")
      const receipts = captured.events.filter(
        { event ->
          event.type == "typed_checkpoint"
            && event?.checkpoint?.schema
              == "harn.completion_directive_receipt.v1"
        },
      )
        .to_list()
      const feedback = events_of(captured.events, "feedback_injected").filter(
        { event -> event?.kind == "verify_completion" },
      )
        .to_list()
      const messages = json_stringify(agent_session_visible_messages(harness.agent, session))
      harness.stdio.println(captured.result.status)
      harness.stdio.println(len(stalls))
      harness.stdio.println(len(judges))
      harness.stdio.println(judges[0].trigger)
      harness.stdio.println(judges[0].verdict)
      harness.stdio.println(
        "completion.invocations=" + to_string(captured.result.completion_judge.invocations),
      )
      harness.stdio.println(
        "completion.vetoes=" + to_string(captured.result.completion_judge.vetoes),
      )
      harness.stdio.println(
        "completion.max=" + to_string(captured.result.completion_judge.max_invocations),
      )
      harness.stdio.println(
        "completion.cap_reached=" + to_string(captured.result.completion_judge.cap_reached),
      )
      harness.stdio.println(
        "done.cap_reached=" + to_string(captured.result.turn_end_condition.cap_reached),
      )
      harness.stdio.println(tool_message_count(harness.agent, session))
      harness.stdio.println(dispatches)
      harness.stdio.println(contains(messages, "Stall diagnostic"))
      // The whole detail, verbatim: the compact verdict carries one field, so
      // what the judge said is exactly what the next turn must receive.
      harness.stdio.println(contains(messages, "Change approach on the next turn."))
      harness.stdio.println(receipts[0].checkpoint.feedback_delivery)
      harness.stdio.println(len(feedback))
      harness.stdio.println(len(harness.llm.mock_calls()))
    },
  )
  let other_tools = tool_registry()
  other_tools = tool_define(
    other_tools,
    "noop",
    "Return the same harmless result",
    {
      handler: { _args -> return "noop" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "noopA", name: "noop", arguments: {}}]},
      {text: "", tool_calls: [{id: "noopB", name: "noop", arguments: {}}]},
    ],
    { ->
      const other_session = "stall-judge-other-" + harness.random.uuid()
      const other = agent_capture_events(
        harness.agent,
        other_session,
        fn() { return agent_loop(
          harness,
          "Do not run a stall judge for non-stalled cadence.",
          nil,
          {
            provider: "mock",
            tools: other_tools,
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 2,
            session_id: other_session,
            stall_diagnostics: {threshold: 2, inject_feedback: true, max_feedback: 1},
            turn_end_condition: {model: "mock-judge", cadence: {when: "always"}},
          },
        ) },
      )
      harness.stdio.println(other.result.status)
      harness.stdio.println(len(events_of(other.events, "agent_loop_stall_warning")))
      harness.stdio.println(len(events_of(other.events, "judge_decision")))
      harness.stdio.println(tool_message_count(harness.agent, other_session))
    },
  )
}
