import "std/agents"
import { llm_text, with_llm_script } from "std/testing"
import "std/triggers"

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {
        tool_calls: [
          {
            id: "park_until_review",
            name: "agent_await_resumption",
            arguments: {
              reason: "waiting on review",
              conditions: {trigger: {kind: "review.approved", provider: "webhook"}},
            },
          },
        ],
        input_tokens: 7,
        output_tokens: 3,
      },
      llm_text("resumed after review"),
    ],
    { ->
      const handle = sub_agent_run(harness, "Park until review approval.",
        {provider: "mock", background: true, tool_format: "native", max_iterations: 3},
      )
      const suspended = wait_agent(harness.agent, handle)
      const trigger_handle = suspended?.suspension?.auto_resume_trigger
      harness.stdio.println(suspended?.status)
      harness.stdio.println(trigger_handle?.id != nil)
      harness.stdio.println(trigger_handle?.version != nil)
      const fired: DispatchHandle = harness.runtime.trigger_fire(
        trigger_handle,
        {
          provider: "webhook",
          kind: "review.approved",
          payload: {decision: "approved"},
          headers: {x_delivery: "auto-resume-conformance"},
        },
      )
      harness.stdio.println(fired.status)
      const resumed = wait_agent(harness.agent, handle)
      harness.stdio.println(resumed?.status)
      harness.stdio.println(contains(resumed?.task ?? "", "approved"))
    },
  )
}
