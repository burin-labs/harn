import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("<user_response>Too thin.</user_response>\n<done>##DONE##</done>"),
      llm_text(
        "{\"action\":\"continue\",\"reason\":\"answer lacks detail\",\"repair\":\"Answer with the concrete result.\",\"specific_gaps\":[],\"accepted_evidence\":[]}",
      ),
      llm_text("<user_response>The concrete result is 4.</user_response>\n<done>##DONE##</done>"),
      llm_text(
        "{\"action\":\"accept\",\"reason\":\"the result is explicit\",\"repair\":\"\",\"specific_gaps\":[],\"accepted_evidence\":[]}",
      ),
    ],
    { ->
      const result = agent_loop(
        harness,
        "What is 2 + 2?",
        nil,
        {provider: "mock", loop_until_done: true, max_iterations: 4, done_judge: true},
      )
      harness.stdio.println(result.status)
      harness.stdio.println(result.visible_text)
      harness.stdio.println(result.llm.iterations)
      const calls = harness.llm.mock_calls()
      harness.stdio.println(len(calls))
      harness.stdio.println(!json_stringify(calls[1].messages).contains("{{"))
      harness.stdio.println(json_stringify(calls[3].messages).contains("The concrete result is 4."))
    },
  )
}
