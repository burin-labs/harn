// A completion judge is a gate: when it cannot run, an unverified completion
// claim must not become `done`. The bounded invocation cap remains the escape
// hatch, and terminates with an attributable unverified result.
import { agent_loop } from "std/agent/loop"
import { agent_loop_options } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("First completion claim. ##DONE##"),
      {error: {category: "generic", message: "structured output is unavailable"}},
      llm_text("Second completion claim. ##DONE##"),
    ],
    { ->
      const options = agent_loop_options(
        harness,
        {
          provider: "mock",
          loop_until_done: true,
          max_iterations: 3,
          done_judge: {max_invocations: 1},
        },
      )
      const result = agent_loop(
        harness,
        "Finish only after the completion judge verifies the claim.",
        nil,
        options,
      )
      harness.stdio.println("status=${result.status}")
      harness.stdio.println("stop_reason=${result.stop_reason}")
      harness.stdio.println("judge_invocations=${result.done_judge.invocations}")
      harness.stdio.println("judge_cap_reached=${result.done_judge.cap_reached}")
      harness.stdio.println("provider_calls=${len(harness.llm.mock_calls())}")
    },
  )
}
