import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { llm_calls, llm_text, with_llm_script } from "std/testing"

/**
 * The step judge's `verdict` set is a schema enum, so the typed-output
 * checkpoint refuses an out-of-set verdict. The refusal takes the documented
 * judge-error path: with the default `fail_open` the turn proceeds and the
 * emitted `step_judge_decision` carries `judge_error: true` and
 * `reason: "judge_unavailable"`, so it cannot be mistaken for an approval.
 */
pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("<user_response>2 + 2 = 4</user_response>\n<done>##DONE##</done>"),
      llm_text("{\"verdict\":\"looks_fine\",\"reasoning\":\"out of set\",\"critique\":\"\"}"),
    ],
    { ->
      const session = "step-judge-enum-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "What is 2 + 2?",
          nil,
          {
            provider: "mock",
            loop_until_done: true,
            max_iterations: 2,
            session_id: session,
            step_judge: {provider: "mock", on_veto: "replace"},
          },
        ) },
      )
      const judge_calls = llm_calls(harness.llm).filter(
        { call -> call?.output_format?.schema?.properties?.verdict != nil },
      )
      harness.stdio.println(len(judge_calls) > 0)
      harness.stdio.println(
        json_stringify(judge_calls[0].output_format.schema.properties.verdict.enum),
      )
      const decisions = captured.events.filter({ event -> event.type == "step_judge_decision" })
      harness.stdio.println(len(decisions))
      harness.stdio.println(decisions[0].judge_error)
      harness.stdio.println(decisions[0].reason)
      harness.stdio.println(decisions[0].vetoed)
    },
  )
}
