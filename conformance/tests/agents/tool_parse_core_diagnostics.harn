// What the parser TELLS the model when a call does not parse.
//
// Every diagnostic here costs the model a corrective turn, so each one has to
// name the real cause. The classes are distinct on purpose: an unknown name
// lists the registry and suggests the closest match; the `read` miss is aliased
// to `look` because that is always the answer; source code emitted where a call
// was expected is diagnosed as a missing content envelope rather than blamed on
// an unknown tool; a raw multi-line body teaches the heredoc recovery; and a
// parse failure inside the argument object carries a `Raw:` preview so the
// model can tell which of several on-screen calls failed.
import { probe, sample_registry } from "_tool_parse_probe"

pipeline main(harness: Harness) {
  // The name is not in the registry: report it, list every available tool, and
  // do not truncate the list for a small registry.
  probe(
    harness.agent,
    harness.stdio,
    "unknown tool name",
    "fictitious_tool({ x: 1 })",
    sample_registry(),
  )
  // The same unknown name alongside a call that DOES parse. The valid call
  // still dispatches.
  probe(
    harness.agent,
    harness.stdio,
    "unknown tool name beside a valid call",
    """fictitious_tool({ x: 1 })
edit({ action: "create", path: "a.go" })""",
    sample_registry(),
  )
  // `read` is the highest-frequency real miss and the answer is always
  // `look({ intent: "read" })`, so the alias hint names that.
  probe(
    harness.agent,
    harness.stdio,
    "read is aliased to look",
    "read({ path: \"a.go\" })",
    sample_registry(),
  )
  // The model emitted its own test/source code where a call was expected. The
  // cause is a missing heredoc/content envelope, not an unknown tool.
  probe(harness.agent, harness.stdio, "source code: it", "it({ x: 1 })", sample_registry())
  probe(harness.agent, harness.stdio, "source code: expect", "expect({ x: 1 })", sample_registry())
  probe(
    harness.agent,
    harness.stdio,
    "source code: describe",
    "describe({ x: 1 })",
    sample_registry(),
  )
  probe(
    harness.agent,
    harness.stdio,
    "source code: assertServiceCount",
    "assertServiceCount({ x: 1 })",
    sample_registry(),
  )
  // A genuine close-miss typo still gets the suggestion, not the source-code
  // message.
  probe(
    harness.agent,
    harness.stdio,
    "close miss typo",
    "edt({ action: \"create\" })",
    sample_registry(),
  )
  // `Label: known_tool(...)` where the label is not in the strip allowlist is
  // ambiguous. It must not silently execute, and the diagnostic names both the
  // observed prefix and the fix.
  probe(
    harness.agent,
    harness.stdio,
    "unknown label prefix on a known tool",
    "Hint: run({ command: \"ls\" })",
    sample_registry(),
  )
  // The guardrail against false positives: the same prefix shape where the
  // identifier is NOT a known tool must not fire the near-miss diagnostic.
  probe(
    harness.agent,
    harness.stdio,
    "unknown label prefix on an unknown identifier",
    "Note: make_coffee({ strength: \"strong\" })",
    sample_registry(),
  )
  // A raw multi-line body pasted after `content:` is the dominant cause of
  // "unexpected character starting a value" from weak models. The error must
  // name the heredoc recovery and show the `<<` marker.
  probe(
    harness.agent,
    harness.stdio,
    "raw multi-line body teaches the heredoc",
    """edit({ action: "replace_range", path: "a.zig", content: // helper
} })""",
    sample_registry(),
  )
  // Truncated mid-object: the model hit its token limit before the closing
  // brace. The diagnostic names the tool.
  probe(
    harness.agent,
    harness.stdio,
    "unclosed object literal",
    "edit({ action: \"create\", path: \"a.go\", content: `hello",
    sample_registry(),
  )
  // A bare scalar argument is nudged toward object-literal syntax.
  probe(harness.agent, harness.stdio, "bare scalar argument", "edit(\"a.go\")", sample_registry())
  // A malformed object literal carries a `Raw:` preview of the offending span.
  probe(
    harness.agent,
    harness.stdio,
    "object literal parse error preview",
    "edit({ action: })",
    sample_registry(),
  )
  // The legacy named-argument call form is rejected in favour of strict
  // object-literal syntax.
  probe(
    harness.agent,
    harness.stdio,
    "legacy named argument form",
    "edit(action=\"replace_body\", path=\"a.go\", new_body=`return 1`)",
    sample_registry(),
  )
  // Over-recovery guard for the omitted-`)` rescue: a complete object followed
  // by stray words is a hard parse error, not a recoverable call.
  probe(
    harness.agent,
    harness.stdio,
    "omitted paren recovery rejects trailing garbage",
    "edit({ action: \"create\", path: \"a.rs\" } and then some stray words",
    sample_registry(),
  )
  // An unregistered name abutting an object literal, in the brace shape. The
  // paren shape has always reported this; the brace shape returned the payload
  // as prose in silence, so the turn carried a dropped call nobody could see.
  probe(
    harness.agent,
    harness.stdio,
    "unknown tool name in the brace shape",
    "fictitious_tool{ \"x\": 1 }",
    sample_registry(),
  )
  // The same two shapes written inside a line of prose, which is where a call
  // is read as narration. Nothing dispatches from either — the diagnostic is
  // the whole remedy, and the prose keeps the payload verbatim.
  probe(
    harness.agent,
    harness.stdio,
    "unknown tool name abutting a sentence",
    "I'll look at the diff.fictitious_tool{ \"x\": 1 }",
    sample_registry(),
  )
  probe(
    harness.agent,
    harness.stdio,
    "known tool abutting a sentence",
    "I'll look at the diff.run({ command: \"ls\" })",
    sample_registry(),
  )
  // The guardrail: a tool name mentioned in prose with no argument object is
  // narration and must stay silent, at any position.
  probe(
    harness.agent,
    harness.stdio,
    "tool name mentioned in prose",
    "I'll use run to list the directory, then edit the file.",
    sample_registry(),
  )
  // The guardrail for ordinary code in an answer: a function call or struct
  // literal that abuts an object literal is code, not a dropped tool call, so
  // it raises nothing and the answer survives as prose.
  probe(
    harness.agent,
    harness.stdio,
    "code call in a fence",
    "Here is the hook:\n```js\nconst [s, setS] = useState({ a: 1 })\n```\nThat keeps state.",
    sample_registry(),
  )
  probe(
    harness.agent,
    harness.stdio,
    "code call in prose",
    "Call it as useState({ a: 1 }) in the component.",
    sample_registry(),
  )
  probe(
    harness.agent,
    harness.stdio,
    "struct literal in a fence",
    "```rust\nlet p = Point{ x: 1, y: 2 };\n```",
    sample_registry(),
  )
}
