import { with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {
        tool_calls: [
          {
            id: "bad_await",
            name: "agent_await_resumption",
            arguments: {reason: "waiting on review", conditions: {trigger: "review.approved"}},
          },
        ],
        input_tokens: 7,
        output_tokens: 3,
      },
      {text: "Recovered. ##DONE##", input_tokens: 5, output_tokens: 2},
    ],
    { ->
      const result = agent_loop(harness, "Finish without parking.",
        nil,
        {
          provider: "mock",
          tool_format: "native",
          loop_until_done: true,
          done_sentinel: "##DONE##",
          max_iterations: 3,
        },
      )
      const calls = harness.llm.mock_calls()
      const followup = json_stringify(calls[1]?.messages ?? [])
      harness.stdio.println(result.status)
      harness.stdio.println(len(calls))
      harness.stdio.println(contains(followup, "HARN-SUS-002"))
      harness.stdio.println(contains(followup, "conditions.trigger"))
    },
  )
}
