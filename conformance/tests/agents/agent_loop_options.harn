import { agent_loop_options } from "std/agent/options"
import { assert_eq } from "std/testing"

pipeline default(harness: Harness) {
  // No explicit tool_format: resolves the GLOBAL text-channel default, now
  // fenced-json (`json`), not heredoc (`text`).
  const no_tools = agent_loop_options(harness, {provider: "mock"})
  harness.stdio.println(no_tools.tool_format)
  harness.stdio.println(contains(no_tools.keys(), "turn_end_condition"))
  harness.stdio.println(contains(no_tools.keys(), "verify_completion_judge"))
  const judged = agent_loop_options(
    harness,
    {provider: "mock", tools: tool_registry(), turn_end_condition: {model: "mock-judge"}},
  )
  harness.stdio.println(judged.done_sentinel)
  harness.stdio.println(type_of(judged.turn_end_condition))
  const disabled_judges = agent_loop_options(
    harness,
    {provider: "mock", turn_end_condition: false, verify_completion_judge: false},
  )
  require disabled_judges.turn_end_condition == nil, "false disables turn_end_condition"
  require disabled_judges.verify_completion_judge == nil, "false disables completion judge"
  const client_search = agent_loop_options(
    harness,
    {provider: "mock", tools: tool_registry(), tool_search: {mode: "client"}},
  )
  harness.stdio.println(client_search.tool_format)
  const explicit_native = agent_loop_options(
    harness,
    {provider: "mock", tools: tool_registry(), tool_format: "native"},
  )
  harness.stdio.println(explicit_native.tool_format)
  harness.stdio.println(contains(explicit_native.keys(), "done_sentinel"))
  const persistent_native = agent_loop_options(
    harness,
    {provider: "mock", tools: tool_registry(), tool_format: "native", loop_until_done: true},
  )
  harness.stdio.println(persistent_native.done_sentinel == nil)
  const judged_native = agent_loop_options(
    harness,
    {
      provider: "mock",
      tools: tool_registry(),
      tool_format: "native",
      loop_until_done: true,
      turn_end_condition: {model: "mock-judge"},
    },
  )
  harness.stdio.println(judged_native.done_sentinel == nil)
  harness.stdio.println(contains(no_tools.keys(), "task_ledger"))
  const shorthand = agent_loop_options(
    harness,
    {provider: "mock", root_task: " Build feature ", deliverables: ["Write code", "", "Run tests"]},
  )
  harness.stdio.println(shorthand.task_ledger.root_task)
  harness.stdio.println(len(shorthand.task_ledger.deliverables))
  harness.stdio.println(shorthand.task_ledger.deliverables[0].id)
  harness.stdio.println(shorthand.task_ledger.deliverables[0].status)
  harness.stdio.println(shorthand.task_ledger.deliverables[1].id)
  const explicit_ledger = agent_loop_options(
    harness,
    {
      provider: "mock",
      root_task: "ignored",
      deliverables: ["ignored"],
      task_ledger: {
        root_task: "explicit",
        deliverables: [{id: "custom", text: "Use caller ledger", status: "done"}],
        rationale: "caller-owned",
        observations: ["observed"],
      },
    },
  )
  harness.stdio.println(explicit_ledger.task_ledger.root_task)
  harness.stdio.println(explicit_ledger.task_ledger.deliverables[0].id)
  const default_transport = agent_loop_options(harness, {provider: "mock"})
  assert_eq(default_transport._llm_caller_transport, {forwards_assistant_prefill: false})
  const prefill_transport = agent_loop_options(
    harness,
    {provider: "mock", llm_caller_transport: {forwards_assistant_prefill: true}},
  )
  assert_eq(prefill_transport._llm_caller_transport, {forwards_assistant_prefill: true})
  const invalid_prefill = try {
    agent_loop_options(
      harness,
      {provider: "mock", llm_caller_transport: {forwards_assistant_prefill: "yes"}},
    )
  }
  assert_eq(is_err(invalid_prefill), true)
  assert_eq(
    to_string(unwrap_err(invalid_prefill)),
    "agent_loop: `llm_caller_transport.forwards_assistant_prefill` must be a bool; got string",
  )
  const invalid_transport = try {
    agent_loop_options(harness, {provider: "mock", llm_caller_transport: true})
  }
  assert_eq(is_err(invalid_transport), true)
  assert_eq(
    to_string(unwrap_err(invalid_transport)),
    "agent_loop: `llm_caller_transport` must be a dict or nil; got bool",
  )
  for case in [
    {
      options: {provider: "mock", turn_end_condition: {model: "mock-judge", fail_open: true}},
      removed: "turn_end_condition.fail_open",
      replacement: "completion judges always fail closed",
    },
    {
      options: {provider: "mock", turn_end_condition: {model: "mock-judge", fail_open_on_error: true}},
      removed: "turn_end_condition.fail_open_on_error",
      replacement: "completion judges always fail closed",
    },
    {
      options: {provider: "mock", turn_end_condition: {model: "mock-judge", max_feedback: 2}},
      removed: "turn_end_condition.max_feedback",
      replacement: "max_invocations",
    },
    {
      options: {provider: "mock", verify_completion_judge: {model: "mock-judge", fail_open: true}},
      removed: "verify_completion_judge.fail_open",
      replacement: "completion judges always fail closed",
    },
    {
      options: {provider: "mock", verify_completion_judge: {model: "mock-judge", fail_open_on_error: true}},
      removed: "verify_completion_judge.fail_open_on_error",
      replacement: "completion judges always fail closed",
    },
    {
      options: {provider: "mock", verify_completion_judge: {model: "mock-judge", max_feedback: 2}},
      removed: "verify_completion_judge.max_feedback",
      replacement: "max_invocations",
    },
    {
      options: {provider: "mock", turn_end_condition: {model: "mock-judge", enabled: false}},
      removed: "turn_end_condition.enabled",
      replacement: "turn_end_condition` to false",
    },
    {
      options: {provider: "mock", verify_completion_judge: {model: "mock-judge", enabled: false}},
      removed: "verify_completion_judge.enabled",
      replacement: "verify_completion_judge` to false",
    },
  ] {
    const rejected = try {
      agent_loop_options(harness, case.options)
    }
    require is_err(rejected), "removed judge option must fail"
    const message = to_string(unwrap_err(rejected))
    require contains(message, case.removed), "error names removed judge option"
    require contains(message, case.replacement), "error names replacement judge option"
  }
  const invalid_expose_decisions = try {
    agent_loop_options(
      harness,
      {provider: "mock", iteration_budget: {mode: "adaptive", expose_decisions: "yes"}},
    )
  }
  harness.stdio.println(is_err(invalid_expose_decisions))
  harness.stdio.println(
    contains(to_string(unwrap_err(invalid_expose_decisions)), "expose_decisions"),
  )
}
