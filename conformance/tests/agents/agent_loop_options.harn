import { agent_loop_options } from "std/agent/options"

pipeline default() {
  // No explicit tool_format: resolves the GLOBAL text-channel default, now
  // fenced-json (`json`), not heredoc (`text`).
  const no_tools = agent_loop_options({provider: "mock"})
  __io_println(no_tools.tool_format)
  __io_println(contains(no_tools.keys(), "done_judge"))
  __io_println(contains(no_tools.keys(), "verify_completion_judge"))
  const judged = agent_loop_options({provider: "mock", tools: tool_registry(), done_judge: true})
  __io_println(judged.done_sentinel)
  __io_println(type_of(judged.done_judge))
  const client_search = agent_loop_options({provider: "mock", tools: tool_registry(), tool_search: {mode: "client"}})
  __io_println(client_search.tool_format)
  const explicit_native = agent_loop_options({provider: "mock", tools: tool_registry(), tool_format: "native"})
  __io_println(explicit_native.tool_format)
  __io_println(contains(explicit_native.keys(), "done_sentinel"))
  const persistent_native = agent_loop_options(
    {provider: "mock", tools: tool_registry(), tool_format: "native", loop_until_done: true},
  )
  __io_println(persistent_native.done_sentinel == nil)
  const judged_native = agent_loop_options(
    {
      provider: "mock",
      tools: tool_registry(),
      tool_format: "native",
      loop_until_done: true,
      done_judge: true,
    },
  )
  __io_println(judged_native.done_sentinel == nil)
  __io_println(contains(no_tools.keys(), "task_ledger"))
  const shorthand = agent_loop_options(
    {provider: "mock", root_task: " Build feature ", deliverables: ["Write code", "", "Run tests"]},
  )
  __io_println(shorthand.task_ledger.root_task)
  __io_println(len(shorthand.task_ledger.deliverables))
  __io_println(shorthand.task_ledger.deliverables[0].id)
  __io_println(shorthand.task_ledger.deliverables[0].status)
  __io_println(shorthand.task_ledger.deliverables[1].id)
  const explicit_ledger = agent_loop_options(
    {
      provider: "mock",
      root_task: "ignored",
      deliverables: ["ignored"],
      task_ledger: {
        root_task: "explicit",
        deliverables: [{id: "custom", text: "Use caller ledger", status: "done"}],
        rationale: "caller-owned",
        observations: ["observed"],
      },
    },
  )
  __io_println(explicit_ledger.task_ledger.root_task)
  __io_println(explicit_ledger.task_ledger.deliverables[0].id)
  const default_transport = agent_loop_options({provider: "mock"})
  require default_transport._llm_caller_transport == {forwards_assistant_prefill: false}
  const prefill_transport = agent_loop_options({provider: "mock", llm_caller_transport: {forwards_assistant_prefill: true}})
  require prefill_transport._llm_caller_transport == {forwards_assistant_prefill: true}
  const invalid_prefill = try {
    agent_loop_options({provider: "mock", llm_caller_transport: {forwards_assistant_prefill: "yes"}})
  }
  require is_err(invalid_prefill)
  require to_string(unwrap_err(invalid_prefill))
    == "agent_loop: `llm_caller_transport.forwards_assistant_prefill` must be a bool; got string"
  const invalid_transport = try {
    agent_loop_options({provider: "mock", llm_caller_transport: true})
  }
  require is_err(invalid_transport)
  require to_string(unwrap_err(invalid_transport))
    == "agent_loop: `llm_caller_transport` must be a dict or nil; got bool"
  const invalid_expose_decisions = try {
    agent_loop_options(
      {provider: "mock", iteration_budget: {mode: "adaptive", expose_decisions: "yes"}},
    )
  }
  __io_println(is_err(invalid_expose_decisions))
  __io_println(contains(to_string(unwrap_err(invalid_expose_decisions)), "expose_decisions"))
}
