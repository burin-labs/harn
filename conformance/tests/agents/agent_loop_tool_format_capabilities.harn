import { agent_loop } from "std/agent/loop"
import { agent_capture_events } from "std/agent/events"

fn sample_tools() {
  const tools = tool_registry()
  return tool_define(
    tools,
    "noop",
    "Return a deterministic result",
    {
      handler: { _args -> return "ok" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
}

fn format_echo_caller() {
  return { call ->
    const format = to_string(call?.opts?.tool_format ?? "")
    return {
      ok: true,
      value: {
        text: "format=" + format,
        provider: call?.opts?.provider ?? "",
        model: call?.opts?.model ?? "",
        input_tokens: 0,
        output_tokens: 0,
      },
    }
  }
}

fn run_format(harness: Harness, options) {
  return agent_loop(harness, "Report the selected format.",
    nil,
    options
      + {
      tools: sample_tools(),
      llm_caller: format_echo_caller(),
      max_iterations: 1,
      done_judge: false,
    },
  )
}

fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

fn transcript_events_of(result, kind) {
  return transcript_events(result?.transcript).filter({ event -> event.kind == kind })
}

pipeline default(harness: Harness) {
  harness.llm.provider_capabilities_install(
    """
[[provider.testcatalog]]
model_match = "catalogued-*"
native_tools = true
preferred_tool_format = "native"
tool_mode_parity = "interchangeable"

[[provider.testcatalog]]
model_match = "native-unreliable-*"
native_tools = true
preferred_tool_format = "text"
tool_mode_parity = "native_unreliable"
""",
  )
  defer {
    harness.llm.provider_capabilities_clear()
  }
  const preferred_session = "tool-format-preferred-" + harness.random.uuid()
  const preferred = agent_capture_events(harness, preferred_session,
    fn() { return run_format(harness,
      {provider: "testcatalog", model: "catalogued-native", session_id: preferred_session},
    ) },
  )
  harness.stdio.println(preferred.result.text)
  harness.stdio.println(len(events_of(preferred.events, "capability_gap")))
  const auto_session = "tool-format-auto-" + harness.random.uuid()
  const auto = agent_capture_events(harness, auto_session,
    fn() { return run_format(harness,
      {
        provider: "testcatalog",
        model: "catalogued-native",
        session_id: auto_session,
        tool_format: "auto",
      },
    ) },
  )
  harness.stdio.println(auto.result.text)
  harness.stdio.println(len(events_of(auto.events, "capability_gap")))
  const fallback_session = "tool-format-fallback-" + harness.random.uuid()
  const fallback = agent_capture_events(harness, fallback_session,
    fn() { return run_format(harness,
      {provider: "testcatalog", model: "uncatalogued-model", session_id: fallback_session},
    ) },
  )
  // An uncatalogued model has no preferred_tool_format, so resolution falls
  // back to the GLOBAL text-channel default (now fenced-json, `json`) and emits
  // a capability_gap whose fallback_tool_format is `json` (was heredoc `text`).
  const gaps = events_of(fallback.events, "capability_gap")
  harness.stdio.println(fallback.result.text)
  harness.stdio.println(len(gaps))
  harness.stdio.println(gaps[0].level)
  harness.stdio.println(gaps[0].provider)
  harness.stdio.println(gaps[0].model)
  harness.stdio.println(gaps[0].capability)
  harness.stdio.println(gaps[0].fallback_tool_format)
  const override_session = "tool-format-override-" + harness.random.uuid()
  const override_capture = agent_capture_events(harness, override_session,
    fn() { return run_format(harness,
      {
        provider: "testcatalog",
        model: "catalogued-native",
        session_id: override_session,
        tool_format: "text",
      },
    ) },
  )
  const override_events = transcript_events_of(override_capture.result, "tool_format_override")
  harness.stdio.println(override_capture.result.text)
  harness.stdio.println(len(override_events))
  harness.stdio.println(override_events[0].metadata?.provider)
  harness.stdio.println(override_events[0].metadata?.model)
  harness.stdio.println(override_events[0].metadata?.requested_format)
  harness.stdio.println(override_events[0].metadata?.recommended_format)
  harness.stdio.println(override_events[0].metadata?.catalog_parity)
  harness.stdio.println(override_events[0].metadata?.override_reason == nil)
  const missing_reason_session = "tool-format-native-unreliable-missing-" + harness.random.uuid()
  const missing_reason = agent_capture_events(harness, missing_reason_session,
    fn() { return run_format(harness,
      {
        provider: "testcatalog",
        model: "native-unreliable-route",
        session_id: missing_reason_session,
        tool_format: "native",
      },
    ) },
  )
  const missing_reason_events = transcript_events_of(missing_reason.result, "tool_format_override")
  harness.stdio.println(missing_reason.result.text)
  harness.stdio.println(len(missing_reason_events))
  harness.stdio.println(missing_reason_events[0].metadata?.requested_format)
  harness.stdio.println(missing_reason_events[0].metadata?.recommended_format)
  harness.stdio.println(missing_reason_events[0].metadata?.catalog_parity)
  harness.stdio.println(missing_reason_events[0].metadata?.override_reason == nil)
  const with_reason_session = "tool-format-native-unreliable-reason-" + harness.random.uuid()
  const with_reason = agent_capture_events(harness, with_reason_session,
    fn() { return run_format(harness,
      {
        provider: "testcatalog",
        model: "native-unreliable-route",
        session_id: with_reason_session,
        tool_format: "native",
        tool_format_override_reason: "cross-check native parser drift",
      },
    ) },
  )
  const with_reason_events = transcript_events_of(with_reason.result, "tool_format_override")
  harness.stdio.println(with_reason.result.text)
  harness.stdio.println(len(with_reason_events))
  harness.stdio.println(with_reason_events[0].metadata?.requested_format)
  harness.stdio.println(with_reason_events[0].metadata?.recommended_format)
  harness.stdio.println(with_reason_events[0].metadata?.catalog_parity)
  harness.stdio.println(with_reason_events[0].metadata?.override_reason)
}
