import { sub_agent_request, sub_agent_run, wait_agent } from "std/agent/workers"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn child_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "search",
    "Search the repo",
    {
      handler: { args -> "search result for " + args.query },
      parameters: {query: {type: "string"}},
      returns: {type: "string"},
    },
  )
  tools = tool_define(
    tools,
    "read",
    "Read a file",
    {
      handler: { args -> "file contents from " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
    },
  )
  return tools
}

fn parent_tools(harness: Harness) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate",
    "Run a sub-agent",
    {
      handler: { args ->
        sub_agent_run(harness, args.task,
          {
            provider: "mock",
            tools: child_tools(),
            allowed_tools: ["search", "read"],
            tool_format: "native",
            max_iterations: 3,
          },
        )
      },
      parameters: {task: {type: "string"}},
      returns: {type: "object"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "parent_1", name: "delegate", arguments: {task: "Find the config path"}}]},
      {tool_calls: [{id: "child_1", name: "search", arguments: {query: "config path"}}]},
      {tool_calls: [{id: "child_2", name: "read", arguments: {path: "crates/harn-vm/src/lib.rs"}}]},
      llm_text("The config path is crates/harn-vm/src/lib.rs"),
      llm_text("Delegation complete."),
    ],
    { ->
      const result = agent_loop(harness, "Investigate the config path",
        "You are helpful.",
        {provider: "mock", tools: parent_tools(harness), tool_format: "native", max_iterations: 2},
      )
      const stats = transcript_stats(result?.transcript)
      const transcript = json_stringify(transcript_messages(result?.transcript))
      harness.stdio.println(stats?.tool_call_count == 1)
      harness.stdio.println(stats?.tool_result_message_count == 1)
      harness.stdio.println(contains(transcript, "delegate"))
      harness.stdio.println(!contains(transcript, "\"search\""))
      harness.stdio.println(!contains(transcript, "\"read\""))
    },
  )
}
