import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { llm_calls, llm_text, with_llm_script } from "std/testing"

/**
 * An unavailable step judge must be LOUD, never a silent pass.
 *
 * When the step judge cannot review a turn, the turn still PROCEEDS (a
 * reviewer outage must not block the agent), but the emitted
 * `step_judge_decision` says `verdict: "unavailable"` with `judge_error`,
 * a typed `unavailable_reason` and a running `unavailable_count`.
 *
 * Case 1: the judge model errors -> `provider_error`.
 * Case 2 (control): a real `pass` carries no unavailable marker.
 * Case 3: the judge is a label-only decision model (Jev). It can never fill
 * the verdict schema, so the judge refuses before dispatch with
 * `schema_unsupported` on step 1, spends no judge call, and the count climbs
 * on every later step instead of reading as N silent passes.
 */
fn events_of(events: any, kind: string) {
  return events.filter({ event -> event.type == kind })
}

fn judge_decisions(captured: dict) {
  return events_of(captured.events, "step_judge_decision")
}

pipeline default(harness: Harness) {
  // --- Case 1: the judge model errors -> fail-open, but marked unavailable.
  with_llm_script(
    harness.llm,
    [
      llm_text("<user_response>2 + 2 = 4</user_response>\n<done>##DONE##</done>"),
      {error: {category: "generic", message: "judge backend 503"}},
    ],
    { ->
      const session = "step-judge-unavail-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "What is 2 + 2?",
          nil,
          {
            provider: "mock",
            loop_until_done: true,
            max_iterations: 2,
            session_id: session,
            step_judge: {provider: "mock", on_veto: "replace"},
          },
        ) },
      )
      const decisions = judge_decisions(captured)
      const unavailable = decisions.filter({ d -> (d.judge_error ?? false) == true })
      harness.stdio.println(len(unavailable))
      harness.stdio.println(unavailable[0].reason)
      harness.stdio.println(unavailable[0].verdict)
      harness.stdio.println(unavailable[0].vetoed)
      harness.stdio.println(unavailable[0].unavailable_reason)
      harness.stdio.println(unavailable[0].unavailable_count)
    },
  )
  // --- Case 2 (control): a genuine pass carries NO judge_error marker.
  with_llm_script(
    harness.llm,
    [
      llm_text("<user_response>2 + 2 = 4</user_response>\n<done>##DONE##</done>"),
      llm_text(
        "{\"verdict\":\"pass\",\"reasoning\":\"correct\",\"critique\":\"\",\"confidence\":0.95}",
      ),
    ],
    { ->
      const session = "step-judge-pass-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "What is 2 + 2?",
          nil,
          {
            provider: "mock",
            loop_until_done: true,
            max_iterations: 2,
            session_id: session,
            step_judge: {provider: "mock", on_veto: "replace"},
          },
        ) },
      )
      const decisions = judge_decisions(captured)
      const unavailable = decisions.filter({ d -> (d.judge_error ?? false) == true })
      const passes = decisions.filter({ d -> d.verdict == "pass" })
      harness.stdio.println(len(unavailable))
      harness.stdio.println(len(passes) > 0)
    },
  )
  // --- Case 3: a label-only decision model is refused before dispatch.
  with_llm_script(
    harness.llm,
    [
      llm_text("Let me look at the arithmetic first."),
      llm_text("<user_response>2 + 2 = 4</user_response>\n<done>##DONE##</done>"),
    ],
    { ->
      const session = "step-judge-decision-only-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "What is 2 + 2?",
          nil,
          {
            provider: "mock",
            loop_until_done: true,
            max_iterations: 4,
            session_id: session,
            step_judge: {
              provider: "mock",
              model: "openrouter/typesafe/jev-latest",
              on_veto: "replace",
            },
          },
        ) },
      )
      const decisions = judge_decisions(captured)
      harness.stdio.println(len(decisions))
      harness.stdio.println(decisions[0].verdict)
      harness.stdio.println(decisions[0].unavailable_reason)
      harness.stdio.println(decisions.map({ d -> d.unavailable_count }))
      harness.stdio.println(len(decisions.filter({ d -> d.verdict == "pass" })))
      const judge_calls = llm_calls(harness.llm).filter(
        { call -> call?.output_format?.schema?.properties?.verdict != nil },
      )
      harness.stdio.println(len(judge_calls))
    },
  )
}
