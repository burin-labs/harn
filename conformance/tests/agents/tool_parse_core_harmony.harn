// Harmony / gpt-oss channel framing leaking into the text channel.
//
// When the native tool channel collapses into `content`, harmony-trained models
// emit their frame markers — `<|start|>`, `<|channel|>`, `<|message|>` — around
// or instead of a call. The parser consumes the framing structurally, salvages
// the call underneath, and keeps the analysis text as prose. It must not
// replay the frame tokens into canonical history, and it must not turn a leaked
// frame into the terminal stray-text diagnostic, which would burn the turn.
//
// The strictness is on the other side: a marker that is not a known harmony
// spelling stays an unknown top-level tag.
import { probe, sample_registry } from "_tool_parse_probe"

pipeline main() {
  // The Fireworks shape: a full frame header, then `tool_call to=NAME` and the
  // arguments as a second message segment.
  probe(
    "fireworks harmony tool_call to= header",
    "<|start|>assistant<|channel|>commentary<|message|>tool_call to=edit code<|message|>{\"action\":\"create\",\"path\":\"src/schema.zig\",\"content\":\"pub const ok = true;\"}",
    sample_registry(),
  )
  // The same leak reduced to just the message markers.
  probe(
    "bare harmony message leak",
    "<|message|>tool_call to=run code<|message|>{\"command\":\"zig test src/schema.zig\"}",
    sample_registry(),
  )
  // Canonical blocks around a harmony leak survive.
  probe(
    "canonical blocks around a harmony leak",
    """<assistant_prose>
Checking the Zig parser.
</assistant_prose>
<|message|>tool_call to=run code<|message|>{"command":"zig test src/schema.zig"}""",
    sample_registry(),
  )
  // The `to=` name is still registry-checked: an unknown one stays prose rather
  // than becoming a parser error.
  probe(
    "harmony tool_call names an unknown tool",
    "<|message|>tool_call to=unknown code<|message|>{\"command\":\"zig test\"}",
    sample_registry(),
  )
  // Full frames wrapped around an ordinary `<tool_call>` block: the frames are
  // consumed, the analysis channel becomes prose, the call dispatches.
  probe(
    "harmony frames around a tagged call",
    """<|start|>assistant<|channel|>analysis<|message|>I need to inspect the files first.<|end|><|start|>assistant<|channel|>commentary<|message|><tool_call>
edit({ action: "create", path: "a.rs", content: "a" })
</tool_call><|end|>""",
    sample_registry(),
  )
  // A batch where each block's close tag is corrupted into `</tool_call<|message|>`.
  probe(
    "harmony multicall batch with corrupted closes",
    """We need to inspect first.<tool_call>
edit({ "action": "create", "path": "a.rs", "content": "a" })
</tool_call<|message|><|start|>assistant<|channel|>analysis<|message|>Run the focused verifier.<tool_call>
run({ "command": "cargo test" })
</tool_call<|message|>""",
    sample_registry(),
  )
  // A malformed OPEN tag, `<tool_call<|message|>`, after a well-formed block.
  probe(
    "malformed harmony tool_call open",
    """<tool_call>
run({ "command": "cargo test -p core" })
</tool_call><tool_call<|message|>run({ "command": "cargo test -p app" })""",
    sample_registry(),
  )
  // A malformed assistant header, `<assistant<|channel|>`.
  probe(
    "malformed harmony assistant header",
    """<assistant<|channel|>analysis<|message|>We need to inspect the file.<tool_call>
run({ "command": "zig test src/root.zig" })
</tool_call>""",
    sample_registry(),
  )
  // A later `<|message|>` marker in prose must not swallow the call between it
  // and the header.
  probe(
    "malformed assistant header bounded before the call",
    """<assistant<|channel|>analysis
<tool_call>
run({ "command": "cargo test" })
</tool_call>
note: emit <|message|> only after the tool finishes""",
    sample_registry(),
  )
  probe(
    "frame header bounded before the call",
    """<|channel|>analysis
<tool_call>
run({ "command": "cargo test -p harn-vm" })
</tool_call>
note: literal <|message|> marker in prose""",
    sample_registry(),
  )
  // Harmony-looking bytes inside a heredoc ARGUMENT are data, not framing.
  probe(
    "harmony-like text inside a heredoc argument",
    """<tool_call>
edit({ action: "create", path: "a.rs", content: <<EOF
inline <assistant<|channel|>analysis<|message|>
<tool_call<|message|>
EOF
})
</tool_call>""",
    sample_registry(),
  )
  // An unrecognized marker spelling stays strict.
  probe(
    "unknown malformed harmony marker stays strict",
    """<assistant<|bogus|>analysis<|message|><tool_call>
run({ "command": "cargo test" })
</tool_call>""",
    sample_registry(),
  )
  probe(
    "empty malformed harmony marker stays strict",
    "<tool_call<||>run({ \"command\": \"cargo test\" })",
    sample_registry(),
  )
}
