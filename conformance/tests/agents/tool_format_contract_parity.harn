// Teach/accept parity for the openai-compat text-route format contract
// (burin-labs/burin-code#4809).
//
// Claim: every exemplar rendered by `agent_render_tool_call_exemplar` for a
// given `tool_format` is accepted by `agent_parse_tool_calls` under that same
// format, with the taught tool name and body content intact.
//
// Falsifier: an exemplar that parses to zero calls, a parse error, the wrong
// name, or a corrupted multiline body — or an adaptive pin that silently
// demotes to tagged text.
import { agent_render_tool_call_exemplar, agent_tool_call_paradigm } from "std/agent/preflight"
import { agent_parse_tool_calls } from "std/agent/primitives"
import { sample_registry } from "_tool_parse_probe"

fn __assert(stdio: HarnessStdio, label: string, ok: bool) {
  if !ok {
    throw "tool_format_contract_parity failed: ${label}"
  }
  stdio.println("ok ${label}")
}

pipeline main(harness: Harness) {
  const registry = sample_registry()
  const body = "fn main() {\n    println!(\"hi\");\n}"
  // --- text / heredoc lane -------------------------------------------------
  const text_paradigm = agent_tool_call_paradigm(harness.llm, {tool_format: "text"})
  __assert(harness.stdio, "text paradigm kind", text_paradigm.kind == "text")
  __assert(
    harness.stdio,
    "text body_hint teaches heredoc",
    contains(text_paradigm.body_hint, "heredoc"),
  )
  const text_ex = agent_render_tool_call_exemplar(
    harness.llm,
    "edit",
    [
      {key: "action", value: "create"},
      {key: "path", value: "t.rs"},
      {key: "content", value: body, body: true},
    ],
    {tool_format: "text"},
  )
  __assert(harness.stdio, "text exemplar opens <tool_call>", starts_with(text_ex, "<tool_call>"))
  __assert(harness.stdio, "text exemplar uses heredoc", contains(text_ex, "content: <<EOF\n"))
  const text_parsed = agent_parse_tool_calls(harness.agent, text_ex, registry, "text")
  __assert(harness.stdio, "text exemplar lands one call", len(text_parsed.tool_calls) == 1)
  __assert(
    harness.stdio,
    "text exemplar has no parse errors",
    len(text_parsed.tool_parse_errors) == 0,
  )
  __assert(harness.stdio, "text exemplar name is edit", text_parsed.tool_calls[0].name == "edit")
  __assert(
    harness.stdio,
    "text exemplar preserves body bytes",
    text_parsed.tool_calls[0].arguments.content == body,
  )
  // --- json / fenced lane --------------------------------------------------
  const json_paradigm = agent_tool_call_paradigm(harness.llm, {tool_format: "json"})
  __assert(harness.stdio, "json paradigm kind", json_paradigm.kind == "json")
  __assert(
    harness.stdio,
    "json body_hint teaches escaped strings",
    contains(json_paradigm.body_hint, "JSON string"),
  )
  const json_ex = agent_render_tool_call_exemplar(
    harness.llm,
    "edit",
    [
      {key: "action", value: "create"},
      {key: "path", value: "t.rs"},
      {key: "content", value: body, body: true},
    ],
    {tool_format: "json"},
  )
  __assert(harness.stdio, "json exemplar opens ```tool", starts_with(json_ex, "```tool\n"))
  __assert(
    harness.stdio,
    "json exemplar carries name field",
    contains(json_ex, "\"name\"") && contains(json_ex, "\"edit\""),
  )
  const json_parsed = agent_parse_tool_calls(harness.agent, json_ex, nil, "json")
  __assert(harness.stdio, "json exemplar lands one call", len(json_parsed.tool_calls) == 1)
  __assert(
    harness.stdio,
    "json exemplar has no parse errors",
    len(json_parsed.tool_parse_errors) == 0,
  )
  __assert(harness.stdio, "json exemplar name is edit", json_parsed.tool_calls[0].name == "edit")
  __assert(
    harness.stdio,
    "json exemplar preserves body bytes",
    json_parsed.tool_calls[0].arguments.content == body,
  )
  // --- accept set: the taught grammar is one, the accepted set is two -------
  //
  // We teach exactly one grammar per route and forgive the other on ARRIVAL.
  // A call written in the other grammar is still a call the model meant to
  // make; discarding it silently is burin-code#6388. The two grammars are
  // mutually unambiguous, so forgiving one costs no soundness — but every
  // forgiven accept must SAY so, or the drift that justified the pin goes
  // invisible.
  //
  // 1. Heredoc markup arriving on a json pin: accepted, normalized, evented.
  //    Measured exposure: burin-code's default eval model `local-qwen3.6`
  //    resolves to llamacpp `qwen3.6-35b-a3b-ud-q4-k-xl` (preferred=json,
  //    parity=text_only), and before this it parsed 0 heredoc calls with 0
  //    errors — a silent total drop.
  const wrong = agent_parse_tool_calls(harness.agent, text_ex, registry, "json")
  __assert(harness.stdio, "json pin accepts heredoc call", len(wrong.tool_calls) == 1)
  __assert(harness.stdio, "json pin keeps heredoc call name", wrong.tool_calls[0].name == "edit")
  __assert(
    harness.stdio,
    "json pin reports the recovery",
    wrong.protocol_violations.any({ entry -> entry.kind == "recovered_dialect" }),
  )
  // 2. Fenced JSON arriving on a text pin: accepted, normalized, evented.
  const fenced_call = "```tool\n{\"name\": \"edit\", \"args\": {\"path\": \"a.rs\"}}\n```"
  const fenced = agent_parse_tool_calls(harness.agent, fenced_call, registry, "text")
  __assert(harness.stdio, "text pin accepts fenced call", len(fenced.tool_calls) == 1)
  __assert(
    harness.stdio,
    "text pin reports the recovery",
    fenced.protocol_violations.any({ entry -> entry.kind == "recovered_dialect" }),
  )
  // 3. Soundness floor: a fence that does NOT open a call is prose, even when
  //    its body would parse and names a registered tool. The fence info is the
  //    only thing separating a call from documentation ABOUT a call, so a
  //    ```json example must never dispatch.
  const example =
    "Here is the shape:\n```json\n{\"name\": \"edit\", \"args\": {\"path\": \"a.rs\"}}\n```"
  const prose_only = agent_parse_tool_calls(harness.agent, example, registry, "text")
  __assert(
    harness.stdio,
    "text pin does not dispatch a ```json example",
    len(prose_only.tool_calls) == 0,
  )
  // 4. Mixed turn: declining to dispatch is not licence to go quiet. The turn
  //    already called correctly, so the fence is not acted on — but it is still
  //    reported and still steered, never a silent 0.
  const mixed = text_ex + "\n```tool\n{\"name\": \"edit\", \"args\": {\"path\": \"b.rs\"}}\n```"
  const mixed_parsed = agent_parse_tool_calls(harness.agent, mixed, registry, "text")
  __assert(harness.stdio, "mixed turn keeps the taught call", len(mixed_parsed.tool_calls) == 1)
  __assert(
    harness.stdio,
    "mixed turn still reports the declined fence",
    mixed_parsed.protocol_violations.any({ entry -> entry.kind == "wrong_tool_format" }),
  )
  // 5. Termination. The two recovery paths call each other — json hands
  //    `<tool_call>` markup to the tagged parser, and the tagged parser hands a
  //    ```tool fence back to json. The entry test on the json side is
  //    `contains(text, "<tool_call>")`, a plain SUBSTRING check, while only the
  //    scanner decides whether that substring is a tag or narration. This input
  //    puts both in one turn: a backticked mention of the wrapper (which the
  //    scanner may or may not lift out) sitting above a canonical fence.
  //
  //    It must terminate on BOTH pins. If it ever hangs, the guard in
  //    `__tool_parse_json`'s `recover_heredoc` parameter has been removed or
  //    routed around. Reaching the assertion at all is most of the claim; the
  //    call count pins that the guard bounds the recursion without eating the
  //    call the recursion was there to recover.
  const cycle =
    "Use the `<tool_call>` wrapper.\n```tool\n{\"name\": \"edit\", \"args\": {\"path\": \"a.rs\"}}\n```"
  const cycle_text = agent_parse_tool_calls(harness.agent, cycle, registry, "text")
  __assert(harness.stdio, "cycle bait terminates on a text pin", len(cycle_text.tool_calls) == 1)
  const cycle_json = agent_parse_tool_calls(harness.agent, cycle, registry, "json")
  __assert(harness.stdio, "cycle bait terminates on a json pin", len(cycle_json.tool_calls) == 1)
  // Deleted adaptive union must fail closed (never silent tagged demotion).
  const adaptive = agent_parse_tool_calls(harness.agent, text_ex, registry, "adaptive")
  __assert(harness.stdio, "adaptive lands no calls", len(adaptive.tool_calls) == 0)
  __assert(
    harness.stdio,
    "adaptive fails closed with guidance",
    len(adaptive.tool_parse_errors) == 1 && contains(adaptive.tool_parse_errors[0], "adaptive"),
  )
  harness.stdio.println("tool_format_contract_parity passed")
}
