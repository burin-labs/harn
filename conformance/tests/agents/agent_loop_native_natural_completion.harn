import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn lookup_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "lookup",
    "Return release evidence",
    {
      handler: { args -> "evidence for " + args.query },
      parameters: {query: {type: "string", description: "Lookup query"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      {tool_calls: [{id: "lookup_1", name: "lookup", arguments: {query: "release"}}]},
      llm_text("<user_response>Release notes are ready.</user_response>"),
      llm_text("{\"verdict\":\"done\",\"detail\":\"The natural final text is complete.\"}"),
    ],
    { ->
      const result = agent_loop(
        harness,
        "Inspect evidence and finish.",
        nil,
        {
          provider: "mock",
          tools: lookup_tools(),
          tool_format: "native",
          loop_until_done: true,
          turn_end_condition: true,
          max_iterations: 4,
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(result.status)
      harness.stdio.println(result.text)
      harness.stdio.println(result.llm.iterations)
      harness.stdio.println(len(calls))
      harness.stdio.println(!contains(calls[0].system, "##DONE##"))
      harness.stdio.println(!contains(calls[1].system, "##DONE##"))
      harness.stdio.println(!contains(calls[0].system, "<user_response>"))
      harness.stdio.println(contains(calls[0].system, "provider's native tool-calling channel"))
      harness.stdio.println(contains(json_stringify(calls[1].messages), "evidence for release"))
    },
  )
  with_llm_script(
    harness.llm,
    [llm_text("Plain final answer.")],
    { ->
      agent_loop(
        harness,
        "Finish without tools.",
        nil,
        {provider: "mock", tools: tool_registry(), tool_format: "native", max_iterations: 1},
      )
      const empty_calls = harness.llm.mock_calls()
      const empty_system = empty_calls[0].system ?? ""
      harness.stdio.println(!contains(empty_system, "Native tool protocol"))
      harness.stdio.println(!contains(empty_system, "<user_response>"))
    },
  )
}
