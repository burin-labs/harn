import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

/**
 * A prose-only no-progress hard stop gets one bounded recovery turn that tells
 * the model to convert its stated intent into an immediate tool call.
 */
fn toolset() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "look",
    "Read a file.",
    {
      handler: { args -> "contents of " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

fn look_call(id: string) {
  return {text: "", tool_calls: [{id: id, name: "look", arguments: {path: "app/Models/Entry.php"}}]}
}

fn events_of(events: any, kind: string) {
  return events.filter({ event -> event.type == kind })
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I should inspect APP models Entry PHP before editing!"),
      look_call("look_after_monologue"),
      llm_text("Read the Entry model. ##DONE##"),
    ],
    { ->
      const session = "monologue-recovery-conformance-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        turn_end_condition: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 1,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Edit the target file after inspecting it.", nil, opts) },
      )
      const receipts = events_of(captured.events, "typed_checkpoint").filter(
        { event -> event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1" },
      )
      const decisions = events_of(captured.events, "loop_control_decision").filter(
        { event -> event.reason == "monologue_recovery_continue" },
      )
      harness.stdio.println(captured.result.status)
      harness.stdio.println(contains(captured.result.tools.successful, "look"))
      harness.stdio.println(len(receipts))
      harness.stdio.println(receipts[0].checkpoint.reason)
      harness.stdio.println(receipts[0].checkpoint.warning.pattern)
      harness.stdio.println(receipts[0].checkpoint.tool_count)
      harness.stdio.println(len(decisions))
    },
  )
  with_llm_script(
    harness.llm,
    [
      llm_text("First I will inspect the Entry model."),
      llm_text("The controller determines which fields are written."),
      look_call("look_after_distinct_monologues"),
      llm_text("Inspection complete. ##DONE##"),
    ],
    { ->
      const session = "distinct-monologue-conformance-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        turn_end_condition: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 1,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Inspect the model and controller.", nil, opts) },
      )
      const warnings = events_of(captured.events, "agent_loop_stall_warning").filter(
        { event -> event.pattern == "no_progress_monologue" },
      )
      harness.stdio.println(captured.result.status)
      harness.stdio.println(contains(captured.result.tools.successful, "look"))
      harness.stdio.println(len(warnings))
    },
  )
}
