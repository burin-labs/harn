import { agent_capture_events } from "std/agent/events"
import { AgentLoopOptions } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

/**
 * A prose-only no-progress hard stop gets one bounded recovery turn that tells
 * the model to convert its stated intent into an immediate tool call.
 */
fn toolset() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "look",
    "Read a file.",
    {
      handler: { args -> "contents of " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

fn look_call(id) {
  return {text: "", tool_calls: [{id: id, name: "look", arguments: {path: "app/Models/Entry.php"}}]}
}

fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

pipeline default() {
  with_llm_script(
    [
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I still need to read the Entry model, but I am only narrating."),
      look_call("look_after_monologue"),
      llm_text("Read the Entry model. ##DONE##"),
    ],
    { ->
      const session = "monologue-recovery-conformance-" + uuid()
      const opts: AgentLoopOptions = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 1,
        },
      }
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop("Edit the target file after inspecting it.", nil, opts) },
      )
      const receipts = events_of(captured.events, "typed_checkpoint")
        .filter({ event -> event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1" })
      const decisions = events_of(captured.events, "loop_control_decision")
        .filter({ event -> event.reason == "monologue_recovery_continue" })
      __io_println(captured.result.status)
      __io_println(contains(captured.result.tools.successful, "look"))
      __io_println(len(receipts))
      __io_println(receipts[0].checkpoint.reason)
      __io_println(receipts[0].checkpoint.warning.pattern)
      __io_println(receipts[0].checkpoint.tool_count)
      __io_println(len(decisions))
    },
  )
}
