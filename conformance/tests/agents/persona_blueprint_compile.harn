import { persona_blueprint_compile, persona_blueprint_validate } from "std/personas/compiler"

pipeline main() {
  const digest = persona_blueprint_compile(
    {
      schema_version: "1",
      name: "reply_digest",
      description: "Summarizes follow-up work.",
      goal: "Surface replies and follow-ups every four hours.",
      template: "deterministic-sweeper",
      cron: {cron: "0 */4 * * *", timezone: "America/Los_Angeles"},
    },
  )
  __io_println(is_ok(digest))
  const digest_lowering = unwrap(digest)
  __io_println(digest_lowering.template)
  __io_println(digest_lowering.policy.autonomy_tier)
  __io_println(digest_lowering.policy.receipt_policy)
  __io_println(digest_lowering.triggers[0].kind)
  __io_println(digest_lowering.triggers[0].events[0])
  __io_println(digest_lowering.triggers[0].handler)
  __io_println(digest_lowering.triggers[0].schedule)
  const slack_catalog = [
    {
      provider: "slack",
      kinds: ["webhook"],
      schema_name: "SlackEventPayload",
      outbound_methods: [],
      secret_requirements: [],
      signature_verification: {kind: "none"},
      runtime: {kind: "placeholder"},
    },
  ]
  const triage = persona_blueprint_compile(
    {
      schema_version: "1",
      name: "alerts_triage",
      description: "Sorts incoming alerts.",
      goal: "Classify alert messages for follow-up.",
      template: "hybrid-classify-then-act",
      external: {provider: "slack", event: "slack.message"},
    },
    slack_catalog,
  )
  __io_println(is_ok(triage))
  const triage_lowering = unwrap(triage)
  __io_println(triage_lowering.triggers[0].kind)
  __io_println(triage_lowering.triggers[0].provider)
  __io_println(triage_lowering.triggers[0].events[0])
  __io_println(triage_lowering.triggers[0].handler)
  const mixed_sources = persona_blueprint_validate(
    {
      schema_version: "1",
      name: "too_many_sources",
      description: "Invalid source shape.",
      goal: "Must not lower two routes.",
      template: "deterministic-sweeper",
      cron: {cron: "0 * * * *", timezone: "UTC"},
      external: {provider: "slack", event: "slack.message"},
    },
    slack_catalog,
  )
  __io_println(mixed_sources.valid)
  __io_println(mixed_sources.errors.any({ error -> error.code == "source_count" }))
}
