import { AgentLoopOptions } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm, [llm_text("Full response text")],
    { ->
      const opts: AgentLoopOptions = {
        provider: "mock",
        max_iterations: 1,
        on_delta: { delta -> harness.stdio.println("delta=[" + delta + "]") },
      }
      const result = agent_loop(harness, "go", nil, opts)
      harness.stdio.println(result.status)
      harness.stdio.println(result.visible_text)
    },
  )
}
// A non-streaming provider (the mock delivers its whole response at once) still
// fires `on_delta` exactly once, carrying the full visible text — the documented
// graceful fallback so harnesses get a uniform "at least one delta" contract
// regardless of transport.
