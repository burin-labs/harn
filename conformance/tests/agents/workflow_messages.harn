pipeline default() {
  let workflow_id = "wf-messages-" + uuid()
  let target = {workflow_id: workflow_id}
  let signaled = workflow.signal(target, "new_customer_joined", {customer_id: 1})
  __io_println(signaled?.status?.pending_count == 1)
  let signal = workflow.receive(target)
  __io_println(signal?.kind == "signal")
  __io_println(signal?.name == "new_customer_joined")
  __io_println(signal?.payload?.customer_id == 1)
  let published = workflow.publish_query(target, "progress_pct", 42)
  __io_println(published?.query_count == 1)
  __io_println(workflow.query(target, "progress_pct") == 42)
  let waiter = spawn {
    let result = workflow.update(target, "adjust_budget", {max_usd: 10}, {timeout_ms: 1000})
    __io_println(result?.ok)
  }
  sleep(50ms)
  let update = workflow.receive(target)
  __io_println(update?.kind == "update")
  __io_println(update?.name == "adjust_budget")
  __io_println(update?.payload?.max_usd == 10)
  __io_println(update?.request_id != nil)
  workflow.respond_update(target, update?.request_id, {ok: true}, update?.name)
  let _ = await(waiter)
  let paused = workflow.pause(target)
  __io_println(paused?.paused)
  let pause_event = workflow.receive(target)
  __io_println(pause_event?.kind == "control")
  __io_println(pause_event?.name == "pause")
  let resumed = workflow.resume(target)
  __io_println(!resumed?.paused)
  let resume_event = workflow.receive(target)
  __io_println(resume_event?.name == "resume")
  let next = continue_as_new(target)
  __io_println(next?.workflow_id == workflow_id)
  let status = workflow.status(target)
  __io_println(status?.generation == 2)
}
