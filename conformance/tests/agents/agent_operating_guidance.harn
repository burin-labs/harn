import { agent_loop } from "std/agent/loop"
import { agent_prompt_ids, agent_prompt_overrides } from "std/agent/prompts"
import { llm_text, with_llm_script } from "std/testing"

fn probe(harness: Harness, options: dict<string, any>, expected: string?) -> nil {
  with_llm_script(
    harness.llm,
    [llm_text("Finished.")],
    { ->
      agent_loop(
        harness,
        "Answer directly.",
        "Base system.",
        options
          + {
            provider: "mock",
            max_iterations: 1,
            done_sentinel: nil,
            turn_end_condition: nil,
            agent_await_resumption_enabled: options?.agent_await_resumption_enabled ?? false,
          },
      )
      const calls = harness.llm.mock_calls()
      require len(calls) == 1, "the primary provider call must fire"
      const system = calls[0].system
      if options?.tools == nil || len(options.tools.tools) == 0 {
        require !contains(json_stringify(calls[0].tools ?? []), "__harn_resolve_tool_call"),
          "an empty tool surface must not advertise a confirmation tool"
        require !contains(system, "__harn_resolve_tool_call"),
          "an empty tool surface must not advertise textual confirmation tooling"
      }
      if expected == nil {
        require !contains(system, "## Operating guidance"),
          "no unsolicited guidance without a loop or tools"
      } else {
        require len(split(system, expected)) == 2, "guidance must occur exactly once"
      }
      return nil
    },
  )
  return nil
}

fn main(harness: Harness) -> nil {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "inspect",
    "Inspect the current state.",
    {handler: { _args: dict<string, any> -> "observed" }, parameters: {}},
  )
  probe(harness, {loop_until_done: true}, "## Operating guidance")
  probe(harness, {loop_until_done: false}, nil)
  for format in ["native", "text", "json"] {
    for loop_enabled in [false, true] {
      probe(
        harness,
        {tool_format: format, loop_until_done: loop_enabled, agent_await_resumption_enabled: true},
        "## Operating guidance",
      )
      probe(
        harness,
        {tools: tool_registry(), tool_format: format, loop_until_done: loop_enabled},
        loop_enabled ? "## Operating guidance" : nil,
      )
      probe(
        harness,
        {tools: tools, tool_format: format, loop_until_done: loop_enabled},
        "## Operating guidance",
      )
    }
  }
  const custom = agent_prompt_overrides(
    {
      operating_guidance: {text: "CUSTOM OPERATING GUIDANCE"},
      loop_contract: {text: "CUSTOM COMPLETION"},
    },
  )
  probe(harness, custom + {loop_until_done: true}, "CUSTOM OPERATING GUIDANCE")
  for sample in [
    {entry: "default_nudge.harn.prompt", expected: "make concrete progress in your reply."},
    {entry: {path: "default_nudge.harn.prompt"}, expected: "make concrete progress in your reply."},
    {
      entry: { _bindings: dict -> "CUSTOM CALLBACK GUIDANCE" },
      expected: "CUSTOM CALLBACK GUIDANCE",
    },
  ] {
    const options = agent_prompt_overrides({operating_guidance: sample.entry})
    probe(harness, options + {loop_until_done: true}, sample.expected)
  }
  require contains(agent_prompt_ids(), "agent.operating_guidance"),
    "catalog exposes the shared prompt"
  harness.stdio.println("shared guidance reached once across loop and tool modes")
}
