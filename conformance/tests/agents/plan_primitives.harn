import { agent_loop } from "std/agent/loop"
import "std/plan"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  const tools = plan_tools()
  require tool_find(tools, "emit_plan") != nil, "emit_plan should be registered"
  require tool_find(tools, "update_plan") != nil, "update_plan should be registered"
  const artifact = plan_from(
    {
      summary: "Add a health endpoint.",
      steps: [
        {content: "Inspect the router.", status: "completed"},
        {content: "Add the endpoint.", status: "pending"},
      ],
      assumptions: ["The existing router owns HTTP endpoints."],
      open_questions: ["Should the endpoint include dependencies?"],
      verification_commands: ["npm test"],
    },
  )
  require artifact.schema_version == "harn.plan.v1", "plan artifact schema should be stable"
  require len(artifact.steps) == 2, "plan steps should normalize"
  require artifact.steps[0]?.status == "completed", "step status should normalize"
  require len(plan_acp_entries(artifact)) == 2, "ACP entries should derive from steps"
  harness.testing.clear()
  harness.testing.respond(
    "interaction",
    "approval_response",
    {approved: true, reviewer: "lead", reason: "ready"},
  )
  const approved = request_plan_approval(harness.interaction, artifact, {reviewers: ["lead"]})
  require approved.approval.state == "approved", "plan approval should use HITL"
  require approved.approval.reviewers?.[0] == "lead", "reviewer should round-trip"
  with_llm_script(
    harness.llm,
    [
      {
        tool_calls: [
          {
            id: "plan1",
            name: "emit_plan",
            arguments: {
              summary: "Implement a small parser change.",
              steps: [
                {content: "Read parser tests.", status: "completed"},
                {content: "Patch parser.", status: "pending"},
              ],
              verification_commands: ["cargo test -p harn-parser"],
            },
          },
        ],
      },
      llm_text("Plan emitted."),
    ],
    { ->
      const result = agent_loop(
        harness,
        "Plan a parser change",
        nil,
        {provider: "mock", tools: tools, max_iterations: 2, session_id: "plan-conformance"},
      )
      const events = transcript_events(result?.transcript)
      let saw_plan = false
      for event in events {
        if event.kind == "plan_document" {
          saw_plan = true
          const document = event.metadata.plan_document
          require document.schema_version == "harn.plan_document.v1",
            "transcript plan document metadata should be structured"
          require document.current_revision.plan.schema_version == "harn.plan.v1",
            "plan document should carry the normalized executable plan"
          require document.current_revision.markdown.contains("Read parser tests."),
            "plan document should carry editable Markdown"
        }
      }
      require saw_plan, "agent loop should persist an emitted plan event"
      harness.stdio.log("plan primitives tests passed")
    },
  )
}
