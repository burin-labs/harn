import { agent_dispatch_tool_call } from "std/agent/primitives"
import { agent_tool_handler_result } from "std/agent/tool_lifecycle"

pipeline main(harness: Harness) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Return typed edit facts beside human feedback.",
    {
      parameters: {},
      handler: { _ ->
        return agent_tool_handler_result(
          "Edited src/main.harn\n\nDiagnostics wording may change.",
          {
            edit_status: "applied_still_failing",
            diagnostics_error_count: 2,
            mutation_status: "applied",
            changed_paths: ["src/main.harn"],
          },
        )
      },
    },
  )
  const dispatched = agent_dispatch_tool_call(harness.tools, {name: "edit", arguments: {}}, tools)
  harness.stdio.println(
    dispatched.rendered_result == "Edited src/main.harn\n\nDiagnostics wording may change.",
  )
  harness.stdio.println(dispatched.result.schema)
  harness.stdio.println(dispatched.result.data.edit_status)
  harness.stdio.println(dispatched.result.data.diagnostics_error_count)
  harness.stdio.println(!dispatched.observation.contains("diagnostics_error_count"))
  harness.stdio.println(dispatched.mutation_status)
  harness.stdio.println(dispatched.changed_paths[0])
}
