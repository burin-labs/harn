// Markdown fencing, inline code spans, and where a call is and is not a call.
//
// Fencing does not make a call inert: the fence check classifies the fragment
// as narration, and the stray sniffer then runs the bare-call parser over it
// and dispatches anything naming a registered tool. That is deliberate — models
// fence their calls constantly, and treating a fenced block as prose-only
// silently drops real work. The negative cases are the other half of the
// contract: a tool NAME mentioned in prose, or an unrelated function call in a
// code example, must stay text.
import { probe, sample_registry } from "_tool_parse_probe"

pipeline main(harness: Harness) {
  // Both the fenced call and the bare one dispatch, and the fence markers are
  // stripped out of the visible prose rather than replayed to the user.
  probe(harness, "fenced and bare call both dispatch",
    """Here's how to use it:
```python
edit({ action: "create", path: "fenced.go" })
```
And another:
edit({ action: "create", path: "bare.go" })
""",
    sample_registry(),
  )
  // A tool name inside an inline code span is a mention, not an invocation.
  probe(harness, "inline code span mention is not a call",
    """I considered `edit({...})` but chose a different approach.
edit({ action: "create", path: "real.go" })
""",
    sample_registry(),
  )
  // A single unmatched backtick used to flip the scanner's inline-code flag for
  // the rest of the response, so every later bare call was silently skipped and
  // the loop stalled. The flag resets at each newline — inline code never spans
  // lines — so the call on the following line still parses.
  probe(harness, "unbalanced backtick does not suppress a later call",
    """The file is `src/main.rs (note path).
edit({ action: "create", path: "real.go" })
""",
    sample_registry(),
  )
  // A whole response that is one inline-wrapped call.
  probe(harness, "inline wrapped call as the entire response",
    "`edit({ action: \"create\", path: \"wrapped.go\" })`",
    sample_registry(),
  )
  // A whole response that is one fenced call, in three fence spellings.
  probe(harness, "fenced call as the entire response",
    """```typescript
edit({ action: "create", path: "wrapped.go" })
```""",
    sample_registry(),
  )
  // Gemma's other native form: a ```tool_code fence around a bare call.
  probe(harness, "gemma tool_code fence",
    """```tool_code
run({ command: "ls" })
```""",
    sample_registry(),
  )
  // A fenced batch edit whose `ops` carry a nested heredoc body.
  probe(harness, "fenced edit batch ops with nested heredoc",
    """```tool_code
edit({ path: "tests/test_service.py", ops: [
  { op: "replace_body", function_name: "test_handle", new_body: <<EOF
value = 1
assert value == 1
EOF
  },
  { op: "add_import", import_statement: "from app.types import RequestContext" }
]})
```""",
    sample_registry(),
  )
  // Function calls in a code example that name no registered tool are code.
  probe(harness, "non-tool calls in a code example stay prose",
    """Here is the target test body:

    assert divide(10, 2) == 5.0
    multiply(2, 3)
""",
    sample_registry(),
  )
  // Two calls in one response, in document order.
  probe(harness, "multiple calls in one response",
    """edit({ action: "create", path: "a.go", content: "a" })
Then we will:
edit({ action: "patch", path: "b.go" })
""",
    sample_registry(),
  )
  // An UNCLOSED ``` fence earlier in the response must not make a later, real
  // `<tool_call>` block look fenced. The fence-parity check used to count every
  // marker before the cursor and call an odd count "inside a fence", which
  // dropped the call and injected a spurious violation.
  probe(harness, "tool call after an unbalanced fence",
    """<assistant_prose>
Here is the rough shape:
```
fn sketch() {}
</assistant_prose>
<tool_call>
edit({ action: "create", path: "a.rs", content: "x" })
</tool_call>""",
    sample_registry(),
  )
  // A protocol tag inside a fence is an example, not a block; the real block
  // after it is the one that counts.
  probe(harness, "user_response inside a markdown fence is an example",
    """```xml
<user_response>example only</user_response>
```
<user_response>Visible answer.</user_response>""",
    sample_registry(),
  )
  // Same rule stated inline: a placeholder in backticks is prose about the
  // protocol, not a response block.
  probe(harness, "inline user_response placeholder is stray prose",
    """Use `<user_response>...</user_response>` as the wrapper.
Actual answer in plain prose.""",
    sample_registry(),
  )
}
