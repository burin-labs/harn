fn run_scripted(calls, opts = {}) {
  return with_llm_script(
    [{text: "", tool_calls: calls}, llm_text("I saw the tool results.")],
    { ->
      const session = "intra-turn-resource-" + uuid()
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Apply the requested edits.",
          nil,
          {
            provider: "mock",
            tools: edit_tools(),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 3,
            done_judge: nil,
            session_id: session,
          }
            + opts,
        ) },
      )
      const mock_calls = llm_mock_calls()
      const transcript = json_stringify(mock_calls[len(mock_calls) - 1].messages)
      return {result: captured.result, transcript: transcript, events: captured.events}
    },
  )
}

fn has_tool_update(events, status: string, category: string, text: string) -> bool {
  return events
    .find(
    { event -> return event.type == "tool_call_update"
      && to_string(event.tool_call_id ?? "") != ""
      && event.status == status
      && event.error_category == category
      && contains(to_string(event.error ?? event.raw_output ?? ""), text) },
  )
    != nil
}

fn partial_apply_receipt_at_index(events, skipped_call_index: number) {
  for event in events {
    const receipt = event?.raw_output?.partial_apply
    if receipt?.skipped_call_index == skipped_call_index {
      return receipt
    }
  }
  return nil
}

pipeline main() {
  // Default-on fail-fast: second same-file edit is skipped, different file runs.
  const defaulted = run_scripted(same_file_failure_batch())
  __io_println(defaulted.result.status)
  __io_println(contains(defaulted.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(defaulted.transcript, "applied src/a.zig second"))
  __io_println(contains(defaulted.transcript, "applied src/b.zig other"))
  assert(
    contains(defaulted.transcript, "stale-anchor safety"),
    "same-resource skips should explain the stale-anchor safety reason",
  )
  assert(
    contains(defaulted.transcript, "issue exactly ONE `edit` call"),
    "same-resource skips should steer to one current-file recovery edit",
  )
  assert(
    !contains(defaulted.transcript, "same assistant response failed for the same workspace resource"),
    "same-resource skip wording should not imply every skipped sibling failed",
  )
  assert(
    has_tool_update(defaulted.events, "failed", "rejected_loop", "skipped dependent `edit` call"),
    "synthetic same-resource skip must emit a terminal tool_call_update for the skipped call",
  )
  const defaulted_receipt = partial_apply_receipt_at_index(defaulted.events, 1)
  assert(
    defaulted_receipt?.kind == "intra_turn_same_resource_partial_apply",
    "synthetic same-resource skip must expose a typed partial-apply receipt",
  )
  assert(
    defaulted_receipt.executed_prefix_count == 1,
    "receipt should name the executed prefix length",
  )
  assert(
    defaulted_receipt.skipped_suffix_count == 1,
    "receipt should count only the skipped same-resource dependent suffix",
  )
  assert(defaulted_receipt.skipped_call_index == 1, "receipt should name the skipped sibling index")
  assert(
    defaulted_receipt.blocking_prior_tool_call_id != "",
    "receipt should point to the prior mutating failure that blocked the sibling",
  )
  assert(
    defaulted_receipt.blocking_prior_mutation_status == "unknown",
    "opaque mutating failures should preserve an unknown mutation status",
  )
  assert(
    defaulted_receipt.next_expected_action == "read_current_resource_then_issue_one_reanchored_call",
    "receipt should expose the recovery action as structured data",
  )
  // Burin exposes this metadata as `policy`; Harn must treat it as resource annotations.
  const policy_metadata = run_scripted(same_file_failure_batch(), {tools: edit_tools("policy")})
  __io_println(policy_metadata.result.status)
  __io_println(contains(policy_metadata.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(policy_metadata.transcript, "applied src/a.zig second"))
  __io_println(contains(policy_metadata.transcript, "applied src/b.zig other"))
  // Burin's runtime policy stores path params directly on the policy dict,
  // not under `arg_schema`; this must still be keyed.
  const burin_policy_metadata = run_scripted(same_file_failure_batch(), {tools: edit_tools("burin_policy")})
  __io_println(burin_policy_metadata.result.status)
  __io_println(contains(burin_policy_metadata.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(burin_policy_metadata.transcript, "applied src/a.zig second"))
  __io_println(contains(burin_policy_metadata.transcript, "applied src/b.zig other"))
  // Some hosts carry canonical tool annotations in the turn policy rather
  // than each registry entry. The scheduler should still see resource keys.
  const turn_policy_metadata = run_scripted(
    same_file_failure_batch(),
    {
      tools: edit_tools("none"),
      policy: {
        tool_annotations: {edit: {kind: "edit", side_effect_level: "workspace_write", path_params: ["path"]}},
      },
    },
  )
  __io_println(turn_policy_metadata.result.status)
  __io_println(contains(turn_policy_metadata.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(turn_policy_metadata.transcript, "applied src/a.zig second"))
  __io_println(contains(turn_policy_metadata.transcript, "applied src/b.zig other"))
  // Product-level errors returned as text (`Error: ...`) also block same-resource siblings.
  const product_error = run_scripted(same_file_product_error_batch())
  __io_println(product_error.result.status)
  __io_println(contains(product_error.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(product_error.transcript, "applied src/a.zig second"))
  __io_println(contains(product_error.transcript, "applied src/b.zig other"))
  // Post-edit diagnostics are product-level write failures even when the
  // transport dispatch succeeded.
  const diagnostics_error = run_scripted(same_file_diagnostics_batch())
  __io_println(diagnostics_error.result.status)
  __io_println(contains(diagnostics_error.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(diagnostics_error.transcript, "applied src/a.zig second"))
  __io_println(contains(diagnostics_error.transcript, "applied src/b.zig other"))
  // A successful first edit does not block a later same-file edit.
  const successful = run_scripted(same_file_success_batch())
  __io_println(successful.result.status)
  __io_println(contains(successful.transcript, "applied src/a.zig first"))
  __io_println(contains(successful.transcript, "applied src/a.zig second"))
  __io_println(!contains(successful.transcript, "skipped dependent `edit` call"))
  // Explicit opt-out preserves legacy dispatch-all behavior.
  const disabled = run_scripted(same_file_failure_batch(), {intra_turn_resource_fail_fast: false})
  __io_println(disabled.result.status)
  __io_println(!contains(disabled.transcript, "skipped dependent `edit` call"))
  __io_println(contains(disabled.transcript, "applied src/a.zig second"))
  // Even when parallel dispatch is requested, keyed mutating batches serialize.
  const parallel_requested = run_scripted(same_file_failure_batch(), {max_concurrent_tools: 4})
  __io_println(parallel_requested.result.status)
  __io_println(contains(parallel_requested.transcript, "skipped dependent `edit` call"))
  __io_println(!contains(parallel_requested.transcript, "applied src/a.zig second"))
  __io_println(contains(parallel_requested.transcript, "applied src/b.zig other"))
  // Pre-apply REJECTION (`[Edit rejected] ... NOT applied`) leaves the view
  // byte-identical, so an independent later same-file edit is NOT stale and MUST
  // still run. Asserted directly (no golden line) so the safety/relaxation
  // invariant is self-checking.
  const noop_failure = run_scripted(same_file_noop_failure_batch())
  assert(
    contains(noop_failure.transcript, "applied src/a.zig second"),
    "a pre-apply rejection (not-applied) failure must NOT skip a later same-file edit",
  )
  assert(
    !contains(noop_failure.transcript, "skipped dependent `edit` call"),
    "no skip marker should be emitted when the prior failure did not mutate the resource",
  )
  // Post-apply failure (`## Diagnostics ...`) means the edit DID land, so the
  // later same-file edit's anchor may be stale and MUST still be skipped.
  const applied_failure = run_scripted(same_file_applied_failure_batch())
  assert(
    contains(applied_failure.transcript, "skipped dependent `edit` call"),
    "a post-apply (applied-then-flagged) failure must STILL skip a later same-file edit",
  )
  assert(
    contains(applied_failure.transcript, "stale-anchor safety"),
    "post-apply same-resource skips should explain the stale-anchor safety reason",
  )
  assert(
    !contains(applied_failure.transcript, "applied src/a.zig second"),
    "the later same-file edit must not run after a mutating failure (stale-anchor hazard)",
  )
  const applied_failure_receipt = partial_apply_receipt_at_index(applied_failure.events, 1)
  assert(
    applied_failure_receipt.blocking_prior_mutation_status == "applied",
    "post-apply diagnostics should preserve an applied mutation status in the partial receipt",
  )
  const dependency_params = edit_dependency_key_params()
  const range_params = edit_dependency_range_params()
  const arg_aliases = {old: "old_string", start: "range_start", end: "range_end"}
  const different_target = run_scripted(
    same_file_different_target_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params)},
  )
  assert(
    contains(different_target.transcript, "applied src/a.zig second-target"),
    "declared dependency ranges should let independent same-file edit targets run after an applied failure",
  )
  assert(
    !contains(different_target.transcript, "skipped dependent `edit` call"),
    "independent same-file edit targets must not emit a dependency skip",
  )
  const same_target = run_scripted(
    same_file_same_target_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params)},
  )
  assert(
    contains(same_target.transcript, "skipped dependent `edit` call"),
    "the same declared edit target must still be skipped after an applied failure",
  )
  assert(
    !contains(same_target.transcript, "applied src/a.zig same-target"),
    "the later same-file same-target edit must not run after a mutating failure",
  )
  const overlapping_target = run_scripted(
    same_file_overlapping_target_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params)},
  )
  assert(
    contains(overlapping_target.transcript, "skipped dependent `edit` call"),
    "overlapping declared edit ranges must still be skipped after an applied failure",
  )
  assert(
    !contains(overlapping_target.transcript, "applied src/a.zig overlap-target"),
    "the later same-file overlapping edit must not run after a mutating failure",
  )
  const same_range_different_action = run_scripted(
    same_file_same_range_different_action_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params)},
  )
  assert(
    contains(same_range_different_action.transcript, "skipped dependent `edit` call"),
    "same-range edits must not become independent just because the edit action differs",
  )
  assert(
    !contains(same_range_different_action.transcript, "applied src/a.zig different-action-same-range"),
    "the later same-file same-range/different-action edit must not run after a mutating failure",
  )
  const same_alias_target = run_scripted(
    same_file_same_alias_target_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params, arg_aliases)},
  )
  assert(
    contains(same_alias_target.transcript, "skipped dependent `edit` call"),
    "dependency key aliases must fold to the canonical target before hashing",
  )
  assert(
    !contains(same_alias_target.transcript, "applied src/a.zig alias-old"),
    "the later same-file alias-spelled same-target edit must not run after a mutating failure",
  )
  const different_alias_target = run_scripted(
    same_file_different_alias_target_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params, arg_aliases)},
  )
  assert(
    contains(different_alias_target.transcript, "applied src/a.zig alias-old-different"),
    "dependency key aliases must preserve different canonical target values",
  )
  const same_range_alias = run_scripted(
    same_file_same_range_alias_applied_failure_batch(),
    {tools: edit_tools("annotations", dependency_params, range_params, arg_aliases)},
  )
  assert(
    contains(same_range_alias.transcript, "skipped dependent `edit` call"),
    "dependency range aliases must fold to the canonical interval before overlap checks",
  )
  assert(
    !contains(same_range_alias.transcript, "applied src/a.zig alias-range"),
    "the later same-file alias-spelled overlapping range edit must not run after a mutating failure",
  )
  const burin_direct_target = run_scripted(
    same_file_different_target_applied_failure_batch(),
    {tools: edit_tools("burin_policy", dependency_params, range_params)},
  )
  assert(
    contains(burin_direct_target.transcript, "applied src/a.zig second-target"),
    "Burin direct runtime policy dependency_key_params should refine same-file resource skips",
  )
  const burin_direct_alias_target = run_scripted(
    same_file_same_alias_target_applied_failure_batch(),
    {tools: edit_tools("burin_policy", dependency_params, range_params, arg_aliases)},
  )
  assert(
    contains(burin_direct_alias_target.transcript, "skipped dependent `edit` call"),
    "Burin direct runtime policy arg_aliases must fold dependency keys before hashing",
  )
  assert(
    !contains(burin_direct_alias_target.transcript, "applied src/a.zig alias-old"),
    "Burin direct runtime policy must skip same-resource edits even when the later call uses an alias",
  )
  const turn_policy_target = run_scripted(
    same_file_different_target_applied_failure_batch(),
    {
      tools: edit_tools("none"),
      policy: {
        tool_annotations: {
          edit: {
            kind: "edit",
            side_effect_level: "workspace_write",
            path_params: ["path"],
            dependency_key_params: dependency_params,
            dependency_range_params: range_params,
          },
        },
      },
    },
  )
  assert(
    contains(turn_policy_target.transcript, "applied src/a.zig second-target"),
    "turn policy dependency_key_params should refine same-file resource skips",
  )
  const turn_policy_alias_target = run_scripted(
    same_file_same_alias_target_applied_failure_batch(),
    {
      tools: edit_tools("none"),
      policy: {
        tool_annotations: {
          edit: {
            kind: "edit",
            side_effect_level: "workspace_write",
            path_params: ["path"],
            dependency_key_params: dependency_params,
            dependency_range_params: range_params,
            arg_aliases: arg_aliases,
          },
        },
      },
    },
  )
  assert(
    contains(turn_policy_alias_target.transcript, "skipped dependent `edit` call"),
    "turn policy arg_aliases must fold dependency keys before hashing",
  )
  assert(
    !contains(turn_policy_alias_target.transcript, "applied src/a.zig alias-old"),
    "turn policy must skip same-resource edits even when the later call uses an alias",
  )
}
