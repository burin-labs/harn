/**
 * Intra-turn resource fail-fast: when one assistant message emits multiple
 * mutating calls for the same annotated workspace resource, a failure in an
 * earlier sibling must stop later same-resource siblings before they can mutate
 * stale state. Different resources and successful same-resource sequences still
 * run normally.
 */
import { agent_capture_events } from "std/agent/events"
import { llm_text, with_llm_script } from "std/testing"

fn edit_dependency_key_params() {
  return ["anchor", "old_string", "function_name", "symbol_name", "name"]
}

fn edit_dependency_range_params() {
  return [{start: "range_start", end: "range_end"}]
}

fn edit_tools(
  metadata_key = "annotations",
  dependency_key_params = [],
  dependency_range_params = [],
  arg_aliases = {},
) {
  let tools = tool_registry()
  const arg_schema = {
    path_params: ["path"],
    dependency_key_params: dependency_key_params,
    dependency_range_params: dependency_range_params,
    arg_aliases: arg_aliases,
  }
  const metadata = {kind: "edit", side_effect_level: "workspace_write", arg_schema: arg_schema}
  const burin_policy = {
    path_params: ["path"],
    dependency_key_params: dependency_key_params,
    dependency_range_params: dependency_range_params,
    arg_aliases: arg_aliases,
    side_effect_level: "workspace_write",
    mutation_classification: "workspace_write",
  }
  const metadata_field = if metadata_key == "policy" {
    {policy: metadata}
  } else if metadata_key == "burin_policy" {
    {policy: burin_policy}
  } else if metadata_key == "none" {
    {}
  } else {
    {annotations: metadata}
  }
  tools = tool_define(
    tools,
    "edit",
    "Edit a workspace file.",
    {
      handler: { args ->
        if args?.fail_noop ?? false {
          return "Error: [Edit rejected] old_string not found. Your edit was NOT applied to "
            + to_string(args?.path ?? "")
            + " "
            + to_string(args?.marker ?? "")
        }
        if args?.fail_applied ?? false {
          return "## Diagnostics (1 errors, via zig ast-check)\n"
            + "  L3 ERROR: expected ';' after statement\n"
            + "-> Fix these errors before declaring done."
        }
        if args?.fail ?? false {
          throw "rejected " + to_string(args?.path ?? "") + " " + to_string(args?.marker ?? "")
        }
        if args?.fail_return ?? false {
          return "Error: rejected " + to_string(args?.path ?? "") + " " + to_string(args?.marker ?? "")
        }
        if args?.diagnostics ?? false {
          return "## Diagnostics (2 errors, via zig ast-check)\n"
            + "  L12 ERROR: expected ',' after initializer\n"
            + "  L19 ERROR: expected statement, found ';'\n"
            + "-> Fix these errors before browsing, broad rewrites, or declaring done."
        }
        return "applied " + to_string(args?.path ?? "") + " " + to_string(args?.marker ?? "")
      },
      parameters: {
        path: {type: "string", description: "Workspace-relative path"},
        marker: {type: "string", description: "Probe marker"},
        action: {type: "string", description: "Logical edit action", required: false},
        range_start: {type: "integer", description: "Start offset for range-based edits", required: false},
        range_end: {type: "integer", description: "End offset for range-based edits", required: false},
        anchor: {type: "string", description: "Anchor text for anchored edits", required: false},
        old_string: {type: "string", description: "Old text for replacement edits", required: false},
        function_name: {type: "string", description: "Target function name", required: false},
        symbol_name: {type: "string", description: "Target symbol name", required: false},
        name: {type: "string", description: "Generic target name", required: false},
        fail: {type: "boolean", description: "Whether this call rejects", required: false},
        fail_return: {type: "boolean", description: "Whether this call returns a product-level error", required: false},
        fail_noop: {
          type: "boolean",
          description: "Whether this call fails WITHOUT mutating (applied: false)",
          required: false,
        },
        fail_applied: {
          type: "boolean",
          description: "Whether this call fails AFTER mutating (applied: true)",
          required: false,
        },
        diagnostics: {
          type: "boolean",
          description: "Whether this call returns product-level diagnostics",
          required: false,
        },
      },
      returns: {type: "string"},
    }
      + metadata_field,
  )
  return tools
}

fn same_file_failure_batch() {
  return [
    {
      id: "a1",
      name: "edit",
      arguments: {path: "src/a.zig", marker: "first", fail: true, fail_return: false},
    },
    {
      id: "a2",
      name: "edit",
      arguments: {path: "src/a.zig", marker: "second", fail: false, fail_return: false},
    },
    {
      id: "b1",
      name: "edit",
      arguments: {path: "src/b.zig", marker: "other", fail: false, fail_return: false},
    },
  ]
}

