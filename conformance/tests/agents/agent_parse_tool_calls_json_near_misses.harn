import { agent_parse_tool_calls } from "std/agent/primitives"

pipeline main(harness: Harness) {
  const tool_code = agent_parse_tool_calls(
    harness.agent,
    "```tool_code\n{\"name\":\"read_file\",\"args\":{\"path\":\"a.rs\"}}\n```",
    nil,
    "json",
  )
  harness.stdio.println(tool_code.tool_calls[0].name)
  harness.stdio.println(tool_code.tool_calls[0].arguments.path)
  harness.stdio.println(len(tool_code.protocol_violations) == 1)
  harness.stdio.println(contains(tool_code.protocol_violations[0].message, "```tool_code"))
  const tilde = agent_parse_tool_calls(
    harness.agent,
    "~~~tool\n{\"name\":\"read_file\",\"args\":{\"path\":\"b.rs\"}}\n~~~",
    nil,
    "json",
  )
  harness.stdio.println(tilde.tool_calls[0].arguments.path)
  harness.stdio.println(contains(tilde.protocol_violations[0].message, "~~~tool"))
  const bare_json = agent_parse_tool_calls(
    harness.agent,
    "{\"name\":\"read_file\",\"args\":{\"path\":\"c.rs\"}}",
    nil,
    "json",
  )
  harness.stdio.println(bare_json.tool_calls[0].arguments.path)
  harness.stdio.println(contains(bare_json.protocol_violations[0].message, "bare JSON object"))
  const tagged = agent_parse_tool_calls(
    harness.agent,
    "<tool_call>\nread_file({ path: \"d.rs\" })\n</tool_call>",
    nil,
    "json",
  )
  harness.stdio.println(len(tagged.tool_calls))
  harness.stdio.println(len(tagged.protocol_violations) == 1)
  harness.stdio.println(contains(tagged.protocol_violations[0].message, "<tool_call>"))
  for answer in ["{\"verdict\":\"pass\"}", "[1,2]", "[{\"verdict\":\"pass\"}]", "{}"] {
    const parsed = agent_parse_tool_calls(harness.agent, answer, nil, "json")
    assert(len(parsed.tool_calls) == 0, "ordinary JSON answers must not dispatch tools")
    assert(len(parsed.tool_parse_errors) == 0, "ordinary JSON must not trigger tool repair")
    assert(len(parsed.protocol_violations) == 0, "ordinary JSON is not a call envelope")
    assert(parsed.prose == answer, "answer data must survive for output validation")
  }
  for malformed in ["{\"name\":\"\",\"args\":{}}", "```tool\n{\"verdict\":\"pass\"}\n```"] {
    const parsed = agent_parse_tool_calls(harness.agent, malformed, nil, "json")
    assert(len(parsed.tool_parse_errors) > 0, "malformed declared calls still need repair")
  }
}
