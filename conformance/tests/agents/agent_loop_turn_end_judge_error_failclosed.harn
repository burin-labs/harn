// A completion judge is a gate: when it cannot run, an unverified completion
// claim must not become `done`. It also has to be able to END the run. A judge
// whose reply cannot be read is re-asked once and then terminates on its own
// reason, so the stop is attributed to the judge rather than to whichever
// unrelated budget happened to run out first. The invocation cap is no longer
// the escape hatch here, which is why `judge_cap_reached` is false.
import { agent_loop } from "std/agent/loop"
import { agent_loop_options } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("First completion claim. ##DONE##"),
      {error: {category: "generic", message: "structured output is unavailable"}},
      llm_text("Second completion claim. ##DONE##"),
    ],
    { ->
      const options = agent_loop_options(
        harness,
        {
          provider: "mock",
          loop_until_done: true,
          max_iterations: 3,
          turn_end_condition: {max_invocations: 1},
        },
      )
      const result = agent_loop(
        harness,
        "Finish only after the completion judge verifies the claim.",
        nil,
        options,
      )
      harness.stdio.println("status=${result.status}")
      harness.stdio.println("stop_reason=${result.stop_reason}")
      harness.stdio.println("judge_invocations=${result.turn_end_condition.invocations}")
      harness.stdio.println("judge_cap_reached=${result.turn_end_condition.cap_reached}")
      harness.stdio.println("provider_calls=${len(harness.llm.mock_calls())}")
    },
  )
}
