import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

fn tool_message_count(agent: HarnessAgent, session_id) {
  let count = 0
  for message in agent_session_messages(agent, session_id) {
    if message?.role == "tool_result" && message?.name == "noop" {
      count = count + 1
    }
  }
  return count
}

pipeline default(harness: Harness) {
  let dispatches = 0
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "noop",
    "Return the same harmless result",
    {
      handler: { _args ->
        dispatches += 1
        return "noop"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "noop1", name: "noop", arguments: {}}]},
      {text: "", tool_calls: [{id: "noop2", name: "noop", arguments: {}}]},
      {text: "", tool_calls: [{id: "noop3", name: "noop", arguments: {}}]},
      llm_text(
        "{\"verdict\":\"done\",\"detail\":\"The repeated call is sufficient evidence.\"}",
      ),
    ],
    { ->
      const session = "stall-judge-done-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Stop when the stall judge accepts.",
          nil,
          {
            provider: "mock",
            tools: tools,
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 5,
            session_id: session,
            stall_diagnostics: {threshold: 3, inject_feedback: true, max_feedback: 1},
            done_judge: {cadence: {when: "stalled"}},
          },
        ) },
      )
      const stalls = events_of(captured.events, "agent_loop_stall_warning")
      const judges = events_of(captured.events, "judge_decision")
      require len(stalls) == 1, "stall warning should fire once"
      require len(judges) == 1, "stalled done_judge should fire once"
      harness.stdio.println(captured.result.status)
      harness.stdio.println(captured.result.stop_reason)
      harness.stdio.println(judges[0].trigger)
      harness.stdio.println(judges[0].verdict)
      harness.stdio.println(judges[0].iteration == stalls[0].warning.iteration)
      harness.stdio.println(tool_message_count(harness.agent, session))
      harness.stdio.println(dispatches)
      harness.stdio.println(len(harness.llm.mock_calls()))
    },
  )
}
