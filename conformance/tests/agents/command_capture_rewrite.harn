import { agent_dispatch_tool_call, agent_parse_tool_calls } from "std/agent/primitives"
import { command_capture_rewrite } from "std/agent/command_capture"
import { agent_command_tools } from "std/agent/host_tools"

pipeline main(harness: Harness) {
  const cap = "/tmp/cap.out"
  // --- pure rewrite cases (deterministic capture path) --------------------
  // 1. plain producer | tail
  harness.stdio.println(command_capture_rewrite("seq 100 | tail -3", cap))
  // 2. verbatim `cd … &&` prefix + 2>&1 redirection ride along
  harness.stdio.println(command_capture_rewrite("cd foo && make 2>&1 | tail -50", cap))
  // 3. tee is inserted before the FINAL filter of a multi-stage pipeline
  harness.stdio.println(
    command_capture_rewrite("find . -name '*.rs' | xargs wc -l | sort -n | tail -1", cap),
  )
  // 4. a pipe inside single quotes is not a split point
  harness.stdio.println(command_capture_rewrite("grep 'a|b' file | wc -l", cap))
  // 5. a `;` prefix is preserved verbatim; only the last statement rewrites
  harness.stdio.println(command_capture_rewrite("echo start; seq 10 | wc -l", cap))
  // --- bail cases (no rewrite -> nil) -------------------------------------
  harness.stdio.println(command_capture_rewrite("ls | head -5", cap) == nil)  // head short-circuits
  harness.stdio.println(command_capture_rewrite("ls | grep -q foo", cap) == nil)  // grep -q short-circuits
  harness.stdio.println(command_capture_rewrite("cat \"$(cfg)\" | tail", cap) == nil)  // command substitution
  harness.stdio.println(command_capture_rewrite("ls", cap) == nil)  // no pipe
  harness.stdio.println(command_capture_rewrite("(a | b) | tail", cap) == nil)  // subshell grouping
  harness.stdio.println(command_capture_rewrite("foo | sed 's/x/y/'", cap) == nil)  // filter not in allowlist
  harness.stdio.println(command_capture_rewrite("echo hi & wc -l", cap) == nil)  // background job
  harness.stdio.println(command_capture_rewrite("a | b && c", cap) == nil)  // last statement has no pipe
  // --- end-to-end through the run_command tool ----------------------------
  const root = path_join(harness.fs.workspace_temp_dir(), "harn-cap-int-" + harness.random.uuid())
  harness.fs.mkdir(root, true)
  const tools = agent_command_tools(harness, nil,
    {root: root, cwd: root, allow_argv_prefixes: [["sh", "-c"]]},
  )
  const run = agent_dispatch_tool_call(harness, {
      id: "c1",
      name: "run_command",
      arguments: {argv: ["sh", "-c", "seq 100 | tail -n 3"], capture: {max_inline_bytes: 1000}},
    },
    tools,
  )
  const data = json_parse(run.rendered_result)
  harness.stdio.println(run.ok)  // true
  harness.stdio.println(data.output_capture.producer)  // seq 100
  harness.stdio.println(data.output_capture.filter)  // tail -n 3
  const captured = harness.fs.read_text(data.output_capture.full_output_path)
  harness.stdio.println(len(captured.trim().split("\n")))  // 100 (full producer output preserved)
  harness.stdio.println(len(data.stdout.trim().split("\n")))  // 3  (agent still sees only the filtered tail)
  harness.stdio.println(data.stdout.trim().ends_with("100"))  // true
  harness.fs.delete(data.output_capture.full_output_path)
  harness.fs.delete(root)
}
