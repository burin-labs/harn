import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

fn judge_events(events: any) {
  return events.filter({ event -> event.type == "judge_decision" })
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("<user_response>isolated final answer</user_response>"),
      llm_text("{\"verdict\":\"done\",\"detail\":\"The task is complete.\"}"),
    ],
    { ->
      const session = "turn-end-judge-isolation-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish once.",
          nil,
          {
            provider: "mock",
            tools: tool_registry(),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 2,
            session_id: session,
            turn_end_condition: true,
          },
        ) },
      )
      const messages = agent_session_messages(harness.agent, session)
      const encoded = json_stringify(messages)
      const judges = judge_events(captured.events)
      require len(judges) == 1, "turn_end_condition should emit one decision"
      harness.stdio.println(captured.result.status)
      harness.stdio.println(len(messages))
      harness.stdio.println(contains(encoded, "isolated final answer"))
      harness.stdio.println(!contains(encoded, "\"verdict\""))
      harness.stdio.println(!contains(encoded, "complete"))
      harness.stdio.println(len(harness.llm.mock_calls()))
    },
  )
}
