import { agent_stall_initial_state, agent_stall_inject_feedback } from "std/agent/stall"
import { __agent_stall_default_config } from "std/agent/stall_config"
import { AgentStallWarning } from "std/agent/stall_types"

fn verify(fs: HarnessFs, counter: string) -> bool {
  const next = to_int(fs.read_text(counter)) + 1
  fs.write_text(counter, to_string(next))
  return next < 5
}

pipeline main(harness: Harness) {
  const session = harness.agent.open()
  defer {
    harness.agent.close(session)
  }
  const warning: AgentStallWarning = {
    iteration: 4,
    tool_name: "verify",
    repeat_count: 4,
    threshold: 3,
    arguments_digest: "",
    signature_digest: "",
    pattern: "repeated_success",
    signature: "verify",
    count: 4,
    consecutive_trips: 1,
    hard_stop: false,
  }
  const state = agent_stall_inject_feedback(
    harness.agent,
    session,
    warning,
    __agent_stall_default_config(),
    agent_stall_initial_state(),
  )
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  require state.feedback_count == 1 && len(reminders) == 1, "public injection emitted one reminder"
  const body = reminders[0].reminder.body
  require !contains(body, "will not produce a new result"),
    "feedback does not predict the next result"
  require contains(body, "succeeded 4 times"), "feedback reports the observed success count"
  require contains(body, "inputs or external state can still change"),
    "unrecorded change remains possible"
  require contains(body, "Conclude if the evidence is sufficient"),
    "conclusion depends on sufficient evidence"
  require contains(body, "another execution is needed"),
    "a justified next execution remains available"
  const path = harness.fs.mkdtemp_in_workspace("changing-verifier")
  defer {
    harness.fs.delete(path)
  }
  const counter = "${path}/counter"
  harness.fs.write_text(counter, "0")
  for _ in [1, 2, 3, 4] {
    require verify(harness.fs, counter), "the verifier initially passes"
  }
  require !verify(harness.fs, counter),
    "the same verifier and arguments now fail without an agent edit"
}
