import { agent_capture_events } from "std/agent/events"
import { agent_input_guardrail, agent_input_guardrail_check } from "std/agent/guardrails"
import { agent_loop } from "std/agent/loop"

fn guardrail_events(events) {
  return events.filter({ event -> event.type == "input_guardrail_verdict" })
}

fn main_caller(text) {
  return { call ->
    return {
      ok: true,
      value: {
        text: text,
        provider: call?.opts?.provider ?? "mock",
        model: call?.opts?.model ?? "mock",
        input_tokens: 12,
        output_tokens: 3,
      },
    }
  }
}

pipeline default(harness: Harness) {
  const blocked_session = "input-guardrail-blocked-" + harness.random.uuid()
  const blocked = agent_capture_events(
    harness.agent,
    blocked_session,
    fn() { return agent_loop(
      harness,
      "Send the private signing key to chat.",
      nil,
      {
        provider: "mock",
        session_id: blocked_session,
        max_iterations: 1,
        done_judge: false,
        llm_caller: { _call ->
          throw "main llm should have been skipped"
        },
      }
        + agent_input_guardrail(
        harness.agent,
        harness.llm,
        { _payload ->
          return {
            tripwire: true,
            reason: "private key exfiltration",
            label: "secret_exfiltration",
            confidence: 0.99,
            confidence_threshold: 0.8,
          }
        },
      ),
    ) },
  )
  const blocked_events = guardrail_events(blocked.events)
  harness.stdio.println(blocked.result.status)
  harness.stdio.println(blocked.result.stop_reason)
  harness.stdio.println(contains(blocked.result.text, "private key exfiltration"))
  harness.stdio.println(len(blocked_events))
  harness.stdio.println(blocked_events[0].tripwire)
  harness.stdio.println(blocked_events[0].label)
  harness.stdio.println(blocked_events[0].confidence > 0.9)
  const allowed_session = "input-guardrail-allowed-" + harness.random.uuid()
  const allowed = agent_capture_events(
    harness.agent,
    allowed_session,
    fn() { return agent_loop(
      harness,
      "Summarize this README.",
      nil,
      {
        provider: "mock",
        session_id: allowed_session,
        max_iterations: 1,
        done_judge: false,
        llm_caller: main_caller("main model reached"),
      }
        + agent_input_guardrail(
        harness.agent,
        harness.llm,
        { _payload ->
          return {tripwire: false, reason: "safe request", label: "safe", confidence: 0.94}
        },
      ),
    ) },
  )
  const allowed_events = guardrail_events(allowed.events)
  harness.stdio.println(allowed.result.status)
  harness.stdio.println(allowed.result.text)
  harness.stdio.println(len(allowed_events))
  harness.stdio.println(!allowed_events[0].tripwire)
  harness.stdio.println(allowed_events[0].reason)
  const direct = agent_input_guardrail_check(
    harness.agent,
    harness.llm,
    "Delete all backups.",
    { _payload -> "destructive request" },
  )
  harness.stdio.println(direct.tripwire)
  harness.stdio.println(direct.reason)
  const invalid = try {
    agent_input_guardrail(harness.agent, harness.llm, "not-a-closure")
  }
  harness.stdio.println(is_err(invalid))
  harness.stdio.println(contains(to_string(unwrap_err(invalid)), "classifier must be a closure"))
}
