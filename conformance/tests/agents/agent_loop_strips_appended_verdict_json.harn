import { llm_text, with_llm_script } from "std/testing"

pipeline default() {
  with_llm_script(
    [
      llm_text(
        "What can I help with today?{ \"verdict\": \"done\", \"reasoning\": \"greeting\", \"next_step\": \"\" }",
      ),
    ],
    { ->
      let result = agent_loop("Hi, how are you?", nil, {provider: "mock", max_iterations: 1, done_judge: false})
      __io_println(result.status)
      __io_println(result.visible_text)
      __io_println(!contains(result.visible_text, "\"verdict\""))
    },
  )
}
