import { agent_model_options, agent_sanitize_model_options } from "std/agent/options"

pipeline default(harness: Harness) {
  const env_route = agent_model_options(
    harness,
    {
      role: "release",
      env_prefixes: ["HARN_RELEASE", "HARN_PLANNER"],
      defaults: {provider: "mock", model: "gpt-5.4-preview"},
      options: {effort: "high", prompt_cache: true, tool_format: "auto"},
    },
  )
  harness.stdio.println(env_route.provider)
  harness.stdio.println(env_route.model)
  harness.stdio.println(env_route.tool_format)
  harness.stdio.println(env_route.options.effort == nil)
  harness.stdio.println(env_route.options.prompt_cache == nil)
  harness.stdio.println(join(env_route.stripped, ","))
  const explicit = agent_model_options(
    harness,
    {
      role: "release",
      env_prefixes: ["HARN_RELEASE"],
      provider: "mock",
      model: "gpt-5.4-preview",
      options: {effort: "high", tool_format: "auto"},
    },
  )
  harness.stdio.println(explicit.model)
  harness.stdio.println(explicit.options.effort)
  const sanitized = agent_sanitize_model_options(
    harness.llm,
    {provider: "mock", model: "gpt-4o", effort: "high", cache_control: {type: "ephemeral"}},
  )
  harness.stdio.println(sanitized.effort == nil)
  harness.stdio.println(sanitized.cache_control == nil)
  const direct_thinking = agent_sanitize_model_options(
    harness.llm,
    {
      provider: "anthropic",
      model: "claude-sonnet-4-6",
      thinking: {mode: "enabled", budget_tokens: 4096},
    },
  )
  harness.stdio.println(direct_thinking.thinking.mode)
  const proxied_thinking = agent_sanitize_model_options(
    harness.llm,
    {
      provider: "openrouter",
      model: "anthropic/claude-sonnet-4-6",
      thinking: {mode: "enabled", budget_tokens: 4096},
    },
  )
  harness.stdio.println(proxied_thinking.thinking == nil)
  const disabled_thinking = agent_sanitize_model_options(
    harness.llm,
    {provider: "openrouter", model: "anthropic/claude-sonnet-4-6", thinking: {mode: "disabled"}},
  )
  harness.stdio.println(disabled_thinking.thinking.mode)
  const healthcheck = agent_sanitize_model_options(
    harness.llm,
    {
      provider: "cerebras",
      model: "gpt-oss-120b",
      effort: "low",
      thinking: {type: "enabled"},
      prompt_cache: true,
    },
    {mode: "healthcheck"},
  )
  harness.stdio.println(healthcheck.effort == nil)
  harness.stdio.println(healthcheck.thinking == nil)
  harness.stdio.println(healthcheck.prompt_cache == nil)
  const fixed_sampling = agent_sanitize_model_options(
    harness.llm,
    {provider: "openai", model: "gpt-5.6-luna", temperature: 0.0, top_p: 0.9},
  )
  harness.stdio.println(fixed_sampling.temperature == nil)
  harness.stdio.println(fixed_sampling.top_p)
  const codex_sampling = agent_sanitize_model_options(
    harness.llm,
    {provider: "openai", model: "gpt-5.3-codex", temperature: 0.0},
  )
  harness.stdio.println(codex_sampling.temperature == nil)
  const fixed_sampling_pair = agent_sanitize_model_options(
    harness.llm,
    {
      provider: "openrouter",
      model: "moonshotai/kimi-k2.7-code",
      temperature: 0.0,
      top_p: 0.9,
      frequency_penalty: 0.1,
      presence_penalty: 0.1,
    },
  )
  harness.stdio.println(fixed_sampling_pair.temperature == nil)
  harness.stdio.println(fixed_sampling_pair.top_p == nil)
  harness.stdio.println(fixed_sampling_pair.frequency_penalty == nil)
  harness.stdio.println(fixed_sampling_pair.presence_penalty == nil)
  const fixed_provider_controls = agent_sanitize_model_options(
    harness.llm,
    {
      provider: "anthropic",
      model: "claude-sonnet-4-6",
      seed: 42,
      frequency_penalty: 0.1,
      presence_penalty: 0.1,
    },
  )
  harness.stdio.println(fixed_provider_controls.seed == nil)
  harness.stdio.println(fixed_provider_controls.frequency_penalty == nil)
  harness.stdio.println(fixed_provider_controls.presence_penalty == nil)
  const fixed_top_k = agent_sanitize_model_options(
    harness.llm,
    {provider: "gemini", model: "gemini-3.6-pro", top_k: 20},
  )
  harness.stdio.println(fixed_top_k.top_k == nil)
  const fixed_stop = agent_sanitize_model_options(
    harness.llm,
    {provider: "xai", model: "grok-4.5", stop: ["END"]},
  )
  harness.stdio.println(fixed_stop.stop == nil)
  const configurable_sampling = agent_sanitize_model_options(
    harness.llm,
    {provider: "mock", model: "gpt-4o", temperature: 0.2, top_p: 0.8},
  )
  harness.stdio.println(configurable_sampling.temperature)
  harness.stdio.println(configurable_sampling.top_p)
}
