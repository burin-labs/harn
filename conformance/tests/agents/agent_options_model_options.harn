import { agent_model_options, agent_sanitize_model_options } from "std/agent/options"

pipeline default() {
  const env_route = agent_model_options(
    {
      role: "release",
      env_prefixes: ["HARN_RELEASE", "HARN_PLANNER"],
      defaults: {provider: "mock", model: "gpt-5.4-preview"},
      options: {reasoning_effort: "high", prompt_cache: true, tool_format: "auto"},
    },
  )
  __io_println(env_route.provider)
  __io_println(env_route.model)
  __io_println(env_route.tool_format)
  __io_println(env_route.options.reasoning_effort == nil)
  __io_println(env_route.options.prompt_cache == nil)
  __io_println(join(env_route.stripped, ","))
  const explicit = agent_model_options(
    {
      role: "release",
      env_prefixes: ["HARN_RELEASE"],
      provider: "mock",
      model: "gpt-5.4-preview",
      options: {reasoning_effort: "high", tool_format: "auto"},
    },
  )
  __io_println(explicit.model)
  __io_println(explicit.options.reasoning_effort)
  const sanitized = agent_sanitize_model_options(
    {provider: "mock", model: "gpt-4o", reasoning_effort: "high", cache_control: {type: "ephemeral"}},
  )
  __io_println(sanitized.reasoning_effort == nil)
  __io_println(sanitized.cache_control == nil)
  const direct_thinking = agent_sanitize_model_options(
    {
      provider: "anthropic",
      model: "claude-sonnet-4-6",
      thinking: {mode: "enabled", budget_tokens: 4096},
    },
  )
  __io_println(direct_thinking.thinking.mode)
  const proxied_thinking = agent_sanitize_model_options(
    {
      provider: "openrouter",
      model: "anthropic/claude-sonnet-4-6",
      thinking: {mode: "enabled", budget_tokens: 4096},
    },
  )
  __io_println(proxied_thinking.thinking == nil)
  const disabled_thinking = agent_sanitize_model_options(
    {provider: "openrouter", model: "anthropic/claude-sonnet-4-6", thinking: {mode: "disabled"}},
  )
  __io_println(disabled_thinking.thinking.mode)
  const healthcheck = agent_sanitize_model_options(
    {
      provider: "cerebras",
      model: "gpt-oss-120b",
      reasoning_effort: "low",
      thinking: {type: "enabled"},
      prompt_cache: true,
    },
    {mode: "healthcheck"},
  )
  __io_println(healthcheck.reasoning_effort == nil)
  __io_println(healthcheck.thinking == nil)
  __io_println(healthcheck.prompt_cache == nil)
}
