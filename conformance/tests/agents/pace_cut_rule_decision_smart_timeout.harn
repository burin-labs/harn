import { PaceCutRuleDecision, pace_cut_rule_decision } from "std/agent/cut_rules"

fn decision_line(decision: PaceCutRuleDecision) -> string {
  const reason = if decision.reason != nil {
    " " + decision.reason
  } else {
    ""
  }
  const budget = if decision.new_budget_ms != nil {
    " " + to_string(decision.new_budget_ms)
  } else {
    ""
  }
  return decision.action + reason + budget
}

pipeline default(harness: Harness) {
  harness.stdio.println(decision_line(pace_cut_rule_decision({}, {armed_budget_ms: 0})))
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {},
        {armed_budget_ms: 1000, elapsed_ms: 5000, done: true, made_progress: false},
      ),
    ),
  )
  harness.stdio.println(
    decision_line(pace_cut_rule_decision({}, {armed_budget_ms: 1000, elapsed_ms: 500})),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision({}, {armed_budget_ms: 1000, elapsed_ms: 1000, made_progress: false}),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {},
        {
          armed_budget_ms: 1000,
          elapsed_ms: 1000,
          made_progress: true,
          verifier_signature_unchanged: true,
        },
      ),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {},
        {
          armed_budget_ms: 1000,
          elapsed_ms: 1000,
          made_progress: true,
          env_blame_without_infra: true,
        },
      ),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision({}, {armed_budget_ms: 1000, elapsed_ms: 1000, made_progress: true}),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {},
        {armed_budget_ms: 1000, elapsed_ms: 1000, made_progress: true, extends_used: 6},
      ),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {},
        {armed_budget_ms: 1000, elapsed_ms: 3000, expected_total_ms: 1000, made_progress: true},
      ),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {},
        {
          armed_budget_ms: 1000,
          elapsed_ms: 3000,
          expected_total_ms: 1000,
          made_progress: true,
          pace_checks_used: 2,
        },
      ),
    ),
  )
  harness.stdio.println(
    decision_line(
      pace_cut_rule_decision(
        {extend_max: 0},
        {armed_budget_ms: 1000, elapsed_ms: 1000, made_progress: true},
      ),
    ),
  )
}
