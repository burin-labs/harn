fn write_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "write_note",
    "Write a note",
    {
      handler: { _args -> "" },
      parameters: {path: {type: "string", description: "Path to write"}},
      returns: {type: "string"},
    },
  )
  return tools
}

pipeline main() {
  const denied = agent_loop(
    "Try to write a note",
    "You are helpful",
    {
      provider: "mock",
      tools: write_tools(),
      tool_format: "native",
      max_iterations: 1,
      policy: {tools: ["read_only"]},
    },
  )
  __io_println(denied?.tools?.rejected[0] == "write_note")
  const transcript = json_stringify(transcript_messages(denied?.transcript))
  __io_println(!transcript.contains("permission_denied"))
  __io_println(transcript.contains("unknown_tool"))
  __io_println(transcript.contains("write_note"))
  // The visible result is name-resolution feedback, while the structured
  // denial still carries the gate and retry metadata for host harnesses.
  __io_println(transcript.contains("tool_ceiling"))
  __io_println(transcript.contains("retryable"))
  const read_only_denied = agent_loop(
    "Try to write a note",
    "You are helpful",
    {
      provider: "mock",
      tools: write_tools(),
      tool_format: "native",
      max_iterations: 1,
      policy: {
        tools: ["read_only"],
        capabilities: {workspace: ["read_text"]},
        side_effect_level: "read_only",
      },
    },
  )
  __io_println(read_only_denied?.tools?.rejected[0] == "write_note")
  const read_only_transcript = json_stringify(transcript_messages(read_only_denied?.transcript))
  __io_println(!read_only_transcript.contains("permission_denied"))
  __io_println(read_only_transcript.contains("unknown_tool"))
  __io_println(read_only_transcript.contains("write_note"))
}
