import {
  workflow_command_verify_graph,
  workflow_repair_stage_graph,
  workflow_self_verifying_graph,
  workflow_verification_only_graph,
} from "std/workflow/patterns"

pipeline default() {
  const command_verify = workflow_command_verify_graph(
    {
      name: "edit_verify",
      model_policy: {provider: "mock", model: "gpt-4o", iteration_budget: {max: 3}},
      repair_model_policy: {model: "gpt-5.4-preview"},
      verify: {command: "echo ok", expect_status: 0},
    },
  )
  __io_println(command_verify.name)
  __io_println(command_verify.entry)
  __io_println(command_verify.nodes.implement.kind)
  __io_println(command_verify.nodes.verify.kind)
  __io_println(command_verify.nodes.repair.metadata.repairs)
  __io_println(command_verify.nodes.repair.model_policy.model)
  __io_println(len(command_verify.edges))
  __io_println(command_verify.edges[1].branch)
  const self_verify = workflow_self_verifying_graph(
    {act_id: "draft", verify_id: "check", verify: {assert_text: "ok"}},
  )
  __io_println(self_verify.entry)
  __io_println(self_verify.edges[0].to)
  const verify_only = workflow_verification_only_graph(
    {verify_id: "gate", verify: {assert_text: "ok"}},
  )
  __io_println(verify_only.entry)
  __io_println(len(verify_only.edges))
  const repair_stage = workflow_repair_stage_graph(
    {verify: {assert_text: "ok"}, retry_policy: {feedback: true}},
  )
  __io_println(repair_stage.entry)
  __io_println(repair_stage.nodes.repair.kind)
  __io_println(repair_stage.nodes.repair.retry_policy.max_attempts)
  __io_println(len(repair_stage.edges))
}
