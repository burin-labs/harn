import "std/agents"
import { with_llm_script } from "std/testing"

// A background child's own policy is enforced by the child's loop, not by the
// worker carrier. The leaf child here still runs its loop (the scripted turn
// reaches it) and still has its tool ceiling enforced at dispatch.
fn write_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "write_note",
    "Write a note",
    {
      handler: { args -> "wrote " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm,
    [{tool_calls: [{id: "write_1", name: "write_note", arguments: {path: "/workspace/a.txt"}}]}],
    { ->
      const handle = sub_agent_run(
        harness,
        "Try to write.",
        {
          provider: "mock",
          background: true,
          tools: write_tools(),
          tool_format: "native",
          max_iterations: 1,
          policy: {
            tools: ["read_note"],
            capabilities: {workspace: ["read_text"]},
            recursion_limit: 0,
          },
          permissions: {allow: {write_note: { args -> true }}},
        },
      )
      const done = wait_agent(harness.agent, handle)
      const result = worker_result(done)
      harness.stdio.println(done?.status == "completed")
      harness.stdio.println(!result?.ok)
      harness.stdio.println(result?.error?.category == "permission_denied")
      harness.stdio.println(result?.error?.tool == "write_note")
    },
  )
}
