// An unrecognized tool dialect must not vanish into prose.
//
// The parser recognizes tool syntax for a fixed set of wrapper tags, and its
// bare-call sniffer can only execute calls that name a registered tool. A
// dialect it does not know — emitted inside a code fence, or naming a tool the
// registry has never heard of — used to fall through as narration: zero calls,
// zero violations, zero events. These cases pin the property that makes that
// recoverable — the parser reports what it dropped, and the shape detector
// recognizes an invocation by its STRUCTURE, so a dialect nobody has emitted
// yet is caught with no code change.
//
// The negative cases matter just as much: a finding costs the model a
// corrective turn, so fenced source code and prose about the protocol must
// stay silent.

import { agent_parse_tool_calls } from "std/agent/primitives"
import { tool_shape_findings } from "std/llm/tool_shape"

const REGISTRY = {
  _type: "tool_registry",
  tools: [{ name: "look", description: "look at a file", parameters: {} }],
}

fn shapes(text: string) -> string {
  const parsed = agent_parse_tool_calls(text, REGISTRY, "text")
  let out = ""
  for finding in tool_shape_findings(parsed.dropped ?? []) {
    out = out + finding.shape + ";"
  }
  return out
}

pipeline main() {
  // The `<tool>` single-tag dialect, fenced, invoking a tool the registry does
  // not know — dozens of these appeared in raw model bytes with zero parsed
  // calls and, before this, zero violations.
  __io_println(shapes("```\n<tool>\nsearch({ query: \"x\" })\n</tool>\n```"))

  // A dialect invented for this test. Nothing in the detector names it; it is
  // caught because it is SHAPED like an invocation. This is the case that makes
  // the fix a class-kill rather than one more allowlist entry.
  __io_println(shapes("```\n<perform_action>\nsearch({ query: \"x\" })\n</perform_action>\n```"))

  // The bare/native JSON family, spread across lines inside a fence, naming an
  // unregistered tool.
  __io_println(shapes("```\n{\n  \"name\": \"search\",\n  \"arguments\": { \"query\": \"x\" }\n}\n```"))

  // Fenced source code is not an invocation.
  __io_println(shapes("```rust\nfn main() { println!(\"hi\"); }\n```"))
  __io_println(shapes("```html\n<div class=\"x\">hello</div>\n```"))

  // Prose about the protocol carries no arguments and must not fire.
  __io_println(shapes("<assistant_prose>Wrap every call in <tool_call> tags.</assistant_prose>"))

  // A well-formed call parses, so there is nothing to flag.
  const good = agent_parse_tool_calls(
    "<tool_call>\nlook({ file: \"a.rs\" })\n</tool_call>",
    REGISTRY,
    "text",
  )
  __io_println(len(good.tool_calls))
  __io_println(shapes("<tool_call>\nlook({ file: \"a.rs\" })\n</tool_call>"))

  // A fenced call the sniffer can already execute (registered tool) is not a
  // finding — the call ran; feedback would be false.
  const salvaged = agent_parse_tool_calls("```\n<tool>\nlook({ file: \"a.rs\" })\n</tool>\n```", REGISTRY, "text")
  __io_println(len(salvaged.tool_calls))
  __io_println(shapes("```\n<tool>\nlook({ file: \"a.rs\" })\n</tool>\n```"))
}
