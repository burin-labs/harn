import {
  workflow_classify_stage_outcome,
  workflow_evaluate_condition,
  workflow_evaluate_verification,
  workflow_prepare_static_stage,
} from "std/workflow/stage"

pipeline default() {
  let verification = workflow_evaluate_verification(
    {verify: {assert_text: "ok", expect_status: 0}, result: {visible_text: "all ok", exit_status: 0}},
  )
  println(verification.kind)
  println(verification.ok)
  println(len(verification.checks))
  let failed_verification = workflow_evaluate_verification(
    {verify: {assert_text: "missing", expect_status: 1}, result: {text: "present", exit_status: 0}},
  )
  println(failed_verification.ok)
  println(failed_verification.checks[1].actual)
  let condition = workflow_evaluate_condition(
    {
      metadata: {contains_text: "needle"},
      artifacts: [{id: "a", kind: "summary", text: "hay"}, {id: "b", kind: "summary", text: "needle here"}],
    },
  )
  println(condition.matched)
  println(json_stringify(condition.consumed_artifact_ids))
  let kind_condition = workflow_evaluate_condition(
    {metadata: {artifact_kind: "diff"}, artifacts: [{id: "d", kind: "diff"}]},
  )
  println(kind_condition.matched)
  let verify_outcome = workflow_classify_stage_outcome(
    {node_kind: "verify", result: {status: "completed"}, verification: {ok: false}},
  )
  println(verify_outcome.outcome)
  println(verify_outcome.branch)
  let stuck_outcome = workflow_classify_stage_outcome(
    {node_kind: "stage", result: {status: "stuck"}, verification: {ok: true}},
  )
  println(stuck_outcome.outcome)
  println(stuck_outcome.branch)
  let done_outcome = workflow_classify_stage_outcome(
    {node_kind: "stage", result: {status: "done"}, verification: {ok: true}},
  )
  println(done_outcome.outcome)
  println(done_outcome.branch)
  let subagent_outcome = workflow_classify_stage_outcome(
    {node_kind: "subagent", result: {status: "completed"}, verification: {ok: true}},
  )
  println(subagent_outcome.outcome)
  println(subagent_outcome.branch)
  let static_condition = workflow_prepare_static_stage(
    {
      node_id: "gate",
      node: {kind: "condition", metadata: {artifact_kind: "summary"}},
      artifacts: [{id: "s", kind: "summary", text: "ok"}],
    },
  )
  println(static_condition.result.text)
  println(static_condition.outcome)
  let static_reduce = workflow_prepare_static_stage(
    {
      node_id: "reduce",
      node: {kind: "reduce", reduce_policy: {separator: " / "}, output_contract: {output_kinds: ["plan"]}},
      artifacts: [{id: "a", kind: "summary", text: "one"}, {id: "b", kind: "summary", text: "two"}],
    },
  )
  println(static_reduce.result.text)
  println(static_reduce.artifacts[0].kind)
  println(json_stringify(static_reduce.artifacts[0].lineage))
  let static_escalation = workflow_prepare_static_stage(
    {
      node_id: "escalate",
      node: {kind: "escalation", escalation_policy: {queue: "review", level: "high", reason: "needs owner"}},
      artifacts: [{id: "input", kind: "plan", text: "blocked"}],
    },
  )
  println(static_escalation.result.text)
  println(static_escalation.artifacts[0].data.queue)
  println(static_escalation.branch)
}
