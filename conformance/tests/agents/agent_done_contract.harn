import { agent_capture_events } from "std/agent/events"
import { agent_done_contract } from "std/agent/judge"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn events_of(events: any, kind: string) {
  return events.filter({ event -> event.type == kind })
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text(
        "Implemented two page-cache tests.\n\nDone claim:\n- requested work: add five page-cache tests\n- evidence: fetch and cached-fetch tests pass\n- files changed: tests/unit/page_cache_extra_test.cpp\n- not done: none\n##DONE##",
      ),
      llm_text(
        "{\"verdict\":\"continue\",\"detail\":\"Add the missing LRU eviction, dirty flush, and pinned-page prevention tests.\"}",
      ),
      llm_text(
        "Added the LRU eviction, dirty flush, and pinned-page prevention cases.\n\nDone claim:\n- requested work: add five page-cache tests\n- evidence: all five page-cache test cases pass in the target suite\n- files changed: tests/unit/page_cache_extra_test.cpp\n- not done: none\n##DONE##",
      ),
      llm_text(
        "{\"verdict\":\"done\",\"detail\":\"All five requested cases are named and the target suite passes.\"}",
      ),
    ],
    { ->
      const session_id = "done-contract-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session_id,
        fn() { return agent_loop(
          harness,
          "Add page-cache tests for fetch, cached fetch, LRU eviction, dirty flush, and pinned-page prevention.",
          nil,
          {
            provider: "mock",
            session_id: session_id,
            max_iterations: 4,
            max_nudges: 4,
            done_sentinel: "##DONE##",
          }
            + agent_done_contract({model: "mock-judge"}),
        ) },
      )
      const result = captured.result
      const judges = events_of(captured.events, "judge_decision")
      harness.stdio.println(result.status)
      harness.stdio.println(result.llm.iterations)
      harness.stdio.println(len(harness.llm.mock_calls()))
      harness.stdio.println(len(judges))
      harness.stdio.println(judges[0].next_step)
      harness.stdio.println(judges[1].reasoning)
      harness.stdio.println(result.visible_text.contains("Added the LRU eviction"))
      harness.stdio.println(to_string(harness.llm.mock_calls()[0].system).contains("Done claim"))
      harness.stdio.println(
        json_stringify(harness.llm.mock_calls()[2].messages).contains(
          "Add the missing LRU eviction",
        ),
      )
    },
  )
}
