import { agent_capture_events } from "std/agent/events"
import { llm_text, with_llm_script } from "std/testing"
import { agent_loop } from "../../../crates/harn-stdlib/src/stdlib/agent/loop.harn"

/**
 * The no-progress streak's wording, per tool-call paradigm.
 *
 * This case used to read the rendered nudge out of the model's packet, because
 * the streak injected it. The streak is now receipts-only: it still renders the
 * paradigm-specific text and still records it, and it no longer puts it in the
 * packet. So the observation point moves from the packet to the receipt and
 * every wording claim below is preserved rather than dropped, which is the
 * point of keeping this case at all. `content` is one of the three fields the
 * typed feedback event carries, so the rendered text survives the projection.
 *
 * The packet is still read, once per mode, to assert the text is NOT there.
 */
fn note_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "write_note",
    "Write a note.",
    {
      handler: { args -> "wrote " + args.path },
      parameters: {path: {type: "string", description: "Path to write"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  return tools
}

fn failing_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "explode",
    "Throw from a Harn-side handler.",
    {
      handler: { _args ->
        throw "boom from tool handler"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

/**
 * The rendered text of the last streak RECEIPT, or "" when the streak never
 * fired. Selected on `kind`: every custom loop event is captured as a
 * `feedback_injected` row carrying its emitted name there, so a selector on
 * `type` matches nothing and an unfired mechanism and a mis-selected one look
 * identical.
 */
fn streak_receipt_text(events: any) -> string {
  const rows = events.filter(
    { event ->
      to_string(event.type) == "feedback_injected"
        && to_string(event?.kind ?? "") == "no_progress_streak_nudge"
    },
  )
    .to_list()
  if len(rows) == 0 {
    return ""
  }
  return to_string(rows[len(rows) - 1].content ?? "")
}

fn messages_for_streak_retry(calls: any) {
  return calls[2].messages[len(calls[2].messages) - 1].content
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      llm_text("The context appears consistent."),
      llm_text("The surrounding details remain aligned."),
      llm_text("<user_response>done</user_response>\n<done>##DONE##</done>"),
    ],
    { ->
      const text_session = "npf-text-" + harness.random.uuid()
      const text_captured = agent_capture_events(
        harness.agent,
        text_session,
        fn() { return agent_loop(
          harness,
          "Write notes.txt.",
          nil,
          {
            provider: "mock",
            tool_format: "text",
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 4,
            max_nudges: 4,
            tools: note_tools(),
            session_id: text_session,
          },
        ) },
      )
      const text_result = text_captured.result
      const text_receipt = streak_receipt_text(text_captured.events)
      const text_retry = messages_for_streak_retry(harness.llm.mock_calls())
      harness.stdio.println("text.status=" + text_result.status)
      harness.stdio.println("text.receipt_rendered=" + to_string(trim(text_receipt) != ""))
      // The demotion itself: rendered above, absent from the packet here.
      harness.stdio.println(
        "text.not_in_packet="
          + to_string(!contains(text_retry, "<directive authority=\"corrective\"")),
      )
      harness.stdio.println(
        "text.has_tool_call_tag=" + to_string(contains(text_receipt, "<tool_call>")),
      )
      harness.stdio.println(
        "text.has_user_response_tag=" + to_string(contains(text_receipt, "<user_response>")),
      )
      harness.stdio.println(
        "text.no_native_final=" + to_string(!contains(text_receipt, "concise assistant text")),
      )
    },
  )
  with_llm_script(
    harness.llm,
    [
      llm_text("The context appears consistent."),
      llm_text("The surrounding details remain aligned."),
      llm_text("##DONE##"),
    ],
    { ->
      const native_session = "npf-native-" + harness.random.uuid()
      const native_captured = agent_capture_events(
        harness.agent,
        native_session,
        fn() { return agent_loop(
          harness,
          "Write notes.txt.",
          nil,
          {
            provider: "mock",
            tool_format: "native",
            loop_until_done: true,
            done_sentinel: "##DONE##",
            turn_end_condition: nil,
            max_iterations: 4,
            max_nudges: 4,
            tools: note_tools(),
            session_id: native_session,
          },
        ) },
      )
      const native_result = native_captured.result
      const native_receipt = streak_receipt_text(native_captured.events)
      const native_retry = messages_for_streak_retry(harness.llm.mock_calls())
      harness.stdio.println("native.status=" + native_result.status)
      harness.stdio.println("native.receipt_rendered=" + to_string(trim(native_receipt) != ""))
      // The demotion itself: rendered above, absent from the packet here.
      harness.stdio.println(
        "native.not_in_packet="
          + to_string(!contains(native_retry, "<directive authority=\"corrective\"")),
      )
      harness.stdio.println(
        "native.has_native_final=" + to_string(contains(native_receipt, "concise assistant text")),
      )
      harness.stdio.println(
        "native.has_native_tool=" + to_string(contains(native_receipt, "native tool")),
      )
      harness.stdio.println(
        "native.no_tool_call_tag=" + to_string(!contains(native_receipt, "<tool_call>")),
      )
      harness.stdio.println(
        "native.no_user_response_tag=" + to_string(!contains(native_receipt, "<user_response>")),
      )
    },
  )
  with_llm_script(
    harness.llm,
    [
      llm_text("The context appears consistent."),
      llm_text("The surrounding details remain aligned."),
      llm_text("##DONE##"),
    ],
    { ->
      const json_session = "npf-json-" + harness.random.uuid()
      const json_captured = agent_capture_events(
        harness.agent,
        json_session,
        fn() { return agent_loop(
          harness,
          "Write notes.txt.",
          nil,
          {
            provider: "mock",
            tool_format: "json",
            loop_until_done: true,
            done_sentinel: "##DONE##",
            turn_end_condition: nil,
            max_iterations: 4,
            max_nudges: 4,
            tools: note_tools(),
            session_id: json_session,
          },
        ) },
      )
      const json_result = json_captured.result
      const json_receipt = streak_receipt_text(json_captured.events)
      const json_retry = messages_for_streak_retry(harness.llm.mock_calls())
      harness.stdio.println("json.status=" + json_result.status)
      harness.stdio.println("json.receipt_rendered=" + to_string(trim(json_receipt) != ""))
      // The demotion itself: rendered above, absent from the packet here.
      harness.stdio.println(
        "json.not_in_packet="
          + to_string(!contains(json_retry, "<directive authority=\"corrective\"")),
      )
      harness.stdio.println("json.has_tool_fence=" + to_string(contains(json_receipt, "```tool")))
      harness.stdio.println(
        "json.no_tool_call_tag=" + to_string(!contains(json_receipt, "<tool_call>")),
      )
      harness.stdio.println(
        "json.no_user_response_tag=" + to_string(!contains(json_receipt, "<user_response>")),
      )
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "bad1", name: "explode", arguments: {}}]},
      {text: "", tool_calls: [{id: "bad2", name: "explode", arguments: {}}]},
      llm_text("##DONE##"),
    ],
    { ->
      const rejected_result = agent_loop(
        harness,
        "Call the failing tool twice, then finish.",
        nil,
        {
          provider: "mock",
          tool_format: "native",
          loop_until_done: true,
          done_sentinel: "##DONE##",
          turn_end_condition: nil,
          max_iterations: 4,
          max_nudges: 4,
          tools: failing_tools(),
        },
      )
      const rejected_retry = json_stringify(harness.llm.mock_calls()[2].messages)
      harness.stdio.println("rejected.status=" + rejected_result.status)
      harness.stdio.println(
        "rejected.has_failure=" + to_string(contains(rejected_retry, "boom from tool handler")),
      )
      harness.stdio.println(
        "rejected.no_streak=" + to_string(!contains(rejected_retry, "no_progress_streak")),
      )
    },
  )
}
