import { workflow_stages } from "std/workflow/patterns"

/**
 * workflow_stages (design D5): the ergonomic linear-stage-graph builder is
 * pure sugar over `workflow_graph`. Its output must be BYTE-IDENTICAL to the
 * equivalent hand-authored `workflow_graph({entry, nodes, edges})` — no new
 * node shape, no new runtime concept.
 */
pipeline default(harness: Harness) {
  // 1. Byte-identical to a hand-authored two-stage graph (linear edge auto-wired).
  const sugar = workflow_stages(
    {
      name: "demo",
      stages: [
        {id: "act", kind: "stage", mode: "agent", model_policy: {provider: "mock"}},
        {id: "check", kind: "verify", mode: "command", verify: {expect_status: 0}},
      ],
    },
  )
  const hand = workflow_graph(
    {
      name: "demo",
      entry: "act",
      nodes: {
        act: {kind: "stage", mode: "agent", model_policy: {provider: "mock"}},
        check: {kind: "verify", mode: "command", verify: {expect_status: 0}},
      },
      edges: [{from: "act", to: "check"}],
    },
  )
  // The substantive graph — node dicts, edges, entry, name — is byte-identical.
  // (Only the auto-generated top-level `id` differs, being a fresh uuid.)
  harness.stdio.println(json_stringify(sugar.nodes) == json_stringify(hand.nodes))
  harness.stdio.println(json_stringify(sugar.edges) == json_stringify(hand.edges))
  harness.stdio.println(sugar.entry == hand.entry)
  harness.stdio.println(sugar.name == hand.name)
  // 2. Bare-list form + default ids (`stage_<n>`) + first-stage entry.
  const bare = workflow_stages([{kind: "stage"}, {kind: "stage"}, {kind: "stage"}])
  harness.stdio.println(json_stringify(keys(bare.nodes)))
  harness.stdio.println(bare.entry)
  harness.stdio.println(len(bare.edges))
  harness.stdio.println(bare.edges[0].from + "->" + bare.edges[0].to)
  harness.stdio.println(bare.edges[1].from + "->" + bare.edges[1].to)
  // 3. Explicit edges override the linear default (branching graphs).
  const branched = workflow_stages(
    {
      name: "loop",
      stages: [
        {id: "impl", kind: "stage"},
        {id: "verify", kind: "verify"},
        {id: "repair", kind: "stage"},
      ],
      edges: [
        {from: "impl", to: "verify"},
        {from: "verify", to: "repair", branch: "failed"},
        {from: "repair", to: "verify"},
      ],
    },
  )
  harness.stdio.println(len(branched.edges))
  harness.stdio.println(branched.edges[1].branch)
  // 4. The authored node body is preserved verbatim (id lifts to the map key).
  harness.stdio.println(branched.nodes["impl"].kind)
  harness.stdio.println(contains(json_stringify(keys(branched.nodes)), "impl"))
}
