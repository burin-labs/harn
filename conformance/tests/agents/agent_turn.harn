import { agent_turn } from "std/agent/turn"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  // Scripted LLM turns via with_llm_script: the scope auto-clears the
  // queue on entry and restores it on exit, replacing the imperative
  // harness.llm.mock_clear() + sequential harness.llm.mock_enqueue(...) form.
  with_llm_script(
    harness.llm, [
      llm_text("<user_response>Agent turn complete.</user_response>\n<done>##DONE##</done>"),
      llm_text("{\"verdict\":\"done\",\"reasoning\":\"answer is complete\"}"),
    ],
    { ->
      const result = agent_turn(harness, "Do the task",
        {provider: "mock", system: "You are helpful.", max_iterations: 3},
      )
      harness.stdio.println(result.status)
      harness.stdio.println(result.visible_text)
      harness.stdio.println(len(result.judge_decisions))
      harness.stdio.println(result.judge_decisions[0].verdict)
      harness.stdio.println(result.judge_decisions[0].source)
      harness.stdio.println(result.llm.iterations)
      harness.stdio.println(len(result.iterations) >= 1)
      const calls = harness.llm.mock_calls()
      harness.stdio.println(len(calls))
      harness.stdio.println(contains(calls[0].system, "Before each group of tool calls"))
      harness.stdio.println(contains(calls[0].system, "You are helpful."))
    },
  )
}
