pipeline default() {
  llm_mock_clear()
  llm_mock({text: "<user_response>Agent turn complete.</user_response>\n<done>##DONE##</done>"})
  llm_mock({text: "{\"verdict\":\"done\",\"reasoning\":\"answer is complete\"}"})
  let result = agent_turn("Do the task", {provider: "mock", system: "You are helpful.", max_iterations: 3})
  println(result.status)
  println(result.visible_text)
  println(len(result.judge_decisions))
  println(result.judge_decisions[0].verdict)
  println(result.llm.iterations)
  println(len(result.iterations) >= 1)
  let calls = llm_mock_calls()
  println(len(calls))
  println(contains(calls[0].system, "Before each group of tool calls"))
  println(contains(calls[0].system, "You are helpful."))
}
