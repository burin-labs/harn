pipeline main(harness: Harness, task) {
  const root = harness.agent.open("ancestry-root")
  harness.agent.inject(root, {role: "user", content: "hello"})
  harness.agent.inject(root, {role: "assistant", content: "hi"})
  const depth1 = harness.agent.fork(root, "ancestry-depth1")
  const depth2 = harness.agent.fork(depth1, "ancestry-depth2")
  const depth3 = harness.agent.fork_at(depth2, 1, "ancestry-depth3")
  const depth3_ancestry = harness.agent.ancestry(depth3)
  assert(depth3_ancestry["parent_id"] == depth2, "fork_at child records its parent")
  assert(depth3_ancestry["root_id"] == root, "ancestry walks the full chain back to root")
  const depth2_snap = harness.agent.snapshot(depth2)
  const depth3_snap = harness.agent.snapshot(depth3)
  assert(contains(depth2_snap["child_ids"], depth3), "parent snapshot includes fork_at child id")
  assert(depth3_snap["parent_id"] == depth2, "snapshot exposes child parent_id")
  assert(depth3_snap["branched_at_event_index"] == 1, "fork_at records branch point")
  assert(len(depth3_snap["messages"]) == 1, "fork_at truncates child transcript")
  const fanout = harness.agent.open("ancestry-fanout")
  harness.agent.inject(fanout, {role: "user", content: "seed"})
  const left = harness.agent.fork(fanout, "ancestry-left")
  const right = harness.agent.fork(fanout, "ancestry-right")
  const fanout_snap = harness.agent.snapshot(fanout)
  assert(len(fanout_snap["child_ids"]) == 2, "fanout parent tracks both children")
  assert(contains(fanout_snap["child_ids"], left), "fanout parent includes left child")
  assert(contains(fanout_snap["child_ids"], right), "fanout parent includes right child")
  assert(harness.agent.ancestry(left)["root_id"] == fanout, "left child resolves root_id")
  assert(harness.agent.ancestry(right)["root_id"] == fanout, "right child resolves root_id")
  harness.stdio.log("agent_sessions ancestry tests passed")
}
