import { agent_command_tools } from "std/agent/host_tools"

pipeline main() {
  let root = path_join(temp_dir(), "harn-host-tools-loop-" + uuid())
  mkdir(root, true)
  let tools = agent_command_tools(
    nil,
    {root: root, cwd: root, max_inline_bytes: 4, allow_argv_prefixes: [["sh", "-c"]]},
  )
  llm_mock_clear()
  llm_mock(
    {
      text: "",
      tool_calls: [
        {
          id: "run1",
          name: "run_command",
          arguments: {argv: ["sh", "-c", "printf toolhistory"], capture: {max_inline_bytes: 4}},
        },
      ],
    },
  )
  llm_mock({text: "Saw the command result."})
  let result = agent_loop(
    "Run the command and report back.",
    nil,
    {
      provider: "mock",
      tools: tools,
      tool_format: "native",
      persistent: true,
      max_iterations: 3,
      done_judge: nil,
    },
  )
  println(result.status)
  let calls = llm_mock_calls()
  println(len(calls) >= 2)
  println(!contains(calls[0].system, "##DONE##"))
  println(!contains(calls[1].system, "##DONE##"))
  println(contains(calls[0].system, "no more tool calls"))
  let second_turn = json_stringify(calls[1].messages)
  println(contains(second_turn, "byte_count"))
  println(contains(second_turn, "tool"))
}
