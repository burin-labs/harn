import { agent_loop } from "std/agent/loop"
import { agent_command_tools } from "std/agent/host_tools"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  const root = path_join(harness.fs.workspace_temp_dir(), "harn-host-tools-loop-" + harness.random.uuid())
  harness.fs.mkdir(root, true)
  const tools = agent_command_tools(harness, nil,
    {root: root, cwd: root, max_inline_bytes: 4, allow_argv_prefixes: [["sh", "-c"]]},
  )
  with_llm_script(
    harness.llm, [
      {
        text: "",
        tool_calls: [
          {
            id: "run1",
            name: "run_command",
            arguments: {argv: ["sh", "-c", "printf toolhistory"], capture: {max_inline_bytes: 4}},
          },
        ],
      },
      llm_text("Saw the command result."),
    ],
    { ->
      const result = agent_loop(harness, "Run the command and report back.",
        nil,
        {
          provider: "mock",
          tools: tools,
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          done_judge: nil,
        },
      )
      harness.stdio.println(result.status)
      const calls = harness.llm.mock_calls()
      harness.stdio.println(len(calls) >= 2)
      harness.stdio.println(!contains(calls[0].system, "##DONE##"))
      harness.stdio.println(!contains(calls[1].system, "##DONE##"))
      harness.stdio.println(contains(calls[0].system, "no more tool calls"))
      const second_turn = json_stringify(calls[1].messages)
      harness.stdio.println(contains(second_turn, "byte_count"))
      harness.stdio.println(contains(second_turn, "tool"))
    },
  )
}
