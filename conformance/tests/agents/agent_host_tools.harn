import { agent_command_tools, agent_host_tools } from "std/agent/host_tools"

pipeline main() {
  const root = path_join(harness.fs.temp_dir(), "harn-host-tools-" + uuid())
  const outside = path_join(harness.fs.temp_dir(), "harn-host-tools-outside-" + uuid())
  harness.fs.mkdir(root, true)
  harness.fs.mkdir(outside, true)
  harness.fs.mkdir(path_join(root, "logs"), true)
  harness.fs.write_text(path_join(root, "README.md"), "alpha\nbeta\ngamma\n")
  harness.fs.write_text(path_join(root, "logs/llm_transcript.jsonl"), "beta from transcript\n")
  const tools = agent_host_tools(
    nil,
    {
      root: root,
      cwd: root,
      max_inline_bytes: 4,
      allow_argv_prefixes: [["sh", "-c"]],
      names: {
        run_command: "release_run",
        read_command_output: "release_read_output",
        read_command_output_tail: "release_output_tail",
      },
      annotations: {run_command: {fixture_marker: "custom"}},
      exclude_globs: ["logs/**"],
    },
  )
  const surface = tool_surface_validate({tools: tools, policy: {side_effect_level: "process_exec"}})
  __io_println(surface.valid)
  __io_println(tool_find(tools, "release_run").annotations.result_readers[0])
  __io_println(tool_find(tools, "release_run").annotations.fixture_marker)
  __io_println(tool_find(tools, "poll_command") == nil)
  const read = agent_dispatch_tool_call(
    {id: "r1", name: "read_file", arguments: {path: "README.md", limit_bytes: 5}},
    tools,
  )
  const read_data = json_parse(read.rendered_result)
  __io_println(read_data.content)
  const search = agent_dispatch_tool_call(
    {
      id: "s1",
      name: "search_files",
      arguments: {pattern: "beta", fixed_strings: true, exclude_globs: ["*.none"]},
    },
    tools,
  )
  const search_data = json_parse(search.rendered_result)
  __io_println(search_data.matches[0].line)
  const run = agent_dispatch_tool_call(
    {
      id: "c1",
      name: "release_run",
      arguments: {argv: ["sh", "-c", "printf abcdefghij"], capture: {max_inline_bytes: 100}},
    },
    tools,
  )
  __io_println(run.ok)
  const data = json_parse(run.rendered_result)
  __io_println(data.stdout)
  __io_println(data.byte_count)
  const tail = agent_dispatch_tool_call(
    {id: "c2", name: "release_output_tail", arguments: {command_id: data.command_id, length: 3}},
    tools,
  )
  const tail_data = json_parse(tail.rendered_result)
  __io_println(tail_data.content)
  const cwd_blocked = agent_dispatch_tool_call(
    {id: "c3", name: "release_run", arguments: {argv: ["sh", "-c", "pwd"], cwd: outside}},
    tools,
  )
  __io_println(cwd_blocked.ok)
  __io_println(contains(cwd_blocked.error, "absolute paths are disabled"))
  const git_blocked = agent_dispatch_tool_call(
    {id: "g1", name: "git_inspect", arguments: {operation: "status", repo: outside}},
    tools,
  )
  __io_println(git_blocked.ok)
  __io_println(contains(git_blocked.error, "absolute paths are disabled"))
  const blocked = agent_dispatch_tool_call({id: "c3", name: "release_run", arguments: {argv: ["echo", "no"]}}, tools)
  const blocked_data = json_parse(blocked.rendered_result)
  __io_println(blocked_data.blocked)
  const lifecycle_tools = agent_command_tools(
    nil,
    {root: root, cwd: root, background_commands: true, allow_argv_prefixes: [["sh", "-c"]]},
  )
  __io_println(tool_find(lifecycle_tools, "poll_command") != nil)
  __io_println(tool_find(lifecycle_tools, "wait_command") != nil)
  __io_println(tool_find(lifecycle_tools, "kill_command") != nil)
  __io_println(!tool_find(lifecycle_tools, "poll_command").parameters.handle_id.required)
  __io_println(!tool_find(lifecycle_tools, "wait_command").parameters.handle_id.required)
  __io_println(!tool_find(lifecycle_tools, "kill_command").parameters.handle_id.required)
  const poll = agent_dispatch_tool_call(
    {id: "p1", name: "poll_command", arguments: {handle_id: "missing-handle"}},
    lifecycle_tools,
  )
  const poll_data = json_parse(poll.rendered_result)
  __io_println(poll_data.status)
  const poll_alias = agent_dispatch_tool_call(
    {id: "p2", name: "poll_command", arguments: {handle: "missing-handle-alias"}},
    lifecycle_tools,
  )
  const poll_alias_data = json_parse(poll_alias.rendered_result)
  __io_println(poll_alias_data.status)
  const background = agent_dispatch_tool_call(
    {
      id: "bg1",
      name: "run_command",
      arguments: {argv: ["sh", "-c", "printf toolwait"], background: true},
    },
    lifecycle_tools,
  )
  const background_data = json_parse(background.rendered_result)
  __io_println(background_data.handle_id != nil)
  const waited = agent_dispatch_tool_call(
    {
      id: "w1",
      name: "wait_command",
      arguments: {handle_id: background_data.handle_id, timeout_ms: 5000},
    },
    lifecycle_tools,
  )
  const waited_data = json_parse(waited.rendered_result)
  __io_println(waited_data.status)
  __io_println(
    contains(
      waited_data?.combined ?? waited_data?.stdout ?? waited_data?.inline_output ?? "",
      "toolwait",
    ),
  )
  const killed = agent_dispatch_tool_call(
    {id: "k1", name: "kill_command", arguments: {handle_id: "missing-handle"}},
    lifecycle_tools,
  )
  const killed_data = json_parse(killed.rendered_result)
  __io_println(killed_data.cancelled)
}
