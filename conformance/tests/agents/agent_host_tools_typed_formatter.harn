import { __agent_host_command_result } from "std/agent/host_command_result"
import { agent_command_tools } from "std/agent/host_tools"
import { agent_dispatch_tool_call } from "std/agent/primitives"
import { agent_tool_handler_result } from "std/agent/tool_lifecycle"

pipeline main(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("harn-host-tools-typed-")
  const tools = agent_command_tools(
    harness,
    nil,
    {
      root: root,
      cwd: root,
      allow_argv_prefixes: [["sh", "-c"]],
      result_formatter: { value, _key ->
        return agent_tool_handler_result(
          "command-ok",
          {exit_code: value.exit_code, stdout: value.stdout},
        )
      },
    },
  )
  const result = agent_dispatch_tool_call(
    harness.tools,
    {name: "run_command", arguments: {argv: ["sh", "-c", "printf typed-output"]}},
    tools,
  )
  harness.stdio.println(result.ok)
  harness.stdio.println(result.rendered_result)
  harness.stdio.println(result.result.schema)
  harness.stdio.println(result.result.data.exit_code)
  harness.stdio.println(result.result.data.stdout)
  const failed = agent_dispatch_tool_call(
    harness.tools,
    {name: "run_command", arguments: {argv: ["sh", "-c", "exit 7"]}},
    tools,
  )
  assert(failed.ok == false)
  assert(failed.error_category == "tool_error")
  assert(failed.result.outcome == "error")
  assert(failed.result.data.exit_code == 7)
  assert(failed.rendered_result == "command-ok")
  const denied = agent_dispatch_tool_call(
    harness.tools,
    {name: "run_command", arguments: {argv: ["printf", "must not run"]}},
    tools,
  )
  assert(denied.ok == false)
  assert(denied.error_category == "tool_rejected")
  assert(denied.result.outcome == "rejected")
  assert(denied.rendered_result == "command-ok")
  // A refused source witness has no qualified exit. Preserve rejection even
  // when formatted feedback omits the host status and no numeric exit exists.
  const refused_data = {status: "blocked", exit_code: nil, signal: nil, timed_out: false}
  const unwitnessed = __agent_host_command_result("command-ok", refused_data)
  assert(unwitnessed.outcome == "rejected")
  assert(unwitnessed.data == refused_data)
  const completed_data = {status: "completed", exit_code: 0, signal: nil, timed_out: false}
  const witnessed = __agent_host_command_result("command-ok", completed_data)
  assert(witnessed.outcome == "ok")
  assert(witnessed.data == completed_data)
  harness.fs.delete(root)
}
