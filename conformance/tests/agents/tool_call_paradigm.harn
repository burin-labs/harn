import { agent_render_tool_call_exemplar, agent_tool_call_paradigm } from "std/agent/preflight"
import { tool_contract_json_prompt } from "std/agent/prompts"

/**
 * The format-aware tool-call paradigm: prompt/tool-description authors reference
 * `body_hint` and the exemplar renderer, and the runtime maps them to whatever
 * the current model's tool-calling format expects. These assertions pin the two
 * shipped paradigms (text heredoc / native JSON) so a regression in the IR is
 * caught before it silently mis-formats every agent prompt.
 */
pipeline default(harness: Harness) {
  const text = agent_tool_call_paradigm(harness.llm, {tool_format: "text"})
  harness.stdio.println(text.kind == "text")
  harness.stdio.println(text.call_open == "<tool_call>")
  harness.stdio.println(contains(text.body_hint, "heredoc"))
  harness.stdio.println(contains(text.body_hint, "Never wrap code"))
  const native = agent_tool_call_paradigm(harness.llm, {tool_format: "native"})
  harness.stdio.println(native.kind == "native")
  harness.stdio.println(contains(native.body_hint, "JSON string"))
  harness.stdio.println(!contains(native.body_hint, "heredoc"))
  const json = agent_tool_call_paradigm(harness.llm, {tool_format: "json"})
  const json_contract = tool_contract_json_prompt(
    harness.fs,
    {done_sentinel: nil, body_hint: json.body_hint, expanded_schemas: "No tools."},
  )
  if len(json_contract.split("For a multi-line or code-bearing field")) != 2 {
    throw "fenced-JSON contract must teach the multiline body exactly once"
  }
  if json.body_hint.contains("Each tool call") || json.body_hint.contains("For several calls") {
    throw "body_hint must own body transport only, not duplicate the enclosing call contract"
  }
  // The exemplar renderer uses the escape-free body channel for body-marked args
  // and quoted scalars otherwise — in the CURRENT paradigm.
  const ex = agent_render_tool_call_exemplar(
    harness.llm,
    "edit",
    [
      {key: "action", value: "create"},
      {key: "path", value: "t.rs"},
      {key: "content", value: "fn main() {}", body: true},
    ],
    {tool_format: "text"},
  )
  harness.stdio.println(contains(ex, "<tool_call>edit({ action: \"create\""))
  harness.stdio.println(contains(ex, "content: <<EOF\nfn main() {}\nEOF })"))
}
