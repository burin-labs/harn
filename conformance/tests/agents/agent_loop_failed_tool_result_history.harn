import { llm_text, with_llm_script } from "std/testing"

fn failing_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "explode",
    "Throw from a Harn-side handler",
    {
      handler: { _args ->
        throw "boom from tool handler"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  const tools = failing_tools()
  with_llm_script(
    harness.llm, [
      {text: "", tool_calls: [{id: "bad1", name: "explode", arguments: {}}]},
      llm_text("I saw the failed tool result."),
    ],
    { ->
      const result = agent_loop(harness, "Call the failing tool, then summarize the failure.",
        nil,
        {
          provider: "mock",
          tools: tools,
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          done_judge: nil,
        },
      )
      harness.stdio.println(result.status)
      harness.stdio.println(result.tools.successful == [])
      harness.stdio.println(contains(result.tools.rejected, "explode"))
      const calls = harness.llm.mock_calls()
      const second_turn = json_stringify(calls[1].messages)
      harness.stdio.println(contains(second_turn, "boom from tool handler"))
      harness.stdio.println(contains(second_turn, "error"))
    },
  )
}
