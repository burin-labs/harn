import { llm_text, with_llm_script } from "std/testing"

fn tools() {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "lookup",
    "Lookup evidence",
    {
      handler: { _args -> "evidence" },
      parameters: {query: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return registry
}

pipeline default() {
  with_llm_script(
    [llm_text("```tool\n{\"name\":\"lookup\",\"args\":{\"query\":\"x\"}}\n```"), llm_text("evidence")],
    { ->
      const result = agent_loop(
        "Use lookup.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "json",
          loop_until_done: true,
          max_iterations: 3,
          max_nudges: 1,
          require_successful_tools: ["lookup"],
        },
      )
      __io_println(result.status)
      __io_println(result.stop_reason)
      __io_println(result.visible_text)
      __io_println(result.llm.iterations)
    },
  )
}
