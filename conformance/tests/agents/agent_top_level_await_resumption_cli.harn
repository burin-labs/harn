import "../_common"

fn first_snapshot_line(text) {
  const matches = regex_captures("snapshot=(.+)", text)
  if len(matches) == 0 {
    return nil
  }
  return matches[0].groups[0]
}

pipeline main() {
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or("HARN_CONFORMANCE_HARN_BIN", resolve_harn_bin(harness, repo_root))
  const root = path_join(harness.fs.temp_dir(), "harn-top-level-resume-" + uuid_v7())
  harness.fs.mkdir(root)
  const script = path_join(root, "top_level_suspend.harn")
  harness.fs.write_text(
    script,
    "pipeline main() {\n"
      + "  llm_mock({tool_calls: [{id: \"park_1\", name: \"agent_await_resumption\", arguments: {reason: \"waiting on operator\"}}]})\n"
      + "  let result = agent_loop(\"Park until the operator resumes.\", nil, {provider: \"mock\", tool_format: \"native\", max_iterations: 2, session_id: \"top-level-\" + uuid_v7()})\n"
      + "  __io_println(\"status=\" + result.status)\n"
      + "  __io_println(\"reason=\" + result.reason)\n"
      + "  __io_println(\"handle_status=\" + result.handle.status)\n"
      + "  __io_println(\"snapshot=\" + result.handle.snapshot_path)\n"
      + "}\n",
  )
  const first = exec_at(root, harn_bin, "run", script)
  __io_println(first.success)
  __io_println(contains(first.stdout, "status=suspended"))
  __io_println(contains(first.stdout, "reason=waiting on operator"))
  __io_println(contains(first.stdout, "handle_status=suspended"))
  const snapshot = first_snapshot_line(first.stdout)
  require snapshot != nil, "top-level suspend did not print a snapshot path"
  const snapshot_path = if path_is_absolute(snapshot) {
    snapshot
  } else {
    path_join(root, snapshot)
  }
  __io_println(harness.fs.exists(snapshot_path))
  const second = exec_at(root, harn_bin, "run", "--resume", snapshot, "--json")
  __io_println(second.success)
  const lines = second.stdout.trim().split("\n")
  const final = json_parse(lines[len(lines) - 1])
  __io_println(final.data.event_type)
  __io_println(final.data.value.status)
  __io_println(contains(final.data.value.result.summary, "Mock response"))
  __io_println(final.data.value.has_transcript)
}
