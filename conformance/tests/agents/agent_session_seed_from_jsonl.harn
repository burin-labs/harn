import { llm_text, with_llm_script } from "std/testing"

pipeline main() {
  let path = path_join(harness.fs.temp_dir(), "harn-seed-" + uuid() + ".jsonl")
  harness.fs
    .write_text(
    path,
    join(
      [
        json_stringify({type: "system_prompt", content: "seed system"}),
        json_stringify(
          {type: "provider_call_request", provider: "mock", model: "mock", tool_format: "native"},
        ),
        json_stringify({type: "message", message: {role: "user", content: "hello"}}),
        json_stringify(
          {
            type: "message",
            message: {
              role: "assistant",
              content: "checking",
              tool_calls: [{id: "call_1", name: "lookup", arguments: {query: "state"}}],
            },
          },
        ),
        json_stringify(
          {
            type: "message",
            message: {role: "tool", name: "lookup", tool_call_id: "call_1", content: "state=ok"},
          },
        ),
        json_stringify({type: "message", message: {role: "assistant", content: "done"}}),
      ],
      "\n",
    )
      + "\n",
  )
  let seeded = agent_session_seed_from_jsonl(
    path,
    {
      rename_session: "seeded-" + uuid(),
      drop_tool_calls: true,
      truncate_to_last: 3,
      provider: "mock",
      model: "mock",
      source_agent: "codex",
      source_session_id: "codex-session-1",
      source_label: "Codex import",
      source_provenance: {workspace: "harn"},
      recommend_compaction: true,
    },
  )
  __io_println(seeded.ok)
  __io_println(seeded.turns_loaded)
  __io_println(seeded.source_format)
  __io_println(seeded.partial)
  __io_println(seeded.source.kind)
  __io_println(seeded.source.agent)
  __io_println(seeded.source.session_id)
  __io_println(seeded.recommend_compaction)
  let snap = agent_session_snapshot(seeded.session_id)
  let seeded_meta = snap.metadata.seeded_from_jsonl
  __io_println(seeded_meta.source.label)
  __io_println(seeded_meta.source.provenance.workspace)
  __io_println(seeded_meta.recommend_compaction)
  __io_println(agent_session_system_prompt(seeded.session_id) != nil)
  __io_println(agent_session_tool_format(seeded.session_id))
  __io_println(len(snap.messages))
  __io_println(snap.messages[0].role)
  __io_println(snap.messages[1].content)
  __io_println(snap.messages[1].tool_calls == nil)
  let legacy_path = path_join(harness.fs.temp_dir(), "harn-legacy-seed-" + uuid() + ".jsonl")
  harness.fs
    .write_text(
    legacy_path,
    join(
      [
        json_stringify(
          {
            type: "request",
            system: "legacy system",
            provider: "mock",
            model: "mock",
            tool_format: "text",
            messages: [{role: "user", content: "legacy hello"}],
          },
        ),
        json_stringify({type: "response", provider: "mock", model: "mock", text: "legacy done"}),
      ],
      "\n",
    )
      + "\n",
  )
  let legacy = agent_session_seed_from_jsonl(legacy_path)
  let legacy_snap = agent_session_snapshot(legacy.session_id)
  __io_println(legacy.ok)
  __io_println(legacy.source_format)
  __io_println(len(legacy_snap.messages))
  __io_println(legacy_snap.messages[1].content)
  with_llm_script(
    [llm_text("recorded assistant")],
    { ->
      let transcript_dir = path_join(harness.fs.temp_dir(), "harn-seed-sidecar-" + uuid())
      let source_session = agent_session_open()
      agent_loop(
        "record this",
        nil,
        {
          provider: "mock",
          session_id: source_session,
          max_iterations: 1,
          llm_transcript_dir: transcript_dir,
        },
      )
      let sidecar = path_join(transcript_dir, "llm_transcript.jsonl")
      __io_println(contains(harness.fs.read_text(sidecar), "\"type\":\"message\""))
      let imported = agent_session_seed_from_jsonl(sidecar, {provider: "mock"})
      __io_println(imported.ok)
      __io_println(imported.source_format)
      __io_println(imported.turns_loaded >= 2)
    },
  )
}
