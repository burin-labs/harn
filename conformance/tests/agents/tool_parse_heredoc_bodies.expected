# go table test body with backticks then run
  calls=2 errors=0 violations=0 stray=2
  call edit {"action":"create","content":"package manifest\n\nimport (\n\t\"testing\"\n)\n\nfunc TestParseManifest(t *testing.T) {\n\ttests := []struct {\n\t\tname    string\n\t\tinput   string\n\t\twant    string\n\t\twantErr bool\n\t}{\n\t\t{\n\t\t\tname:  \"basic\",\n\t\t\tinput: `{\"name\": \"test\"}`,\n\t\t\twant:  \"test\",\n\t\t},\n\t\t{\n\t\t\tname:    \"empty\",\n\t\t\tinput:   ``,\n\t\t\twantErr: true,\n\t\t},\n\t}\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tgot, err := Parse(tt.input)\n\t\t\tif (err != nil) != tt.wantErr {\n\t\t\t\tt.Errorf(\"Parse() error = %v, wantErr %v\", err, tt.wantErr)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif got != tt.want {\n\t\t\t\tt.Errorf(\"Parse() = %v, want %v\", got, tt.want)\n\t\t\t}\n\t\t})\n\t}\n}","path":"internal/manifest/parser_test.go"}
  call run {"command":"go test ./internal/manifest/ -v"}
  prose="I'll create the test file with table-driven tests.\n\nNow let me run the tests."
