import { llm_text, with_llm_script } from "std/testing"

/**
 * S-11 (#1847): nested suspend/resume. Two independent background
 * workers each self-park at turn 1 and can be resumed independently.
 *
 * Asserts that:
 *   - The worker registry tracks two simultaneously-suspended workers
 *     with distinct ids and distinct snapshot paths.
 *   - Resuming worker A does not affect worker B's suspension state.
 *   - Each worker resumes from its own snapshot to completion.
 *
 * Workers are spawned serially so the FIFO `llm_mock` queue stays
 * deterministic. The two suspended workers coexist between the second
 * `wait_agent` and the first `resume_agent`.
 */
pipeline main(harness: Harness) {
  // Stage worker A: park, then complete.
  with_llm_script(
    harness.llm, [
      {
        tool_calls: [
          {id: "park_a", name: "agent_await_resumption", arguments: {reason: "worker A parks"}},
        ],
      },
      {
        tool_calls: [
          {id: "park_b", name: "agent_await_resumption", arguments: {reason: "worker B parks"}},
        ],
      },
      llm_text("worker A completed"),
      llm_text("worker B completed"),
    ],
    { ->
      const handle_a = sub_agent_run(harness, "Worker A: park until resumed.",
        {provider: "mock", background: true, tool_format: "native", max_iterations: 3},
      )
      const suspended_a = wait_agent(handle_a)
      const handle_b = sub_agent_run(harness, "Worker B: park until resumed.",
        {provider: "mock", background: true, tool_format: "native", max_iterations: 3},
      )
      const suspended_b = wait_agent(handle_b)
      harness.stdio.println("a_suspended=" + suspended_a.status)
      harness.stdio.println("b_suspended=" + suspended_b.status)
      harness.stdio.println("distinct_ids=" + to_string(suspended_a.id != suspended_b.id))
      harness.stdio.println(
        "distinct_snapshots=" + to_string(suspended_a.snapshot_path != suspended_b.snapshot_path),
      )
      const _resumed_a = resume_agent(handle_a)
      const done_a = wait_agent(handle_a)
      const still_b = wait_agent(handle_b)
      harness.stdio.println("a_after_resume=" + done_a.status)
      harness.stdio.println("b_still_suspended=" + still_b.status)
      const _resumed_b = resume_agent(handle_b)
      const done_b = wait_agent(handle_b)
      harness.stdio.println("b_after_resume=" + done_b.status)
      harness.stdio.println("a_unchanged=" + done_a.status)
    },
  )
}
