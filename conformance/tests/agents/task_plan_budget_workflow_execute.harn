import { task_plan_compile } from "std/agent/task_plan"
import { with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {
        text: "still working",
        provider: "openai",
        model: "gpt-4o-mini",
        input_tokens: 100000,
        output_tokens: 100000,
      },
    ],
    { ->
      const plan = {
        schema_version: "1",
        objective: "Budgeted workflow",
        entry: "work",
        nodes: {
          work: {
            kind: "agent_loop",
            purpose: "Run budgeted loop",
            prompt: "Spend one modeled call",
            model: {provider: "mock", model: "gpt-4o-mini"},
            agent_loop: {done_sentinel: "DONE"},
          },
        },
        budgets: {total_cost_usd: 0.000001},
      }
      const compiled = task_plan_compile(plan)
      const result = workflow_execute(harness, "Budgeted workflow", compiled.workflow, [], {max_steps: 1})
      const stage = result.run.stages[0]
      harness.stdio.println(result.status)
      harness.stdio.println(stage.status)
      harness.stdio.println(stage.outcome)
      harness.stdio.println(stage.branch)
      harness.stdio.println(stage.metadata.model_policy.iteration_budget.total_cost_usd == 0.000001)
    },
  )
}
