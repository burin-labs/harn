import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

/**
 * `require_successful_tools` is an active gate: when a required tool
 * never succeeds the agent_loop result carries a structured
 * `error_envelope` (consumable by cloud receipts) AND emits a
 * `tool_gap` friction event onto the friction sink so context-pack
 * suggestions and dashboards pick it up alongside natively-emitted
 * events.
 */
fn tools() {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "lookup",
    "Lookup evidence",
    {
      handler: { _args -> "evidence" },
      parameters: {query: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return registry
}

pipeline main(harness: Harness) {
  harness.obs.friction_clear()
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "lookup_1", name: "lookup", arguments: {query: "x"}}]},
      llm_text("Finished."),
    ],
    { ->
      const failed = agent_loop(harness, "Use one tool.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          require_successful_tools: ["missing_tool"],
          persona: "test_persona",
          _preset_kind: "test",
        },
      )
      harness.stdio.println(failed.status)
      harness.stdio.println(failed.stop_reason)
      harness.stdio.println(failed.missing_required_tools[0])
      harness.stdio.println(failed.error_envelope.schema_version)
      harness.stdio.println(failed.error_envelope.kind)
      harness.stdio.println(failed.error_envelope.missing[0])
      harness.stdio.println(contains(failed.error_envelope.successful_tool_names, "lookup"))
      const events = harness.obs.friction_events()
      harness.stdio.println(len(events))
      harness.stdio.println(events[0].kind)
      harness.stdio.println(events[0].source)
      harness.stdio.println(events[0].actor)
      harness.stdio.println(events[0].metadata.preset_kind)
      harness.stdio.println(contains(events[0].metadata.successful_tool_names, "lookup"))
      harness.stdio.println(events[0].metadata.missing_required_tools[0])
      harness.obs.friction_clear()
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "lookup_2", name: "lookup", arguments: {query: "y"}}]},
      llm_text("<user_response>Done.</user_response>"),
    ],
    { ->
      const satisfied = agent_loop(harness, "Use one tool.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          require_successful_tools: ["lookup"],
        },
      )
      harness.stdio.println(satisfied.status)
      harness.stdio.println(satisfied?.error_envelope == nil)
      harness.stdio.println(len(harness.obs.friction_events()))
    },
  )
}
// Structured error envelope shape.
// Friction event was recorded with kind=tool_gap and persona actor.
// No friction event when require_successful_tools is satisfied.
