import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

/**
 * Evidence-aware repair loop (#repair-diagnostics): proposed edit+retest
 * thrash. Each edit+test proposal crosses an effect boundary, so the edit runs
 * first and the model re-proposes the test after observing the edit result. The
 * test keeps failing with the SAME signature. This fixture protects the phase
 * boundary from being mistaken for the legacy same-dispatch edit+retest shape:
 * deferred synthetic results must not create a duplicate repair-stall warning.
 */
fn events_of(events: any, kind: string) {
  return events.filter({ event -> event.type == kind })
}

fn repair_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "run_test",
    "Run the test suite",
    {
      handler: { _args ->
        throw "AssertionError: expected 5 got 4"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "verify"},
    },
  )
  tools = tool_define(
    tools,
    "apply_fix",
    "Apply a corrective edit",
    {
      handler: { _args -> "edit applied" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  return tools
}

/**
 * Propose an edit followed by a dependent test. The dispatcher runs the edit
 * and defers the test until the next inference.
 */
fn fix_and_test(edit_id: string, test_id: string) {
  return {
    text: "",
    tool_calls: [
      {id: edit_id, name: "apply_fix", arguments: {}},
      {id: test_id, name: "run_test", arguments: {}},
    ],
  }
}

fn test_again(test_id: string) {
  return {text: "", tool_calls: [{id: test_id, name: "run_test", arguments: {}}]}
}

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      fix_and_test("e1", "t1"),
      test_again("t1-reproposed"),
      fix_and_test("e2", "t2"),
      test_again("t2-reproposed"),
      fix_and_test("e3", "t3"),
      test_again("t3-reproposed"),
      llm_text("Giving up. ##DONE##"),
    ],
    { ->
      const session = "repair-same-turn-thrash-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Make the failing test pass.",
          nil,
          {
            provider: "mock",
            tools: repair_tools(),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 10,
            session_id: session,
            done_sentinel: "##DONE##",
            stall_diagnostics: {
              enabled: true,
              repair_aware: true,
              stuck_same_diagnostic_after: 2,
              inject_feedback: true,
              max_feedback: 1,
            },
          },
        ) },
      )
      const stalls = events_of(captured.events, "agent_loop_stall_warning")
      const repair_stalls = stalls.filter({ s -> s.warning.pattern == "stuck_same_diagnostic" })
      const deferred = events_of(captured.events, "tool_batch_disposition").filter(
        { event -> event.receipt.disposition == "deferred" },
      )
      harness.stdio.println(len(repair_stalls))
      harness.stdio.println(len(deferred))
    },
  )
}
