import {
  agent_session_finalize,
  agent_session_init,
  agent_session_inject_feedback,
} from "std/agent/state"

pipeline main(harness: Harness, task) {
  const public_session = harness.agent.open("prefill-feedback-public")
  harness.agent.inject_feedback(public_session, "prefill_assistant", "<done>##DONE##</done>")
  const public_messages = harness.agent.snapshot(public_session).messages
  harness.stdio.println(public_messages[0].role)
  harness.stdio.println(!contains(public_messages[0].content, "runtime_feedback"))
  const control = agent_session_init(
    harness.agent,
    "task",
    nil,
    {provider: "mock", session_id: "prefill-feedback-host"},
  )
  agent_session_inject_feedback(
    harness.agent,
    control.session_id,
    "prefill_assistant",
    "<done>##DONE##</done>",
  )
  const host_messages = harness.agent.snapshot(control.session_id).messages
  harness.stdio.println(host_messages[1].role)
  harness.stdio.println(!contains(host_messages[1].content, "runtime_feedback"))
  agent_session_finalize(
    harness.agent,
    control.session_id,
    {final_status: "done", stop_reason: "test", iterations: 0},
  )
}
