import { agent_command_tools } from "std/agent/host_tools"
import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

// The pre-approval precheck through a REAL `agent_loop`, not just dispatch.
//
// The loop forwards policy options to dispatch from an explicit allowlist. A
// precheck the list omits is accepted by `agent_loop` and never consulted, so
// the embedder's refusal silently becomes a command that runs.
//
// The pair is the proof. Same script, same tool: without a precheck the
// command runs and its output reaches the second turn; with one that denies,
// the output is absent and the model sees the precheck's cue instead.
fn probe_tools(harness: Harness, root: string) {
  return agent_command_tools(
    harness,
    nil,
    {root: root, cwd: root, allow_argv_prefixes: [["sh", "-c"]]},
  )
}

fn probe_script() -> list {
  return [
    {
      text: "",
      tool_calls: [
        {
          id: "run1",
          name: "run_command",
          // The output (42) is absent from the argv, so it can only reach the
          // second turn if the command actually ran.
          arguments: {argv: ["sh", "-c", "expr 6 + 36"]},
        },
      ],
    },
    llm_text("Saw the command result."),
  ]
}

fn run_probe(harness: Harness, root: string, extra: dict) -> string {
  let second_turn = ""
  with_llm_script(
    harness.llm,
    probe_script(),
    { ->
      agent_loop(
        harness,
        "Run the command and report back.",
        nil,
        {
          provider: "mock",
          tools: probe_tools(harness, root),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
        }
          + extra,
      )
      second_turn = json_stringify(harness.llm.mock_calls()[1].messages)
    },
  )
  return second_turn
}

pipeline main(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-tool-precheck-loop-" + harness.random.uuid(),
  )
  harness.fs.mkdir(root, true)
  // CONTROL: no precheck. The command must run, or the denial below proves
  // nothing.
  const control = run_probe(harness, root, {})
  harness.stdio.println("control_output_present=" + to_string(contains(control, "42")))
  // A precheck that allows everything leaves the call on its normal path.
  const allowed = run_probe(harness, root, {tool_precheck: { _call -> nil }})
  harness.stdio.println("allowed_output_present=" + to_string(contains(allowed, "42")))
  // A precheck that denies the tool: the command never runs, and the cue the
  // precheck wrote is what the model reads.
  const denied = run_probe(
    harness,
    root,
    {
      tool_precheck: { call ->
        if call?.tool == "run_command" {
          return {deny: true, model_cue: "precheck refused this command"}
        }
        return nil
      },
    },
  )
  harness.stdio.println("denied_output_absent=" + to_string(!contains(denied, "42")))
  harness.stdio.println(
    "denied_cue_present=" + to_string(contains(denied, "precheck refused this command")),
  )
}
