import { agent_host_tools } from "std/agent/host_tools"
import { agent_dispatch_tool_call } from "std/agent/primitives"

type ReadContent = {content: string}

type CommandIdentity = {command_id: string}

fn read_content(result: any) -> string {
  const parsed = schema_expect(json_parse(result.rendered_result), schema_of(ReadContent))
  return parsed.content
}

pipeline main(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "host-read-budget-" + harness.random.uuid(),
  )
  harness.fs.mkdir(root, true)
  harness.fs.write_text(path_join(root, "large.txt"), "abcdefghijklmnopqrstuvwxyz")
  const tools = agent_host_tools(
    harness,
    nil,
    {
      root: root,
      cwd: root,
      read_bytes: 4,
      tail_bytes: 3,
      max_inline_bytes: 4,
      allow_argv_prefixes: [["sh", "-c"]],
    },
  )
  const default_read = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_file", arguments: {path: "large.txt"}},
    tools,
  )
  assert(read_content(default_read) == "abcd")
  const oversized_read = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_file", arguments: {path: "large.txt", limit_bytes: 100}},
    tools,
  )
  assert(read_content(oversized_read) == "abcd")
  const next_page = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_file", arguments: {path: "large.txt", offset: 4}},
    tools,
  )
  assert(read_content(next_page) == "efgh")
  const default_tail = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_file_tail", arguments: {path: "large.txt"}},
    tools,
  )
  assert(read_content(default_tail) == "xyz")
  const oversized_tail = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_file_tail", arguments: {path: "large.txt", length: 100}},
    tools,
  )
  assert(read_content(oversized_tail) == "xyz")
  const command = agent_dispatch_tool_call(
    harness.tools,
    {name: "run_command", arguments: {argv: ["sh", "-c", "printf abcdefghijklmnopqrstuvwxyz"]}},
    tools,
  )
  assert(command.ok)
  const command_result = schema_expect(
    json_parse(command.rendered_result),
    schema_of(CommandIdentity),
  )
  const command_id = command_result.command_id
  const command_read = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_command_output", arguments: {command_id: command_id, length: 100}},
    tools,
  )
  assert(read_content(command_read) == "abcd")
  const command_tail = agent_dispatch_tool_call(
    harness.tools,
    {name: "read_command_output_tail", arguments: {command_id: command_id, length: 100}},
    tools,
  )
  assert(read_content(command_tail) == "xyz")
  harness.stdio.println("ok")
}
