/**
 * P2-3 (#3682): a suspended agent snapshot can move through the portable
 * session-bundle path and resume from a fresh local root.
 *
 * This covers the operator handoff path:
 *   1. create a real suspended agent snapshot with `agent_loop`;
 *   2. embed that snapshot in a local session bundle;
 *   3. import the bundle into a different directory, materializing a fresh
 *      destination-local worker snapshot;
 *   4. resume through the canonical `harn run --resume <snapshot>` surface.
 */
import "../_common"

fn first_snapshot_line(text) {
  let matches = regex_captures("snapshot=(.+)", text)
  if len(matches) == 0 {
    return nil
  }
  return matches[0].groups[0]
}

fn final_json_line(result) {
  let lines = result.stdout.trim().split("\n")
  return json_parse(lines[len(lines) - 1])
}

fn resume_signature(final) {
  return {
    event_type: to_string(final.data.event_type),
    status: to_string(final.data.value.status),
    has_transcript: final.data.value.has_transcript,
    summary: to_string(final.data.value.result.summary ?? ""),
  }
}

pipeline main() {
  let repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  let harn_bin = harness.env.get_or("HARN_CONFORMANCE_HARN_BIN", resolve_harn_bin(harness, repo_root))
  let root = path_join(harness.fs.temp_dir(), "harn-session-bundle-resume-" + uuid_v7())
  let source_root = path_join(root, "source")
  let dest_root = path_join(root, "dest")
  harness.fs.mkdir(source_root)
  harness.fs.mkdir(dest_root)
  let script = path_join(source_root, "bundle_suspend.harn")
  harness.fs
    .write_text(
    script,
    """
pipeline main() {
  llm_mock({tool_calls: [{id: "park_bundle", name: "agent_await_resumption", arguments: {reason: "bundle migration park"}}]})
  let result = agent_loop("Park so a session bundle can carry this run.", nil, {provider: "mock", tool_format: "native", max_iterations: 2, session_id: "bundle-resume-" + uuid_v7()})
  __io_println("status=" + result.status)
  __io_println("snapshot=" + result.handle.snapshot_path)
}
""",
  )
  let first = exec_at(source_root, harn_bin, "run", script)
  __io_println("first_ok=" + to_string(first.success))
  __io_println("first_suspended=" + to_string(contains(first.stdout, "status=suspended")))
  let snapshot = first_snapshot_line(first.stdout)
  require snapshot != nil, "session bundle suspend did not print a snapshot path"
  let snapshot_path = if path_is_absolute(snapshot) {
    snapshot
  } else {
    path_join(source_root, snapshot)
  }
  __io_println("source_snapshot_exists=" + to_string(harness.fs.exists(snapshot_path)))
  let snapshot_value = json_parse(harness.fs.read_text(snapshot_path))
  let bundle_path = path_join(source_root, "source.bundle.json")
  let exported = exec_at(source_root, harn_bin, "session", "checkpoint", snapshot_path, "--out", bundle_path)
  __io_println("export_ok=" + to_string(exported.success))
  let validated = exec_at(source_root, harn_bin, "session", "validate", bundle_path, "--json")
  __io_println("validate_ok=" + to_string(validated.success))
  let imported_run_path = path_join(dest_root, "imported-run.json")
  let imported_snapshot_dir = path_join(dest_root, "worker-snapshots")
  let imported = exec_at(
    dest_root,
    harn_bin,
    "session",
    "import",
    bundle_path,
    "--out",
    imported_run_path,
    "--worker-snapshot-dir",
    imported_snapshot_dir,
    "--json",
  )
  __io_println("import_ok=" + to_string(imported.success))
  let import_report = json_parse(imported.stdout)
  let imported_snapshot = import_report.worker_snapshots[0].path
  __io_println("worker_snapshot_count=" + to_string(import_report.worker_snapshot_count))
  __io_println("imported_snapshot_exists=" + to_string(harness.fs.exists(imported_snapshot)))
  __io_println("snapshot_rewritten=" + to_string(imported_snapshot != snapshot_path))
  let imported_snapshot_value = json_parse(harness.fs.read_text(imported_snapshot))
  __io_println(
    "snapshot_self_ref_rewritten="
      + to_string(imported_snapshot_value.snapshot_path == imported_snapshot),
  )
  __io_println(
    "suspension_ref_rewritten="
      + to_string(imported_snapshot_value.suspension?.snapshot_ref == imported_snapshot),
  )
  __io_println(
    "transcript_prefix_preserved="
      + to_string(
      json_stringify(imported_snapshot_value.transcript?.messages ?? [])
        == json_stringify(snapshot_value.transcript?.messages ?? []),
    ),
  )
  __io_println(
    "resume_command_points_to_snapshot="
      + to_string(import_report.worker_snapshots[0].resume_command[3] == imported_snapshot),
  )
  let imported_run = json_parse(harness.fs.read_text(imported_run_path))
  __io_println(
    "imported_run_metadata_rewritten="
      + to_string(imported_run.metadata.worker_snapshot_path == imported_snapshot),
  )
  let source_resumed = exec_at(source_root, harn_bin, "run", "--resume", snapshot_path, "--json")
  __io_println("source_resume_ok=" + to_string(source_resumed.success))
  let source_final = final_json_line(source_resumed)
  let source_signature = resume_signature(source_final)
  harness.fs.delete(source_root)
  __io_println("source_host_removed=" + to_string(!harness.fs.exists(source_root)))
  let resumed = exec_at(dest_root, harn_bin, "run", "--resume", imported_snapshot, "--json")
  __io_println("resume_ok=" + to_string(resumed.success))
  let final = final_json_line(resumed)
  let imported_signature = resume_signature(final)
  __io_println(
    "resume_signature_matches_source="
      + to_string(json_stringify(imported_signature) == json_stringify(source_signature)),
  )
  __io_println("event_type=" + to_string(final.data.event_type))
  __io_println("resumed_status=" + to_string(final.data.value.status))
  __io_println("has_transcript=" + to_string(final.data.value.has_transcript))
  __io_println(
    "summary_contains_mock=" + to_string(contains(final.data.value.result.summary, "Mock response")),
  )
}
