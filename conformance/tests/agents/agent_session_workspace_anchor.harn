pipeline main(harness: Harness, task: unknown) {
  const session = harness.agent.open(
    "anchor-conformance",
    {workspace_anchor: {primary: "/workspace/main", anchored_at: "2026-05-23T00:00:00Z"}},
  )
  const opened = harness.agent.workspace_anchor(session)
  assert(opened?.primary == "/workspace/main", "open pins the typed anchor")
  assert(opened?.anchored_at == "2026-05-23T00:00:00Z", "open preserves the anchored_at")
  assert(len(opened?.additional_roots) == 0, "additional_roots starts empty")
  const default_policy = harness.agent.workspace_policy(session)
  assert(
    default_policy.default_mount_mode == "read_only",
    "workspace policy defaults mounted roots to read_only",
  )
  const snap = harness.agent.snapshot(session)
  assert(
    snap.workspace_anchor?.primary == "/workspace/main",
    "snapshot surfaces the workspace anchor",
  )
  assert(
    snap.workspace_policy.default_mount_mode == "read_only",
    "snapshot surfaces the workspace policy",
  )
  const policy_changed = harness.agent.set_workspace_policy(session, {default_mount_mode: "extend"})
  assert(policy_changed, "workspace policy setter reports change")
  const updated_policy = harness.agent.workspace_policy(session)
  assert(
    updated_policy.default_mount_mode == "extend",
    "workspace policy setter updates default mount mode",
  )
  const changed = harness.agent.set_workspace_anchor(
    session,
    {
      primary: "/workspace/lib",
      additional_roots: [{path: "/workspace/extras", mounted_at: "2026-05-23T00:00:01Z"}],
      anchored_at: "2026-05-23T00:00:02Z",
    },
  )
  assert(changed, "setter reports change when value differs")
  const mutated = harness.agent.workspace_anchor(session)
  assert(mutated?.primary == "/workspace/lib", "setter replaces primary")
  assert(len(mutated?.additional_roots) == 1, "setter populates additional_roots")
  assert(mutated?.additional_roots[0]?.mount_mode == "extend", "setter preserves mount_mode")
  const same = harness.agent.set_workspace_anchor(
    session,
    {
      primary: "/workspace/lib",
      additional_roots: [{path: "/workspace/extras", mounted_at: "2026-05-23T00:00:01Z"}],
      anchored_at: "2026-05-23T00:00:02Z",
    },
  )
  assert(!same, "setter reports unchanged when value matches")
  const cleared = harness.agent.set_workspace_anchor(session, nil)
  assert(cleared, "clearing reports change")
  assert(harness.agent.workspace_anchor(session) == nil, "clearing returns nil")
  harness.stdio.log("agent_session_workspace_anchor tests passed")
}
