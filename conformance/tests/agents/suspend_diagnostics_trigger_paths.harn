import {
  __agent_await_resumption_from_tool,
  __parse_resume_conditions_unchecked,
  agent_lifecycle_tools,
  resume_agent,
} from "std/agent/workers"

fn has_code(result: any, code: string) {
  return is_err(result) && contains(to_string(unwrap_err(result)), code)
}

pipeline main(harness: Harness) {
  const invalid_trigger: any = {trigger: "not-a-trigger"}
  const bad_trigger_shape = try {
    __parse_resume_conditions_unchecked(harness.agent, invalid_trigger)
  }
  harness.stdio.println(has_code(bad_trigger_shape, "HARN-SUS-002"))
  const invalid_timeout: any = {timeout: {duration_minutes: 1, on_timeout: "explode"}}
  const bad_timeout_action = try {
    __agent_await_resumption_from_tool(
      harness.agent,
      {reason: "waiting on review", conditions: invalid_timeout},
    )
  }
  harness.stdio.println(has_code(bad_timeout_action, "HARN-SUS-002"))
  const lifecycle = agent_lifecycle_tools(harness.agent, tool_registry())
  const await_tool = tool_find(lifecycle, "agent_await_resumption")
  const direct_tool_call = try {
    await_tool.handler({reason: "outside agent loop"})
  }
  harness.stdio.println(has_code(direct_tool_call, "HARN-SUS-005"))
  const missing_snapshot = try {
    resume_agent(harness.agent, "/tmp/harn-suspend-diagnostics-missing-worker.json")
  }
  harness.stdio.println(has_code(missing_snapshot, "HARN-SUS-004"))
}
