// The verbatim content lane: heredoc bodies trailing a ```tool block.
//
// JSON-escaping a large file body is where the fenced lane used to lose data —
// a doubled backslash transform mangled a 900-line payload on the way through,
// and a model that hand-escapes ~10KB loses the whole call to one unbalanced
// brace. The fix is to let an argument value be a heredoc opener, with the real
// bytes following the JSON header.
//
// Two openers, matching the text dialect's grammar:
//
//   `<<TAG`   closes on the first following line that is exactly TAG. The
//             everyday form: it asks for a delimiter the model already wrote,
//             not for an arithmetic fact about text it is still emitting.
//   `<<TAG:N` closes after exactly N body lines. Required only when the body
//             itself contains a line that is exactly TAG, where the terminator
//             alone would be ambiguous. The count, not the tag, is then
//             authoritative.
//
// Under either opener the body carries a ```tool separator, `<<EOF`,
// `</tool_calls>`, a bare `}`, or backticks and still round-trips: the chunker
// holds the fence open for the whole declared body.
//
// Everything ambiguous fails loud with zero calls: a wrong count, a declared
// body that never arrives, a body whose tag does not match its declaration, two
// declarations sharing one body, a counted close with trailing bytes on the tag
// line, a count that overflows, and a trailing body no argument asked for.
// Half-applying a file edit is worse than any of them.
import { probe_json } from "_tool_parse_probe"

pipeline main(harness: Harness) {
  // A body containing a line that is exactly the close tag. The count wins.
  probe_json(
    harness.agent,
    harness.stdio,
    "body containing the tag line round trips",
    """```tool
{ "name": "write_file", "args": { "path": "a.txt", "content": "<<END:5" } }
<<END:5
before
END
middle
END
after
END
```""",
  )
  // Every literal the fenced lane promises to carry: a bare fence, a heredoc
  // opener, a lone brace, both envelope close tags, and backticks.
  probe_json(
    harness.agent,
    harness.stdio,
    "body with all promised literals round trips",
    """```tool
{ "name": "write_file", "args": { "path": "b.txt", "content": "<<T:8" } }
<<T:8
```
<<EOF
}
</tool>
</tool_calls>
const raw = `go run`;
```
EOF
T
```""",
  )
  // An empty body is a valid segment.
  probe_json(
    harness.agent,
    harness.stdio,
    "empty counted body",
    """```tool
{ "name": "write_file", "args": { "path": "empty.txt", "content": "<<T:0" } }
<<T:0
T
```""",
  )
  // A ```tool separator inside a counted body is content, not a block split.
  probe_json(
    harness.agent,
    harness.stdio,
    "tool fence inside a counted body is content",
    """```tool
{ "name": "write_file", "args": { "path": "d.txt", "content": "<<T:3" } }
<<T:3
line a
```tool
line c
T
```""",
  )
  // Two verbatim arguments in one call bind by their opener string, so the
  // trailing bodies may appear in any order relative to the JSON keys.
  probe_json(
    harness.agent,
    harness.stdio,
    "two bodies matched by opener",
    """```tool
{ "name": "edit_file", "args": { "path": "x.rs", "old_string": "<<OLD:1", "new_string": "<<NEW:2" } }
<<NEW:2
NEW a\b
NEW c
NEW
<<OLD:1
OLD "q"
OLD
```""",
  )
  // Verbatim coexists with batching: a plain read object and a verbatim write
  // object in one block both dispatch, and the body binds only the write.
  probe_json(
    harness.agent,
    harness.stdio,
    "verbatim coexists with a batched object",
    """```tool
{ "name": "read_file", "args": { "path": "a.zig" } }
{ "name": "write_file", "args": { "path": "b.zig", "content": "<<C:1" } }
<<C:1
const x = "a\tb";
C
```""",
  )
  // A CRLF body keeps every carriage return, and a CRLF close line works.
  probe_json(
    harness.agent,
    harness.stdio,
    "crlf counted close round trips",
    "```tool\r\n{\"name\":\"write_file\",\"args\":{\"content\":\"<<C:1\"}}\r\n<<C:1\r\nbody\r\n  C\r\n```",
  )
  // BEHAVIOR CHANGE: `<<TAG` is now an opener in the fenced lane, so a value
  // that is exactly an opener with no body is a missing body, not a literal
  // string. Failing loud is the only safe reading: binding it as a literal
  // would write the text `<<EOF` into the file the model meant to fill.
  probe_json(
    harness.agent,
    harness.stdio,
    "bare opener value with no body fails loud",
    """```tool
{"name": "write_file", "args": {"path": "a", "content": "<<EOF"}}
```""",
  )
  // The everyday form: no count, closed by its own tag line.
  probe_json(
    harness.agent,
    harness.stdio,
    "uncounted body round trips",
    """```tool
{ "name": "write_file", "args": { "path": "a.go", "content": "<<BODY" } }
<<BODY
package main

func main() {}
BODY
```""",
  )
  // The fence-immunity promise holds without a count: the chunker keeps the
  // ```tool block open until the tag line, so fenced content survives.
  probe_json(
    harness.agent,
    harness.stdio,
    "uncounted body carrying fences and openers",
    """```tool
{ "name": "write_file", "args": { "path": "README.md", "content": "<<BODY" } }
<<BODY
```sh
echo hi
```
<<EOF
}
</tool_calls>
BODY
```""",
  )
  // An empty uncounted body is a valid segment.
  probe_json(
    harness.agent,
    harness.stdio,
    "empty uncounted body",
    """```tool
{ "name": "write_file", "args": { "path": "empty.txt", "content": "<<BODY" } }
<<BODY
BODY
```""",
  )
  // Mixed openers in one call: each binds by its own opener string, and each
  // carries its own newline contract. `<<OLD` yields "before" because the
  // newline before the tag is the delimiter, matching the text dialect's
  // heredoc; `<<NEW:3` yields "after\nNEW\ntail\n" because the count makes each
  // of the three lines content, terminator included. The difference is the
  // openers, not an inconsistency to normalize away.
  probe_json(
    harness.agent,
    harness.stdio,
    "uncounted and counted bodies in one call",
    """```tool
{ "name": "edit_file", "args": { "old_string": "<<OLD", "new_string": "<<NEW:3" } }
<<OLD
before
OLD
<<NEW:3
after
NEW
tail
NEW
```""",
  )
  // TERMINATOR COLLISION — the load-bearing safety property of the uncounted
  // form. An uncounted body closes on the first line that is exactly its tag,
  // so a body CONTAINING that line closes early. The only acceptable outcomes
  // are a loud failure or a correct full bind; a SILENT TRUNCATION that still
  // dispatches would write a half file and report nothing, which is strictly
  // worse than the escaping failure this whole lane exists to remove.
  //
  // The reason it cannot be silent is structural rather than incidental: an
  // early close does not consume the rest of the body, so the leftovers stay in
  // the trailing region, and every trailing block must match a declared opener.
  // Body text does not, so the call is rejected. Keep these cases if the binder
  // is ever refactored — they are what stops (a) from quietly becoming (c).
  probe_json(
    harness.agent,
    harness.stdio,
    "collision mid-body fails loud",
    """```tool
{ "name": "write_file", "args": { "path": "a.txt", "content": "<<C" } }
<<C
before
C
after
C
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "collision as the last content line fails loud",
    """```tool
{ "name": "write_file", "args": { "path": "a.txt", "content": "<<C" } }
<<C
before
C
C
```""",
  )
  // The mis-bind case: with a second declaration present, the residual after an
  // early close must NOT bind to the other argument and dispatch two wrong
  // bodies.
  probe_json(
    harness.agent,
    harness.stdio,
    "collision cannot mis-bind a second verbatim argument",
    """```tool
{ "name": "edit_file", "args": { "old_string": "<<C", "new_string": "<<D" } }
<<C
before
C
after
C
<<D
replacement
D
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "collision with a blank residual fails loud",
    """```tool
{ "name": "write_file", "args": { "path": "a.txt", "content": "<<C" } }
<<C
before
C

C
```""",
  )
  // NEGATIVE PIN for the four cases above: the SAME colliding body is legal
  // under the counted opener and still binds in full, so the uncounted
  // production did not take the counted form's turn.
  probe_json(
    harness.agent,
    harness.stdio,
    "counted opener still binds the same colliding body",
    """```tool
{ "name": "write_file", "args": { "path": "a.txt", "content": "<<C:3" } }
<<C:3
before
C
after
C
```""",
  )
  // A body that never closes is a parse error, never a recovery point.
  probe_json(
    harness.agent,
    harness.stdio,
    "uncounted body that never closes fails loud",
    """```tool
{ "name": "write_file", "args": { "path": "a", "content": "<<BODY" } }
<<BODY
line one
line two
```""",
  )
  // A pure-JSON block is untouched by the verbatim lane.
  probe_json(
    harness.agent,
    harness.stdio,
    "pure json block is unchanged",
    """```tool
{"name": "write_file", "args": {"path": "a", "content": "x\ny"}}
```""",
  )
  // The rejections.
  probe_json(
    harness.agent,
    harness.stdio,
    "wrong declared count fails loud",
    """```tool
{ "name": "write_file", "args": { "path": "a", "content": "<<C:5" } }
<<C:5
l1
l2
C
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "count overflow never downgrades",
    """```tool
{ "name": "write_file", "args": { "content": "<<C:184467440737095516160" } }
<<C:184467440737095516160
body
C
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "counted close with a trailing suffix",
    """```tool
{ "name": "write_file", "args": { "content": "<<C:1" } }
<<C:1
body
C trailing payload
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "counted declaration with no body",
    """```tool
{"name":"write_file","args":{"content":"<<C:1"}}
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "counted body with a mismatched tag",
    """```tool
{"name":"write_file","args":{"content":"<<C:1"}}
<<D:1
body
D
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "one of two counted bodies missing",
    """```tool
{"name":"edit_file","args":{"old":"<<OLD:1","new":"<<NEW:1"}}
<<OLD:1
before
OLD
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "duplicate declarations need distinct bodies",
    """```tool
{"name":"edit_file","args":{"old":"<<BODY:1","new":"<<BODY:1"}}
<<BODY:1
only one
BODY
```""",
  )
  probe_json(
    harness.agent,
    harness.stdio,
    "orphan trailing heredoc",
    """```tool
{ "name": "write_file", "args": { "path": "a", "content": "x" } }
<<ORPHAN:1
stray
ORPHAN
```""",
  )
}
