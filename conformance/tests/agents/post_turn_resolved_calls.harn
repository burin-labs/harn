import { agent_loop } from "std/agent/loop"
import { agent_compute_post_turn } from "std/agent/postturn"
import { agent_session_messages } from "std/agent/state"
import {
  agent_transcript_tool_lifecycle_report,
  agent_transcript_turn_lifecycle_report,
} from "std/agent/transcript"
import { with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const tools = tool_define(
    tool_registry(),
    "lookup",
    "Look up evidence",
    {
      annotations: {kind: "read"},
      parameters: {query: {type: "string"}},
      returns: {type: "string"},
      handler: { args -> args.query },
    },
  )
  with_llm_script(
    harness.llm,
    [
      {
        text: "",
        tool_calls: [
          {id: "lookup-1", name: "lookup", arguments: {query: "one"}},
          {id: "lookup-2", name: "lookup", arguments: {query: "two"}},
        ],
      },
    ],
    { ->
      const result = agent_loop(
        harness,
        "Look up two facts.",
        nil,
        {
          provider: "mock",
          tool_format: "native",
          tools: tools,
          max_iterations: 1,
          loop_until_done: true,
          post_turn_callback: { turn ->
            const expected = [{id: "lookup-1", name: "lookup"}, {id: "lookup-2", name: "lookup"}]
            assert_eq(
              turn?.resolved_tool_calls,
              expected,
              "both resolved calls must be present without arguments",
            )
            const lifecycle = agent_transcript_tool_lifecycle_report(
              agent_session_messages(harness.agent, turn.session_id),
            )
            const current = lifecycle.calls.filter({ call -> call.iteration == turn.iteration })
              .to_list()
            assert(lifecycle.ok, "the real dispatched calls must have complete lifecycle evidence")
            assert_eq(len(current), 2)
            assert_eq(current[0]?.tool_call_id, "lookup-1")
            assert_eq(current[1]?.tool_call_id, "lookup-2")
            const reconciled = agent_transcript_turn_lifecycle_report(
              lifecycle,
              turn?.resolved_tool_calls,
              turn.iteration,
            )
            assert_eq(reconciled.status, "complete", "the real turn must reconcile")
            assert_eq(reconciled.expected_count, 2)
            assert_eq(reconciled.observed_count, 2)
            assert_eq(reconciled.assistant_row_count, 1)
            return {stop: true, stop_reason: "captured"}
          },
        },
      )
      assert_eq(result.stop_reason, "captured")
    },
  )
  with_llm_script(
    harness.llm,
    [{text: "done"}],
    { ->
      const result = agent_loop(
        harness,
        "Answer without tools.",
        nil,
        {
          provider: "mock",
          tool_format: "native",
          tools: tools,
          max_iterations: 1,
          post_turn_callback: { turn ->
            assert_eq(
              turn?.resolved_tool_calls,
              [],
              "a turn with no resolved calls has an empty inventory",
            )
            const lifecycle = agent_transcript_tool_lifecycle_report(
              agent_session_messages(harness.agent, turn.session_id),
            )
            const reconciled = agent_transcript_turn_lifecycle_report(
              lifecycle,
              turn?.resolved_tool_calls,
              turn.iteration,
            )
            assert_eq(reconciled.status, "complete", "the empty turn must be observed")
            assert_eq(reconciled.expected_count, 0)
            assert_eq(reconciled.observed_count, 0)
            assert_eq(reconciled.assistant_row_count, 1)
            return {stop: true, stop_reason: "empty"}
          },
        },
      )
      assert_eq(result.stop_reason, "empty")
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "first-turn", name: "lookup", arguments: {query: "one"}}]},
      {text: "done"},
    ],
    { ->
      const marker = "reconciled-turn-count"
      harness.runtime.store_set(marker, 0)
      const result = agent_loop(
        harness,
        "Look up one fact and answer.",
        nil,
        {
          provider: "mock",
          tool_format: "native",
          tools: tools,
          max_iterations: 2,
          loop_until_done: true,
          post_turn_callback: { turn ->
            const lifecycle = agent_transcript_tool_lifecycle_report(
              agent_session_messages(harness.agent, turn.session_id),
            )
            const reconciled = agent_transcript_turn_lifecycle_report(
              lifecycle,
              turn?.resolved_tool_calls,
              turn.iteration,
            )
            assert_eq(reconciled.status, "complete", "each real turn must reconcile")
            harness.runtime.store_set(marker, harness.runtime.store_get(marker) + 1)
            if len(turn?.resolved_tool_calls ?? []) == 0 {
              return {stop: true, stop_reason: "two-turns"}
            }
            return {stop: false}
          },
        },
      )
      assert_eq(result.stop_reason, "two-turns")
      assert_eq(harness.runtime.store_get(marker), 2)
      harness.runtime.store_set(marker, nil)
    },
  )
  const sid = harness.agent.open(nil)
  const marker = "post-turn-unavailable-" + sid
  const legacy = agent_compute_post_turn(
    harness,
    {session_id: sid},
    {text: "done"},
    nil,
    {
      post_turn_callback: { turn ->
        harness.runtime.store_set(marker, true)
        assert_eq(turn?.resolved_tool_calls, nil, "an unavailable inventory must not look empty")
        return {stop: true, stop_reason: "unavailable"}
      },
    },
    0,
  )
  harness.agent.close(sid)
  assert_eq(harness.runtime.store_get(marker), true, "the direct callback must run")
  harness.runtime.store_set(marker, nil)
  assert(legacy != nil, "the direct post-turn control must reach its callback")
  const partial_sid = harness.agent.open(nil)
  const partial_marker = "post-turn-partial-" + partial_sid
  const partial_calls = [
    {id: "duplicate", name: "lookup"},
    {id: "duplicate", name: "lookup"},
    {name: "lookup"},
    {id: "nameless"},
  ]
  const partial = agent_compute_post_turn(
    harness,
    {session_id: partial_sid},
    {text: "done"},
    nil,
    {
      post_turn_callback: { turn ->
        harness.runtime.store_set(partial_marker, true)
        assert_eq(
          turn?.resolved_tool_calls,
          [
            {id: "duplicate", name: "lookup"},
            {id: "duplicate", name: "lookup"},
            {id: nil, name: "lookup"},
            {id: "nameless", name: nil},
          ],
          "duplicate and missing identities must remain visible",
        )
        return {stop: true, stop_reason: "partial"}
      },
    },
    0,
    partial_calls,
  )
  harness.agent.close(partial_sid)
  assert_eq(
    harness.runtime.store_get(partial_marker),
    true,
    "the partial inventory callback must run",
  )
  harness.runtime.store_set(partial_marker, nil)
  assert(partial != nil)
  harness.stdio.println("resolved calls verified")
}
