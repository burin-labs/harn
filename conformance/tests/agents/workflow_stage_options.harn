import { workflow_stage_agent_options } from "std/workflow/options"

pipeline default(harness: Harness) {
  const explicit = workflow_stage_agent_options(
    {
      mode: "agent",
      has_tools: true,
      session_id: "stage-1",
      done_sentinel: "DONE",
      exit_when_verified: true,
      model_policy: {
        provider: "mock",
        model: "mock-model",
        tool_format: " native ",
        max_iterations: 4,
        max_nudges: 1,
        nudge: "use a tool",
        native_tool_fallback: "allow_once",
        tool_examples: "example",
        stop_after_successful_tools: ["edit"],
        require_successful_tools: ["test", ["edit", "scaffold"]],
      },
      host: {env_tool_format: "text", default_tool_format: "text"},
    },
  )
  harness.stdio.println(explicit.tool_format)
  harness.stdio.println(explicit.run_agent_loop)
  harness.stdio.println(explicit.llm_options.provider)
  harness.stdio.println(explicit.llm_options.tool_format)
  harness.stdio.println(explicit.agent_loop_options.max_iterations)
  harness.stdio.println(explicit.agent_loop_options.session_id)
  harness.stdio.println(explicit.agent_loop_options.native_tool_fallback)
  harness.stdio.println(explicit.agent_loop_options.done_sentinel)
  harness.stdio.println(explicit.agent_loop_options.exit_when_verified)
  harness.stdio.println(explicit.agent_loop_options.stop_after_successful_tools[0])
  harness.stdio.println(json_stringify(explicit.agent_loop_options.require_successful_tools))
  const env = workflow_stage_agent_options(
    {
      has_tools: true,
      model_policy: {tool_format: "   "},
      host: {env_tool_format: "native", default_tool_format: "text"},
    },
  )
  harness.stdio.println(env.tool_format)
  const defaulted = workflow_stage_agent_options(
    {
      has_tools: false,
      model_policy: {},
      host: {env_tool_format: "", default_tool_format: "native"},
    },
  )
  harness.stdio.println(defaulted.tool_format)
  harness.stdio.println(defaulted.run_agent_loop)
  harness.stdio.println(defaulted.agent_loop_options.max_iterations)
}
