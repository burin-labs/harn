import { agent_loop } from "std/agent/loop"
import { AgentLoopOptions } from "std/agent/options"
import { read_jsonl } from "std/jsonl"
import { with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm,
    [{error: {category: "transient_network", message: "connection reset by peer"}}],
    { ->
      const transcript_dir = path_join(
        harness.fs.workspace_temp_dir(),
        "harn-provider-call-error-telemetry-" + harness.random.uuid(),
      )
      const opts: AgentLoopOptions = {
        provider: "mock",
        model: "mock",
        loop_until_done: true,
        max_iterations: 1,
        llm_transcript_dir: transcript_dir,
      }
      agent_loop(harness, "Return a short answer.", nil, opts)
      const records = read_jsonl(
        harness.fs,
        path_join(transcript_dir, "llm_transcript.jsonl"),
        {strict: true},
      )
      const errors = records.filter({ record -> record.type == "provider_call_error" })
      harness.stdio.println(len(errors) == 1)
      harness.stdio.println(errors[0].attempt)
      harness.stdio.println(errors[0].status)
      harness.stdio.println(errors[0].retryable)
      harness.stdio.println(errors[0].status != "retries_exhausted")
    },
  )
}
