import { task_plan_render_mermaid } from "std/agent/task_plan"

pipeline main() {
  const plan = {
    schema_version: "1",
    objective: "Smoke-test the mermaid renderer",
    entry: "discover",
    nodes: {
      discover: {kind: "read_fact", purpose: "map middleware"},
      gate: {kind: "human_gate", human_gate: {approval_id: "ship"}},
      cmd: {kind: "deterministic_command", command: {tool: "cargo"}},
      check: {kind: "verify"},
    },
    edges: [
      {from: "discover", to: "gate"},
      {from: "gate", to: "cmd", branch: "approved"},
      {from: "cmd", to: "check"},
    ],
  }
  const mermaid = task_plan_render_mermaid(plan)
  __io_println(starts_with(mermaid, "flowchart TD"))
  __io_println(contains(mermaid, "discover[\"discover: read_fact"))
  __io_println(contains(mermaid, "gate((\"gate: human_gate"))
  __io_println(contains(mermaid, "cmd[/\"cmd: deterministic_command"))
  __io_println(contains(mermaid, "check{{\"check: verify"))
  __io_println(contains(mermaid, "gate -- approved --> cmd"))
  __io_println(contains(mermaid, "cmd --> check"))
}
