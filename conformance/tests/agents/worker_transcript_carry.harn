import "std/agent/workers"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [llm_text("first carried answer"), llm_text("second reset answer")],
    { ->
      const worker = sub_agent_run(harness, "Answer the first prompt.",
        {provider: "mock", background: true, carry: {transcript_mode: "reset"}},
      )
      const first = wait_agent(harness.agent, worker)
      const first_snapshot = json_parse(harness.fs.read_text(first?.snapshot_path))
      harness.stdio.println(first_snapshot?.carry_policy?.transcript_mode == "reset")
      harness.stdio.println(
        contains(
          json_stringify(first_snapshot?.transcript?.messages ?? []),
          "first carried answer",
        ),
      )
      const resumed = send_input(harness.agent, first, "Answer the second prompt.")
      const second = wait_agent(harness.agent, resumed)
      const second_snapshot = json_parse(harness.fs.read_text(second?.snapshot_path))
      const second_messages = json_stringify(second_snapshot?.transcript?.messages ?? [])
      harness.stdio.println(contains(second_messages, "second reset answer"))
      harness.stdio.println(!contains(second_messages, "first carried answer"))
    },
  )
}
