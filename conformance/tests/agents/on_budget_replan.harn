import { OnBudget, replan } from "std/lifecycle/on_budget"

fn reminder_has_no_command_terms(body: string?) {
  const lowered = lowercase(body)
  return !contains(lowered, "cargo")
    && !contains(lowered, "swift")
    && !contains(lowered, "pytest")
    && !contains(lowered, "jest")
    && !contains(lowered, "gradle")
    && !contains(lowered, "dotnet")
    && !contains(lowered, "rspec")
    && !contains(lowered, "go test")
    && !contains(lowered, "tsc")
    && !contains(lowered, "rustc")
}

pipeline default(harness: Harness) {
  const src = harness.agent.open("on-budget-replan-source")
  harness.agent.inject(src, {role: "user", content: "seed"})
  harness.agent.inject(src, {role: "assistant", content: "branch"})
  const result = replan(
    harness,
    {session_id: src, iteration: 2, last_good_iteration: 1, kind: "wall_clock"},
  )
  const snapshot = harness.agent.snapshot(result.session_id)
  const reminders = transcript_events_by_kind(snapshot, "system_reminder")
  const body = reminders[0].reminder.body
  const ns = OnBudget()
  harness.stdio.println("strategy=" + result.strategy)
  harness.stdio.println("branched_at=" + to_string(snapshot.branched_at_event_index))
  harness.stdio.println("reminders=" + to_string(len(reminders)))
  harness.stdio.println("body=" + body)
  harness.stdio.println("body_clean=" + to_string(reminder_has_no_command_terms(body)))
  harness.stdio.println("namespace=" + to_string(ns.replan != nil))
}
