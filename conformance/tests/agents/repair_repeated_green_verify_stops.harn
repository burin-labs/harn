import { agent_capture_events } from "std/agent/events"
import { with_llm_script } from "std/testing"

/**
 * Evidence-aware repair loop: after a workspace edit has been followed by a
 * passing non-edit verification result, repeating the exact same green
 * observation is terminal evidence, not progress that should buy more adaptive
 * budget.
 */
fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

fn repair_tools() {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "apply_fix",
    "Apply a source edit",
    {
      handler: { _args -> "edit applied" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  tools = tool_define(
    tools,
    "run_test",
    "Run the test suite",
    {
      handler: { _args -> "all tests pass" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

fn call(id, name) {
  return {text: "", tool_calls: [{id: id, name: name, arguments: {}}]}
}

pipeline default() {
  with_llm_script(
    [
      call("edit-1", "apply_fix"),
      call("test-1", "run_test"),
      call("test-2", "run_test"),
      call("test-3", "run_test"),
      call("test-4", "run_test"),
    ],
    { ->
      let session = "repair-repeated-green-" + uuid()
      let captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Fix the bug and run the tests.",
          nil,
          {
            provider: "mock",
            tools: repair_tools(),
            tool_format: "native",
            loop_until_done: true,
            iteration_budget: {mode: "adaptive", initial: 3, max: 12, extend_by: 3},
            session_id: session,
            stall_diagnostics: {enabled: true, repair_aware: true, post_edit_reverify: true, no_net_progress_extend_guard: true},
          },
        ) },
      )
      let decisions = events_of(captured.events, "loop_control_decision")
      let extensions = decisions.filter({ decision -> decision.action == "extend" })
      __io_println(captured.result.status)
      __io_println(captured.result.stop_reason)
      __io_println(captured.result.llm.iterations)
      __io_println(captured.result.adaptive_budget.extensions_used)
      __io_println(len(extensions))
    },
  )
}
