// What may live inside a `<tool_call>` block besides Harn's `name({ ... })`.
//
// Providers put four other things in there: a raw JSON object, a single-element
// JSON array (the OpenAI `tool_calls: [ ... ]` shape leaking into text), a
// nested XML function wrapper naming the tool, and narration the model wrote
// while deciding not to act. The first three are unambiguous recoveries and
// dispatch. Narration is not a malformed call and must not be reported as one —
// the model took no action, which is the loop's problem, not the parser's.
//
// The line the recoveries do not cross: a multi-element array is genuinely
// ambiguous, and an unknown inner tag names no tool. Both fail loudly rather
// than vanishing into prose, because a body swallowed with zero calls and zero
// errors gives the model nothing to correct.
import { probe, sample_registry } from "_tool_parse_probe"

pipeline main(harness: Harness) {
  // Gemma-family stacks return raw JSON inside the wrapper.
  probe(harness, "json object body",
    "<tool_call>{\"name\":\"edit\",\"arguments\":{\"action\":\"create\",\"path\":\"a.rs\",\"content\":\"fn a() {}\"}}</tool_call>",
    sample_registry(),
  )
  // One logical call expressed as a single-element array dispatches identically.
  probe(harness, "single element json array body",
    "<tool_call>[{\"name\":\"edit\",\"arguments\":{\"action\":\"create\",\"path\":\"a.rs\",\"content\":\"fn a() {}\"}}]</tool_call>",
    sample_registry(),
  )
  // Two calls in one block cannot be correlated to results, so this must not
  // over-dispatch — but it must surface the actionable one-call-per-block error
  // rather than being swallowed as prose.
  probe(harness, "multi element json array body",
    "<tool_call>[{\"name\":\"edit\",\"arguments\":{\"action\":\"create\",\"path\":\"a.rs\"}},{\"name\":\"edit\",\"arguments\":{\"action\":\"create\",\"path\":\"b.rs\"}}]</tool_call>",
    sample_registry(),
  )
  // A generic XML function wrapper naming a registered tool, with JSON args.
  probe(harness, "nested xml wrapper naming a registered tool",
    "<tool_call><edit>{\"action\":\"create\",\"path\":\"a.rs\",\"content\":\"fn a() {}\"}</edit></tool_call>",
    sample_registry(),
  )
  probe(harness, "nested xml wrapper naming an unknown tool",
    "<tool_call><deploy>{\"target\":\"prod\"}</deploy></tool_call>",
    sample_registry(),
  )
  // The dominant DeepSeek shape: the inner open tag names a real tool, the
  // inner close is malformed, and there is no outer close. The JSON is
  // complete, so this is recoverable — not truncated.
  probe(harness, "nested xml, mismatched inner close, no outer close",
    """<tool_call>
<edit>
{ "action": "create", "path": "a.rs", "content": "fn a() {}" }
</edit_call>""",
    sample_registry(),
  )
  // The inner tag never closes and a duplicate `</tool_call>` follows. Dispatch
  // the call and swallow the orphan close without a noisy violation.
  probe(harness, "nested xml, missing inner close, duplicate outer close",
    """<tool_call>
<edit>
{ "action": "create", "path": "a.rs" }
</tool_call>
</tool_call>""",
    sample_registry(),
  )
  // Same sloppy shape with an unknown inner tag: prose with angle brackets must
  // not be mis-parsed into a call.
  probe(harness, "nested xml, unknown tool, sloppy close",
    """<tool_call>
<frobnicate>
{ "target": "prod" }
</frobnicate_call>""",
    sample_registry(),
  )
  // Narration the model wrapped in `<tool_call>`: no call, no error, no
  // violation, text preserved as prose.
  probe(harness, "wrapped assistant_prose is narration",
    """<tool_call>
<assistant_prose>
Reading parser.go to understand ParseManifest.
</assistant_prose>
</tool_call>""",
    sample_registry(),
  )
  probe(harness, "bare prose body is narration",
    """<tool_call>
Reading the file to understand the layout.
</tool_call>""",
    sample_registry(),
  )
  // Narration AND a real call in the same block: recover the call, keep the
  // narration.
  probe(harness, "narration alongside a real call",
    """<tool_call>
<assistant_prose>
Reading parser.go first.
</assistant_prose>
run({ command: "cat parser.go" })
</tool_call>""",
    sample_registry(),
  )
  // The narration allowance is scoped to the narration allowlist; an unknown
  // wrapped tag that looks like an attempted call is still rejected.
  probe(harness, "unknown wrapped tag is not narration",
    """<tool_call>
<frobnicate>
{ "target": "prod" }
</frobnicate>
</tool_call>""",
    sample_registry(),
  )
}
