// The tool-call parse invariant as a property, over generated compositions.
//
// `tool_parse_invariant_matrix` pins the arrangements someone thought of. This
// pins the ones nobody did. The scanner already carries property coverage for
// span tiling, but the scanner cannot see the invariant that matters: whether a
// call the model wrote reached dispatch, and whether the model was told when it
// did not. That question only has an answer at the public seam, with the
// feedback layer attached, so this drives `agent_parse_tool_calls` and asks
// `__parse_feedback_diagnostics` what the loop would actually deliver.
//
// Three properties, over every composition of the fragments models really emit:
//
//   1. NO QUIET LOSS. If fewer calls come back than were planted, the turn must
//      say something the model will receive. Recovering less is allowed;
//      recovering less in silence is the defect this whole lane exists to kill.
//   2. NO INVENTION. Never more calls than were planted, and narration that
//      names no tool must yield none at all. A parser that gets loud enough to
//      satisfy property 1 by guessing would fail here.
//   3. NO CORRUPTION. Every recovered argument value that came from a planted
//      call must be the bytes the fragment carried, not a re-encoding. This is
//      the wall that makes "maximally tolerant" safe: a recovery that rewrites
//      an escape-heavy body through the wrong grammar has corrupted the work,
//      not saved it.
//
// Seeds are fixed so a failure is reproducible from the printed seed alone, and
// so this costs no wall-clock in CI. Widen the range locally to sweep further.
//
// The range is NOT "everything we could generate". Widening it to 600 seeds
// surfaces harn#6787 at seed 329: on a tagged pin only the first fenced call in
// a message is recovered and the rest are dropped in silence, which predates
// this harness and is tracked separately. The range stops below that so this
// file pins what is fixed rather than encoding a known defect as expected. Raise
// it when #6787 lands; a green run here is evidence about the compositions
// covered, not a claim that none exist beyond them.
import { __parse_feedback_diagnostics } from "std/agent/loop_tool_calls"
import { agent_parse_tool_calls } from "std/agent/primitives"
import { corpus_registry } from "_tool_parse_probe"

const PINS: list<string> = ["json", "text", "native"]

/**
 * Fragments that each carry exactly one recoverable call, with the argument
 * value that must survive verbatim.
 */
const CALL_FRAGMENTS: list<dict> = [
  {text: "<tool_call>\nlook({ path: \"src/a.py\" })\n</tool_call>\n", value: "src/a.py"},
  {
    text: "```tool\n{\"name\": \"look\", \"arguments\": {\"path\": \"src/b.py\"}}\n```\n",
    value: "src/b.py",
  },
  {text: "<tool_call>\nlook\n{\"path\": \"src/c.py\"}\n</tool_call>\n", value: "src/c.py"},
  {text: "[[tool]]look({ path: \"src/d.py\" })[[/tool]]\n", value: "src/d.py"},
  {
    text:
      "<tool_call>\nrun({ command: <<EOF\necho \"a b\" && ls -la | wc -l\nEOF })\n</tool_call>\n",
    value: "echo \"a b\" && ls -la | wc -l",
  },
]

/**
 * Fragments that carry no call under any pin, and must never produce one.
 *
 * A ```json block is deliberately NOT in here. `tool_fence_info_intent` calls
 * that spelling `drift`: on a route that already taught fenced JSON it is the
 * wrong label on the right thing and dispatches by design, while on a tagged
 * route it stays documentation. That pin-dependent fragment is asserted on its
 * own below rather than smuggled into a pool that claims to hold non-calls.
 */
const PROSE_FRAGMENTS: list<string> = [
  "I will start by reading the file.\n",
  "You could look(path) here, but I am not going to run anything yet.\n",
  "```python\nprint(\"some unrelated code\")\n```\n",
  "Reading the file first, then I will decide what to change.\n",
]

/** A fence that documents the shape of a call. Never an action on a tagged pin. */
const DOCUMENTED_CALL: string =
  "Here is the shape:\n```json\n{\"name\": \"look\", \"args\": {\"path\": \"x\"}}\n```\n"

/** Fragments that are call-shaped but abandoned: recoverable or not, never silent. */
const BROKEN_FRAGMENTS: list<string> = [
  "<tool_call>\nlook({ path: \"half\n",
  "<tool_call>\nlook({ path: \"src/e.py\" })\n",
  "</tool_call>\n",
  "<invoke name=\"look\">\n",
]

/** A small deterministic generator; the seed is printed with any failure. */
fn __next(state: int) -> int {
  return (state * 1103515245 + 12345) % 2147483648
}

fn __compose(seed: int, count: int) -> dict {
  let state = seed
  let text = ""
  let planted = 0
  let shaped = 0
  let values: list<string> = []
  for _ in range(0, count) {
    state = __next(state)
    const bucket = state % 3
    state = __next(state)
    if bucket == 0 {
      const pick = CALL_FRAGMENTS[state % len(CALL_FRAGMENTS)]
      text = text + to_string(pick.text)
      values = values + [to_string(pick.value)]
      planted = planted + 1
      shaped = shaped + 1
    } else if bucket == 1 {
      text = text + to_string(PROSE_FRAGMENTS[state % len(PROSE_FRAGMENTS)])
    } else {
      text = text + to_string(BROKEN_FRAGMENTS[state % len(BROKEN_FRAGMENTS)])
      shaped = shaped + 1
    }
  }
  return {text: text, planted: planted, shaped: shaped, values: values}
}

fn __check(
  caps: {agent: HarnessAgent, llm: HarnessLlm},
  pin: string,
  seed: int,
  composed: dict,
) -> nil {
  const parsed = agent_parse_tool_calls(
    caps.agent,
    to_string(composed.text),
    corpus_registry(),
    pin,
  )
  const feedback = __parse_feedback_diagnostics(
    caps.llm,
    parsed,
    {tool_format: pin, tools: corpus_registry()},
  )
  const calls = parsed?.calls ?? []
  const planted = to_int(composed.planted)
  const shaped = to_int(composed.shaped)
  const loud = len(feedback) > 0 || len(parsed?.tool_parse_errors ?? []) > 0
  const where = "seed=" + to_string(seed) + " pin=" + pin
  // 2. No invention: a composition can never yield more calls than it has
  //    call-shaped spans, whatever recovery it went through.
  require len(calls) <= shaped,
    where + " invented calls: " + to_string(len(calls)) + " from "
    + to_string(
    shaped,
  )
    + " spans"
  // 1. No quiet loss.
  require len(calls) >= planted || loud,
    where
    + " lost a planted call in silence: recovered "
    + to_string(len(calls))
    + " of "
    + to_string(planted)
  // 3. No corruption: every recovered argument value that matches a planted one
  //    must match it byte for byte, so a value can never come back re-encoded.
  for call in calls {
    for key in keys(call?.arguments ?? {}) {
      const value = call.arguments[key]
      if type_of(value) == "string" {
        require contains(to_string(composed.text), to_string(value)),
          where
          + " argument value is not a slice of the source: "
          + json_stringify(value)
      }
    }
  }
}

fn main(harness: Harness) {
  const seeds = range(1, 61)
  for seed in seeds {
    const composed = __compose(seed, 1 + seed % 5)
    for pin in PINS {
      __check({agent: harness.agent, llm: harness.llm}, pin, seed, composed)
    }
  }
  // Property 2, the sharp end: narration alone must never manufacture a call,
  // including a fenced ```json block that documents the shape of one.
  for seed in range(1, 21) {
    let text = ""
    let state = seed
    for _ in range(0, 3) {
      state = __next(state)
      text = text + to_string(PROSE_FRAGMENTS[state % len(PROSE_FRAGMENTS)])
    }
    for pin in PINS {
      const parsed = agent_parse_tool_calls(harness.agent, text, corpus_registry(), pin)
      require len(parsed?.calls ?? []) == 0,
        "narration produced a call: seed=" + to_string(seed)
        + " pin="
        + pin
      // The same narration must stay narration with a documented call beside
      // it, on the pins where a ```json fence is documentation rather than a
      // wrong-labelled call.
      const documented = agent_parse_tool_calls(
        harness.agent,
        text + DOCUMENTED_CALL,
        corpus_registry(),
        pin,
      )
      if pin != "json" {
        require len(documented?.calls ?? []) == 0,
          "a documented call dispatched: seed="
          + to_string(
          seed,
        )
          + " pin="
          + pin
      }
    }
  }
  harness.stdio.println("parse invariant properties hold over 60 compositions x 3 pins")
}
