import "std/triggers"

fn replay_marker_path(fs: HarnessFs, event: TriggerEvent) -> string {
  return path_join(
    fs.workspace_temp_dir(),
    "harn-trigger-replay-event-log-" + to_string(event.headers?.x_delivery ?? "unknown")
      + ".marker",
  )
}

fn flaky_handler(harness: Harness, event: TriggerEvent) -> dict {
  const marker_path = replay_marker_path(harness.fs, event)
  if !harness.fs.exists(marker_path) {
    harness.fs.write_text(marker_path, "seen")
    throw "replay-fail:" + event.kind
  }
  return {kind: event.kind, provider: event.provider, replayed: event.id}
}

pipeline test(harness: Harness, task: unknown) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.range(100000, 999999))
  const delivery = "evt-replay-" + unique
  const trigger_id = "replay-trigger-" + unique
  const handle: TriggerHandle = harness.runtime.trigger_register(
    {
      id: trigger_id,
      kind: "issue.opened",
      provider: "webhook",
      handler: flaky_handler,
      retry: {max: 1, backoff: "immediate"},
      when: nil,
      when_budget: nil,
      match: nil,
      events: ["issue.opened"],
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: nil,
      package_name: nil,
    },
  )
  const fired: DispatchHandle = harness.runtime.trigger_fire(
    handle,
    {provider: "webhook", kind: "issue.opened", headers: {x_delivery: delivery}},
  )
  harness.stdio.println(
    fired.status == "dlq" && contains(fired.error ?? "", "replay-fail:issue.opened"),
  )
  const before: list<DlqEntry> = harness.runtime.trigger_inspect_dlq()
  const pending_before = before.filter({ entry -> entry.binding_id == handle.id })
  harness.stdio.println(len(pending_before) == 1 && pending_before[0]?.event_id == fired.event_id)
  harness.stdio.println(
    len(pending_before[0]?.retry_history) == 1
      && pending_before[0]?.retry_history?.[0]?.status
        == "dlq",
  )
  const replay: DispatchHandle = harness.runtime.trigger_replay(fired.event_id)
  harness.stdio.println(
    replay.status == "dispatched" && replay.replay_of_event_id == fired.event_id,
  )
  harness.stdio.println(contains(json_stringify(replay.result ?? {}), "\"kind\":\"issue.opened\""))
  const after: list<DlqEntry> = harness.runtime.trigger_inspect_dlq()
  const pending_after = after.filter({ entry -> entry.binding_id == handle.id })
  harness.stdio.println(len(pending_after) == 0)
  const bindings_after: list<TriggerBinding> = harness.runtime.trigger_list()
  const live = bindings_after.find({ binding -> binding.id == handle.id })
  harness.stdio.println(live?.metrics?.dlq == 1)
  harness.stdio.println(live?.metrics?.dispatched == 1)
  const marker_path = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-trigger-replay-event-log-" + delivery + ".marker",
  )
  if harness.fs.exists(marker_path) {
    harness.fs.delete(marker_path)
  }
}
