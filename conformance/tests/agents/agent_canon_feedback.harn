import {
  canon_evaluate_slice,
  canon_event_observed_symbols,
  canon_event_paths,
  canon_event_router,
  canon_event_write_path_from_result,
  canon_feedback_text,
  canon_inject_feedback,
  canon_inject_paths_feedback,
  canon_install_feedback_sink,
  canon_pack_ids_for_path,
  canon_resolve_packs,
  canon_resolve_root,
  canon_slice_from_files,
  canon_slice_from_paths,
} from "std/agent/canon"
import { with_fs } from "std/testing"

const INVARIANTS = """
@invariant
@deterministic
@archivist(evidence: ["fixture"], confidence: 1.0, source_date: "2026-07-03")
pub fn no_bad(slice, _ctx, _repo_at_base) {
  if contains(slice.files[0].text, "bad") {
    return {
      verdict: "Block",
      rule: "no_bad",
      findings: [{path: slice.files[0].path, message: "bad sentinel"}],
      remediation: "Remove bad sentinel text.",
    }
  }
  return {verdict: "Allow", rule: "no_bad", findings: [], remediation: ""}
}
"""

fn write_latex_canon_package(dir) {
  harness.fs.mkdir(path_join(dir, ".harn/packages/latex-canon/canon/latex"))
  harness.fs
    .write_text(
    path_join(dir, ".harn/packages/latex-canon/harn.toml"),
    "version = 1\n[package]\nname = \"latex-canon\"\npermissions = [\"workspace:read_text\"]\n\n[[contributes]]\nkind = \"harn.canon\"\nid = \"latex\"\ntitle = \"LaTeX\"\npath = \"canon/latex\"\nextensions = [\"tex\"]\n",
  )
  harness.fs
    .write_text(
    path_join(dir, ".harn/packages/latex-canon/canon/latex/invariants.harn"),
    INVARIANTS,
  )
}

fn write_manifest_canon_package(dir) {
  harness.fs.mkdir(path_join(dir, ".harn/packages/canon-manifest/canon/latex"))
  harness.fs
    .write_text(
    path_join(dir, ".harn/packages/canon-manifest/harn.toml"),
    "version = 1\n[package]\nname = \"canon-manifest\"\npermissions = [\"workspace:read_text\"]\n\n[[contributes]]\nkind = \"harn.canon\"\nmanifest = \"canon/canon-packs.json\"\n",
  )
  harness.fs
    .write_text(
    path_join(dir, ".harn/packages/canon-manifest/canon/canon-packs.json"),
    "{\"schema_version\":1,\"packs\":[{\"id\":\"latex\",\"title\":\"LaTeX\",\"invariants\":\"latex/invariants.harn\",\"extensions\":[\"tex\"]}]}",
  )
  harness.fs
    .write_text(
    path_join(dir, ".harn/packages/canon-manifest/canon/latex/invariants.harn"),
    INVARIANTS,
  )
}

fn canon_feedback_state_key(session_id: string, suffix: string) -> string {
  return "harn.canon_feedback.${session_id}.${suffix}"
}

pipeline main(task) {
  const manifest = {
    schema_version: 1,
    packs: [
      {
        id: "zig",
        title: "Zig",
        invariants: "zig/invariants.harn",
        extensions: ["foo"],
        file_names: ["buildfile"],
      },
    ],
  }
  __io_println(join(canon_pack_ids_for_path("src/main.zig"), ","))
  __io_println(join(canon_pack_ids_for_path("src/main.foo", manifest), ","))
  __io_println(join(canon_pack_ids_for_path("Buildfile", manifest), ","))
  __io_println(to_string(len(canon_pack_ids_for_path("src/main.zig", manifest)) == 0))
  const event_paths = canon_event_paths(
    {
      changed_paths: [{path: "src/main.foo"}, "src/main.foo"],
      changedPaths: [{file: "src/camel.foo"}],
      files_written: 2,
      filesWritten: ["src/top.foo"],
      iteration_info: {changed_paths: ["src/other.foo"], files_written: [{name: "build.foo"}]},
      iterationInfo: {changedPaths: ["src/main.foo", {file_path: "src/filepath.foo"}], filesWritten: 1},
      tool_results: [{tool_name: "edit", status: "ok", arguments: {path: "src/from-edit.foo"}}],
    },
  )
  const expected_event_paths = [
    "src/main.foo",
    "src/camel.foo",
    "src/top.foo",
    "src/other.foo",
    "build.foo",
    "src/filepath.foo",
    "src/from-edit.foo",
  ]
  require event_paths == expected_event_paths, "canon_event_paths extracts and dedupes paths"
  const fallback_path = canon_event_write_path_from_result({tool_name: "edit", observation: "updated src/fallback.foo"})
  require fallback_path == "src/fallback.foo", "canon_event_write_path_from_result uses terse observations"
  const event_symbols = canon_event_observed_symbols(
    {
      observed_symbols: ["format_value", {symbol: "serialize"}],
      observedSymbol: "render",
      observations: [{kind: "observe_output", name: "encode"}],
      tool_results: [
        {result: {schema: "harn.probe.v1", name: "decode"}},
        {raw_output: {observed_symbols: ["print_ini", "format_value"]}},
      ],
    },
  )
  const expected_symbols = ["format_value", "serialize", "render", "encode", "decode", "print_ini"]
  require event_symbols == expected_symbols, "canon_event_observed_symbols preserves ordered unique observations"
  with_fs(
    {
      "canon-packs.json": manifest,
      "src/main.foo": "const bad = true;",
      "src/ok.foo": "const good = true;",
      "zig/invariants.harn": INVARIANTS,
      ".harn/canon/canon-packs.json": manifest,
      ".harn/canon/zig/invariants.harn": INVARIANTS,
    },
    { dir ->
      __io_println(to_string(canon_resolve_root({canon_root: dir}) == dir))
      __io_println(to_string(canon_resolve_root({project_root: dir}) == path_join(dir, ".harn", "canon")))
      const slice = canon_slice_from_files([{path: "src/main.foo", text: "const bad = true;"}])
      const result = canon_evaluate_slice(slice, {canon_root: dir, files: slice.files})
      __io_println(result.status)
      __io_println(to_string(result.packs[0].report.records[0].name == "no_bad"))
      const feedback = canon_feedback_text(result)
      __io_println(to_string(contains(feedback, "no_bad")))
      const path_slice = canon_slice_from_paths(["src/main.foo"], {root: dir})
      __io_println(to_string(path_slice.files[0].text == "const bad = true;"))
      const disabled_session_id = agent_session_open("canon-router-disabled-" + uuid_v7())
      const disabled = canon_event_router(
        disabled_session_id,
        {type: "iteration_end", changed_paths: ["src/main.foo"]},
        {enabled: false, root: dir, canon_root: dir},
      )
      require disabled == nil, "disabled canon_event_router short-circuits"
      const disabled_symbols = store_get(canon_feedback_state_key(disabled_session_id, "observed_symbols"))
      require disabled_symbols == nil, "disabled canon_event_router does not touch session state"
      agent_session_close(disabled_session_id)
      const session_id = agent_session_open("canon-feedback-" + uuid_v7())
      const injected = canon_inject_feedback(session_id, slice, {canon_root: dir, files: slice.files})
      const messages = agent_session_snapshot(session_id).messages
      __io_println(to_string(injected.injected))
      __io_println(to_string(contains(messages[len(messages) - 1].content, "harn-canon")))
      const router_session_id = agent_session_open("canon-router-" + uuid_v7())
      const pre_event = canon_event_router(
        router_session_id,
        {type: "tool_call_update", observed_symbol: "format_value"},
        {root: dir, canon_root: dir},
      )
      require pre_event == nil, "non-iteration canon events only update observations"
      const stored_symbols = store_get(canon_feedback_state_key(router_session_id, "observed_symbols"))
      require stored_symbols == ["format_value"], "canon_event_router stores observed symbols per session"
      const routed = canon_event_router(
        router_session_id,
        {type: "iteration_end", changed_paths: ["src/main.foo"]},
        {root: dir, canon_root: dir, inject: "reminder"},
      )
      const routed_events = transcript_events_by_kind(agent_session_snapshot(router_session_id), "system_reminder")
      require routed.injected, "canon_event_router injects when routed paths trip a pack"
      require routed.paths == ["src/main.foo"], "canon_event_router reports routed paths"
      require len(routed_events) == 1, "canon_event_router injects one reminder"
      require contains(routed_events[0].reminder.body, "no_bad"), "router feedback reaches reminder"
      agent_session_close(router_session_id)
      const fallback_session_id = agent_session_open("canon-router-fallback-" + uuid_v7())
      const fallback = canon_event_router(
        fallback_session_id,
        {type: "iteration_end"},
        {root: dir, canon_root: dir, changed_paths_provider: { -> ["src/main.foo"] }},
      )
      require fallback.injected, "canon_event_router uses changed_paths_provider fallback"
      agent_session_close(fallback_session_id)
      const install_session_id = agent_session_open("canon-install-" + uuid_v7())
      canon_install_feedback_sink(install_session_id, {enabled: false})
      const disabled_install = store_get(canon_feedback_state_key(install_session_id, "installed"))
      require disabled_install == nil, "disabled canon_install_feedback_sink does not mark installed"
      canon_install_feedback_sink(install_session_id, {root: dir, canon_root: dir})
      canon_install_feedback_sink(install_session_id, {root: dir, canon_root: dir})
      require store_get(canon_feedback_state_key(install_session_id, "installed")), "canon_install_feedback_sink installs once"
      agent_session_close(install_session_id)
      const path_session_id = agent_session_open("canon-path-feedback-" + uuid_v7())
      const path_injected = canon_inject_paths_feedback(path_session_id, ["src/main.foo"], {root: dir, canon_root: dir})
      const path_messages = agent_session_snapshot(path_session_id).messages
      __io_println(to_string(path_injected.injected))
      __io_println(to_string(contains(path_messages[len(path_messages) - 1].content, "no_bad")))
      const auto_session_id = agent_session_open("canon-auto-root-feedback-" + uuid_v7())
      const auto_injected = canon_inject_paths_feedback(auto_session_id, ["src/main.foo"], {root: dir, project_root: dir})
      const auto_messages = agent_session_snapshot(auto_session_id).messages
      __io_println(to_string(auto_injected.injected))
      __io_println(to_string(contains(auto_messages[len(auto_messages) - 1].content, "no_bad")))
      agent_session_close(auto_session_id)
      const package_session_id = agent_session_open("canon-package-feedback-" + uuid_v7())
      write_latex_canon_package(dir)
      harness.fs.write_text(path_join(dir, "paper.tex"), "bad macro")
      const package_injected = canon_inject_paths_feedback(package_session_id, ["paper.tex"], {root: dir, project_root: dir})
      const package_messages = agent_session_snapshot(package_session_id).messages
      __io_println(to_string(package_injected.selected_pack_ids == ["latex"]))
      __io_println(to_string(package_injected.injected))
      __io_println(
        to_string(contains(package_messages[len(package_messages) - 1].content, "[latex] LaTeX")),
      )
      agent_session_close(package_session_id)
      const reminder_session_id = agent_session_open("canon-reminder-feedback-" + uuid_v7())
      const reminder_injected = canon_inject_feedback(
        reminder_session_id,
        slice,
        {canon_root: dir, files: slice.files, inject: "reminder"},
      )
      const reminder_events = transcript_events_by_kind(agent_session_snapshot(reminder_session_id), "system_reminder")
      __io_println(to_string(reminder_injected.injected))
      __io_println(to_string(to_string(reminder_injected.reminder_id ?? "") != ""))
      __io_println(to_string(len(reminder_events) == 1))
      __io_println(to_string(reminder_events[0].reminder.preserve_on_compact))
      __io_println(to_string(reminder_events[0].reminder.ttl_turns == 1))
      __io_println(to_string(reminder_events[0].reminder.tags[0] == "harn-canon"))
      __io_println(to_string(contains(reminder_events[0].reminder.body, "no_bad")))
      agent_session_close(reminder_session_id)
      agent_session_close(path_session_id)
      agent_session_close(session_id)
    },
  )
  with_fs(
    {"paper.tex": "bad macro"},
    { dir ->
      write_latex_canon_package(dir)
      const package_only_session_id = agent_session_open("canon-package-only-feedback-" + uuid_v7())
      const package_only_injected = canon_inject_paths_feedback(package_only_session_id, ["paper.tex"], {root: dir, project_root: dir})
      const package_only_messages = agent_session_snapshot(package_only_session_id).messages
      __io_println(to_string(package_only_injected.selected_pack_ids == ["latex"]))
      __io_println(to_string(package_only_injected.injected))
      __io_println(
        to_string(contains(package_only_messages[len(package_only_messages) - 1].content, "[latex] LaTeX")),
      )
      agent_session_close(package_only_session_id)
    },
  )
  with_fs(
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(dir)
      const package_manifest_session_id = agent_session_open("canon-package-manifest-feedback-" + uuid_v7())
      const package_manifest_injected = canon_inject_paths_feedback(
        package_manifest_session_id,
        ["paper.tex"],
        {root: dir, project_root: dir},
      )
      const package_manifest_messages = agent_session_snapshot(package_manifest_session_id).messages
      __io_println(to_string(package_manifest_injected.selected_pack_ids == ["latex"]))
      __io_println(to_string(package_manifest_injected.injected))
      __io_println(
        to_string(
          contains(package_manifest_messages[len(package_manifest_messages) - 1].content, "[latex] LaTeX"),
        ),
      )
      agent_session_close(package_manifest_session_id)
    },
  )
  with_fs(
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(dir)
      const manifest_path = path_join(dir, ".harn/packages/canon-manifest/canon/canon-packs.json")
      harness.fs.write_text(manifest_path, "{bad")
      const malformed = try {
        canon_resolve_packs({project_root: dir, files: [{path: "paper.tex"}]})
      }
      require unwrap_err(malformed).kind == "malformed", "malformed contribution manifest fails closed"
      __io_println(is_err(malformed))
    },
  )
  with_fs(
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(dir)
      const manifest_path = path_join(dir, ".harn/packages/canon-manifest/canon/canon-packs.json")
      harness.fs
        .write_text(
        manifest_path,
        "{\"schema_version\":1,\"packs\":[{\"id\":7,\"invariants\":true}]}",
      )
      const invalid = try {
        canon_resolve_packs({project_root: dir, files: [{path: "paper.tex"}]})
      }
      require unwrap_err(invalid).kind == "schema_invalid", "mistyped contribution manifest fails closed"
      __io_println(is_err(invalid))
    },
  )
  with_fs(
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(dir)
      const manifest_path = path_join(dir, ".harn/packages/canon-manifest/canon/canon-packs.json")
      harness.fs
        .write_text(
        manifest_path,
        "{\"schema_version\":2,\"packs\":[{\"id\":\"latex\",\"invariants\":\"latex/invariants.harn\"}]}",
      )
      const unsupported = try {
        canon_resolve_packs({project_root: dir, files: [{path: "paper.tex"}]})
      }
      require unwrap_err(unsupported).kind == "schema_invalid", "unsupported manifest version fails closed"
      __io_println(is_err(unsupported))
    },
  )
  with_fs(
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(dir)
      const manifest_path = path_join(dir, ".harn/packages/canon-manifest/canon/canon-packs.json")
      harness.fs.delete(manifest_path)
      const missing = try {
        canon_resolve_packs({project_root: dir, files: [{path: "paper.tex"}]})
      }
      require unwrap_err(missing).kind == "absent", "missing contribution manifest fails closed"
      __io_println(is_err(missing))
    },
  )
}
