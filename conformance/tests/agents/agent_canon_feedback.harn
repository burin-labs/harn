import {
  canon_evaluate_slice,
  canon_event_observed_symbols,
  canon_event_paths,
  canon_event_router,
  canon_event_write_path_from_result,
  canon_feedback_text,
  canon_inject_feedback,
  canon_inject_paths_feedback,
  canon_install_feedback_sink,
  canon_pack_ids_for_path,
  canon_resolve_packs,
  canon_resolve_root,
  canon_slice_from_files,
  canon_slice_from_paths,
} from "std/agent/canon"
import { with_fs } from "std/testing"

const INVARIANTS = """
@invariant
@deterministic
@archivist(evidence: ["fixture"], confidence: 1.0, source_date: "2026-07-03")
pub fn no_bad(slice, _ctx, _repo_at_base) {
  if contains(slice.files[0].text, "bad") {
    return {
      verdict: "Block",
      rule: "no_bad",
      findings: [{path: slice.files[0].path, message: "bad sentinel"}],
      remediation: "Remove bad sentinel text.",
    }
  }
  return {verdict: "Allow", rule: "no_bad", findings: [], remediation: ""}
}
"""

fn test_packages_dir(fs: HarnessFs, dir, package_name: string) -> string {
  const generation = "generation-test"
  const generation_root = path_join(dir, ".harn", "package-generations", generation)
  const packages = path_join(generation_root, "packages")
  const lock_body = "version = 4\n\n[[package]]\nname = \"${package_name}\"\n"
  fs.mkdir(packages)
  fs.write_text(path_join(generation_root, "harn.lock"), lock_body)
  fs.write_text(path_join(generation_root, "lease.lock"), "")
  fs.write_text(
    path_join(generation_root, "generation.toml"),
    "schema_version = 1\ngeneration = \"${generation}\"\nlock_digest = \"sha256:${sha256(lock_body)}\"\n",
  )
  fs.write_text(path_join(dir, ".harn", "package-generation.lock"), "")
  fs.write_text(
    path_join(dir, ".harn", "package-current.toml"),
    "schema_version = 1\ngeneration = \"${generation}\"\n",
  )
  return packages
}

fn write_latex_canon_package(fs: HarnessFs, dir) {
  const packages = test_packages_dir(fs, dir, "latex-canon")
  fs.mkdir(path_join(packages, "latex-canon/canon/latex"))
  fs.write_text(
    path_join(packages, "latex-canon/harn.toml"),
    "version = 1\n[package]\nname = \"latex-canon\"\npermissions = [\"workspace:read_text\"]\n\n[[contributes]]\nkind = \"harn.canon\"\nid = \"latex\"\ntitle = \"LaTeX\"\npath = \"canon/latex\"\nextensions = [\"tex\"]\n",
  )
  fs.write_text(path_join(packages, "latex-canon/canon/latex/invariants.harn"), INVARIANTS)
}

fn write_manifest_canon_package(fs: HarnessFs, dir) {
  const packages = test_packages_dir(fs, dir, "canon-manifest")
  fs.mkdir(path_join(packages, "canon-manifest/canon/latex"))
  fs.write_text(
    path_join(packages, "canon-manifest/harn.toml"),
    "version = 1\n[package]\nname = \"canon-manifest\"\npermissions = [\"workspace:read_text\"]\n\n[[contributes]]\nkind = \"harn.canon\"\nmanifest = \"canon/canon-packs.json\"\n",
  )
  fs.write_text(
    path_join(packages, "canon-manifest/canon/canon-packs.json"),
    "{\"schema_version\":1,\"packs\":[{\"id\":\"latex\",\"title\":\"LaTeX\",\"invariants\":\"latex/invariants.harn\",\"extensions\":[\"tex\"]}]}",
  )
  fs.write_text(path_join(packages, "canon-manifest/canon/latex/invariants.harn"), INVARIANTS)
}

fn canon_feedback_state_key(session_id: string, suffix: string) -> string {
  return "harn.canon_feedback.${session_id}.${suffix}"
}

pipeline main(harness: Harness, task) {
  const manifest = {
    schema_version: 1,
    packs: [
      {
        id: "zig",
        title: "Zig",
        invariants: "zig/invariants.harn",
        extensions: ["foo"],
        file_names: ["buildfile"],
      },
    ],
  }
  harness.stdio.println(join(canon_pack_ids_for_path("src/main.zig"), ","))
  harness.stdio.println(join(canon_pack_ids_for_path("src/main.foo", manifest), ","))
  harness.stdio.println(join(canon_pack_ids_for_path("Buildfile", manifest), ","))
  harness.stdio.println(to_string(len(canon_pack_ids_for_path("src/main.zig", manifest)) == 0))
  const event_paths = canon_event_paths(
    {
      changed_paths: [{path: "src/main.foo"}, "src/main.foo"],
      changedPaths: [{file: "src/camel.foo"}],
      files_written: 2,
      filesWritten: ["src/top.foo"],
      iteration_info: {changed_paths: ["src/other.foo"], files_written: [{name: "build.foo"}]},
      iterationInfo: {
        changedPaths: ["src/main.foo", {file_path: "src/filepath.foo"}],
        filesWritten: 1,
      },
      tool_results: [{tool_name: "edit", status: "ok", arguments: {path: "src/from-edit.foo"}}],
    },
  )
  const expected_event_paths = [
    "src/main.foo",
    "src/camel.foo",
    "src/top.foo",
    "src/other.foo",
    "build.foo",
    "src/filepath.foo",
    "src/from-edit.foo",
  ]
  require event_paths == expected_event_paths, "canon_event_paths extracts and dedupes paths"
  const fallback_path = canon_event_write_path_from_result(
    {tool_name: "edit", observation: "updated src/fallback.foo"},
  )
  require fallback_path == "src/fallback.foo",
    "canon_event_write_path_from_result uses terse observations"
  const event_symbols = canon_event_observed_symbols(
    {
      observed_symbols: ["format_value", {symbol: "serialize"}],
      observedSymbol: "render",
      observations: [{kind: "observe_output", name: "encode"}],
      tool_results: [
        {result: {schema: "harn.probe.v1", name: "decode"}},
        {raw_output: {observed_symbols: ["print_ini", "format_value"]}},
      ],
    },
  )
  const expected_symbols = ["format_value", "serialize", "render", "encode", "decode", "print_ini"]
  require event_symbols == expected_symbols,
    "canon_event_observed_symbols preserves ordered unique observations"
  with_fs(
    harness.fs,
    {
      "canon-packs.json": manifest,
      "src/main.foo": "const bad = true;",
      "src/ok.foo": "const good = true;",
      "zig/invariants.harn": INVARIANTS,
      ".harn/canon/canon-packs.json": manifest,
      ".harn/canon/zig/invariants.harn": INVARIANTS,
    },
    { dir ->
      harness.stdio.println(
        to_string(canon_resolve_root(harness.env, harness.fs, {canon_root: dir}) == dir),
      )
      harness.stdio.println(
        to_string(
          canon_resolve_root(harness.env, harness.fs, {project_root: dir})
            == path_join(
            dir,
            ".harn",
            "canon",
          ),
        ),
      )
      const slice = canon_slice_from_files([{path: "src/main.foo", text: "const bad = true;"}])
      const result = canon_evaluate_slice(harness, slice, {canon_root: dir, files: slice.files})
      harness.stdio.println(result.status)
      harness.stdio.println(to_string(result.packs[0].report.records[0].name == "no_bad"))
      const feedback = canon_feedback_text(result)
      harness.stdio.println(to_string(contains(feedback, "no_bad")))
      const path_slice = canon_slice_from_paths(harness.fs, ["src/main.foo"], {root: dir})
      harness.stdio.println(to_string(path_slice.files[0].text == "const bad = true;"))
      const disabled_session_id = harness.agent.open(
        "canon-router-disabled-" + harness.random.uuid_v7(),
      )
      const disabled = canon_event_router(
        harness,
        disabled_session_id,
        {type: "iteration_end", changed_paths: ["src/main.foo"]},
        {enabled: false, root: dir, canon_root: dir},
      )
      require disabled == nil, "disabled canon_event_router short-circuits"
      const disabled_symbols = harness.runtime.store_get(
        canon_feedback_state_key(disabled_session_id, "observed_symbols"),
      )
      require disabled_symbols == nil, "disabled canon_event_router does not touch session state"
      harness.agent.close(disabled_session_id)
      const session_id = harness.agent.open("canon-feedback-" + harness.random.uuid_v7())
      const injected = canon_inject_feedback(
        harness,
        session_id,
        slice,
        {canon_root: dir, files: slice.files},
      )
      const messages = harness.agent.snapshot(session_id).messages
      harness.stdio.println(to_string(injected.injected))
      harness.stdio.println(to_string(contains(messages[len(messages) - 1].content, "harn-canon")))
      const router_session_id = harness.agent.open("canon-router-" + harness.random.uuid_v7())
      const pre_event = canon_event_router(
        harness,
        router_session_id,
        {type: "tool_call_update", observed_symbol: "format_value"},
        {root: dir, canon_root: dir},
      )
      require pre_event == nil, "non-iteration canon events only update observations"
      const stored_symbols = harness.runtime.store_get(
        canon_feedback_state_key(router_session_id, "observed_symbols"),
      )
      require stored_symbols == ["format_value"],
        "canon_event_router stores observed symbols per session"
      const routed = canon_event_router(
        harness,
        router_session_id,
        {type: "iteration_end", changed_paths: ["src/main.foo"]},
        {root: dir, canon_root: dir, inject: "reminder"},
      )
      const routed_events = transcript_events_by_kind(
        harness.agent.snapshot(router_session_id),
        "system_reminder",
      )
      require routed.injected, "canon_event_router injects when routed paths trip a pack"
      require routed.paths == ["src/main.foo"], "canon_event_router reports routed paths"
      require len(routed_events) == 1, "canon_event_router injects one reminder"
      require contains(routed_events[0].reminder.body, "no_bad"), "router feedback reaches reminder"
      harness.agent.close(router_session_id)
      const fallback_session_id = harness.agent.open(
        "canon-router-fallback-" + harness.random.uuid_v7(),
      )
      const fallback = canon_event_router(
        harness,
        fallback_session_id,
        {type: "iteration_end"},
        {root: dir, canon_root: dir, changed_paths_provider: { -> ["src/main.foo"] }},
      )
      require fallback.injected, "canon_event_router uses changed_paths_provider fallback"
      harness.agent.close(fallback_session_id)
      const install_session_id = harness.agent.open("canon-install-" + harness.random.uuid_v7())
      canon_install_feedback_sink(harness, install_session_id, {enabled: false})
      const disabled_install = harness.runtime.store_get(
        canon_feedback_state_key(install_session_id, "installed"),
      )
      require disabled_install == nil,
        "disabled canon_install_feedback_sink does not mark installed"
      canon_install_feedback_sink(harness, install_session_id, {root: dir, canon_root: dir})
      canon_install_feedback_sink(harness, install_session_id, {root: dir, canon_root: dir})
      require harness.runtime.store_get(canon_feedback_state_key(install_session_id, "installed")),
        "canon_install_feedback_sink installs once"
      harness.agent.close(install_session_id)
      const path_session_id = harness.agent.open("canon-path-feedback-" + harness.random.uuid_v7())
      const path_injected = canon_inject_paths_feedback(
        harness,
        path_session_id,
        ["src/main.foo"],
        {root: dir, canon_root: dir},
      )
      const path_messages = harness.agent.snapshot(path_session_id).messages
      harness.stdio.println(to_string(path_injected.injected))
      harness.stdio.println(
        to_string(contains(path_messages[len(path_messages) - 1].content, "no_bad")),
      )
      const auto_session_id = harness.agent.open(
        "canon-auto-root-feedback-" + harness.random.uuid_v7(),
      )
      const auto_injected = canon_inject_paths_feedback(
        harness,
        auto_session_id,
        ["src/main.foo"],
        {root: dir, project_root: dir},
      )
      const auto_messages = harness.agent.snapshot(auto_session_id).messages
      harness.stdio.println(to_string(auto_injected.injected))
      harness.stdio.println(
        to_string(contains(auto_messages[len(auto_messages) - 1].content, "no_bad")),
      )
      harness.agent.close(auto_session_id)
      const package_session_id = harness.agent.open(
        "canon-package-feedback-" + harness.random.uuid_v7(),
      )
      write_latex_canon_package(harness.fs, dir)
      harness.fs.write_text(path_join(dir, "paper.tex"), "bad macro")
      const package_injected = canon_inject_paths_feedback(
        harness,
        package_session_id,
        ["paper.tex"],
        {root: dir, project_root: dir},
      )
      const package_messages = harness.agent.snapshot(package_session_id).messages
      harness.stdio.println(to_string(package_injected.selected_pack_ids == ["latex"]))
      harness.stdio.println(to_string(package_injected.injected))
      harness.stdio.println(
        to_string(contains(package_messages[len(package_messages) - 1].content, "[latex] LaTeX")),
      )
      harness.agent.close(package_session_id)
      const reminder_session_id = harness.agent.open(
        "canon-reminder-feedback-" + harness.random.uuid_v7(),
      )
      const reminder_injected = canon_inject_feedback(
        harness,
        reminder_session_id,
        slice,
        {canon_root: dir, files: slice.files, inject: "reminder"},
      )
      const reminder_events = transcript_events_by_kind(
        harness.agent.snapshot(reminder_session_id),
        "system_reminder",
      )
      harness.stdio.println(to_string(reminder_injected.injected))
      harness.stdio.println(to_string(to_string(reminder_injected.reminder_id ?? "") != ""))
      harness.stdio.println(to_string(len(reminder_events) == 1))
      harness.stdio.println(to_string(reminder_events[0].reminder.preserve_on_compact))
      harness.stdio.println(to_string(reminder_events[0].reminder.ttl_turns == 1))
      harness.stdio.println(to_string(reminder_events[0].reminder.tags[0] == "harn-canon"))
      harness.stdio.println(to_string(contains(reminder_events[0].reminder.body, "no_bad")))
      harness.agent.close(reminder_session_id)
      harness.agent.close(path_session_id)
      harness.agent.close(session_id)
    },
  )
  with_fs(
    harness.fs,
    {"paper.tex": "bad macro"},
    { dir ->
      write_latex_canon_package(harness.fs, dir)
      const package_only_session_id = harness.agent.open(
        "canon-package-only-feedback-" + harness.random.uuid_v7(),
      )
      const package_only_injected = canon_inject_paths_feedback(
        harness,
        package_only_session_id,
        ["paper.tex"],
        {root: dir, project_root: dir},
      )
      const package_only_messages = harness.agent.snapshot(package_only_session_id).messages
      harness.stdio.println(to_string(package_only_injected.selected_pack_ids == ["latex"]))
      harness.stdio.println(to_string(package_only_injected.injected))
      harness.stdio.println(
        to_string(
          contains(package_only_messages[len(package_only_messages) - 1].content, "[latex] LaTeX"),
        ),
      )
      harness.agent.close(package_only_session_id)
    },
  )
  with_fs(
    harness.fs,
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(harness.fs, dir)
      const package_manifest_session_id = harness.agent.open(
        "canon-package-manifest-feedback-" + harness.random.uuid_v7(),
      )
      const package_manifest_injected = canon_inject_paths_feedback(
        harness,
        package_manifest_session_id,
        ["paper.tex"],
        {root: dir, project_root: dir},
      )
      const package_manifest_messages = harness.agent.snapshot(package_manifest_session_id).messages
      harness.stdio.println(to_string(package_manifest_injected.selected_pack_ids == ["latex"]))
      harness.stdio.println(to_string(package_manifest_injected.injected))
      harness.stdio.println(
        to_string(
          contains(
            package_manifest_messages[len(package_manifest_messages) - 1].content,
            "[latex] LaTeX",
          ),
        ),
      )
      harness.agent.close(package_manifest_session_id)
    },
  )
  with_fs(
    harness.fs,
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(harness.fs, dir)
      const manifest_path = path_join(
        test_packages_dir(harness.fs, dir, "canon-manifest"),
        "canon-manifest/canon/canon-packs.json",
      )
      harness.fs.write_text(manifest_path, "{bad")
      const malformed = try {
        canon_resolve_packs(
          harness.env,
          harness.fs,
          {project_root: dir, files: [{path: "paper.tex"}]},
        )
      }
      require unwrap_err(malformed).kind == "malformed",
        "malformed contribution manifest fails closed"
      harness.stdio.println(is_err(malformed))
    },
  )
  with_fs(
    harness.fs,
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(harness.fs, dir)
      const manifest_path = path_join(
        test_packages_dir(harness.fs, dir, "canon-manifest"),
        "canon-manifest/canon/canon-packs.json",
      )
      harness.fs.write_text(
        manifest_path,
        "{\"schema_version\":1,\"packs\":[{\"id\":7,\"invariants\":true}]}",
      )
      const invalid = try {
        canon_resolve_packs(
          harness.env,
          harness.fs,
          {project_root: dir, files: [{path: "paper.tex"}]},
        )
      }
      require unwrap_err(invalid).kind == "schema_invalid",
        "mistyped contribution manifest fails closed"
      harness.stdio.println(is_err(invalid))
    },
  )
  with_fs(
    harness.fs,
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(harness.fs, dir)
      const manifest_path = path_join(
        test_packages_dir(harness.fs, dir, "canon-manifest"),
        "canon-manifest/canon/canon-packs.json",
      )
      harness.fs.write_text(
        manifest_path,
        "{\"schema_version\":2,\"packs\":[{\"id\":\"latex\",\"invariants\":\"latex/invariants.harn\"}]}",
      )
      const unsupported = try {
        canon_resolve_packs(
          harness.env,
          harness.fs,
          {project_root: dir, files: [{path: "paper.tex"}]},
        )
      }
      require unwrap_err(unsupported).kind == "schema_invalid",
        "unsupported manifest version fails closed"
      harness.stdio.println(is_err(unsupported))
    },
  )
  with_fs(
    harness.fs,
    {"paper.tex": "bad macro"},
    { dir ->
      write_manifest_canon_package(harness.fs, dir)
      const manifest_path = path_join(
        test_packages_dir(harness.fs, dir, "canon-manifest"),
        "canon-manifest/canon/canon-packs.json",
      )
      harness.fs.delete(manifest_path)
      const missing = try {
        canon_resolve_packs(
          harness.env,
          harness.fs,
          {project_root: dir, files: [{path: "paper.tex"}]},
        )
      }
      require unwrap_err(missing).kind == "absent", "missing contribution manifest fails closed"
      harness.stdio.println(is_err(missing))
    },
  )
}
