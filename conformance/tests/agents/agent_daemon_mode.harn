pipeline test(task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const dir = path_join(harness.fs.temp_dir(), "harn-agent-daemon-" + unique)
  harness.fs.mkdir(dir)
  const snapshot = path_join(dir, "daemon.json")
  const result = agent_loop(
    "Poll for background work",
    "You are helpful",
    {
      provider: "mock",
      daemon: true,
      max_iterations: 2,
      wake_interval_ms: 1,
      persist_path: snapshot,
      consolidate_on_idle: true,
      auto_compact: true,
      compact_threshold: 1,
      compact_keep_last: 1,
      compact_strategy: "custom",
      compact_callback: { archived -> {summary: "daemon compact " + to_string(len(archived))} },
    },
  )
  const saved = json_parse(harness.fs.read_text(snapshot))
  __io_println(result.status)
  __io_println(result.daemon_state)
  __io_println(result.daemon_snapshot_path == snapshot)
  __io_println(result.llm.iterations)
  __io_println(saved.daemon_state)
  __io_println(saved.total_iterations)
  __io_println(saved.transcript_summary.contains("daemon compact"))
  harness.fs.delete(dir)
}
