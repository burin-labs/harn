// Live-shape / registration proof for `overlay_policy` (std/agent/overlays).
//
// Catches dead-since-inception drift: proves the overlay fragment actually
// REACHES the outbound request (`llm_mock_calls()[i].system`), not just that
// `overlay_context_fragment(...)` renders a plausible string nobody sends.
//
//   A. the matched mode's overlay text appears in the outbound system prompt
//      on the very first call.
//   B. a mode with no matching row adds nothing — `system` is unaffected.
//   C. an overlay ADDS alongside an explicit `system` prompt; it never
//      replaces or removes it — both the caller's text and the overlay body
//      are present in the same outbound `system`.
//   D. an `options.overrides` entry reaches the wire INSTEAD OF the row
//      default for that slot (fill-nil-at-lower-priority, caller wins).
import { default_overlay_rows, overlay_policy } from "std/agent/overlays"
import { llm_text, with_llm_script } from "std/testing"

pipeline default() {
  // --- A. the matched row's text reaches the first outbound system prompt ---
  with_llm_script(
    [llm_text("done ##DONE##")],
    { ->
      let opts = overlay_policy(
        default_overlay_rows(),
        "agent",
        {done_sentinel: "##DONE##", loop_until_done: true, max_iterations: 2, provider: "mock"},
      )
      let result = agent_loop("Do the task.", nil, opts)
      let system = llm_mock_calls()[0].system
      __io_println("A.status=" + result.status)
      __io_println("A.has_overlay=" + to_string(contains(system, "Batch related read-only tool calls")))
    },
  )
  // --- B. no matching row -> system is unaffected ---
  with_llm_script(
    [llm_text("done ##DONE##")],
    { ->
      let opts = overlay_policy(
        default_overlay_rows(),
        "architect",
        {
          done_sentinel: "##DONE##",
          loop_until_done: true,
          max_iterations: 2,
          provider: "mock",
          system: "base system prompt",
        },
      )
      let result = agent_loop("Do the task.", nil, opts)
      let system = llm_mock_calls()[0].system
      __io_println("B.status=" + result.status)
      __io_println("B.has_caller_system=" + to_string(contains(system, "base system prompt")))
      __io_println("B.no_overlay_added=" + to_string(!contains(system, "Batch related read-only")))
    },
  )
  // --- C. overlay ADDS alongside an explicit system prompt, never replaces it ---
  with_llm_script(
    [llm_text("done ##DONE##")],
    { ->
      let opts = overlay_policy(
        default_overlay_rows(),
        "plan",
        {
          done_sentinel: "##DONE##",
          loop_until_done: true,
          max_iterations: 2,
          provider: "mock",
          system: "This session's explicit caller-supplied system prompt.",
        },
      )
      let result = agent_loop("Do the task.", nil, opts)
      let system = llm_mock_calls()[0].system
      __io_println("C.status=" + result.status)
      __io_println(
        "C.has_caller_system="
          + to_string(contains(system, "explicit caller-supplied system prompt")),
      )
      __io_println("C.has_overlay=" + to_string(contains(system, "concrete, reviewable plan")))
    },
  )
  // --- D. an explicit override reaches the wire instead of the row default ---
  with_llm_script(
    [llm_text("done ##DONE##")],
    { ->
      let opts = overlay_policy(
        default_overlay_rows(),
        "agent",
        {done_sentinel: "##DONE##", loop_until_done: true, max_iterations: 2, provider: "mock"},
        {overrides: {agent: ["A fully custom nudge line."]}},
      )
      let result = agent_loop("Do the task.", nil, opts)
      let system = llm_mock_calls()[0].system
      __io_println("D.status=" + result.status)
      __io_println("D.has_custom_override=" + to_string(contains(system, "A fully custom nudge line.")))
      __io_println(
        "D.row_default_absent=" + to_string(!contains(system, "Batch related read-only tool calls")),
      )
    },
  )
}
// A: overlay_policy's fragment threads through the existing
//    `context_profile.prompt_fragments` channel into the first outbound
//    system prompt — no dead builder, no one-turn lag.
// B: the "architect" mode has no row in `default_overlay_rows()`, so
//    `overlay_policy` is a true no-op — the caller's `system` text still
//    reaches the wire and no overlay content was added alongside it.
// C: the fragment channel only ADDS — the caller's explicit `system` text
//    and the overlay body are BOTH present in the same outbound request.
// D: `options.overrides` fills (and wins over) the row's slot before the
//    fragment is ever built, so only the override text reaches the wire.
