// Live registration proof for `overlay_policy` (std/agent/overlays).
//
// Run otherwise identical agent turns with and without a matching overlay row,
// then compare the provider-boundary request shape. This proves that the
// policy is live without pinning any overlay prose.
import { agent_loop } from "std/agent/loop"
import { default_overlay_rows, overlay_policy } from "std/agent/overlays"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  with_llm_script(
    harness.llm,
    [llm_text("done ##DONE##"), llm_text("done ##DONE##")],
    { ->
      const base = {
        done_sentinel: "##DONE##",
        loop_until_done: true,
        max_iterations: 2,
        provider: "mock",
      }
      const baseline = agent_loop(
        harness,
        "Do the task.",
        nil,
        overlay_policy(default_overlay_rows(), "architect", base),
      )
      const overlaid = agent_loop(
        harness,
        "Do the task.",
        nil,
        overlay_policy(default_overlay_rows(), "agent", base),
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("baseline.status=" + baseline.status)
      harness.stdio.println("overlaid.status=" + overlaid.status)
      harness.stdio.println("system.changed=" + to_string(calls[0].system != calls[1].system))
    },
  )
}
