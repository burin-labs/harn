import {
  agent_lifecycle_tools,
  agent_stop,
  list_agents,
  sub_agent_run,
  wait_agent,
} from "std/agent/workers"
import { with_llm_script } from "std/testing"

fn nested_tools(harness: Harness) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "spawn_nested",
    "Start a nested child agent.",
    {
      handler: { _args ->
        const child = sub_agent_run(
          harness,
          "Leaf checks the migration guard.",
          {
            provider: "mock",
            background: true,
            tool_format: "native",
            max_iterations: 1,
            token_budget: 20,
            session_id: "agent-stop-leaf",
            anchor: {primary: "/workspace/agent-stop-middle/leaf"},
          },
        )
        return wait_agent(harness.agent, child)
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      {
        tool_calls: [{id: "spawn_nested_1", name: "spawn_nested", arguments: {}}],
        input_tokens: 5,
        output_tokens: 6,
      },
      {text: "leaf concluded the migration guard is ready", input_tokens: 2, output_tokens: 3},
      {
        tool_calls: [
          {
            id: "park_1",
            name: "agent_await_resumption",
            arguments: {reason: "waiting for parent stop"},
          },
        ],
        input_tokens: 7,
        output_tokens: 8,
      },
    ],
    { ->
      const middle = sub_agent_run(
        harness,
        "Middle should spawn a leaf then park.",
        {
          provider: "mock",
          background: true,
          tool_format: "native",
          max_iterations: 4,
          token_budget: 50,
          tools: agent_lifecycle_tools(nested_tools(harness)),
          allowed_tools: ["spawn_nested", "agent_await_resumption"],
          session_id: "agent-stop-middle",
          anchor: {primary: "/workspace/agent-stop-middle"},
        },
      )
      const suspended = wait_agent(harness.agent, middle)
      const stopped = agent_stop(harness.agent, middle, {graceful: true, reason: "parent takeover"})
      harness.stdio.println("suspended=" + suspended.status)
      harness.stdio.println("stopped=" + stopped.status)
      harness.stdio.println("worker_status=" + stopped.worker.status)
      harness.stdio.println("handoff_type=" + stopped.handoff._type)
      harness.stdio.println("handoff_kind=" + stopped.handoff.kind)
      harness.stdio.println(
        "has_anchor=" + to_string(stopped.handoff.metadata.workspace_anchor.primary != nil),
      )
      harness.stdio.println(
        "has_budget=" + to_string(stopped.handoff.budget_remaining.tokens != nil),
      )
      harness.stdio.println("confidence=" + to_string(stopped.handoff.confidence > 0.0))
      harness.stdio.println("children=" + to_string(len(stopped.children)))
      harness.stdio.println(
        "summary_reason=" + to_string(contains(stopped.summary, "waiting for parent stop")),
      )
      harness.stdio.println(
        "nested_summary="
          + to_string(contains(stopped.children[0].handoff.reason, "leaf concluded")),
      )
      harness.stdio.println("flat_handoffs=" + to_string(len(stopped.handoffs)))
      harness.stdio.println(
        "outcome="
          + to_string(contains(stopped.handoff.metadata.outcome, "waiting for parent stop")),
      )
      let leaf_status = ""
      for agent in list_agents(harness.agent) {
        if agent.result?.session_id == "agent-stop-leaf" {
          leaf_status = agent.status
        }
      }
      harness.stdio.println("leaf_status=" + leaf_status)
      const hard = sub_agent_run(
        harness,
        "Hard cancel stays lossy.",
        {
          provider: "mock",
          background: true,
          tool_format: "native",
          max_iterations: 4,
          session_id: "agent-stop-hard",
        },
      )
      const cancelled = agent_stop(harness.agent, hard, {graceful: false})
      harness.stdio.println("hard=" + cancelled.status)
    },
  )
}
