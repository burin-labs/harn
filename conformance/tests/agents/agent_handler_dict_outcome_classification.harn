import { agent_dispatch_tool_call } from "std/agent/primitives"
import { agent_tool_handler_result } from "std/agent/tool_lifecycle"

/**
 * Preserve the seven-shape dispatch regression from harn#7884 while migrating
 * its producers to explicit outcomes. The typed envelope carries the old
 * display text unchanged. Data keys cannot substitute for the declaration.
 */
fn shapes() -> list {
  return [
    {name: "ok_false_blocked", value: {ok: false, status: "blocked", message: "apply blocked"}},
    {name: "ok_false_error", value: {ok: false, error: "boom"}},
    {name: "success_false", value: {success: false, message: "rejected"}},
    {name: "status_error", value: {status: "error", message: "nope"}},
    {name: "ok_false_categorized", value: {ok: false, error_category: "tool_error", error: "boom"}},
    {name: "is_error_true", value: {isError: true, message: "mcp shape"}},
    {name: "ok_true", value: {ok: true, message: "fine"}},
  ]
}

pipeline default(harness: Harness) {
  let tools = tool_registry()
  for shape in shapes() {
    const returned = shape.value
    tools = tool_define(
      tools,
      shape.name,
      "returns declared text and structured data",
      {
        handler: { _args ->
          agent_tool_handler_result(
            to_string(returned),
            returned,
            shape.name == "ok_true" ? "ok" : "error",
          )
        },
        parameters: {},
        annotations: {kind: "edit"},
      },
    )
  }
  tools = tool_define(
    tools,
    "raises",
    "raises instead of returning",
    {
      handler: { _args ->
        throw "boom"
      },
      parameters: {},
      annotations: {kind: "edit"},
    },
  )
  for shape in shapes() {
    const envelope = agent_dispatch_tool_call(
      harness.tools,
      {id: "call-" + shape.name, name: shape.name, arguments: {}},
      tools,
      {},
    )
    harness.stdio.println(
      shape.name + " ok=" + to_string(envelope?.ok)
        + " status="
        + to_string(envelope?.status)
        + " rendered="
        + to_string(envelope?.rendered_result),
    )
  }
  const raised = agent_dispatch_tool_call(
    harness.tools,
    {id: "call-raises", name: "raises", arguments: {}},
    tools,
    {},
  )
  harness.stdio.println(
    "raises ok=" + to_string(raised?.ok) + " status=" + to_string(raised?.status),
  )
}
