/**
 * Captain preset wired into the cheap-model conformance harness:
 * `agent_preset("release_captain", ...)` accepts a `cheap_caller` +
 * `frontier_caller`
 * + `escalate_predicate` and composes them into a `with_routing`-backed
 * `llm_caller` that defaults to the cheap caller and escalates on the
 * predicate (mirrors the cost-moat substrate from `std/llm/handlers`
 * and the `prelude_cheap_classify_then_escalate` recipe).
 *
 * Verifies:
 *   - cheap caller wins by default;
 *   - frontier caller wins when the escalation predicate fires;
 *   - the captain preset's `logging_sink` composes a `with_logging`
 *     wrapper around the routed caller that fires for every call;
 *   - the captain preset's defaults (long adaptive budget, persona
 *     iteration scope) flow through to the agent_loop result.
 */
import { agent_preset } from "std/agent/presets"

fn preset_agent(kind, prompt, options = nil) {
  const opts = agent_preset(kind, options)
  return agent_loop(prompt, opts?.system, opts)
}

pipeline default() {
  const cheap_calls = atomic(0)
  const frontier_calls = atomic(0)
  const log_records = atomic(0)
  const cheap = { _call ->
    let _ = atomic_add(cheap_calls, 1)
    return {
      ok: true,
      value: {
        text: "Cheap-tier reply. ##DONE##",
        model: "cheap-mock",
        provider: "mock",
        input_tokens: 1,
        output_tokens: 1,
      },
    }
  }
  const frontier = { _call ->
    let _ = atomic_add(frontier_calls, 1)
    return {
      ok: true,
      value: {
        text: "Frontier-tier reply. ##DONE##",
        model: "frontier-mock",
        provider: "mock",
        input_tokens: 1,
        output_tokens: 1,
      },
    }
  }
  const escalate = { call -> call?.opts?.escalate ?? false }
  const logging_sink = { _record ->
    let _ = atomic_add(log_records, 1)
  }
  // Default route: cheap caller handles the call without escalation.
  const cheap_run = preset_agent(
    "release_captain",
    "Cheap path.",
    {
      provider: "mock",
      cheap_caller: cheap,
      frontier_caller: frontier,
      escalate_predicate: escalate,
      logging_sink: logging_sink,
      done_sentinel: "##DONE##",
      max_iterations: 2,
    },
  )
  __io_println(cheap_run.status)
  __io_println(cheap_run.text)
  __io_println(atomic_get(cheap_calls))
  __io_println(atomic_get(frontier_calls))
  __io_println(atomic_get(log_records))
  // Escalated route: predicate matches via `escalate: true` in opts.
  const frontier_run = preset_agent(
    "release_captain",
    "Frontier path.",
    {
      provider: "mock",
      escalate: true,
      cheap_caller: cheap,
      frontier_caller: frontier,
      escalate_predicate: escalate,
      logging_sink: logging_sink,
      done_sentinel: "##DONE##",
      max_iterations: 2,
    },
  )
  __io_println(frontier_run.status)
  __io_println(frontier_run.text)
  __io_println(atomic_get(cheap_calls))
  __io_println(atomic_get(frontier_calls))
  __io_println(atomic_get(log_records))
}
