import { agent_loop_options } from "std/agent/options"
import { agent_preset } from "std/agent/presets"

pipeline default() {
  const audit = agent_preset("audit")
  __io_println(audit.profile)
  __io_println(audit.loop_until_done)
  __io_println(audit.iteration_budget.mode)
  __io_println(audit.iteration_budget.initial)
  __io_println(audit.iteration_budget.max)
  __io_println(audit.iteration_budget.extend_by)
  __io_println(audit.turn_policy.allow_done_sentinel)
  __io_println(audit.max_nudges)
  __io_println(audit?.thinking == nil)
  __io_println(audit.reasoning_policy)
  __io_println(audit.reasoning_scale)
  __io_println(audit.reasoning_task)
  __io_println(audit.repair_diagnostics.reserved_terminal_verify)
  __io_println(audit.repair_diagnostics.reserved_terminal_verify_iterations)
  const json_audit = agent_loop_options(
    agent_preset("audit", {provider: "mock", tools: tool_registry(), tool_format: "json"}),
  )
  __io_println(json_audit.done_sentinel)
  const native_audit = agent_loop_options(
    agent_preset("audit", {provider: "mock", tools: tool_registry(), tool_format: "native"}),
  )
  __io_println(native_audit.done_sentinel == nil)
  const summary = agent_preset("summary")
  __io_println(summary.profile)
  __io_println(summary?.tool_choice == nil)
  __io_println(summary.iteration_budget.mode)
  __io_println(summary.iteration_budget.initial)
  __io_println(summary.iteration_budget.max)
  __io_println(summary.loop_until_done)
  __io_println(summary.max_nudges)
  const repair = agent_preset(
    "repair",
    {iteration_budget: {mode: "adaptive", initial: 6, max: 20, extend_by: 3}},
  )
  __io_println(repair.iteration_budget.mode)
  __io_println(repair.iteration_budget.initial)
  __io_println(repair.iteration_budget.max)
  __io_println(repair.iteration_budget.extend_by)
  const verify = agent_preset("verify")
  __io_println(verify.profile)
  __io_println(verify.iteration_budget.mode)
  __io_println(verify.iteration_budget.max)
  __io_println(verify.done_judge)
  // String sugar: iteration_budget: "adaptive" keeps preset numeric defaults
  // but explicitly switches mode.
  const audit_adaptive_sugar = agent_preset("audit", {iteration_budget: "adaptive"})
  __io_println(audit_adaptive_sugar.iteration_budget.mode)
  __io_println(audit_adaptive_sugar.iteration_budget.initial)
  __io_println(audit_adaptive_sugar.iteration_budget.max)
  // Caller overrides preset defaults.
  const overridden = agent_preset("audit", {max_nudges: 4, loop_until_done: false})
  __io_println(overridden.max_nudges)
  __io_println(overridden.loop_until_done)
}
