import { agent_loop_options } from "std/agent/options"
import { agent_preset } from "std/agent/presets"

pipeline default(harness: Harness) {
  const audit = agent_preset(harness, "audit")
  harness.stdio.println(audit.profile)
  harness.stdio.println(audit.loop_until_done)
  harness.stdio.println(audit.iteration_budget.mode)
  harness.stdio.println(audit.iteration_budget.initial)
  harness.stdio.println(audit.iteration_budget.max)
  harness.stdio.println(audit.iteration_budget.extend_by)
  harness.stdio.println(audit.turn_policy.allow_done_sentinel)
  harness.stdio.println(audit.max_nudges)
  harness.stdio.println(audit?.thinking == nil)
  harness.stdio.println(audit.reasoning_policy)
  harness.stdio.println(audit.reasoning_scale)
  harness.stdio.println(audit.reasoning_task)
  harness.stdio.println(audit.repair_diagnostics.reserved_terminal_verify)
  harness.stdio.println(audit.repair_diagnostics.reserved_terminal_verify_iterations)
  const json_audit = agent_loop_options(
    harness,
    agent_preset(harness, "audit", {provider: "mock", tools: tool_registry(), tool_format: "json"}),
  )
  harness.stdio.println(json_audit.done_sentinel)
  const native_audit = agent_loop_options(
    harness,
    agent_preset(
      harness,
      "audit",
      {provider: "mock", tools: tool_registry(), tool_format: "native"},
    ),
  )
  harness.stdio.println(native_audit.done_sentinel == nil)
  const summary = agent_preset(harness, "summary")
  harness.stdio.println(summary.profile)
  harness.stdio.println(summary?.tool_choice == nil)
  harness.stdio.println(summary.iteration_budget.mode)
  harness.stdio.println(summary.iteration_budget.initial)
  harness.stdio.println(summary.iteration_budget.max)
  harness.stdio.println(summary.loop_until_done)
  harness.stdio.println(summary.max_nudges)
  const repair = agent_preset(
    harness,
    "repair",
    {iteration_budget: {mode: "adaptive", initial: 6, max: 20, extend_by: 3}},
  )
  harness.stdio.println(repair.iteration_budget.mode)
  harness.stdio.println(repair.iteration_budget.initial)
  harness.stdio.println(repair.iteration_budget.max)
  harness.stdio.println(repair.iteration_budget.extend_by)
  const verify = agent_preset(harness, "verify")
  harness.stdio.println(verify.profile)
  harness.stdio.println(verify.iteration_budget.mode)
  harness.stdio.println(verify.iteration_budget.max)
  harness.stdio.println(verify.turn_end_condition)
  // String sugar: iteration_budget: "adaptive" keeps preset numeric defaults
  // but explicitly switches mode.
  const audit_adaptive_sugar = agent_preset(harness, "audit", {iteration_budget: "adaptive"})
  harness.stdio.println(audit_adaptive_sugar.iteration_budget.mode)
  harness.stdio.println(audit_adaptive_sugar.iteration_budget.initial)
  harness.stdio.println(audit_adaptive_sugar.iteration_budget.max)
  // Caller overrides preset defaults.
  const overridden = agent_preset(harness, "audit", {max_nudges: 4, loop_until_done: false})
  harness.stdio.println(overridden.max_nudges)
  harness.stdio.println(overridden.loop_until_done)
}
