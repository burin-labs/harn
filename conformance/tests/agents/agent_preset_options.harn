import { agent_budget, agent_preset } from "std/agent/presets"

pipeline default() {
  let audit = agent_preset("audit")
  println(audit.profile)
  println(audit.loop_until_done)
  println(audit.iteration_budget.mode)
  println(audit.iteration_budget.initial)
  println(audit.iteration_budget.max)
  println(audit.iteration_budget.extend_by)
  println(audit.turn_policy.allow_done_sentinel)
  println(audit.max_nudges)
  println(audit?.thinking == nil)
  let summary = agent_preset("summary")
  println(summary.profile)
  println(summary?.tool_choice == nil)
  println(summary.iteration_budget.mode)
  println(summary.iteration_budget.initial)
  println(summary.iteration_budget.max)
  println(summary.loop_until_done)
  println(summary.max_nudges)
  let repair = agent_preset("repair", {iteration_budget: {mode: "adaptive", initial: 6, max: 20, extend_by: 3}})
  println(repair.iteration_budget.mode)
  println(repair.iteration_budget.initial)
  println(repair.iteration_budget.max)
  println(repair.iteration_budget.extend_by)
  let verify = agent_preset("verify")
  println(verify.profile)
  println(verify.iteration_budget.mode)
  println(verify.iteration_budget.max)
  println(verify.done_judge)
  // String sugar: iteration_budget: "adaptive" keeps preset numeric defaults
  // but explicitly switches mode.
  let audit_adaptive_sugar = agent_preset("audit", {iteration_budget: "adaptive"})
  println(audit_adaptive_sugar.iteration_budget.mode)
  println(audit_adaptive_sugar.iteration_budget.initial)
  println(audit_adaptive_sugar.iteration_budget.max)
  // Caller overrides preset defaults.
  let overridden = agent_preset("audit", {max_nudges: 4, loop_until_done: false})
  println(overridden.max_nudges)
  println(overridden.loop_until_done)
  // agent_budget standalone helper.
  let custom = agent_budget("adaptive", {initial: 2, max: 6})
  println(custom.mode)
  println(custom.initial)
  println(custom.max)
  let pass_through = agent_budget({mode: "adaptive", initial: 3, max: 9, extend_by: 2})
  println(pass_through.initial)
  println(pass_through.max)
}
