import { agent_loop } from "std/agent/loop"
import { scripted_user, simulated_user_post_turn, simulated_user_status } from "std/agent/user"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm,
    [llm_text("Which test runner should I use?"), llm_text("Done. ##DONE##")],
    { ->
      const answerer = scripted_user(harness, ["Use Vitest."])
      const result = agent_loop(
        harness,
        "Create index.test.ts with full edge coverage.",
        nil,
        {
          provider: "mock",
          loop_until_done: true,
          done_sentinel: "##DONE##",
          max_iterations: 3,
          post_turn_callback: simulated_user_post_turn(answerer),
        },
      )
      const calls = harness.llm.mock_calls()
      const status = simulated_user_status(harness, answerer)
      harness.stdio.println(result.status)
      harness.stdio.println(result.stop_reason)
      harness.stdio.println(result.llm.iterations)
      harness.stdio.println(status.state.replies)
      harness.stdio.println(contains(json_stringify(calls[1].messages), "Use Vitest."))
    },
  )
}
