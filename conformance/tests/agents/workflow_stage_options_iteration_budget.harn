import { agent_loop } from "std/agent/loop"
import { workflow_stage_agent_options } from "std/workflow/options"

fn print_budget_error(harness: Harness, options: dict, expected: string) {
  const result = try {
    agent_loop(harness, "budget validation probe", nil, options)
    "no_error"
  } catch (e) {
    to_string(e)
  }
  harness.stdio.println(contains(result, expected))
}

pipeline default(harness: Harness) {
  const opts = workflow_stage_agent_options(
    {
      mode: "agent",
      has_tools: true,
      model_policy: {
        provider: "mock",
        model: "mock-model",
        max_iterations: 40,
        iteration_budget: {mode: "adaptive", initial: 8, max: 40, extend_by: 4},
      },
      host: {default_tool_format: "native"},
    },
  )
  const budget = opts.agent_loop_options?.iteration_budget
  harness.stdio.println(type_of(budget))
  harness.stdio.println(budget?.mode)
  harness.stdio.println(budget?.initial)
  harness.stdio.println(budget?.max)
  harness.stdio.println(budget?.extend_by)
  // Keep the scalar cap visible for tooling that summarizes loop limits
  // without interpreting the structured budget.
  harness.stdio.println(opts.agent_loop_options?.max_iterations)
  const sugar = workflow_stage_agent_options(
    {
      mode: "agent",
      has_tools: true,
      model_policy: {iteration_budget: "adaptive"},
      host: {default_tool_format: "native"},
    },
  )
  harness.stdio.println(type_of(sugar.agent_loop_options?.iteration_budget))
  harness.stdio.println(sugar.agent_loop_options?.iteration_budget)
  const invalid_mode = workflow_stage_agent_options(
    {
      mode: "agent",
      has_tools: true,
      model_policy: {provider: "mock", iteration_budget: {mode: "unbounded", max: 4}},
      host: {default_tool_format: "native"},
    },
  )
  print_budget_error(harness,
    invalid_mode.agent_loop_options,
    "agent_loop: iteration_budget.mode must be \"fixed\" or \"adaptive\"",
  )
  const invalid_max = workflow_stage_agent_options(
    {
      mode: "agent",
      has_tools: true,
      model_policy: {provider: "mock", iteration_budget: {mode: "adaptive", initial: 1, max: 0}},
      host: {default_tool_format: "native"},
    },
  )
  print_budget_error(harness,
    invalid_max.agent_loop_options,
    "agent_loop: `iteration_budget.max` must be a positive integer; got 0",
  )
}
