import { agent_loop_options } from "std/agent/options"
import { agent_build_turn_system_fragments } from "std/agent/preflight"

fn contains_id(items, needle) {
  for item in items {
    if item == needle {
      return true
    }
  }
  return false
}

fn trace_by_id(traces, id) {
  for trace in traces {
    if trace.id == id {
      return trace
    }
  }
  return nil
}

pipeline test(task) {
  const root = path_join(harness.fs.temp_dir(), "harn-context-profile-" + uuid_v7())
  harness.fs.mkdir(root)
  harness.fs
    .write_text(path_join(root, "Cargo.toml"), "[package]\nname = \"demo\"\nversion = \"0.1.0\"\n")
  const opts = agent_loop_options(
    {
      provider: "mock",
      system: "Base.",
      root: root,
      context_profile_options: {include_env_credentials: false},
    },
  )
  assert(contains_id(opts.context_profile.profile_ids, "rust"), "rust profile auto-resolved")
  assert(!contains_id(opts.context_profile.profile_ids, "github"), "no github profile without remote")
  assert(
    opts.context_profile.token_delta.saved_tokens > 0,
    "single-match profile saves prompt tokens",
  )
  const fragments = agent_build_turn_system_fragments({session_id: "context-profile-resolver"}, opts, 0)
  const fragment_ids = fragments.map(fn(fragment) { return fragment.id })
  assert(contains_id(fragment_ids, "profile:rust"), "profile fragment enters agent preflight")
  const explained = prompt_explain({_system_fragments: fragments, context_profile: opts.context_profile})
  const trace = trace_by_id(explained.fragments, "profile:rust")
  assert(trace != nil, "prompt_explain traces profile fragment")
  assert(trace.included, "profile fragment is included")
  assert(contains(trace.reason, "language.rust"), "profile provenance names the matched capability")
  log("context_profile_resolver tests passed")
}
