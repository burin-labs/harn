import { agent_capture_events } from "std/agent/events"
// Live-shape / registration proof for `agent_completion_gate` (std/agent/judge).
//
// Catches dead-since-inception drift: it proves the gate bundle produced by
// `agent_completion_gate` is actually consulted by `agent_loop` at done-time (via
// the existing `verify_completion` seam), that the gate's host-fact callbacks
// receive the LIVE payload shape (session_id / task / parsed transcript), and that
// the ported veto arithmetic drives real loop control. The `facts` callback runs
// ONLY when the loop invokes the gate closure at done-time, so its recorded
// observations are direct evidence of live consultation.
//
//   A. source-writes gating — a cosmetic-only run is vetoed on every done attempt,
//      then released by the per-session veto budget (`max_vetoes`).
//   B. a source write + green verifier is honored immediately, and the callback
//      recorded the live payload shape it received.
//   C. a source write + red verifier is a STRICT veto the budget never converts.
//   D. no host-fact callbacks -> graceful judge-only degradation, surfaced via the
//      bundle's `_completion_gate.facts_available` flag (never a silent pass).
import { agent_completion_gate } from "std/agent/judge"
import { llm_text, with_llm_script } from "std/testing"

fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

fn event_field_values(events, field) {
  return join(events.map({ event -> to_string(event[field] ?? "") }), ",")
}

fn done_turns(n) {
  let turns = []
  for i in range(0, n) {
    turns = turns.push(llm_text("<user_response>attempt</user_response>\n<done>##DONE##</done>"))
  }
  return turns
}

pipeline default() {
  // --- A. cosmetic-only writes are vetoed, then released by the veto budget ---
  with_llm_script(
    done_turns(6),
    { ->
      const session = "cg-cosmetic-" + uuid()
      const calls_key = "cg-calls-" + session
      store_set(calls_key, 0)
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Implement the feature.",
          nil,
          {provider: "mock", loop_until_done: true, max_iterations: 8, max_nudges: 20, session_id: session}
            + agent_completion_gate(
            {
              facts: fn(ctx) {
                store_set(calls_key, (store_get(calls_key) ?? 0) + 1)
                return {source_write_count: 0, cosmetic_write_count: 1, requires_write: true}
              },
            },
          ),
        ) },
      )
      const decisions = events_of(captured.events, "judge_decision")
      __io_println("A.status=" + captured.result.status)
      __io_println("A.gate_calls=" + to_string(store_get(calls_key)))
      __io_println("A.reasons=" + event_field_values(decisions, "reason"))
      __io_println("A.confirms=" + event_field_values(decisions, "confirm"))
    },
  )
  // --- B. source write + green verifier: honored immediately; payload shape seen ---
  with_llm_script(
    done_turns(2),
    { ->
      const session = "cg-green-" + uuid()
      const probe = "cg-probe-" + session
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Implement the feature.",
          nil,
          {provider: "mock", loop_until_done: true, max_iterations: 4, max_nudges: 20, session_id: session}
            + agent_completion_gate(
            {
              facts: fn(ctx) {
                store_set(probe + ".session_matches", ctx.session_id == session)
                store_set(probe + ".has_task", ctx.task != "")
                store_set(probe + ".messages_is_list", type_of(ctx.messages) == "list")
                return {source_write_count: 1, verify: {ok: true}}
              },
            },
          ),
        ) },
      )
      const decisions = events_of(captured.events, "judge_decision")
      __io_println("B.status=" + captured.result.status)
      __io_println("B.session_matches=" + to_string(store_get(probe + ".session_matches")))
      __io_println("B.has_task=" + to_string(store_get(probe + ".has_task")))
      __io_println("B.messages_is_list=" + to_string(store_get(probe + ".messages_is_list")))
      __io_println("B.reasons=" + event_field_values(decisions, "reason"))
      __io_println("B.confirms=" + event_field_values(decisions, "confirm"))
    },
  )
  // --- C. source write + red verifier: strict veto the budget never converts ---
  with_llm_script(
    done_turns(4),
    { ->
      const session = "cg-red-" + uuid()
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Implement the feature.",
          nil,
          {provider: "mock", loop_until_done: true, max_iterations: 3, max_nudges: 20, session_id: session}
            + agent_completion_gate(
            {
              max_vetoes: 1,
              facts: fn(ctx) { return {source_write_count: 1, verify: {ok: false, findings: "boom"}} },
            },
          ),
        ) },
      )
      __io_println("C.status=" + captured.result.status)
      __io_println("C.is_done=" + to_string(captured.result.status == "done"))
      __io_println(
        "C.reasons=" + event_field_values(events_of(captured.events, "judge_decision"), "reason"),
      )
    },
  )
  // --- D. no host facts: judge-only degradation, surfaced (never a silent pass) ---
  const bundle = agent_completion_gate({})
  __io_println("D.facts_available=" + to_string(bundle._completion_gate.facts_available))
  with_llm_script(
    done_turns(2),
    { ->
      const session = "cg-degraded-" + uuid()
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Answer the question.",
          nil,
          {provider: "mock", loop_until_done: true, max_iterations: 4, max_nudges: 20, session_id: session}
            + bundle,
        ) },
      )
      __io_println("D.status=" + captured.result.status)
      __io_println(
        "D.reasons=" + event_field_values(events_of(captured.events, "judge_decision"), "reason"),
      )
      __io_println(
        "D.confirms=" + event_field_values(events_of(captured.events, "judge_decision"), "confirm"),
      )
    },
  )
}
// Consulted once per done attempt: 3 charged vetoes + 1 budget-exhausted allow.
// Strict veto is never released by the budget (max_vetoes: 1): the run does
// not reach a clean `done`.
