import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { default_llm_caller } from "std/llm/caller"
import { assert_eq, llm_text, llm_tool_call, with_llm_script } from "std/testing"

fn lookup_tools(fail_reads: bool = false, include_writers: bool = true) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "lookup",
    "Read a file.",
    {
      handler: { args ->
        if fail_reads {
          throw "read failed for " + args.path
        }
        return "contents of " + args.path
      },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  if !include_writers {
    return tools
  }
  tools = tool_define(
    tools,
    "mutate",
    "Write a file.",
    {
      handler: { args -> "wrote " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  tools = tool_define(
    tools,
    "scaffold",
    "Create a file from a template.",
    {
      handler: { args -> "created " + args.path },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  return tools
}

fn lookup_call(tool_format: string = "text", narration: string = "", path: string = "app.txt") {
  if tool_format == "native" {
    return llm_tool_call("lookup", {path: path})
  }
  if tool_format == "json" {
    return llm_text(
      narration + "```tool\n{\"name\":\"lookup\",\"args\":{\"path\":\"" + path + "\"}}\n```",
    )
  }
  return llm_text(narration + "<tool_call>lookup({ path: \"" + path + "\" })</tool_call>")
}

fn mutate_call() {
  return llm_text("<tool_call>mutate({ path: \"app.txt\" })</tool_call>")
}

fn read_loop_script(tool_format: string = "text") {
  return [
    lookup_call(tool_format, "I will inspect one more location before changing it.\n"),
    lookup_call(tool_format, "The answer may be elsewhere, so I will inspect again.\n"),
    lookup_call(tool_format, "I need one more read before I can edit.\n"),
    lookup_call(tool_format, "I should keep inspecting before committing.\n"),
    lookup_call(tool_format, "Another read should make the change clearer.\n"),
    lookup_call(tool_format, "I will inspect once more.\n"),
    llm_text("Inspection complete. ##DONE##"),
  ]
}

fn actuation_receipts(events: any) {
  return events.filter({ event -> event.type == "typed_checkpoint" }).filter(
    { event -> event.checkpoint?.schema == "harn.agent_loop_monologue_actuation.v1" },
  )
}

fn options(session: any, actuation: any = nil, tool_format: string = "text", extra: dict? = nil) {
  let stall_diagnostics = {enabled: true, no_progress_messages: 2}
  if actuation != nil {
    stall_diagnostics = stall_diagnostics + {monologue_actuation: actuation}
  }
  return {
    provider: "mock",
    model: "claude-opus-3-5",
    tools: lookup_tools(),
    tool_format: tool_format,
    loop_until_done: true,
    done_sentinel: "##DONE##",
    done_judge: nil,
    final_wrapup: false,
    max_iterations: 10,
    max_nudges: 10,
    session_id: session,
    stall_diagnostics: stall_diagnostics,
  }
    + (extra ?? {})
}

fn run_case(
  harness: Harness,
  script: any,
  session: any,
  actuation: any = nil,
  tool_format: string = "text",
  extra: dict? = nil,
) {
  return with_llm_script(
    harness.llm,
    script,
    { ->
      return agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Inspect app.txt.",
          nil,
          options(session, actuation, tool_format, extra),
        ) },
      )
        + {calls: harness.llm.mock_calls()}
    },
  )
}

fn prefill_capable_caller_options(agent: HarnessAgent, llm: HarnessLlm) {
  return {
    llm_caller: default_llm_caller(agent, llm),
    llm_caller_transport: {forwards_assistant_prefill: true},
  }
}

pipeline default(harness: Harness) {
  const off = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I still need to inspect app.txt, but I am only narrating."),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-off-" + harness.random.uuid(),
  )
  harness.stdio.println(off.result.status)
  harness.stdio.println(off.calls[2].prefill == nil)
  harness.stdio.println(len(actuation_receipts(off.events)))
  const text = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-text-" + harness.random.uuid(),
    {enabled: true},
  )
  const text_receipts = actuation_receipts(text.events)
  harness.stdio.println(text.result.status)
  harness.stdio.println(text.calls[2].prefill == "<tool_call>")
  harness.stdio.println(text.calls[3].prefill == nil)
  harness.stdio.println(text_receipts[0].checkpoint.outcome)
  const read_loop = run_case(
    harness,
    read_loop_script(),
    "monologue-actuation-read-loop-" + harness.random.uuid(),
    {enabled: true, read_only_turns: 4, write_tool: "mutate"},
  )
  const read_loop_receipt = actuation_receipts(read_loop.events)[0].checkpoint
  harness.stdio.println(read_loop.result.status)
  harness.stdio.println(read_loop.calls[3].prefill == nil)
  harness.stdio.println(read_loop.calls[4].prefill == "<tool_call>mutate({ ")
  harness.stdio.println(read_loop_receipt.trigger)
  assert_eq(read_loop_receipt.write_tool, "mutate")
  const unavailable_writer = run_case(
    harness,
    read_loop_script(),
    "monologue-actuation-unavailable-writer-" + harness.random.uuid(),
    {enabled: true, read_only_turns: 4, write_tool: "missing"},
    "text",
    {tools: lookup_tools(false, false)},
  )
  const unavailable_writer_receipt = actuation_receipts(unavailable_writer.events)[0].checkpoint
  assert_eq(unavailable_writer_receipt.outcome, "suppressed")
  assert_eq(unavailable_writer_receipt.reason, "commit_tool_unavailable")
  assert_eq(unavailable_writer_receipt.write_tool, "")
  const json_read_loop = run_case(
    harness,
    read_loop_script("json"),
    "monologue-actuation-json-read-loop-" + harness.random.uuid(),
    {enabled: true, read_only_turns: 4, write_tool: "mutate"},
    "json",
  )
  harness.stdio.println(json_read_loop.result.status)
  harness.stdio.println(
    json_read_loop.calls[4].prefill == "```tool\n{\"name\":\"mutate\",\"args\":{",
  )
  harness.stdio.println(actuation_receipts(json_read_loop.events)[0].checkpoint.trigger)
  const read_loop_reset = run_case(
    harness,
    [
      lookup_call(),
      lookup_call(),
      mutate_call(),
      lookup_call(),
      lookup_call(),
      llm_text("Work complete. ##DONE##"),
    ],
    "monologue-actuation-read-loop-reset-" + harness.random.uuid(),
    {enabled: true, read_only_turns: 4, write_tool: "mutate"},
  )
  harness.stdio.println(read_loop_reset.result.status)
  harness.stdio.println(read_loop_reset.calls.all({ call -> call.prefill == nil }))
  harness.stdio.println(len(actuation_receipts(read_loop_reset.events)))
  const failed_reads = run_case(
    harness,
    [
      lookup_call("text", "", "a"),
      lookup_call("text", "", "b"),
      lookup_call("text", "", "c"),
      lookup_call("text", "", "d"),
      lookup_call("text", "", "e"),
      llm_text("Unable to read. ##DONE##"),
    ],
    "monologue-actuation-failed-reads-" + harness.random.uuid(),
    {enabled: true, read_only_turns: 4, write_tool: "mutate"},
    "text",
    {tools: lookup_tools(true)},
  )
  harness.stdio.println(failed_reads.result.status)
  harness.stdio.println(failed_reads.calls.all({ call -> call.prefill == nil }))
  harness.stdio.println(len(actuation_receipts(failed_reads.events)))
  const veto_count = harness.runtime.atomic(0)
  const vetoed_reads = run_case(
    harness,
    [
      lookup_call("text", "", "a"),
      lookup_call("text", "", "b"),
      lookup_call("text", "", "c"),
      lookup_call("text", "", "d"),
      lookup_call("text", "", "e"),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-vetoed-reads-" + harness.random.uuid(),
    {enabled: true, read_only_turns: 4, write_tool: "mutate"},
    "text",
    {
      structural_validator: { envelope, next ->
        const base = next(envelope)
        const count = harness.runtime.atomic_add(veto_count, 1)
        if count < 4 {
          return base
            + {
              result: {
                configured: true,
                vetoed: true,
                on_failure: "regenerate_with_feedback",
                feedback: "retry the read",
                rule: "fixture_veto",
              },
            }
        }
        return base
      },
    },
  )
  harness.stdio.println(vetoed_reads.result.status)
  harness.stdio.println(vetoed_reads.calls.all({ call -> call.prefill == nil }))
  harness.stdio.println(len(actuation_receipts(vetoed_reads.events)))
  const json = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call("json"),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-json-" + harness.random.uuid(),
    {enabled: true},
    "json",
  )
  harness.stdio.println(json.result.status)
  harness.stdio.println(json.calls[2].prefill == "```tool\n")
  harness.stdio.println(actuation_receipts(json.events)[0].checkpoint.tool_format)
  const native = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call("native"),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-native-" + harness.random.uuid(),
    {enabled: true},
    "native",
  )
  const native_receipt = actuation_receipts(native.events)[0].checkpoint
  harness.stdio.println(native.result.status)
  harness.stdio.println(native.calls[2].prefill == nil)
  harness.stdio.println(native_receipt.outcome)
  harness.stdio.println(native_receipt.reason)
  const parse_error = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("<tool_call>lookup({ path:"),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-parse-error-" + harness.random.uuid(),
    {enabled: true},
  )
  harness.stdio.println(parse_error.result.status)
  harness.stdio.println(parse_error.calls[2].prefill == nil)
  harness.stdio.println(len(actuation_receipts(parse_error.events)))
  const compatible_text = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-compatible-text-" + harness.random.uuid(),
    {enabled: true},
    "text",
    prefill_capable_caller_options(harness.agent, harness.llm),
  )
  const compatible_text_receipts = actuation_receipts(compatible_text.events)
  assert_eq(compatible_text.result.status, "done")
  assert_eq(compatible_text.calls[2].prefill, "<tool_call>")
  assert_eq(len(compatible_text_receipts), 1)
  assert_eq(compatible_text_receipts[0].checkpoint.outcome, "applied")
  const compatible_json = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call("json"),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-compatible-json-" + harness.random.uuid(),
    {enabled: true},
    "json",
    prefill_capable_caller_options(harness.agent, harness.llm),
  )
  const compatible_json_receipts = actuation_receipts(compatible_json.events)
  assert_eq(compatible_json.result.status, "done")
  assert_eq(compatible_json.calls[2].prefill, "```tool\n")
  assert_eq(len(compatible_json_receipts), 1)
  assert_eq(compatible_json_receipts[0].checkpoint.outcome, "applied")
  const external_caller = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-external-caller-" + harness.random.uuid(),
    {enabled: true},
    "text",
    {llm_caller: default_llm_caller(harness.agent, harness.llm)},
  )
  const external_caller_receipts = actuation_receipts(external_caller.events)
  assert_eq(external_caller.result.status, "done")
  assert_eq(external_caller.calls[2].prefill, nil)
  assert_eq(len(external_caller_receipts), 1)
  assert_eq(external_caller_receipts[0].checkpoint.outcome, "suppressed")
  assert_eq(external_caller_receipts[0].checkpoint.reason, "external_llm_caller_unsupported")
  const explicit_failover = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-explicit-failover-" + harness.random.uuid(),
    {enabled: true},
    "text",
    {equivalent_failover: {max_routes: 2, on_no_dispatch: true}},
  )
  harness.stdio.println(explicit_failover.result.status)
  harness.stdio.println(explicit_failover.calls[2].prefill == nil)
  harness.stdio.println(actuation_receipts(explicit_failover.events)[0].checkpoint.reason)
  const bounded = run_case(
    harness,
    [
      llm_text("I should inspect app.txt before editing."),
      llm_text("I should inspect APP txt before editing!"),
      lookup_call(),
      llm_text("I should inspect app.txt again."),
      llm_text("I should inspect APP txt again!"),
      lookup_call(),
      llm_text("Inspection complete. ##DONE##"),
    ],
    "monologue-actuation-bounded-" + harness.random.uuid(),
    {enabled: true, max_firings: 1},
  )
  const bounded_receipts = actuation_receipts(bounded.events)
  harness.stdio.println(bounded.result.status)
  harness.stdio.println(bounded.calls[2].prefill == "<tool_call>")
  harness.stdio.println(bounded.calls[5].prefill == nil)
  harness.stdio.println(len(bounded_receipts))
  harness.stdio.println(bounded_receipts[1].checkpoint.reason)
}
