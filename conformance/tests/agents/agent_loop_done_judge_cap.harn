import { agent_loop } from "std/agent/loop"
/* Verifies the top-level `done_judge.max_invocations` terminal cap:
   - `done_judge.cadence.max_invocations` remains a cadence gate; this fixture
     covers the separate top-level veto-loop cap.
   - when the judge repeatedly vetoes, the loop stops with status
     `verify_capped` and stop_reason `done_judge_cap_reached`.
   - the run record carries structured `done_judge` counters.
   - `max_invocations: 0` disables the terminal cap and leaves the existing
     `max_verify_attempts` exhaustion behavior in charge. */
import { agent_capture_events } from "std/agent/events"
import { llm_text, with_llm_script } from "std/testing"

fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

fn run_capped(harness: Harness) {
  with_llm_script(
    harness.llm, [
      llm_text("Round one. ##DONE##"),
      llm_text(
        "{\"verdict\":\"continue\",\"reasoning\":\"veto one\",\"next_step\":\"keep going\"}",
      ),
      llm_text("Round two. ##DONE##"),
      llm_text(
        "{\"verdict\":\"continue\",\"reasoning\":\"veto two\",\"next_step\":\"keep going\"}",
      ),
      llm_text("Round three. ##DONE##"),
    ],
    { ->
      const session_id = "done-judge-cap-" + harness.random.uuid()
      const captured = agent_capture_events(harness, session_id,
        fn() { return agent_loop(harness, "Done judge keeps vetoing.",
          nil,
          {
            provider: "mock",
            loop_until_done: true,
            max_iterations: 10,
            max_nudges: 10,
            session_id: session_id,
            done_sentinel: "##DONE##",
            done_judge: {max_invocations: 2},
          },
        ) },
      )
      const result = captured.result
      harness.stdio.println("capped.status=${result.status}")
      harness.stdio.println("capped.stop_reason=${result.stop_reason}")
      harness.stdio.println("capped.invocations=${result.done_judge.invocations}")
      harness.stdio.println("capped.vetoes=${result.done_judge.vetoes}")
      harness.stdio.println("capped.max_invocations=${result.done_judge.max_invocations}")
      harness.stdio.println("capped.cap_reached=${result.done_judge.cap_reached}")
      harness.stdio.println("capped.judge_decisions=${len(events_of(captured.events, "judge_decision"))}")
      harness.stdio.println("capped.calls=${len(harness.llm.mock_calls())}")
    },
  )
}

fn run_approved(harness: Harness) {
  with_llm_script(
    harness.llm, [
      llm_text("Final answer. ##DONE##"),
      llm_text("{\"verdict\":\"done\",\"reasoning\":\"looks complete\"}"),
    ],
    { ->
      const session_id = "done-judge-approve-" + harness.random.uuid()
      const result = agent_loop(harness, "Done judge approves on the first proposal.",
        nil,
        {
          provider: "mock",
          loop_until_done: true,
          max_iterations: 10,
          max_nudges: 10,
          session_id: session_id,
          done_sentinel: "##DONE##",
          done_judge: {max_invocations: 2},
        },
      )
      harness.stdio.println("approved.status=${result.status}")
      harness.stdio.println("approved.invocations=${result.done_judge.invocations}")
      harness.stdio.println("approved.vetoes=${result.done_judge.vetoes}")
      harness.stdio.println("approved.max_invocations=${result.done_judge.max_invocations}")
      harness.stdio.println("approved.cap_reached=${result.done_judge.cap_reached}")
      harness.stdio.println("approved.calls=${len(harness.llm.mock_calls())}")
    },
  )
}

fn run_cap_disabled(harness: Harness) {
  with_llm_script(
    harness.llm, [
      llm_text("Try one. ##DONE##"),
      llm_text("{\"verdict\":\"continue\",\"reasoning\":\"veto one\"}"),
      llm_text("Try two. ##DONE##"),
      llm_text("{\"verdict\":\"continue\",\"reasoning\":\"veto two\"}"),
      llm_text("Try three. ##DONE##"),
    ],
    { ->
      const session_id = "done-judge-disabled-" + harness.random.uuid()
      const captured = agent_capture_events(harness, session_id,
        fn() { return agent_loop(harness, "Cap disabled; rely on max_verify_attempts.",
          nil,
          {
            provider: "mock",
            loop_until_done: true,
            max_iterations: 10,
            max_nudges: 10,
            session_id: session_id,
            done_sentinel: "##DONE##",
            max_verify_attempts: 2,
            done_judge: {max_invocations: 0},
          },
        ) },
      )
      const result = captured.result
      harness.stdio.println("disabled.status=${result.status}")
      harness.stdio.println("disabled.stop_reason=${result.stop_reason}")
      harness.stdio.println("disabled.invocations=${result.done_judge.invocations}")
      harness.stdio.println("disabled.cap_reached=${result.done_judge.cap_reached}")
      harness.stdio.println("disabled.judge_decisions=${len(events_of(captured.events, "judge_decision"))}")
    },
  )
}

pipeline default(harness: Harness) {
  run_capped(harness)
  run_approved(harness)
  run_cap_disabled(harness)
}
