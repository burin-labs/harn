pipeline default() {
  const failing = workflow_graph(
    {
      entry: "verify",
      nodes: {
        verify: {
          kind: "verify",
          retry_policy: {max_attempts: 5, backoff_ms: 1},
          verify: {command: "echo nope && exit 7", expect_status: 0},
          output_contract: {output_kinds: ["verification_result"]},
        },
      },
      edges: [],
    },
  )
  const failed = workflow_execute("verify once", failing, [], {max_steps: 1})
  __io_println(failed.run.stages[0].status)
  __io_println(failed.run.stages[0].outcome)
  __io_println(failed.run.stages[0].branch)
  __io_println(len(failed.run.stages[0].attempts))
  __io_println(len(failed.run.stages[0].artifacts))
  __io_println(contains(failed.run.stages[0].visible_text, "nope"))
  const verify_ok = failed.run.stages[0].verification?.ok ?? false
  __io_println(!verify_ok)
  const passing = workflow_graph(
    {
      entry: "verify",
      nodes: {
        verify: {
          kind: "verify",
          retry_policy: {max_attempts: 3},
          verify: {command: "echo ok", expect_status: 0},
          output_contract: {output_kinds: ["verification_result"]},
        },
      },
      edges: [],
    },
  )
  const passed = workflow_execute("verify once", passing, [], {max_steps: 1})
  __io_println(passed.run.stages[0].status)
  __io_println(len(passed.run.stages[0].attempts))
}
