import { workflow_execute } from "std/workflow/execute"
pipeline default(harness: Harness) {
  const failing = workflow_graph(
    {
      entry: "verify",
      nodes: {
        verify: {
          kind: "verify",
          retry_policy: {max_attempts: 5, backoff_ms: 1},
          verify: {command: "echo nope && exit 7", expect_status: 0},
          output_contract: {output_kinds: ["verification_result"]},
        },
      },
      edges: [],
    },
  )
  const failed = workflow_execute(harness, "verify once", failing, [], {max_steps: 1})
  harness.stdio.println(failed.run.stages[0].status)
  harness.stdio.println(failed.run.stages[0].outcome)
  harness.stdio.println(failed.run.stages[0].branch)
  harness.stdio.println(len(failed.run.stages[0].attempts))
  harness.stdio.println(len(failed.run.stages[0].artifacts))
  harness.stdio.println(contains(failed.run.stages[0].visible_text, "nope"))
  const verify_ok = failed.run.stages[0].verification?.ok ?? false
  harness.stdio.println(!verify_ok)
  const passing = workflow_graph(
    {
      entry: "verify",
      nodes: {
        verify: {
          kind: "verify",
          retry_policy: {max_attempts: 3},
          verify: {command: "echo ok", expect_status: 0},
          output_contract: {output_kinds: ["verification_result"]},
        },
      },
      edges: [],
    },
  )
  const passed = workflow_execute(harness, "verify once", passing, [], {max_steps: 1})
  harness.stdio.println(passed.run.stages[0].status)
  harness.stdio.println(len(passed.run.stages[0].attempts))
}
