import { scripted_user, simulated_user_respond, simulated_user_status } from "std/agent/user"

pipeline main() {
  let answerer = scripted_user(["First answer."], {max_replies: 1})
  let first = simulated_user_respond(answerer, {question: "One?"})
  let second = simulated_user_respond(answerer, {question: "Two?"})
  let status = simulated_user_status(answerer)
  println(first.action)
  println(first.message)
  println(second.action)
  println(second.reason)
  println(status.state.replies)
  println(status.state.stopped)
}
