import { scripted_user, simulated_user_respond, simulated_user_status } from "std/agent/user"

pipeline main() {
  const answerer = scripted_user(["First answer."], {max_replies: 1})
  const first = simulated_user_respond(answerer, {question: "One?"})
  const second = simulated_user_respond(answerer, {question: "Two?"})
  const status = simulated_user_status(answerer)
  __io_println(first.action)
  __io_println(first.message)
  __io_println(second.action)
  __io_println(second.reason)
  __io_println(status.state.replies)
  __io_println(status.state.stopped)
}
