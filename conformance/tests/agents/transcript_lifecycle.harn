pipeline main(harness: Harness) {
  const base = transcript()
  const next = add_user(base, "hello")
  const archived = transcript_archive(next)
  const resumed = transcript_resume(archived)
  const abandoned = transcript_abandon(resumed)
  const reset = transcript_reset({metadata: {source: "test"}})
  harness.stdio.println(contains(transcript_render_full(archived), "transcript archived"))
  harness.stdio.println(contains(transcript_render_full(resumed), "transcript resumed"))
  harness.stdio.println(contains(transcript_render_full(abandoned), "transcript abandoned"))
  harness.stdio.println(transcript_messages(reset) == [])
}
