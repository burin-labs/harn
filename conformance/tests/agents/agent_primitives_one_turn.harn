import { with_llm_script } from "std/testing"

fn calculator_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "add",
    "Add two integers",
    {
      handler: { args -> args.left + args.right },
      parameters: {
        left: {type: "integer", description: "Left operand"},
        right: {type: "integer", description: "Right operand"},
      },
      returns: {type: "integer"},
      annotations: {kind: "read"},
    },
  )
  tools = tool_define(
    tools,
    "explode",
    "Throw from a Harn-side handler",
    {
      handler: { _args ->
        throw "boom"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

pipeline main() {
  const tools = calculator_tools()
  with_llm_script(
    [
      {text: "<tool_call>\nadd({ left: 2, right: 3 })\n</tool_call>"},
      {text: "", tool_calls: [{id: "native_add", name: "add", arguments: {left: 4, right: 6}}]},
    ],
    { ->
      const turn = agent_llm_turn("Calculate 2 + 3", nil, {provider: "mock", tools: tools})
      const parsed = agent_parse_tool_calls(turn.raw_text, tools)
      const dispatched = agent_dispatch_tool_call(parsed.tool_calls[0], tools)
      const batch = agent_dispatch_tool_batch(parsed.tool_calls, tools)
      const malformed_text = agent_parse_tool_calls("<tool_call>\nadd({ left: })\n</tool_call>", tools)
      const schema_error = agent_dispatch_tool_call({name: "add", arguments: {left: 2}}, tools)
      const handler_error = agent_dispatch_tool_call({name: "explode", arguments: {}}, tools)
      const native_turn = agent_llm_turn("Calculate 4 + 6", nil, {provider: "mock", tools: tools})
      const native_batch = agent_dispatch_tool_batch(native_turn.tool_calls, tools)
      __io_println(parsed.tool_calls[0].name)
      __io_println(dispatched.ok)
      __io_println(dispatched.rendered_result)
      __io_println(len(batch))
      __io_println(batch[0].rendered_result)
      __io_println(len(malformed_text.tool_parse_errors) > 0)
      __io_println(schema_error.ok)
      __io_println(schema_error.error_category)
      __io_println(handler_error.ok)
      __io_println(contains(handler_error.error, "boom"))
      __io_println(native_turn.tool_calls[0].name)
      __io_println(native_batch[0].rendered_result)
    },
  )
}
