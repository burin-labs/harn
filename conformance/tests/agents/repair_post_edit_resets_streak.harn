import { agent_capture_events } from "std/agent/events"
import "std/collections"
import { llm_text, with_llm_script } from "std/testing"

/**
 * Evidence-aware repair loop (#repair-diagnostics): FALSE-POSITIVE SAFETY PROOF.
 *
 * The failure SIGNATURE is the progress signal. A productive edit changes the
 * error, so the next failure carries a DIFFERENT signature and the
 * same-diagnostic streak resets — legitimate progress is never flagged as
 * thrash. An edit that does NOT change the error (same signature) is real
 * thrash, covered by `repair_edit_retest_thrash_trips`.
 *
 * Sequence: fail(sigA), edit, fail(sigB-different), edit, fail(sigC-different).
 * Each `run_test` reports a distinct error (modeling a productive edit moving
 * the failure forward). With `stuck_same_diagnostic_after: 2` a blind counter
 * would trip; the signature-keyed model keeps the streak at 1 each time the
 * error changes and fires zero repair warnings.
 */
fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

fn repair_tools() {
  let tools = tool_registry()
  // The error echoes a per-call `tag`, so successive runs carry DIFFERENT
  // failure signatures without relying on mutable closure state.
  tools = tool_define(
    tools,
    "run_test",
    "Run the test suite",
    {
      handler: { args ->
        throw "AssertionError: failure " + to_string(args?.tag ?? "x")
      },
      parameters: {tag: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  tools = tool_define(
    tools,
    "apply_fix",
    "Apply a corrective edit",
    {
      handler: { _args -> "edit applied" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  return tools
}

fn run_test_call(id, tag) {
  return {text: "", tool_calls: [{id: id, name: "run_test", arguments: {tag: tag}}]}
}

fn apply_fix_call(id) {
  return {text: "", tool_calls: [{id: id, name: "apply_fix", arguments: {}}]}
}

pipeline default() {
  with_llm_script(
    [
      run_test_call("r1", "A"),
      apply_fix_call("e1"),
      run_test_call("r2", "B"),
      apply_fix_call("e2"),
      run_test_call("r3", "C"),
      apply_fix_call("e3"),
      run_test_call("r4", "D"),
      llm_text("Stopping. ##DONE##"),
    ],
    { ->
      const session = "repair-reset-streak-" + uuid()
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop(
          "Make the failing test pass.",
          nil,
          {
            provider: "mock",
            tools: repair_tools(),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 10,
            session_id: session,
            done_sentinel: "##DONE##",
            // verify_completion absent so the post-edit re-verify mandate has no
            // closure to fire — this test isolates the streak-reset property.
            stall_diagnostics: {
              enabled: true,
              repair_aware: true,
              stuck_same_diagnostic_after: 2,
              inject_feedback: true,
              max_feedback: 3,
            },
          },
        ) },
      )
      const stalls = events_of(captured.events, "agent_loop_stall_warning")
      __io_println(count_where(stalls, { s -> s.warning.pattern == "stuck_same_diagnostic" }))
      __io_println(len(stalls))
      __io_println(captured.result.status)
    },
  )
}
