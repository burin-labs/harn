/**
 * Effect-phased tool batches: one inference response may fan out independent
 * calls inside its first structural effect phase, but later phases must return
 * to inference before they can run.
 */
import {
  agent_capture_events,
  agent_event_report,
  agent_tool_batch_disposition_event_schema,
} from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { with_llm_script } from "std/testing"

fn reset_counts(runtime: HarnessRuntime, counters) {
  runtime.atomic_set(counters.read, 0)
  runtime.atomic_set(counters.edit, 0)
  runtime.atomic_set(counters.delete, 0)
  runtime.atomic_set(counters.search, 0)
  runtime.atomic_set(counters.verify, 0)
  runtime.atomic_set(counters.run, 0)
  runtime.atomic_set(counters.done, 0)
}

fn run_tools(runtime: HarnessRuntime, counters) {
  let tools = phase_tools(runtime, counters)
  return tool_define(
    tools,
    "run",
    "Run a workspace command.",
    {
      handler: { args ->
        runtime.atomic_add(counters.run, 1)
        return "ran " + to_string(args?.command ?? "")
      },
      parameters: {command: {type: "string"}},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
    },
  )
}

fn run_call(command: string, id = "run") {
  return {id: id, name: "run", arguments: {command: command}}
}

fn phase_tools(runtime: HarnessRuntime, counters) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "read_state",
    "Observe current state.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.read, 1)
        return "observed"
      },
      parameters: {},
      annotations: {kind: "read", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "edit_state",
    "Apply one atomic edit operation.",
    {
      handler: { args ->
        runtime.atomic_add(counters.edit, 1)
        if args?.fail ?? false {
          throw "mutation rejected"
        }
        return "edited " + to_string(len(args?.operations ?? [])) + " operation(s)"
      },
      parameters: {
        path: {type: "string"},
        operations: {type: "array"},
        fail: {type: "boolean", required: false},
      },
      annotations: {
        kind: "edit",
        side_effect_level: "workspace_write",
        arg_schema: {path_params: ["path"]},
      },
    },
  )
  tools = tool_define(
    tools,
    "delete_state",
    "Delete one resource.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.delete, 1)
        return "deleted"
      },
      parameters: {},
      annotations: {kind: "delete", side_effect_level: "workspace_write"},
    },
  )
  tools = tool_define(
    tools,
    "search_state",
    "Observe the post-mutation state.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.search, 1)
        return "searched"
      },
      parameters: {},
      annotations: {kind: "search", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "verify_state",
    "Verify the resulting state.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.verify, 1)
        return "verified"
      },
      parameters: {},
      annotations: {kind: "verify", side_effect_level: "process_exec"},
    },
  )
  return tool_define(
    tools,
    "done",
    "Certify terminal completion.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.done, 1)
        return "done"
      },
      parameters: {},
      annotations: {kind: "terminal", side_effect_level: "none"},
    },
  )
}

fn read_call(id = "read") {
  return {id: id, name: "read_state", arguments: {}}
}

fn edit_call(fail = false, id = "edit") {
  return {
    id: id,
    name: "edit_state",
    arguments: {
      path: "src/app.harn",
      operations: [
        {kind: "replace", old: "before", new: "after"},
        {kind: "insert", after: "anchor", text: "tail"},
      ],
      fail: fail,
    },
  }
}

fn delete_call(id = "delete") {
  return {id: id, name: "delete_state", arguments: {}}
}

fn search_call(id = "search") {
  return {id: id, name: "search_state", arguments: {}}
}

fn verify_call(id = "verify") {
  return {id: id, name: "verify_state", arguments: {}}
}

fn done_call(id = "done") {
  return {id: id, name: "done", arguments: {}}
}

fn receipt_counts(events) {
  let executed = 0
  let deferred = 0
  let skipped = 0
  let skipped_blockers = []
  let executed_mutations = []
  let reproposed = 0
  let reproposed_ids = []
  let total = 0
  for event in events {
    if event?.type != "tool_batch_disposition" {
      continue
    }
    const schema_report = agent_event_report(event, agent_tool_batch_disposition_event_schema())
    require schema_report.ok,
      "tool batch disposition events must satisfy their public schema: "
      + json_stringify({event: event, report: schema_report})
    total = total + 1
    const receipt = event.receipt
    if receipt.disposition == "executed" {
      executed = executed + 1
      if receipt.tool_name == "edit_state" {
        executed_mutations = executed_mutations.appending(receipt.tool_call_id)
      }
    } else if receipt.disposition == "deferred" {
      deferred = deferred + 1
    } else if receipt.disposition == "skipped_after_blocking_result" {
      skipped = skipped + 1
      skipped_blockers = skipped_blockers.appending(receipt.blocking_tool_call_id)
    }
    if receipt.proposal_status == "re_proposed" {
      reproposed = reproposed + 1
      reproposed_ids = reproposed_ids.appending(receipt.tool_call_id)
    }
    require receipt.planned_at_ms >= 0, "every call needs planning timing"
    if receipt.disposition == "executed" {
      require receipt.started_at_ms != nil, "executed calls need start timing"
      require receipt.finished_at_ms != nil, "executed calls need finish timing"
      require receipt.duration_ms >= 0, "executed calls need a nonnegative duration"
    } else {
      require receipt.started_at_ms == nil, "unlaunched calls must not claim a start time"
      require receipt.finished_at_ms == nil, "unlaunched calls must not claim a finish time"
      require receipt.duration_ms == nil, "unlaunched calls must not claim a duration"
    }
  }
  return {
    total: total,
    executed: executed,
    deferred: deferred,
    skipped: skipped,
    skipped_blockers: skipped_blockers,
    executed_mutations: executed_mutations,
    reproposed: reproposed,
    reproposed_ids: reproposed_ids,
  }
}

fn run_phased(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            text: "##DONE##",
            tool_calls: [
              read_call("read-1"),
              edit_call(false, "edit-1"),
              delete_call("delete-1"),
              search_call("search-1"),
              verify_call("verify-1"),
              done_call("done-1"),
            ],
          },
          {text: "##DONE##"},
          {
            tool_calls: [
              edit_call(false, "edit-2"),
              delete_call("delete-2"),
              search_call("search-2"),
              verify_call("verify-2"),
              done_call("done-2"),
            ],
          },
          {tool_calls: [search_call("search-3"), verify_call("verify-3"), done_call("done-3")]},
          {tool_calls: [verify_call("verify-4"), done_call("done-4")]},
          {tool_calls: [done_call("done-5")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 7,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(harness, "Observe, mutate, re-observe, verify, then finish.", nil, opts)
        },
      )
    },
  )
  return {
    result: captured.result,
    events: captured.events,
    receipts: receipt_counts(captured.events),
  }
}

fn run_blocked_then_consumed(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-blocked-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              edit_call(true, "blocked-edit-1"),
              verify_call("blocked-verify-1"),
              done_call("blocked-done-1"),
            ],
          },
          {tool_calls: [verify_call("blocked-verify-2"), done_call("blocked-done-2")]},
          {tool_calls: [verify_call("recovery-verify-3"), done_call("recovery-done-3")]},
          {tool_calls: [done_call("recovery-done-4")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 6,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(
            harness,
            "Recover from a rejected mutation before verifying.",
            nil,
            opts,
          )
        },
      )
    },
  )
  return {
    result: captured.result,
    events: captured.events,
    receipts: receipt_counts(captured.events),
  }
}

fn run_partitioned_reads(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-partition-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              verify_call("lead-verify"),
              read_call("middle-read"),
              read_call("tail-read"),
              search_call("tail-search"),
              done_call("partition-done"),
            ],
          },
          {tool_calls: [verify_call("reproposed-verify"), done_call("later-done")]},
          {tool_calls: [done_call("final-done")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 5,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(harness, "Keep independent reads after a later-phase call.", nil, opts)
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

fn run_read_effect_status(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-status-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              read_call("status-read"),
              run_call("git status --short --branch", "status-run"),
              search_call("status-search"),
              done_call("status-done"),
            ],
          },
          {tool_calls: [done_call("status-done-2")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: run_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 4,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(harness, "Batch a read-only status probe with observations.", nil, opts)
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

fn run_durable_reproposal(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-durable-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              read_call("quiet-read-1"),
              run_call("echo hi > scratch.txt", "write-run-1"),
            ],
          },
          {tool_calls: [read_call("quiet-read-2")]},
          {
            tool_calls: [
              run_call("echo hi > scratch.txt", "write-run-2"),
              done_call("durable-done"),
            ],
          },
          {tool_calls: [done_call("durable-done-2")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: run_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 6,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(
            harness,
            "Remember a deferred write across a quiet observation turn.",
            nil,
            opts,
          )
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

fn run_rearmed_barrier(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-rearmed-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {tool_calls: [edit_call(true, "first-edit"), verify_call("first-verify-1")]},
          {tool_calls: [verify_call("first-verify-2")]},
          {tool_calls: [edit_call(true, "second-edit"), verify_call("second-verify-1")]},
          {tool_calls: [verify_call("second-verify-2")]},
          {tool_calls: [verify_call("recovered-verify"), done_call("recovered-done-1")]},
          {tool_calls: [done_call("recovered-done-2")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 7,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(
            harness,
            "Recover after two independently rejected mutations.",
            nil,
            opts,
          )
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}
pipeline main(harness: Harness) {
  const counters = {
    read: harness.runtime.atomic(0),
    edit: harness.runtime.atomic(0),
    delete: harness.runtime.atomic(0),
    search: harness.runtime.atomic(0),
    verify: harness.runtime.atomic(0),
    run: harness.runtime.atomic(0),
    done: harness.runtime.atomic(0),
  }
  const partitioned = run_partitioned_reads(harness, counters)
  require partitioned.result.status == "done", "partitioned reads should finish"
  require harness.runtime.atomic_get(counters.read) == 2,
    "both observation calls must execute even when a later phase was emitted first"
  require harness.runtime.atomic_get(counters.search) == 1, "the trailing search must also execute"
  require harness.runtime.atomic_get(counters.verify) == 1,
    "verification waits for its own phase regardless of emission order"
}
