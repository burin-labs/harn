/**
 * Effect-phased tool batches: one inference response may fan out independent
 * calls inside its first structural effect phase, but later phases must return
 * to inference before they can run.
 */
import {
  agent_capture_events,
  agent_event_report,
  agent_tool_batch_disposition_event_schema,
} from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { with_audit_log } from "std/llm/tool_middleware"
import { with_llm_script } from "std/testing"

fn reset_counts(runtime: HarnessRuntime, counters) {
  runtime.atomic_set(counters.read, 0)
  runtime.atomic_set(counters.edit, 0)
  runtime.atomic_set(counters.delete, 0)
  runtime.atomic_set(counters.search, 0)
  runtime.atomic_set(counters.verify, 0)
  runtime.atomic_set(counters.run, 0)
  runtime.atomic_set(counters.done, 0)
}

fn run_tools(runtime: HarnessRuntime, counters) {
  let tools = phase_tools(runtime, counters)
  return tool_define(
    tools,
    "run",
    "Run a workspace command.",
    {
      handler: { args ->
        runtime.atomic_add(counters.run, 1)
        return "ran " + to_string(args?.command ?? "")
      },
      parameters: {command: {type: "string"}},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
    },
  )
}

fn run_call(command: string, id = "run") {
  return {id: id, name: "run", arguments: {command: command}}
}

fn phase_tools(runtime: HarnessRuntime, counters) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "read_state",
    "Observe current state.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.read, 1)
        return "observed"
      },
      parameters: {},
      annotations: {kind: "read", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "edit_state",
    "Apply one atomic edit operation.",
    {
      handler: { args ->
        runtime.atomic_add(counters.edit, 1)
        if args?.fail ?? false {
          throw "mutation rejected"
        }
        return "edited " + to_string(len(args?.operations ?? [])) + " operation(s)"
      },
      parameters: {
        path: {type: "string"},
        operations: {type: "array"},
        fail: {type: "boolean", required: false},
      },
      annotations: {
        kind: "edit",
        side_effect_level: "workspace_write",
        arg_schema: {path_params: ["path"]},
      },
    },
  )
  tools = tool_define(
    tools,
    "delete_state",
    "Delete one resource.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.delete, 1)
        return "deleted"
      },
      parameters: {},
      annotations: {kind: "delete", side_effect_level: "workspace_write"},
    },
  )
  tools = tool_define(
    tools,
    "search_state",
    "Observe the post-mutation state.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.search, 1)
        return "searched"
      },
      parameters: {},
      annotations: {kind: "search", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "verify_state",
    "Verify the resulting state.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.verify, 1)
        return "verified"
      },
      parameters: {},
      annotations: {kind: "verify", side_effect_level: "process_exec"},
    },
  )
  return tool_define(
    tools,
    "done",
    "Certify terminal completion.",
    {
      handler: { _args ->
        runtime.atomic_add(counters.done, 1)
        return "done"
      },
      parameters: {},
      annotations: {kind: "terminal", side_effect_level: "none"},
    },
  )
}

fn read_call(id = "read") {
  return {id: id, name: "read_state", arguments: {}}
}

fn edit_call(fail = false, id = "edit") {
  return {
    id: id,
    name: "edit_state",
    arguments: {
      path: "src/app.harn",
      operations: [
        {kind: "replace", old: "before", new: "after"},
        {kind: "insert", after: "anchor", text: "tail"},
      ],
      fail: fail,
    },
  }
}

fn delete_call(id = "delete") {
  return {id: id, name: "delete_state", arguments: {}}
}

fn search_call(id = "search") {
  return {id: id, name: "search_state", arguments: {}}
}

fn verify_call(id = "verify") {
  return {id: id, name: "verify_state", arguments: {}}
}

fn done_call(id = "done") {
  return {id: id, name: "done", arguments: {}}
}

fn receipt_counts(events) {
  let executed = 0
  let deferred = 0
  let skipped = 0
  let skipped_blockers = []
  let executed_mutations = []
  let reproposed = 0
  let reproposed_ids = []
  let reproposed_names = []
  let audit_orders = []
  let total = 0
  for event in events {
    if event?.type == "tool_call_audit" && event?.receipt != nil {
      audit_orders = audit_orders.appending(event.receipt.emit_order)
    }
    if event?.type != "tool_batch_disposition" {
      continue
    }
    const schema_report = agent_event_report(event, agent_tool_batch_disposition_event_schema())
    require schema_report.ok,
      "tool batch disposition events must satisfy their public schema: "
      + json_stringify({event: event, report: schema_report})
    total = total + 1
    const receipt = event.receipt
    if receipt.disposition == "executed" {
      executed = executed + 1
      if receipt.tool_name == "edit_state" {
        executed_mutations = executed_mutations.appending(receipt.tool_call_id)
      }
    } else if receipt.disposition == "deferred" {
      deferred = deferred + 1
    } else if receipt.disposition == "skipped_after_blocking_result" {
      skipped = skipped + 1
      skipped_blockers = skipped_blockers.appending(receipt.blocking_tool_call_id)
    }
    if receipt.proposal_status == "re_proposed" {
      reproposed = reproposed + 1
      reproposed_ids = reproposed_ids.appending(receipt.tool_call_id)
      reproposed_names = reproposed_names.appending(receipt.tool_name)
    }
    require receipt.planned_at_ms >= 0, "every call needs planning timing"
    if receipt.disposition == "executed" {
      require receipt.started_at_ms != nil, "executed calls need start timing"
      require receipt.finished_at_ms != nil, "executed calls need finish timing"
      require receipt.duration_ms >= 0, "executed calls need a nonnegative duration"
    } else {
      require receipt.started_at_ms == nil, "unlaunched calls must not claim a start time"
      require receipt.finished_at_ms == nil, "unlaunched calls must not claim a finish time"
      require receipt.duration_ms == nil, "unlaunched calls must not claim a duration"
    }
  }
  return {
    total: total,
    executed: executed,
    deferred: deferred,
    skipped: skipped,
    skipped_blockers: skipped_blockers,
    executed_mutations: executed_mutations,
    reproposed: reproposed,
    reproposed_ids: reproposed_ids,
    reproposed_names: reproposed_names,
    audit_orders: audit_orders,
  }
}

fn run_phased(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            text: "##DONE##",
            tool_calls: [
              read_call("read-1"),
              edit_call(false, "edit-1"),
              delete_call("delete-1"),
              search_call("search-1"),
              verify_call("verify-1"),
              done_call("done-1"),
            ],
          },
          {text: "##DONE##"},
          {
            tool_calls: [
              edit_call(false, "edit-2"),
              delete_call("delete-2"),
              search_call("search-2"),
              verify_call("verify-2"),
              done_call("done-2"),
            ],
          },
          {
            tool_calls: [
              edit_call(false, "edit-3"),
              delete_call("delete-3"),
              verify_call("verify-3"),
              done_call("done-3"),
            ],
          },
          {tool_calls: [verify_call("verify-4"), done_call("done-4")]},
          {tool_calls: [done_call("done-5")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 7,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(harness, "Observe, mutate, re-observe, verify, then finish.", nil, opts)
        },
      )
    },
  )
  return {
    result: captured.result,
    events: captured.events,
    receipts: receipt_counts(captured.events),
  }
}

fn run_blocked_then_consumed(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-blocked-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              edit_call(true, "blocked-edit-1"),
              verify_call("blocked-verify-1"),
              done_call("blocked-done-1"),
            ],
          },
          {tool_calls: [verify_call("blocked-verify-2"), done_call("blocked-done-2")]},
          {tool_calls: [verify_call("recovery-verify-3"), done_call("recovery-done-3")]},
          {tool_calls: [done_call("recovery-done-4")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 6,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(
            harness,
            "Recover from a rejected mutation before verifying.",
            nil,
            opts,
          )
        },
      )
    },
  )
  return {
    result: captured.result,
    events: captured.events,
    receipts: receipt_counts(captured.events),
  }
}

fn run_partitioned_reads(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-partition-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              verify_call("lead-verify"),
              read_call("middle-read"),
              read_call("tail-read"),
              search_call("tail-search"),
              done_call("partition-done"),
            ],
          },
          {tool_calls: [verify_call("reproposed-verify"), done_call("later-done")]},
          {tool_calls: [done_call("final-done")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 5,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
            tool_caller: with_audit_log(harness.clock, harness.fs, "cloud"),
          }
          return agent_loop(harness, "Keep independent reads after a later-phase call.", nil, opts)
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

fn run_read_effect_status(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-status-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              read_call("status-read"),
              run_call("git status --short --branch", "status-run"),
              search_call("status-search"),
              done_call("status-done"),
            ],
          },
          {tool_calls: [done_call("status-done-2")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: run_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 4,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(harness, "Batch a read-only status probe with observations.", nil, opts)
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

fn run_durable_reproposal(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-durable-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              read_call("quiet-read-1"),
              run_call("echo hi > scratch.txt", "write-run-1"),
            ],
          },
          {tool_calls: [read_call("quiet-read-2")]},
          {
            tool_calls: [
              run_call("echo hi > scratch.txt", "write-run-2"),
              done_call("durable-done"),
            ],
          },
          {tool_calls: [done_call("durable-done-2")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: run_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 6,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(
            harness,
            "Remember a deferred write across a quiet observation turn.",
            nil,
            opts,
          )
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

fn run_rearmed_barrier(harness: Harness, counters) {
  reset_counts(harness.runtime, counters)
  const session = "effect-phases-rearmed-" + harness.random.uuid()
  const captured = agent_capture_events(
    harness.agent,
    session,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {tool_calls: [edit_call(true, "first-edit"), verify_call("first-verify-1")]},
          {tool_calls: [verify_call("first-verify-2")]},
          {tool_calls: [edit_call(true, "second-edit"), verify_call("second-verify-1")]},
          {tool_calls: [verify_call("second-verify-2")]},
          {tool_calls: [verify_call("recovered-verify"), done_call("recovered-done-1")]},
          {tool_calls: [done_call("recovered-done-2")]},
        ],
        { ->
          const opts: AgentSpec = {
            provider: "mock",
            tools: phase_tools(harness.runtime, counters),
            tool_format: "native",
            loop_until_done: true,
            max_iterations: 7,
            max_concurrent_tools: 4,
            stop_after_successful_tools: ["done"],
            session_id: session,
          }
          return agent_loop(
            harness,
            "Recover after two independently rejected mutations.",
            nil,
            opts,
          )
        },
      )
    },
  )
  return {result: captured.result, receipts: receipt_counts(captured.events)}
}

pipeline main(harness: Harness) {
  const counters = {
    read: harness.runtime.atomic(0),
    edit: harness.runtime.atomic(0),
    delete: harness.runtime.atomic(0),
    search: harness.runtime.atomic(0),
    verify: harness.runtime.atomic(0),
    run: harness.runtime.atomic(0),
    done: harness.runtime.atomic(0),
  }
  const phased = run_phased(harness, counters)
  require phased.result.status == "done", "the phased batch should reach terminal completion"
  require harness.runtime.atomic_get(counters.read) == 1, "the observation call must execute once"
  require harness.runtime.atomic_get(counters.edit) == 1,
    "one atomic edit call must remain one mutation"
  require harness.runtime.atomic_get(counters.delete) == 1, "the delete call must execute once"
  require harness.runtime.atomic_get(counters.search) == 2,
    "the first-phase search must execute with the leading observation, and the later search once"
  require harness.runtime.atomic_get(counters.verify) == 1, "verification must execute once"
  require harness.runtime.atomic_get(counters.done) == 1, "terminal completion must execute once"
  require phased.receipts.total == 18, "every proposed call needs a disposition receipt"
  require phased.receipts.executed == 7,
    "partition keeps later first-phase calls instead of truncating them"
  require phased.receipts.deferred == 11, "later effect phases should be deferred"
  require phased.receipts.skipped == 0, "the successful path should not skip calls"
  require phased.receipts.reproposed == 11,
    "every deferred call should be recognized on re-proposal"
  harness.stdio.println("phased.status=" + phased.result.status)
  harness.stdio.println("phased.executed=" + to_string(phased.receipts.executed))
  harness.stdio.println("phased.deferred=" + to_string(phased.receipts.deferred))
  harness.stdio.println("phased.reproposed=" + to_string(phased.receipts.reproposed))
  const blocked = run_blocked_then_consumed(harness, counters)
  require blocked.result.status == "done", "the observed barrier should be consumed once"
  require harness.runtime.atomic_get(counters.edit) == 1,
    "recovery after observing a rejection must not require a synthetic mutation"
  require harness.runtime.atomic_get(counters.verify) == 1,
    "only the first dependent verification proposal should be blocked"
  require harness.runtime.atomic_get(counters.done) == 1,
    "completion must wait for recovered verification"
  require blocked.receipts.skipped == 2, "verify and done should be skipped behind the barrier"
  const blocked_edit_id = blocked.receipts.executed_mutations[0]
  require blocked.receipts.skipped_blockers == [blocked_edit_id, blocked_edit_id],
    "the consumed receipts must preserve the exact original blocker"
  harness.stdio.println("blocked.status=" + blocked.result.status)
  harness.stdio.println("blocked.skipped=" + to_string(blocked.receipts.skipped))
  harness.stdio.println(
    "blocked.counters.verify=" + to_string(harness.runtime.atomic_get(counters.verify)),
  )
  harness.stdio.println(
    "blocked.counters.done=" + to_string(harness.runtime.atomic_get(counters.done)),
  )
  const rearmed = run_rearmed_barrier(harness, counters)
  require rearmed.result.status == "done", "a later rejected mutation should re-arm the barrier"
  require harness.runtime.atomic_get(counters.edit) == 2,
    "both independently rejected mutations should execute"
  require harness.runtime.atomic_get(counters.verify) == 1,
    "each new barrier should skip exactly one dependent verification proposal"
  require rearmed.receipts.skipped_blockers == rearmed.receipts.executed_mutations,
    "each consumed barrier must identify the mutation that armed it"
  harness.stdio.println("rearmed.status=" + rearmed.result.status)
  harness.stdio.println("rearmed.skipped=" + to_string(rearmed.receipts.skipped))
  const partitioned = run_partitioned_reads(harness, counters)
  require partitioned.result.status == "done", "partitioned reads should finish"
  require harness.runtime.atomic_get(counters.read) == 2,
    "both observation calls must execute even when a later phase was emitted first"
  require harness.runtime.atomic_get(counters.search) == 1, "the trailing search must also execute"
  require harness.runtime.atomic_get(counters.verify) == 1,
    "verification waits for its own phase regardless of emission order"
  require contains(partitioned.receipts.audit_orders, 1),
    "the selected subset must preserve the read's original model emission index: "
    + json_stringify(partitioned.receipts.audit_orders)
  require contains(partitioned.receipts.audit_orders, 2),
    "the second read must preserve its original model emission index"
  require contains(partitioned.receipts.audit_orders, 3),
    "the search must preserve its original model emission index"
  require partitioned.receipts.deferred >= 1, "the later-phase verify must still defer"
  harness.stdio.println("partitioned.status=" + partitioned.result.status)
  harness.stdio.println("partitioned.executed=" + to_string(partitioned.receipts.executed))
  const status = run_read_effect_status(harness, counters)
  require status.result.status == "done", "read-effect status probes should finish"
  require harness.runtime.atomic_get(counters.run) == 1, "git status must execute in the read batch"
  require harness.runtime.atomic_get(counters.read) == 1, "the sibling read must execute"
  require harness.runtime.atomic_get(counters.search) == 1, "the sibling search must execute"
  require status.receipts.deferred == 1, "only the terminal done call should defer"
  harness.stdio.println("status.status=" + status.result.status)
  harness.stdio.println("status.executed=" + to_string(status.receipts.executed))
  const durable = run_durable_reproposal(harness, counters)
  require durable.result.status == "done", "durable re-proposal should finish"
  require harness.runtime.atomic_get(counters.run) == 1,
    "the write-effect run executes once after the quiet turn"
  // Name the tool. A bare `reproposed >= 1` is satisfied by the unrelated
  // `done` re-proposal in the last turn, which happens with or without durable
  // signatures — so that assertion passed before this fix existed. The claim
  // under test is specifically that the write deferred in turn 1 is still
  // remembered in turn 3, across a turn that never mentioned it.
  // Mock providers normalize call IDs at their boundary, so the durable public
  // invariant is the re-proposed tool identity rather than the source-local ID.
  require contains(durable.receipts.reproposed_names, "run"),
    "the identical write proposed after a quiet turn must be marked re_proposed: "
    + json_stringify(durable.receipts.reproposed_names)
  harness.stdio.println("durable.status=" + durable.result.status)
  harness.stdio.println("durable.reproposed=" + to_string(durable.receipts.reproposed))
}
