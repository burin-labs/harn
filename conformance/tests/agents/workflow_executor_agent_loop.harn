import { workflow_run_repair } from "std/workflow/repair"

/**
 * Inline executor re-entrancy (v0.9.14): the executor closure may itself call
 * `agent_loop` / `llm_call`. This is the exact shape a bespoke embedder needs —
 * its own in-process agent loop (custom llm_caller / post-turn gates / session
 * policy) running as the stage leaf, with harn's retry-with-feedback wrapped
 * around it. The nested agent_loop runs on this same VM/thread; the workflow
 * driver already calls host builtins from Harn, so a closure leaf that does the
 * same must work too.
 *
 * Attempt 1: the mock agent_loop returns text WITHOUT the pass token, so verify
 * fails and threads its finding. Attempt 2: the executor sees the finding in the
 * nested loop's task and the mock echoes it back, so verify passes — proving the
 * nested agent_loop ran under (and consumed the feedback from) the retry loop.
 */
pipeline default() {
  let token = "AGENTOK"
  // The executor is a bespoke in-process agent loop with a mock llm_caller. It
  // emits the pass token only after the (feedback-threaded) task carries it.
  let executor = { ctx ->
    let caller = { _call ->
      let saw = contains(ctx.task, token)
      return {
        ok: true,
        value: {
          text: if saw {
            token + " reached"
          } else {
            "working"
          },
          provider: "mock",
          model: "mock",
          input_tokens: 0,
          output_tokens: 0,
        },
      }
    }
    let r = agent_loop(ctx.task, nil, {provider: "mock", llm_caller: caller, max_iterations: 1})
    return {text: r.text}
  }
  let verifier = { r -> return {ok: contains(to_string(r?.visible_text), token), findings: [token]} }
  let out = workflow_run_repair({task: "do the work", executor: executor, verify: verifier, max_attempts: 2})
  __io_println(out.ok)
  __io_println(len(out.attempts))
  __io_println(out.attempts[0].status)
  __io_println(out.attempts[1].status)
  __io_println(contains(out.text, token))
}
