import { persona_blueprint_validate } from "std/personas/compiler"

fn has_code(report, code) {
  return report.errors.any({ error -> error.code == code })
}

pipeline main() {
  const forbidden_authority = persona_blueprint_validate(
    {
      schema_version: "1",
      name: "unsafe",
      description: "Invalid authority request.",
      goal: "Must fail closed.",
      template: "deterministic-sweeper",
      autonomy_tier: "act_auto",
      cron: {cron: "0 * * * *", timezone: "UTC"},
    },
  )
  __io_println(forbidden_authority.valid)
  __io_println(has_code(forbidden_authority, "shape"))
  const catalog = [
    {
      provider: "github",
      kinds: ["webhook", "poll"],
      schema_name: "GitHubEventPayload",
      outbound_methods: [],
      secret_requirements: [],
      signature_verification: {kind: "none"},
      runtime: {kind: "placeholder"},
    },
  ]
  const invalid_external = persona_blueprint_validate(
    {
      schema_version: "1",
      name: "sdk_watch",
      description: "Watches the SDK.",
      goal: "Narrate important changes.",
      template: "frontier-judgment-loop",
      external: {provider: "github", event: "slack.message"},
    },
    catalog,
  )
  __io_println(invalid_external.valid)
  __io_println(has_code(invalid_external, "ambiguous_provider_transport"))
  __io_println(has_code(invalid_external, "event_namespace_mismatch"))
  const invalid_cron = persona_blueprint_validate(
    {
      schema_version: "1",
      name: "bad_clock",
      description: "Has invalid schedule inputs.",
      goal: "Must fail before materialization.",
      template: "deterministic-sweeper",
      cron: {cron: "not a cron", timezone: "Not/AZone"},
    },
    [],
  )
  __io_println(invalid_cron.valid)
  __io_println(has_code(invalid_cron, "invalid_cron"))
  __io_println(has_code(invalid_cron, "invalid_timezone"))
  __io_println(has_code(invalid_cron, "cron_unavailable"))
  const malformed_five_field_cron = persona_blueprint_validate(
    {
      schema_version: "1",
      name: "invalid_minute",
      description: "Has a syntactically malformed five-field schedule.",
      goal: "Must fail before materialization.",
      template: "deterministic-sweeper",
      cron: {cron: "60 0 * * *", timezone: "UTC"},
    },
    [],
  )
  __io_println(malformed_five_field_cron.valid)
  __io_println(has_code(malformed_five_field_cron, "invalid_cron"))
}
