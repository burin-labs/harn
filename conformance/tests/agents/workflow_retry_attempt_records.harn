import { workflow_execute } from "std/workflow/execute"
/**
 * Byte-compat pin for the stage-loop inversion (design D5): with the default
 * retry policy (no feedback, no repair_prompt_builder) the embedded stage loop
 * records attempts in the exact RunStageRecord shape the legacy Rust loop
 * produced — dense-monotonic attempt numbers, per-attempt status/outcome/
 * branch, nil error on settled-but-failed verification, and non-empty
 * uuid-v7 timestamps.
 */
pipeline default(harness: Harness) {
  const graph = workflow_graph(
    {
      entry: "verify",
      nodes: {
        verify: {
          kind: "verify",
          retry_policy: {max_attempts: 3},
          verify: {command: "echo nope && exit 7", expect_status: 0},
          output_contract: {output_kinds: ["verification_result"]},
        },
      },
      edges: [],
    },
  )
  const run = workflow_execute(harness, "verify", graph, [], {max_steps: 1})
  const attempts = run.run.stages[0].attempts
  harness.stdio.println(len(attempts))
  for attempt in attempts {
    harness.stdio.println(
      to_string(attempt.attempt) + "|" + attempt.status + "|" + attempt.outcome + "|"
        + to_string(
        attempt.branch,
      ),
    )
    harness.stdio.println(attempt.error == nil)
    harness.stdio.println(attempt.verification.ok)
    harness.stdio.println(type_of(attempt.started_at) == "string" && attempt.started_at != "")
    harness.stdio.println(type_of(attempt.finished_at) == "string" && attempt.finished_at != "")
  }
}
