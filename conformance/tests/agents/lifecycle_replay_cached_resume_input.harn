/**
 * Cached resume input replay (P-08, #1861).
 *
 * On replay the runtime feeds the journaled resume payload back into
 * the suspended worker instead of re-prompting. The cached payload's
 * `input_hash` is computed against the *original* value, so a stale or
 * drifted input surfaces `HARN-SUS-011` and the replay refuses to
 * memoize. The hash is canonical (insensitive to map-key order), so
 * the same logical payload can re-validate even if a serializer reorders
 * keys.
 */
pipeline default() {
  const _ = mock_time(1700000001000)
  const original_input = {approved: true, comment: "ship it", reviewer: "alice"}
  const receipt = lifecycle_receipt_record_resumption(
    {
      handle: "worker://triage/42",
      session_id: "session-a",
      initiator: "operator",
      initiator_id: "op-1",
      input: original_input,
      continue_transcript: true,
    },
  )
  // Replay with identical payload — succeeds, returns cached input.
  const hit = lifecycle_replay_resume_input(receipt.payload, original_input)
  __io_println("hit_ok=" + to_string(hit.ok))
  __io_println("hit_input_approved=" + to_string(hit.input?.approved))
  __io_println("hit_input_reviewer=" + hit.input?.reviewer)
  // Replay with reordered keys — canonical hash matches.
  const reordered = {reviewer: "alice", approved: true, comment: "ship it"}
  const reorder_hit = lifecycle_replay_resume_input(receipt.payload, reordered)
  __io_println("reorder_ok=" + to_string(reorder_hit.ok))
  // Replay with a drifted payload — mismatch, HARN-SUS-011.
  const drifted = {approved: false, comment: "ship it", reviewer: "alice"}
  const miss = lifecycle_replay_resume_input(receipt.payload, drifted)
  __io_println("miss_ok=" + to_string(miss.ok))
  __io_println("miss_code=" + miss.code)
  // Hash is stable across orderings.
  const h1 = lifecycle_resume_input_hash(original_input)
  const h2 = lifecycle_resume_input_hash(reordered)
  __io_println("hash_canonical=" + to_string(h1 == h2))
  const _ = unmock_time()
  return "ok"
}
