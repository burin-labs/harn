import { llm_text, llm_tool_call, with_llm_script } from "std/testing"

fn on_delta_tools() {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "note",
    "Record a note",
    {
      handler: { _args -> "noted" },
      parameters: {text: {type: "string", description: "Note text"}},
      returns: {type: "string"},
    },
  )
  return tools
}

pipeline default() {
  with_llm_script(
    [llm_tool_call("note", {text: "remember"}), llm_text("All done.")],
    { ->
      let result = agent_loop(
        "take a note then finish",
        nil,
        {
          provider: "mock",
          tools: on_delta_tools(),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          on_delta: { delta -> __io_println("delta=[" + delta + "]") },
        },
      )
      let calls = llm_mock_calls()
      __io_println(result.status)
      __io_println(len(calls))
      __io_println(contains(json_stringify(calls[1].messages), "noted"))
    },
  )
}
// `on_delta` must not perturb tool dispatch. The streaming seam preserves the
// full turn result (native tool calls + usage), so the first turn's native tool
// call is dispatched normally and its result feeds the second turn. The
// tool-call turn carries no visible text, so it fires no delta; the closing text
// turn streams its one delta.
