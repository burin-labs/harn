import { parse_resume_conditions } from "std/agent/workers"

pipeline main(harness: Harness) {
  const trigger = parse_resume_conditions(
    harness.agent,
    {
      trigger: {
        id: "resume-review",
        kind: "review.approved",
        provider: "github",
        match: {events: ["review.approved"]},
      },
    },
  )
  harness.stdio.println(trigger?.trigger?.kind)
  harness.stdio.println(trigger?.trigger?.match?.events[0])
  const timeout = parse_resume_conditions(
    harness.agent,
    {timeout: {duration_minutes: 15, on_timeout: "resume_with_input"}},
  )
  harness.stdio.println(timeout?.timeout?.duration_minutes)
  harness.stdio.println(timeout?.timeout?.on_timeout)
  const event = parse_resume_conditions(harness.agent, {on_event: "operator.resume"})
  harness.stdio.println(event?.on_event)
  const default_timeout = parse_resume_conditions(harness.agent, {timeout: {duration_minutes: 5}})
  harness.stdio.println(default_timeout?.timeout?.on_timeout)
}
