import { parse_resume_conditions } from "std/agent/workers"

pipeline main() {
  const trigger = parse_resume_conditions(
    {
      trigger: {
        id: "resume-review",
        kind: "review.approved",
        provider: "github",
        match: {events: ["review.approved"]},
      },
    },
  )
  __io_println(trigger?.trigger?.kind)
  __io_println(trigger?.trigger?.match?.events[0])
  const timeout = parse_resume_conditions(
    {timeout: {duration_minutes: 15, on_timeout: "resume_with_input"}},
  )
  __io_println(timeout?.timeout?.duration_minutes)
  __io_println(timeout?.timeout?.on_timeout)
  const event = parse_resume_conditions({on_event: "operator.resume"})
  __io_println(event?.on_event)
  const default_timeout = parse_resume_conditions({timeout: {duration_minutes: 5}})
  __io_println(default_timeout?.timeout?.on_timeout)
}
