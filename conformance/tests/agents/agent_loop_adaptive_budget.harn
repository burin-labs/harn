import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn lookup_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "lookup",
    "Return release evidence",
    {
      handler: { args -> "evidence for " + args.query },
      parameters: {query: {type: "string", description: "Lookup query"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

pipeline default(harness: Harness) {
  // Case 1: adaptive budget starts low, ends early on natural completion.
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "lookup_1", name: "lookup", arguments: {query: "alpha"}}]},
      llm_text("<user_response>All good.</user_response>"),
    ],
    { ->
      const early = agent_loop(harness, "Inspect alpha",
        nil,
        {
          provider: "mock",
          tools: lookup_tools(),
          tool_format: "native",
          loop_until_done: true,
          iteration_budget: {mode: "adaptive", initial: 3, max: 8, extend_by: 2},
        },
      )
      harness.stdio.println(early.status)
      harness.stdio.println(early.llm.iterations)
      harness.stdio.println(early.adaptive_budget.mode)
      harness.stdio.println(early.adaptive_budget.initial)
      harness.stdio.println(early.adaptive_budget.max)
      harness.stdio.println(early.adaptive_budget.final_limit)
      harness.stdio.println(early.adaptive_budget.extensions_used)
      harness.stdio.println(len(early.adaptive_budget.decisions))
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "t1", name: "lookup", arguments: {query: "1"}}]},
      {tool_calls: [{id: "t2", name: "lookup", arguments: {query: "2"}}]},
      {tool_calls: [{id: "t3", name: "lookup", arguments: {query: "3"}}]},
      llm_text("<user_response>Done after extension.</user_response>"),
    ],
    { ->
      const extended = agent_loop(harness, "Inspect everything",
        nil,
        {
          provider: "mock",
          tools: lookup_tools(),
          tool_format: "native",
          loop_until_done: true,
          iteration_budget: {mode: "adaptive", initial: 2, max: 6, extend_by: 2},
        },
      )
      harness.stdio.println(extended.status)
      harness.stdio.println(extended.llm.iterations)
      harness.stdio.println(extended.adaptive_budget.extensions_used)
      harness.stdio.println(len(extended.adaptive_budget.decisions))
      harness.stdio.println(extended.adaptive_budget.decisions[0].action)
      harness.stdio.println(extended.adaptive_budget.decisions[0].old_limit)
      harness.stdio.println(extended.adaptive_budget.decisions[0].new_limit)
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "tA", name: "lookup", arguments: {query: "x"}}]},
      {tool_calls: [{id: "tB", name: "lookup", arguments: {query: "y"}}]},
      {tool_calls: [{id: "tC", name: "lookup", arguments: {query: "z"}}]},
      {tool_calls: [{id: "tD", name: "lookup", arguments: {query: "w"}}]},
      {tool_calls: [{id: "tE", name: "lookup", arguments: {query: "q"}}]},
    ],
    { ->
      const capped = agent_loop(harness, "Keep working",
        nil,
        {
          provider: "mock",
          tools: lookup_tools(),
          tool_format: "native",
          loop_until_done: true,
          iteration_budget: {mode: "adaptive", initial: 2, max: 4, extend_by: 2},
        },
      )
      harness.stdio.println(capped.status)
      harness.stdio.println(capped.adaptive_budget.final_limit)
      harness.stdio.println(capped.adaptive_budget.final_limit <= capped.adaptive_budget.max)
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "early1", name: "lookup", arguments: {query: "stop"}}]},
      {tool_calls: [{id: "early2", name: "lookup", arguments: {query: "now"}}]},
    ],
    { ->
      const controlled = agent_loop(harness, "Inspect stop",
        nil,
        {
          provider: "mock",
          tools: lookup_tools(),
          tool_format: "native",
          loop_until_done: true,
          iteration_budget: {mode: "adaptive", initial: 5, max: 10, extend_by: 2},
          loop_control: { state ->
            if state.iteration >= 2 {
              {action: "stop", status: "incomplete", reason: "policy stop"}
            } else {
              nil
            }
          },
        },
      )
      harness.stdio.println(controlled.status)
      harness.stdio.println(controlled.stop_reason)
      harness.stdio.println(controlled.llm.iterations)
      harness.stdio.println(
        controlled.adaptive_budget.decisions[len(controlled.adaptive_budget.decisions) - 1].action,
      )
    },
  )
  with_llm_script(
    harness.llm, [llm_text("Plain final answer.")],
    { ->
      const legacy = agent_loop(harness, "Do nothing fancy.",
        nil,
        {provider: "mock", tools: tool_registry(), tool_format: "native", max_iterations: 1},
      )
      harness.stdio.println(legacy.status)
      harness.stdio.println(legacy.llm.iterations)
      harness.stdio.println(contains(legacy.keys(), "adaptive_budget"))
    },
  )
}
// Case 2: cap starts low; tool progress at the cap edge triggers default
// policy extension. Three tool turns, then a final natural-completion.
// Case 3: max cap is honored. With initial=2, max=4, three tool calls
// exhaust the budget after one extension; status becomes budget_exhausted.
// Case 4: caller-supplied loop_control closure stops the loop early.
// Case 5: legacy fixed `max_iterations` still works without adaptive_budget surface.
