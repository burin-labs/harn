import { agent_loop_options } from "std/agent/options"
import { missing_tool_call_classifier } from "std/llm/missing_tool_call"
import { llm_text, with_llm_script } from "std/testing"

/**
 * Cheap/local-model behavioral tips: TEXT-mode corrective nudges that the
 * native-gated completion-confirmation path never reaches. The agent loop
 * inspects each toolless TEXT-mode turn and injects ONE content-specific
 * nudge, or — as a fallback for pure-prose churn — an escalating
 * "no meaningful progress" streak nudge.
 *
 *  1. Fenced-call attempt: the model wraps a (Python-kwarg-style) call in a
 *     ```tool_code fence that the parser does NOT lift, so the turn is
 *     toolless → `fenced_call_attempt` nudge fires.
 *  2. Classifier-backed tool intent: the model expresses intent to use a
 *     bound tool but emits no call syntax → `missing_tool_call` nudge.
 *  3. Real call (bare `edit({...})` and braceless `edit(path=...)`) does NOT
 *     false-fire either content nudge — the call dispatches and the loop
 *     proceeds normally.
 *  4. No-progress streak: 3 consecutive toolless prose turns in the DEFAULT
 *     loop escalate to the `no_progress_streak` nudge; a successful tool call
 *     decays the streak so a later toolless turn does not re-escalate at the
 *     same depth.
 */
fn edit_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Edit a file.",
    {
      handler: { args -> "edited " + (args?.path ?? "") },
      parameters: {path: {type: "string", description: "Path to edit"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  return tools
}

fn injected_kind_in(calls, idx, marker) {
  if idx >= len(calls) {
    return false
  }
  return contains(json_stringify(calls[idx].messages), marker)
}

fn edit_missing_tool_call_recovery() {
  return {
    classifier: { _payload -> return {
      action: "tool_call_intended",
      tool_name: "edit",
      confidence: 0.96,
      evidence: "fixture classifier found a tool action",
      language: "fixture",
    } },
  }
}

pipeline default() {
  // 1. Fenced-call attempt → fenced_call_attempt nudge on the next turn.
  //    The fenced body uses the Python-kwarg shape `edit(path=...)`, which the
  //    parser does NOT lift from inside a fence, so the turn is genuinely
  //    toolless and the fenced nudge fires.
  with_llm_script(
    [
      llm_text("Here is the change:\n```tool_code\nedit(path=\"a.txt\")\n```"),
      llm_text("<tool_call>\nedit({ path: \"a.txt\" })\n</tool_call>"),
      llm_text("All set."),
    ],
    { ->
      const r = agent_loop(
        "Edit a.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = llm_mock_calls()
      __io_println("fenced.status=" + r.status)
      __io_println("fenced.nudge=" + to_string(injected_kind_in(calls, 1, "fenced_call_attempt")))
      __io_println("fenced.no_missing=" + to_string(!injected_kind_in(calls, 1, "missing_tool_call")))
    },
  )
  // 2. Missing tool call → missing_tool_call nudge on the next turn.
  with_llm_script(
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"b.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      const r = agent_loop(
        "Edit b.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = llm_mock_calls()
      __io_println("missing.status=" + r.status)
      __io_println("missing.nudge=" + to_string(injected_kind_in(calls, 1, "missing_tool_call")))
      __io_println("missing.not_fenced=" + to_string(!injected_kind_in(calls, 1, "fenced_call_attempt")))
    },
  )
  // 2b. Another typoed/non-English phrase depends on the classifier, not exact
  //     tool-name substrings in the assistant text.
  with_llm_script(
    [
      llm_text("Je vais corriger le fichier maintenant."),
      llm_text("<tool_call>\nedit({ path: \"b2.txt\" })\n</tool_call>"),
      llm_text("Listo."),
    ],
    { ->
      const r = agent_loop(
        "Edit b2.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = llm_mock_calls()
      __io_println("multilingual.status=" + r.status)
      __io_println("multilingual.nudge=" + to_string(injected_kind_in(calls, 1, "missing_tool_call")))
      __io_println(
        "multilingual.not_fenced=" + to_string(!injected_kind_in(calls, 1, "fenced_call_attempt")),
      )
    },
  )
  // 3a. A real bare object-literal call does NOT trip either content nudge.
  with_llm_script(
    [llm_text("<tool_call>\nedit({ path: \"c.txt\" })\n</tool_call>"), llm_text("Done.")],
    { ->
      const r = agent_loop(
        "Edit c.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = llm_mock_calls()
      __io_println("realcall.successful=" + json_stringify(r.tools.successful))
      __io_println("realcall.no_fenced=" + to_string(!injected_kind_in(calls, 1, "fenced_call_attempt")))
      __io_println("realcall.no_missing=" + to_string(!injected_kind_in(calls, 1, "missing_tool_call")))
    },
  )
  // 3b. A braceless `name(key=...)` call shape also does NOT false-fire the
  //     missing-tool-call recovery path (it carries real call shape).
  with_llm_script(
    [
      llm_text("edit(path=\"d.txt\")"),
      llm_text("<tool_call>\nedit({ path: \"d.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      const r = agent_loop(
        "Edit d.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = llm_mock_calls()
      __io_println("kwargshape.status=" + r.status)
      __io_println("kwargshape.no_missing=" + to_string(!injected_kind_in(calls, 1, "missing_tool_call")))
    },
  )
  // 4. No-progress streak in the DEFAULT loop (loop_until_done so the toolless
  //    turns continue): a successful tool call decays the streak, then three
  //    consecutive toolless prose turns escalate to the no_progress_streak
  //    nudge. The prose avoids intent verbs / fences / bound-tool names so the
  //    content nudges do NOT match and the fallback streak nudge is exercised.
  with_llm_script(
    [
      llm_text("<tool_call>\nedit({ path: \"e.txt\" })\n</tool_call>"),
      llm_text("The file was updated and the content looks consistent."),
      llm_text("The surrounding context appears coherent on a second pass."),
      llm_text("Everything reads as expected throughout the module."),
      llm_text("Final summary of the result."),
    ],
    { ->
      const r = agent_loop(
        "Edit e.txt and review.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 8,
          max_nudges: 8,
          tools: edit_tools(),
        },
      )
      const calls = llm_mock_calls()
      __io_println(
        "streak.none_after_progress=" + to_string(!injected_kind_in(calls, 1, "no_progress_streak")),
      )
      let streak_fired = false
      for i in range(2, len(calls)) {
        if injected_kind_in(calls, i, "no_progress_streak") {
          streak_fired = true
        }
      }
      __io_println("streak.escalates=" + to_string(streak_fired))
    },
  )
  const invalid_classifier = try {
    agent_loop_options({missing_tool_call_recovery: {classifier: "yes"}})
  }
  __io_println("invalid_classifier=" + to_string(is_err(invalid_classifier)))
  __io_println(contains(to_string(unwrap_err(invalid_classifier)), "missing_tool_call_recovery"))
  const invalid_enabled = try {
    agent_loop_options({missing_tool_call_recovery: {enabled: "yes"}})
  }
  __io_println("invalid_enabled=" + to_string(is_err(invalid_enabled)))
  __io_println(contains(to_string(unwrap_err(invalid_enabled)), "missing_tool_call_recovery.enabled"))
  const invalid_options = try {
    agent_loop_options({missing_tool_call_recovery: "yes"})
  }
  __io_println("invalid_options=" + to_string(is_err(invalid_options)))
  __io_println(contains(to_string(unwrap_err(invalid_options)), "missing_tool_call_recovery"))
  const invalid_threshold = try {
    missing_tool_call_classifier({confidence_threshold: 2.0})
  }
  __io_println("invalid_threshold=" + to_string(is_err(invalid_threshold)))
  const threshold_error = unwrap_err(invalid_threshold)
  __io_println(
    "invalid_threshold.code="
      + to_string(threshold_error.error == "missing_tool_call.invalid_confidence_threshold"),
  )
  __io_println(
    "invalid_threshold.field=" + to_string(threshold_error.field == "confidence_threshold"),
  )
  __io_println(
    "invalid_threshold.bounds="
      + to_string(threshold_error.min == 0.0 && threshold_error.max == 1.0),
  )
}
// Successful tool on turn 1 → no streak nudge on turn 2.
// By a later turn (>= 2 consecutive toolless turns) the streak nudge fired.
