import { agent_loop } from "std/agent/loop"
import { agent_loop_options } from "std/agent/options"
import { missing_tool_call_classifier } from "std/llm/missing_tool_call"
import { llm_text, with_llm_script } from "std/testing"

/**
 * Text-mode corrective nudges. The agent loop inspects unresolved turns with
 * no tool call and injects one content-specific nudge. Plain repeated prose
 * falls back to the no-progress nudge.
 *
 *  1. Fenced-call attempt: the model wraps a (Python-kwarg-style) call in a
 *     ```tool_code fence that the parser does NOT lift, so the turn is
 *     toolless → `fenced_call_attempt` nudge fires.
 *  2. Classifier-backed tool intent: the model expresses intent to use a
 *     bound tool but emits no call syntax → `missing_tool_call` nudge.
 *  3. Real call (bare `edit({...})` and braceless `edit(path=...)`) does NOT
 *     false-fire either content nudge — the call dispatches and the loop
 *     proceeds normally.
 *  4. No-progress streak: 3 consecutive toolless prose turns in the DEFAULT
 *     loop escalate to the `no_progress_streak` nudge; a successful tool call
 *     decays the streak so a later toolless turn does not re-escalate at the
 *     same depth.
 *
 *  5. A completion judge owns terminal intent and bypasses this classifier.
 *  6. A repair claim is published as a typed fact on the next turn, so a
 *     host control policy can observe it instead of racing it.
 *  7. `turn_end_condition: false` is not a judge, and the loop must not gate on it as
 *     though it were.
 *  8. A non-stopping host advisory cannot consume a repair opportunity.
 */
fn edit_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Edit a file.",
    {
      handler: { args -> "edited " + (args?.path ?? "") },
      parameters: {path: {type: "string", description: "Path to edit"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  return tools
}

/**
 * Scan EVERY call for a marker. The indexed helper below is only valid when
 * both sides of a comparison share a loop shape; installing a `turn_end_condition`
 * changes the call count, so the judge cases must not assert on a position.
 */
fn injected_anywhere(calls: list?, marker: string) {
  for call in calls ?? [] {
    for message in call.messages {
      if contains(to_string(message?.content ?? ""), marker) {
        return true
      }
    }
  }
  return false
}

fn injected_kind_in(calls: any, idx: int, marker: string) {
  if idx >= len(calls) {
    return false
  }
  for message in calls[idx].messages {
    if contains(to_string(message?.content ?? ""), marker) {
      return true
    }
  }
  return false
}

fn edit_missing_tool_call_recovery() {
  return {
    classifier: { _payload ->
      return {
        action: "tool_call_intended",
        tool_name: "edit",
        confidence: 0.96,
        evidence: "fixture classifier found a tool action",
        language: "fixture",
      }
    },
  }
}

pipeline default(harness: Harness) {
  // 1. Fenced-call attempt → fenced_call_attempt nudge on the next turn.
  //    The fenced body uses the Python-kwarg shape `edit(path=...)`, which the
  //    parser does NOT lift from inside a fence, so the turn is genuinely
  //    toolless and the fenced nudge fires.
  with_llm_script(
    harness.llm,
    [
      llm_text("Here is the change:\n```tool_code\nedit(path=\"a.txt\")\n```"),
      llm_text("<tool_call>\nedit({ path: \"a.txt\" })\n</tool_call>"),
      llm_text("All set."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit a.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          post_turn_callback: { info ->
            if info?.iteration == 1 {
              harness.stdio.println(
                "fenced.no_claim=" + to_string(info?.prior_turn_next_tool_claim == nil),
              )
            }
            return nil
          },
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("fenced.status=" + r.status)
      harness.stdio.println(
        "fenced.nudge="
          + to_string(injected_kind_in(calls, 1, "<directive authority=\"corrective\"")),
      )
      harness.stdio.println(
        "fenced.no_missing="
          + to_string(!injected_kind_in(calls, 1, "appeared to intend a call")),
      )
    },
  )
  // 2. Missing tool call → missing_tool_call nudge on the next turn.
  with_llm_script(
    harness.llm,
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"b.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit b.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("missing.status=" + r.status)
      harness.stdio.println(
        "missing.nudge="
          + to_string(injected_kind_in(calls, 1, "<directive authority=\"corrective\"")),
      )
      harness.stdio.println(
        "missing.not_fenced=" + to_string(!injected_kind_in(calls, 1, "wrapped a tool call")),
      )
    },
  )
  // 2b. Another typoed/non-English phrase depends on the classifier, not exact
  //     tool-name substrings in the assistant text.
  with_llm_script(
    harness.llm,
    [
      llm_text("Je vais corriger le fichier maintenant."),
      llm_text("<tool_call>\nedit({ path: \"b2.txt\" })\n</tool_call>"),
      llm_text("Listo."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit b2.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("multilingual.status=" + r.status)
      harness.stdio.println(
        "multilingual.nudge="
          + to_string(injected_kind_in(calls, 1, "<directive authority=\"corrective\"")),
      )
      harness.stdio.println(
        "multilingual.not_fenced="
          + to_string(!injected_kind_in(calls, 1, "wrapped a tool call")),
      )
    },
  )
  // 3a. A real bare object-literal call does NOT trip either content nudge.
  with_llm_script(
    harness.llm,
    [llm_text("<tool_call>\nedit({ path: \"c.txt\" })\n</tool_call>"), llm_text("Done.")],
    { ->
      const r = agent_loop(
        harness,
        "Edit c.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("realcall.successful=" + json_stringify(r.tools.successful))
      harness.stdio.println(
        "realcall.no_fenced=" + to_string(!injected_kind_in(calls, 1, "wrapped a tool call")),
      )
      harness.stdio.println(
        "realcall.no_missing="
          + to_string(!injected_kind_in(calls, 1, "appeared to intend a call")),
      )
    },
  )
  // 3b. A braceless `name(key=...)` call shape also does NOT false-fire the
  //     missing-tool-call recovery path (it carries real call shape).
  with_llm_script(
    harness.llm,
    [
      llm_text("edit(path=\"d.txt\")"),
      llm_text("<tool_call>\nedit({ path: \"d.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit d.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("kwargshape.status=" + r.status)
      harness.stdio.println(
        "kwargshape.no_missing="
          + to_string(!injected_kind_in(calls, 1, "appeared to intend a call")),
      )
    },
  )
  // 4. No-progress streak in the DEFAULT loop (loop_until_done so the toolless
  //    turns continue): a successful tool call decays the streak, then three
  //    consecutive toolless prose turns escalate to the no_progress_streak
  //    nudge. The prose avoids intent verbs / fences / bound-tool names so the
  //    content nudges do NOT match and the fallback streak nudge is exercised.
  with_llm_script(
    harness.llm,
    [
      llm_text("<tool_call>\nedit({ path: \"e.txt\" })\n</tool_call>"),
      llm_text("The file was updated and the content looks consistent."),
      llm_text("The surrounding context appears coherent on a second pass."),
      llm_text("Everything reads as expected throughout the module."),
      llm_text("Final summary of the result."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit e.txt and review.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 8,
          max_nudges: 8,
          tools: edit_tools(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "streak.none_after_progress="
          + to_string(!injected_kind_in(calls, 1, "<directive authority=\"corrective\"")),
      )
      let streak_fired = false
      for i in range(2, len(calls)) {
        if injected_kind_in(calls, i, "<directive authority=\"corrective\"") {
          streak_fired = true
        }
      }
      harness.stdio.println("streak.escalates=" + to_string(streak_fired))
    },
  )
  // 5. A completion judge is the single model-based owner of terminal intent.
  //    The missing-call classifier must not run first or consume the judge's
  //    provider call.
  with_llm_script(
    harness.llm,
    [
      llm_text("The requested edit is complete."),
      llm_text("{\"verdict\":\"done\",\"detail\":\"The edit result is explicit.\"}"),
    ],
    { ->
      agent_loop(
        harness,
        "Edit j.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 2,
          max_nudges: 4,
          tools: edit_tools(),
          turn_end_condition: {model: "mock-judge"},
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "judged_owner.no_missing="
          + to_string(!injected_anywhere(calls, "appeared to intend a call")),
      )
      harness.stdio.println(
        "judged_owner.no_exemplar=" + to_string(!injected_anywhere(calls, "Emit the call now")),
      )
      harness.stdio.println("judged_owner.calls=" + to_string(len(calls)))
    },
  )
  // 6. The claim is a FACT a host can read, not an ordering it has to infer.
  //    When the corrective claims a turn for repair, the next turn's post-turn
  //    payload says so, so a host churn/termination policy looking at the same
  //    toolless turn shape can tell "the model is spinning" from "the loop
  //    asked for one specific repair and this is that turn".
  with_llm_script(
    harness.llm,
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"k.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      agent_loop(
        harness,
        "Edit k.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          turn_end_condition: false,
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
          post_turn_callback: { info ->
            if info?.iteration == 0 {
              harness.stdio.println(
                "claim_fact.first_turn="
                  + to_string(info?.prior_turn_claimed_for_repair ?? "missing"),
              )
            }
            if info?.iteration == 1 {
              harness.stdio.println(
                "claim_fact.repair_turn="
                  + to_string(info?.prior_turn_claimed_for_repair ?? "missing"),
              )
              harness.stdio.println(
                "claim_fact.tool="
                  + to_string(info?.prior_turn_next_tool_claim?.tool_name ?? "missing"),
              )
            }
            return nil
          },
        },
      )
    },
  )
  // 7. `turn_end_condition: false` means no judge. Pinning the normalized notion of
  //    judge presence: the loop must not treat a disabled judge as an installed
  //    one and gate behavior on it. This holds today through a normalization
  //    step upstream of the consumers, so it pins an invariant rather than
  //    proving a fix.
  with_llm_script(
    harness.llm,
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"m.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit m.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          turn_end_condition: false,
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("judge_false.status=" + r.status)
      harness.stdio.println(
        "judge_false.exemplar=" + to_string(injected_anywhere(calls, "Emit the call now")),
      )
    },
  )
  // 8. An embedder's advisory verdict must not consume the repair opportunity.
  //    A stalled toolless turn is contended: the embedder's post-turn callback,
  //    the content-specific corrective, and completion adjudication all have a
  //    reading of it. A callback that returns advice without stopping the loop
  //    is expressing an opinion, not terminating, so it must not silently claim
  //    the turn and leave the stall unrepaired. The corrective still fires, and
  //    its concrete exemplar is what the next turn sees.
  with_llm_script(
    harness.llm,
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"n.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      agent_loop(
        harness,
        "Edit n.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          turn_end_condition: false,
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
          post_turn_callback: { _info -> {message: "Keep making progress."} },
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "host_advisory.exemplar=" + to_string(injected_anywhere(calls, "Emit the call now")),
      )
      // The claimed turn carries ONE directive. Two owners telling the model
      // different things in the same turn is the contradiction that stalls a
      // loop, and between the two the corrective is the actionable one.
      harness.stdio.println(
        "host_advisory.suppressed_on_claimed_turn="
          + to_string(!injected_kind_in(calls, 1, "Keep making progress.")),
      )
    },
  )
  // 9. The other direction: terminating is the embedder's authority, and the
  //     corrective must not preempt it. A verdict that stops the loop wins over
  //     every other claimant on the same turn shape, so the run ends without the
  //     corrective injecting anything.
  with_llm_script(
    harness.llm,
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"o.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      const r = agent_loop(
        harness,
        "Edit o.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          turn_end_condition: {model: "mock-judge"},
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
          post_turn_callback: { _info -> {stop: true, stop_reason: "host_said_stop"} },
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("host_stop.stop_reason=" + to_string(r?.stop_reason))
      harness.stdio.println(
        "host_stop.no_exemplar=" + to_string(!injected_anywhere(calls, "Emit the call now")),
      )
    },
  )
  // 10. A repair claim is only meaningful if the loop has another turn to give.
  //     A single-shot loop (no `loop_until_done`, no daemon, no judge) ends ON
  //     this turn, so the corrective must not be consulted: claiming the turn
  //     would replace a clean completion with a dangling continue asking for a
  //     call that can never be made. The prose here carries a ```python fence,
  //     which the fence detector would otherwise read as a wrapped call.
  with_llm_script(
    harness.llm,
    [llm_text("The smallest change is:\n\n```python\ndef add(a, b): return a + b\n```")],
    { ->
      const r = agent_loop(
        harness,
        "State the smallest code change.",
        nil,
        {provider: "mock", tool_format: "text", max_iterations: 1, tools: edit_tools()},
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println("single_shot.status=" + to_string(r.status))
      harness.stdio.println(
        "single_shot.not_claimed=" + to_string(!injected_anywhere(calls, "that is ignored")),
      )
    },
  )
  // 11. The corrective's exemplar must carry the tool's OWN required argument
  //     names, read from the tool entry. An exemplar showing an empty argument
  //     object is a complete, copy-pasteable call that is also wrong, and it
  //     tells the model nothing about what the call needs. `edit` declares a
  //     required `path`, so the exemplar names it and marks it a placeholder
  //     rather than inventing a plausible value.
  with_llm_script(
    harness.llm,
    [
      llm_text("Voy a edittar el archivo ahora, un momento."),
      llm_text("<tool_call>\nedit({ path: \"p.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      agent_loop(
        harness,
        "Edit p.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
          turn_end_condition: false,
          missing_tool_call_recovery: edit_missing_tool_call_recovery(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "exemplar.names_required_arg=" + to_string(injected_anywhere(calls, "path")),
      )
      // The placeholder marker itself is HTML-escaped inside the directive
      // envelope, so assert the instruction rather than the escaped glyphs —
      // the contract is "this is a placeholder", not how `<` is encoded.
      harness.stdio.println(
        "exemplar.marks_placeholder="
          + to_string(injected_anywhere(calls, "replace each placeholder with a real value")),
      )
      // The empty-argument form must be gone: it is the shape that taught
      // nothing and still parsed as a complete call.
      harness.stdio.println(
        "exemplar.not_empty_args=" + to_string(!injected_anywhere(calls, "{ }")),
      )
    },
  )
  // 12. Malformed call markup is an ATTEMPTED call, not an absent one. A
  //     message ending in a dangling closing marker means the model reached for
  //     the emission and the parser rejected it, so answering "you did not call
  //     it" describes the turn wrongly and teaches nothing. Observed live as
  //     prose ending in `</tool>` on a lane whose grammar is the ```tool block.
  with_llm_script(
    harness.llm,
    [
      llm_text("Let me read the full contents of the two files now. </tool>"),
      llm_text("<tool_call>\nedit({ path: \"q.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      agent_loop(
        harness,
        "Edit q.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "malformed.diagnosed=" + to_string(injected_anywhere(calls, "call markup was malformed")),
      )
      // It must NOT be described as a turn that never intended a call.
      harness.stdio.println(
        "malformed.not_absent_call="
          + to_string(!injected_anywhere(calls, "appeared to intend a call")),
      )
    },
  )
  // 13. The other direction, and the one that makes case 12 safe: ordinary
  //     prose that merely MENTIONS the marker mid-sentence is not an attempt,
  //     and an honest finished turn must never be re-opened by this detector.
  with_llm_script(
    harness.llm,
    [
      llm_text("The parser ignores a stray </tool> marker inside prose, which is why I checked."),
      llm_text("<tool_call>\nedit({ path: \"r.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      agent_loop(
        harness,
        "Edit r.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "malformed.silent_on_prose="
          + to_string(!injected_anywhere(calls, "call markup was malformed")),
      )
    },
  )
  // 14. The third direction, found by a cardinality test rather than by design:
  //     a COMPLETE call block whose arguments the parser rejected also ends in a
  //     closing marker, but that turn already has an owner — the parse-rejection
  //     path. Two owners answering one turn is the contradiction this whole seam
  //     exists to prevent, so the detector requires the marker to be dangling.
  with_llm_script(
    harness.llm,
    [
      llm_text("<tool_call>\nedit({ path: })\n</tool_call>"),
      llm_text("<tool_call>\nedit({ path: \"s.txt\" })\n</tool_call>"),
      llm_text("Done."),
    ],
    { ->
      agent_loop(
        harness,
        "Edit s.txt.",
        nil,
        {
          provider: "mock",
          tool_format: "text",
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 4,
          tools: edit_tools(),
        },
      )
      const calls = harness.llm.mock_calls()
      harness.stdio.println(
        "malformed.silent_on_parse_rejection="
          + to_string(!injected_anywhere(calls, "call markup was malformed")),
      )
    },
  )
  const invalid_classifier = try {
    agent_loop_options(harness, {missing_tool_call_recovery: {classifier: "yes"}})
  }
  harness.stdio.println("invalid_classifier=" + to_string(is_err(invalid_classifier)))
  harness.stdio.println(
    contains(to_string(unwrap_err(invalid_classifier)), "missing_tool_call_recovery"),
  )
  const invalid_enabled = try {
    agent_loop_options(harness, {missing_tool_call_recovery: {enabled: "yes"}})
  }
  harness.stdio.println("invalid_enabled=" + to_string(is_err(invalid_enabled)))
  harness.stdio.println(
    contains(to_string(unwrap_err(invalid_enabled)), "missing_tool_call_recovery.enabled"),
  )
  const invalid_options = try {
    agent_loop_options(harness, {missing_tool_call_recovery: "yes"})
  }
  harness.stdio.println("invalid_options=" + to_string(is_err(invalid_options)))
  harness.stdio.println(
    contains(to_string(unwrap_err(invalid_options)), "missing_tool_call_recovery"),
  )
  const invalid_threshold = try {
    missing_tool_call_classifier(harness, {confidence_threshold: 2.0})
  }
  harness.stdio.println("invalid_threshold=" + to_string(is_err(invalid_threshold)))
  const threshold_error = unwrap_err(invalid_threshold)
  harness.stdio.println(
    "invalid_threshold.code="
      + to_string(threshold_error.error == "missing_tool_call.invalid_confidence_threshold"),
  )
  harness.stdio.println(
    "invalid_threshold.field=" + to_string(threshold_error.field == "confidence_threshold"),
  )
  harness.stdio.println(
    "invalid_threshold.bounds="
      + to_string(threshold_error.min == 0.0 && threshold_error.max == 1.0),
  )
}
// Successful tool on turn 1 → no streak nudge on turn 2.
// By a later turn (>= 2 consecutive toolless turns) the streak nudge fired.
