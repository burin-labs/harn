import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn tools() {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "lookup",
    "Return evidence",
    {
      handler: { _args -> "evidence ok" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return registry
}

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {text: "", tool_calls: [{id: "lookup1", name: "lookup", arguments: {}}]},
      llm_text("Final answer without sentinel."),
      llm_text("##DONE##"),
    ],
    { ->
      const result = agent_loop(harness, "Use the tool, then finish.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          loop_until_done: true,
          done_sentinel: "##DONE##",
          done_judge: nil,
          max_iterations: 4,
          max_nudges: 2,
        },
      )
      harness.stdio.println(result.status)
      harness.stdio.println(result.stop_reason)
      harness.stdio.println(result.llm.iterations)
      harness.stdio.println(result.text)
      harness.stdio.println(!contains(result.text, "##DONE##"))
      const calls = harness.llm.mock_calls()
      harness.stdio.println(contains(calls[0].system, "##DONE##"))
      harness.stdio.println(contains(calls[1].system, "##DONE##"))
      harness.stdio.println(contains(calls[2].system, "##DONE##"))
      harness.stdio.println(!contains(calls[0].system, "<user_response>"))
    },
  )
}
