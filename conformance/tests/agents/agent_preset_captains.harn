import { agent_loop } from "std/agent/loop"
/**
 * Captain presets — verify that each of the four captain shapes
 * (merge_captain, review_captain, oncall_captain, release_captain)
 * returns the expected agent_loop options envelope, that opt-in tool
 * middleware layers wire correctly, and that captain-specific defaults
 * (merge: read-only auto-approve consent; oncall: 50-call rate cap)
 * fire when nothing is supplied.
 */
import { agent_preset } from "std/agent/presets"
import { llm_text, with_llm_script } from "std/testing"

fn preset_agent(harness: Harness, kind, prompt, options = nil) {
  const opts = agent_preset(harness, kind, options)
  return agent_loop(harness, prompt, opts?.system, opts)
}

pipeline default(harness: Harness) {
  // (1) merge_captain — long adaptive budget; tool_using profile;
  // captain max-nudges of 3.
  const merge = agent_preset(harness, "merge_captain")
  harness.stdio.println(merge.profile)
  harness.stdio.println(merge.iteration_budget.mode)
  harness.stdio.println(merge.iteration_budget.initial)
  harness.stdio.println(merge.iteration_budget.max)
  harness.stdio.println(merge.iteration_budget.extend_by)
  harness.stdio.println(merge.max_nudges)
  harness.stdio.println(merge._preset_kind)
  harness.stdio.println(merge.turn_policy.allow_done_sentinel)
  // No layers wired without sinks/consent — tool_caller stays unset
  // because the default consent is auto-approve-reads / deny-writes,
  // which IS a layer.
  harness.stdio.println(merge?.tool_caller != nil)
  // (2) review_captain — tool-using profile, medium adaptive budget.
  const review = agent_preset(harness, "review_captain")
  harness.stdio.println(review.profile)
  harness.stdio.println(review.iteration_budget.mode)
  harness.stdio.println(review.iteration_budget.initial)
  harness.stdio.println(review.iteration_budget.max)
  harness.stdio.println(review._preset_kind)
  // No tool middleware default for review_captain.
  harness.stdio.println(review?.tool_caller == nil)
  // (3) oncall_captain — tool_using profile + default rate-limit
  // (max_calls=50) layer wired automatically.
  const oncall = agent_preset(harness, "oncall_captain")
  harness.stdio.println(oncall.profile)
  harness.stdio.println(oncall.iteration_budget.initial)
  harness.stdio.println(oncall.iteration_budget.max)
  harness.stdio.println(oncall?.tool_caller != nil)
  // (4) release_captain — long adaptive budget. Dry-run is opt-in.
  const release = agent_preset(harness, "release_captain")
  harness.stdio.println(release.iteration_budget.initial)
  harness.stdio.println(release.iteration_budget.max)
  harness.stdio.println(release?.tool_caller == nil)
  // (5) Caller-supplied audit/telemetry sinks compose into the stack.
  const audit_sink = { _record -> nil }
  const telemetry_sink = { _span -> nil }
  const merge_with_sinks = agent_preset(
    harness, "merge_captain",
    {audit_sink: audit_sink, telemetry: telemetry_sink},
  )
  harness.stdio.println(merge_with_sinks?.tool_caller != nil)
  // (6) Caller-supplied cheap-default + frontier escalation builds
  // the with_routing-backed llm_caller.
  const cheap = { _call ->
    {
      ok: true,
      value: {text: "cheap", model: "mock", provider: "mock", input_tokens: 0, output_tokens: 0},
    }
  }
  const frontier = { _call ->
    {
      ok: true,
      value: {text: "frontier", model: "mock", provider: "mock", input_tokens: 0, output_tokens: 0},
    }
  }
  const escalate = { _call -> false }
  const routed = agent_preset(
    harness, "release_captain",
    {cheap_caller: cheap, frontier_caller: frontier, escalate_predicate: escalate},
  )
  harness.stdio.println(routed?.llm_caller != nil)
  // (7) Caller-supplied tool_caller wins outright over preset-built layers.
  const custom_caller = { call, next -> next(call) }
  const overridden = agent_preset(
    harness, "merge_captain",
    {tool_caller: custom_caller, audit_sink: audit_sink},
  )
  harness.stdio.println(overridden.tool_caller == custom_caller)
  // (8) merge_captain default consent ALLOWS read-annotated tools and
  // BLOCKS unannotated/write tools. Drive a real agent_loop through
  // both paths to confirm short-circuit behavior.
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "lookup",
    "Read evidence",
    {
      handler: { args -> "evidence: " + to_string(args?.q ?? "") },
      parameters: {q: {type: "string"}},
      annotations: {kind: "read"},
    },
  )
  registry = tool_define(
    registry,
    "delete",
    "Delete a file",
    {
      handler: { args -> "deleted " + to_string(args?.path ?? "") },
      parameters: {path: {type: "string"}},
      annotations: {kind: "delete"},
    },
  )
  with_llm_script(
    harness.llm, [
      {
        tool_calls: [
          {id: "ok1", name: "lookup", arguments: {q: "x"}},
          {id: "block1", name: "delete", arguments: {path: "/tmp/y"}},
        ],
      },
      {tool_calls: [{id: "block1-reproposed", name: "delete", arguments: {path: "/tmp/y"}}]},
      llm_text("<user_response>Done.</user_response>"),
    ],
    { ->
      const merge_run = preset_agent(harness,
        "merge_captain",
        "Try one read and one write.",
        {provider: "mock", tools: registry, tool_format: "native", max_iterations: 3},
      )
      harness.stdio.println(merge_run.status)
      harness.stdio.println(contains(merge_run.tools.successful, "lookup"))
      harness.stdio.println(!contains(merge_run.tools.successful, "delete"))
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "rl1", name: "lookup", arguments: {q: "1"}}]},
      {tool_calls: [{id: "rl2", name: "lookup", arguments: {q: "2"}}]},
      {tool_calls: [{id: "rl3", name: "lookup", arguments: {q: "3"}}]},
      llm_text("<user_response>Stopping.</user_response>"),
    ],
    { ->
      const oncall_capped = preset_agent(harness,
        "oncall_captain",
        "Hammer the same tool.",
        {
          provider: "mock",
          tools: registry,
          tool_format: "native",
          max_iterations: 5,
          rate_limit: {max_calls: 1},
        },
      )
      harness.stdio.println(len(oncall_capped.tools.successful))
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "dr1", name: "delete", arguments: {path: "/tmp/preview"}}]},
      llm_text("<user_response>Dry run preview.</user_response>"),
    ],
    { ->
      const release_dry = preset_agent(harness,
        "release_captain",
        "Preview the action.",
        {
          provider: "mock",
          tools: registry,
          tool_format: "native",
          max_iterations: 3,
          dry_run: true,
        },
      )
      harness.stdio.println(release_dry.status)
      harness.stdio.println(contains(release_dry.tools.successful, "delete"))
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "rv1", name: "lookup", arguments: {q: "review"}}]},
      llm_text("<user_response>Looks good.</user_response>"),
    ],
    { ->
      const review_run = preset_agent(harness,
        "review_captain",
        "Review this PR.",
        {provider: "mock", tools: registry, tool_format: "native"},
      )
      harness.stdio.println(review_run.status)
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "ow1", name: "delete", arguments: {path: "/tmp/yes"}}]},
      llm_text("<user_response>Done.</user_response>"),
    ],
    { ->
      const merge_no_consent = preset_agent(harness,
        "merge_captain",
        "Delete with consent disabled.",
        {
          provider: "mock",
          tools: registry,
          tool_format: "native",
          max_iterations: 3,
          consent: false,
        },
      )
      harness.stdio.println(merge_no_consent.status)
      harness.stdio.println(contains(merge_no_consent.tools.successful, "delete"))
    },
  )
}
