import { agent_convergence_guard_receipt_schema, agent_event_report } from "std/agent/events"
import { convergence_guard_decision, convergence_guard_receipt } from "std/agent/governors"
import { is_type } from "std/schema"

pipeline default() {
  const decision = convergence_guard_decision(
    {},
    {
      output_contract_passed: true,
      post_green_turns: 2,
      post_green_verify_only_retries: 1,
      post_green_task_diff_count: 0,
      required_verification_green: true,
    },
  )
  const receipt = convergence_guard_receipt(decision, {iteration: 4, session_id: "convergence-receipt"})
  const schema = agent_convergence_guard_receipt_schema()
  __io_println(receipt.schema)
  __io_println(receipt.status)
  __io_println(receipt.shape)
  __io_println(receipt.recovery.verb)
  __io_println(receipt.evidence.post_green_turns)
  __io_println(is_type(receipt, schema))
  __io_println(agent_event_report(receipt, schema).ok)
  __io_println(!agent_event_report({schema: receipt.schema, kind: "convergence_guard"}, schema).ok)
}
