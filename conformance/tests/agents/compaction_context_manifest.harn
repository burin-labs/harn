// Auto-compaction is itself a provider call and must be retained on the same
// observed request/manifest spine as the agent turns around it.
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { read_jsonl } from "std/jsonl"
import { llm_done, llm_text, with_llm_script } from "std/testing"

fn evidence_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "lookup",
    "Return deterministic evidence",
    {
      handler: { _args -> "evidence" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

fn main(harness: Harness) {
  with_llm_script(
    harness.llm,
    [
      {tool_calls: [{id: "lookup_1", name: "lookup", arguments: {}}]},
      llm_text("retained goal and latest evidence"),
      llm_done(),
    ],
    { ->
      const transcript_dir = path_join(
        harness.fs.workspace_temp_dir(),
        "harn-compaction-context-manifest-" + harness.random.uuid(),
      )
      const options: AgentSpec = {
        provider: "mock",
        model: "mock",
        tools: evidence_tools(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 2,
        // Keep the request nested, as production hosts do. The outer option
        // bag intentionally has no compact_strategy: reconstructing the
        // receipt from that bag used to misreport this LLM run as masking.
        auto_compact: {enabled: true, token_threshold: 1, keep_last: 1, compact_strategy: "llm"},
        llm_transcript_dir: transcript_dir,
      }
      const result = agent_loop(
        harness,
        "Inspect the evidence and finish.",
        "Keep the task grounded.",
        options,
      )
      const calls = harness.llm.mock_calls()
      const compaction_calls = calls.filter({ call -> call.mock_scope == "compaction" })
      const records = read_jsonl(
        harness.fs,
        path_join(transcript_dir, "llm_transcript.jsonl"),
        {strict: true},
      )
      const requests = records.filter({ record -> record.type == "provider_call_request" })
      const compaction_requests = requests.filter({ record -> record.call_role == "compaction" })
      const manifests = records.filter(
        { record ->
          record.type == "context_manifest" && record.manifest?.call_role == "compaction"
        },
      )
      require result.status == "done"
      const compactions = transcript_events_by_kind(result.transcript, "compaction")
      require len(compactions) > 0
      const receipt = compactions[0].metadata.receipt
      require receipt.requested_strategy == "llm"
      require receipt.engine_strategy == "llm"
      require receipt.resolved_threshold_tokens == 1
      require receipt.threshold_source == "token_threshold"
      require receipt.source_measurement.summary_bytes > 0
      require compactions[0].metadata.summary_bytes == receipt.source_measurement.summary_bytes
      require len(compaction_calls) == 1
      require len(requests) == len(calls)
      require len(compaction_requests) == 1
      require len(manifests) == 1
      const request = compaction_requests[0]
      const manifest = manifests[0]
      require request.served_context.manifest_content_hash == manifest.content_hash
      require request.served_context.system_prompt_bytes == 0
      require request.message_count == 1
      require manifest.manifest.root == "transformed"
      require manifest.manifest.system_prompt_bytes == 0
      require compaction_calls[0].system == nil
      require calls[2].mock_scope == "agent.main"
      require contains(json_stringify(calls[2].messages), "retained goal and latest evidence"),
        "the immediately following agent request must contain the installed summary"
      harness.stdio.println(result.status)
      harness.stdio.println(len(calls))
      harness.stdio.println(request.call_role)
      harness.fs.delete(transcript_dir)
    },
  )
}
