import {
  agent_llm_caller,
  agent_stack,
  agent_stack_audit_line,
  agent_tool_stack,
} from "std/agent/stack"

fn callable(value) -> bool {
  let kind = type_of(value)
  return kind == "function" || kind == "closure" || kind == "fn"
}

pipeline default() {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "lookup",
    "Lookup a record",
    {parameters: {query: "string"}, handler: { _args -> return "ok" }},
  )
  let tool_stack = agent_tool_stack(tools, {required_reason: {field: "why", schema_required: true}, binder: false})
  __io_println(join(tool_stack.wrappers, ","))
  __io_println(callable(tool_stack.tool_caller))
  __io_println(tool_stack.tools.tools[0].parameters.why.type)
  let llm_stack = agent_llm_caller(
    {
      retry: {max_attempts: 2},
      logging: true,
      cache: {namespace: "agent-stack-test"},
      budget: {max_calls: 3},
    },
  )
  __io_println(join(llm_stack.wrappers, ","))
  __io_println(callable(llm_stack.caller))
  let stack = agent_stack({provider: "mock", model: "gpt-4o", tools: tools, required_reason: true, retry: false})
  __io_println(stack.provider)
  __io_println(len(stack.audit.llm_wrappers))
  __io_println(stack.audit.tool_wrappers[0])
  __io_println(
    contains(agent_stack_audit_line(stack), "agent_stack role=agent provider=mock model=gpt-4o"),
  )
  let merged = agent_stack(
    {
      provider: "mock",
      model: "gpt-4o",
      agent_options: {reasoning_effort: "high", prompt_cache: true},
      retry: false,
    },
  )
  __io_println(merged.options.reasoning_effort == nil)
  __io_println(merged.options.prompt_cache == nil)
  __io_println(join(merged.audit.model.stripped, ","))
}
