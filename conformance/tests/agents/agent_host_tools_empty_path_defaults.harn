import { agent_read_tools } from "std/agent/host_tools"
import { agent_dispatch_tool_call } from "std/agent/primitives"

fn main(harness: Harness) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "harn-host-tools-empty-path-" + harness.random.uuid(),
  )
  harness.fs.mkdir(root)
  harness.fs.write_text(path_join(root, "needle.txt"), "alpha needle\n")
  const tools = agent_read_tools(harness.fs, harness.tools, nil, {root: root, cwd: root})
  const listed = agent_dispatch_tool_call(
    harness.tools,
    {name: "list_directory", arguments: {path: ""}},
    tools,
  )
  const searched = agent_dispatch_tool_call(
    harness.tools,
    {name: "search_files", arguments: {path: "", pattern: "needle"}},
    tools,
  )
  harness.stdio.println(listed.ok)
  harness.stdio.println(searched.ok)
  harness.stdio.println(contains(listed.rendered_result, "needle.txt"))
  harness.stdio.println(contains(searched.rendered_result, "needle"))
}
