import { compact_for_bug_fix_resumption } from "std/agent/autocompact"

pipeline test(harness: Harness, task: unknown) {
  const session = harness.agent.open("host-compact-policy")
  harness.agent.inject(session, {role: "user", content: "Investigate the parser regression."})
  harness.agent.inject(
    session,
    {role: "assistant", content: "The root cause is likely in diagnostic recovery."},
  )
  harness.agent.inject(session, {role: "user", content: "Keep the failing tests and next command."})
  const kept = harness.agent.compact(
    session,
    {
      keep_last: 1,
      token_threshold: 1,
      compact_strategy: "custom",
      custom_compactor: { archived, _reminders, policy ->
        {
          summary: "host compact " + policy.mode + " " + policy.author + " "
            + to_string(len(archived)),
        }
      },
      policy: compact_for_bug_fix_resumption({author: "host"}),
    },
  )
  const snapshot = harness.agent.snapshot(session)
  const events = transcript_events_by_kind(snapshot, "compaction")
  const event = events[0]
  harness.stdio.println(trim(transcript_summary(snapshot) ?? "") != "")
  harness.stdio.println(event.metadata?.mode == "host")
  harness.stdio.println(event.metadata?.instruction_mode == "extend")
  harness.stdio.println(event.metadata?.instruction_source == "host")
  harness.stdio.println(kept)
}
