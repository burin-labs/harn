pipeline main() {
  const base = transcript({source: "conformance"})
  const with_asset = transcript_add_asset(
    base,
    {
      kind: "image",
      name: "diagram.png",
      mime_type: "image/png",
      storage: {path: ".harn/assets/diagram.png"},
    },
  )
  const asset_id = transcript_assets(with_asset)[0].id
  const multimodal = add_user(
    with_asset,
    [
      {type: "image", asset_id: asset_id, name: "diagram.png", visibility: "public"},
      {type: "text", text: "review this diagram", visibility: "public"},
    ],
  )
  __io_println(len(transcript_assets(multimodal)) == 1)
  __io_println(transcript_messages(multimodal)[0].content[0].asset_id == asset_id)
  __io_println(contains(transcript_render_visible(multimodal), "diagram.png"))
  const forked = transcript_fork(multimodal)
  __io_println(len(transcript_assets(forked)) == 1)
  const imported = transcript_import(transcript_export(multimodal))
  const imported_assets = transcript_assets(imported)
  __io_println(len(imported_assets) == 1)
}
