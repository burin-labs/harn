import { agent_lifecycle_tools } from "std/agent/workers"

pipeline main() {
  let base = tool_registry()
  let lifecycle = agent_lifecycle_tools(base)
  println(tool_find(lifecycle, "agent_await_resumption")?.name)
  println(tool_find(lifecycle, "subagent_pause") == nil)
  println(tool_find(lifecycle, "subagent_resume") == nil)
  let parent = agent_lifecycle_tools(base, {subagents: true})
  println(tool_find(parent, "agent_await_resumption")?.name)
  println(tool_find(parent, "subagent_pause")?.name)
  println(tool_find(parent, "subagent_resume")?.name)
  let reapplied = agent_lifecycle_tools(parent, {subagents: true})
  println(tool_count(reapplied) == tool_count(parent))
}
