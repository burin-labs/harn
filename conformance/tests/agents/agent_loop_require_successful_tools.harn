import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn tools() {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "lookup",
    "Lookup evidence",
    {
      handler: { _args -> "evidence" },
      parameters: {query: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return registry
}

pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "lookup_1", name: "lookup", arguments: {query: "x"}}]},
      llm_text("Finished."),
    ],
    { ->
      const failed = agent_loop(harness, "Use one tool.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          require_successful_tools: ["missing_tool"],
        },
      )
      harness.stdio.println(failed.status)
      harness.stdio.println(failed.stop_reason)
      harness.stdio.println(failed.missing_required_tools[0])
    },
  )
  with_llm_script(
    harness.llm, [
      {tool_calls: [{id: "lookup_2", name: "lookup", arguments: {query: "x"}}]},
      llm_text("Finished."),
    ],
    { ->
      const satisfied = agent_loop(harness, "Use one tool.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          require_successful_tools: [["lookup", "alternate_reader"]],
        },
      )
      harness.stdio.println(satisfied.status)
      harness.stdio.println(len(satisfied.missing_required_tools ?? []))
    },
  )
  with_llm_script(
    harness.llm, [
      llm_text("Finished before using the required tool."),
      {tool_calls: [{id: "lookup_3", name: "lookup", arguments: {query: "x"}}]},
      llm_text("Finished after using the required tool."),
    ],
    { ->
      const gated = agent_loop(harness, "Use one tool.",
        nil,
        {
          provider: "mock",
          tools: tools(),
          tool_format: "native",
          loop_until_done: true,
          max_iterations: 3,
          max_nudges: 2,
          require_successful_tools: ["lookup"],
        },
      )
      harness.stdio.println(gated.status)
      harness.stdio.println(gated.llm.iterations)
      harness.stdio.println(len(gated.missing_required_tools ?? []))
    },
  )
}
