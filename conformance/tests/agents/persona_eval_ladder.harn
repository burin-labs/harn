pipeline main() {
  const root = project_root() ?? cwd()
  const artifacts = path_join(harness.fs.temp_dir(), "harn-persona-eval-ladder-" + uuid())
  const manifest = persona_eval_ladder_manifest(
    {
      id: "merge-captain-ladder-conformance",
      persona: "merge_captain",
      base_dir: root,
      artifact_root: artifacts,
      backend: {kind: "replay", path: "examples/personas/merge_captain/transcripts/green_pr.jsonl"},
      model_routes: [
        {
          id: "gemma-value",
          route: "local/gemma-value",
          provider: "llama.cpp",
          model: "gemma",
          profile: "value",
        },
      ],
      timeout_tiers: [
        {id: "tiny", max_tool_calls: 1},
        {id: "balanced", max_tool_calls: 4, max_model_calls: 1},
      ],
    },
  )
  const report = persona_eval_ladder_run(manifest)
  __io_println(report.pass)
  __io_println(report.total)
  __io_println(report.first_correct_tier)
  __io_println(report.first_correct_route)
  __io_println(report.tiers[0].outcome)
  __io_println(report.tiers[1].outcome)
  __io_println(len(report.tiers[1].state_machine_coverage.observed_steps) > 0)
  __io_println(harness.fs.exists(report.tiers[1].receipt_path))
}
