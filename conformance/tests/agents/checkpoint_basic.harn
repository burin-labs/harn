pipeline test(harness: Harness, task) {
  // Test checkpoint builtins for resilient pipeline execution.
  // Initially no checkpoint exists
  const val = harness.runtime.checkpoint_get("step1")
  assert(val == nil, "checkpoint_get should return nil for missing key")
  // Set a checkpoint
  harness.runtime.checkpoint("step1", {status: "done", count: 42})
  // Read it back
  const saved = harness.runtime.checkpoint_get("step1")
  assert(saved != nil, "checkpoint_get should return saved value")
  assert(saved.status == "done", "should preserve string field")
  assert(saved.count == 42, "should preserve int field")
  // Overwrite
  harness.runtime.checkpoint("step1", "completed")
  const updated = harness.runtime.checkpoint_get("step1")
  assert(updated == "completed", "checkpoint should overwrite")
  // List checkpoints
  const keys = harness.runtime.checkpoint_list()
  assert(len(keys) == 1, "should have 1 checkpoint key")
  assert(keys[0] == "step1", "key should be step1")
  // Multiple checkpoints
  harness.runtime.checkpoint("step2", true)
  const keys2 = harness.runtime.checkpoint_list()
  assert(len(keys2) == 2, "should have 2 checkpoint keys")
  // Clear all
  harness.runtime.checkpoint_clear()
  const after_clear = harness.runtime.checkpoint_get("step1")
  assert(after_clear == nil, "should be nil after clear")
  harness.stdio.log("checkpoint tests passed")
}
