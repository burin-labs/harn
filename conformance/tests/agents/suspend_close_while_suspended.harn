import "std/agent/workers"
import { with_llm_script } from "std/testing"

/**
 * S-11 (#1847): closing a suspended worker is terminal. Future resume
 * attempts against the same live handle surface HARN-SUS-010.
 *
 * The fixture parks a background subagent, calls `close_agent` while
 * the worker is in `suspended` status, and then asserts that
 * `resume_agent` rejects with the documented diagnostic. A second
 * `close_agent` is idempotent (already-cancelled workers stay
 * cancelled, no panic).
 */
pipeline main(harness: Harness) {
  with_llm_script(
    harness.llm, [
      {
        tool_calls: [
          {
            id: "park_close",
            name: "agent_await_resumption",
            arguments: {reason: "park before close"},
          },
        ],
      },
    ],
    { ->
      const handle = sub_agent_run(harness, "Park, get closed, reject resume.",
        {provider: "mock", background: true, tool_format: "native", max_iterations: 3},
      )
      const suspended = wait_agent(harness.agent, handle)
      harness.stdio.println("pre_close_status=" + suspended.status)
      const closed = close_agent(harness.agent, handle)
      harness.stdio.println("post_close_status=" + closed.status)
      const resume_attempt = try {
        resume_agent(harness.agent, handle)
      }
      harness.stdio.println("resume_failed=" + to_string(is_err(resume_attempt)))
      harness.stdio.println(
        "resume_err_has_code="
          + to_string(
          contains(to_string(unwrap_err(resume_attempt)), "HARN-SUS-010"),
        ),
      )
      const closed_again = close_agent(harness.agent, handle)
      harness.stdio.println("reclose_status=" + closed_again.status)
    },
  )
}
// Resume attempt should reject with HARN-SUS-010.
// Idempotent re-close — does not panic, returns terminal summary.
