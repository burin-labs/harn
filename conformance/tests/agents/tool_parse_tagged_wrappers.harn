// The canonical tagged protocol and the wrapper shapes models substitute for it.
//
// The protocol asks for `<assistant_prose>`, `<user_response>`, `<tool_call>`,
// and `<done>`. Text-mode models wrap their bare calls in `<tool_call>` tags
// unpredictably even when told not to, spell the tags without underscores, or
// drop the wrapper entirely. Each of those is salvage, not a violation: a
// well-wrapped call, a same-line wrapper, a compact alias, and a lone bare call
// all dispatch, and the canonical replay carries the wrapper signal instead of
// spending a turn teaching the model a shape it already got right enough.
import { probe, sample_registry } from "_tool_parse_probe"

pipeline main() {
  // The full canonical response: prose, answer, call, done marker.
  probe(
    "well formed canonical response",
    """<assistant_prose>Creating the file.</assistant_prose>
<user_response>Created the file.</user_response>
<tool_call>
edit({ action: "create", path: "a.rs", content: "fn a() {}" })
</tool_call>
<done>##DONE##</done>""",
    sample_registry(),
  )
  // A properly wrapped call: no violation, no wrapper leak into prose.
  probe(
    "wrapped call parses cleanly",
    """<tool_call>
run({ command: "cargo test" })
</tool_call>""",
    sample_registry(),
  )
  // The qwen3-coder shape: the wrapper opens and closes on the same line as the
  // call. This used to hide the call entirely.
  probe(
    "same-line tool_call wrapper",
    "<tool_call>run({ command: \"cargo test\" })</tool_call>",
    sample_registry(),
  )
  // Wrapper on its own lines with leading prose.
  probe(
    "multiline wrapper with leading prose",
    """I'll find the file.
<tool_call>
run({ command: "cargo test" })
</tool_call>""",
    sample_registry(),
  )
  // The model forgot the OPEN tag and left only a trailing close fragment. The
  // fragment must not survive into visible prose as a `_call>` shard.
  probe(
    "trailing close-tag fragment only",
    """run({ command: "cargo test" })
</tool_call>""",
    sample_registry(),
  )
  // Compact aliases without underscores.
  probe(
    "compact protocol tag aliases",
    """<assistantprose>Checking status.</assistantprose>
<userresponse>Done.</userresponse>
<toolcall>
run({ command: "git status" })
</toolcall>
<done>##DONE##</done>""",
    sample_registry(),
  )
  // A single bare call with no wrapper at all is pure salvage: it executes, it
  // counts as a stray recovery, and it raises no violation, because burning a
  // paid turn after exactly one useful call landed is worse than the drift.
  probe(
    "single bare call, no wrapper",
    "edit({ action: \"create\", path: \"a.rs\", content: \"x\" })",
    sample_registry(),
  )
  probe(
    "two bare calls, no wrapper",
    """edit({ action: "create", path: "a.rs", content: "a" })
edit({ action: "create", path: "b.rs", content: "b" })""",
    sample_registry(),
  )
  // Stray prose before a well-formed block is canonicalized rather than flagged.
  probe(
    "stray prose alongside a tool call",
    """def foo():
    pass

<tool_call>
edit({ action: "create", path: "a.rs", content: "x" })
</tool_call>""",
    sample_registry(),
  )
  // `<user_response>` alone is a complete, valid response.
  probe("user_response only", "<user_response>Visible answer.</user_response>", sample_registry())
  // A non-default done sentinel round-trips verbatim; the agent, not the
  // grammar, decides whether the body matches its configured sentinel.
  probe("configured done body", "<done>PLAN_READY</done>", sample_registry())
  // Empty input is not a violation, and plain prose is salvageable narration.
  probe("empty response", "", sample_registry())
  probe("plain prose response", "just prose with no tags at all", sample_registry())
  // Two blocks in one turn, adjacent with no separator and with a space.
  probe(
    "two tool_call blocks",
    """<tool_call>run({ command: "echo a" })</tool_call>
<tool_call>run({ command: "echo b" })</tool_call>""",
    sample_registry(),
  )
}
