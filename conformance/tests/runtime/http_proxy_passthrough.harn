import { process_shell } from "std/runtime"
import { shell_quote } from "std/runtime"
import { resolve_harn_bin, wait_for_file_content } from "../_common.harn"

pipeline default(harness: Harness) {
  const root = harness.fs.workspace_root()
  const harn_bin = resolve_harn_bin(harness, root)
  const state_dir = path_join(harness.fs.workspace_temp_dir(), "harn-http-proxy-" + harness.random.uuid())
  const port_path = path_join(state_dir, "port")
  const state_path = path_join(state_dir, "state.json")
  const pid_path = path_join(state_dir, "server.pid")
  const log_path = path_join(state_dir, "server.log")
  harness.fs.mkdir(state_dir)
  const start = process_shell(
    harness.process, shell_quote(harn_bin)
      + " conformance-helper http-proxy "
      + shell_quote(state_dir)
      + " >"
      + shell_quote(log_path)
      + " 2>&1 & echo $! > "
      + shell_quote(pid_path),
  )
  require start?.success, "proxy server started"
  // Wait for the port file to hold a non-empty value, not merely to exist:
  // the server creates it before flushing the port number.
  const port = wait_for_file_content(harness,
    port_path,
    { text ->
      const trimmed = trim(text)
      if trimmed != "" {
        return trimmed
      }
      return nil
    },
  )
  require port != nil, "timed out waiting for proxy server to publish its port"
  const proxy = "http://127.0.0.1:" + port
  const response = harness.net.get(
    "http://example.invalid/proxy-check",
    {proxy: proxy, proxy_auth: {user: "user", pass: "pass"}, timeout_ms: 1000},
  )
  // Wait until the recorded request state parses as a complete JSON object,
  // not merely until the file exists: it is written after the proxied request
  // and a bare existence wait can observe a half-written document.
  const state = wait_for_file_content(harness,
    state_path,
    { text ->
      const parsed = try {
        json_parse(text)
      }
      if is_ok(parsed) {
        return unwrap(parsed)
      }
      return nil
    },
  )
  require state != nil, "timed out waiting for proxy server to record the request state"
  process_shell(harness.process, "kill $(cat \"" + pid_path + "\") >/dev/null 2>&1 || true")
  harness.stdio.println(response.body)
  harness.stdio.println(state.method)
  harness.stdio.println(state.target)
  harness.stdio.println(state.headers["proxy-authorization"])
}
