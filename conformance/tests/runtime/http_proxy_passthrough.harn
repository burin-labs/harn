import { process_shell } from "std/runtime"
import { shell_quote } from "std/runtime"
import { resolve_harn_bin } from "../_common.harn"

fn wait_for_file(harness: Harness, path, attempts) {
  let remaining = attempts
  while !harness.fs.exists(path) && remaining > 0 {
    sleep(50ms)
    remaining = remaining - 1
  }
  require harness.fs.exists(path), "timed out waiting for " + path
}

pipeline default() {
  const root = project_root() ?? cwd()
  const harn_bin = resolve_harn_bin(harness, root)
  const state_dir = path_join(harness.fs.temp_dir(), "harn-http-proxy-" + uuid())
  const port_path = path_join(state_dir, "port")
  const state_path = path_join(state_dir, "state.json")
  const pid_path = path_join(state_dir, "server.pid")
  const log_path = path_join(state_dir, "server.log")
  harness.fs.mkdir(state_dir)
  const start = process_shell(
    shell_quote(harn_bin)
      + " conformance-helper http-proxy "
      + shell_quote(state_dir)
      + " >"
      + shell_quote(log_path)
      + " 2>&1 & echo $! > "
      + shell_quote(pid_path),
  )
  require start?.success, "proxy server started"
  wait_for_file(harness, port_path, 100)
  const proxy = "http://127.0.0.1:" + harness.fs.read_text(port_path).trim()
  const response = harness.net
    .get(
    "http://example.invalid/proxy-check",
    {proxy: proxy, proxy_auth: {user: "user", pass: "pass"}, timeout_ms: 1000},
  )
  wait_for_file(harness, state_path, 100)
  process_shell("kill $(cat \"" + pid_path + "\") >/dev/null 2>&1 || true")
  const state = json_parse(harness.fs.read_text(state_path))
  __io_println(response.body)
  __io_println(state.method)
  __io_println(state.target)
  __io_println(state.headers["proxy-authorization"])
}
