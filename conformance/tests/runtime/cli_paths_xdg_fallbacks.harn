import { xdg_cache_home, xdg_config_home, xdg_data_home } from "std/cli/paths"
import { normalize } from "std/path"

fn main(_harness: Harness) {
  const config_expected = if harness.system.platform().os == "darwin" {
    "/home/alice/Library/Application Support/harn"
  } else {
    "/home/alice/.config/harn"
  }
  const data_expected = if harness.system.platform().os == "darwin" {
    "/home/alice/Library/Application Support/harn"
  } else {
    "/home/alice/.local/share/harn"
  }
  const cache_expected = if harness.system.platform().os == "darwin" {
    "/home/alice/Library/Caches/harn"
  } else {
    "/home/alice/.cache/harn"
  }
  harness.stdio.println(normalize(xdg_config_home(harness, "harn")) == config_expected)
  harness.stdio.println(normalize(xdg_data_home(harness, "harn")) == data_expected)
  harness.stdio.println(normalize(xdg_cache_home(harness, "harn")) == cache_expected)
}
