fn main(harness: Harness) {
  const request = {tool_name: "run", arguments: {command: "git status"}}
  const allowed = harness.runtime.evaluate_approval_policy({}, request)
  const asked = harness.runtime.evaluate_approval_policy({require_approval: ["run"]}, request)
  const denied = harness.runtime.evaluate_approval_policy({auto_deny: ["run"]}, request)
  harness.stdio.println(allowed.action)
  harness.stdio.println(asked.action)
  harness.stdio.println(denied.action)
  harness.stdio.println(denied.receipt.type)
  const invalid = try {
    harness.runtime.evaluate_approval_policy({auto_denyy: ["run"]}, request)
  }
  harness.stdio.println(is_err(invalid))
  const unchanged = harness.runtime.evaluate_approval_policy({}, request)
  harness.stdio.println(unchanged.action)
  const memory = {
    rules: [
      {id: "mode-ask", source: "mode", ask: "run"},
      {
        id: "remembered",
        source: "user",
        identity_match: "literal",
        allow: {tool: "run", command: "git diff HEAD~*"},
      },
    ],
  }
  const exact = harness.runtime.evaluate_approval_policy(
    memory,
    {tool_name: "run", arguments: {command: "git diff HEAD~*"}},
  )
  harness.stdio.println(exact.action)
  harness.stdio.println(exact.receipt.matched_rule.id)
  const broadened = harness.runtime.evaluate_approval_policy(
    memory,
    {tool_name: "run", arguments: {command: "git diff HEAD~123"}},
  )
  harness.stdio.println(broadened.action)
  const appended = harness.runtime.evaluate_approval_policy(
    memory,
    {tool_name: "run", arguments: {command: "git diff HEAD~* && curl example.org"}},
  )
  harness.stdio.println(appended.action)
  const malformed = try {
    harness.runtime.evaluate_approval_policy(
      {rules: [{identity_match: "litteral", allow: "run"}]},
      request,
    )
  }
  harness.stdio.println(is_err(malformed))
  const quoted = {
    rules: [
      {source: "mode", ask: "run"},
      {source: "user", identity_match: "literal", allow: {command: "printf '%s' 'a b'"}},
    ],
  }
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      quoted,
      {tool_name: "run", arguments: {command: "printf '%s' 'a b'"}},
    ).action,
  )
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      quoted,
      {tool_name: "run", arguments: {command: "printf '%s' 'a    b'"}},
    ).action,
  )
  const argv = {
    rules: [
      {source: "mode", ask: "run"},
      {source: "user", identity_match: "literal", allow: {command: "echo foo bar"}},
    ],
  }
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      argv,
      {tool_name: "run", arguments: {argv: ["echo", "foo bar"]}},
    ).action,
  )
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      argv,
      {tool_name: "run", arguments: {argv: ["echo", "foo", "bar"]}},
    ).action,
  )
  const resource = {
    rules: [
      {id: "ask", source: "mode", ask: "read"},
      {
        id: "memory",
        source: "user",
        identity_match: "literal",
        allow: {tool: "read", path: "report*.txt"},
      },
    ],
  }
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      resource,
      {tool_name: "read", arguments: {path: "report*.txt"}},
    ).action,
  )
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      resource,
      {tool_name: "read", arguments: {path: "report-2026.txt"}},
    ).action,
  )
  harness.stdio.println(
    harness.runtime.evaluate_approval_policy(
      {rules: [{id: "authored", allow: {path: "report*.txt"}}]},
      {tool_name: "read", arguments: {path: "report-2026.txt"}},
    ).receipt.matched_rule.id,
  )
}
