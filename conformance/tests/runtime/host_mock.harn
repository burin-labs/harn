pipeline test(task) {
  host_mock_clear()
  host_mock("project", "metadata_get", {result: {value: "fallback"}})
  host_mock("project", "metadata_get", {result: {value: "facts"}, params: {namespace: "facts"}})
  host_mock("project", "metadata_set", {error: "write denied", params: {dir: "pkg"}})
  let capabilities = host_capabilities()
  __io_println(host_has("project", "metadata_get"))
  __io_println(capabilities?.project?.operations?.metadata_get?.description != nil)
  let facts = host_call("project.metadata_get", {dir: "pkg", namespace: "facts"})
  __io_println(facts?.value)
  let fallback = host_call("project.metadata_get", {dir: "pkg", namespace: "classification"})
  __io_println(fallback?.value)
  let denied = try {
    host_call("project.metadata_set", {dir: "pkg", namespace: "facts", value: {}})
  }
  __io_println(is_err(denied))
  let calls = host_mock_calls()
  __io_println(calls?.count ?? 0)
  __io_println(calls[0]?.capability)
  __io_println(calls[0]?.operation)
  __io_println(calls[0]?.params?.namespace)
}
