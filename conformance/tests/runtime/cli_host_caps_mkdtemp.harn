// Free-builtin alias coverage for mkdtemp. The canonical capability-aware
// surface is `harness.fs.mkdtemp`.
const dir = mkdtemp("harn-cli-host-caps-")

harness.stdio.println(harness.fs.exists(dir))

harness.stdio.println(dir.starts_with(harness.fs.temp_dir()))

harness.stdio.println(dir.contains("harn-cli-host-caps-"))

harness.fs.delete(dir)

harness.stdio.println(!harness.fs.exists(dir))
