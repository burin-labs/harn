import { xdg_config_home } from "std/cli/paths"

fn config_error(harness: Harness, name: string) -> string {
  return try {
    xdg_config_home(harness, name)
    "ok"
  } catch (e) {
    to_string(e)
  }
}

fn main(_harness: Harness) {
  const message = "std/cli/paths: app_name must be a single path segment"
  harness.stdio.println(config_error(harness, _harness, "") == message)
  harness.stdio.println(config_error(harness, _harness, ".") == message)
  harness.stdio.println(config_error(harness, _harness, "..") == message)
  harness.stdio.println(config_error(harness, _harness, "harn/config") == message)
  harness.stdio.println(config_error(harness, _harness, "harn\\config") == message)
  harness.stdio.println(config_error(harness, _harness, "harn") == "ok")
}
