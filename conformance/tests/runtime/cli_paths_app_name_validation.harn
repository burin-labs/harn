import { xdg_config_home } from "std/cli/paths"

fn config_error(env: HarnessEnv, system: HarnessSystem, name: string) -> string {
  return try {
    xdg_config_home(env, system, name)
    "ok"
  } catch (e) {
    to_string(e)
  }
}

fn main(harness: Harness) {
  const message = "std/cli/paths: app_name must be a single path segment"
  harness.stdio.println(config_error(harness.env, harness.system, "") == message)
  harness.stdio.println(config_error(harness.env, harness.system, ".") == message)
  harness.stdio.println(config_error(harness.env, harness.system, "..") == message)
  harness.stdio.println(config_error(harness.env, harness.system, "harn/config") == message)
  harness.stdio.println(config_error(harness.env, harness.system, "harn\\config") == message)
  harness.stdio.println(config_error(harness.env, harness.system, "harn") == "ok")
}
