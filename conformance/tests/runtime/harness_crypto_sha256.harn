fn main(harness: Harness) {
  const empty = harness.crypto.sha256("")
  const hello = harness.crypto.sha256("hello")
  const hello_bytes = harness.crypto.sha256(bytes_from_string("hello"))
  harness.stdio.println(empty)
  harness.stdio.println(hello)
  harness.stdio.println(hello == hello_bytes)
  harness.stdio.println(hello == sha256_hex("hello"))
}
