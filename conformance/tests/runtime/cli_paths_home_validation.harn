import { xdg_config_home } from "std/cli/paths"

fn main(harness: Harness) {
  const message = try {
    xdg_config_home(harness.env, harness.system, "harn")
    "ok"
  } catch (e) {
    to_string(e)
  }
  harness.stdio.println(message == "std/cli/paths: HOME or USERPROFILE must be an absolute path")
}
