pipeline test(harness: Harness, task) {
  http_mock(
    "GET",
    "https://api.example.com/retry-after",
    {responses: [{status: 429, headers: {"retry-after": "0"}}, {status: 200, body: "ok"}]},
  )
  const resp = harness.net.get(
    "https://api.example.com/retry-after",
    {retry: {max: 1, backoff_ms: 0}},
  )
  const calls = http_mock_calls()
  assert_eq(resp.status, 200)
  assert_eq(len(calls), 2)
  harness.stdio.println("retry-after status: " + to_string(resp.status))
  harness.stdio.println("retry-after calls: " + to_string(len(calls)))
}
