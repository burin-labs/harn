import "std/runtime"

pipeline default() {
  host_mock("runtime", "task", "demo-task")
  host_mock("runtime", "pipeline_input", {message: "hello"})
  host_mock("runtime", "prompt_content", [{type: "text", text: "hello blocks"}])
  host_mock("runtime", "dry_run", true)
  host_mock("runtime", "approved_plan", "ship it")
  __io_println(runtime_task())
  __io_println(runtime_pipeline_input()?.message)
  __io_println(runtime_prompt_content()[0]?.text ?? "")
  __io_println(runtime_dry_run())
  __io_println(runtime_approved_plan())
  const result = process_shell("printf ok")
  __io_println(result?.success)
  __io_println(result?.combined)
  const argv = if platform() == "windows" {
    ["cmd", "/C", "echo|set /p=argv-ok"]
  } else {
    ["printf", "argv-ok"]
  }
  const argv_result = process_run(argv, {timeout_ms: 5000})
  __io_println(argv_result?.success)
  __io_println(process_result_text(argv_result))
}
