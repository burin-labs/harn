pipeline default(harness: Harness) {
  harness.testing.http_mock("POST", "https://api.example.com/upload", {status: 201, body: "uploaded", headers: {}})
  const response = harness.net.post(
    "https://api.example.com/upload",
    {
      multipart: [
        {name: "meta", value: "hello"},
        {name: "blob", filename: "blob.txt", content_type: "text/plain", value: "payload"},
      ],
    },
  )
  const calls = harness.testing.http_mock_calls()
  const body = calls[0].body ?? ""
  harness.stdio.println(response.status)
  harness.stdio.println(calls[0].headers["content-type"])
  harness.stdio.println(contains(body, "name=\"meta\""))
  harness.stdio.println(contains(body, "hello"))
  harness.stdio.println(contains(body, "filename=\"blob.txt\""))
}
