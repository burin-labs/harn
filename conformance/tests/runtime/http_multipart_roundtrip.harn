pipeline default() {
  http_mock("POST", "https://api.example.com/upload", {status: 201, body: "uploaded", headers: {}})
  const response = harness.net.post(
    "https://api.example.com/upload",
    {
      multipart: [
        {name: "meta", value: "hello"},
        {name: "blob", filename: "blob.txt", content_type: "text/plain", value: "payload"},
      ],
    },
  )
  const calls = http_mock_calls()
  const body = calls[0].body ?? ""
  __io_println(response.status)
  __io_println(calls[0].headers["content-type"])
  __io_println(contains(body, "name=\"meta\""))
  __io_println(contains(body, "hello"))
  __io_println(contains(body, "filename=\"blob.txt\""))
}
