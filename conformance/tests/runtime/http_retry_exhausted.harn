pipeline test(harness: Harness, task: unknown) {
  harness.testing.http_mock(
    "GET",
    "https://api.example.com/retry-exhausted",
    {responses: [{status: 503}, {status: 503}, {status: 503}]},
  )
  const resp = harness.net.get(
    "https://api.example.com/retry-exhausted",
    {retry: {max: 2, backoff_ms: 0}},
  )
  const calls = harness.testing.http_mock_calls()
  assert_eq(resp.status, 503)
  assert_eq(len(calls), 3)
  harness.stdio.log("exhausted status: " + to_string(resp.status))
  harness.stdio.log("exhausted calls: " + to_string(len(calls)))
}
