import "std/project"

const root = path_join(harness.fs.temp_dir(), "meta_scratch")

harness.fs.mkdir(root)

harness.fs.mkdir(path_join(root, "src"))

harness.fs.mkdir(path_join(root, "src/deep"))

harness.fs.write_text(path_join(root, "root.txt"), "root")

harness.fs.write_text(path_join(root, ".hidden.txt"), "secret")

harness.fs.write_text(path_join(root, "src/deep/nested.txt"), "nested")

harness.fs.write_text(path_join(root, "src/deep/code.rs"), "fn " + "main() {}")

metadata_set("", "classification", {language: "rust", structureHash: "stale"})

metadata_set("src", "classification", {owner: "vm"})

metadata_set("src", "facts", {kind: "module"})

const resolved = metadata_resolve("src", "classification")

__io_println(resolved.language == "rust")

__io_println(resolved.owner == "vm")

const all_resolved = metadata_resolve("src")

__io_println(all_resolved.classification.language == "rust")

__io_println(all_resolved.facts.kind == "module")

const entries = metadata_entries("classification")

__io_println(entries[0].dir == ".")

__io_println(entries[1].dir == "src")

__io_println(entries[1].resolved.language == "rust")

__io_println(entries[1].local.owner == "vm")

const status = metadata_status("classification")

__io_println(status.directory_count == 2)

__io_println(status.namespace_count == 2)

__io_println(status.namespaces[0] == "classification")

__io_println(status.namespaces[1] == "facts")

__io_println(status.missing_content_hash[0] == ".")

__io_println(status.stale.any_stale)

__io_println(status.stale.tier1[0] == ".")

const inventory = project_inventory("classification")

__io_println(inventory.status.directory_count == 2)

__io_println(metadata_namespace("src", "classification").owner == "vm")

__io_println(metadata_local_namespace("src", "classification").owner == "vm")

__io_println(project_requires_refresh("classification"))

const shallow = scan_directory(root, {pattern: ".txt", include_dirs: false, max_depth: 0})

__io_println(shallow[0].path == path_join(root, "root.txt"))

let saw_hidden = false

for entry in shallow {
  if entry.path == path_join(root, ".hidden.txt") {
    saw_hidden = true
  }
}

__io_println(!saw_hidden)

const with_hidden = scan_directory(
  root,
  {pattern: ".txt", include_dirs: false, max_depth: 1, include_hidden: true},
)

let found_hidden = false

for entry in with_hidden {
  if entry.path == path_join(root, ".hidden.txt") {
    found_hidden = true
  }
}

__io_println(found_hidden)
