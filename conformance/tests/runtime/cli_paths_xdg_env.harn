import { xdg_cache_home, xdg_config_home, xdg_data_home } from "std/cli/paths"
import { normalize } from "std/path"

fn main(harness: Harness) {
  harness.stdio.println(normalize(xdg_config_home(harness, "harn")) == "/xdg/config/harn")
  harness.stdio.println(normalize(xdg_data_home(harness, "harn")) == "/xdg/data/harn")
  harness.stdio.println(normalize(xdg_cache_home(harness, "harn")) == "/xdg/cache/harn")
}
