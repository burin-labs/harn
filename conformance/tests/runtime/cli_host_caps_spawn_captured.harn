// Legacy free-builtin alias for `harness.process.spawn_captured`.
// Verifies the synchronous capture shape stays shared by both surfaces.
let ok = spawn_captured({cmd: "printf", args: ["hi"]})

__io_println(ok.exit_code)

__io_println(ok.stdout)

__io_println(ok.success)

__io_println(ok.timed_out)

__io_println(ok.duration_ms >= 0)

let fail = spawn_captured({cmd: "sh", args: ["-c", "exit 7"]})

__io_println(fail.exit_code)

__io_println(fail.success)
