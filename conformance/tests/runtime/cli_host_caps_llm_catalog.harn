// Free-builtin alias for `harness.llm.catalog()`. Verifies the catalog
// returns a list of dicts with the expected shape. Doesn't assert
// specific model ids (the catalog evolves with provider releases) —
// just shape.
const entries = harness.llm.catalog()

harness.stdio.println(len(entries) > 0)

const first = entries[0]

harness.stdio.println(first.id != nil)

harness.stdio.println(first.provider != nil)

harness.stdio.println(first.capabilities != nil)

harness.stdio.println(first.context_window >= 0)
