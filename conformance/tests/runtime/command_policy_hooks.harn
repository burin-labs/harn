import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

pipeline default(harness: Harness) {
  const root = path_join(harness.fs.workspace_temp_dir(), "harn_command_policy_hooks")
  if harness.fs.exists(root) {
    harness.fs.delete(root)
  }
  harness.fs.mkdir(root)
  const marker = path_join(root, "should_not_spawn")
  const policy = command_policy(
    {
      workspace_roots: [root],
      deny_patterns: ["*policy-deny-marker*"],
      require_approval: ["credential_file_read"],
      pre: { ctx ->
        const argv = ctx?.request?.argv ?? []
        if len(argv) > 0 && argv[0] == "printf" {
          return {rewrite: {argv: ["printf", "rewritten"]}}
        }
        return nil
      },
      post: { ctx ->
        if ctx?.result?.stdout == "rewritten" {
          return {annotations: {checked: true}}
        }
        return nil
      },
    },
  )
  harness.runtime.command_policy_push(policy)
  const denied = harness.process.run(
    {
      program: "sh",
      args: ["-c", "echo spawned > \"" + marker + "\"; echo policy-deny-marker"],
      cwd: root,
    },
  )
  assert(denied?.status == "blocked", "deny decision returns blocked envelope")
  assert(!harness.fs.exists(marker), "blocked command must not spawn")
  const hostlib_marker = path_join(root, "hostlib_should_not_spawn")
  const hostlib_denied = harness.tools.run_command(
    {
      argv: ["sh", "-c", "echo spawned > \"" + hostlib_marker + "\"; echo policy-deny-marker"],
      cwd: root,
    },
  )
  assert(hostlib_denied?.status == "blocked", "hostlib command observes the same deny policy")
  assert(
    hostlib_denied?.handle_id == nil,
    "blocked hostlib command does not return a process handle",
  )
  assert(!harness.fs.exists(hostlib_marker), "blocked hostlib command must not spawn")
  const rewritten = harness.process.run({program: "printf", args: ["original"], cwd: root})
  assert(rewritten?.stdout == "rewritten", "pre-hook rewrite updates argv")
  assert(
    rewritten?.command_policy?.annotation?.annotations?.checked,
    "post-hook annotation is recorded in command audit",
  )
  const hostlib_rewritten = harness.tools.run_command({argv: ["printf", "original"], cwd: root})
  assert(hostlib_rewritten?.stdout == "rewritten", "pre-hook rewrite applies to hostlib argv")
  assert(
    hostlib_rewritten?.command_policy?.annotation?.annotations?.checked,
    "post-hook annotation is recorded on the hostlib result",
  )
  harness.fs.write_text(path_join(root, ".env"), "TOKEN=secret\n")
  const approval = harness.process.run({program: "cat", args: [path_join(root, ".env")], cwd: root})
  assert(
    approval?.status == "blocked",
    "approval risk blocks before spawn without a host approval grant",
  )
  assert(contains(approval?.stderr ?? "", "requires approval"), "approval reason is surfaced")
  const hostlib_approval = harness.tools.run_command(
    {argv: ["cat", path_join(root, ".env")], cwd: root},
  )
  assert(hostlib_approval?.status == "blocked", "hostlib approval risk blocks before spawn")
  harness.runtime.command_policy_pop()
  // ---- Consent gate ----
  // With a `consent` closure configured (the `with_consent` prompt_fn
  // contract), a `require_approval` risk class routes through consent instead
  // of hard-denying: an approval lets the command run; a denial blocks it with
  // a `consent_denied` disposition. This is the seam that lets a command-safety
  // floor REQUEST CONSENT rather than only allow/deny.
  const consent_asks = harness.runtime.atomic(0)
  const approve_policy = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["credential_file_read"],
      consent: { ctx ->
        harness.runtime.atomic_add(consent_asks, 1)
        assert(
          contains(ctx?.consent?.risk_labels ?? [], "credential_file_read"),
          "consent callback sees the deterministic risk classification",
        )
        return {decision: "approved", decided_by: "test"}
      },
    },
  )
  harness.runtime.command_policy_push(approve_policy)
  const approved = harness.process.run({program: "cat", args: [path_join(root, ".env")], cwd: root})
  assert(
    harness.runtime.atomic_get(consent_asks) == 1,
    "consent ask fires for a require_approval command",
  )
  assert(approved?.status != "blocked", "consented command is not blocked")
  assert(approved?.status != "consent_denied", "consented command is not consent-denied")
  assert(contains(approved?.stdout ?? "", "TOKEN=secret"), "consented command actually runs")
  harness.runtime.command_policy_pop()
  // Denial via the dict form blocks execution with a consent_denied status.
  const deny_marker = path_join(root, "consent_should_not_spawn")
  const deny_policy = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["credential_file_read"],
      consent: { ctx -> return {decision: "denied", reason: "not this time"} },
    },
  )
  harness.runtime.command_policy_push(deny_policy)
  const refused = harness.process.run(
    {
      program: "sh",
      args: ["-c", "cat \"" + path_join(root, ".env") + "\"; echo x > \"" + deny_marker + "\""],
      cwd: root,
    },
  )
  assert(refused?.status == "consent_denied", "denied consent yields a consent_denied disposition")
  assert(!harness.fs.exists(deny_marker), "consent-denied command must not spawn")
  assert(contains(refused?.stderr ?? "", "not this time"), "consent denial reason is surfaced")
  const hostlib_refused = harness.tools.run_command(
    {argv: ["cat", path_join(root, ".env")], cwd: root},
  )
  assert(hostlib_refused?.status == "consent_denied", "hostlib preserves consent-denied status")
  assert(
    contains(hostlib_refused?.stderr ?? "", "not this time"),
    "hostlib surfaces consent reason",
  )
  harness.runtime.command_policy_pop()
  // Bool-false shorthand denies too (with_consent prompt_fn parity).
  const bool_deny = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["credential_file_read"],
      consent: { ctx -> return false },
    },
  )
  harness.runtime.command_policy_push(bool_deny)
  const bool_refused = harness.process.run(
    {program: "cat", args: [path_join(root, ".env")], cwd: root},
  )
  assert(bool_refused?.status == "consent_denied", "bool-false consent blocks execution")
  harness.runtime.command_policy_pop()
  // ---- Catastrophic (never-approvable) command floor ----
  // A catastrophic command is HARD-DENIED before the child spawns and is NEVER
  // routed to the consent gate — even when a would-approve consent closure is
  // configured AND `catastrophic` is listed in require_approval. This is the
  // floor burin's twin command-safety checkers collapse onto.
  const floor_asks = harness.runtime.atomic(0)
  const floor_policy = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["catastrophic", "credential_file_read"],
      consent: { ctx ->
        harness.runtime.atomic_add(floor_asks, 1)
        return {decision: "approved"}
      },
    },
  )
  harness.runtime.command_policy_push(floor_policy)
  // argv-mode catastrophe: `git reset --hard` is blocked even though a consent
  // closure would approve it.
  const reset_blocked = harness.process.run({program: "git", args: ["reset", "--hard"], cwd: root})
  assert(reset_blocked?.status == "blocked", "catastrophic git reset --hard is hard-denied")
  assert(reset_blocked?.status != "consent_denied", "catastrophic is not a consent disposition")
  assert(
    contains(reset_blocked?.stderr ?? "", "git reset --hard"),
    "catastrophic reason is surfaced",
  )
  assert(
    harness.runtime.atomic_get(floor_asks) == 0,
    "catastrophic floor never consults the consent gate",
  )
  // The canonical agent shape is argv mode with an `sh -c "<script>"` wrapper.
  // A token-based rule inside the wrapped script (`git reset --hard`) must still
  // hard-deny — the floor preserves argv argument boundaries.
  const wrapped_marker = path_join(root, "wrapped_should_not_spawn")
  const wrapped_blocked = harness.process.run(
    {
      program: "sh",
      args: ["-c", "git reset --hard; echo x > \"" + wrapped_marker + "\""],
      cwd: root,
    },
  )
  assert(wrapped_blocked?.status == "blocked", "argv sh -c wrapped catastrophe is hard-denied")
  assert(!harness.fs.exists(wrapped_marker), "wrapped catastrophic command must not spawn")
  assert(
    contains(wrapped_blocked?.stderr ?? "", "git reset --hard"),
    "wrapped catastrophic reason is surfaced",
  )
  assert(
    harness.runtime.atomic_get(floor_asks) == 0,
    "wrapped catastrophic floor never consults the consent gate",
  )
  harness.runtime.command_policy_pop()
  const background_marker = path_join(root, "background_should_not_spawn")
  const background_policy = command_policy(
    {workspace_roots: [root], deny_patterns: ["*background-policy-deny*"]},
  )
  harness.runtime.command_policy_push(background_policy)
  const background_blocked = harness.tools.run_command(
    {
      argv: ["sh", "-c", "echo x > \"" + background_marker + "\"; echo background-policy-deny"],
      cwd: root,
      background: true,
    },
  )
  assert(
    background_blocked?.status == "blocked",
    "background hostlib command is denied before spawn",
  )
  assert(background_blocked?.handle_id == nil, "denied background command has no process handle")
  assert(!harness.fs.exists(background_marker), "denied background command never starts")
  harness.runtime.command_policy_pop()
  const invalid_post_calls = harness.runtime.atomic(0)
  const invalid_post_policy = command_policy(
    {
      workspace_roots: [root],
      post: { _ctx ->
        harness.runtime.atomic_add(invalid_post_calls, 1)
        return {result: {status: "completed"}}
      },
    },
  )
  let invalid_post_rejected = false
  harness.runtime.command_policy_push(invalid_post_policy)
  try {
    harness.tools.run_command({argv: ["printf", "valid-before-post"], cwd: root})
  } catch {
    invalid_post_rejected = true
  } finally {
    harness.runtime.command_policy_pop()
  }
  assert(
    harness.runtime.atomic_get(invalid_post_calls) == 1,
    "the invalid replacement reached command postflight",
  )
  assert(
    invalid_post_rejected,
    "a post hook cannot replace a command result with an invalid response",
  )
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "run",
    "Run a command",
    {
      parameters: {command: {type: "string"}},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
      handler: { args ->
        harness.process.run({program: "sh", args: ["-c", args.command], cwd: root})
      },
    },
  )
  with_llm_script(
    harness.llm,
    [
      {tool_calls: [{id: "run_1", name: "run", arguments: {command: "echo agent-policy-deny"}}]},
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      const loop = agent_loop(
        harness,
        "exercise command policy",
        nil,
        {
          provider: "mock",
          tools: tools,
          max_iterations: 2,
          command_policy: command_policy(policy + {deny_patterns: ["*agent-policy-deny*"]}),
          session_id: "command-policy-hooks",
        },
      )
      assert(
        contains(json_stringify(loop), "status: blocked"),
        "agent_loop scoped command policy applies to run handlers",
      )
      const scan = command_llm_risk_scan(
        {request: {argv: ["curl", "https://example.invalid/secret"]}},
        {model: "cheap"},
      )
      assert(len(scan?.risk_labels ?? []) > 0, "risk scan helper returns structured labels")
      harness.fs.delete(root)
      harness.stdio.println("command_policy_hooks_ok")
    },
  )
}
