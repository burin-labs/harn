import { llm_text, with_llm_script } from "std/testing"

pipeline default() {
  let root = path_join(harness.fs.temp_dir(), "harn_command_policy_hooks")
  if harness.fs.exists(root) {
    harness.fs.delete(root)
  }
  harness.fs.mkdir(root)
  let marker = path_join(root, "should_not_spawn")
  let policy = command_policy(
    {
      workspace_roots: [root],
      deny_patterns: ["*policy-deny-marker*"],
      require_approval: ["credential_file_read"],
      pre: { ctx ->
        let argv = ctx?.request?.argv ?? []
        if len(argv) > 0 && argv[0] == "printf" {
          return {rewrite: {argv: ["printf", "rewritten"]}}
        }
        return nil
      },
      post: { ctx ->
        if ctx?.result?.stdout == "rewritten" {
          return {annotations: {checked: true}}
        }
        return nil
      },
    },
  )
  command_policy_push(policy)
  let denied = host_call(
    "process.exec",
    {
      mode: "argv",
      argv: ["sh", "-c", "echo spawned > \"" + marker + "\"; echo policy-deny-marker"],
      cwd: root,
    },
  )
  assert(denied?.status == "blocked", "deny decision returns blocked envelope")
  assert(!harness.fs.exists(marker), "blocked command must not spawn")
  let rewritten = host_call("process.exec", {mode: "argv", argv: ["printf", "original"], cwd: root})
  assert(rewritten?.stdout == "rewritten", "pre-hook rewrite updates argv")
  assert(
    rewritten?.command_policy?.annotation?.annotations?.checked,
    "post-hook annotation is recorded in command audit",
  )
  harness.fs.write_text(path_join(root, ".env"), "TOKEN=secret\n")
  let approval = host_call("process.exec", {mode: "argv", argv: ["cat", path_join(root, ".env")], cwd: root})
  assert(
    approval?.status == "blocked",
    "approval risk blocks before spawn without a host approval grant",
  )
  assert(contains(approval?.stderr ?? "", "requires approval"), "approval reason is surfaced")
  command_policy_pop()
  // ---- Consent gate ----
  // With a `consent` closure configured (the `with_consent` prompt_fn
  // contract), a `require_approval` risk class routes through consent instead
  // of hard-denying: an approval lets the command run; a denial blocks it with
  // a `consent_denied` disposition. This is the seam that lets a command-safety
  // floor REQUEST CONSENT rather than only allow/deny.
  let consent_asks = atomic(0)
  let approve_policy = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["credential_file_read"],
      consent: { ctx ->
        atomic_add(consent_asks, 1)
        assert(
          contains(ctx?.consent?.risk_labels ?? [], "credential_file_read"),
          "consent callback sees the deterministic risk classification",
        )
        return {decision: "approved", decided_by: "test"}
      },
    },
  )
  command_policy_push(approve_policy)
  let approved = host_call("process.exec", {mode: "argv", argv: ["cat", path_join(root, ".env")], cwd: root})
  assert(atomic_get(consent_asks) == 1, "consent ask fires for a require_approval command")
  assert(approved?.status != "blocked", "consented command is not blocked")
  assert(approved?.status != "consent_denied", "consented command is not consent-denied")
  assert(contains(approved?.stdout ?? "", "TOKEN=secret"), "consented command actually runs")
  command_policy_pop()
  // Denial via the dict form blocks execution with a consent_denied status.
  let deny_marker = path_join(root, "consent_should_not_spawn")
  let deny_policy = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["credential_file_read"],
      consent: { ctx -> return {decision: "denied", reason: "not this time"} },
    },
  )
  command_policy_push(deny_policy)
  let refused = host_call(
    "process.exec",
    {
      mode: "argv",
      argv: ["sh", "-c", "cat \"" + path_join(root, ".env") + "\"; echo x > \"" + deny_marker + "\""],
      cwd: root,
    },
  )
  assert(refused?.status == "consent_denied", "denied consent yields a consent_denied disposition")
  assert(!harness.fs.exists(deny_marker), "consent-denied command must not spawn")
  assert(contains(refused?.stderr ?? "", "not this time"), "consent denial reason is surfaced")
  command_policy_pop()
  // Bool-false shorthand denies too (with_consent prompt_fn parity).
  let bool_deny = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["credential_file_read"],
      consent: { ctx -> return false },
    },
  )
  command_policy_push(bool_deny)
  let bool_refused = host_call("process.exec", {mode: "argv", argv: ["cat", path_join(root, ".env")], cwd: root})
  assert(bool_refused?.status == "consent_denied", "bool-false consent blocks execution")
  command_policy_pop()
  // ---- Catastrophic (never-approvable) command floor ----
  // A catastrophic command is HARD-DENIED before the child spawns and is NEVER
  // routed to the consent gate — even when a would-approve consent closure is
  // configured AND `catastrophic` is listed in require_approval. This is the
  // floor burin's twin command-safety checkers collapse onto.
  let floor_asks = atomic(0)
  let floor_policy = command_policy(
    {
      workspace_roots: [root],
      require_approval: ["catastrophic", "credential_file_read"],
      consent: { ctx ->
        atomic_add(floor_asks, 1)
        return {decision: "approved"}
      },
    },
  )
  command_policy_push(floor_policy)
  // argv-mode catastrophe: `git reset --hard` is blocked even though a consent
  // closure would approve it.
  let reset_blocked = host_call("process.exec", {mode: "argv", argv: ["git", "reset", "--hard"], cwd: root})
  assert(reset_blocked?.status == "blocked", "catastrophic git reset --hard is hard-denied")
  assert(reset_blocked?.status != "consent_denied", "catastrophic is not a consent disposition")
  assert(contains(reset_blocked?.stderr ?? "", "git reset --hard"), "catastrophic reason is surfaced")
  // Redirection onto a source file is catastrophic and must not spawn.
  let floor_marker = path_join(root, "floor_should_not_spawn.rs")
  let redirect_blocked = host_call(
    "process.exec",
    {mode: "argv", argv: ["sh", "-c", "echo pwned > \"" + floor_marker + "\""], cwd: root},
  )
  assert(redirect_blocked?.status == "blocked", "redirect onto a source file is hard-denied")
  assert(!harness.fs.exists(floor_marker), "catastrophic command must not spawn")
  assert(atomic_get(floor_asks) == 0, "catastrophic floor never consults the consent gate")
  // The canonical agent shape is argv mode with an `sh -c "<script>"` wrapper.
  // A token-based rule inside the wrapped script (`git reset --hard`) must still
  // hard-deny — the floor preserves argv argument boundaries.
  let wrapped_marker = path_join(root, "wrapped_should_not_spawn")
  let wrapped_blocked = host_call(
    "process.exec",
    {
      mode: "argv",
      argv: ["sh", "-c", "git reset --hard; echo x > \"" + wrapped_marker + "\""],
      cwd: root,
    },
  )
  assert(wrapped_blocked?.status == "blocked", "argv sh -c wrapped catastrophe is hard-denied")
  assert(!harness.fs.exists(wrapped_marker), "wrapped catastrophic command must not spawn")
  assert(
    contains(wrapped_blocked?.stderr ?? "", "git reset --hard"),
    "wrapped catastrophic reason is surfaced",
  )
  assert(atomic_get(floor_asks) == 0, "wrapped catastrophic floor never consults the consent gate")
  command_policy_pop()
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "run",
    "Run a command",
    {
      parameters: {command: {type: "string"}},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
      handler: { args -> host_call("process.exec", {mode: "argv", argv: ["sh", "-c", args.command], cwd: root}) },
    },
  )
  with_llm_script(
    [
      {tool_calls: [{id: "run_1", name: "run", arguments: {command: "echo agent-policy-deny"}}]},
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      let loop = agent_loop(
        "exercise command policy",
        nil,
        {
          provider: "mock",
          tools: tools,
          max_iterations: 2,
          command_policy: command_policy(policy + {deny_patterns: ["*agent-policy-deny*"]}),
          session_id: "command-policy-hooks",
        },
      )
      assert(
        contains(json_stringify(loop), "status: blocked"),
        "agent_loop scoped command policy applies to run handlers",
      )
      let scan = command_llm_risk_scan(
        {request: {argv: ["curl", "https://example.invalid/secret"]}},
        {model: "cheap"},
      )
      assert(len(scan?.risk_labels ?? []) > 0, "risk scan helper returns structured labels")
      harness.fs.delete(root)
      __io_println("command_policy_hooks_ok")
    },
  )
}
