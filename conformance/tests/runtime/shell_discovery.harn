pipeline default() {
  const catalog = host_call("process.list_shells", {})
  const default_shell = host_call("process.get_default_shell", {})
  const invocation = host_call(
    "process.shell_invocation",
    {shell_id: default_shell?.id, command: "printf shell-contract"},
  )
  __io_println(len(catalog?.shells) > 0)
  __io_println(catalog?.default_shell_id == default_shell?.id)
  __io_println(invocation?.program == default_shell?.path)
  __io_println(invocation?.args != nil)
  const result = host_call(
    "process.exec",
    {mode: "shell", shell_id: default_shell?.id, command: "printf shell-contract"},
  )
  __io_println(result?.stdout)
}
