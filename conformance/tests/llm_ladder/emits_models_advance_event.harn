import { with_llm_script } from "std/testing"

/**
 * A ladder step advance emits a dedicated `llm_models_advance` trace event
 * (surfaced through `harness.obs.agent_trace()`) carrying the from/to models and the
 * transport failure category that drove the escalation.
 */
pipeline test(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [
      {
        error: {category: "rate_limit", message: "HTTP 429", retry_after_ms: 10},
        model: "mock",
        provider: "mock",
      },
      {text: "ok", model: "mock-strong", provider: "mock"},
    ],
    { ->
      const _ = harness.llm.call(
        "hi",
        nil,
        {models: [{model: "mock", provider: "mock"}, {model: "mock-strong", provider: "mock"}]},
      )
      const advances = harness.obs.agent_trace().filter({ e -> e.type == "models_advance" })
      harness.stdio.println(len(advances))
      harness.stdio.println(advances[0].from_index)
      harness.stdio.println(advances[0].from_model)
      harness.stdio.println(advances[0].to_model)
      harness.stdio.println(advances[0].category)
    },
  )
}
