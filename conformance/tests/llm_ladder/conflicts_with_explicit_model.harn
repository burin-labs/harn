import { with_llm_script } from "std/testing"

/**
 * A `models:` ladder already declares every rung's model/provider, so
 * combining it with a standalone `model:` pin is ambiguous and must error
 * before any provider work happens.
 */
pipeline test(task) {
  with_llm_script(
    [{text: "should never run", model: "mock", provider: "mock"}],
    { ->
      let out = try {
        llm_call("hi", nil, {models: ["mock-a", "mock-b"], model: "pinned"})
      } catch (e) {
        {msg: to_string(e)}
      }
      __io_println(contains(out.msg, "cannot be combined"))
    },
  )
}
