import "../_common"

pipeline default() {
  const repo_root = exec("git", "rev-parse", "--show-toplevel").stdout.trim()
  const harn_bin = harness.env.get_or(
    "HARN_CONFORMANCE_HARN_BIN",
    resolve_harn_bin(harness, repo_root),
  )
  const root = path_join(harness.fs.temp_dir(), "harn_persona_scaffolder_" + uuid_v7())
  harness.fs.mkdir(root)
  const created = exec_at(
    root,
    harn_bin,
    "persona",
    "new",
    "my_release_captain",
    "--template",
    "deterministic-sweeper",
  )
  __io_println(created.success)
  const persona_dir = path_join(root, "personas/my_release_captain")
  __io_println(harness.fs.exists(path_join(persona_dir, "harn.toml")))
  __io_println(harness.fs.exists(path_join(persona_dir, "src/my_release_captain.harn")))
  __io_println(harness.fs.exists(path_join(persona_dir, "tests/my_release_captain_smoke.harn")))
  __io_println(harness.fs.exists(path_join(persona_dir, "tests/my_release_captain_smoke.expected")))
  __io_println(harness.fs.exists(path_join(persona_dir, "fixtures/happy_path.json")))
  __io_println(harness.fs.exists(path_join(persona_dir, "evals/smoke.eval.json")))
  const doctor = exec_at(root, harn_bin, "persona", "doctor", "my_release_captain", "--json")
  __io_println(doctor.success)
  const report = json_parse(doctor.stdout)
  __io_println(report.persona)
  __io_println(len(report.checks) >= 6)
  const smoke = exec_at(persona_dir, harn_bin, "test", "tests/my_release_captain_smoke.harn")
  __io_println(smoke.success)
}
