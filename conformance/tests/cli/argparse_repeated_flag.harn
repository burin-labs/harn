import { parse, parser } from "std/cli/argparse"

fn main(harness: Harness) {
  const spec = parser(
    {name: "demo", args: [{name: "model", kind: "flag", short: "-m", long: "--model", multi: true}]},
  )
  const r = parse(spec, ["-m", "a", "--model", "b", "--model=c"])
  harness.stdio.println(len(r.ok.model))
  for m in r.ok.model {
    harness.stdio.println(m)
  }
}
