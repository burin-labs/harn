import { parse, parser } from "std/cli/argparse"

fn main(harness: Harness) {
  const spec = parser(
    {name: "demo", args: [{name: "model", kind: "flag", short: "-m", long: "--model", multi: true}]},
  )
  const invocation = unwrap(parse(spec, ["-m", "a", "--model", "b", "--model=c"]))
  harness.stdio.println(len(invocation.options.model))
  for m in invocation.options.model {
    harness.stdio.println(m)
  }
}
