import { parse, parser } from "std/cli/argparse"

fn main(harness: Harness) {
  let spec = parser({name: "demo", args: [{name: "json", kind: "switch", long: "--json"}]})
  let r = parse(spec, ["--nope"])
  let err = r.err
  if err != nil {
    harness.stdio.println(err.kind)
    harness.stdio.println(err.arg)
  }
}
