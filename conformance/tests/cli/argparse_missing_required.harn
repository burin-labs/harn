import { parse, parser } from "std/cli/argparse"

fn main(harness: Harness) {
  const spec = parser({name: "demo", args: [{name: "input", kind: "positional"}]})
  const r = parse(spec, [])
  const err = r.err
  if err != nil {
    harness.stdio.println(err.kind)
    harness.stdio.println(err.arg)
  }
}
