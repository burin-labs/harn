import { parse, parser } from "std/cli/argparse"
import { assert_eq } from "std/testing"

pipeline test(task) {
  const spec = parser(
    {name: "demo", args: [{name: "model", kind: "flag", short: "-m", long: "--model"}]},
  )
  const a = unwrap(parse(spec, ["-m", "claude-opus"]))
  const b = unwrap(parse(spec, ["--model", "claude-haiku"]))
  const c = unwrap(parse(spec, ["--model=claude-sonnet"]))
  const d = unwrap(parse(spec, ["-mclaude-inline"]))
  assert_eq(a, {options: {model: "claude-opus"}, rest: []})
  assert_eq(b, {options: {model: "claude-haiku"}, rest: []})
  assert_eq(c, {options: {model: "claude-sonnet"}, rest: []})
  assert_eq(d, {options: {model: "claude-inline"}, rest: []})
  harness.stdio.println(a.options.model)
  harness.stdio.println(b.options.model)
  harness.stdio.println(c.options.model)
  harness.stdio.println(d.options.model)
}
