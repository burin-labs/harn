import { parse, parser } from "std/cli/argparse"

fn main(harness: Harness) {
  const spec = parser(
    {
      name: "demo",
      args: [
        {name: "input", kind: "positional", required: true},
        {name: "output", kind: "positional", required: false},
      ],
    },
  )
  const r = parse(spec, ["foo.txt", "bar.txt"])
  harness.stdio.println(r.ok.input)
  harness.stdio.println(r.ok.output)
  harness.stdio.println(len(r.ok.rest))
}
