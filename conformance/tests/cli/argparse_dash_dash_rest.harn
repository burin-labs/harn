import { parse, parser } from "std/cli/argparse"

fn main(harness: Harness) {
  const spec = parser({name: "demo", args: [{name: "json", kind: "switch", long: "--json"}]})
  const invocation = unwrap(parse(spec, ["--json", "--", "--not-a-flag", "x", "y"]))
  harness.stdio.println(invocation.options.json)
  harness.stdio.println(len(invocation.rest))
  for s in invocation.rest {
    harness.stdio.println(s)
  }
}
