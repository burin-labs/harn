/**
 * Under a paused clock sleep_ms returns immediately and advances the
 * virtual clock by the requested duration.
 *
 * Validates the core testbench property: script-perceived time advances
 * without consuming real wall-clock time.
 */
pipeline test(task) {
  let start_ms = 1767225600000
  mock_time(start_ms)
  let before = now_ms()
  sleep_ms(86400000)
  let after = now_ms()
  println(before == start_ms)
  println(after == start_ms + 86400000)
  println(after - before == 86400000)
  unmock_time()
}
