/**
 * A testbench fs overlay keeps working under a capability policy whose
 * workspace roots exclude the overlay root (#5609).
 *
 * The scope check used to run before the overlay ever saw the access, so a
 * mutation the overlay absorbs — one that never reaches disk — was refused
 * as a sandbox violation. The carve-out is deliberately not "exempt the
 * overlay root": a read the overlay would pass through to a real file is a
 * genuine disk read, and stays gated. Only a path the layer already holds
 * is served from memory.
 */
pipeline test(harness: Harness, task) {
  const root = harness.fs.source_dir() + "/testbench_fs_overlay_confined.fs-overlay"
  const jail = harness.fs.temp_dir()
  harness.runtime.with_execution_policy(
    {
      sandbox_profile: "worktree",
      workspace_roots: [jail],
      // Pin reads too: an empty list inherits the runner's broad read scope.
      read_only_roots: [jail],
    },
    { ->
      // Absorbed mutation: allowed, and visible in the diff.
      harness.fs.write_text(root + "/new.txt", "alpha")
      const added = harness.testing.fs_diff().filter({ e -> e.kind == "added" })
      harness.stdio.println(len(added) == 1)
      // The layer now holds this path, so the read is served from memory.
      harness.stdio.println(harness.fs.read_text(root + "/new.txt") == "alpha")
      // Pass-through read of a real file outside the jail: still refused.
      const denied = try {
        harness.fs.read_text(root + "/existing.txt")
        nil
      } catch (e) {
        e
      }
      harness.stdio.println(denied != nil)
    },
  )
  // `exists` routes through the overlay too, so it reports the layer, not
  // the disk — it cannot witness that the write stayed virtual. The
  // disk-level evidence is that this case's sidecar is tracked in git and
  // the checkout stays clean across a run.
  harness.stdio.println(harness.fs.exists(root + "/new.txt"))
}
// An absorbed mutation is allowed under a policy that excludes its root.
// A read the layer holds is absorbed; a pass-through read is not.
