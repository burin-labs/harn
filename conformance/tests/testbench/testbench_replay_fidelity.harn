import { with_llm_script } from "std/testing"

/**
 * Script performs deterministic work under a mocked LLM and paused
 * clock. The .testbench-tape sidecar contains the golden tape from the
 * first run; the conformance runner records a fresh tape on every
 * subsequent run and compares the user-script phase byte-for-byte
 * against the golden version via the fidelity oracle.
 *
 * A passing comparison means: given the same fixture and the same
 * paused clock, the runtime always produces the same user-script
 * sequence of host-boundary events. Runtime-finalize records are
 * checked semantically so internal lifecycle observability can evolve
 * without regenerating this fixture.
 *
 * REGENERATING THE TAPE: use the current runtime from the repository root:
 * harn test-bench run conformance/tests/testbench/testbench_replay_fidelity.harn \
 *   --start-at 1767225600000 --emit-tape /tmp/actual.tape
 * Review the header and every user-script record, then copy /tmp/actual.tape
 * to conformance/tests/testbench/testbench_replay_fidelity.testbench-tape.
 * Every regeneration requires explicit review of the observable changes.
 */
pipeline test(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [{text: "fidelity-response", input_tokens: 5, output_tokens: 3, model: "mock"}],
    { ->
      harness.testing.clock_set(1767225600000)
      const before = harness.clock.now_ms()
      const resp = harness.llm.call("replay test", nil, {provider: "mock", model: "mock"})
      harness.testing.clock_advance(1000)
      const after = harness.clock.now_ms()
      harness.stdio.println(resp.text == "fidelity-response")
      harness.stdio.println(after - before == 1000)
      harness.testing.clock_reset()
    },
  )
}
