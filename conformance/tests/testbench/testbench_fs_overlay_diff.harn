/**
 * Script writes 3 files, deletes 1, and modifies 1 through the fs
 * overlay. The testbench_fs_diff() builtin surfaces the in-memory diff
 * without touching the underlying filesystem.
 *
 * The .fs-overlay/ sidecar directory activates the overlay; the runner
 * installs a paused clock automatically.
 */
pipeline test(task) {
  let root = source_dir() + "/testbench_fs_overlay_diff.fs-overlay"
  harness.fs.write_text(root + "/new_a.txt", "alpha")
  harness.fs.write_text(root + "/new_b.txt", "beta")
  harness.fs.write_text(root + "/new_c.txt", "gamma")
  harness.fs.write_text(root + "/existing.txt", "updated content")
  harness.fs.delete(root + "/to_delete.txt")
  let diff = testbench_fs_diff()
  let added = diff.filter({ e -> e.kind == "added" })
  let modified = diff.filter({ e -> e.kind == "modified" })
  let deleted = diff.filter({ e -> e.kind == "deleted" })
  __io_println(len(added) == 3)
  __io_println(len(modified) == 1)
  __io_println(len(deleted) == 1)
  __io_println(added.any({ e -> contains(e.path, "new_a.txt") && e.content == "alpha" }))
  __io_println(modified[0].content == "updated content")
}
