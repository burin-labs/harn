import "std/triggers"

/**
 * CH-04 (#1875): aggregation trigger fires once the `count` threshold is
 * reached. The handler receives a batched event (`event.batch` populated)
 * with the buffered list of channel events.
 */
fn handle_batch(harness: Harness, event) {
  const batch_len = if event.batch == nil {
    0
  } else {
    len(event.batch)
  }
  harness.channels.append("batch.count.fired", {batch_size: batch_len})
}

pipeline test(harness: Harness, task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const _ = harness.runtime.trigger_register(
    {
      id: "batch-count-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_batch,
      when: nil,
      retry: nil,
      match: {events: ["channel:batch.count.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      batch: {count: 5, window: "10m"},
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  const _ = harness.channels.append("batch.count.input", {seq: 1})
  const _ = harness.channels.append("batch.count.input", {seq: 2})
  const _ = harness.channels.append("batch.count.input", {seq: 3})
  const _ = harness.channels.append("batch.count.input", {seq: 4})
  const before = harness.channels.events("batch.count.fired")
  harness.stdio.println("before-threshold:" + to_string(len(before)))
  const _ = harness.channels.append("batch.count.input", {seq: 5})
  const after = harness.channels.events("batch.count.fired")
  harness.stdio.println("after-threshold:" + to_string(len(after)))
  harness.stdio.println("batch_size:" + to_string(after[0].payload.batch_size))
}
