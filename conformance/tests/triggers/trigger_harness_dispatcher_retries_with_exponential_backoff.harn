pipeline test(harness: Harness, task) {
  const result = harness.runtime.trigger_test_harness("dispatcher_retries_with_exponential_backoff")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.attempts) == 3)
  harness.stdio.println(result.attempts[1].at_ms == 100)
  harness.stdio.println(result.attempts[2].status == "dispatched")
}
