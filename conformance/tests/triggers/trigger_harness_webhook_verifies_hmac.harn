pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("webhook_verifies_hmac")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.emitted) == 1)
  harness.stdio.println(result.emitted[0].signature_state == "verified")
  harness.stdio.println(result.emitted[0].kind == "ping")
}
