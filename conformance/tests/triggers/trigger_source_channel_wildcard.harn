import "std/triggers"

/**
 * CH-02 (#1872): tenant wildcard selector (`channel:tenant:*:foo`) matches
 * emits within the trigger's entitled tenant boundary.
 */
fn handle_any_tenant(event) {
  let payload = event.provider_payload
  emit_channel("ch.wild.fired", {scope: payload.scope, scope_id: payload.scope_id})
}

pipeline test(task) {
  let unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.gen_range(100000, 999999))
  let _ = trigger_register(
    {
      id: "channel-wild-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_any_tenant,
      when: nil,
      retry: nil,
      match: {events: ["channel:tenant:*:wild.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  let _ = emit_channel("wild.input", {n: 1})
  let fired = channel_events("ch.wild.fired")
  __io_println(len(fired))
  __io_println(fired[0].payload.scope)
  // Default tenant id is `default` when no tenant is set on the runtime.
  __io_println(fired[0].payload.scope_id)
}
