import "std/triggers"

/**
 * CH-02 (#1872): session-scoped selector matches an emit on the same
 * session scope but ignores emits on the default tenant scope.
 */
fn handle_session(event) {
  let payload = event.provider_payload
  emit_channel("ch.session.fired", {scope: payload.scope, name: payload.name})
}

pipeline test(task) {
  let unique = to_string(to_int(timestamp())) + "-" + to_string(random_int(100000, 999999))
  let _ = trigger_register(
    {
      id: "channel-session-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_session,
      when: nil,
      retry: nil,
      match: {events: ["channel:session:sess.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  // Tenant-scoped emit must NOT fire the session-scoped trigger.
  let _ = emit_channel("sess.input", {n: 1})
  // Session-scoped emit fires the trigger.
  let _ = emit_channel("session:sess.input", {n: 2})
  let fired = channel_events("ch.session.fired")
  println(len(fired))
  println(fired[0].payload.scope)
  println(fired[0].payload.name)
}
