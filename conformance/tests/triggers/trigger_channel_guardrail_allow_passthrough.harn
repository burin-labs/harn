import { prompt_injection_scanner } from "std/channel_guardrails"

/**
 * CH-11 (#1911): an `allow` verdict passes through silently — no
 * audit row is written and the receipt looks identical to an emit
 * without any guardrails registered.
 */
pipeline default() {
  pipeline_lifecycle_audit_log_take()
  channel_guardrail_clear()
  const _ = prompt_injection_scanner({})
  const receipt = emit_channel("ch.guardrail.allow", {value: 42})
  __io_println(receipt?.inserted)
  __io_println(receipt?.blocked ?? false)
  __io_println(receipt?.duplicate)
  /* Confirm the durable journal has the entry. */
  const history = channel_events("ch.guardrail.allow")
  __io_println(len(history))
  __io_println(history[0].payload.value)
  /* No guardrail audit fired. */
  const audit = pipeline_lifecycle_audit_log_take()
  __io_println(len(audit))
  /* Listing returns the registered guardrail id. */
  const ids = channel_guardrail_list()
  __io_println(len(ids))
  __io_println(channel_guardrail_unregister(ids[0]))
  __io_println(len(channel_guardrail_list()))
}
