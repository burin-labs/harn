pipeline test(task) {
  const intake_a = webhook_intake_register(
    {
      id: "intake-a",
      path: "/hooks/a",
      secret: "secret-a",
      signature_header: "x-a-signature",
      delivery_id_header: "x-a-delivery",
      topic: "tests.intake.path_a",
    },
  )
  const intake_b = webhook_intake_register(
    {
      id: "intake-b",
      path: "/hooks/b",
      secret: "secret-b",
      signature_header: "x-b-signature",
      delivery_id_header: "x-b-delivery",
      topic: "tests.intake.path_b",
    },
  )
  __io_println(intake_a.id == "intake-a")
  __io_println(intake_b.id == "intake-b")
  const body = "shared-body"
  // Same delivery id on two intakes must NOT collide.
  const sig_a = "sha256=" + hmac_sha256("secret-a", body)
  const sig_b = "sha256=" + hmac_sha256("secret-b", body)
  const outcome_a = webhook_intake_feed(
    "intake-a",
    {
      headers: {"x-a-signature": sig_a, "x-a-delivery": "shared-delivery"},
      body: body,
      path: "/hooks/a",
    },
  )
  const outcome_b = webhook_intake_feed(
    "intake-b",
    {
      headers: {"x-b-signature": sig_b, "x-b-delivery": "shared-delivery"},
      body: body,
      path: "/hooks/b",
    },
  )
  __io_println(outcome_a.status == "accepted")
  __io_println(outcome_b.status == "accepted")
  // Path mismatch is rejected even with a valid signature.
  const mismatched = webhook_intake_feed(
    "intake-a",
    {
      headers: {"x-a-signature": sig_a, "x-a-delivery": "delivery-other"},
      body: body,
      path: "/hooks/wrong",
    },
  )
  __io_println(mismatched.status == "rejected")
  // Wrong-secret signature is rejected (cross-intake leakage).
  const cross = webhook_intake_feed(
    "intake-a",
    {
      headers: {"x-a-signature": sig_b, "x-a-delivery": "delivery-cross"},
      body: body,
      path: "/hooks/a",
    },
  )
  __io_println(cross.status == "rejected")
}
