import { with_llm_script } from "std/testing"
import "std/triggers"

fn handler(event: TriggerEvent) -> dict {
  return {handled: true, kind: event.kind}
}

fn classify(event: TriggerEvent) -> bool {
  const result = llm_call(
    "predicate false " + event.kind,
    nil,
    {provider: "mock", model: "gpt-4o-mini"},
  )
  return contains(result.text, "yes")
}

pipeline test(task) {
  with_llm_script(
    [{text: "no", input_tokens: 10, output_tokens: 5, model: "gpt-4o-mini"}],
    { ->
      const unique = to_string(to_int(harness.clock.timestamp())) + "-"
        + to_string(
        harness.random.gen_range(100000, 999999),
      )
      const handle: TriggerHandle = trigger_register(
        {
          id: "llm-predicate-false-" + unique,
          kind: "issue.opened",
          provider: "github",
          handler: handler,
          when: classify,
          when_budget: nil,
          retry: nil,
          match: {events: ["issue.opened"]},
          events: nil,
          dedupe_key: nil,
          filter: nil,
          budget: nil,
          manifest_path: nil,
          package_name: nil,
        },
      )
      const fire: DispatchHandle = trigger_fire(
        handle,
        {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-false-" + unique}},
      )
      const dispatches = trigger_inspect_lifecycle("DispatchStarted").filter(
        { entry -> entry?.headers?.trigger_id == handle.id },
      )
      __io_println(fire.status == "dispatched")
      __io_println(contains(json_stringify(fire.result ?? {}), "\"skipped\":true"))
      __io_println(contains(json_stringify(fire.result ?? {}), "\"reason\":null"))
      __io_println(len(dispatches) == 0)
    },
  )
}
