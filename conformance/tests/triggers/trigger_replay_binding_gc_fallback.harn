pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("replay_binding_gc_fallback")
  harness.stdio.println(result.ok)
  harness.stdio.println(result.details.trigger_id == "replay.gc.fixture")
  harness.stdio.println(result.details.recorded_version == 1)
  harness.stdio.println(result.details.resolved_version == 3)
}
