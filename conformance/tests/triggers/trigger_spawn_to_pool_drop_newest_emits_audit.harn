import { Backpressure, pool_create, pool_wait } from "std/lifecycle/pool"
import "std/triggers"

/**
 * Verifies the drop_newest backpressure path on a SpawnToPool trigger
 * (#1889): when the pool's queue is saturated, the dispatcher still records
 * the dispatch as successful and the pool emits its standard
 * `lifecycle.pool.audit` event so observers can see the rejection. This
 * matches `pool.submit({backpressure: bp.queue(1, "drop_newest")})` —
 * composing triggers with pools shouldn't introduce a parallel audit path.
 */
pipeline test(harness: Harness, task) {
  const bp = Backpressure()
  const gate = harness.runtime.channel(nil, 1)
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const pool_name = "spawn-to-pool-drop-newest-demo-" + unique
  const _ = pool_create(
    {name: pool_name, max_concurrent: 1, backpressure: bp.queue(1, "drop_newest")},
  )
  // Filter to drop receipts so the assertion ignores the `pool_submit`
  // and `pool_dequeue` receipts emitted on the same topic by PL-06.
  const stream = harness.obs.event_log_subscribe({topic: "lifecycle.pool.audit", kind_prefix: "pool_drop"})
  const task_factory = { _event ->
    return { ->
      harness.runtime.receive(gate)
      return "ok"
    }
  }
  const trigger_id = "trigger-spawn-to-pool-dropnew-" + unique
  const handle: TriggerHandle = harness.runtime.trigger_register(
    {
      id: trigger_id,
      kind: "issue.opened",
      provider: "webhook",
      handler: SpawnToPool({pool: pool_name, task_factory: task_factory}),
      when: nil,
      retry: nil,
      match: {events: ["issue.opened"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  // First fire occupies the single active slot. Second occupies the queue.
  // Third should be evicted by drop_newest, leaving the result as rejected.
  const warmup = harness.runtime.trigger_fire(
    handle,
    {provider: "webhook", kind: "issue.opened", headers: {x_delivery: "warmup-" + unique}},
  )
  const queued = harness.runtime.trigger_fire(
    handle,
    {provider: "webhook", kind: "issue.opened", headers: {x_delivery: "queued-" + unique}},
  )
  const newest = harness.runtime.trigger_fire(
    handle,
    {provider: "webhook", kind: "issue.opened", headers: {x_delivery: "newest-" + unique}},
  )
  harness.stdio.println(warmup.status == "dispatched")
  harness.stdio.println(queued.status == "dispatched")
  harness.stdio.println(newest.status == "dispatched")
  harness.stdio.println(newest.result?.status == "rejected")
  harness.stdio.println(newest.result?.rejection_reason)
  // The pool emits its standard audit so trigger dispatch and direct
  // `pool.submit` callers see the same drop event.
  const audit = stream.next().value
  harness.stdio.println(audit.payload.policy)
  harness.stdio.println(audit.headers.schema)
  // Drain the gate so the two surviving tasks finish.
  harness.runtime.send(gate, "go")
  harness.runtime.send(gate, "go")
  const results = pool_wait([warmup.result, queued.result])
  harness.stdio.println(results[0].status)
  harness.stdio.println(results[1].status)
}
