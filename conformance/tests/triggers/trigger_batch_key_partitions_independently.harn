import "std/triggers"

/**
 * CH-04 (#1875): `key` partitions events by JSON path. Each distinct key
 * value maintains its own counter + window. Repo-A reaches `count` first
 * and fires immediately; repo-B fires later when its own threshold is
 * reached.
 */
fn handle_batch(event) {
  const batch_len = if event.batch == nil {
    0
  } else {
    len(event.batch)
  }
  const first = event.batch[0]
  const repo = first.provider_payload.payload.repo
  emit_channel("batch.key.fired", {repo: repo, batch_size: batch_len})
}

pipeline test(task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const _ = trigger_register(
    {
      id: "batch-key-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_batch,
      when: nil,
      retry: nil,
      match: {events: ["channel:batch.key.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      batch: {count: 2, window: "10m", key: "repo"},
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  const _ = emit_channel("batch.key.input", {repo: "repoA", seq: 1})
  const _ = emit_channel("batch.key.input", {repo: "repoB", seq: 1})
  const only_a = channel_events("batch.key.fired")
  __io_println("after-one-each:" + to_string(len(only_a)))
  const _ = emit_channel("batch.key.input", {repo: "repoA", seq: 2})
  const one_fired = channel_events("batch.key.fired")
  __io_println("after-repoA-pair:" + to_string(len(one_fired)))
  __io_println("first-fired-repo:" + one_fired[0].payload.repo)
  const _ = emit_channel("batch.key.input", {repo: "repoB", seq: 2})
  const both_fired = channel_events("batch.key.fired")
  __io_println("after-repoB-pair:" + to_string(len(both_fired)))
  __io_println("second-fired-repo:" + both_fired[1].payload.repo)
}
