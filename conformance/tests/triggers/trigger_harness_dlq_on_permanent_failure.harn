pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("dlq_on_permanent_failure")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.dlq) == 1)
  harness.stdio.println(result.dlq[0].state == "pending")
  harness.stdio.println(result.attempts[0].status == "dlq")
}
