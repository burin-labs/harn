import "std/triggers"

/**
 * CH-06 (#1877): for an aggregation/batched trigger the `ChannelMatch`
 * span multi-links to ALL constituent `ChannelEmit` spans. The
 * transcript match event also surfaces the batch summary with the full
 * constituent event id list so downstream renderers can join the
 * batched dispatch back to the emit timeline.
 */
fn handle_batch(event) {
  let batch_len = if event.batch == nil {
    0
  } else {
    len(event.batch)
  }
  emit_channel("ch.otel.batch.fired", {batch_size: batch_len})
}

pipeline default() {
  enable_tracing(true)
  let stream = event_log.subscribe({topic: "transcript.channel.lifecycle"})
  let unique = to_string(to_int(timestamp())) + "-" + to_string(random_int(100000, 999999))
  let _ = trigger_register(
    {
      id: "channel-otel-batch-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_batch,
      when: nil,
      retry: nil,
      match: {events: ["channel:ch.otel.batch.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      batch: {count: 3, window: "10m"},
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  let _ = emit_channel("ch.otel.batch.input", {seq: 1})
  let _ = emit_channel("ch.otel.batch.input", {seq: 2})
  let _ = emit_channel("ch.otel.batch.input", {seq: 3})
  // Drain emit + match lifecycle events. Three input emits land first,
  // then the batched match, then the nested emit of `ch.otel.batch.fired`
  // (with its own match event since no binding listens to it).
  let first = stream.next().value
  let second = stream.next().value
  let third = stream.next().value
  let fourth = stream.next().value
  println(first.kind)
  println(second.kind)
  println(third.kind)
  println(fourth.kind)
  println(fourth.payload.handler_kind)
  println(fourth.payload.batch.count)
  println(len(fourth.payload.batch.constituent_event_ids))
  // Span check: match span must multi-link to every emit span.
  let spans = trace_spans()
  let emit_spans = spans
    .filter(
    { s -> s.kind == "channel_emit" && s.metadata.name_resolved == "tenant:default:ch.otel.batch.input" },
  )
  let match_spans = spans
    .filter(
    { s -> s.kind == "channel_match" && s.name == "channel.match tenant:default:ch.otel.batch.input" },
  )
  println(len(emit_spans) >= 3)
  println(len(match_spans) >= 1)
  let match_span = match_spans[0]
  println(len(match_span.links) >= 3)
  enable_tracing(false)
}
