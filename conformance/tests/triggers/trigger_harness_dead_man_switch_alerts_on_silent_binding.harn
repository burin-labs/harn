pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("dead_man_switch_alerts_on_silent_binding")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.alerts) == 1)
  harness.stdio.println(result.alerts[0].binding_id == "deadman.fixture")
  harness.stdio.println(result.details.silent_for_ms == 300000)
}
