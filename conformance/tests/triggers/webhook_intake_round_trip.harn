pipeline test(harness: Harness, task: unknown) {
  const intake = harness.runtime.webhook_intake_register(
    {
      id: "round-trip",
      path: "/hooks/foo",
      secret: "super-secret",
      signature_header: "x-hub-signature-256",
      delivery_id_header: "x-github-delivery",
      topic: "tests.intake.round_trip",
    },
  )
  harness.stdio.println(intake.id == "round-trip")
  harness.stdio.println(intake.topic == "tests.intake.round_trip")
  const body = "{\"hello\":\"world\"}"
  const signature = "sha256=" + hmac_sha256("super-secret", body)
  // Acceptance: a valid signature is accepted and republished onto the topic.
  const accepted = harness.runtime.webhook_intake_feed(
    "round-trip",
    {
      headers: {"x-hub-signature-256": signature, "x-github-delivery": "delivery-1"},
      body: body,
      path: "/hooks/foo",
    },
  )
  harness.stdio.println(accepted.status == "accepted")
  harness.stdio.println(accepted.delivery_id == "delivery-1")
  // Acceptance: replay with the same delivery id is deduped.
  const dup = harness.runtime.webhook_intake_feed(
    "round-trip",
    {
      headers: {"x-hub-signature-256": signature, "x-github-delivery": "delivery-1"},
      body: body,
      path: "/hooks/foo",
    },
  )
  harness.stdio.println(dup.status == "duplicate")
  // Acceptance: a tampered signature is rejected.
  const bad = harness.runtime.webhook_intake_feed(
    "round-trip",
    {
      headers: {"x-hub-signature-256": "sha256=deadbeef", "x-github-delivery": "delivery-2"},
      body: body,
      path: "/hooks/foo",
    },
  )
  harness.stdio.println(bad.status == "rejected")
  // Bounded replay buffer: the topic holds the accepted delivery.
  const recent = harness.runtime.webhook_intake_recent("round-trip", 8)
  harness.stdio.println(len(recent) == 1)
  harness.stdio.println(recent[0].delivery_id == "delivery-1")
}
