pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("replay_refires_from_dlq")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.emitted) == 1)
  harness.stdio.println(result.dlq[0].replayed)
  harness.stdio.println(result.attempts[1].replay_of_event_id == result.details.replay_of_event_id)
}
