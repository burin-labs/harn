pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("scheduled_eval_suite")
  harness.stdio.println(result.ok)
  harness.stdio.println(result.details.first_status == "succeeded")
  harness.stdio.println(result.details.ledger_rows == 1)
  harness.stdio.println(result.details.ledger_commit == "commit-a")
  harness.stdio.println(result.details.second_status == "skipped")
  harness.stdio.println(result.details.second_budget == "daily_budget_exceeded")
  harness.stdio.println(result.details.skip_stage == "budget")
}
