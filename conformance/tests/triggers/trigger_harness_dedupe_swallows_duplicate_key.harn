pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("dedupe_swallows_duplicate_key")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.emitted) == 1)
  harness.stdio.println(result.emitted[0].note == "first_delivery")
  harness.stdio.println(contains(result.details.duplicate_error, "duplicate"))
}
