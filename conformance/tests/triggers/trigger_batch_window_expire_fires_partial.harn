import "std/triggers"

/**
 * CH-04 (#1875): when the window elapses before reaching `count`, the
 * default `expire_action` is `fire_partial`: the handler receives a
 * partial batch (length < count). `advance_time(ms)` advances the
 * thread-local mock clock so the buffer is observed as expired during
 * the next `flush_trigger_aggregations()` call.
 */
fn handle_batch(harness: Harness, event) {
  const batch_len = if event.batch == nil {
    0
  } else {
    len(event.batch)
  }
  harness.channels.append("batch.window.fired", {batch_size: batch_len})
}

pipeline test(harness: Harness, task) {
  mock_time(1000000)
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const _ = harness.runtime.trigger_register(
    {
      id: "batch-window-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_batch,
      when: nil,
      retry: nil,
      match: {events: ["channel:batch.window.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      batch: {count: 5, window: "10m"},
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  const _ = harness.channels.append("batch.window.input", {seq: 1})
  const _ = harness.channels.append("batch.window.input", {seq: 2})
  const _ = harness.channels.append("batch.window.input", {seq: 3})
  const before = harness.channels.events("batch.window.fired")
  harness.stdio.println("before-window:" + to_string(len(before)))
  const _ = advance_time(601000)
  flush_trigger_aggregations()
  const after = harness.channels.events("batch.window.fired")
  harness.stdio.println("after-window:" + to_string(len(after)))
  harness.stdio.println("batch_size:" + to_string(after[0].payload.batch_size))
  unmock_time()
}
