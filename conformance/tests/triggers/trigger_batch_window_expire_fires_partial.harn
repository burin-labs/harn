import "std/triggers"

/**
 * CH-04 (#1875): when the window elapses before reaching `count`, the
 * default `expire_action` is `fire_partial`: the handler receives a
 * partial batch (length < count). `advance_time(ms)` advances the
 * thread-local mock clock so the buffer is observed as expired during
 * the next `flush_trigger_aggregations()` call.
 */
fn handle_batch(event) {
  let batch_len = if event.batch == nil {
    0
  } else {
    len(event.batch)
  }
  emit_channel("batch.window.fired", {batch_size: batch_len})
}

pipeline test(task) {
  mock_time(1000000)
  let unique = to_string(to_int(timestamp())) + "-" + to_string(random_int(100000, 999999))
  let _ = trigger_register(
    {
      id: "batch-window-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_batch,
      when: nil,
      retry: nil,
      match: {events: ["channel:batch.window.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      batch: {count: 5, window: "10m"},
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  let _ = emit_channel("batch.window.input", {seq: 1})
  let _ = emit_channel("batch.window.input", {seq: 2})
  let _ = emit_channel("batch.window.input", {seq: 3})
  let before = channel_events("batch.window.fired")
  __io_println("before-window:" + to_string(len(before)))
  let _ = advance_time(601000)
  flush_trigger_aggregations()
  let after = channel_events("batch.window.fired")
  __io_println("after-window:" + to_string(len(after)))
  __io_println("batch_size:" + to_string(after[0].payload.batch_size))
  unmock_time()
}
