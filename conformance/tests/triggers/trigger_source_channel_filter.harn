import "std/triggers"

/**
 * CH-02 (#1872): JSON-path-equality filter restricts trigger fires to
 * matching payloads.
 */
fn handle_match(event) {
  emit_channel("ch.filter.fired", {repo: event.provider_payload.payload.repo})
}

pipeline test(task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const _ = trigger_register(
    {
      id: "channel-filter-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_match,
      when: nil,
      retry: nil,
      match: {events: ["channel:filter.input"]},
      events: nil,
      dedupe_key: nil,
      filter: "{\"repo\": \"harn\"}",
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  const _ = emit_channel("filter.input", {repo: "other-repo"})
  const _ = emit_channel("filter.input", {repo: "harn"})
  const _ = emit_channel("filter.input", {repo: "burin"})
  const fired = channel_events("ch.filter.fired")
  __io_println(len(fired))
  __io_println(fired[0].payload.repo)
}
