import "std/triggers"

/**
 * CH-04 (#1875): after a successful fire, the buffer resets so the next
 * matching event starts a fresh window. Counter increments cleanly from
 * 0 again.
 */
fn handle_batch(event) {
  const batch_len = if event.batch == nil {
    0
  } else {
    len(event.batch)
  }
  emit_channel("batch.btb.fired", {batch_size: batch_len})
}

pipeline test(task) {
  const unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(
    harness.random.gen_range(100000, 999999),
  )
  const _ = trigger_register(
    {
      id: "batch-btb-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_batch,
      when: nil,
      retry: nil,
      match: {events: ["channel:batch.btb.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      batch: {count: 2, window: "10m"},
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  const _ = emit_channel("batch.btb.input", {seq: 1})
  const _ = emit_channel("batch.btb.input", {seq: 2})
  const first = channel_events("batch.btb.fired")
  __io_println("after-first-pair:" + to_string(len(first)))
  const _ = emit_channel("batch.btb.input", {seq: 3})
  const mid = channel_events("batch.btb.fired")
  __io_println("after-third:" + to_string(len(mid)))
  const _ = emit_channel("batch.btb.input", {seq: 4})
  const second = channel_events("batch.btb.fired")
  __io_println("after-second-pair:" + to_string(len(second)))
}
