import { with_llm_script } from "std/testing"
import "std/triggers"

fn handler(harness: Harness, event: TriggerEvent) -> dict {
  return {handled: true, kind: event.kind}
}

fn classify(harness: Harness, event: TriggerEvent) -> bool {
  const result = harness.llm.call(
    "predicate budget " + event.kind,
    nil,
    {provider: "mock", model: "gpt-4o-mini"},
  )
  return contains(result.text, "yes")
}

pipeline test(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [{text: "yes", input_tokens: 3000, output_tokens: 4000, model: "gpt-4o-mini"}],
    { ->
      const unique = to_string(to_int(harness.clock.timestamp())) + "-"
        + to_string(harness.random.range(100000, 999999))
      const handle: TriggerHandle = harness.runtime.trigger_register(
        {
          id: "llm-predicate-budget-" + unique,
          kind: "issue.opened",
          provider: "webhook",
          handler: handler,
          when: classify,
          when_budget: {max_cost_usd: 0.001, tokens_max: 500, timeout: "5s"},
          retry: nil,
          match: {events: ["issue.opened"]},
          events: nil,
          dedupe_key: nil,
          filter: nil,
          budget: nil,
          manifest_path: nil,
          package_name: nil,
        },
      )
      const fire: DispatchHandle = harness.runtime.trigger_fire(
        handle,
        {provider: "webhook", kind: "issue.opened", headers: {x_delivery: "evt-budget-" + unique}},
      )
      const budget_events = harness.runtime.trigger_inspect_lifecycle("predicate.budget_exceeded")
        .filter({ entry -> entry?.headers?.trigger_id == handle.id })
      const dispatches = harness.runtime.trigger_inspect_lifecycle("DispatchStarted").filter(
        { entry -> entry?.headers?.trigger_id == handle.id },
      )
      harness.stdio.println(fire.status == "dispatched")
      harness.stdio.println(
        contains(json_stringify(fire.result ?? {}), "\"reason\":\"budget_exceeded\""),
      )
      harness.stdio.println(len(budget_events) == 1 && budget_events[0]?.payload?.tokens == 7000)
      harness.stdio.println(len(dispatches) == 0)
    },
  )
}
