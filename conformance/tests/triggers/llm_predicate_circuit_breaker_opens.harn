import { with_llm_script } from "std/testing"
import "std/triggers"

fn handler(harness: Harness, event: TriggerEvent) -> dict {
  return {handled: true, kind: event.kind}
}

fn classify(harness: Harness, event: TriggerEvent) -> bool {
  const result = harness.llm.call(
    "predicate breaker " + event.kind,
    nil,
    {provider: "mock", model: "gpt-4o-mini"},
  )
  return contains(result.text, "yes")
}

pipeline test(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [
      {error: {category: "server_error", message: "503 upstream"}, model: "gpt-4o-mini"},
      {error: {category: "server_error", message: "503 upstream"}, model: "gpt-4o-mini"},
      {error: {category: "server_error", message: "503 upstream"}, model: "gpt-4o-mini"},
    ],
    { ->
      const unique = to_string(to_int(harness.clock.timestamp())) + "-"
        + to_string(
        harness.random.range(100000, 999999),
      )
      const handle: TriggerHandle = harness.runtime.trigger_register(
        {
          id: "llm-predicate-breaker-" + unique,
          kind: "issue.opened",
          provider: "webhook",
          handler: handler,
          when: classify,
          when_budget: nil,
          retry: nil,
          match: {events: ["issue.opened"]},
          events: nil,
          dedupe_key: nil,
          filter: nil,
          budget: nil,
          manifest_path: nil,
          package_name: nil,
        },
      )
      const first: DispatchHandle = harness.runtime.trigger_fire(
        handle,
        {
          provider: "webhook",
          kind: "issue.opened",
          headers: {x_delivery: "evt-breaker-1-" + unique},
        },
      )
      const second: DispatchHandle = harness.runtime.trigger_fire(
        handle,
        {
          provider: "webhook",
          kind: "issue.opened",
          headers: {x_delivery: "evt-breaker-2-" + unique},
        },
      )
      const third: DispatchHandle = harness.runtime.trigger_fire(
        handle,
        {
          provider: "webhook",
          kind: "issue.opened",
          headers: {x_delivery: "evt-breaker-3-" + unique},
        },
      )
      const fourth: DispatchHandle = harness.runtime.trigger_fire(
        handle,
        {
          provider: "webhook",
          kind: "issue.opened",
          headers: {x_delivery: "evt-breaker-4-" + unique},
        },
      )
      const evaluated = harness.runtime.trigger_inspect_lifecycle("predicate.evaluated").filter(
        { entry -> entry?.headers?.trigger_id == handle.id },
      )
      const last = evaluated[len(evaluated) - 1]
      harness.stdio.println(len(harness.llm.mock_calls()) == 3)
      harness.stdio.println(contains(json_stringify(first.result ?? {}), "\"skipped\":true"))
      harness.stdio.println(contains(json_stringify(second.result ?? {}), "\"skipped\":true"))
      harness.stdio.println(contains(json_stringify(third.result ?? {}), "\"skipped\":true"))
      harness.stdio.println(
        contains(json_stringify(fourth.result ?? {}), "\"reason\":\"circuit_open\""),
      )
      harness.stdio.println(len(evaluated) == 4 && last?.payload?.reason == "circuit_open")
    },
  )
}
