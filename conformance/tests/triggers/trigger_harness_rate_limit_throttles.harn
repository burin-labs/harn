pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("rate_limit_throttles")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.emitted) == 2)
  harness.stdio.println(result.attempts[1].backoff_ms == 60000)
  harness.stdio.println(result.details.throttled_for_ms == 60000)
}
