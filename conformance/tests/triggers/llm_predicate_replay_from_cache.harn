import { with_llm_script } from "std/testing"
import "std/triggers"

fn handler(event: TriggerEvent) -> dict {
  return {handled: true, kind: event.kind}
}

fn classify(event: TriggerEvent) -> bool {
  const result = llm_call("predicate replay " + event.kind, nil, {provider: "mock", model: "gpt-4o-mini"})
  return contains(result.text, "yes")
}

pipeline test(task) {
  with_llm_script(
    [{text: "yes", input_tokens: 10, output_tokens: 5, model: "gpt-4o-mini"}],
    { ->
      const unique = to_string(to_int(harness.clock.timestamp())) + "-"
        + to_string(harness.random.gen_range(100000, 999999))
      const handle: TriggerHandle = trigger_register(
        {
          id: "llm-predicate-replay-" + unique,
          kind: "issue.opened",
          provider: "github",
          handler: handler,
          when: classify,
          when_budget: nil,
          retry: nil,
          match: {events: ["issue.opened"]},
          events: nil,
          dedupe_key: nil,
          filter: nil,
          budget: nil,
          manifest_path: nil,
          package_name: nil,
        },
      )
      const fire: DispatchHandle = trigger_fire(
        handle,
        {provider: "github", kind: "issue.opened", headers: {x_delivery: "evt-replay-" + unique}},
      )
      const replay: DispatchHandle = trigger_replay(fire.event_id)
      const evaluated = trigger_inspect_lifecycle("predicate.evaluated").filter(
        { entry -> entry?.headers?.trigger_id == handle.id },
      )
      __io_println(fire.status == "dispatched" && replay.status == "dispatched")
      __io_println(len(llm_mock_calls()) == 1)
      __io_println(len(evaluated) == 2)
      __io_println(!evaluated[0]?.payload?.cached && evaluated[1]?.payload?.cached)
      __io_println(evaluated[1]?.payload?.replay_of_event_id == fire.event_id)
    },
  )
}
