pipeline test(harness: Harness, task: unknown) {
  const result = harness.runtime.trigger_test_harness("crash_recovery_replays_in_flight_events")
  harness.stdio.println(result.ok)
  harness.stdio.println(len(result.emitted) == 1)
  harness.stdio.println(result.emitted[0].note == "recovered")
  harness.stdio.println(len(result.details.recovered_event_ids) == 1)
}
