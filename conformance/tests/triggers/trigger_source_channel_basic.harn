import "std/triggers"

/**
 * CH-02 (#1872): register a `channel:`-source trigger and verify it fires
 * on a matching emit_channel(...). The handler echoes the payload to a
 * separate channel so the test can observe the dispatch synchronously.
 */
fn handle_channel(event) {
  let payload = event.provider_payload
  emit_channel("ch.basic.fired", {name: payload.name, repo: payload.payload?.repo})
}

pipeline test(task) {
  let unique = to_string(to_int(harness.clock.timestamp())) + "-"
    + to_string(harness.random.gen_range(100000, 999999))
  let handle: TriggerHandle = trigger_register(
    {
      id: "channel-basic-" + unique,
      kind: "channel.emit",
      provider: "channel",
      autonomy_tier: "act_auto",
      handler: handle_channel,
      when: nil,
      retry: nil,
      match: {events: ["channel:ch.basic.input"]},
      events: nil,
      dedupe_key: nil,
      filter: nil,
      budget: nil,
      manifest_path: nil,
      package_name: "conformance",
    },
  )
  __io_println(handle.provider)
  __io_println(handle.kind)
  let _ = emit_channel("ch.basic.input", {repo: "harn"})
  let fired = channel_events("ch.basic.fired")
  __io_println(len(fired))
  __io_println(fired[0].payload.name)
  __io_println(fired[0].payload.repo)
}
