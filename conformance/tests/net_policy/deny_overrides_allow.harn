/**
 * Deny rules always win over allow rules. `*.github.com` allows
 * subdomains broadly, but an explicit deny for one carves it out.
 *
 * Tracking: harn#1913 (E4.9).
 */
import { create, domain, domain_wildcard } from "std/net_policy"

fn main(harness: Harness) {
  const policy = create(
    {allow: [domain_wildcard("*.github.com")], deny: [domain("evil.github.com")], default: "deny"},
  )
  const restricted = harness.with_net_policy(policy)
  const ok = restricted.net.get("https://api.github.com/probe")
  harness.stdio.println("api=" + ok)
  let deny_err = nil
  try {
    restricted.net.get("https://evil.github.com/x")
  } catch (e) {
    deny_err = e
  }
  harness.stdio.println("evil_blocked=" + to_string(deny_err != nil))
  harness.stdio.println("matched_rule=" + deny_err.matched_rule)
}
