// Tenant- and org-scope pools are host-routed (harn-cloud, see
// harn-cloud#306). The in-process runtime accepts the spec keyword for
// portability but fails fast with a clear diagnostic when no host is
// wired.
import { pool_create } from "std/lifecycle/pool"

fn has_text(result, snippet) {
  return is_err(result) && contains(to_string(unwrap_err(result)), snippet)
}

pipeline default() {
  let tenant_result = try {
    pool_create({name: "tenant-demo", scope: "tenant"})
  }
  log(has_text(tenant_result, "host-routed"))
  log(has_text(tenant_result, "harn-cloud"))
  let org_result = try {
    pool_create({name: "org-demo", scope: "org"})
  }
  log(has_text(org_result, "host-routed"))
}
