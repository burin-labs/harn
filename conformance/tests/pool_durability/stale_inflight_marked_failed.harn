// Tasks that were in-flight when the previous process exited are
// reloaded as `failed` with a stale-restart marker — closures cannot
// resume across a process boundary, but idempotent re-submission lets
// the new process re-run the work.
import { fail_fast, pool_create, pool_simulate_restart, pool_wait } from "std/lifecycle/pool"

pipeline default() {
  const dir = path_join(harness.fs.temp_dir(), "harn-pool-durability-stale-" + uuid())
  const pool = pool_create(
    {
      name: "stale-demo",
      scope: "pipeline",
      pipeline_id: "pipe_stale",
      max_concurrent: 1,
      backpressure: fail_fast(),
      dir: dir,
    },
  )
  const h1 = pool.submit({ -> 7 }, {idempotency_key: "task-A"})
  const r1 = pool_wait(h1)
  log(r1.status)
  log(r1.result)
  // Forge an in-flight record on disk via a side-channel append. The
  // simulate_restart helper then drops the live registry, and a fresh
  // pool_create re-hydrates: terminal "task-A" stays completed, the
  // forged in-flight "task-B" is re-classified as failed (process gone).
  const forged_path = path_join(dir, harness.fs.list_dir(dir)[0])
  const _now = harness.clock.now_ms()
  const stale = "{\"kind\":\"task\",\"task\":{\"id\":\"stale_task\",\"pool_id\":\"" + pool.id
    + "\",\"pool_name\":\"stale-demo\",\"priority\":0,\"status\":\"running\",\"submitted_at\":\"forged\",\"started_at\":\"forged\",\"idempotency_key\":\"task-B\",\"heartbeat_at_ms\":0,\"seq\":99}}\n"
  harness.fs.write_text(forged_path, harness.fs.read_text(forged_path) + stale)
  pool_simulate_restart()
  const resumed = pool_create(
    {
      name: "stale-demo",
      scope: "pipeline",
      pipeline_id: "pipe_stale",
      max_concurrent: 1,
      backpressure: fail_fast(),
      dir: dir,
    },
  )
  log(resumed.completed)
  log(resumed.failed)
  log(resumed.total)
  // Re-submitting under "task-A" still dedupes (completed).
  const h2 = resumed.submit({ -> 0 }, {idempotency_key: "task-A"})
  const r2 = pool_wait(h2)
  log(r2.status)
  log(r2.result)
  // The forged "task-B" came back failed; a re-submit with the same
  // idempotency_key short-circuits to that failed snapshot too.
  const h3 = resumed.submit({ -> 0 }, {idempotency_key: "task-B"})
  const r3 = pool_wait(h3)
  log(r3.status)
}
