// Two submissions with the same idempotency_key inside a single
// session resolve to the same task — even in-memory pools dedupe.
import { pool_create, pool_wait } from "std/lifecycle/pool"

pipeline default(harness: Harness) {
  const pool = pool_create({name: "idem-demo", max_concurrent: 1})
  const h1 = pool.submit({ -> 100 }, {idempotency_key: "only-once"})
  const h2 = pool.submit({ -> 200 }, {idempotency_key: "only-once"})
  harness.stdio.log(h1.id == h2.id)
  const r1 = pool_wait(h1)
  const r2 = pool_wait(h2)
  harness.stdio.log(r1.result)
  harness.stdio.log(r2.result)
  const snap = pool.snapshot()
  harness.stdio.log(snap.total)
}
