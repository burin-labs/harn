// Pipeline-scope pool persists task metadata to a JSONL log under the
// custom `dir`. After a simulated process restart, re-creating the pool
// with the same name + pipeline_id reloads the persisted tasks, and
// terminal-state results are still visible.
import { pool_create, pool_simulate_restart, pool_wait } from "std/lifecycle/pool"

pipeline default() {
  const dir = path_join(harness.fs.temp_dir(), "harn-pool-durability-pipeline-" + uuid())
  const pool = pool_create(
    {
      name: "pipeline-demo",
      scope: "pipeline",
      pipeline_id: "pipe_001",
      max_concurrent: 1,
      dir: dir,
    },
  )
  log(pool.scope)
  log(pool.scope_id)
  log(pool.durable)
  // Submit and wait so the task reaches a terminal state and the
  // durable log records it as completed.
  const h1 = pool.submit({ -> 42 }, {idempotency_key: "submit-001"})
  const r1 = pool_wait(h1)
  log(r1.status)
  log(r1.result)
  // "Kill the process": clear the in-process registry. The .harn/pools/
  // JSONL file persists.
  pool_simulate_restart()
  // Re-create the pool with the same name + pipeline_id. The store
  // re-hydrates terminal tasks and surfaces them via snapshot.
  const resumed = pool_create(
    {
      name: "pipeline-demo",
      scope: "pipeline",
      pipeline_id: "pipe_001",
      max_concurrent: 1,
      dir: dir,
    },
  )
  log(resumed.scope)
  log(resumed.durable)
  log(resumed.completed)
  log(resumed.total)
  // Idempotent re-submission of the same key returns the persisted
  // outcome (now stringified) instead of re-running the closure.
  const h2 = resumed.submit({ -> 999 }, {idempotency_key: "submit-001"})
  const r2 = pool_wait(h2)
  log(r2.status)
  log(r2.result)
}
