import {
  agent_reminder_providers_fire,
  agent_session_apply_reminder_post_turn,
} from "std/agent/state"

pipeline main(harness: Harness) {
  const session = harness.agent.open("reminder-provider-idle-nudge")
  harness.agent.reset(session)
  const opts = {reminders: {config: {idle_nudge: {idle_seconds: 60}}}}
  const first = agent_reminder_providers_fire(harness, session,
    "session_idle",
    {session: {id: session}, iteration: 2, wake_interval_ms: 65000},
    opts,
  )
  const second = agent_reminder_providers_fire(harness, session,
    "session_idle",
    {session: {id: session}, iteration: 3, wake_interval_ms: 65000},
    opts,
  )
  const before = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  const ttl = agent_session_apply_reminder_post_turn(harness, session, 4)
  const after = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  harness.stdio.println(first.fired_count)
  harness.stdio.println(second.reports[0].deduped_count)
  harness.stdio.println(len(before))
  harness.stdio.println(before[0].reminder.tags[0])
  harness.stdio.println(before[0].reminder.propagate)
  harness.stdio.println(before[0].reminder.ttl_turns)
  harness.stdio.println(ttl.expired_count)
  harness.stdio.println(len(after))
}
