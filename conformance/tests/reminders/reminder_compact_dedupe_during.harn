pipeline main() {
  let older = transcript_reminder_event(
    {body: "older copy", dedupe_key: "slot", ttl_turns: 3, preserve_on_compact: true},
  )
  let newer = transcript_reminder_event(
    {body: "newer copy", dedupe_key: "slot", ttl_turns: 3, preserve_on_compact: true},
  )
  let crafted = {
    _type: "transcript",
    messages: [
      {role: "user", content: "one"},
      {role: "assistant", content: "two"},
      {role: "user", content: "three"},
      {role: "assistant", content: "four"},
    ],
    events: [older, newer],
  }
  let compacted = transcript_compact(crafted, {strategy: "truncate", keep_last: 1, target_tokens: 1})
  let reminders = transcript_events_by_kind(compacted, "system_reminder")
  // Two reminders sharing the same dedupe_key collapse to one during
  // compaction, preserving the newest body and TTL.
  __io_println(len(reminders))
  __io_println(reminders[0].reminder.body)
  __io_println(reminders[0].reminder.dedupe_key)
  __io_println(reminders[0].reminder.ttl_turns)
}
