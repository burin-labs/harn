import {
  agent_reminder_providers_fire,
  agent_session_apply_reminder_post_turn,
} from "std/agent/state"

pipeline main() {
  clear_reminder_providers()
  register_reminder_provider(
    {
      id: "custom_echo",
      subscribes_to: ["session_idle"],
      evaluate: { ctx -> return {
        reminder: {body: "custom " + ctx.payload.note, tags: ["custom"], dedupe_key: "custom_echo", ttl_turns: 2},
      } },
    },
  )
  let session = agent_session_open("reminder-provider-user-defined")
  agent_session_reset(session)
  let payload = {session: {id: session}, iteration: 1, wake_interval_ms: 0, note: "provider"}
  let first = agent_reminder_providers_fire(session, "session_idle", payload, {})
  let second = agent_reminder_providers_fire(session, "session_idle", payload, {})
  let before = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  let ttl = agent_session_apply_reminder_post_turn(session, 2)
  let after = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  __io_println(first.fired_count)
  __io_println(second.reports[0].deduped_count)
  __io_println(len(before))
  __io_println(before[0].reminder.body)
  __io_println(before[0].reminder.source)
  __io_println(before[0].reminder.tags[0])
  __io_println(ttl.decremented_count)
  __io_println(after[0].reminder.ttl_turns)
  clear_reminder_providers()
}
