import { agent_reminder_providers_fire } from "std/agent/state"

pipeline main(harness: Harness) {
  const chunk = "0123456789abcdefghij0123456789abcdefghij0123456789abcdefghij"
  const long_body = chunk + chunk + chunk + chunk
  harness.agent.clear_reminder_providers()
  harness.agent.register_reminder_provider(
    {
      id: "large_repeat",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx ->
        return {reminder: {body: long_body, tags: ["large_repeat"], dedupe_key: "large_repeat"}}
      },
    },
  )
  const repeat_session = harness.agent.open("reminder-provider-budget-repeat")
  harness.agent.reset(repeat_session)
  harness.agent.inject(repeat_session, {role: "user", content: "one"})
  harness.agent.inject(repeat_session, {role: "assistant", content: "two"})
  harness.agent.inject(repeat_session, {role: "user", content: "three"})
  const payload = {session: {id: repeat_session}, iteration: 1, wake_interval_ms: 0}
  const fire = { ->
    agent_reminder_providers_fire(harness.agent, repeat_session, "session_idle", payload, {})
  }
  const bodies = { ->
    transcript_events_by_kind(harness.agent.snapshot(repeat_session), "system_reminder").map(
      { event -> event.reminder.body },
    )
      .to_list()
  }
  const first = fire()
  harness.stdio.println(first.fired_count)
  harness.stdio.println(bodies() == [long_body])
  // The unchanged body is still in the session, so the repeat sends nothing.
  const second = fire()
  harness.stdio.println(second.fired_count)
  harness.stdio.println(second.skipped_reports[0].reason)
  harness.stdio.println(bodies() == [long_body])
  // Compaction drops the non-durable reminder; the next emission is whole again.
  harness.agent.compact(
    repeat_session,
    {keep_last: 1, token_threshold: 1, compact_strategy: "truncate"},
  )
  harness.stdio.println(len(bodies()))
  const third = fire()
  harness.stdio.println(third.fired_count)
  harness.stdio.println(bodies() == [long_body])
  harness.agent.clear_reminder_providers()
  harness.agent.register_reminder_provider(
    {
      id: "budget_a",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx ->
        return {reminder: {body: long_body, tags: ["budget_a"], dedupe_key: "budget_a"}}
      },
    },
  )
  harness.agent.register_reminder_provider(
    {
      id: "budget_b",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx ->
        return {reminder: {body: long_body, tags: ["budget_b"], dedupe_key: "budget_b"}}
      },
    },
  )
  const budget_session = harness.agent.open("reminder-provider-budget-skip")
  harness.agent.reset(budget_session)
  const budget_payload = {session: {id: budget_session}, iteration: 1, wake_interval_ms: 0}
  const budget = agent_reminder_providers_fire(
    harness.agent,
    budget_session,
    "session_idle",
    budget_payload,
    {reminders: {max_iteration_bytes: 300}},
  )
  const budget_events = transcript_events_by_kind(
    harness.agent.snapshot(budget_session),
    "system_reminder",
  )
  harness.stdio.println(budget.fired_count)
  harness.stdio.println(budget.skipped_count)
  harness.stdio.println(budget.reports[0].provider)
  harness.stdio.println(budget.skipped_reports[0].provider)
  harness.stdio.println(budget.skipped_reports[0].reason)
  harness.stdio.println(len(budget_events))
  harness.agent.clear_reminder_providers()
}
