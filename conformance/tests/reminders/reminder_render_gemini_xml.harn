import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline main() {
  clear_reminder_providers()
  register_reminder_provider(
    {
      id: "render_gemini",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx -> return {reminder: {body: "gemini reminder", role_hint: "system"}} },
    },
  )
  let session = agent_session_open("reminder-render-gemini")
  agent_session_reset(session)
  agent_session_inject(session, {role: "user", content: "hello"})
  agent_reminder_providers_fire(session, "session_idle", {session: {id: session}}, {})
  with_llm_script(
    [llm_text("ok")],
    { ->
      llm_call(
        "ignored",
        "base system",
        {
          provider: "mock",
          model: "gemini-2.5-flash",
          messages: agent_session_messages(session),
          session_id: session,
        },
      )
      let call = llm_mock_calls()[0]
      let last = call.messages[len(call.messages) - 1]
      __io_println(contains(call.system, "base system"))
      __io_println(!contains(call.system, "<system-reminder>"))
      __io_println(contains(last.content, "<system-reminder>"))
      __io_println(contains(last.content, "gemini reminder"))
      __io_println(last.role)
      clear_reminder_providers()
    },
  )
}
// The stable primary ("base system") stays in the system string, but the
// XML-scaffolded reminder is moved to the trailing user message so the
// system string is byte-stable across turns for the prefix cache.
