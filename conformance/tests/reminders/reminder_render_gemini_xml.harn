import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  harness.agent.clear_reminder_providers()
  harness.agent.register_reminder_provider(
    {
      id: "render_gemini",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx -> return {reminder: {body: "gemini reminder", role_hint: "system"}} },
    },
  )
  const session = harness.agent.open("reminder-render-gemini")
  harness.agent.reset(session)
  harness.agent.inject(session, {role: "user", content: "hello"})
  agent_reminder_providers_fire(harness, session, "session_idle", {session: {id: session}}, {})
  with_llm_script(
    harness.llm, [llm_text("ok")],
    { ->
      harness.llm.call(
        "ignored",
        "base system",
        {
          provider: "mock",
          model: "gemini-2.5-flash",
          messages: agent_session_messages(harness, session),
          session_id: session,
        },
      )
      const call = harness.llm.mock_calls()[0]
      const last = call.messages[len(call.messages) - 1]
      harness.stdio.println(contains(call.system, "base system"))
      harness.stdio.println(!contains(call.system, "<system-reminder>"))
      harness.stdio.println(contains(last.content, "<system-reminder>"))
      harness.stdio.println(contains(last.content, "gemini reminder"))
      harness.stdio.println(last.role)
      harness.agent.clear_reminder_providers()
    },
  )
}
// The stable primary ("base system") stays in the system string, but the
// XML-scaffolded reminder is moved to the trailing user message so the
// system string is byte-stable across turns for the prefix cache.
