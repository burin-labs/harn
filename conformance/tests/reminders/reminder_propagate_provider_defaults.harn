import { agent_reminder_providers_fire } from "std/agent/state"

pipeline main() {
  const token_session = agent_session_open("reminder-propagate-provider-token")
  agent_session_reset(token_session)
  agent_reminder_providers_fire(
    token_session,
    "on_budget_threshold",
    {session: {id: token_session}, tokens_used: 80, context_window: 100},
    {},
  )
  const token =
    transcript_events_by_kind(agent_session_snapshot(token_session), "system_reminder")[0]
    .reminder
  const idle_session = agent_session_open("reminder-propagate-provider-idle")
  agent_session_reset(idle_session)
  agent_reminder_providers_fire(
    idle_session,
    "session_idle",
    {session: {id: idle_session}, wake_interval_ms: 60000},
    {},
  )
  const idle = transcript_events_by_kind(agent_session_snapshot(idle_session), "system_reminder")[0]
    .reminder
  const tool_session = agent_session_open("reminder-propagate-provider-tool")
  agent_session_reset(tool_session)
  agent_reminder_providers_fire(
    tool_session,
    "post_tool_use",
    {session: {id: tool_session}, tool_name: "read_file", truncated: true, original_size: 4096},
    {},
  )
  const tool_reminder = transcript_events_by_kind(
    agent_session_snapshot(tool_session),
    "system_reminder",
  )[0].reminder
  const recap_session = agent_session_open("reminder-propagate-provider-recap")
  agent_session_reset(recap_session)
  agent_reminder_providers_fire(
    recap_session,
    "post_compact",
    {session: {id: recap_session}, archived_messages: 3, summary: "recap"},
    {},
  )
  const recap =
    transcript_events_by_kind(agent_session_snapshot(recap_session), "system_reminder")[0]
    .reminder
  __io_println(token.propagate)
  __io_println(idle.propagate)
  __io_println(tool_reminder.propagate)
  __io_println(recap.propagate)
}
