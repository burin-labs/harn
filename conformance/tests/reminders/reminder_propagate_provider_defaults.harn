import { agent_reminder_providers_fire } from "std/agent/state"

pipeline main(harness: Harness) {
  const token_session = harness.agent.open("reminder-propagate-provider-token")
  harness.agent.reset(token_session)
  agent_reminder_providers_fire(
    harness.agent,
    token_session,
    "on_budget_threshold",
    {session: {id: token_session}, tokens_used: 80, context_window: 100},
    {},
  )
  const token =
    transcript_events_by_kind(harness.agent.snapshot(token_session), "system_reminder")[0]
    .reminder
  const idle_session = harness.agent.open("reminder-propagate-provider-idle")
  harness.agent.reset(idle_session)
  agent_reminder_providers_fire(
    harness.agent,
    idle_session,
    "session_idle",
    {session: {id: idle_session}, wake_interval_ms: 60000},
    {},
  )
  const idle = transcript_events_by_kind(harness.agent.snapshot(idle_session), "system_reminder")[0]
    .reminder
  const tool_session = harness.agent.open("reminder-propagate-provider-tool")
  harness.agent.reset(tool_session)
  agent_reminder_providers_fire(
    harness.agent,
    tool_session,
    "post_tool_use",
    {session: {id: tool_session}, tool_name: "read_file", truncated: true, original_size: 4096},
    {},
  )
  const tool_reminder = transcript_events_by_kind(
    harness.agent.snapshot(tool_session),
    "system_reminder",
  )[0].reminder
  const recap_session = harness.agent.open("reminder-propagate-provider-recap")
  harness.agent.reset(recap_session)
  agent_reminder_providers_fire(
    harness.agent,
    recap_session,
    "post_compact",
    {session: {id: recap_session}, archived_messages: 3, summary: "recap"},
    {},
  )
  const recap =
    transcript_events_by_kind(harness.agent.snapshot(recap_session), "system_reminder")[0]
    .reminder
  harness.stdio.println(token.propagate)
  harness.stdio.println(idle.propagate)
  harness.stdio.println(tool_reminder.propagate)
  harness.stdio.println(recap.propagate)
}
