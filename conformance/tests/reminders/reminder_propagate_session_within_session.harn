import { agent_session_apply_reminder_post_turn } from "std/agent/state"

pipeline main() {
  const session = agent_session_open("reminder-propagate-session-within-session")
  agent_session_reset(session)
  agent_session_inject(
    session,
    transcript_reminder_event(
      {
        body: "stays in session",
        tags: ["session"],
        dedupe_key: "session",
        propagate: "session",
        ttl_turns: 5,
      },
    ),
  )
  const after_inject = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  // Advance two turns. Session-scoped reminders survive within the same
  // session as long as their TTL has not lapsed.
  agent_session_apply_reminder_post_turn(session, 1)
  agent_session_apply_reminder_post_turn(session, 2)
  const after_turns = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  __io_println(len(after_inject))
  __io_println(after_inject[0].reminder.propagate)
  __io_println(after_inject[0].reminder.ttl_turns)
  __io_println(len(after_turns))
  __io_println(after_turns[0].reminder.body)
  // Two post-turn decrements should leave the TTL at 3.
  __io_println(after_turns[0].reminder.ttl_turns)
}
