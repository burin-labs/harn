import { agent_loop } from "std/agent/loop"
import { sub_agent_run } from "std/agent/workers"
import { llm_text, with_llm_script } from "std/testing"

fn child_tools(harness: Harness, grandchild_session: string) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_grandchild",
    "Run a grandchild sub-agent",
    {
      handler: { _args ->
        sub_agent_run(
          harness,
          "Grandchild task.",
          {
            provider: "mock",
            session_id: grandchild_session,
            max_iterations: 1,
            turn_end_condition: nil,
          },
        )
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

fn parent_tools(harness: Harness, child_session: string, grandchild_session: string) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_child",
    "Run a child sub-agent",
    {
      handler: { _args ->
        sub_agent_run(
          harness,
          "Child task.",
          {
            provider: "mock",
            session_id: child_session,
            tools: child_tools(harness, grandchild_session),
            tool_format: "native",
            max_iterations: 2,
            turn_end_condition: nil,
          },
        )
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  const parent = harness.agent.open("reminder-propagate-session-parent")
  const child = "reminder-propagate-session-child"
  const grandchild = "reminder-propagate-session-grandchild"
  harness.agent.open(child)
  harness.agent.open(grandchild)
  harness.agent.reset(parent)
  harness.agent.reset(child)
  harness.agent.reset(grandchild)
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {
        body: "session reminder",
        tags: ["session"],
        dedupe_key: "session-key",
        propagate: "session",
      },
    ),
  )
  with_llm_script(
    harness.llm,
    [
      {tool_calls: [{id: "parent_delegate", name: "delegate_child", arguments: {}}]},
      {tool_calls: [{id: "child_delegate", name: "delegate_grandchild", arguments: {}}]},
      llm_text("grandchild done"),
      llm_text("child done"),
      llm_text("parent done"),
    ],
    { ->
      agent_loop(
        harness,
        "Run child.",
        nil,
        {
          provider: "mock",
          session_id: parent,
          tools: parent_tools(harness, child, grandchild),
          tool_format: "native",
          max_iterations: 2,
          turn_end_condition: nil,
        },
      )
      const child_reminders = transcript_events_by_kind(
        harness.agent.snapshot(child),
        "system_reminder",
      )
      const grandchild_reminders = transcript_events_by_kind(
        harness.agent.snapshot(grandchild),
        "system_reminder",
      )
      harness.stdio.println(len(child_reminders))
      harness.stdio.println(child_reminders[0].reminder.body)
      harness.stdio.println(child_reminders[0].reminder.source)
      harness.stdio.println(child_reminders[0].reminder.originating_agent_id == parent)
      harness.stdio.println(len(grandchild_reminders))
    },
  )
}
