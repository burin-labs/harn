import { llm_text, with_llm_script } from "std/testing"

fn child_tools(grandchild_session) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_grandchild",
    "Run a grandchild sub-agent",
    {
      handler: { _args ->
        sub_agent_run(
          "Grandchild task.",
          {provider: "mock", session_id: grandchild_session, max_iterations: 1, done_judge: nil},
        )
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

fn parent_tools(child_session, grandchild_session) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_child",
    "Run a child sub-agent",
    {
      handler: { _args ->
        sub_agent_run(
          "Child task.",
          {
            provider: "mock",
            session_id: child_session,
            tools: child_tools(grandchild_session),
            tool_format: "native",
            max_iterations: 2,
            done_judge: nil,
          },
        )
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

pipeline main() {
  const parent = agent_session_open("reminder-propagate-session-parent")
  const child = "reminder-propagate-session-child"
  const grandchild = "reminder-propagate-session-grandchild"
  agent_session_open(child)
  agent_session_open(grandchild)
  agent_session_reset(parent)
  agent_session_reset(child)
  agent_session_reset(grandchild)
  agent_session_inject(
    parent,
    transcript_reminder_event(
      {
        body: "session reminder",
        tags: ["session"],
        dedupe_key: "session-key",
        propagate: "session",
      },
    ),
  )
  with_llm_script(
    [
      {tool_calls: [{id: "parent_delegate", name: "delegate_child", arguments: {}}]},
      {tool_calls: [{id: "child_delegate", name: "delegate_grandchild", arguments: {}}]},
      llm_text("grandchild done"),
      llm_text("child done"),
      llm_text("parent done"),
    ],
    { ->
      agent_loop(
        "Run child.",
        nil,
        {
          provider: "mock",
          session_id: parent,
          tools: parent_tools(child, grandchild),
          tool_format: "native",
          max_iterations: 2,
          done_judge: nil,
        },
      )
      const child_reminders = transcript_events_by_kind(
        agent_session_snapshot(child),
        "system_reminder",
      )
      const grandchild_reminders = transcript_events_by_kind(
        agent_session_snapshot(grandchild),
        "system_reminder",
      )
      __io_println(len(child_reminders))
      __io_println(child_reminders[0].reminder.body)
      __io_println(child_reminders[0].reminder.source)
      __io_println(child_reminders[0].reminder.originating_agent_id == parent)
      __io_println(len(grandchild_reminders))
    },
  )
}
