import { agent_reminder_providers_fire } from "std/agent/state"

pipeline main(harness: Harness) {
  harness.agent.clear_reminder_providers()
  harness.agent.register_reminder_provider(
    {
      id: "worker_spawn_reminder",
      subscribes_to: ["WorkerSpawned"],
      evaluate: { _ctx -> return {reminder: {body: "worker spawned"}} },
    },
  )
  const session = harness.agent.open("reminder-hook-worker-unsupported-event")
  harness.agent.reset(session)
  agent_reminder_providers_fire(harness, session, "WorkerSpawned", {session: {id: session}}, {})
  harness.agent.clear_reminder_providers()
}
