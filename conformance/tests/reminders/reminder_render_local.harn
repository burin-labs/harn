import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline main() {
  clear_reminder_providers()
  register_reminder_provider(
    {
      id: "render_local",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx -> return {reminder: {body: "local reminder", role_hint: "user_block"}} },
    },
  )
  let session = agent_session_open("reminder-render-local")
  agent_session_reset(session)
  agent_session_inject(session, {role: "user", content: "hello"})
  agent_reminder_providers_fire(session, "session_idle", {session: {id: session}}, {})
  with_llm_script(
    [llm_text("ok")],
    { ->
      llm_call(
        "ignored",
        "base system",
        {provider: "mock", model: "mock", messages: agent_session_messages(session), session_id: session},
      )
      let call = llm_mock_calls()[0]
      let last = call.messages[len(call.messages) - 1]
      __io_println(!contains(call.system, "System reminder:"))
      __io_println(contains(last.content, "System reminder:"))
      __io_println(contains(last.content, "local reminder"))
      __io_println(!contains(last.content, "<system-reminder>"))
      __io_println(last.role)
      clear_reminder_providers()
    },
  )
}
// SystemText reminders move out of the system string into the trailing
// user message; the plain-prose body is preserved at the new position.
