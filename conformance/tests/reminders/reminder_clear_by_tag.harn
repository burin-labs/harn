pipeline main() {
  const a = transcript
    .inject_reminder(transcript(), {body: "tagged", tags: ["watchlist"], dedupe_key: "a"})
  const b = transcript
    .inject_reminder(a.transcript, {body: "untagged", tags: ["other"], dedupe_key: "b"})
  const cleared = transcript.clear_reminders(b.transcript, {tag: "watchlist"})
  const events = transcript_events_by_kind(cleared.transcript, "system_reminder")
  __io_println(cleared.removed_count)
  __io_println(len(events))
  __io_println(events[0].reminder.body)
  __io_println(events[0].reminder.tags[0])
}
