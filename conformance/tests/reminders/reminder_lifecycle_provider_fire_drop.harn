import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline main() {
  clear_reminder_providers()
  register_reminder_provider(
    {
      id: "lifecycle_provider",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx -> return {
        reminder: {
          body: "provider reminder",
          tags: ["provider"],
          dedupe_key: "provider-slot",
          ttl_turns: 2,
          role_hint: "developer",
        },
      } },
    },
  )
  const topic = "transcript.reminder.lifecycle"
  const session = agent_session_open("reminder-lifecycle-provider-fire-drop")
  agent_session_reset(session)
  agent_session_inject(session, {role: "user", content: "hello"})
  const cursor = event_log.latest(topic)
  const report = agent_reminder_providers_fire(
    session,
    "session_idle",
    {session: {id: session}, iteration: 4},
    {
      reminders: {
        providers: [
          "-token_pressure",
          "-idle_nudge",
          "-tool_output_truncated",
          "-post_compact_recap",
          "lifecycle_provider",
        ],
      },
    },
  )
  with_llm_script(
    [llm_text("ok"), llm_text("ok"), llm_text("ok")],
    { ->
      llm_call(
        "ignored",
        nil,
        {
          provider: "mock",
          model: "o3",
          messages: agent_session_messages(session),
          session_id: session,
          _iteration: 4,
        },
      )
      agent_session_reset(session)
      agent_session_inject(
        session,
        {
          id: "bad-reminder-event",
          kind: "system_reminder",
          role: "system",
          visibility: "public",
          text: "bad",
          reminder: {id: "bad-reminder"},
        },
      )
      llm_call("ignored", nil, {provider: "mock", model: "o3", session_id: session})
      const after_first_drop = event_log.latest(topic)
      llm_call("ignored", nil, {provider: "mock", model: "o3", session_id: session})
      const drop_was_one_shot = event_log.latest(topic) == after_first_drop
      const validation_session = agent_session_open("reminder-lifecycle-validation-no-fire")
      agent_session_reset(validation_session)
      agent_session_inject(validation_session, transcript_reminder_event({body: "do not fire"}))
      const validation_cursor = event_log.latest(topic)
      const rejected = try {
        llm_call(
          "ignored",
          nil,
          {provider: "mock", model: "o3", session_id: validation_session, transcript: {}},
        )
        false
      } catch (e) {
        contains(json_stringify(e), "transcript")
      }
      const validation_did_not_fire = event_log.latest(topic) == validation_cursor
      const stream = event_log.subscribe({topic: topic, from_cursor: cursor, kind_prefix: "transcript.reminder."})
      const evaluated = stream.next().value
      const injected = stream.next().value
      const fired = stream.next().value
      const summary = stream.next().value
      const dropped = stream.next().value
      __io_println(report.fired_count)
      __io_println(evaluated.kind)
      __io_println(evaluated.payload.provider_id)
      __io_println(evaluated.payload.event)
      __io_println(evaluated.payload.fired)
      __io_println(injected.kind)
      __io_println(injected.payload.source)
      __io_println(fired.kind)
      __io_println(fired.payload.session_id == session)
      __io_println(fired.payload.turn_number)
      __io_println(fired.payload.rendered_role)
      __io_println(summary.kind)
      __io_println(summary.payload.session_id == session)
      __io_println(summary.payload.turn_number)
      __io_println(summary.payload.count)
      __io_println(summary.payload.by_source[0].source)
      __io_println(summary.payload.by_rendered_role[0].rendered_role)
      __io_println(dropped.kind)
      __io_println(dropped.payload.session_id == session)
      __io_println(dropped.payload.reminder_id)
      __io_println(dropped.payload.reason)
      __io_println(drop_was_one_shot)
      __io_println(rejected)
      __io_println(validation_did_not_fire)
      clear_reminder_providers()
    },
  )
}
