import { agent_session_apply_reminder_post_turn } from "std/agent/state"

pipeline main(harness: Harness) {
  const topic = "transcript.reminder.lifecycle"
  const cursor = harness.obs.event_log_latest(topic)
  const session = harness.agent.open("reminder-ttl-post-turn")
  harness.agent.reset(session)
  harness.agent.inject(session, transcript_reminder_event({body: "expire", ttl_turns: 1}))
  harness.agent.inject(session, transcript_reminder_event({body: "stay", ttl_turns: 2}))
  const report = agent_session_apply_reminder_post_turn(harness.agent, session, 7)
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  const stream = harness.obs.event_log_subscribe({topic: topic, from_cursor: cursor})
  const logged = stream.next().value
  harness.stdio.println(report.expired_count)
  harness.stdio.println(report.decremented_count)
  harness.stdio.println(len(reminders))
  harness.stdio.println(reminders[0].reminder.body)
  harness.stdio.println(reminders[0].reminder.ttl_turns)
  harness.stdio.println(logged.kind)
  harness.stdio.println(logged.payload.reminder_id != "")
  harness.stdio.println(logged.payload.session_id == session)
  harness.stdio.println(logged.payload.agent_id == session)
  harness.stdio.println(logged.payload.task_id == nil)
  harness.stdio.println(logged.payload.reason)
  harness.stdio.println(logged.payload.ttl_turns_before)
  harness.stdio.println(logged.payload.expired_at_turn)
}
