pipeline main() {
  const base = transcript_from_messages(
    [
      {role: "user", content: "one"},
      {role: "assistant", content: "two"},
      {role: "user", content: "three"},
      {role: "assistant", content: "four"},
    ],
  )
  const kept = transcript.inject_reminder(
    base,
    {body: "keep me", dedupe_key: "keep", ttl_turns: 2, preserve_on_compact: true},
  ).transcript
  const mixed = transcript.inject_reminder(
    kept,
    {body: "drop me", dedupe_key: "drop", ttl_turns: 2, preserve_on_compact: false},
  ).transcript
  const compacted = transcript_compact(mixed, {strategy: "truncate", keep_last: 1, target_tokens: 1})
  const reminders = transcript_events_by_kind(compacted, "system_reminder")
  __io_println(len(reminders))
  __io_println(reminders[0].reminder.body)
  __io_println(reminders[0].reminder.ttl_turns)
  __io_println(transcript_summary(compacted)?.contains("auto-compacted"))
}
