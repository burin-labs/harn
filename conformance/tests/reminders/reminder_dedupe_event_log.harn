pipeline main() {
  const topic = "transcript.reminder.lifecycle"
  const cursor = event_log.latest(topic)
  const first = transcript
    .inject_reminder(transcript(), {body: "old reminder", dedupe_key: "context-slot", ttl_turns: 2})
  const second = transcript
    .inject_reminder(
    first.transcript,
    {body: "new reminder", dedupe_key: "context-slot", ttl_turns: 3},
  )
  const stream = event_log.subscribe({topic: topic, from_cursor: cursor})
  const injected = stream.next().value
  const logged = stream.next().value
  __io_println(second.deduped_count)
  __io_println(injected.kind)
  __io_println(logged.kind)
  __io_println(logged.payload.dedupe_key)
  __io_println(logged.payload.reminder_id == second.reminder_id)
  __io_println(logged.payload.replacing_id == second.reminder_id)
  __io_println(logged.payload.replaced_id == first.reminder_id)
  __io_println(logged.payload.dropped_count)
  __io_println(len(logged.payload.dropped_reminder_ids))
}
