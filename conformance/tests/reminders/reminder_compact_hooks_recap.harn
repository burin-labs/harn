pipeline main(harness: Harness) {
  const pre_seen = harness.runtime.atomic(0)
  const post_seen = harness.runtime.atomic(0)
  harness.agent.clear_session_hooks()
  const session = harness.agent.open("reminder-compact-hooks-recap")
  harness.agent.reset(session)
  harness.agent.inject(session, {role: "user", content: "one"})
  harness.agent.inject(session, {role: "assistant", content: "two"})
  harness.agent.inject(session, {role: "user", content: "three"})
  harness.agent.inject(session, {role: "assistant", content: "four"})
  harness.agent.register_session_hook(
    "pre_compact",
    { _hook_harness, event ->
      if event?.session?.id == session {
        harness.runtime.atomic_add(pre_seen, 1)
      }
      if harness.runtime.atomic_get(pre_seen) == 1 {
        return {block: true, reason: "first compaction intentionally vetoed"}
      }
      return nil
    },
  )
  harness.agent.register_session_hook(
    "post_compact",
    { _hook_harness, event ->
      if (event?.archived_messages ?? 0) > 0 {
        harness.runtime.atomic_add(post_seen, 1)
      }
      return nil
    },
  )
  const opts = {strategy: "truncate", keep_last: 1, target_tokens: 1}
  const snapshot = harness.agent.snapshot(session) ?? {}
  const blocked = harness.agent.compact_transcript(snapshot, opts)
  const compacted = harness.agent.compact_transcript(snapshot, opts)
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  harness.stdio.println(len(transcript_events_by_kind(blocked, "compaction")))
  harness.stdio.println(harness.runtime.atomic_get(pre_seen))
  harness.stdio.println(harness.runtime.atomic_get(post_seen))
  harness.stdio.println(len(reminders))
  harness.stdio.println(reminders[0].reminder.tags[0])
  harness.stdio.println(reminders[0].reminder.body.contains("Transcript compacted"))
  harness.stdio.println(len(transcript_events_by_kind(compacted, "compaction")))
  harness.agent.clear_session_hooks()
}
