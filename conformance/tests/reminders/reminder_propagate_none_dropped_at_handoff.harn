import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn tools(stdio: HarnessStdio) {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "emit_handoff",
    "Emit a handoff artifact",
    {
      handler: { _args ->
        const record = handoff(
          {
            source_persona: "parent",
            target_persona_or_human: {kind: "persona", id: "child", label: "child"},
            task: "Run inherited reminder work",
            reason: "Verifying propagate=none is dropped at handoff",
          },
        )
        stdio.println(len(record.reminder_propagation))
        stdio.println(record.reminder_propagation[0].body)
        stdio.println(record.reminder_propagation[0].source)
        let saw_none = false
        for entry in record.reminder_propagation {
          if entry.body == "dropped at handoff" {
            saw_none = true
          }
        }
        stdio.println(saw_none)
        record
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return registry
}

pipeline main(harness: Harness) {
  // The handoff envelope must omit propagate=none reminders, keeping
  // only the propagate=all entry.
  const parent = harness.agent.open("reminder-propagate-none-dropped-at-handoff")
  harness.agent.reset(parent)
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {body: "carried into handoff", tags: ["all"], dedupe_key: "all-key", propagate: "all"},
    ),
  )
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {body: "dropped at handoff", tags: ["none"], dedupe_key: "none-key", propagate: "none"},
    ),
  )
  with_llm_script(
    harness.llm,
    [{tool_calls: [{id: "handoff_call", name: "emit_handoff", arguments: {}}]}, llm_text("done")],
    { ->
      agent_loop(
        harness,
        "Emit a handoff.",
        nil,
        {
          provider: "mock",
          session_id: parent,
          tools: tools(harness.stdio),
          tool_format: "native",
          max_iterations: 2,
          turn_end_condition: nil,
        },
      )
    },
  )
}
