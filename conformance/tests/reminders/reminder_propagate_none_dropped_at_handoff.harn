import { llm_text, with_llm_script } from "std/testing"

fn tools() {
  var registry = tool_registry()
  registry = tool_define(
    registry,
    "emit_handoff",
    "Emit a handoff artifact",
    {
      handler: { _args ->
        let record = handoff(
          {
            source_persona: "parent",
            target_persona_or_human: {kind: "persona", id: "child", label: "child"},
            task: "Run inherited reminder work",
            reason: "Verifying propagate=none is dropped at handoff",
          },
        )
        __io_println(len(record.reminder_propagation))
        __io_println(record.reminder_propagation[0].body)
        __io_println(record.reminder_propagation[0].source)
        var saw_none = false
        for entry in record.reminder_propagation {
          if entry.body == "dropped at handoff" {
            saw_none = true
          }
        }
        __io_println(saw_none)
        record
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return registry
}

pipeline main() {
  // The handoff envelope must omit propagate=none reminders, keeping
  // only the propagate=all entry.
  let parent = agent_session_open("reminder-propagate-none-dropped-at-handoff")
  agent_session_reset(parent)
  agent_session_inject(
    parent,
    transcript_reminder_event(
      {body: "carried into handoff", tags: ["all"], dedupe_key: "all-key", propagate: "all"},
    ),
  )
  agent_session_inject(
    parent,
    transcript_reminder_event(
      {body: "dropped at handoff", tags: ["none"], dedupe_key: "none-key", propagate: "none"},
    ),
  )
  with_llm_script(
    [{tool_calls: [{id: "handoff_call", name: "emit_handoff", arguments: {}}]}, llm_text("done")],
    { -> agent_loop(
      "Emit a handoff.",
      nil,
      {
        provider: "mock",
        session_id: parent,
        tools: tools(),
        tool_format: "native",
        max_iterations: 2,
        done_judge: nil,
      },
    ) },
  )
}
