pipeline main() {
  const old = transcript_reminder_event(
    {body: "old duplicate", dedupe_key: "slot", ttl_turns: 3, preserve_on_compact: true},
  )
  const newest = transcript_reminder_event(
    {body: "new duplicate", dedupe_key: "slot", ttl_turns: 3, preserve_on_compact: true},
  )
  const crafted = {
    _type: "transcript",
    messages: [
      {role: "user", content: "one"},
      {role: "assistant", content: "two"},
      {role: "user", content: "three"},
      {role: "assistant", content: "four"},
    ],
    events: [old, newest],
  }
  const compacted = transcript_compact(crafted, {strategy: "truncate", keep_last: 1, target_tokens: 1})
  const reminders = transcript_events_by_kind(compacted, "system_reminder")
  __io_println(len(reminders))
  __io_println(reminders[0].reminder.body)
  __io_println(reminders[0].reminder.ttl_turns)
}
