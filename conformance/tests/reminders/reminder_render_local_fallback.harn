import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  // Renders the plain-text fallback used for providers without a richer
  // system-reminder envelope (mock provider here stands in for any model
  // outside Anthropic/OpenAI/Gemini paths). role_hint "system" avoids the
  // provider-capability lint while still routing through the local fallback.
  harness.agent.clear_reminder_providers()
  harness.agent.register_reminder_provider(
    {
      id: "render_local_fallback",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx ->
        return {reminder: {body: "local fallback reminder", role_hint: "system"}}
      },
    },
  )
  const session = harness.agent.open("reminder-render-local-fallback")
  harness.agent.reset(session)
  harness.agent.inject(session, {role: "user", content: "hello"})
  agent_reminder_providers_fire(
    harness.agent,
    session,
    "session_idle",
    {session: {id: session}},
    {},
  )
  with_llm_script(
    harness.llm,
    [llm_text("ok")],
    { ->
      harness.llm.call(
        "ignored",
        "base system",
        {
          provider: "mock",
          model: "mock",
          messages: agent_session_messages(harness.agent, session),
          session_id: session,
        },
      )
      const call = harness.llm.mock_calls()[0]
      const last = call.messages[len(call.messages) - 1]
      harness.stdio.println(!contains(call.system, "System reminder:"))
      harness.stdio.println(contains(last.content, "System reminder:"))
      harness.stdio.println(contains(last.content, "local fallback reminder"))
      harness.stdio.println(!contains(last.content, "<system-reminder>"))
      harness.stdio.println(last.role)
      harness.agent.clear_reminder_providers()
    },
  )
}
// SystemText reminders are kept OUT of the system string (so it stays
// byte-stable across turns for the non-Anthropic prefix cache) and
// folded into the trailing user message instead. The plain-prose body
// and "no XML scaffolding" invariants are preserved at the new position.
// Local fallback uses plain prose, not XML tags, now in the trailing message.
