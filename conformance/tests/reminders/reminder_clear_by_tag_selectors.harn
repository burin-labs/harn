pipeline main() {
  const first = transcript
    .inject_reminder(transcript(), {body: "clear by id", tags: ["id_tag"], dedupe_key: "id-key"})
  const second = transcript
    .inject_reminder(
    first.transcript,
    {body: "clear by dedupe", tags: ["dedupe_tag"], dedupe_key: "dedupe-key"},
  )
  const third = transcript
    .inject_reminder(
    second.transcript,
    {body: "clear by tag", tags: ["tagged"], dedupe_key: "tag-key"},
  )
  const by_id = transcript.clear_reminders(third.transcript, {id: first.reminder_id})
  const by_dedupe = transcript.clear_reminders(by_id.transcript, {dedupe_key: "dedupe-key"})
  const by_tag = transcript.clear_reminders(by_dedupe.transcript, {tag: "tagged"})
  const events = transcript_events_by_kind(by_tag.transcript, "system_reminder")
  __io_println(by_id.removed_count)
  __io_println(by_dedupe.removed_count)
  __io_println(by_tag.removed_count)
  __io_println(len(events))
}
