pipeline main(harness: Harness) {
  const first = harness.agent.transcript_inject_reminder(
    transcript(),
    {body: "clear by id", tags: ["id_tag"], dedupe_key: "id-key"},
  )
  const second = harness.agent.transcript_inject_reminder(
    first.transcript,
    {body: "clear by dedupe", tags: ["dedupe_tag"], dedupe_key: "dedupe-key"},
  )
  const third = harness.agent.transcript_inject_reminder(
    second.transcript,
    {body: "clear by tag", tags: ["tagged"], dedupe_key: "tag-key"},
  )
  const by_id = harness.agent.transcript_clear_reminders(third.transcript, {id: first.reminder_id})
  const by_dedupe = harness.agent.transcript_clear_reminders(
    by_id.transcript,
    {dedupe_key: "dedupe-key"},
  )
  const by_tag = harness.agent.transcript_clear_reminders(by_dedupe.transcript, {tag: "tagged"})
  const events = transcript_events_by_kind(by_tag.transcript, "system_reminder")
  harness.stdio.println(by_id.removed_count)
  harness.stdio.println(by_dedupe.removed_count)
  harness.stdio.println(by_tag.removed_count)
  harness.stdio.println(len(events))
}
