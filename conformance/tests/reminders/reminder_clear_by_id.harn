pipeline main() {
  const first = transcript.inject_reminder(transcript(), {body: "first", dedupe_key: "k1"})
  const second = transcript.inject_reminder(first.transcript, {body: "second", dedupe_key: "k2"})
  const cleared = transcript.clear_reminders(second.transcript, {id: first.reminder_id})
  const events = transcript_events_by_kind(cleared.transcript, "system_reminder")
  __io_println(cleared.removed_count)
  __io_println(len(events))
  __io_println(events[0].reminder.body)
}
