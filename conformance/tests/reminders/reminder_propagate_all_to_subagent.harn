import { agent_loop } from "std/agent/loop"
import { sub_agent_run } from "std/agent/workers"
import { llm_text, with_llm_script } from "std/testing"

fn child_tools() {
  return tool_registry()
}

fn parent_tools(harness: Harness, child_session: string) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_child",
    "Run a child sub-agent",
    {
      handler: { _args ->
        sub_agent_run(
          harness,
          "Child task.",
          {
            provider: "mock",
            session_id: child_session,
            tools: child_tools(),
            tool_format: "native",
            max_iterations: 1,
            done_judge: nil,
          },
        )
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

pipeline main(harness: Harness) {
  const parent = harness.agent.open("reminder-propagate-all-to-subagent-parent")
  const child = "reminder-propagate-all-to-subagent-child"
  harness.agent.open(child)
  harness.agent.reset(parent)
  harness.agent.reset(child)
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {body: "shared with subagent", tags: ["all"], dedupe_key: "all", propagate: "all"},
    ),
  )
  with_llm_script(
    harness.llm,
    [
      {tool_calls: [{id: "parent_delegate", name: "delegate_child", arguments: {}}]},
      llm_text("child done"),
      llm_text("parent done"),
    ],
    { ->
      agent_loop(
        harness,
        "Run child.",
        nil,
        {
          provider: "mock",
          session_id: parent,
          tools: parent_tools(harness, child),
          tool_format: "native",
          max_iterations: 2,
          done_judge: nil,
        },
      )
      const child_reminders = transcript_events_by_kind(
        harness.agent.snapshot(child),
        "system_reminder",
      )
      harness.stdio.println(len(child_reminders))
      harness.stdio.println(child_reminders[0].reminder.body)
      harness.stdio.println(child_reminders[0].reminder.propagate)
      harness.stdio.println(child_reminders[0].reminder.originating_agent_id == parent)
    },
  )
}
