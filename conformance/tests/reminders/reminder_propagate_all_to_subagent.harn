import { llm_text, with_llm_script } from "std/testing"

fn child_tools() {
  return tool_registry()
}

fn parent_tools(child_session) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "delegate_child",
    "Run a child sub-agent",
    {
      handler: { _args -> sub_agent_run(
        "Child task.",
        {
          provider: "mock",
          session_id: child_session,
          tools: child_tools(),
          tool_format: "native",
          max_iterations: 1,
          done_judge: nil,
        },
      ) },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return tools
}

pipeline main() {
  const parent = agent_session_open("reminder-propagate-all-to-subagent-parent")
  const child = "reminder-propagate-all-to-subagent-child"
  agent_session_open(child)
  agent_session_reset(parent)
  agent_session_reset(child)
  agent_session_inject(
    parent,
    transcript_reminder_event(
      {body: "shared with subagent", tags: ["all"], dedupe_key: "all", propagate: "all"},
    ),
  )
  with_llm_script(
    [
      {tool_calls: [{id: "parent_delegate", name: "delegate_child", arguments: {}}]},
      llm_text("child done"),
      llm_text("parent done"),
    ],
    { ->
      agent_loop(
        "Run child.",
        nil,
        {
          provider: "mock",
          session_id: parent,
          tools: parent_tools(child),
          tool_format: "native",
          max_iterations: 2,
          done_judge: nil,
        },
      )
      const child_reminders = transcript_events_by_kind(agent_session_snapshot(child), "system_reminder")
      __io_println(len(child_reminders))
      __io_println(child_reminders[0].reminder.body)
      __io_println(child_reminders[0].reminder.propagate)
      __io_println(child_reminders[0].reminder.originating_agent_id == parent)
    },
  )
}
