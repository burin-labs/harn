import { agent_reminder_providers_fire, agent_session_messages } from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline main(harness: Harness) {
  harness.agent.clear_reminder_providers()
  harness.agent.register_reminder_provider(
    {
      id: "render_anthropic_user",
      subscribes_to: ["session_idle"],
      evaluate: { _ctx ->
        return {reminder: {body: "anthropic user block reminder", role_hint: "user_block"}}
      },
    },
  )
  const session = harness.agent.open("reminder-render-anthropic-user-block")
  harness.agent.reset(session)
  harness.agent.inject(session, {role: "user", content: "hello"})
  agent_reminder_providers_fire(
    harness.agent,
    session,
    "session_idle",
    {session: {id: session}},
    {},
  )
  with_llm_script(
    harness.llm,
    [llm_text("ok")],
    { ->
      harness.llm.call(
        "ignored",
        nil,
        {
          provider: "mock",
          model: "claude-sonnet-4-7",
          messages: agent_session_messages(harness.agent, session),
          session_id: session,
        },
      )
      const call = harness.llm.mock_calls()[0]
      harness.stdio.println(call.messages[0].role)
      harness.stdio.println(contains(call.messages[0].content[0].text, "<system-reminder>"))
      harness.stdio.println(
        contains(call.messages[0].content[0].text, "anthropic user block reminder"),
      )
      harness.stdio.println(call.messages[0].content[0].cache_control == nil)
      harness.stdio.println(call.messages[0].content[1].text)
      harness.agent.clear_reminder_providers()
    },
  )
}
// user_block role hint does NOT request ephemeral caching by itself.
