import { agent_session_apply_reminder_post_turn } from "std/agent/state"

pipeline main() {
  const session = agent_session_open("reminder-inject-ttl-expires")
  agent_session_reset(session)
  agent_session_inject(session, transcript_reminder_event({body: "expire me", ttl_turns: 1}))
  const before = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  const report = agent_session_apply_reminder_post_turn(session, 1)
  const after = transcript_events_by_kind(agent_session_snapshot(session), "system_reminder")
  __io_println(len(before))
  __io_println(before[0].reminder.ttl_turns)
  __io_println(report.expired_count)
  __io_println(report.decremented_count)
  __io_println(len(after))
}
