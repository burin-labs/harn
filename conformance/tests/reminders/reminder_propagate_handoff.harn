import { agent_loop } from "std/agent/loop"
import { llm_text, with_llm_script } from "std/testing"

fn tools(stdio: HarnessStdio) {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "emit_handoff",
    "Emit a handoff artifact",
    {
      handler: { _args ->
        const record = handoff(
          {
            source_persona: "parent",
            target_persona_or_human: {kind: "persona", id: "child", label: "child"},
            task: "Run inherited reminder work",
            reason: "Testing reminder propagation envelope",
          },
        )
        stdio.println(len(record.reminder_propagation))
        stdio.println(record.reminder_propagation[0].body)
        stdio.println(record.reminder_propagation[0].source)
        stdio.println(
          record.reminder_propagation[0].originating_agent_id
            == "reminder-propagate-handoff-parent",
        )
        stdio.println(record.reminder_propagation[1].body)
        stdio.println(record.reminder_propagation[1].source)
        stdio.println(
          record.reminder_propagation[1].originating_agent_id
            == "reminder-propagate-handoff-parent",
        )
        record
      },
      parameters: {},
      returns: {type: "object"},
    },
  )
  return registry
}

pipeline main(harness: Harness) {
  const parent = harness.agent.open("reminder-propagate-handoff-parent")
  harness.agent.reset(parent)
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {body: "all reminder", tags: ["all"], dedupe_key: "all-key", propagate: "all"},
    ),
  )
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {
        body: "session reminder",
        tags: ["session"],
        dedupe_key: "session-key",
        propagate: "session",
      },
    ),
  )
  harness.agent.inject(
    parent,
    transcript_reminder_event(
      {body: "none reminder", tags: ["none"], dedupe_key: "none-key", propagate: "none"},
    ),
  )
  with_llm_script(
    harness.llm,
    [{tool_calls: [{id: "handoff_call", name: "emit_handoff", arguments: {}}]}, llm_text("done")],
    { ->
      agent_loop(
        harness,
        "Emit a handoff.",
        nil,
        {
          provider: "mock",
          session_id: parent,
          tools: tools(harness.stdio),
          tool_format: "native",
          max_iterations: 2,
          done_judge: nil,
        },
      )
    },
  )
}
