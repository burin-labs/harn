pipeline main() {
  const base = transcript()
  const first = transcript
    .inject_reminder(
    base,
    {body: "old reminder", tags: ["context"], dedupe_key: "context-slot", ttl_turns: 2},
  )
  const second = transcript
    .inject_reminder(
    first.transcript,
    {
      body: "new reminder",
      tags: ["context"],
      dedupe_key: "context-slot",
      ttl_turns: 3,
      role_hint: "developer",
    },
  )
  const events = transcript_events_by_kind(second.transcript, "system_reminder")
  __io_println(second.deduped_count)
  __io_println(len(events))
  __io_println(events[0].text)
  __io_println(events[0].reminder.ttl_turns)
  __io_println(events[0].role)
  __io_println(len(transcript_messages(second.transcript)))
}
