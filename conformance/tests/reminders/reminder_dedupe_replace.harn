pipeline main(harness: Harness) {
  const base = transcript()
  const first = transcript.inject_reminder(
    base,
    {body: "old reminder", tags: ["context"], dedupe_key: "context-slot", ttl_turns: 2},
  )
  const second = transcript.inject_reminder(
    first.transcript,
    {
      body: "new reminder",
      tags: ["context"],
      dedupe_key: "context-slot",
      ttl_turns: 3,
      role_hint: "developer",
    },
  )
  const events = transcript_events_by_kind(second.transcript, "system_reminder")
  harness.stdio.println(second.deduped_count)
  harness.stdio.println(len(events))
  harness.stdio.println(events[0].text)
  harness.stdio.println(events[0].reminder.ttl_turns)
  harness.stdio.println(events[0].role)
  harness.stdio.println(len(transcript_messages(second.transcript)))
}
