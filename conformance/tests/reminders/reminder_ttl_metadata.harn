pipeline main() {
  const injected = transcript.inject_reminder(
    transcript(),
    {body: "ttl reminder", ttl_turns: 5, preserve_on_compact: true, propagate: "none"},
  )
  const events = transcript_events_by_kind(injected.transcript, "system_reminder")
  __io_println(len(events))
  __io_println(events[0].reminder.body)
  __io_println(events[0].reminder.ttl_turns)
  __io_println(events[0].reminder.preserve_on_compact)
  __io_println(events[0].reminder.propagate)
  __io_println(events[0].reminder.source)
  __io_println(injected.deduped_count)
}
