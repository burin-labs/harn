        "occurred_at_ms": 1770000003200,
        "payload": {"binding_id": "missing-drift", "result": {"status": "dispatched"}}
      }
    ]
  },
  "second_run": {
    "run_id": "run_replay_missing_drift",
    "event_log_entries": [
      {
        "event_id": 701,
        "topic": "trigger.outbox",
        "kind": "dispatch_succeeded",
        "occurred_at_ms": 1770001003200,
        "payload": {"binding_id": "missing-drift", "result": {"status": "dispatched"}}
      }
    ]
  }
