pipeline default(harness: Harness, task: unknown) {
  const result = harness.llm.call_safe(
    "Reply with exactly PONG.",
    "Return only the requested word.",
    {
      provider: "cerebras",
      model: "gpt-oss-120b",
      stream: true,
      max_tokens: 32,
      temperature: 0.0,
      retries: 0,
      timeout_ms: 30000,
    },
  )
  harness.stdio.println(json_stringify(result))
}
