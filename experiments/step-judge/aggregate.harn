import { parse, parser } from "std/cli/argparse"
import { Summary, load_summary } from "./summary"

type CellSummary = {label: string, summary: Summary}

type Stats = {
  runs: int,
  passed: int,
  skipped: int,
  pass_rate_pct: float,
  cost_usd: float?,
  input_tokens: int,
  output_tokens: int,
}

fn load_cells(fs: HarnessFs, directory: string) -> list<CellSummary> {
  let summaries: list<CellSummary> = []
  for entry in fs.list_dir(directory).sorted() {
    const path = path_join(directory, entry, "summary.json")
    if fs.exists(path) {
      summaries.push({label: entry, summary: load_summary(fs, path)})
    }
  }
  require summaries.count > 0, "No measurements found under ${directory}"
  return summaries
}

fn stats(summaries: list<CellSummary>) -> Stats {
  let runs = 0
  let passed = 0
  let skipped = 0
  let cost = 0.0
  let complete_cost = true
  let input_tokens = 0
  let output_tokens = 0
  for entry in summaries {
    const summary = entry.summary
    runs = runs + summary.total_runs
    passed = passed + summary.passed_runs
    skipped = skipped + summary.skipped_runs
    if summary.total_cost_usd == nil {
      complete_cost = false
    } else {
      cost = cost + summary.total_cost_usd
    }
    for run in summary.runs {
      input_tokens = input_tokens + run.input_tokens
      output_tokens = output_tokens + run.output_tokens
    }
  }
  return {
    runs: runs,
    passed: passed,
    skipped: skipped,
    pass_rate_pct: to_float(passed) * 100.0 / to_float(runs),
    cost_usd: if complete_cost {
      cost
    } else {
      nil
    },
    input_tokens: input_tokens,
    output_tokens: output_tokens,
  }
}

fn cost_label(value: float?) -> string {
  return if value == nil {
    "unknown"
  } else {
    to_string(value)
  }
}

fn render(summaries: list<CellSummary>, directory: string) -> string {
  let groups: dict<string, list<CellSummary>> = {}
  for entry in summaries {
    const cell = regex_replace(r"-r[0-9]+$", "", entry.label)
    groups[cell] = (groups[cell] ?? []) + [entry]
  }
  let lines = [
    "# Step-Judge Experiment Report",
    "",
    "Source: `${directory}`",
    "",
    "## Cells",
    "",
    "| Cell | Runs | Pass | Skipped | Pass% | Cost USD | Input tokens | Output tokens |",
    "|---|---:|---:|---:|---:|---:|---:|---:|",
  ]
  const order = ["baseline-cheap", "symmetric-cheap", "asymmetric", "symmetric-strong"]
  for cell in order {
    const entries = groups[cell]
    if entries != nil {
      const measured = stats(entries)
      lines.push(
        "| ${cell} | ${measured.runs} | ${measured.passed} | ${measured.skipped} | ${measured.pass_rate_pct}% | ${cost_label(measured.cost_usd)} | ${measured.input_tokens} | ${measured.output_tokens} |",
      )
    }
  }
  const baseline = groups["baseline-cheap"]
  if baseline != nil {
    const baseline_rate = stats(baseline).pass_rate_pct
    lines = lines
      + ["", "## Lift vs baseline-cheap", "", "| Cell | Lift (percentage points) |", "|---|---:|"]
    for cell in order.filter({ cell: string -> cell != "baseline-cheap" }) {
      const entries = groups[cell]
      if entries != nil {
        lines.push("| ${cell} | ${stats(entries).pass_rate_pct - baseline_rate} |")
      }
    }
  }
  const probes = groups.keys().filter({ cell: string -> !order.contains(cell) }).to_list().sorted()
  if probes.count > 0 {
    lines = lines
      + [
        "",
        "## Probes",
        "",
        "| Probe | Runs | Pass | Skipped | Pass% | Cost USD |",
        "|---|---:|---:|---:|---:|---:|",
      ]
    for cell in probes {
      const measured = stats(groups[cell]!)
      lines.push(
        "| ${cell} | ${measured.runs} | ${measured.passed} | ${measured.skipped} | ${measured.pass_rate_pct}% | ${cost_label(measured.cost_usd)} |",
      )
    }
  }
  lines = lines
    + [
      "",
      "## Go / no-go",
      "",
      "Compare lift to the criteria in `experiments/step-judge/README.md`:",
      "",
      "- asymmetric lift ≥ 15 percentage points at ≤3× baseline cost → GO (recommended opt-in)",
      "- symmetric-cheap lift ≥ 10 percentage points at ≤2× baseline cost → GO (both presets)",
      "- 5 percentage points ≤ lift < threshold → SHIP AS OPT-IN with mixed-evidence note",
      "- lift < 5 percentage points or degraded → NO-GO; ship primitive @experimental, file follow-up",
      "",
      "Unknown cost cannot establish a cost threshold.",
    ]
  return "${lines.join("\n")}\n"
}

fn main(harness: Harness) -> nil {
  const options = unwrap(
    parse(
      parser(
        {
          name: "step-judge-aggregate",
          args: [
            {kind: "flag", name: "results_dir", long: "--results-dir", required: true},
            {kind: "flag", name: "output", long: "--output", required: true},
          ],
        },
      ),
      argv,
    ),
  ).options
  const summaries = load_cells(harness.fs, options.results_dir)
  harness.fs.write_text(options.output, render(summaries, options.results_dir))
  harness.stdio.println("Wrote ${options.output}")
}
