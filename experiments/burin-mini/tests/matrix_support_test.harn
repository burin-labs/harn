import { together_model_ids } from "../matrix_support.harn"

@test
pipeline test_together_models_filter_price_and_order(harness: Harness, task: unknown) {
  const payload = {
    data: [
      {uuid: "endpoint-gemma", id: "gemma-model", pricing: {input: "1.0", output: "1.5"}},
      {
        uuid: "endpoint-qwen",
        id: "qwen3-coder-next",
        pricing: {input_per_mtok: 2, output_per_mtok: 2},
      },
      {uuid: "endpoint-z", id: "z-qwen3-coder", pricing: {input: 1, output: 1}},
      {uuid: "endpoint-a", id: "a-qwen3-coder", pricing: {input: 1, output: 1}},
      {uuid: "endpoint-expensive", id: "deepseek-expensive", pricing: {input: 3, output: 1}},
      {uuid: "not-endpoint", id: "qwen-ignored", pricing: {input: 0, output: 0}},
    ],
  }
  assert_eq(
    together_model_ids(payload, 4),
    ["qwen3-coder-next", "a-qwen3-coder", "z-qwen3-coder", "gemma-model"],
  )
  assert_eq(together_model_ids({data: "bad"}, 2), [])
}
