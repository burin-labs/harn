pub fn split_matrix_words(text: string) -> list<string> {
  return regex_split(text.trim(), r"[\s,]+").filter({ value -> value != "" }).to_list()
}

fn numeric(value: string | int | float | nil) -> float? {
  if type_of(value) == "int" || type_of(value) == "float" {
    return to_float(value)
  }
  if type_of(value) != "string" {
    return nil
  }
  const matched = regex_match(r"\d+(?:\.\d+)?", value)
  return matched == nil || matched.count == 0 ? nil : to_float(matched[0])
}

fn price_mtok(model: dict, keys: list<string>) -> float? {
  const pricing = model?.pricing
  if type_of(pricing) != "dict" {
    return nil
  }
  for key in keys {
    const parsed = numeric(pricing.get(key))
    if parsed != nil {
      return parsed
    }
  }
  return nil
}

fn model_priority(model_id: string) -> int {
  const lowered = model_id.lower()
  if lowered.contains("qwen3-coder-next") {
    return 0
  }
  if lowered.contains("qwen3-coder") {
    return 1
  }
  if lowered.contains("qwen") && lowered.contains("coder") {
    return 2
  }
  if lowered.contains("qwen") {
    return 3
  }
  if lowered.contains("deepseek") || lowered.contains("glm") || lowered.contains("kimi") {
    return 4
  }
  if lowered.contains("gemma") {
    return 5
  }
  if lowered.contains("gpt-oss") {
    return 6
  }
  return 50
}

pub fn together_model_ids(payload: dict | list, limit: int) -> list<string> {
  const models = if type_of(payload) == "dict" {
    payload?.data ?? payload
  } else {
    payload
  }
  if type_of(models) != "list" || limit <= 0 {
    return []
  }
  let selected = []
  for model in models {
    if type_of(model) != "dict" || !to_string(model?.uuid ?? "").starts_with("endpoint-") {
      continue
    }
    const model_id = to_string(model?.id ?? model?.name ?? model?.model ?? "")
    if model_id == ""
      || regex_captures(r"(?i)(qwen|deepseek|kimi|moonshot|glm|zai|gemma|gpt-oss|coder)", model_id)
        .count
        == 0 {
      continue
    }
    const input_price = price_mtok(model, ["input", "input_per_mtok", "prompt"])
    const output_price = price_mtok(model, ["output", "output_per_mtok", "completion"])
    if input_price == nil || output_price == nil || input_price > 2.0 || output_price > 2.0 {
      continue
    }
    selected = selected
      + [
        {
          id: model_id,
          priority: model_priority(model_id),
          input_price: input_price,
          output_price: output_price,
        },
      ]
  }
  return selected.sorted_by({ row -> [row.priority, row.output_price, row.input_price, row.id] })
    .take(limit)
    .map({ row -> row.id })
    .to_list()
}
