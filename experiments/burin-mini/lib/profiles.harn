/** Task profile for the read-only repo explanation case. */
pub fn explain_profile() {
  return {
    id: "explain_repo",
    mode: "read_only",
    max_rounds: 2,
    max_research_questions_per_round: 3,
    target_paths: [
      "README.md",
      "packages/server/src/routes/api.ts",
      "packages/server/src/middleware/auth-guard.ts",
    ],
    success_criteria: ["Explain the repo in simple terms.", "Name the key auth and API files."],
    write_paths: [],
    verify_command: "",
    verification_contract: {},
    research_focus:
      "Explain the repository in simple terms. Identify the API route layer, the middleware layer, and the auth path.",
    completion_bar:
      "Ready only when you can explain what the repo does, how requests reach the API, and where auth happens.",
  }
}

/** Task profile for the single-file comment case. */
pub fn comment_profile() {
  return {
    id: "comment_file",
    mode: "scoped_write",
    max_rounds: 2,
    max_research_questions_per_round: 1,
    target_paths: ["packages/server/src/middleware/auth-guard.ts"],
    success_criteria: ["Add a short, accurate module comment.", "Do not change runtime behavior."],
    write_paths: ["packages/server/src/middleware/auth-guard.ts"],
    // Node, not a shell `grep`. The command runs under whatever shell the host
    // picked, which on Windows is cmd.exe, and cmd neither ships grep nor
    // strips single quotes -- so the old pattern arrived as three arguments and
    // the only verification this task had never ran (harn#7968). A `node`
    // invocation with no quoting in it is unaffected by either cause.
    //
    // Portability here is necessary and was not sufficient: the same run also
    // reached the child with a working directory cmd.exe refuses and with no
    // search path at all. Both were harness defects and are fixed at their own
    // seams; see `child_process_cwd` and the Windows environment allowlist.
    verify_command: "node scripts/verify-comment.js",
    verification_contract: {
      required_paths: ["packages/server/src/middleware/auth-guard.ts"],
      required_text: ["Auth guard middleware"],
      notes: ["Preserve runtime behavior. Only add the module comment."],
    },
    research_focus:
      "Understand what auth-guard.ts does, what request data it reads, and where the user context gets attached.",
    completion_bar:
      "Ready only when you know the file's responsibility and can add one short module comment without changing behavior.",
  }
}

/** Task profile for the multi-file rate-limit implementation case. */
pub fn rate_limit_profile() {
  return {
    id: "rate_limit_auth",
    mode: "multi_write",
    max_rounds: 2,
    max_research_questions_per_round: 2,
    success_criteria: [
      "Add a simple in-memory per-IP rate limiter.",
      "Export it from the middleware index.",
      "Wire it into the API route stack.",
      "Pass the verify script.",
    ],
    target_paths: ["packages/server/src/middleware/index.ts", "packages/server/src/routes/api.ts"],
    write_paths: [
      "packages/server/src/middleware/rate-limit.ts",
      "packages/server/src/middleware/index.ts",
      "packages/server/src/routes/api.ts",
    ],
    verify_command: "node scripts/verify-rate-limit.js",
    verification_contract: {
      required_identifiers: ["rateLimit"],
      required_paths: [
        "packages/server/src/middleware/rate-limit.ts",
        "packages/server/src/middleware/index.ts",
        "packages/server/src/routes/api.ts",
      ],
      required_text: ["export { rateLimit }", "rateLimit"],
      notes: [
        "Use the verifier-exact export name `rateLimit`.",
        "Preserve the existing withMiddleware route architecture instead of replacing files with framework boilerplate.",
      ],
    },
    research_focus:
      "Find the current middleware export surface, the existing route-wiring pattern, and the exact identifier and file-path constraints implied by the verifier contract.",
    completion_bar:
      "Ready once you can create rateLimit, export it from the middleware index, wire it before authGuard in the existing withMiddleware route stack, and run the verify script.",
  }
}

/**
 * Task profile for the slow-verifier case.
 *
 * Same deliverable as `rate_limit_profile`, but its verifier does not answer
 * inline: `background_after_ms` gives the command a foreground budget it is
 * built to outlive, so the run converts to a handle and the exit status arrives
 * only on the wait that resolves it. That is the lifecycle a real test suite
 * has, and the one a loop can spin on forever if it re-runs the verifier
 * instead of awaiting the run already in flight.
 */
pub fn slow_verify_profile() {
  return rate_limit_profile()
    + {
      id: "slow_verify_auth",
      verify_command: "node scripts/verify-slow.js",
      background_after_ms: 250,
      success_criteria: [
        "Add a simple in-memory per-IP rate limiter.",
        "Export it from the middleware index.",
        "Wire it into the API route stack.",
        "Await the slow verifier's result instead of restarting it.",
      ],
      completion_bar:
        "Ready once the verifier has been run AND its terminal result collected. A handle is not a result: if the run reports it is still running, wait on that handle rather than starting another verifier.",
    }
}

/** Map a task prompt onto one of the canonical experiment profiles. */
pub fn profile_for_task(task: string?) {
  const lower = lowercase(task)
  if contains(lower, "comment what this file does") {
    return comment_profile()
  }
  if contains(lower, "slow verifier") {
    return slow_verify_profile()
  }
  if contains(lower, "rate limiting middleware") {
    return rate_limit_profile()
  }
  return explain_profile()
}
