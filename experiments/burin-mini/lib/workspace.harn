import { command_run, command_wait } from "std/command"
import "std/path"

/** Return the sample workspace root for the experiment. */
pub fn workspace_root(fs: HarnessFs) {
  return path_join(fs.source_dir(), "..", "workspace")
}

fn workspace_alias_path(path: string?) {
  const raw = (path ?? "").trim()
  if starts_with(raw, "/workspace/") {
    return raw.replace("/workspace/", "")
  }
  return raw
}

/** Normalize a model-provided path into a workspace-relative path. */
pub fn workspace_path(fs: HarnessFs, path: string?) {
  const normalized = workspace_normalize(workspace_alias_path(path), workspace_root(fs))
  guard normalized else {
    throw "Path is outside the experiment workspace: ${path ?? ""}"
  }
  return normalized
}

/** Resolve a workspace-relative path to an on-disk host path. */
pub fn resolve_workspace_path(fs: HarnessFs, path: string?) {
  return path_join(workspace_root(fs), workspace_path(fs, path))
}

/** Read one file from the sample workspace. */
pub fn read_workspace(fs: HarnessFs, path: string?) {
  return fs.read_text(resolve_workspace_path(fs, path))
}

/** Write one file inside the sample workspace. */
pub fn write_workspace(fs: HarnessFs, path: string?, content: any) {
  const resolved = resolve_workspace_path(fs, path)
  fs.write_text(resolved, content)
  return resolved
}

/** Search the sample workspace with ripgrep. */
pub fn search_workspace(fs: HarnessFs, process: HarnessProcess, query: any) {
  const result = process.exec_at(
    workspace_root(fs),
    "rg",
    "-n",
    "--hidden",
    "--glob",
    "!node_modules",
    "--glob",
    "!coverage",
    "--glob",
    "!dist",
    query,
    ".",
  )
  return result?.stdout ?? result?.stderr ?? ""
}

/** List every workspace file in deterministic (path-sorted) order. */
pub fn list_workspace_files(fs: HarnessFs, process: HarnessProcess) {
  const result = process.exec_at(
    workspace_root(fs),
    "rg",
    "--files",
    "--hidden",
    "--sort",
    "path",
    "--glob",
    "!node_modules",
    "--glob",
    "!.git",
    "--glob",
    "!dist",
    "--glob",
    "!coverage",
  )
  const out = (result?.stdout ?? "").trim()
  if out == "" {
    return []
  }
  return split(out, "\n")
}

/**
 * Unified discovery: filename matches AND content matches in one call.
 *
 * Returns a string with two sections (omitted when empty), or an explicit
 * "(no matches for 'query')" line if both sections are empty. The caller
 * should pass a token or symbol — natural-language phrases like
 * "auth middleware" rarely match content literally; the filename pass
 * is what saves them.
 */
pub fn find_workspace(fs: HarnessFs, process: HarnessProcess, query: string?) {
  const q = (query ?? "").trim()
  if q == "" {
    return "(empty query)"
  }
  // Filename pass: path-sorted file list, filter by case-insensitive substring.
  let name_hits = []
  for path in list_workspace_files(fs, process) {
    if contains(lowercase(path), lowercase(q)) {
      name_hits = name_hits + [path]
    }
  }
  // Content pass: ripgrep -n -i, capped at 80 lines.
  const rg = process.exec_at(
    workspace_root(fs),
    "rg",
    "-n",
    "-i",
    "--hidden",
    "--sort",
    "path",
    "--max-count",
    "20",
    "--glob",
    "!node_modules",
    "--glob",
    "!.git",
    "--glob",
    "!dist",
    "--glob",
    "!coverage",
    q,
    ".",
  )
  const content_lines = split((rg?.stdout ?? "").trim(), "\n")
  const trimmed_content = if len(content_lines) > 80 {
    content_lines[0:80]
  } else {
    content_lines
  }
  const truncated = len(content_lines) > 80
  let sections = []
  if len(name_hits) > 0 {
    const hdr = "## Filename matches (${len(name_hits)})"
    sections = sections + [hdr + "\n" + join(name_hits, "\n")]
  }
  if (rg?.stdout ?? "").trim() != "" {
    let body = join(trimmed_content, "\n")
    if truncated {
      body = body + "\n... (truncated; refine query or use read on a specific file)"
    }
    sections = sections + ["## Content matches\n" + body]
  }
  if len(sections) == 0 {
    return "(no matches for '${q}')"
  }
  return join(sections, "\n\n")
}

/** Run one shell command from the sample workspace root. */
pub fn run_workspace(fs: HarnessFs, process: HarnessProcess, command: any) {
  return process.shell_at(workspace_root(fs), command)
}

/** How much output a command may return inline before it is truncated. */
const COMMAND_INLINE_BYTES = 20000

/**
 * Run one workspace command through the command runner, with an optional
 * foreground budget.
 *
 * `run_workspace` above blocks until the command finishes, which means a task
 * can never observe the lifecycle a slow verifier actually has. With a positive
 * `background_after_ms`, a command that outlives the budget converts to a handle
 * and returns `status: "running"` instead of an exit status -- the real outcome
 * then arrives on `wait_workspace_command`. A budget of 0 keeps the whole call
 * in the foreground, so callers that never opt in see no change.
 */
pub fn run_workspace_command(
  tools: HarnessTools,
  fs: HarnessFs,
  command: any,
  background_after_ms: int = 0,
) {
  const capture = {capture: {max_inline_bytes: COMMAND_INLINE_BYTES}}
  const options = if background_after_ms > 0 {
    capture + {background_after_ms: background_after_ms}
  } else {
    capture
  }
  return command_run(tools, {mode: "shell", command: command, cwd: workspace_root(fs)}, options)
}

/**
 * Resolve a background command handle to its terminal result.
 *
 * This is the only place a backgrounded command's exit status and output can
 * come from; the handle banner carries neither.
 */
pub fn wait_workspace_command(tools: HarnessTools, handle_id: string, timeout_ms: int = 600000) {
  return command_wait(tools, {handle_id: handle_id}, {timeout_ms: timeout_ms})
}

/**
 * Add the background command lifecycle to a tool registry.
 *
 * Only reached when a profile declares `background_after_ms`. The `run` tool
 * then hands back a handle for any command that outlives the budget, and
 * `wait_command` is the only way to turn that handle into an exit status --
 * so a task cannot pretend a started verifier is a finished one.
 */
pub fn background_command_tools(
  caps: {fs: HarnessFs, tools: HarnessTools},
  registry: {_type: "tool_registry", tools: list},
  background_after_ms: int,
) {
  let out = tool_define(
    registry,
    "run",
    "Run one shell command inside the workspace. A command that runs longer than the foreground budget returns a handle with status \"running\"; collect its result with wait_command.",
    {
      policy: {kind: "execute"},
      parameters: {command: {type: "string"}},
      returns: {type: "object"},
      handler: { args ->
        run_workspace_command(caps.tools, caps.fs, args.command, background_after_ms)
      },
    },
  )
  out = tool_define(
    out,
    "wait_command",
    "Wait for a backgrounded command to finish and return its exit status and output.",
    {
      policy: {kind: "execute"},
      parameters: {handle_id: {type: "string"}},
      returns: {type: "object"},
      handler: { args -> wait_workspace_command(caps.tools, args.handle_id) },
    },
  )
  return out
}
