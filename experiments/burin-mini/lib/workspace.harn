import "std/path"

/** Return the sample workspace root for the experiment. */
pub fn workspace_root(fs: HarnessFs) {
  return path_join(fs.source_dir(), "..", "workspace")
}

fn workspace_alias_path(path: string?) {
  const raw = (path ?? "").trim()
  if starts_with(raw, "/workspace/") {
    return raw.replace("/workspace/", "")
  }
  return raw
}

/** Normalize a model-provided path into a workspace-relative path. */
pub fn workspace_path(fs: HarnessFs, path: string?) {
  const normalized = workspace_normalize(workspace_alias_path(path), workspace_root(fs))
  guard normalized else {
    throw "Path is outside the experiment workspace: ${path ?? ""}"
  }
  return normalized
}

/** Resolve a workspace-relative path to an on-disk host path. */
pub fn resolve_workspace_path(fs: HarnessFs, path: string?) {
  return path_join(workspace_root(fs), workspace_path(fs, path))
}

/** Read one file from the sample workspace. */
pub fn read_workspace(fs: HarnessFs, path: string?) {
  return fs.read_text(resolve_workspace_path(fs, path))
}

/** Write one file inside the sample workspace. */
pub fn write_workspace(fs: HarnessFs, path: string?, content: any) {
  const resolved = resolve_workspace_path(fs, path)
  fs.write_text(resolved, content)
  return resolved
}

/** Search the sample workspace with ripgrep. */
pub fn search_workspace(fs: HarnessFs, process: HarnessProcess, query: any) {
  const result = process.exec_at(
    workspace_root(fs),
    "rg",
    "-n",
    "--hidden",
    "--glob",
    "!node_modules",
    "--glob",
    "!coverage",
    "--glob",
    "!dist",
    query,
    ".",
  )
  return result?.stdout ?? result?.stderr ?? ""
}

/** List every workspace file in deterministic (path-sorted) order. */
pub fn list_workspace_files(fs: HarnessFs, process: HarnessProcess) {
  const result = process.exec_at(
    workspace_root(fs),
    "rg",
    "--files",
    "--hidden",
    "--sort",
    "path",
    "--glob",
    "!node_modules",
    "--glob",
    "!.git",
    "--glob",
    "!dist",
    "--glob",
    "!coverage",
  )
  const out = (result?.stdout ?? "").trim()
  if out == "" {
    return []
  }
  return split(out, "\n")
}

/**
 * Unified discovery: filename matches AND content matches in one call.
 *
 * Returns a string with two sections (omitted when empty), or an explicit
 * "(no matches for 'query')" line if both sections are empty. The caller
 * should pass a token or symbol — natural-language phrases like
 * "auth middleware" rarely match content literally; the filename pass
 * is what saves them.
 */
pub fn find_workspace(fs: HarnessFs, process: HarnessProcess, query: string?) {
  const q = (query ?? "").trim()
  if q == "" {
    return "(empty query)"
  }
  // Filename pass: path-sorted file list, filter by case-insensitive substring.
  let name_hits = []
  for path in list_workspace_files(fs, process) {
    if contains(lowercase(path), lowercase(q)) {
      name_hits = name_hits + [path]
    }
  }
  // Content pass: ripgrep -n -i, capped at 80 lines.
  const rg = process.exec_at(
    workspace_root(fs),
    "rg",
    "-n",
    "-i",
    "--hidden",
    "--sort",
    "path",
    "--max-count",
    "20",
    "--glob",
    "!node_modules",
    "--glob",
    "!.git",
    "--glob",
    "!dist",
    "--glob",
    "!coverage",
    q,
    ".",
  )
  const content_lines = split((rg?.stdout ?? "").trim(), "\n")
  const trimmed_content = if len(content_lines) > 80 {
    content_lines[0:80]
  } else {
    content_lines
  }
  const truncated = len(content_lines) > 80
  let sections = []
  if len(name_hits) > 0 {
    const hdr = "## Filename matches (${len(name_hits)})"
    sections = sections + [hdr + "\n" + join(name_hits, "\n")]
  }
  if (rg?.stdout ?? "").trim() != "" {
    let body = join(trimmed_content, "\n")
    if truncated {
      body = body + "\n... (truncated; refine query or use read on a specific file)"
    }
    sections = sections + ["## Content matches\n" + body]
  }
  if len(sections) == 0 {
    return "(no matches for '${q}')"
  }
  return join(sections, "\n\n")
}

/** Run one shell command from the sample workspace root. */
pub fn run_workspace(fs: HarnessFs, process: HarnessProcess, command: any) {
  return process.shell_at(workspace_root(fs), command)
}
