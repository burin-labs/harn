; Finite mathematical abstraction, NOT Rust MIR verification.
; Four named scope bits, origin s0 plus zero to three delegated actors.
; Trusted refinement: normalized BTreeSet membership corresponds to these bits;
; is_subset and len implement membership inclusion and cardinality.
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-const s0 (_ BitVec 4))
(declare-const s1 (_ BitVec 4))
(declare-const s2 (_ BitVec 4))
(declare-const s3 (_ BitVec 4))
(declare-const depth (_ BitVec 2))
(define-fun subset ((p (_ BitVec 4)) (c (_ BitVec 4))) Bool
  (= (bvand c p) c))
(define-fun count ((s (_ BitVec 4))) (_ BitVec 4)
  (bvadd ((_ zero_extend 3) ((_ extract 0 0) s))
         ((_ zero_extend 3) ((_ extract 1 1) s))
         ((_ zero_extend 3) ((_ extract 2 2) s))
         ((_ zero_extend 3) ((_ extract 3 3) s))))
(define-fun strict ((p (_ BitVec 4)) (c (_ BitVec 4))) Bool
  (and (subset p c) (bvult (count c) (count p))))
; Independent extensional specification: each child membership implies parent
; membership. Proper subset also has at least one parent-only member.
(define-fun membership ((p (_ BitVec 4)) (c (_ BitVec 4))) Bool
  (and (=> (= ((_ extract 0 0) c) #b1) (= ((_ extract 0 0) p) #b1))
       (=> (= ((_ extract 1 1) c) #b1) (= ((_ extract 1 1) p) #b1))
       (=> (= ((_ extract 2 2) c) #b1) (= ((_ extract 2 2) p) #b1))
       (=> (= ((_ extract 3 3) c) #b1) (= ((_ extract 3 3) p) #b1))))
(define-fun proper ((p (_ BitVec 4)) (c (_ BitVec 4))) Bool
  (and (membership p c) (not (= (bvand p (bvnot c)) #x0))))
(define-fun non-chain () Bool
  (and (=> (bvuge depth #b01) (subset s0 s1))
       (=> (bvuge depth #b10) (subset s1 s2))
       (=> (bvuge depth #b11) (subset s2 s3))))
(define-fun strict-chain () Bool
  (and (=> (bvuge depth #b01) (strict s0 s1))
       (=> (bvuge depth #b10) (strict s1 s2))
       (=> (bvuge depth #b11) (strict s2 s3))))
(define-fun current () (_ BitVec 4)
  (ite (= depth #b00) s0 (ite (= depth #b01) s1 (ite (= depth #b10) s2 s3))))

(echo "non_increasing_iff_membership")
(push)
(assert (xor (subset s0 s1) (membership s0 s1)))
(check-sat)
(pop)
(echo "strict_iff_proper_subset")
(push)
(assert (xor (strict s0 s1) (proper s0 s1)))
(check-sat)
(pop)
(echo "non_increasing_chain_never_widens_origin")
(push)
(assert (and non-chain (not (membership s0 current))))
(check-sat)
(pop)
(echo "strict_chain_never_widens_origin")
(push)
(assert (and strict-chain (not (membership s0 current))))
(check-sat)
(pop)
(echo "strict_chain_consumes_at_least_one_scope_per_hop")
(push)
(assert (and strict-chain
  (bvult (count s0) (bvadd (count current) ((_ zero_extend 2) depth)))))
(check-sat)
(pop)
(echo "strict_rejects_equal_including_empty")
(push)
(assert (and (= s0 s1) (strict s0 s1)))
(check-sat)
(pop)
(echo "empty_parent_cannot_delegate_nonempty_child")
(push)
(assert (and (= s0 #x0) (not (= s1 #x0)) (subset s0 s1)))
(check-sat)
(pop)
(echo "empty_child_is_non_increasing")
(push)
(assert (not (subset s0 #x0)))
(check-sat)
(pop)
(echo "widening_is_reachable_for_off_mode")
(push)
(assert (and (= s0 #x0) (= s1 #x1)))
(check-sat)
(get-value (s0 s1))
(pop)
(echo "negative_control_drop_subset_guard")
(push)
(assert (and (bvult (count s1) (count s0)) (not (membership s0 s1))))
(check-sat)
(get-value (s0 s1))
(pop)
(echo "negative_control_drop_strictness")
(push)
(assert (and (subset s0 s1) (not (proper s0 s1))))
(check-sat)
(get-value (s0 s1))
(pop)
(echo "negative_control_skip_origin_edge")
(push)
(assert (and (= depth #b11) (subset s1 s2) (subset s2 s3)
  (not (membership s0 current))))
(check-sat)
(get-value (s0 s1 s2 s3))
(pop)
