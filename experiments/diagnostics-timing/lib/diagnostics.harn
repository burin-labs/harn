// Tiered diagnostic producer for the timing experiment.
//
// Three tiers, per the precision shape under test:
//   1. syntax     -- the parser is authoritative; always surfaced as an error.
//   2. semantic   -- surfaced as a confident error ONLY where the resolver can
//                    see the whole symbol space for that language AND the file
//                    itself carries no construct that defeats resolution.
//   3. unresolved -- structurally incomplete resolution; demoted to one labeled
//                    low-confidence line, or suppressed entirely.
//
// Signatures are location-stripped on purpose. A diagnostic that shifts line
// number as the file grows is the SAME diagnostic; keying on `line` would defeat
// both the novelty filter and the do-not-re-inject rule.
// Per-language declaration of how far the semantic resolver can be trusted.
// Data, never an if-language-name branch at a call site.
//
//   complete     the resolver sees the whole symbol space unconditionally.
//   static_only  the resolver sees it only when the file itself resolves
//                statically: every name is a builtin, a local definition, or an
//                explicit import. A construct from RESOLUTION_DEFEATERS voids it.
//   never        the language resolves names at runtime as a matter of course,
//                so an unresolved name is never evidence of a defect.
//
// Nothing is `complete` today because the only semantic producer is a
// tree-sitter heuristic. The value moves to `complete` for a language when a
// real resolver (a language server) backs it — a data edit, not a code edit.
const RESOLVER_COMPLETENESS = {
  python: "static_only",
  javascript: "static_only",
  typescript: "static_only",
  go: "static_only",
  ruby: "never",
}

// Constructs that defeat symbol resolution within a single file, per language.
// Presence of any of these makes the file's semantic tier structurally
// incomplete no matter how good the language's resolver is.
const RESOLUTION_DEFEATERS = {
  python: ["import *", "globals()", "locals()", "setattr(", "__getattr__"],
  ruby: ["method_missing", "define_method", "const_missing"],
  javascript: ["eval(", "with ("],
  typescript: ["eval(", "declare global"],
  go: [],
}

pub fn language_resolver_completeness(language: string) -> string {
  return to_string(RESOLVER_COMPLETENESS.get(language, "unknown"))
}

/** True when the source carries a construct that defeats resolution. */
pub fn source_defeats_resolution(source: string, language: string) -> bool {
  const defeaters = RESOLUTION_DEFEATERS.get(language, [])
  for marker in defeaters {
    if source.contains(to_string(marker)) {
      return true
    }
  }
  return false
}

/**
 * The tier a semantic finding earns in this file.
 *
 * Confidence needs BOTH halves: a resolver that can see the symbol space, and a
 * file that does not defeat it. Either half missing demotes the finding, because
 * an unresolved name then means "the checker could not see it" and not "the code
 * is wrong".
 */
fn semantic_tier(source: string, language: string) -> string {
  const ceiling = language_resolver_completeness(language)
  if ceiling == "complete" {
    return "semantic"
  }
  if ceiling == "static_only" && !source_defeats_resolution(source, language) {
    return "semantic"
  }
  return "unresolved"
}

/**
 * Collect every diagnostic for one source, already tiered and signed.
 *
 * Signatures are qualified by `path` so the same unresolved name in two files
 * stays two diagnostics, and are stripped of line/column so a finding that
 * shifts as the file grows keeps one identity.
 */
pub fn collect(ast: HarnessAst, source: string, language: string, path: string) -> list {
  let out: list = []
  const parse = ast.parse_errors({content: source, language: language})
  if (parse?.supported ?? false) && (parse?.had_errors ?? false) {
    for err in parse?.errors ?? [] {
      const message = to_string(err?.message ?? "parse error")
      out = out
        + [
        {
          tier: "syntax",
          severity: "ERROR",
          line: to_int(err?.start_row ?? 0) + 1,
          message: message,
          signature: "${path}|syntax:${message}",
        },
      ]
    }
    // A file that does not parse makes every semantic reading noise, so stop.
    return out
  }
  const undef = ast.undefined_names({content: source, language: language})
  if !(undef?.supported ?? false) {
    return out
  }
  const tier = semantic_tier(source, language)
  for diag in undef?.diagnostics ?? [] {
    const name = to_string(diag?.name ?? "")
    out = out
      + [
      {
        tier: tier,
        severity: if tier == "semantic" {
          "ERROR"
        } else {
          "LOW-CONFIDENCE"
        },
        line: to_int(diag?.row ?? 0) + 1,
        message: "undefined name '${name}'",
        signature: "${path}|${tier}:undefined name '${name}'",
      },
    ]
  }
  return out
}

/**
 * Keep only diagnostics whose signature is absent from `baseline` (the pre-edit
 * reading) and from `suppressed` (everything already shown to the model once).
 */
pub fn novel(current: list, baseline, suppressed) -> list {
  let out: list = []
  for diag in current {
    const signature = to_string(diag.signature)
    if baseline.contains(signature) {
      continue
    }
    if suppressed.contains(signature) {
      continue
    }
    out = out.appending(diag)
  }
  return out
}

pub fn signatures_of(diags: list) {
  let out = set()
  for diag in diags {
    out = out.adding(to_string(diag.signature))
  }
  return out
}

/**
 * Render the model-facing block. Confident errors get fix-first framing; the
 * demoted tier collapses to ONE labeled line no matter how many findings it
 * carried, so an unresolvable framework namespace cannot flood the turn.
 */
pub fn render(diags: list, path: string) -> string {
  if len(diags) == 0 {
    return ""
  }
  let error_lines: list = []
  let low_names: list = []
  for diag in diags {
    if to_string(diag.severity) == "ERROR" {
      if len(error_lines) < 8 {
        error_lines = error_lines.appending("  L${diag.line} ERROR: ${diag.message}")
      }
    } else {
      low_names = low_names.appending(to_string(diag.message))
    }
  }
  let lines: list = []
  if len(error_lines) > 0 {
    lines = lines + ["\n## Diagnostics for ${path} (${len(error_lines)} error(s))"]
    lines = lines + error_lines
    lines = lines + ["-> Fix these before verifying."]
  }
  if len(low_names) > 0 {
    lines = lines
      + [
      "\n## Note for ${path} (low confidence, not verified): ${len(low_names)} name(s) could not be resolved statically, e.g. ${low_names.first()}. This checker does not resolve imports, so framework and dynamically-provided names appear here. Do not act on this unless verification agrees.",
    ]
  }
  return join(lines, "\n")
}
