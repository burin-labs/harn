import { boolean } from "std/predicate"
import { llm_text, with_llm_script } from "std/testing"

pipeline test(harness: Harness) {
  // The first call has no prior usage to adapt its projection. Its schema alone
  // fits this cap in structured v3; schema plus v4 question instructions do not.
  for case in [
    {length: 1000, kind: "unavailable", calls: 0},
    {length: 0, kind: "answered", calls: 1},
  ] {
    with_llm_script(
      harness.llm,
      [
        llm_text(
          json_stringify({answers: {safe: {verdict: true, confidence: 1.0, evidence: "fixture"}}}),
        ),
      ],
      { ->
        const result = harness.llm.evaluate_request(
          "instruction-budget.v1",
          {text: "short"},
          {safe: boolean("Is this safe? " + "rubric ".repeat(case.length))},
          {
            backend: "structured_llm",
            provider: "openai",
            model: "gpt-5.4-nano",
            effort: "none",
            temperature: 0.0,
            threshold: 0.0,
            evaluation_cost_limit: 0.003,
          },
        )
        assert_eq(result.kind, case.kind)
        assert_eq(len(harness.llm.mock_calls()), case.calls)
      },
    )
  }
  harness.stdio.log("question instructions participate in pre-dispatch admission")
}
