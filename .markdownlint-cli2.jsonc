{
  "config": {
    // Allow longer lines — 80 is too strict for docs with tables and URLs
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    // Allow bare URLs (common in docs)
    "MD034": false,
    // Allow duplicate headings in siblings (needed for CHANGELOG.md)
    "MD024": { "siblings_only": true },
    // Tables: don't enforce padding style
    "MD060": false
  },
  "ignores": [
    "node_modules",
    "**/node_modules",
    "target",
    ".target-inspect",
    // Stray out-of-tree Cargo target dirs (gitignored as `.target-*/`, plus a
    // bare `.target`). Their vendored crate READMEs are build output, not docs.
    ".target/**",
    ".target-*/**",
    "docs/dist",
    ".worktrees",
    ".burin",
    ".claude",
    ".harn-runs",
    "meta_scratch",
    "docs/src/SUMMARY.md",
    "conformance/tests/**/.harn/**/*.md",
    // Generated drift report fixture for the provider catalog refresh
    // workflow. Adapter run rows can exceed 120 cols when a URL and a
    // skip reason both fit on one line; keep the report rendering
    // straight-line readable rather than wrapping.
    "scripts/provider_catalog_fixtures/expected_drift_report.md",
    // qmode experiment writes synthetic profile bullets here during eval runs;
    // these are not docs and shouldn't be linted as such.
    "experiments/**/.harn/**/*.md",
    "experiments/**/USER_PROFILE.md",
    // GitHub PR/issue templates are forms, not prose docs — they lead with
    // an HTML comment and h2 sections, which trips MD041 (first-line-h1).
    ".github/pull_request_template.md",
    ".github/ISSUE_TEMPLATE/**/*.md"
  ]
}
