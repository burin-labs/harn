{
  "name": "harn-lang",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "burin-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/burin-labs/harn"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b1413",
    "theme": "dark"
  },
  "keywords": [
    "harn",
    "agents",
    "pipeline",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "onLanguage:harn",
    "onLanguage:harn-prompt",
    "onDebug",
    "onTaskType:harn"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "harn",
        "aliases": [
          "Harn",
          "harn"
        ],
        "extensions": [
          ".harn"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "harn-prompt",
        "aliases": [
          "Harn Prompt",
          "harn-prompt"
        ],
        "extensions": [
          ".harn.prompt",
          ".prompt"
        ],
        "configuration": "./language-configuration-prompt.json"
      }
    ],
    "grammars": [
      {
        "language": "harn",
        "scopeName": "source.harn",
        "path": "./syntaxes/harn.tmLanguage.json"
      },
      {
        "language": "harn-prompt",
        "scopeName": "text.harn.prompt",
        "path": "./syntaxes/harn-prompt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "harn",
        "path": "./snippets/harn.json"
      }
    ],
    "commands": [
      {
        "command": "harn.runPipeline",
        "title": "%harn.runPipeline%"
      },
      {
        "command": "harn.formatFile",
        "title": "%harn.formatFile%"
      },
      {
        "command": "harn.applyAllAutofixes",
        "title": "%harn.applyAllAutofixes%"
      }
    ],
    "configurationDefaults": {
      "[harn]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.harn": "always"
        }
      }
    },
    "debuggers": [
      {
        "type": "harn",
        "label": "Harn",
        "languages": [
          "harn"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debug.program%",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "%debug.cwd%",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "harn",
            "request": "launch",
            "name": "%debug.name%",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Harn",
      "properties": {
        "harn.path": {
          "type": "string",
          "default": "harn",
          "description": "%harn.path%"
        },
        "harn.lspPath": {
          "type": "string",
          "default": "harn-lsp",
          "description": "%harn.lspPath%"
        },
        "harn.dapPath": {
          "type": "string",
          "default": "harn-dap",
          "description": "%harn.dapPath%"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "harn",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "check",
              "fmt",
              "lint",
              "test"
            ],
            "description": "%task.command%"
          },
          "file": {
            "type": "string",
            "description": "%task.file%",
            "default": "${file}"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%task.args%",
            "default": []
          },
          "cwd": {
            "type": "string",
            "description": "%task.cwd%",
            "default": "${workspaceFolder}"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "harn",
        "owner": "harn",
        "source": "harn",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:error|warning|note)?\\s*([^:]+):(\\d+):(\\d+):?\\s+(error|warning|note):?\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "harn-lint",
        "owner": "harn",
        "source": "harn-lint",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "node --test test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "1.125.0",
    "typescript": "^7.0.2",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "7.1.0"
    }
  },
  "l10n": "./l10n"
}
