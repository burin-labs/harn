// Run: harn test personas/merge_captain/tests/scheduler_test.harn
//
// End-to-end exercises that the sweep loop reads from the fixture
// adapter, classifies each PR correctly, persists checkpoints, and
// surfaces newly arrived PRs across two sweeps.
import { list_all_checkpoints, open_checkpoints, prior_state_for } from "../lib/checkpoint_store"
import { fixture_adapter } from "../lib/github_adapter"
import { with_defaults } from "../lib/policy"
import { sweep } from "../lib/scheduler"

fn _policy_for(repo, queue_enabled) {
  return with_defaults(
    {repo: repo, merge_queue_enabled: queue_enabled, required_checks: ["ci"], required_review_count: 1},
  )
}

fn _snapshot(prs, checks_map) {
  return {[_default_repo()]: {pulls: prs, checks: checks_map}}
}

fn _default_repo() {
  return "x/y"
}

fn _pr(num, overrides) {
  const base = {
    repo: "x/y",
    number: num,
    title: "PR ${to_string(num)}",
    head_sha: "sha${to_string(num)}",
    head_ref: "feat-${to_string(num)}",
    base_ref: "main",
    state: "open",
    draft: false,
    merged: false,
    mergeable: true,
    mergeable_state: "clean",
    behind_by: 0,
    labels: [],
    review_decision: "APPROVED",
    approvals: 1,
    in_merge_queue: false,
    merge_group_active: false,
  }
  const extras = overrides ?? {}
  return base + extras
}

fn _ok_check() {
  return [{name: "ci", status: "completed", conclusion: "success"}]
}

fn _fail_check() {
  return [{name: "ci", status: "completed", conclusion: "failure"}]
}

fn _open_handle(suffix) {
  // Unique per invocation so re-running tests does not see stale state.
  const session = "scheduler-test-${suffix}-${to_string(now_ms())}"
  return open_checkpoints(".harn/test/merge-captain", session, "merge_captain_test")
}

pipeline test_sweep_classifies_clean_pr(task) {
  const snapshot = _snapshot([_pr(1, {})], {"1": _ok_check()})
  const adapter = fixture_adapter(snapshot)
  const handle = _open_handle("classify-clean")
  const summary = sweep(
    {
      adapter: adapter,
      policies: [_policy_for(_default_repo(), true)],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-clean",
    },
  )
  assert_eq(summary.pr_count, 1)
  assert_eq(summary.by_state.queued, 1)
  assert_eq(summary.by_action.enqueue_merge_queue, 1)
}

pipeline test_sweep_persists_checkpoints(task) {
  const snapshot = _snapshot([_pr(1, {behind_by: 2, mergeable_state: "behind"})], {"1": _ok_check()})
  const adapter = fixture_adapter(snapshot)
  const handle = _open_handle("persist")
  sweep(
    {
      adapter: adapter,
      policies: [_policy_for(_default_repo(), true)],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-persist",
    },
  )
  const prior = prior_state_for(handle, _default_repo(), 1)
  assert_eq(prior, "behind")
  const all = list_all_checkpoints(handle)
  assert_eq(len(all), 1)
}

pipeline test_resume_picks_up_new_pr(task) {
  const policy = _policy_for(_default_repo(), true)
  const snapshot1 = _snapshot([_pr(1, {})], {"1": _ok_check()})
  const snapshot2 = _snapshot([_pr(1, {}), _pr(2, {})], {"1": _ok_check(), "2": _ok_check()})
  const handle = _open_handle("resume-add")
  // First sweep tracks PR 1 only.
  sweep(
    {
      adapter: fixture_adapter(snapshot1),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-resume-1",
    },
  )
  assert_eq(prior_state_for(handle, _default_repo(), 1), "queued")
  assert_eq(prior_state_for(handle, _default_repo(), 2), "discovered")
  // Second sweep absorbs the newly opened PR 2.
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot2),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-resume-2",
    },
  )
  assert_eq(summary.pr_count, 2)
  assert_eq(prior_state_for(handle, _default_repo(), 2), "queued")
}

pipeline test_disappeared_pr_gets_terminal_receipt(task) {
  const policy = _policy_for(_default_repo(), true)
  const snapshot1 = _snapshot([_pr(1, {})], {"1": _ok_check()})
  const snapshot2 = _snapshot([], {})
  const handle = _open_handle("disappear")
  sweep(
    {
      adapter: fixture_adapter(snapshot1),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-disappear-1",
    },
  )
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot2),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-disappear-2",
    },
  )
  // Reconciliation produced a closed-receipt for PR 1.
  assert_eq(summary.pr_count, 1)
  assert_eq(summary.by_state.closed, 1)
  // Checkpoint was forgotten so the next sweep stays clean.
  const all = list_all_checkpoints(handle)
  assert_eq(len(all), 0)
}

pipeline test_failing_ci_with_local_verify_runs_dry(task) {
  const policy_extra = with_defaults(
    {
      repo: _default_repo(),
      merge_queue_enabled: true,
      required_checks: ["ci"],
      local_verification: [{name: "tests", command: "true"}],
    },
  )
  const snapshot = _snapshot([_pr(1, {})], {"1": _fail_check()})
  const handle = _open_handle("local-verify")
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot),
      policies: [policy_extra],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-local-verify",
    },
  )
  assert_eq(summary.by_state.local_repair, 1)
  assert_eq(summary.by_action.run_local_verification, 1)
  // Per-PR receipt records the (skipped) command.
  const receipt = summary.receipts[0]
  assert_eq(len(receipt.commands_run), 1)
  const cmd = receipt.commands_run[0]
  assert_eq(cmd.action, "run_local_verification")
  const local_results = cmd.results
  assert_eq(local_results[0].status, "skipped_dry_run")
}

fn _stub_repair_executor(output) {
  return { _bundle, _options -> {
    ok: true,
    output: output,
    raw: "stub",
    agent_loop: {status: "completed", iterations: 1, input_tokens: 50, output_tokens: 25},
  } }
}

fn _ok_repair_output() {
  return {
    diagnosis: "ci flake repaired",
    files_changed: [{path: "src/foo.rs", action: "modified"}],
    tests_run: [{name: "tests", command: "true", status: "ok", exit_code: 0}],
    commits_created: [{sha: "abc", subject: "fix flake"}],
    push_result: {pushed: true, ref: "feat-1", sha: "abc", force_with_lease: true},
    residual_risk: "none",
  }
}

pipeline test_repair_worker_dispatch_attaches_run_to_receipt(task) {
  const policy_with_worker = with_defaults(
    {
      repo: _default_repo(),
      merge_queue_enabled: true,
      required_checks: ["ci"],
      local_verification: [{name: "tests", command: "true"}],
      repair_worker: {
        enabled: true,
        handles_kinds: ["ci_failure"],
        autopilot_action_kinds: ["semantic_repair"],
        require_human_for: [],
      },
    },
  )
  const snapshot = _snapshot([_pr(1, {head_ref: "feat-1"})], {"1": _fail_check()})
  const handle = _open_handle("repair-worker-attach")
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot),
      policies: [policy_with_worker],
      checkpoint_handle: handle,
      dry_run: false,
      sweep_id: "test-repair-attach",
      repair_executor: _stub_repair_executor(_ok_repair_output()),
      repair_extras_for: { _obs -> {allowed_write_scope: ["src/**"]} },
    },
  )
  assert_eq(summary.pr_count, 1)
  const receipt = summary.receipts[0]
  // The classifier still says local_repair / run_local_verification —
  // the scheduler upgrades the action transparently and records it as
  // run_repair_worker in the commands list.
  assert_eq(receipt.classification.state, "local_repair")
  assert_eq(receipt.classification.action, "run_local_verification")
  assert_eq(len(receipt.commands_run), 1)
  const cmd = receipt.commands_run[0]
  assert_eq(cmd.action, "run_repair_worker")
  assert_eq(cmd.bundle_kind, "ci_failure")
  assert_eq(cmd.status, "completed")
  assert_eq(cmd.approval_state, "autopilot")
  assert_eq(cmd.output_summary.pushed, true)
  // The repair_run linkage is on the receipt itself for auditability.
  assert(receipt.repair_run != nil)
  assert_eq(receipt.repair_run._type, "merge_captain.repair_run_link")
  assert_eq(receipt.repair_run.bundle_kind, "ci_failure")
  assert_eq(receipt.repair_run.bundle_pr_number, 1)
  assert_eq(receipt.repair_run.status, "completed")
  assert_eq(receipt.final_outcome, "repair_worker_completed")
}

pipeline test_repair_worker_blocked_when_human_required(task) {
  const policy = with_defaults(
    {
      repo: _default_repo(),
      merge_queue_enabled: true,
      required_checks: ["ci"],
      local_verification: [{name: "tests", command: "true"}],
      repair_worker: {enabled: true, handles_kinds: ["ci_failure"], require_human_for: ["semantic_repair"]},
    },
  )
  const snapshot = _snapshot([_pr(1, {head_ref: "feat-1"})], {"1": _fail_check()})
  const handle = _open_handle("repair-worker-blocked")
  let executor_calls = 0
  const executor = { _bundle, _options ->
    executor_calls = executor_calls + 1
    {ok: true, output: _ok_repair_output(), raw: "should_not_run"}
  }
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: false,
      sweep_id: "test-repair-blocked",
      repair_executor: executor,
      repair_extras_for: { _obs -> {allowed_write_scope: ["src/**"]} },
    },
  )
  const receipt = summary.receipts[0]
  const cmd = receipt.commands_run[0]
  assert_eq(cmd.status, "blocked_pending_approval")
  assert(cmd.blocking_actions.contains("semantic_repair"))
  assert_eq(executor_calls, 0)
  assert_eq(receipt.repair_run.status, "blocked_pending_approval")
}

pipeline test_repair_worker_disabled_falls_back_to_local_verify(task) {
  // Policy without repair_worker block keeps the existing path working.
  const policy = with_defaults(
    {
      repo: _default_repo(),
      merge_queue_enabled: true,
      required_checks: ["ci"],
      local_verification: [{name: "tests", command: "true"}],
    },
  )
  const snapshot = _snapshot([_pr(1, {head_ref: "feat-1"})], {"1": _fail_check()})
  const handle = _open_handle("repair-worker-disabled")
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: true,
      sweep_id: "test-repair-disabled",
    },
  )
  const receipt = summary.receipts[0]
  const cmd = receipt.commands_run[0]
  assert_eq(cmd.action, "run_local_verification")
  assert_eq(receipt.repair_run, nil)
}

pipeline test_repair_worker_validators_fail_writes_outside_scope(task) {
  const policy = with_defaults(
    {
      repo: _default_repo(),
      merge_queue_enabled: true,
      required_checks: ["ci"],
      local_verification: [{name: "tests", command: "true"}],
      repair_worker: {
        enabled: true,
        handles_kinds: ["ci_failure"],
        autopilot_action_kinds: ["semantic_repair"],
        require_human_for: [],
      },
    },
  )
  const snapshot = _snapshot([_pr(1, {head_ref: "feat-1"})], {"1": _fail_check()})
  const handle = _open_handle("repair-worker-violations")
  const bad_output = _ok_repair_output() + {files_changed: [{path: "secrets/key.pem", action: "created"}]}
  const summary = sweep(
    {
      adapter: fixture_adapter(snapshot),
      policies: [policy],
      checkpoint_handle: handle,
      dry_run: false,
      sweep_id: "test-repair-violations",
      repair_executor: _stub_repair_executor(bad_output),
      repair_extras_for: { _obs -> {allowed_write_scope: ["src/**"]} },
    },
  )
  const receipt = summary.receipts[0]
  const cmd = receipt.commands_run[0]
  assert_eq(cmd.status, "validators_failed")
  assert_eq(receipt.repair_run.status, "validators_failed")
  assert(receipt.repair_run.validation_errors[0].contains("unexpected write scope"))
  assert_eq(receipt.final_outcome, "repair_worker_validators_failed")
}
