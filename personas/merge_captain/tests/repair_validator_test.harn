// Run: harn test personas/merge_captain/tests/repair_validator_test.harn
import { build } from "../lib/repair_bundle"
import {
  harness_validate,
  path_matches_any,
  path_matches_glob,
  validate_all,
  validate_pushed,
  validate_shape,
  validate_tests,
  validate_write_scope,
} from "../lib/repair_validator"

fn _bundle(overrides) {
  const base = {
    kind: "ci_failure",
    repo: "x/y",
    pr_number: 1,
    head_sha: "h",
    head_ref: "feat",
    failing_checks: [{name: "ci", conclusion: "failure"}],
    allowed_write_scope: ["src/**", "tests/**"],
    required_verification: [{name: "tests", command: "make test"}],
  }
  return build(base + (overrides ?? {}))
}

fn _good_output() {
  return {
    diagnosis: "x",
    files_changed: [{path: "src/foo.rs", action: "modified"}],
    tests_run: [{name: "tests", command: "make test", status: "ok", exit_code: 0}],
    commits_created: [{sha: "abc", subject: "fix"}],
    push_result: {pushed: true, ref: "feat", sha: "abc", force_with_lease: true},
    residual_risk: "none",
  }
}

pipeline test_path_matches_glob_plain_prefix(harness: Harness, task) {
  assert(path_matches_glob("src/foo.rs", "src"))
  assert(path_matches_glob("src/foo/bar.rs", "src/foo"))
  assert(!path_matches_glob("srcs/foo.rs", "src"))
  assert(!path_matches_glob("other/foo.rs", "src"))
}

pipeline test_path_matches_glob_recursive(harness: Harness, task) {
  assert(path_matches_glob("src/foo.rs", "src/**"))
  assert(path_matches_glob("src/foo/bar/baz.rs", "src/**"))
  assert(path_matches_glob("src", "src/**"))
  assert(!path_matches_glob("other/foo.rs", "src/**"))
}

pipeline test_path_matches_glob_single_segment(harness: Harness, task) {
  assert(path_matches_glob("src/foo.rs", "src/*"))
  assert(!path_matches_glob("src/foo/bar.rs", "src/*"))
  assert(!path_matches_glob("src", "src/*"))
}

pipeline test_path_matches_any_short_circuits(harness: Harness, task) {
  const globs = ["src/**", "tests/**"]
  assert(path_matches_any("src/foo.rs", globs))
  assert(path_matches_any("tests/foo_test.rs", globs))
  assert(!path_matches_any("docs/foo.md", globs))
}

pipeline test_validate_shape_catches_missing_keys(harness: Harness, task) {
  const bare = {diagnosis: "x"}
  const v = validate_shape(bare)
  assert(!v.ok)
  assert_eq(len(v.errors), 1)
  const err = v.errors[0]
  assert(err.contains("malformed output"))
  assert(err.contains("files_changed"))
}

pipeline test_validate_shape_passes_full(harness: Harness, task) {
  const v = validate_shape(_good_output())
  assert(v.ok)
  assert_eq(len(v.errors), 0)
}

pipeline test_validate_tests_rejects_empty_when_required(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output() + {tests_run: []}
  const v = validate_tests(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("missing tests"))
}

pipeline test_validate_tests_rejects_missing_required_command(harness: Harness, task) {
  const bundle = _bundle({required_verification: [{name: "lint", command: "make lint"}]})
  const bad = _good_output()
    + {tests_run: [{name: "tests", command: "make test", status: "ok", exit_code: 0}]}
  const v = validate_tests(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("missing tests"))
  assert(v.errors[0].contains("lint"))
}

pipeline test_validate_tests_rejects_failing(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output()
    + {tests_run: [{name: "tests", command: "make test", status: "failed", exit_code: 1}]}
  const v = validate_tests(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("failing tests"))
}

pipeline test_validate_write_scope_blocks_outside(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output()
    + {
      files_changed: [
        {path: "src/foo.rs", action: "modified"},
        {path: "secrets/key.pem", action: "created"},
      ],
    }
  const v = validate_write_scope(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("unexpected write scope"))
  assert(v.errors[0].contains("secrets/key.pem"))
}

pipeline test_validate_write_scope_allows_inside(harness: Harness, task) {
  const bundle = _bundle({})
  const v = validate_write_scope(bundle, _good_output())
  assert(v.ok)
}

pipeline test_validate_write_scope_empty_scope_blocks_writes(harness: Harness, task) {
  // build() requires at least one entry, so we forge a raw bundle.
  const bundle = {
    _type: "merge_captain.repair_bundle",
    version: 1,
    kind: "ci_failure",
    allowed_write_scope: [],
  }
  const v = validate_write_scope(bundle, _good_output())
  assert(!v.ok)
  assert(v.errors[0].contains("unexpected write scope"))
}

pipeline test_validate_pushed_requires_push_when_committed(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output() + {push_result: {pushed: false, ref: "feat"}}
  const v = validate_pushed(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("unpushed commits"))
}

pipeline test_validate_pushed_rejects_push_without_commits(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output() + {commits_created: [], push_result: {pushed: true, ref: "feat"}}
  const v = validate_pushed(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("push without commits"))
}

pipeline test_validate_pushed_rejects_target_mismatch(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output() + {push_result: {pushed: true, ref: "wrong-branch", sha: "abc"}}
  const v = validate_pushed(bundle, bad)
  assert(!v.ok)
  assert(v.errors[0].contains("push target mismatch"))
}

pipeline test_validate_pushed_accepts_qualified_ref(harness: Harness, task) {
  const bundle = _bundle({})
  const good = _good_output() + {push_result: {pushed: true, ref: "refs/heads/feat", sha: "abc"}}
  const v = validate_pushed(bundle, good)
  assert(v.ok)
}

pipeline test_validate_all_short_circuits_on_shape_failure(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = {diagnosis: "x"}
  const v = validate_all(bundle, bad)
  assert(!v.ok)
  // Only the shape error surfaces because downstream checks need a full dict.
  assert_eq(len(v.errors), 1)
  assert(v.errors[0].contains("malformed output"))
}

pipeline test_validate_all_aggregates_errors(harness: Harness, task) {
  const bundle = _bundle({})
  const bad = _good_output()
    + {
      files_changed: [{path: "secrets/key.pem", action: "created"}],
      tests_run: [{name: "tests", command: "make test", status: "failed", exit_code: 1}],
      push_result: {pushed: false, ref: "feat"},
    }
  const v = validate_all(bundle, bad)
  assert(!v.ok)
  // tests + write scope + push together produce 3 distinct errors.
  assert_eq(len(v.errors), 3)
}

pipeline test_validate_all_passes_clean(harness: Harness, task) {
  const bundle = _bundle({})
  const v = validate_all(bundle, _good_output())
  assert(v.ok)
  assert_eq(len(v.errors), 0)
}

pipeline test_harness_validate_skipped_when_disabled(harness: Harness, task) {
  const bundle = _bundle({})
  const v = harness_validate(harness.process, bundle, _good_output(), {enabled: false})
  assert(v.ok)
  assert_eq(len(v.errors), 0)
}

pipeline test_harness_validate_rejects_unsafe_cwd(harness: Harness, task) {
  const bundle = _bundle({})
  const v = harness_validate(
    harness.process,
    bundle,
    _good_output(),
    {enabled: true, cwd: "/tmp; rm -rf /"},
  )
  assert(!v.ok)
  assert(v.errors[0].contains("shell metacharacters"))
}
