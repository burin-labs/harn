pub import { is_digest, is_git_id } from "./identifiers"
import { ReviewActor, ReviewObservation, ReviewedSource } from "./review"
import {
  AdmissionRecord,
  AdmissionRequest,
  AdmissionScope,
  Checkpoint,
  Execution,
  JobInputs,
  Policy,
  RepairOrigin,
  RepairPermit,
  Snapshot,
  SnapshotOrigin,
  Source,
  VerificationPlan,
  VerifierKey,
} from "./types"

/**
 * Closed records are projected into arrays so JSON object insertion order cannot change identity.
 */
pub fn source_identity(source: Source) -> string {
  return json_stringify([source.repository, source.commit, source.tree])
}

/** Complete semantic inputs must match before an original job can be reused. */
pub fn requirement_identity(requirement: JobInputs) -> string {
  return json_stringify(
    [
      requirement.id,
      requirement.kind,
      requirement.repository,
      requirement.input_digest,
      requirement.runtime_digest,
      requirement.environment_digest,
      requirement.coverage_digest,
      requirement.trust_domain,
      requirement.reuse_allowed,
      requirement.artifacts.sorted(),
    ],
  )
}

/** Signing bytes bind execution provenance, result, logs, artifacts, and timing. */
pub fn execution_bytes(execution: Execution) -> string {
  return "smart-ship.execution.v1\n"
    + json_stringify(
      [
        execution.installation,
        requirement_identity(execution.requirement),
        execution.requirement.execution_request,
        source_identity(execution.source),
        execution.run,
        execution.attempt,
        execution.job,
        execution.result,
        execution.log_digest,
        execution.artifacts.map({ artifact -> json_stringify([artifact.name, artifact.digest]) })
          .sorted(),
        if execution.tests == nil {
          nil
        } else {
          [
            execution.tests.report_digest,
            execution.tests.total,
            execution.tests.passed,
            execution.tests.failed,
            execution.tests.skipped,
          ]
        },
        execution.started_at_ms,
        execution.completed_at_ms,
      ],
    )
}

/** Policy identity contains every decision input and every allowed verification key. */
pub fn policy_digest(policy: Policy) -> string {
  const keys = { key: VerifierKey -> json_stringify([key.id, key.public_key, key.trust_domain]) }
  return "sha256:"
    + sha256_hex(
      "smart-ship.policy.v1\n"
        + json_stringify(
          [
            policy.installation,
            policy.repositories.sorted(),
            policy.verifier_keys.map(keys).sorted(),
            policy.checkpoint_keys.map(keys).sorted(),
            policy.scope_keys.map(keys).sorted(),
            policy.admission_keys.map(keys).sorted(),
            policy.admission_rules.map(
              { rule ->
                json_stringify(
                  [
                    rule.id,
                    rule.repository,
                    rule.repository_id,
                    rule.base_branch,
                    rule.scope_trust_domain,
                    rule.review.minimum_approvals,
                    rule.review.trusted_actor_ids.sorted(),
                    rule.review.allow_forks,
                  ],
                )
              },
            )
              .sorted(),
            policy.max_changes,
            policy.max_unverified_ms,
            policy.max_repair_attempts,
            // JSON readers may encode an integral budget as either 0 or 0.0.
            // Preserve existing float signing bytes while canonicalizing numeric zero.
            if policy.max_repair_usd == 0.0 {
              0.0
            } else {
              to_float(policy.max_repair_usd)
            },
          ],
        ),
    )
}

/** Canonical repair authority bytes are shared by candidate and snapshot identities. */
pub fn repair_permit_identity(permit: RepairPermit) -> string {
  return json_stringify(
    [
      permit.installation,
      permit.generation,
      permit.controller,
      permit.incident,
      permit.owner,
      permit.attempt,
    ],
  )
}

/** Repair origin cannot be erased or moved to another spend reservation. */
pub fn origin_identity(origin: SnapshotOrigin) -> string {
  if origin.kind == "repair" {
    const repair: RepairOrigin = schema_expect(origin, schema_of(RepairOrigin))
    return json_stringify(["repair", repair_permit_identity(repair.permit)])
  }
  return json_stringify(["changes"])
}

fn snapshot_frontier(snapshot: Snapshot) -> list {
  return [
    snapshot.installation,
    snapshot.sequence,
    snapshot.generation,
    snapshot.policy_digest,
    snapshot.previous_checkpoint,
    snapshot.created_at_ms,
    origin_identity(snapshot.origin),
    snapshot.sources.map({ source -> source_identity(source) }).sorted(),
    snapshot.changes.map(
      { change ->
        json_stringify(
          [
            change.id,
            change.repository,
            change.head,
            change.integrated_commit,
            admission_bytes(change.admission.record),
            change.admission.signer,
            change.admission.signature,
          ],
        )
      },
    )
      .sorted(),
    snapshot.requirements.map({ requirement -> requirement_identity(requirement) }).sorted(),
    snapshot.inventory_complete,
  ]
}

/**
 * The verification frontier excludes dispatch bindings so requests can be derived without a cycle.
 */
pub fn snapshot_verification_id(snapshot: Snapshot) -> string {
  return "sha256:"
    + sha256_hex(
      "smart-ship.verification-frontier.v1\n" + json_stringify(snapshot_frontier(snapshot)),
    )
}

/** Bind one required job to the complete immutable frontier, not just to its source tree. */
pub fn verification_request(frontier: string, requirement: string) -> string {
  require is_digest(frontier) && requirement != "", "verification request identity is incomplete"
  return "sha256:"
    + sha256_hex("smart-ship.verification-request.v1\n" + json_stringify([frontier, requirement]))
}

/**
 * Freeze the request for every declared job before dispatch. Incomplete inventories stay incomplete.
 */
pub fn freeze_snapshot(snapshot: Snapshot) -> Snapshot {
  const frontier = snapshot_verification_id(snapshot)
  return snapshot
    + {
      requirements: snapshot.requirements.map(
        { requirement ->
          requirement + {execution_request: verification_request(frontier, requirement.id)}
        },
      ),
    }
}

/** Project a grouped frontier onto the same job contract used by admission. */
pub fn snapshot_plan(snapshot: Snapshot) -> VerificationPlan {
  return {
    installation: snapshot.installation,
    frontier: snapshot_verification_id(snapshot),
    sources: snapshot.sources,
    requirements: snapshot.requirements,
    inventory_complete: snapshot.inventory_complete,
  }
}

/** Snapshot identity covers the immutable frontier and its derived verification requests. */
pub fn snapshot_bytes(snapshot: Snapshot) -> string {
  return "smart-ship.snapshot.v1\n"
    + json_stringify(
      [
        snapshot_frontier(snapshot),
        snapshot.requirements.map(
          { requirement -> json_stringify([requirement.id, requirement.execution_request]) },
        )
          .sorted(),
      ],
    )
}

/** Stable name for an exact frozen frontier. */
pub fn snapshot_id(snapshot: Snapshot) -> string {
  return "sha256:" + sha256_hex(snapshot_bytes(snapshot))
}

/** Checkpoint identity includes original proofs, their signatures, and how each was used. */
pub fn checkpoint_bytes(checkpoint: Checkpoint) -> string {
  return "smart-ship.checkpoint.v1\n"
    + json_stringify(
      [
        policy_digest(checkpoint.policy),
        snapshot_bytes(checkpoint.snapshot),
        checkpoint.proofs.map(
          { proof ->
            json_stringify(
              [
                proof.requirement,
                proof.mode,
                execution_bytes(proof.original),
                proof.signer,
                proof.signature,
              ],
            )
          },
        )
          .sorted(),
      ],
    )
}

/** Immutable checkpoint name; a convenience branch or tag is only a projection. */
pub fn checkpoint_id(checkpoint: Checkpoint) -> string {
  return "sha256:" + sha256_hex(checkpoint_bytes(checkpoint))
}

fn actor_identity(actor: ReviewActor?) {
  return if actor == nil {
    nil
  } else {
    [actor.id, actor.name, actor.kind]
  }
}

fn reviewed_source_identity(source: ReviewedSource) -> string {
  return json_stringify(
    [
      source.repository,
      source.change,
      source.head,
      source.base,
      source.base_branch,
      actor_identity(source.author),
      source.state,
      source.draft,
      source.head_repository,
      source.base_repository,
      source.head_repository_id,
      source.base_repository_id,
    ],
  )
}

fn review_identity(reviews: ReviewObservation) -> string {
  return json_stringify(
    [
      reviews.repository,
      reviews.change,
      reviews.head,
      reviews.base,
      reviews.base_branch,
      reviews.platform_decision,
      reviews.declared_reviews,
      reviews.declared_threads,
      reviews.reviews.map(
        { row ->
          json_stringify(
            [
              row.id,
              row.state,
              row.head,
              actor_identity(row.actor),
              row.submitted_at,
              row.updated_at,
            ],
          )
        },
      )
        .sorted(),
      reviews.threads.map({ row -> json_stringify([row.id, row.resolved, row.outdated]) }).sorted(),
    ],
  )
}

/** Signing bytes authenticate the owning scope adapter's complete semantic selection. */
pub fn scope_bytes(scope: AdmissionScope) -> string {
  return "smart-ship.admission-scope.v1\n"
    + json_stringify(
      [
        scope.installation,
        scope.policy_digest,
        scope.rule,
        scope.reviewed_head,
        scope.reviewed_base,
        scope.reviewed_base_branch,
        source_identity(scope.source),
        scope.requirements.map({ requirement -> requirement_identity(requirement) }).sorted(),
        scope.inventory_complete,
      ],
    )
}

fn admission_request_bytes(request: AdmissionRequest) -> string {
  return "smart-ship.admission-request.v1\n"
    + json_stringify(
      [
        request.installation,
        request.policy_digest,
        policy_digest(request.policy),
        reviewed_source_identity(request.source),
        review_identity(request.reviews),
        scope_bytes(request.scope.scope),
        request.scope.signer,
        request.scope.signature,
      ],
    )
}

/** Bind prechecks to signed scope; current reviews are authenticated by the admission receipt. */
pub fn prepare_admission(request: AdmissionRequest) -> VerificationPlan {
  const frontier = "sha256:"
    + sha256_hex(
      "smart-ship.admission-dispatch.v1\n"
        + json_stringify(
          [scope_bytes(request.scope.scope), request.scope.signer, request.scope.signature],
        ),
    )
  return {
    installation: request.installation,
    frontier: frontier,
    sources: [request.scope.scope.source],
    requirements: request.scope.scope.requirements.map(
      { inputs -> inputs + {execution_request: verification_request(frontier, inputs.id)} },
    ),
    inventory_complete: request.scope.scope.inventory_complete,
  }
}

/** The admission issuer signs inspectable review, scope, original execution, and timing facts. */
pub fn admission_bytes(record: AdmissionRecord) -> string {
  return "smart-ship.admission.v1\n"
    + json_stringify(
      [
        admission_request_bytes(record),
        record.proofs.map(
          { proof ->
            json_stringify(
              [
                proof.requirement,
                proof.mode,
                execution_bytes(proof.original),
                proof.signer,
                proof.signature,
              ],
            )
          },
        )
          .sorted(),
        record.admitted_at_ms,
      ],
    )
}
