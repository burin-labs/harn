import { ReviewAdmission, ReviewObservation, ReviewPolicy, ReviewedSource } from "./review"

/** One immutable Git source identity. Repository names are installation data. */
pub type Source = {repository: string, commit: string, tree: string}

/** Reviewed work retains its original head even after integration changes its SHA. */
pub type Change = {
  id: string,
  repository: string,
  head: string,
  integrated_commit: string,
  admission: SignedAdmission,
}

/** A required job's complete execution inputs, independent of runner placement. */
pub type JobInputs = {
  id: string,
  kind: "tests" | "check",
  repository: string,
  input_digest: string,
  runtime_digest: string,
  environment_digest: string,
  coverage_digest: string,
  trust_domain: string,
  reuse_allowed: bool,
  artifacts: list<string>,
}

/** A dispatch binds semantic job inputs to one immutable verification request. */
pub type Requirement = JobInputs & {execution_request: string}

/** An executor key has one declared trust domain; another installation cannot borrow it. */
pub type VerifierKey = {id: string, public_key: string, trust_domain: string}

/** Release consumers need issuer trust, while the checkpoint retains its qualification policy. */
pub type CheckpointTrust = {installation: string, checkpoint_keys: list<VerifierKey>}

/** Immutable policy used to judge a candidate, including candidates that change policy. */
pub type Policy = {
  schema: "smart-ship.policy.v1",
  installation: string,
  repositories: list<string>,
  verifier_keys: list<VerifierKey>,
  checkpoint_keys: list<VerifierKey>,
  scope_keys: list<VerifierKey>,
  admission_keys: list<VerifierKey>,
  admission_rules: list<AdmissionRule>,
  max_changes: int,
  max_unverified_ms: int,
  max_repair_attempts: int,
  max_repair_usd: float,
}

/** A repair claim names the controller, incident, worker and reserved attempt. */
pub type RepairPermit = {
  installation: string,
  generation: int,
  controller: string,
  incident: string,
  owner: string,
  attempt: int,
}

/** Repaired source retains the exact incident and spend reservation that authorized it. */
pub type RepairOrigin = {kind: "repair", permit: RepairPermit}

/** Ordinary reviewed admission and bounded repair have distinct source authority. */
pub type SnapshotOrigin = {kind: "changes"} | RepairOrigin

/** A frozen frontier and the complete job census derived by the owning scope adapter. */
pub type Snapshot = {
  schema: "smart-ship.snapshot.v1",
  installation: string,
  sequence: int,
  generation: int,
  policy_digest: string,
  previous_checkpoint: string,
  created_at_ms: int,
  origin: SnapshotOrigin,
  sources: list<Source>,
  changes: list<Change>,
  requirements: list<Requirement>,
  inventory_complete: bool,
}

/** Artifacts name both their logical output and their immutable content. */
pub type Artifact = {name: string, digest: string}

/** A complete producer report distinguishes observed cases from an absent report. */
pub type TestEvidence = {report_digest: string, total: int, passed: int, failed: int, skipped: int}

/** Original execution provenance survives every later reuse. */
pub type Execution = {
  schema: "smart-ship.execution.v1",
  installation: string,
  requirement: Requirement,
  source: Source,
  run: string,
  attempt: int,
  job: string,
  result: "passed" | "failed" | "infrastructure_failed" | "cancelled",
  log_digest: string,
  artifacts: list<Artifact>,
  tests: TestEvidence?,
  started_at_ms: int,
  completed_at_ms: int,
}

/** A signature covers the original execution, never an intermediary's green slot. */
pub type Proof = {
  requirement: string,
  mode: "executed" | "reused",
  original: Execution,
  signer: string,
  signature: string,
}

/** Trusted scope selection chooses an installation-owned review policy for one repository. */
pub type AdmissionRule = {
  id: string,
  repository: string,
  repository_id: string?,
  base_branch: string,
  scope_trust_domain: string,
  review: ReviewPolicy,
}

/** The owning scope adapter attests the complete job census before dispatch bindings exist. */
pub type AdmissionScope = {
  schema: "smart-ship.admission-scope.v1",
  installation: string,
  policy_digest: string,
  rule: string,
  reviewed_head: string,
  reviewed_base: string,
  reviewed_base_branch: string,
  source: Source,
  requirements: list<JobInputs>,
  inventory_complete: bool,
}

/** Scope signatures authenticate selection without giving candidate code that authority. */
pub type SignedScope = {scope: AdmissionScope, signer: string, signature: string}

/** Frozen admission inputs are shared by dispatch, archived replay, and receipt validation. */
pub type AdmissionRequest = {
  installation: string,
  policy_digest: string,
  policy: Policy,
  source: ReviewedSource,
  reviews: ReviewObservation,
  scope: SignedScope,
}

/** A receipt retains required CI evidence rather than replacing it with an opaque digest. */
pub type AdmissionRecord = AdmissionRequest \
  & {schema: "smart-ship.admission.v1", proofs: list<Proof>, admitted_at_ms: int}

/** Only an installation's declared admission issuer can authorize the recorded decision. */
pub type SignedAdmission = {record: AdmissionRecord, signer: string, signature: string}

/** A nonrecursive verification plan serves admission and cumulative grouped snapshots. */
pub type VerificationPlan = {
  installation: string,
  frontier: string,
  sources: list<Source>,
  requirements: list<Requirement>,
  inventory_complete: bool,
}

/** Qualification exposes both decisions and their complete inventories. */
pub type AdmissionVerification = {
  status: "admitted" | "pending" | "failed" | "invalid",
  review: ReviewAdmission?,
  checks: Verification,
  invalid: list<string>,
}

/** Complete counts and names prevent a missing census from looking green. */
pub type Verification = {
  status: "verified" | "pending" | "failed" | "invalid",
  required: int,
  executed: int,
  reused: int,
  pending: list<string>,
  failed: list<string>,
  infrastructure_failed: list<string>,
  invalid: list<string>,
}

/** One existing mutation writer, bound to its repository and exact control-source revision. */
pub type FormerWriter = {id: string, repository: string, source: string}

/** A complete provider observation retains the measured resource even when its count is zero. */
pub type WriterDrainCensus = {
  resource: string,
  complete: bool,
  declared: int,
  unsettled: list<string>,
}

/** Every registered writer must answer for all four kinds of unfinished work. */
pub type WriterDrainObservation = {
  writer: FormerWriter,
  runs: WriterDrainCensus,
  queue: WriterDrainCensus,
  repairs: WriterDrainCensus,
  effects: WriterDrainCensus,
}

/** The installation's trusted scope observer binds a real drain to its durable start. */
pub type WriterDrain = {
  schema: "smart-ship.writer-drain.v1",
  installation: string,
  policy_digest: string,
  controller: string,
  generation: int,
  drain_revision: int,
  observed_at_ms: int,
  expires_at_ms: int,
  observations: list<WriterDrainObservation>,
}

/** A signature authenticates the observer, not the correctness of its provider census. */
pub type SignedWriterDrain = {drain: WriterDrain, signer: string, signature: string}

/** The accepted observation remains verifiable after its dispatch window expires. */
pub type WriterRetirement = {proof: SignedWriterDrain, accepted_at_ms: int}

/** Former-writer retirement remains durable across pause, restart and controller transfer. */
pub type WriterHandoff = {
  schema: "smart-ship.writer-handoff.v1",
  policy: Policy,
  scope_trust_domain: string,
  controller: string,
  generation: int,
  enrolled_revision: int,
  enrolled_at_ms: int,
  max_drain_age_ms: int,
  writers: list<FormerWriter>,
  phase: "observing" | "draining" | "retired",
  drain_revision: int?,
  drain_started_at_ms: int?,
  retirement: WriterRetirement?,
}

/** A running former writer captures this authority fence once, including its control revision. */
pub type FormerWriterPermit = Fence & {writer: FormerWriter}

/** Counts and named refusals distinguish a measured drain from missing observations. */
pub type WriterDrainQualification = {
  status: "ready" | "pending" | "invalid",
  required: int,
  observed: int,
  pending: list<string>,
  invalid: list<string>,
}

/** Authority is read from the effect owner immediately before an effect. */
pub type Authority = {
  installation: string,
  policy: Policy,
  policy_digest: string,
  generation: int,
  revision: int,
  controller: string,
  mode: "shadow" | "active" | "draining" | "stopped",
  previous_checkpoint: string,
  promoted_sequence: int,
  held_repositories: list<string>,
  writer_handoff: WriterHandoff?,
}

/** A worker carries only an expected fence, never durable mutation credentials. */
pub type Fence = {installation: string, generation: int, revision: int, controller: string}

/** Proven source, job inventory, and signed original evidence form one release fact. */
pub type Checkpoint = {
  schema: "smart-ship.checkpoint.v1",
  policy: Policy,
  snapshot: Snapshot,
  proofs: list<Proof>,
}

/** Publication is independently signed by a key authorized for checkpoints. */
pub type SignedCheckpoint = {checkpoint: Checkpoint, signer: string, signature: string}

/** A refusal preserves the last checkpoint and names the failed condition. */
pub type Promotion = {
  status: "promote" | "refused",
  reason: string,
  verification: Verification,
  checkpoint: Checkpoint?,
}
