pub import {
  AdmissionEffect,
  CandidateEffect,
  CandidateQualification,
  EffectReceipt,
  EffectRefusal,
  EffectRequest,
  EffectTarget,
  IntegrationEffect,
  ReleaseEffect,
  RerunEffect,
  admission_effect,
  candidate_effect,
  effect_receipt,
  integration_effect,
  repair_candidate_effect,
} from "./effect_contract"
import {
  effect_receipt_valid,
  qualify_admission_effect,
  qualify_candidate_effect,
} from "./effect_contract"
import {
  checkpoint_id,
  is_digest,
  is_git_id,
  policy_digest,
  requirement_identity,
  snapshot_id,
} from "./identity"
import { fence_matches, promote } from "./promotion"
import {
  AdmissionVerification,
  Authority,
  Checkpoint,
  Fence,
  Policy,
  Proof,
  RepairOrigin,
  Snapshot,
  Verification,
} from "./types"
pub import { RepairPermit } from "./types"
import { policy_errors, verify } from "./verification"
import { writer_handoff_retired } from "./writer_handoff_contract"

/** Independent verification retains repaired source, original proofs and the complete verdict. */
pub type RepairVerification = {snapshot: Snapshot, proofs: list<Proof>, verification: Verification}

/** Attempt spend and independently measured repair verification share one ledger. */
pub type RepairAttempt = {
  owner: string,
  lease_until_ms: int,
  max_usd: float,
  spent_usd: float?,
  status: "active" | "unknown" | "settled" | "revoked",
  verification: RepairVerification?,
}

/** One incident retains the failed immutable source, original evidence, and all repair attempts. */
pub type Incident = {
  id: string,
  snapshot: Snapshot,
  proofs: list<Proof>,
  verification: Verification,
  attempts: list<RepairAttempt>,
  resolved: bool,
}

/** The next attempt repairs the latest measured source while retaining the original incident. */
pub fn repair_snapshot(incident: Incident) -> Snapshot {
  for attempt in incident.attempts.reversed() {
    if attempt.verification != nil {
      return attempt.verification.snapshot
    }
  }
  return incident.snapshot
}

/** Charged allowances are distinct from completely measured actual spend. */
pub type RepairSpend = {committed_usd: float, spent_usd: float?, unreported_attempts: list<int>}

/** Derive the budget projection from the one authoritative attempt ledger. */
pub fn repair_spend(incident: Incident) -> RepairSpend {
  let committed = 0.0
  let measured = 0.0
  let unreported: list<int> = []
  let number = 0
  for attempt in incident.attempts {
    number += 1
    if attempt.spent_usd == nil {
      committed += attempt.max_usd
      unreported.push(number)
    } else {
      committed += attempt.spent_usd
      measured += attempt.spent_usd
    }
  }
  return {
    committed_usd: committed,
    spent_usd: if len(unreported) == 0 {
      measured
    } else {
      nil
    },
    unreported_attempts: unreported,
  }
}

fn revoke_attempts(incident: Incident, revoke_settled: bool = false) -> Incident {
  return incident
    + {
      attempts: incident.attempts.map(
        { attempt ->
          if attempt.status == "active" {
            attempt + {status: "unknown"}
          } else if revoke_settled && attempt.status == "settled" && attempt.verification == nil {
            attempt + {status: "revoked"}
          } else {
            attempt
          }
        },
      ),
    }
}

/** An unresolved request blocks authority transfer until the adapter reconciles it. */
pub type Effect = {
  installation: string,
  request: EffectRequest,
  generation: int,
  controller: string,
  policy_digest: string,
  status: "reserved" | "dispatching" | "unknown" | "confirmed" | "refused",
  dispatch_binding: string?,
  dispatch_id: string?,
  dispatch_revision: int?,
  receipt: EffectReceipt?,
}

fn unresolved_effect(effect: Effect) -> bool {
  return ["reserved", "dispatching", "unknown"].contains(effect.status)
}

/** Persist this whole record with compare-and-swap before executing any returned work. */
pub type Controller = {
  schema: "smart-ship.controller.v1",
  authority: Authority,
  active: Snapshot?,
  pending: Snapshot?,
  checkpoint: Checkpoint?,
  incidents: list<Incident>,
  effects: list<Effect>,
  unverified_since_ms: int?,
}

/**
 * Resolve one repository from durable integration history, independent of another repository's jobs.
 * Without an integration receipt, retain the existing local snapshot projection. Nil is unknown,
 * not an assertion about the forge; adapters still measure and guard the actual destination.
 */
pub fn retained_repository_snapshot(state: Controller, repository: string) -> Snapshot? {
  for effect in state.effects.reversed() {
    if effect.status == "confirmed" && effect.request.kind == "integration"
      && effect.request.repository == repository {
      const request: IntegrationEffect = schema_expect(effect.request, schema_of(IntegrationEffect))
      return request.snapshot
    }
  }
  for snapshot in [state.pending, state.active, state.checkpoint?.snapshot] {
    if snapshot != nil && snapshot.sources.any({ source -> source.repository == repository }) {
      return snapshot
    }
  }
  return nil
}

fn repair_basis_current(state: Controller, incident: Incident) -> bool {
  const basis = repair_snapshot(incident)
  let observed = state.incidents.map(repair_snapshot)
  for snapshot in [state.pending, state.active, state.checkpoint?.snapshot] {
    if snapshot != nil {
      observed.push(snapshot)
    }
  }
  for effect in state.effects {
    if effect.status == "confirmed" && effect.request.kind == "integration" {
      const request: IntegrationEffect = schema_expect(effect.request, schema_of(IntegrationEffect))
      observed.push(request.snapshot)
    }
  }
  return !observed.any(
    { snapshot ->
      snapshot.sequence > basis.sequence
        && source_changed(snapshot, basis)
    },
  )
}

fn repair_claim_current(state: Controller, permit: RepairPermit, now_ms: int) -> bool {
  const incident = state.incidents.find({ item -> item.id == permit.incident })
  if incident == nil || len(incident.attempts) == 0 {
    return false
  }
  const attempt = incident.attempts[len(incident.attempts) - 1]
  return ["active", "draining"].contains(state.authority.mode)
    && state.authority.installation == permit.installation
    && state.authority.generation == permit.generation
    && state.authority.controller == permit.controller
    && !incident.resolved
    && repair_basis_current(state, incident)
    && attempt != nil
    && attempt.owner == permit.owner
    && len(incident.attempts) == permit.attempt
    && attempt.max_usd > 0.0
    && attempt.lease_until_ms > now_ms
    && !state.authority.held_repositories.any(
      { repository ->
        incident.snapshot.sources.any({ source -> source.repository == repository })
      },
    )
}

/** Check against freshly read durable state immediately before a worker effect. */
pub fn repair_authorized(state: Controller, permit: RepairPermit, now_ms: int) -> bool {
  if !repair_claim_current(state, permit, now_ms) {
    return false
  }
  const incident = state.incidents.find({ item -> item.id == permit.incident })!
  return incident.attempts[permit.attempt - 1]!.status == "active"
}

/** Only a completely priced, current proposal can reach the privileged publication owner. */
pub fn repair_publication_authorized(state: Controller, permit: RepairPermit, now_ms: int) -> bool {
  if !repair_claim_current(state, permit, now_ms) {
    return false
  }
  const incident = state.incidents.find({ item -> item.id == permit.incident })!
  const attempt = incident.attempts[permit.attempt - 1]!
  return attempt.status == "settled" && attempt.verification == nil
    && attempt.spent_usd != nil
    && attempt.spent_usd <= attempt.max_usd
    && repair_spend(incident).committed_usd <= state.authority.policy.max_repair_usd
}

/** Fresh authority exposes only the spend already reserved for this exact attempt. */
pub fn repair_allowance(state: Controller, permit: RepairPermit, now_ms: int) -> float? {
  if !repair_authorized(state, permit, now_ms) {
    return nil
  }
  const incident = state.incidents.find({ item -> item.id == permit.incident })
  if incident == nil {
    return nil
  }
  return incident.attempts[permit.attempt - 1]?.max_usd
}

fn preserves_work(snapshot: Snapshot, basis: Snapshot) -> bool {
  return basis.changes.all({ change -> snapshot.changes.contains(change) })
    && basis.requirements.all(
      { required ->
        snapshot.requirements.any(
          { job ->
            requirement_identity(job)
              == requirement_identity(required + {input_digest: job.input_digest})
          },
        )
      },
    )
}

fn source_changed(snapshot: Snapshot, basis: Snapshot) -> bool {
  return snapshot.sources.any(
    { source ->
      basis.sources.any(
        { original -> original.repository == source.repository && original != source },
      )
    },
  )
}

fn qualify_snapshot_origin(
  state: Controller,
  snapshot: Snapshot,
  now_ms: int,
) -> Result<RepairOrigin?, string> {
  if snapshot.origin.kind != "repair" {
    for incident in state.incidents {
      const basis = repair_snapshot(incident)
      const unclaimed = basis.sources.any(
        { original_source ->
          const source = snapshot.sources.find(
            { row -> row.repository == original_source.repository },
          )
          source != nil && source != original_source
            && !snapshot.changes.any(
              { change ->
                change.repository == original_source.repository
                  && !basis.changes.any(
                    { original ->
                      original.id == change.id && original.head == change.head
                        && original.repository == change.repository
                    },
                  )
              },
            )
        },
      )
      if !incident.resolved && unclaimed {
        return Err("changed incident source requires its bounded repair origin")
      }
    }
    return Ok(nil)
  }
  const origin: RepairOrigin = schema_expect(snapshot.origin, schema_of(RepairOrigin))
  if !repair_publication_authorized(state, origin.permit, now_ms) {
    return Err("repair source authority is absent, revoked, expired, or superseded")
  }
  const incident = state.incidents.find({ item -> item.id == origin.permit.incident })!
  const basis = repair_snapshot(incident)
  if snapshot.sequence <= basis.sequence || !preserves_work(snapshot, basis)
    || snapshot.changes != basis.changes
    || snapshot.sources.map({ source -> source.repository }).sorted()
      != basis.sources.map({ source -> source.repository }).sorted() {
    return Err(
      "repair source must preserve its incident's repositories, admitted work, and required jobs",
    )
  }
  return Ok(origin)
}

fn authorized(state: Controller, fence: Fence) -> bool {
  return fence_matches(state.authority, fence)
}

fn policy_matches(state: Controller, policy: Policy) -> bool {
  return policy.installation == state.authority.installation
    && policy_digest(policy) == state.authority.policy_digest
    && len(policy_errors(policy)) == 0
}

fn advance(state: Controller) -> Controller {
  let next = state
  next.authority.revision += 1
  return next
}

/** Construct a refusal without turning unmeasured evidence into a measured zero. */
fn effect_refusal(
  reason: string,
  admission: AdmissionVerification? = nil,
  verification: Verification? = nil,
) -> EffectRefusal {
  return {reason: reason, admission: admission, verification: verification}
}

pub fn qualify_group_effect(
  state: Controller,
  fence: Fence,
  effect: EffectRequest,
  policy: Policy,
  now_ms: int?,
) -> EffectRefusal? {
  if effect.kind == "candidate" {
    return qualify_candidate(
      state,
      schema_expect(effect, schema_of(CandidateEffect)),
      policy,
      now_ms,
    )
  }
  if effect.kind != "integration" {
    return nil
  }
  const request = schema_expect(effect, schema_of(IntegrationEffect))
  const derived = try {
    integration_effect(request.snapshot)
  }
  const verification = verify(request.snapshot, [], policy)
  if is_err(derived) || unwrap(derived) != request {
    return effect_refusal(
      "integration target differs from its complete frontier",
      nil,
      verification,
    )
  }
  if now_ms == nil {
    return effect_refusal("integration requires the owner's current time", nil, verification)
  }
  const offered = offer(state, fence, request.snapshot, policy, now_ms)
  return if is_err(offered) {
    effect_refusal(unwrap_err(offered), nil, verification)
  } else {
    nil
  }
}

fn qualify_candidate(
  state: Controller,
  request: CandidateEffect,
  policy: Policy,
  now_ms: int?,
) -> EffectRefusal? {
  const measured = qualify_candidate_effect(request, policy)
  if len(measured.invalid) > 0
    || measured.admissions.any({ item -> item.status != "admitted" }) {
    return effect_refusal("candidate preparation inputs are not qualified")
      + {preparation: measured}
  }
  if request.origin.kind == "repair" {
    return qualify_repair_candidate(state, request, measured, now_ms)
  }
  const frontier = retained_repository_snapshot(state, request.repository)
  const known = (frontier?.sources ?? []).find({ item -> item.repository == request.repository })
  let retained = (frontier?.changes ?? []).filter({ item -> item.repository == request.repository })
    .to_list()
  for incident in state.incidents {
    if !incident.resolved {
      retained = retained
        + repair_snapshot(incident).changes.filter(
          { change -> change.repository == request.repository },
        )
          .to_list()
    }
  }
  if now_ms == nil || now_ms < 0
    || (known != nil && known.commit != request.source)
    || len(frontier?.changes ?? []) + measured.required > policy.max_changes
    || request.admissions.any(
      { signed ->
        retained.any(
          { change ->
            change.id == signed.record.source.change
              || change.head == signed.record.source.head
          },
        )
      },
    )
    || (state.unverified_since_ms != nil
      && (now_ms < state.unverified_since_ms
        || now_ms - state.unverified_since_ms >= policy.max_unverified_ms)) {
    return effect_refusal("candidate base, cumulative change bound or verification debt is invalid")
      + {preparation: measured}
  }
  return nil
}

fn qualify_repair_candidate(
  state: Controller,
  request: CandidateEffect,
  measured: CandidateQualification,
  now_ms: int?,
) -> EffectRefusal? {
  const origin: RepairOrigin = schema_expect(request.origin, schema_of(RepairOrigin))
  if now_ms == nil || now_ms < 0 || !repair_publication_authorized(state, origin.permit, now_ms) {
    return effect_refusal("repair candidate requires its current completely priced claim")
      + {preparation: measured}
  }
  const incident = state.incidents.find({ item -> item.id == origin.permit.incident })!
  const basis = repair_snapshot(incident)
  const source = basis.sources.find({ item -> item.repository == request.repository })
  if len(basis.sources) != 1 || source == nil || source.commit != request.source
    || source.tree == request.tree
    || basis.changes.map({ change -> change.admission }) != request.admissions {
    return effect_refusal(
      "repair candidate must retain its exact failed source and original admissions",
    )
      + {preparation: measured}
  }
  for effect in state.effects {
    if effect.request.kind == "candidate" {
      const previous: CandidateEffect = schema_expect(effect.request, schema_of(CandidateEffect))
      if previous.origin == request.origin && previous != request {
        return effect_refusal(
          "repair attempt already names a different candidate; reconcile its original request",
        )
          + {preparation: measured}
      }
    }
  }
  return nil
}

fn reservation_mode_allowed(state: Controller, request: EffectRequest) -> bool {
  if state.authority.mode == "active" {
    return true
  }
  if state.authority.mode != "draining" {
    return false
  }
  if request.kind == "candidate" {
    const candidate: CandidateEffect = schema_expect(request, schema_of(CandidateEffect))
    return candidate.origin.kind == "repair"
  }
  if request.kind == "integration" {
    const integration: IntegrationEffect = schema_expect(request, schema_of(IntegrationEffect))
    return integration.snapshot.origin.kind == "repair"
  }
  return false
}

/** Persist the qualified reservation with CAS; refusals retain any measured evidence. */
pub fn reserve_effect(
  state: Controller,
  fence: Fence,
  request: EffectRequest,
  policy: Policy,
  dispatch_binding: string? = nil,
  now_ms: int? = nil,
) -> Result<Controller, EffectRefusal> {
  if !authorized(state, fence) || !reservation_mode_allowed(state, request)
    || !policy_matches(state, policy)
    || !policy.repositories.contains(request.repository)
    || request.repository == ""
    || !is_git_id(request.source)
    || !is_digest(request.input_digest)
    || (dispatch_binding != nil && !is_digest(dispatch_binding))
    || state.authority.held_repositories.contains(request.repository) {
    return Err(effect_refusal("external effect authority or source identity is invalid"))
  }
  const admission = qualify_admission_effect(request, policy)
  if admission != nil && admission.status != "admitted" {
    return Err(effect_refusal("external admission is not qualified", admission))
  }
  const group_refusal = qualify_group_effect(state, fence, request, policy, now_ms)
  if group_refusal != nil {
    return Err(group_refusal)
  }
  if request.kind == "release" {
    const checkpoint = state.checkpoint
    if checkpoint == nil
      || request.input_digest != checkpoint_id(checkpoint)
      || policy_digest(checkpoint.policy) != state.authority.policy_digest
      || !checkpoint.snapshot.sources.any(
        { source -> source.repository == request.repository && source.commit == request.source },
      ) {
      return Err(effect_refusal("release request does not name the exact proven checkpoint"))
    }
    const verification = verify(checkpoint.snapshot, checkpoint.proofs, policy)
    if verification.status != "verified" {
      return Err(
        effect_refusal("release checkpoint verification is not complete", nil, verification),
      )
    }
  }
  if state.effects.any({ effect -> effect.request == request }) {
    return Err(
      effect_refusal("external effect is already recorded; reconcile its original request"),
    )
  }
  if state.effects.any(
    { effect ->
      effect.request.repository == request.repository
        && unresolved_effect(effect)
    },
  ) {
    return Err(effect_refusal("repository already has an unresolved external effect"))
  }
  let next = advance(state)
  next.effects = next.effects
    + [
      {
        installation: state.authority.installation,
        request: request,
        generation: state.authority.generation,
        controller: state.authority.controller,
        policy_digest: state.authority.policy_digest,
        status: "reserved",
        dispatch_binding: dispatch_binding,
        dispatch_id: nil,
        dispatch_revision: nil,
        receipt: nil,
      },
    ]
  return Ok(next)
}

fn repair_effect_permit(request: EffectRequest) -> RepairPermit? {
  if request.kind == "candidate" {
    const candidate: CandidateEffect = schema_expect(request, schema_of(CandidateEffect))
    if candidate.origin.kind == "repair" {
      return schema_expect(candidate.origin, schema_of(RepairOrigin)).permit
    }
  }
  if request.kind == "integration" {
    const integration: IntegrationEffect = schema_expect(request, schema_of(IntegrationEffect))
    if integration.snapshot.origin.kind == "repair" {
      return schema_expect(integration.snapshot.origin, schema_of(RepairOrigin)).permit
    }
  }
  return nil
}

/** Re-read durable state before dispatch. A reservation is not perpetual permission. */
pub fn effect_authorized(state: Controller, effect: Effect, now_ms: int? = nil) -> bool {
  const permit = repair_effect_permit(effect.request)
  if permit != nil {
    if now_ms == nil || now_ms < 0
      || !repair_publication_authorized(state, permit, now_ms) {
      return false
    }
  }
  return ["active", "draining"].contains(state.authority.mode)
    && state.authority.installation == effect.installation
    && state.authority.generation == effect.generation
    && state.authority.controller == effect.controller
    && state.authority.policy_digest == effect.policy_digest
    && !state.authority.held_repositories.contains(effect.request.repository)
    && state.effects.contains(effect)
    && effect.status == "reserved"
}

/** Commit this transition with CAS at the privileged owner before contacting the provider. */
pub fn begin_effect(
  state: Controller,
  fence: Fence,
  request: EffectRequest,
  dispatch_id: string,
  dispatch_binding: string? = nil,
  now_ms: int? = nil,
) -> Result<Controller, string> {
  const effect = state.effects.find({ item -> item.request == request })
  if !authorized(state, fence) || effect == nil || !effect_authorized(state, effect, now_ms)
    || !is_digest(dispatch_id)
    || effect.dispatch_binding != dispatch_binding
    || effect.dispatch_id != nil {
    return Err("external dispatch authority is stale, stopped, or already consumed")
  }
  let next = advance(state)
  next.effects = state.effects.map(
    { item ->
      if item == effect {
        item
          + {
            status: "dispatching",
            dispatch_id: dispatch_id,
            dispatch_revision: next.authority.revision,
          }
      } else {
        item
      }
    },
  )
  return Ok(next)
}

/** Only a measured terminal receipt settles a request; timeout remains a transfer barrier. */
pub fn settle_effect(
  state: Controller,
  fence: Fence,
  request: EffectRequest,
  status: "unknown" | "confirmed" | "refused",
  receipt: EffectReceipt?,
) -> Result<Controller, string> {
  if request.kind == "candidate" && status == "confirmed" {
    const effect = state.effects.find({ item -> item.request == request })
    if effect == nil || effect.dispatch_id == nil || effect.status == "reserved" {
      return Err("candidate confirmation requires its durable dispatch claim")
    }
  }
  if request.kind == "integration" && status == "confirmed" {
    return Err("integration confirmation must retain its pending verification frontier")
  }
  return settle_claimed_effect(state, fence, request, status, receipt)
}

fn settle_claimed_effect(
  state: Controller,
  fence: Fence,
  request: EffectRequest,
  status: "unknown" | "confirmed" | "refused",
  receipt: EffectReceipt?,
) -> Result<Controller, string> {
  if !authorized(state, fence)
    || (status != "unknown" && receipt == nil)
    || (receipt != nil && !effect_receipt_valid(receipt)) {
    return Err("effect settlement requires current authority and an observed receipt")
  }
  const effect = state.effects.find({ item -> item.request == request })
  if effect == nil || effect.installation != state.authority.installation
    || effect.generation != state.authority.generation
    || effect.controller != state.authority.controller
    || !["reserved", "dispatching", "unknown"].contains(effect.status) {
    return Err("effect settlement is stale or does not match the reserved request")
  }
  let next = advance(state)
  next.effects = next.effects.map(
    { item ->
      if item.request == request {
        item + {status: status, receipt: receipt}
      } else {
        item
      }
    },
  )
  return Ok(next)
}

/**
 * Prepare the state that must move atomically with the destination ref.
 * A durable dispatch claim is required; preparing this value does not confirm a provider write.
 * Reuse offer's complete census, cumulative retention and debt limits at the final boundary.
 */
pub fn confirm_integration(
  state: Controller,
  fence: Fence,
  request: IntegrationEffect,
  policy: Policy,
  now_ms: int,
  receipt: EffectReceipt,
) -> Result<Controller, string> {
  const effect = state.effects.find({ item -> item.request == request })
  if effect == nil || effect.status != "dispatching" || effect.dispatch_id == nil {
    return Err("integration requires the durable dispatch claim")
  }
  const offered = offer(state, fence, request.snapshot, policy, now_ms)
  if is_err(offered) {
    return Err(unwrap_err(offered))
  }
  const settled = settle_claimed_effect(state, fence, request, "confirmed", receipt)
  if is_err(settled) {
    return settled
  }
  const frontier = unwrap(offered)
  // One atomic write advances authority once while retaining both transitions.
  return Ok(
    unwrap(settled)
      + {pending: frontier.pending, unverified_since_ms: frontier.unverified_since_ms},
  )
}

/** Freeze the newest cumulative frontier without cancelling the running verification. */
pub fn offer(
  state: Controller,
  fence: Fence,
  snapshot: Snapshot,
  policy: Policy,
  now_ms: int,
) -> Result<Controller, string> {
  const admission_mode = state.authority.mode == "active"
    || (state.authority.mode == "draining" && snapshot.origin.kind == "repair")
  if !authorized(state, fence) || !admission_mode
    || !policy_matches(state, policy) {
    return Err("admission authority unavailable")
  }
  if snapshot.installation != state.authority.installation
    || snapshot.generation != state.authority.generation
    || snapshot.previous_checkpoint != state.authority.previous_checkpoint
    || !snapshot.inventory_complete
    || len(snapshot.requirements) == 0 {
    return Err("snapshot identity or inventory is incomplete")
  }
  const latest = state.pending ?? state.active
  if len(verify(snapshot, [], policy).invalid) > 0
    || snapshot.sources.any(
      { source -> state.authority.held_repositories.contains(source.repository) },
    ) {
    return Err("snapshot policy is invalid or a repository is held")
  }
  const origin = qualify_snapshot_origin(state, snapshot, now_ms)
  if is_err(origin) {
    return Err(unwrap_err(origin))
  }
  if snapshot.sequence <= (latest?.sequence ?? state.authority.promoted_sequence) {
    return Err("snapshot is duplicate or obsolete")
  }
  if latest != nil {
    for change in latest.changes {
      const checkpoint = state.checkpoint
      const verified = checkpoint != nil
        && checkpoint.snapshot.changes.any({ item -> item == change })
      if !verified && !snapshot.changes.any({ item -> item == change }) {
        return Err("coalescing would lose admitted work")
      }
    }
  }
  const since = state.unverified_since_ms ?? now_ms
  if now_ms < since || (unwrap(origin) == nil && now_ms - since >= policy.max_unverified_ms)
    || len(snapshot.changes) > policy.max_changes {
    return Err("unverified work budget exhausted")
  }
  let next = advance(state)
  next.pending = snapshot
  next.unverified_since_ms = since
  return Ok(next)
}

/** Claim exactly one frozen snapshot; newer offers occupy only the pending slot. */
pub fn start(state: Controller, fence: Fence) -> Result<Controller, string> {
  if !authorized(state, fence) || !["active", "draining"].contains(state.authority.mode) {
    return Err("verification authority unavailable")
  }
  if state.active != nil || state.pending == nil {
    return Err("verification is busy or no snapshot is pending")
  }
  if state.pending.previous_checkpoint != state.authority.previous_checkpoint
    || state.pending.generation != state.authority.generation {
    return Err("pending work must be frozen against current authority and checkpoint")
  }
  let next = advance(state)
  next.active = state.pending
  next.pending = nil
  return Ok(next)
}

/** Complete only the claimed snapshot; a failure preserves the previous release checkpoint. */
pub fn complete(
  state: Controller,
  fence: Fence,
  completed: Snapshot,
  proofs: list<Proof>,
  policy: Policy,
) -> Result<Controller, string> {
  if !authorized(state, fence) || !policy_matches(state, policy) || state.active == nil
    || snapshot_id(state.active) != snapshot_id(completed) {
    return Err("verification completion is stale or unclaimed")
  }
  const decision = promote(completed, proofs, policy, state.authority, fence)
  if decision.verification.status == "pending" {
    return Err("verification still has pending jobs")
  }
  if decision.verification.status == "verified" && decision.status != "promote" {
    return Err(decision.reason)
  }
  let repaired: RepairOrigin? = nil
  if completed.origin.kind == "repair" {
    repaired = schema_expect(completed.origin, schema_of(RepairOrigin))
    const incident = state.incidents.find({ item -> item.id == repaired.permit.incident })
    if incident == nil || repaired.permit.attempt <= 0 {
      return Err("repair verification incident or attempt is absent")
    }
    const attempt = incident.attempts[repaired.permit.attempt - 1]
    if attempt == nil || attempt.owner != repaired.permit.owner
      || repaired.permit.attempt != len(incident.attempts)
      || attempt.verification != nil {
      return Err("repair verification belongs to an absent, stale, or already measured attempt")
    }
  }
  let next = advance(state)
  next.active = nil
  if decision.status == "promote" && decision.checkpoint != nil {
    next.checkpoint = decision.checkpoint
    next.authority.previous_checkpoint = checkpoint_id(decision.checkpoint)
    next.authority.promoted_sequence = completed.sequence
    // Resolve only incidents whose admitted work and required jobs remain in
    // this independently verified checkpoint. A newer sequence alone is not proof.
    next.incidents = next.incidents.map(
      { incident ->
        if preserves_work(completed, incident.snapshot)
          && preserves_work(completed, repair_snapshot(incident)) {
          revoke_attempts(incident) + {resolved: true}
        } else {
          incident
        }
      },
    )
    // A pending snapshot is still bound to the old checkpoint. The adapter must
    // re-freeze it against the newly published checkpoint before starting it.
    next.unverified_since_ms = if next.pending == nil {
      nil
    } else {
      next.unverified_since_ms
    }
  } else if repaired == nil {
    const id = snapshot_id(completed)
    if !next.incidents.any({ incident -> incident.id == id }) {
      next.incidents = next.incidents
        + [
          {
            id: id,
            snapshot: completed,
            proofs: proofs,
            verification: decision.verification,
            attempts: [],
            resolved: false,
          },
        ]
    }
  }
  if repaired != nil {
    next.incidents = next.incidents.map(
      { incident ->
        if incident.id != repaired.permit.incident {
          incident
        } else {
          let attempts = incident.attempts
          const index = repaired.permit.attempt - 1
          attempts[index] = attempts[index]!
            + {
              verification: {
                snapshot: completed,
                proofs: proofs,
                verification: decision.verification,
              },
            }
          incident + {attempts: attempts}
        }
      },
    )
  }
  return Ok(next)
}

/** Reserve one bounded repair attempt. Stale workers retain no mutation authority. */
pub fn claim_repair(
  state: Controller,
  fence: Fence,
  id: string,
  owner: string,
  now_ms: int,
  lease_ms: int,
  max_usd: float,
  policy: Policy,
) -> Result<Controller, string> {
  if !authorized(state, fence) || !policy_matches(state, policy)
    || state.authority.mode != "active"
    || owner == ""
    || lease_ms <= 0
    || lease_ms > policy.max_unverified_ms {
    return Err("repair authority or lease is invalid")
  }
  const incident = state.incidents.find({ item -> item.id == id })
  if incident == nil || incident.resolved || !repair_basis_current(state, incident)
    || len(incident.attempts) >= policy.max_repair_attempts
    || is_nan(max_usd)
    || is_infinite(max_usd)
    || max_usd <= 0.0
    || max_usd > policy.max_repair_usd - repair_spend(incident).committed_usd {
    return Err("incident is absent, resolved, superseded, or over budget")
  }
  if incident.attempts.any(
    { attempt -> attempt.status == "active" && attempt.lease_until_ms > now_ms },
  ) {
    return Err("incident already has a live repair owner")
  }
  let next = advance(state)
  next.incidents = state.incidents.map(
    { item ->
      if item.id != id {
        item
      } else {
        const revoked = revoke_attempts(item)
        revoked
          + {
            attempts: revoked.attempts
              + [
                {
                  owner: owner,
                  lease_until_ms: now_ms + lease_ms,
                  max_usd: max_usd,
                  spent_usd: nil,
                  status: "active",
                  verification: nil,
                },
              ],
          }
      }
    },
  )
  return Ok(next)
}

/** Stop and shadow cancel undispatched intent; claimed outcomes still require reconciliation. */
pub fn control(
  state: Controller,
  fence: Fence,
  mode: "shadow" | "active" | "draining" | "stopped",
) -> Result<Controller, string> {
  if !authorized(state, fence) {
    return Err("control authority changed")
  }
  if mode == "active" && !writer_handoff_retired(state.authority) {
    return Err("former mutation writers have not retired")
  }
  let next = advance(state)
  next.authority.mode = mode
  if mode == "stopped" || mode == "shadow" {
    next.incidents = next.incidents.map({ incident -> revoke_attempts(incident, true) })
    next.effects = next.effects.map(
      { effect ->
        if effect.status == "reserved" && effect.dispatch_id == nil {
          effect
            + {
              status: "refused",
              receipt: effect_receipt(
                json_stringify(
                  {
                    schema: "smart-ship.cancelled-before-dispatch.v1",
                    request: pick(effect.request, ["repository", "source", "input_digest"]),
                    kind: effect.request.kind,
                    authority: pick(
                      next.authority,
                      ["installation", "generation", "revision", "controller"],
                    ),
                    mode: mode,
                  },
                ),
              ),
            }
        } else if unresolved_effect(effect) {
          effect + {status: "unknown"}
        } else {
          effect
        }
      },
    )
  }
  return Ok(next)
}

/** Record the measured attempt cost; only later verified source can resolve the incident. */
pub fn finish_repair(
  state: Controller,
  fence: Fence,
  id: string,
  owner: string,
  attempt: int,
  spent_usd: float?,
) -> Result<Controller, string> {
  if !authorized(state, fence)
    || (spent_usd != nil && (is_nan(spent_usd) || is_infinite(spent_usd) || spent_usd < 0.0)) {
    return Err("repair completion authority or measured cost is invalid")
  }
  const incident = state.incidents.find({ item -> item.id == id })
  if incident == nil || len(incident.attempts) != attempt || attempt <= 0 {
    return Err("repair completion belongs to a stale attempt")
  }
  const claimed = incident.attempts[attempt - 1]
  if claimed == nil || claimed.owner != owner || claimed.status != "active" {
    return Err("repair completion belongs to a stale attempt")
  }
  let next = advance(state)
  next.incidents = state.incidents.map(
    { item ->
      if item.id != id {
        item
      } else {
        item
          + {
            attempts: item.attempts.map(
              { record ->
                if record == claimed {
                  record
                    + {
                      spent_usd: spent_usd,
                      status: if spent_usd == nil {
                        "unknown"
                      } else {
                        "settled"
                      },
                    }
                } else {
                  record
                }
              },
            ),
          }
      }
    },
  )
  return Ok(next)
}

/** The controller owns drain and policy-change barriers for every durable generation transfer. */
pub fn transfer_ready(state: Controller, next_policy_digest: string) -> bool {
  return is_digest(next_policy_digest) && state.authority.mode == "draining"
    && writer_handoff_retired(state.authority)
    && state.active == nil
    && state.pending == nil
    && !state.effects.any(unresolved_effect)
    && !state.incidents.any(
      { item -> item.attempts.any({ attempt -> attempt.status == "active" }) },
    )
    && (next_policy_digest == state.authority.policy_digest
      || !state.incidents.any({ item -> !item.resolved }))
}

/** A verified transfer invalidates old controllers even when their local leases remain live. */
pub fn transfer(
  state: Controller,
  fence: Fence,
  controller: string,
  next_policy: Policy? = nil,
) -> Result<Controller, string> {
  if next_policy != nil
    && (next_policy.installation != state.authority.installation
      || len(policy_errors(next_policy)) > 0) {
    return Err("next generation policy is invalid or belongs to another installation")
  }
  const next_digest = if next_policy == nil {
    state.authority.policy_digest
  } else {
    policy_digest(next_policy)
  }
  if !authorized(state, fence) || controller == "" || !transfer_ready(state, next_digest) {
    return Err("old mutation owners or admitted work have not drained for this policy")
  }
  let next = advance(state)
  next.authority.generation += 1
  next.authority.controller = controller
  next.authority.policy = next_policy ?? state.authority.policy
  next.authority.policy_digest = next_digest
  next.authority.mode = "shadow"
  return Ok(next)
}
