import { review_admission, review_policy_errors } from "./admission"
import {
  admission_bytes,
  execution_bytes,
  is_digest,
  is_git_id,
  policy_digest,
  prepare_admission,
  requirement_identity,
  scope_bytes,
  snapshot_plan,
  source_identity,
  verification_request,
} from "./identity"
import { ReviewAdmission } from "./review"
import {
  AdmissionRecord,
  AdmissionRequest,
  AdmissionRule,
  AdmissionVerification,
  Execution,
  Policy,
  Proof,
  Requirement,
  SignedAdmission,
  Snapshot,
  Verification,
  VerificationPlan,
  VerifierKey,
} from "./types"

fn duplicate(values: list<string>) -> bool {
  return values.any({ value -> len(values.filter({ other -> other == value })) > 1 })
}

fn requirement_valid(requirement: Requirement) -> bool {
  return requirement.id != "" && requirement.repository != "" && requirement.trust_domain != ""
    && is_digest(requirement.execution_request)
    && is_digest(requirement.input_digest)
    && is_digest(requirement.runtime_digest)
    && is_digest(requirement.environment_digest)
    && is_digest(requirement.coverage_digest)
    && !duplicate(requirement.artifacts)
    && !requirement.artifacts.contains("")
}

fn key_inventory_valid(keys: list<VerifierKey>) -> bool {
  return len(keys) > 0 && !duplicate(keys.map({ key -> key.id }))
    && keys.all(
      { key ->
        key.id != "" && key.trust_domain != ""
          && regex_match("^[0-9a-f]{64}$", key.public_key) != nil
      },
    )
}

fn policy_budget_errors(policy: Policy) -> list<string> {
  let errors: list<string> = []
  if policy.max_changes < 1 || policy.max_unverified_ms < 1
    || policy.max_repair_attempts < 0
    || policy.max_repair_usd < 0.0
    || is_nan(policy.max_repair_usd)
    || is_infinite(policy.max_repair_usd) {
    errors = errors + ["work and repair budgets are invalid"]
  }
  if type_of(policy.max_repair_usd) == "int" {
    const floating = to_float(policy.max_repair_usd)
    // Check the signed-integer ceiling before conversion, whose saturation
    // would otherwise make i64::MAX appear to round-trip successfully.
    if floating >= 9223372036854776000.0 || to_int(floating) != policy.max_repair_usd {
      errors = errors + ["repair budget integer cannot be represented exactly as a float"]
    }
  }
  return errors
}

/** Validate installation policy before accepting any submitted work. */
pub fn policy_errors(policy: Policy) -> list<string> {
  let errors: list<string> = []
  if policy.installation == "" || len(policy.repositories) == 0
    || policy.repositories.contains("")
    || duplicate(policy.repositories) {
    errors = errors + ["installation and unique repositories are required"]
  }
  errors = errors + policy_budget_errors(policy)
  for inventory in [
    {role: "executor", keys: policy.verifier_keys},
    {role: "checkpoint", keys: policy.checkpoint_keys},
    {role: "scope", keys: policy.scope_keys},
    {role: "admission", keys: policy.admission_keys},
  ] {
    if !key_inventory_valid(inventory.keys) {
      errors = errors + ["invalid signing keys: " + inventory.role]
    }
  }
  if len(policy.admission_rules) == 0
    || duplicate(policy.admission_rules.map({ rule -> rule.id })) {
    errors = errors + ["unique admission rules are required"]
  }
  for rule in policy.admission_rules {
    if rule.id == "" || !policy.repositories.contains(rule.repository)
      || rule.repository_id == ""
      || trim(rule.base_branch) == ""
      || rule.scope_trust_domain == ""
      || len(review_policy_errors(rule.review)) > 0
      || !policy.scope_keys.any({ key -> key.trust_domain == rule.scope_trust_domain }) {
      errors = errors + ["invalid admission rule: " + rule.id]
    }
  }
  if policy.repositories.any(
    { repository -> !policy.admission_rules.any({ rule -> rule.repository == repository }) },
  ) {
    errors = errors + ["repository admission rule is missing"]
  }
  if !policy.admission_keys.any({ key -> key.trust_domain == policy.installation }) {
    errors = errors + ["installation admission issuer is missing"]
  }
  return errors
}

fn coverage_errors(snapshot: VerificationPlan, policy: Policy) -> list<string> {
  let errors: list<string> = []
  if !snapshot.inventory_complete || len(snapshot.requirements) == 0 {
    errors = errors + ["required job inventory is incomplete or empty"]
  }
  if len(snapshot.sources) == 0
    || duplicate(snapshot.sources.map({ source -> source.repository })) {
    errors = errors + ["source inventory is incomplete or duplicated"]
  }
  for source in snapshot.sources {
    if !policy.repositories.contains(source.repository)
      || !is_git_id(source.commit)
      || !is_git_id(source.tree) {
      errors = errors + ["invalid source: " + source.repository]
    }
    if !snapshot.requirements.any({ requirement -> requirement.repository == source.repository }) {
      errors = errors + ["uncovered source: " + source.repository]
    }
  }
  const repositories = snapshot.sources.map({ source -> source.repository })
  const frontier = snapshot.frontier
  if snapshot.installation != policy.installation || !is_digest(frontier) {
    errors = errors + ["verification installation or frontier differs"]
  }
  if duplicate(snapshot.requirements.map({ requirement -> requirement.id })) {
    errors = errors + ["required job inventory contains duplicates"]
  }
  for requirement in snapshot.requirements {
    if !requirement_valid(requirement) || !repositories.contains(requirement.repository)
      || !policy.verifier_keys.any({ key -> key.trust_domain == requirement.trust_domain })
      || requirement.execution_request != verification_request(frontier, requirement.id) {
      errors = errors + ["invalid required job: " + requirement.id]
    }
  }
  return errors
}

fn change_errors(snapshot: Snapshot, policy: Policy) -> list<string> {
  let errors: list<string> = []
  const repositories = snapshot.sources.map({ source -> source.repository })
  if len(snapshot.changes) > policy.max_changes
    || duplicate(snapshot.changes.map({ change -> change.id })) {
    errors = errors + ["change inventory exceeds its budget or contains duplicates"]
  }
  for change in snapshot.changes {
    if change.id == "" || !repositories.contains(change.repository) || !is_git_id(change.head)
      || !is_git_id(change.integrated_commit)
      || change.admission.record.source.change != change.id
      || change.admission.record.source.repository != change.repository
      || change.admission.record.source.head != change.head
      || change.admission.record.admitted_at_ms > snapshot.created_at_ms {
      errors = errors + ["invalid admitted change: " + change.id]
    }
    const admission = qualify_admission(change.admission, policy)
    if admission.status != "admitted" {
      errors = errors + ["unqualified admission: " + change.id]
      const review = admission.review
      const reasons = admission.invalid + admission.checks.invalid + admission.checks.pending
        + admission.checks.failed
        + admission.checks.infrastructure_failed
        + if review == nil {
          []
        } else {
          review.invalid + review.pending + review.failed
        }
      errors = errors + reasons.map({ reason -> "admission:" + change.id + ":" + reason })
    }
  }
  return errors
}

fn snapshot_errors(snapshot: Snapshot, policy: Policy) -> list<string> {
  let errors = policy_errors(policy) + change_errors(snapshot, policy)
  if snapshot.installation != policy.installation
    || snapshot.policy_digest != policy_digest(policy) {
    errors = errors + ["snapshot policy or installation differs"]
  }
  if snapshot.sequence < 1 || snapshot.generation < 1 || snapshot.created_at_ms < 0 {
    errors = errors + ["snapshot sequence, generation, or time is invalid"]
  }
  return errors
}

fn tests_valid(original: Execution) -> bool {
  const tests = original.tests
  if tests != nil
    && (!is_digest(tests.report_digest) || tests.total < 0
      || tests.passed < 0
      || tests.failed < 0
      || tests.skipped < 0
      || tests.total != tests.passed + tests.failed + tests.skipped) {
    return false
  }
  if original.requirement.kind == "tests" && original.result == "passed" {
    return tests != nil && tests.passed > 0 && tests.failed == 0
  }
  if original.result == "passed" && tests != nil && tests.failed > 0 {
    return false
  }
  return true
}

fn provenance_valid(original: Execution) -> bool {
  return original.run != "" && original.attempt > 0 && original.job != ""
    && is_digest(original.requirement.execution_request)
    && original.source.repository == original.requirement.repository
    && is_git_id(original.source.commit)
    && is_git_id(original.source.tree)
    && is_digest(original.log_digest)
    && tests_valid(original)
    && original.started_at_ms >= 0
    && original.completed_at_ms >= original.started_at_ms
    && !duplicate(original.artifacts.map({ artifact -> artifact.name }))
    && original.artifacts.all({ artifact -> artifact.name != "" && is_digest(artifact.digest) })
    && (original.result != "passed"
      || original.requirement.artifacts.all(
        { name -> original.artifacts.any({ artifact -> artifact.name == name }) },
      ))
}

fn signature_valid(
  signed: {signer: string, signature: string},
  bytes: string,
  keys: list<VerifierKey>,
  domain: string,
) -> bool {
  const key = keys.find({ candidate -> candidate.id == signed.signer })
  if key == nil || key.trust_domain != domain {
    return false
  }
  const authenticated = try {
    ed25519_verify(key.public_key, bytes, signed.signature)
  }
  return is_ok(authenticated) && unwrap(authenticated)
}

fn proof_valid(
  proof: Proof,
  requirement: Requirement,
  snapshot: VerificationPlan,
  policy: Policy,
) -> bool {
  const original = proof.original
  if original.installation != policy.installation || !provenance_valid(original)
    || requirement_identity(original.requirement) != requirement_identity(requirement)
    || (proof.mode == "reused" && !requirement.reuse_allowed)
    || proof.mode == "executed"
      != (original.requirement.execution_request == requirement.execution_request) {
    return false
  }
  if !signature_valid(
    proof,
    execution_bytes(original),
    policy.verifier_keys,
    requirement.trust_domain,
  ) {
    return false
  }
  const source = snapshot.sources.find(
    { candidate -> candidate.repository == requirement.repository },
  )
  return proof.mode == "reused"
    || (source != nil && source_identity(original.source) == source_identity(source))
}

fn verify_plan(
  snapshot: VerificationPlan,
  proofs: list<Proof>,
  policy: Policy,
  initial_errors: list<string>,
) -> Verification {
  let invalid = initial_errors + coverage_errors(snapshot, policy)
  let pending: list<string> = []
  let failed: list<string> = []
  let infrastructure_failed: list<string> = []
  let executed = 0
  let reused = 0
  for proof in proofs {
    if !snapshot.requirements.any({ requirement -> requirement.id == proof.requirement }) {
      invalid = invalid + ["unknown proof: " + proof.requirement]
    }
  }
  for requirement in snapshot.requirements {
    const matches = proofs.filter({ proof -> proof.requirement == requirement.id })
    const proof = matches[0]
    if len(matches) == 0 {
      pending = pending + [requirement.id]
    } else if proof == nil || len(matches) != 1
      || !proof_valid(proof, requirement, snapshot, policy) {
      invalid = invalid + [requirement.id]
    } else {
      if proof.mode == "executed" {
        executed = executed + 1
      } else {
        reused = reused + 1
      }
      if proof.original.result == "failed" {
        failed = failed + [requirement.id]
      } else if proof.original.result == "infrastructure_failed" {
        infrastructure_failed = infrastructure_failed + [requirement.id]
      } else if proof.original.result == "cancelled" {
        pending = pending + [requirement.id]
      }
    }
  }
  const status = if len(invalid) > 0 {
    "invalid"
  } else if len(failed) > 0 || len(infrastructure_failed) > 0 {
    "failed"
  } else if len(pending) > 0 {
    "pending"
  } else {
    "verified"
  }
  return {
    status: status,
    required: len(snapshot.requirements),
    executed: executed,
    reused: reused,
    pending: pending,
    failed: failed,
    infrastructure_failed: infrastructure_failed,
    invalid: invalid,
  }
}

fn admission_time_errors(record: AdmissionRecord) -> list<string> {
  let invalid: list<string> = []
  if record.admitted_at_ms < 0
    || record.proofs.any({ proof -> proof.original.completed_at_ms > record.admitted_at_ms }) {
    invalid = invalid + ["admission-time"]
  }
  for row in record.reviews.reviews {
    for value in [row.submitted_at, row.updated_at] {
      if value != nil {
        const observed = try {
          date_parse(value)
        }
        if is_err(observed) || unwrap(observed) * 1000 > record.admitted_at_ms {
          invalid = invalid + ["review-after-admission:" + row.id]
        }
      }
    }
  }
  return invalid
}

/** Compare submitted policy provenance with an independently selected installation policy. */
pub fn admission_policy_matches(request: AdmissionRequest, policy: Policy) -> bool {
  return len(policy_errors(policy)) == 0 && len(policy_errors(request.policy)) == 0
    && request.installation == policy.installation
    && request.policy_digest == policy_digest(policy)
    && policy_digest(request.policy) == request.policy_digest
}

type AdmissionAuthentication = {rule: AdmissionRule?, invalid: list<string>}

fn authenticate_record(
  record: AdmissionRecord,
  policy: Policy,
  initial_errors: list<string>,
) -> AdmissionAuthentication {
  const scope = record.scope.scope
  const rule = policy.admission_rules.find({ candidate -> candidate.id == scope.rule })
  let invalid = initial_errors + admission_time_errors(record)
  if !admission_policy_matches(record, policy) || scope.installation != record.installation
    || scope.policy_digest != record.policy_digest
    || scope.source.repository != record.source.repository
    || scope.reviewed_head != record.source.head
    || scope.reviewed_base != record.source.base
    || scope.reviewed_base_branch != record.source.base_branch {
    invalid = invalid + ["admission-source-or-policy"]
  }
  if rule == nil || rule.repository != record.source.repository {
    invalid = invalid + ["admission-rule"]
  } else {
    if rule.base_branch != record.source.base_branch {
      invalid = invalid + ["admission-target-binding"]
    }
    if rule.repository_id != record.source.base_repository_id {
      invalid = invalid + ["admission-repository-binding"]
    }
    const authenticated = signature_valid(
      record.scope,
      scope_bytes(scope),
      policy.scope_keys,
      rule.scope_trust_domain,
    )
    if !authenticated {
      invalid = invalid + ["scope-signature"]
    }
  }
  return {rule: rule, invalid: invalid}
}

fn assess_record(
  record: AdmissionRecord,
  policy: Policy,
  initial_errors: list<string>,
) -> AdmissionVerification {
  const authenticated = authenticate_record(record, policy, initial_errors)
  const rule = authenticated.rule
  const invalid = authenticated.invalid
  let review: ReviewAdmission? = nil
  if rule != nil {
    review = review_admission(record.source, rule.review, record.reviews)
  }
  const checks = verify_plan(prepare_admission(record), record.proofs, policy, [])
  const status = if len(invalid) > 0 || checks.status == "invalid"
    || (review != nil && review.status == "invalid") {
    "invalid"
  } else if checks.status == "failed"
    || (review != nil && review.status == "failed") {
    "failed"
  } else if review == nil || review.status == "pending"
    || checks.status == "pending" {
    "pending"
  } else {
    "admitted"
  }
  return {status: status, review: review, checks: checks, invalid: invalid}
}

/**
 * Assess current review and original CI evidence before reading an issuer key. This grants no authority.
 */
pub fn assess_admission(record: AdmissionRecord, policy: Policy) -> AdmissionVerification {
  return assess_record(record, policy, policy_errors(policy))
}

fn qualify_admission(signed: SignedAdmission, policy: Policy) -> AdmissionVerification {
  const errors = if signature_valid(
    signed,
    admission_bytes(signed.record),
    policy.admission_keys,
    policy.installation,
  ) {
    []
  } else {
    ["admission-signature"]
  }
  return assess_record(signed.record, policy, errors)
}

/** Judge signed admission through the same original-execution verifier used for grouped work. */
pub fn verify_admission(signed: SignedAdmission, policy: Policy) -> AdmissionVerification {
  const result = qualify_admission(signed, policy)
  const errors = policy_errors(policy)
  return if len(errors) == 0 {
    result
  } else {
    result + {status: "invalid", invalid: result.invalid + errors}
  }
}

/** Judge every required grouped job and every inspectable signed admission record. */
pub fn verify(snapshot: Snapshot, proofs: list<Proof>, policy: Policy) -> Verification {
  return verify_plan(snapshot_plan(snapshot), proofs, policy, snapshot_errors(snapshot, policy))
}
