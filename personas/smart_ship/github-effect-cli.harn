import {
  GithubAdmissionConfiguration,
  GithubAdmissionDispatch,
  GithubAdmissionSubmission,
  submit_github_admission,
} from "./lib/github_effect"

/** Execute the command's file and schema boundary through the same host capabilities as the CLI. */
pub fn run_github_effect_command(harness: Harness, args: list<string>) -> GithubAdmissionDispatch {
  require len(args) == 2, "pass trusted configuration and signed submission files"
  const settings = harness.fs.read_text(args[0]!)
  const payload = harness.fs.read_text(args[1]!)
  require len(settings) <= 1048576 && len(payload) <= 16777216,
    "admission input exceeds its size limit"
  const configuration: GithubAdmissionConfiguration = schema_expect(
    json_parse(settings),
    schema_of(GithubAdmissionConfiguration),
  )
  const submission: GithubAdmissionSubmission = schema_expect(
    json_parse(payload),
    schema_of(GithubAdmissionSubmission),
  )
  return submit_github_admission(harness, configuration, submission)
}

fn main(harness: Harness) {
  harness.stdio.println(json_stringify(run_github_effect_command(harness, argv)))
}
