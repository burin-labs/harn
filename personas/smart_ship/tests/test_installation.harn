import { assert_error_contains } from "std/testing"
import { run_installation_command } from "../cli"
import { git } from "../fixtures/neutral"
import { execution, fixture, proof } from "../fixtures/support"
import {
  ControllerArtifact,
  Installation,
  commit_state,
  complete,
  control,
  controller_artifact,
  initialize_installation,
  inspect_installation,
  load_installation,
  offer,
  prepare_state,
  read_state,
  start,
} from "../lib/main"

pipeline test_installation_starts_in_shadow_and_inspects_archived_checkpoint_policy(
  harness: Harness,
) {
  const root = harness.fs.mkdtemp_in_workspace("smart-ship-installation-")
  defer {
    harness.fs.delete(root)
  }
  const remote = path_join(root, "remote.git")
  const workspace = path_join(root, "controller.git")
  git(harness.process, root, ["init", "--bare", "--quiet", remote])
  git(harness.process, root, ["init", "--bare", "--quiet", workspace])
  git(harness.process, workspace, ["config", "user.name", "Smart Ship Fixture"])
  git(harness.process, workspace, ["config", "user.email", "fixture@example.invalid"])
  const f = fixture(harness.random)
  const config: Installation = {
    schema: "smart-ship.installation.v1",
    writer_enrollment: nil,
    policy: f.policy,
    controller: controller_artifact(pick(harness, ["env", "fs", "process"])).digest,
    store: {
      workspace: workspace,
      remote: remote,
      ref: "refs/heads/smart-ship-state",
      timeout_ms: 10000,
      signed_commits: false,
    },
  }
  const path = path_join(root, "installation.json")
  harness.fs.write_text(path, json_stringify(config))
  assert_eq(load_installation(harness.fs, path), config)
  const initialized = initialize_installation(harness.process, config)
  assert(initialized.state != nil)
  assert_eq(initialized.state.authority.mode, "shadow")
  assert_eq(inspect_installation(harness.process, config).verification, nil)
  assert_eq(initialize_installation(harness.process, config), initialized)
  const state = initialized.state
  const active = unwrap(
    control(
      state,
      pick(state.authority, ["installation", "generation", "revision", "controller"]),
      "active",
    ),
  )
  const admitted = unwrap(
    offer(
      active,
      pick(active.authority, ["installation", "generation", "revision", "controller"]),
      f.snapshot,
      f.policy,
      1000,
    ),
  )
  const running = unwrap(
    start(
      admitted,
      pick(admitted.authority, ["installation", "generation", "revision", "controller"]),
    ),
  )
  const settled = unwrap(
    complete(
      running,
      pick(running.authority, ["installation", "generation", "revision", "controller"]),
      f.snapshot,
      [proof(f, execution(f))],
      f.policy,
    ),
  )
  for next in [active, admitted, running, settled] {
    const previous = read_state(harness.process, config.store)
    assert_eq(
      commit_state(
        harness.process,
        config.store,
        prepare_state(harness.process, config.store, previous, next),
      ).status,
      "committed",
    )
  }
  const later = fixture(harness.random)
  const changed = config
    + {policy: f.policy + {verifier_keys: later.policy.verifier_keys, max_changes: 20}}
  const view = inspect_installation(harness.process, changed)
  assert_eq(view.verification?.status, "verified")
  assert_eq(view.verification?.required, 1)
  assert_eq(view.verification?.executed, 1)
  assert_error_contains(
    fn() { initialize_installation(harness.process, changed) },
    "policy changed without a fenced generation transfer",
  )
  assert_eq(initialize_installation(harness.process, config).state, settled)
  assert_eq(inspect_installation(harness.process, config).checkpoint, view.checkpoint)
}

@heavy(threads: 4)
pipeline test_installed_replacement_fences_the_old_controller_and_resumes(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("smart-ship-cutover-")
  defer {
    harness.fs.delete(root)
  }
  const remote = path_join(root, "remote.git")
  const workspace = path_join(root, "controller.git")
  git(harness.process, root, ["init", "--bare", "--quiet", remote])
  git(harness.process, root, ["init", "--bare", "--quiet", workspace])
  git(harness.process, workspace, ["config", "user.name", "Smart Ship Fixture"])
  git(harness.process, workspace, ["config", "user.email", "fixture@example.invalid"])
  const f = fixture(harness.random)
  const config: Installation = {
    schema: "smart-ship.installation.v1",
    writer_enrollment: nil,
    policy: f.policy,
    controller: controller_artifact(pick(harness, ["env", "fs", "process"])).digest,
    store: {
      workspace: workspace,
      remote: remote,
      ref: "refs/heads/smart-ship-state",
      timeout_ms: 10000,
      signed_commits: false,
    },
  }
  const path = path_join(root, "installation.json")
  harness.fs.write_text(path, json_stringify(config))
  const settled = initialize_installation(harness.process, config).state!
  const later = fixture(harness.random)
  const changed = config
    + {policy: f.policy + {verifier_keys: later.policy.verifier_keys, max_changes: 20}}
  const binary = harness.env.get("HARN_BIN") ?? "harn"
  const replacement_root = path_join(root, "replacement")
  harness.stdio.println("installation phase: pack replacement")
  const packed = harness.process.run(
    {
      program: binary,
      args: [
        "package",
        "pack",
        path_join(harness.fs.source_dir(), ".."),
        "--output",
        replacement_root,
      ],
      timeout_ms: 30000,
    },
  )
  assert(packed.success && packed.exit_code == 0, packed.stderr)
  harness.stdio.println("installation phase: install replacement")
  const installed = harness.process.run(
    {program: binary, args: ["install", "--frozen"], cwd: replacement_root, timeout_ms: 30000},
  )
  assert(installed.success && installed.exit_code == 0, installed.stderr)
  harness.stdio.println("installation phase: measure replacement")
  const measured = harness.process.run(
    {
      program: binary,
      args: ["run", path_join(replacement_root, "artifact-cli.harn")],
      timeout_ms: 30000,
    },
  )
  assert(measured.success && measured.exit_code == 0, measured.stderr)
  const artifact: ControllerArtifact = json_decode(measured.stdout, schema_of(ControllerArtifact))?
  const controller = artifact.digest
  assert(
    controller != config.controller && artifact.files > 0,
    "the packed replacement must have its own measured artifact identity",
  )
  for request in [
    {action: "control", configuration: path, mode: "draining"},
    {
      action: "transfer",
      configuration: path,
      target_controller: controller,
      next_policy: changed.policy,
    },
  ] {
    harness.stdio.println("installation phase: " + request.action)
    run_installation_command(harness, [json_stringify(request)])
  }
  const replacement = changed + {controller: controller}
  harness.fs.write_text(path, json_stringify(replacement))
  const transferred = initialize_installation(harness.process, replacement).state!
  assert_eq(transferred.authority.policy, changed.policy)
  assert_eq(transferred.authority.generation, settled.authority.generation + 1)
  assert_eq(transferred.authority.mode, "shadow")
  const stale = try {
    run_installation_command(
      harness,
      [json_stringify({action: "control", configuration: path, mode: "active"})],
    )
  }
  assert(
    is_err(stale) && to_string(unwrap_err(stale)).contains("executing controller package differs"),
    "the already-running old controller must refuse its next command after transfer",
  )
  assert_eq(read_state(harness.process, config.store).state!.authority.mode, "shadow")
  harness.stdio.println("installation phase: resume replacement")
  const resumed = harness.process.run(
    {
      program: binary,
      args: [
        "run",
        "--write-root",
        root,
        path_join(replacement_root, "cli.harn"),
        "--",
        json_stringify({action: "control", configuration: path, mode: "active"}),
      ],
      timeout_ms: 30000,
    },
  )
  assert(resumed.success && resumed.exit_code == 0, resumed.stderr)
  assert_eq(read_state(harness.process, config.store).state!.authority.mode, "active")
}
