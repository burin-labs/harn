import { digest, execution, fixture, reviewed_request } from "../fixtures/support"
import {
  GithubCiArtifact,
  GithubCiJob,
  assess_github_ci,
  github_ci_identities,
} from "../lib/github_ci"
import {
  AdmissionRequest,
  admission_bytes,
  execution_bytes,
  prepare_admission,
  verify_admission,
} from "../lib/main"
import { ProducerPolicy, ProofSource, Run } from "burin-ci-checks/ci_job_proof"

const REPOSITORY = "acme/product"

const POLICY: ProducerPolicy = {
  repository: REPOSITORY,
  workflow: "verify.yml",
  events: ["workflow_dispatch"],
  registrarJob: "Prepare",
  registrarStep: "Register",
}

const JOBS: list<GithubCiJob> = [
  {
    id: "stock-tests",
    legs: [
      {
        requirement: "tests",
        name: "Test Python",
        artifact_name: "python-result",
        member_name: "result.json",
      },
    ],
  },
]

type CiFixture = {
  request: AdmissionRequest,
  producer: Run,
  registration: dict,
  census: list<dict>,
  artifacts: list<GithubCiArtifact>,
  private_key: string,
}

fn ci_fixture(random: HarnessRandom) -> CiFixture {
  const f = fixture(random)
  const policy = f.policy
    + {
      repositories: [REPOSITORY],
      admission_rules: f.policy.admission_rules.map({ rule -> rule + {repository: REPOSITORY} }),
    }
  const original = execution(f)
    + {
      source: {repository: REPOSITORY, commit: "a".repeat(40), tree: "b".repeat(40)},
      requirement: execution(f).requirement
        + {repository: REPOSITORY, kind: "tests", reuse_allowed: false},
      run: "10",
      attempt: 2,
      job: "tests",
      log_digest: digest(json_stringify(["two tests passed", "", 0])),
      tests: {
        report_digest: digest("actual fixture junit"),
        total: 2,
        passed: 2,
        failed: 0,
        skipped: 0,
      },
      started_at_ms: 4500,
      completed_at_ms: 5000,
    }
  const request = reviewed_request(policy, f.private_key, {id: "7", base: "c".repeat(40)}, original)
  const executed = original + {requirement: prepare_admission(request).requirements[0]!}
  const run = {
    proof: {
      requirement: "tests",
      mode: "executed",
      original: executed,
      signer: "executor",
      signature: ed25519_sign(f.private_key, execution_bytes(executed)),
    },
    stdout: "two tests passed",
    stderr: "",
    exit_code: 0,
  }
  const producer: Run = {
    id: 10,
    run_attempt: 2,
    head_sha: "d".repeat(40),
    event: "workflow_dispatch",
    path: ".github/workflows/verify.yml",
    status: "completed",
    conclusion: "success",
    repository: {full_name: REPOSITORY},
    head_repository: {full_name: REPOSITORY},
  }
  const row = {
    run_id: 10,
    run_attempt: 2,
    head_sha: producer.head_sha,
    status: "completed",
    conclusion: "success",
    steps: [{name: "Register", status: "completed", conclusion: "success"}],
  }
  return {
    private_key: f.private_key,
    request: request,
    producer: producer,
    registration: {
      schema: "burin.ci_job_proof_registration.v3",
      repository: REPOSITORY,
      workflow: "verify.yml",
      event: producer.event,
      commit: producer.head_sha,
      runId: 10,
      attempt: 2,
      registrarJob: "Prepare",
      registrarStep: "Register",
      tested_source: {commit: executed.source.commit, tree: executed.source.tree},
      jobs: github_ci_identities(request, JOBS).map({ identity -> identity + {provenance: nil} }),
    },
    census: [
      row
        + {
          id: 100,
          name: "Prepare",
          started_at: "1970-01-01T00:00:01Z",
          completed_at: "1970-01-01T00:00:02Z",
        },
      row
        + {
          id: 101,
          name: "Test Python",
          started_at: "1970-01-01T00:00:04Z",
          completed_at: "1970-01-01T00:00:06Z",
        },
    ],
    artifacts: [
      {
        requirement: "tests",
        result: Ok(
          {
            repo: REPOSITORY,
            run_id: 10,
            run_name: "Verify",
            run_head_sha: producer.head_sha,
            workflow_id: 1,
            run_attempt: 2,
            run_event: producer.event,
            run_status: "completed",
            run_conclusion: "success",
            artifact_id: 201,
            artifact_name: "python-result",
            artifact_total_count: 2,
            artifact_pages_fetched: 1,
            artifact_expires_at: "2099-01-01T00:00:00Z",
            artifact_digest: digest("archive bytes"),
            archive_size_bytes: 300,
            archive_sha256: sha256_hex("archive bytes"),
            member_name: "result.json",
            member_size_bytes: len(json_stringify(run)),
            member_sha256: sha256_hex(json_stringify(run)),
            data: run,
          },
        ),
      },
    ],
  }
}

fn source(f: CiFixture, declared: int = 2) -> ProofSource {
  return {
    json: fn(endpoint) {
      if endpoint == "/repos/acme/product/actions/runs/10/artifacts?per_page=100&page=1" {
        return {
          total_count: 1,
          artifacts: [
            {
              id: 200,
              name: "ci-job-inputs-10-2",
              size_in_bytes: 100,
              expired: false,
              digest: digest("registration archive"),
              created_at: "1970-01-01T00:00:03Z",
              workflow_run: {id: 10, head_sha: f.producer.head_sha},
            },
          ],
        }
      }
      require endpoint == "/repos/acme/product/actions/runs/10/attempts/2/jobs?per_page=30&page=1",
        "unexpected fixture endpoint"
      return {total_count: declared, jobs: f.census}
    },
    registration: fn(_repo, _artifact) { return f.registration },
  }
}

pipeline test_original_ci_retains_actual_tested_source_and_job_then_signs_same_assessment(
  harness: Harness,
) {
  const f = ci_fixture(harness.random)
  const actual = assess_github_ci(source(f), POLICY, f.producer, f.request, JOBS, f.artifacts, 7000)
  assert_eq(actual.assessment.status, "admitted")
  assert_eq(actual.assessment.checks.required, 1)
  assert_eq(actual.assessment.checks.executed, 1)
  assert_eq(actual.assessment.checks.reused, 0)
  assert_eq(actual.assessment.checks.pending, [])
  assert_eq(actual.assessment.review!.observed_reviews, 1)
  assert_eq(actual.inspection.census.declared, 2)
  assert_eq(actual.inspection.admission.admitted[0]!.jobIds, [101])
  assert(actual.inspection.producer.head_sha != actual.record.scope.scope.source.commit)
  const signed = {
    record: actual.record,
    signer: "admitter",
    signature: ed25519_sign(f.private_key, admission_bytes(actual.record)),
  }
  assert_eq(verify_admission(signed, f.request.policy), actual.assessment)
  const replay = assess_github_ci(
    source(f),
    POLICY,
    f.producer,
    f.request,
    JOBS,
    actual.artifacts,
    7000,
  )
  assert_eq(replay, actual)
}

pipeline test_green_provider_job_without_structured_execution_stays_pending(harness: Harness) {
  const f = ci_fixture(harness.random)
  const actual = assess_github_ci(source(f), POLICY, f.producer, f.request, JOBS, [], 7000)
  assert_eq(actual.assessment.status, "pending")
  assert_eq(actual.assessment.checks.required, 1)
  assert_eq(actual.assessment.checks.executed, 0)
  assert_eq(actual.assessment.checks.pending, ["tests"])
}

pipeline test_current_review_and_head_remain_required_after_original_ci_passes(harness: Harness) {
  const f = ci_fixture(harness.random)
  const waiting = f.request
    + {
      reviews: f.request.reviews
        + {declared_reviews: 0, reviews: [], platform_decision: "review_required"},
    }
  const pending = assess_github_ci(source(f), POLICY, f.producer, waiting, JOBS, f.artifacts, 7000)
  assert_eq(pending.assessment.status, "pending")
  assert_eq(pending.assessment.checks.executed, 1)
  assert_eq(pending.assessment.checks.pending, [])
  assert_eq(pending.assessment.review!.observed_reviews, 0)
  const moved = f.request + {source: f.request.source + {head: "e".repeat(40)}}
  const invalid = assess_github_ci(source(f), POLICY, f.producer, moved, JOBS, f.artifacts, 7000)
  assert_eq(invalid.assessment.status, "invalid")
  assert(invalid.assessment.invalid.contains("admission-source-or-policy"))
}

pipeline test_actual_result_signature_and_exact_provider_attempt_are_required(harness: Harness) {
  const f = ci_fixture(harness.random)
  const receipt = unwrap(f.artifacts[0]!.result)
  const forged = receipt + {data: receipt.data + {proof: receipt.data.proof + {signature: ""}}}
  const invalid = assess_github_ci(
    source(f),
    POLICY,
    f.producer,
    f.request,
    JOBS,
    [{requirement: "tests", result: Ok(forged)}],
    7000,
  )
  assert_eq(invalid.assessment.status, "invalid")
  assert_eq(invalid.assessment.checks.invalid, ["tests"])
  for altered in [
    receipt + {run_attempt: 1},
    receipt + {run_id: 11},
    receipt + {run_head_sha: "e".repeat(40)},
    receipt + {data: receipt.data + {stdout: "replaced log"}},
    receipt + {data: receipt.data + {proof: receipt.data.proof + {mode: "reused"}}},
  ] {
    assert(
      is_err(
        try {
          assess_github_ci(
            source(f),
            POLICY,
            f.producer,
            f.request,
            JOBS,
            [{requirement: "tests", result: Ok(altered)}],
            7000,
          )
        },
      ),
    )
  }
}

pipeline test_wrong_workflow_source_mixed_census_and_poisoned_reuse_cannot_admit(harness: Harness) {
  const f = ci_fixture(harness.random)
  for changed in [
    f + {producer: f.producer + {path: ".github/workflows/other.yml"}},
    f
      + {
        registration: f.registration
          + {tested_source: {commit: "e".repeat(40), tree: "b".repeat(40)}},
      },
    f + {census: f.census.map({ row -> row + {run_attempt: 1} })},
  ] {
    assert(
      is_err(
        try {
          assess_github_ci(
            source(changed),
            POLICY,
            changed.producer,
            changed.request,
            JOBS,
            changed.artifacts,
            7000,
          )
        },
      ),
    )
  }
  assert(
    is_err(
      try {
        assess_github_ci(source(f, 3), POLICY, f.producer, f.request, JOBS, f.artifacts, 7000)
      },
    ),
  )
  const poisoned = f
    + {
      registration: f.registration
        + {
          jobs: github_ci_identities(f.request, JOBS).map(
            { identity -> identity + {provenance: {runId: 9, attempt: 1}} },
          ),
        },
    }
  const actual = assess_github_ci(
    source(poisoned),
    POLICY,
    f.producer,
    f.request,
    JOBS,
    f.artifacts,
    7000,
  )
  assert_eq(actual.assessment.status, "pending")
  assert_eq(actual.assessment.checks.pending, ["tests"])
  assert_eq(
    actual.inspection.admission.deferred,
    [{id: "stock-tests", provenance: {runId: 9, attempt: 1}}],
  )
}
