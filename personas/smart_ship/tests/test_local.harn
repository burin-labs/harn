import { prepare_interaction } from "../fixtures/interaction"
import { STACKS, Stack, git, job, project } from "../fixtures/neutral"
import { fixture } from "../fixtures/support"
import {
  Controller,
  Fence,
  RepairPermit,
  bind_job,
  checkpoint_id,
  claim_repair,
  complete,
  execute_job,
  finish_repair,
  freeze_snapshot,
  local_lineage,
  offer,
  prepare_job,
  run_job,
  start,
  verify,
} from "../lib/main"

fn fence(state: Controller) -> Fence {
  return pick(state.authority, ["installation", "generation", "revision", "controller"])
}

@heavy(threads: 2)
pipeline test_python_combined_failure_holds_the_checkpoint_until_forward_repair(harness: Harness) {
  const stack = STACKS.find({ item -> item.name == "python" })
  if stack == nil {
    throw "Python fixture is missing"
  }
  interaction(harness, stack)
}

@heavy(threads: 2)
pipeline test_typescript_combined_failure_holds_the_checkpoint_until_forward_repair(
  harness: Harness,
) {
  const stack = STACKS.find({ item -> item.name == "typescript" })
  if stack == nil {
    throw "TypeScript fixture is missing"
  }
  interaction(harness, stack)
}

fn interaction(harness: Harness, stack: Stack) {
  const scenario = prepare_interaction(harness, stack)
  const f = scenario.fixture
  const root = scenario.root
  defer {
    harness.fs.delete(root)
  }
  const local = pick(harness, ["clock", "fs", "process", "random", "system"])
  const signer = {id: "executor", private_key: f.private_key}
  const previous = checkpoint_id(scenario.checkpoint)
  const authority = scenario.authority
  const initial: Controller = {
    schema: "smart-ship.controller.v1",
    authority: authority,
    active: scenario.candidate,
    pending: nil,
    checkpoint: scenario.checkpoint,
    incidents: [],
    effects: [],
    unverified_since_ms: harness.clock.now_ms(),
  }
  const failed = unwrap(
    complete(initial, fence(initial), scenario.candidate, [scenario.combined.proof], f.policy),
  )
  assert_eq(failed.authority.previous_checkpoint, previous)
  const incident = failed.incidents[0]!
  const claimed = unwrap(
    claim_repair(
      failed,
      fence(failed),
      incident.id,
      "fixture",
      harness.clock.now_ms(),
      60000,
      1.0,
      f.policy,
    ),
  )
  const permit: RepairPermit = {
    installation: claimed.authority.installation,
    generation: claimed.authority.generation,
    controller: claimed.authority.controller,
    incident: incident.id,
    owner: "fixture",
    attempt: 1,
  }
  harness.fs.write_text(path_join(root, stack.capacity_path), stack.repair)
  git(harness.process, root, ["add", stack.capacity_path])
  git(harness.process, root, ["commit", "--quiet", "-m", "size capacity for active workers"])
  const repaired_plan = prepare_job(
    local,
    job(pick(harness, ["env", "system"]), stack, root, "repaired"),
  )
  const repaired_candidate = freeze_snapshot(
    scenario.candidate
      + {
        sequence: 3,
        origin: {kind: "repair", permit: permit},
        sources: [repaired_plan.source],
        requirements: [repaired_plan.requirement],
        created_at_ms: harness.clock.now_ms(),
      },
  )
  const admission_check = verify(repaired_candidate, [], f.policy)
  assert_eq(admission_check.invalid, [], json_stringify(admission_check))
  const accounted = unwrap(finish_repair(claimed, fence(claimed), incident.id, "fixture", 1, 0.0))
  const admitted = unwrap(
    offer(accounted, fence(accounted), repaired_candidate, f.policy, harness.clock.now_ms()),
  )
  const running = unwrap(start(admitted, fence(admitted)))
  assert_eq(running.active, repaired_candidate)
  const repaired = execute_job(local, bind_job(repaired_plan, repaired_candidate), signer)
  assert_eq(repaired.proof.original.result, "passed")
  const lineage = local_lineage(
    harness.process,
    root,
    repaired.proof.original.source,
    scenario.candidate.changes,
  )
  assert_eq(lineage.required, 2)
  assert_eq(lineage.checked, 2)
  assert_eq(lineage.missing, [])
  assert_eq(lineage.unknown, [])
  const original_a = scenario.candidate.changes[0]
  assert(original_a != nil)
  const missing = local_lineage(
    harness.process,
    root,
    repaired.proof.original.source,
    [original_a + {integrated_commit: original_a.head}],
  )
  assert_eq(missing.checked, 1)
  assert_eq(missing.missing, ["change-a"])
  const unknown = local_lineage(
    harness.process,
    root,
    repaired.proof.original.source,
    [original_a + {integrated_commit: sha256_hex("absent object")}],
  )
  assert_eq(unknown.checked, 0)
  assert_eq(unknown.unknown, ["change-a"])
  const settled = unwrap(
    complete(running, fence(running), repaired_candidate, [repaired.proof], f.policy),
  )
  assert(settled.checkpoint != nil)
  assert(checkpoint_id(settled.checkpoint) != previous)
  assert_eq(len(settled.incidents), 1)
  assert_eq(settled.incidents[0]?.resolved, true)
}

pipeline test_python_verification_cannot_read_controller_files(harness: Harness) {
  isolate(
    harness,
    "python",
    "test_capacity.py",
    "\n    def test_controller_file_is_denied(self):\n        with self.assertRaises(PermissionError):\n            open(os.environ['SMART_SHIP_FILE_CANARY']).read()\n",
  )
}

pipeline test_typescript_verification_cannot_read_controller_files(harness: Harness) {
  isolate(
    harness,
    "typescript",
    "test-capacity.ts",
    "\nimport { readFileSync } from 'node:fs';\ntest('controller file is denied', () => {\n  assert.throws(() => readFileSync(process.env.SMART_SHIP_FILE_CANARY!), (error: any) => error.code === 'EPERM' || error.code === 'EACCES');\n});\n",
  )
}

fn isolate(harness: Harness, name: string, test_path: string, probe: string) {
  const stack = STACKS.find({ item -> item.name == name })
  assert(stack != nil)
  const root = project(pick(harness, ["fs", "process"]), stack)
  const parent = harness.fs.mkdtemp_in_workspace("smart-ship-controller-")
  defer {
    harness.fs.delete(root)
    harness.fs.delete(parent)
  }
  const marker = path_join(parent, "nonsecret-marker.txt")
  harness.fs.write_text(marker, "harmless controller marker")
  assert_eq(harness.fs.read_text(marker), "harmless controller marker")
  const test_file = path_join(root, test_path)
  harness.fs.write_text(test_file, harness.fs.read_text(test_file) + probe)
  git(harness.process, root, ["add", test_path])
  git(harness.process, root, ["commit", "--quiet", "-m", "probe process file isolation"])
  const base = job(pick(harness, ["env", "system"]), stack, root, "isolation", 10)
  const request = base
    + {
      command: base.command
        + {environment: base.command.environment + {SMART_SHIP_FILE_CANARY: marker}},
    }
  const f = fixture(harness.random)
  const measured = run_job(
    pick(harness, ["clock", "fs", "process", "random", "system"]),
    request,
    {id: "executor", private_key: f.private_key},
  )
  assert_eq(measured.proof.original.result, "passed")
  assert_eq(measured.proof.original.tests?.passed, 5)
}
