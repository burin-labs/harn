pipeline default(harness: Harness, task) {
  // Test multiple bridge calls in sequence
  const file_content = harness.fs.read_text("README.md")
  harness.stdio.println("File: ${file_content}")
  const llm_response = harness.llm.call("Summarize this", "Be brief")
  harness.stdio.println("LLM: ${llm_response}")
  progress("done", "All bridge calls completed")
  harness.stdio.println("Success")
}
