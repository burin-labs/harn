pipeline default(task) {
  // Test multiple bridge calls in sequence
  const file_content = read_file("README.md")
  log("File: ${file_content}")
  const llm_response = llm_call("Summarize this", "Be brief")
  log("LLM: ${llm_response}")
  const host_result = host_call("get_repo_map", {})
  log("Host: ${host_result}")
  progress("done", "All bridge calls completed")
  log("Success")
}
