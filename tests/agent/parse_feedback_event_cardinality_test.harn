// Run: harn test tests/agent/parse_feedback_event_cardinality_test.harn
//
// A parse-repair turn injects one corrective directive into the transcript.
// Its observability stream must count that same logical injection exactly once.
import {
  agent_capture_events,
  agent_event_value,
  agent_feedback_injected_event_schema,
} from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

fn parse_feedback_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "add",
    "Add two integers.",
    {
      handler: { args -> args.left + args.right },
      parameters: {
        left: {type: "integer", description: "Left operand"},
        right: {type: "integer", description: "Right operand"},
      },
      returns: {type: "integer"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

pipeline test_parse_feedback_is_counted_once(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [llm_text("<tool_call>\nadd({ left: })\n</tool_call>"), llm_text("<done>##DONE##</done>")],
    { ->
      const session = "parse-feedback-cardinality-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: parse_feedback_tools(),
        tool_format: "text",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 3,
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Add the two numbers, then finish.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      let parse_guidance_events = 0
      let feedback_events = 0
      for event in captured.events {
        if event.type != "feedback_injected" {
          continue
        }
        feedback_events = feedback_events + 1
        const feedback = agent_event_value(event, agent_feedback_injected_event_schema())
        if feedback.kind == "parse_guidance" {
          parse_guidance_events = parse_guidance_events + 1
        }
      }
      assert_eq(parse_guidance_events, 1)
      assert_eq(feedback_events, 1)
      const corrective_directives = transcript_events_by_kind(
        captured.result.transcript,
        "system_reminder",
      )
        .filter(
          { event ->
            event?.reminder?.dedupe_key == "runtime_feedback/parse_guidance"
              && event?.reminder?.authority
                == "corrective"
          },
        )
        .to_list()
      assert_eq(len(corrective_directives), 1)
    },
  )
}

pipeline test_repeated_full_parse_rejection_enters_bounded_recovery(harness: Harness, task) {
  const malformed = llm_text("<tool_call>\nadd({ left: })\n</tool_call>")
  with_llm_script(
    harness.llm,
    [
      malformed,
      malformed,
      llm_text("<tool_call>\nadd({ left: 1, right: 2 })\n</tool_call>"),
      llm_text("<done>##DONE##</done>"),
    ],
    { ->
      const session = "parse-feedback-recovery-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: parse_feedback_tools(),
        tool_format: "text",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 5,
        stall_diagnostics: {
          enabled: true,
          repeat_parse_rejection: 2,
          inject_feedback: true,
          max_feedback: 1,
          hard_stop_after_trips: 3,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Add one and two, then finish.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert_eq(captured.result.tools.successful, ["add"])
      const warnings = captured.events.filter(
        { event ->
          event.type == "agent_loop_stall_warning"
            && event?.warning?.pattern
              == "repeated_parse_rejection"
        },
      )
      assert_eq(len(warnings), 1)
      const retry_messages = json_stringify(harness.llm.mock_calls()[2].messages)
      assert(contains(retry_messages, "Content repair"))
      assert(contains(retry_messages, "active tool format"))
    },
  )
}
