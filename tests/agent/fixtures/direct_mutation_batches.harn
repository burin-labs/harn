import { agent_loop } from "std/agent/loop"
import { __dispatch_call_tally } from "std/agent/loop_result_status"
import { AgentSpec } from "std/agent/options"
import { agent_tool_handler_result } from "std/agent/tool_lifecycle"
import { llm_text, with_llm_script } from "std/testing"

type DirectBatchCounts = {reads: int, writes: int, verifies: int, terminals: int}

fn assert_initial_dispatch(
  dispatch: list,
  variant: string,
  counts: DirectBatchCounts,
  proposed: int,
) -> nil {
  const tally = __dispatch_call_tally(dispatch)
  assert_eq(len(dispatch), proposed, "every call must receive one result")
  assert_eq(dispatch[0].tool_name, "edit_value", "results keep original call order")
  assert_eq(dispatch[0].dispatch_receipt.call_index, 0)
  assert_eq(counts.reads, 1)
  const applied = variant == "success" || variant == "later_phases"
  assert_eq(counts.writes, applied ? 1 : 0)
  assert_eq(counts.verifies, 0, "verification keeps its boundary")
  assert_eq(counts.terminals, 0, "completion keeps its boundary")
  if applied || variant == "denied" || variant == "mutation_failed" {
    assert_eq(dispatch[0].dispatch_receipt.reason, "mutation_after_observation")
    assert_eq(tally.attempted, 2, "the read and actual edit dispatch must be counted")
  } else if variant == "read_failed" {
    assert_eq(dispatch[0].dispatch_receipt.reason, "observation_failed")
    assert_eq(tally.attempted, 1, "the held edit is not an attempt")
  } else if variant == "inbox" {
    assert_eq(dispatch[0].dispatch_receipt.reason, "control_pending")
  }
}

/** Exercise fresh authored edits through the public loop and actual filesystem. */
pub fn assert_direct_mutation_batch(harness: Harness, variant: string) -> nil {
  const sid = "direct-mutation-${harness.random.uuid()}"
  const path = path_join(harness.fs.workspace_temp_dir(), "direct-${harness.random.uuid()}.txt")
  const reads = harness.runtime.atomic(0)
  const writes = harness.runtime.atomic(0)
  const verifies = harness.runtime.atomic(0)
  const terminals = harness.runtime.atomic(0)
  const later_phases = ["later_phases", "mutation_failed"].contains(variant)
  let tools = tool_define(
    tool_registry(),
    "read_evidence",
    "Read evidence independently of the authored edit.",
    {
      parameters: {},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { _args ->
        harness.runtime.atomic_add(reads, 1)
        assert(!harness.fs.exists(path), "observations must finish before a coissued edit")
        if variant == "read_failed" {
          return agent_tool_handler_result("Read failed.", {error: "unavailable"}, "error")
        }
        if variant == "injected" {
          harness.agent.inject(sid, {role: "user", content: "Use a new task instead."})
        }
        if variant == "inbox" {
          harness.agent.post_event(sid, "user_interrupt", "Pause this work.")
        }
        return "Evidence ready."
      },
    },
  )
  tools = tool_define(
    tools,
    "edit_value",
    "Apply the already-authored value.",
    {
      parameters: {path: {type: "string"}, value: {type: "string"}},
      annotations: {kind: "edit", side_effect_level: "workspace_write", path_params: ["path"]},
      handler: { args ->
        assert_eq(harness.runtime.atomic_get(reads), 1, "the observation must run first")
        if variant == "mutation_failed" {
          return agent_tool_handler_result(
            "Edit rejected.",
            {error: "edit_rejected", mutation_status: "not_applied"},
            "rejected",
          )
        }
        harness.fs.write_text(args.path, args.value)
        harness.runtime.atomic_add(writes, 1)
        return agent_tool_handler_result(
          "applied",
          {mutation_status: "applied", requires_repair_before_verify: false},
        )
      },
    },
  )
  if later_phases {
    tools = tool_define(
      tools,
      "verify",
      "Verify only after the mutation boundary.",
      {
        parameters: {},
        annotations: {
          kind: "execute",
          side_effect_level: "process_exec",
          completion_evidence_role: "verification",
        },
        handler: { _args -> harness.runtime.atomic_add(verifies, 1) },
      },
    )
    tools = tool_define(
      tools,
      "finish",
      "Finish after verification.",
      {
        parameters: {},
        annotations: {kind: "terminal"},
        handler: { _args -> harness.runtime.atomic_add(terminals, 1) },
      },
    )
  }
  let proposed = [
    {id: "fresh-edit", name: "edit_value", arguments: {path: path, value: "authored value"}},
    {id: "observe", name: "read_evidence", arguments: {}},
  ]
  if later_phases {
    proposed = proposed
      + [
        {id: "verify", name: "verify", arguments: {}},
        {id: "finish", name: "finish", arguments: {}},
      ]
  }
  let turn = 0
  let successful = 0
  let attempted = 0
  with_llm_script(
    harness.llm,
    [{tool_calls: proposed}],
    { ->
      const options: AgentSpec = {
        provider: "mock",
        session_id: sid,
        tools: tools,
        tool_format: "native",
        loop_until_done: true,
        max_iterations: 5,
        auto_compact: false,
        final_wrapup: false,
        tool_precheck: { call ->
          return variant == "denied" && call?.tool == "edit_value" ? {
            deny: true,
            model_cue: "The current policy refuses this edit.",
          } : nil
        },
        post_turn_callback: { info ->
          turn = turn + 1
          const tally = __dispatch_call_tally(info.dispatch)
          successful = successful + tally.succeeded
          attempted = attempted + tally.attempted
          if turn == 1 {
            assert_initial_dispatch(
              info.dispatch,
              variant,
              {
                reads: harness.runtime.atomic_get(reads),
                writes: harness.runtime.atomic_get(writes),
                verifies: harness.runtime.atomic_get(verifies),
                terminals: harness.runtime.atomic_get(terminals),
              },
              len(proposed),
            )
          }
          if variant == "mutation_failed" && turn == 2 {
            assert_eq(harness.runtime.atomic_get(verifies), 0)
            assert(
              info.dispatch.any({ item -> item?.status == "skipped_after_blocking_result" }),
              "confirmation must encounter the actual failed-mutation barrier",
            )
          }
          let next = []
          for item in info.dispatch ?? [] {
            if item?.status == "deferred" || item?.status == "skipped_after_blocking_result" {
              next.push(
                {
                  id: "resolve-${turn}-${len(next)}",
                  name: "__harn_resolve_tool_call",
                  arguments: {
                    proposal_id: item.dispatch_receipt.retained_proposal_id,
                    action: variant == "mutation_failed" && turn == 1
                      && item.tool_name == "verify" ? "resume" : "discard",
                  },
                },
              )
            }
          }
          harness.llm.mock_enqueue(
            len(next) > 0 ? {tool_calls: next} : llm_text("Finished. ##DONE##"),
          )
          return nil
        },
      }
      const result = agent_loop(
        harness,
        "Execute the authored independent calls, then report their results.",
        nil,
        options,
      )
      assert_eq(result.tools.successful.count, successful)
      assert_eq(result.tools.rejected.count, attempted - successful)
      assert_eq(result.trace.tool_executions, successful)
      assert_eq(result.trace.tool_rejections, attempted - successful)
      assert(!result.trace.tools_used.contains("__harn_resolve_tool_call"))
      if variant == "success" {
        assert_eq(len(harness.llm.mock_calls()), 2, "no confirmation response is needed")
      }
    },
  )
  if variant == "success" || variant == "later_phases" {
    assert_eq(harness.fs.read_text(path), "authored value")
  } else {
    assert(!harness.fs.exists(path), "failed or interrupted work must not write")
  }
}
