// Shared real-loop evidence for agent tests and the registered mechanism contract.
import {
  agent_capture_events,
  agent_event_report,
  agent_tool_batch_proposal_resolution_event_schema,
} from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { __dispatch_call_tally } from "std/agent/loop_result_status"
import { agent_session_post_event } from "std/agent/state"
import { agent_tool_handler_result } from "std/agent/tool_lifecycle"
import { __tool_registry_name } from "std/llm/call_shape"
import { llm_text, with_llm_script } from "std/testing"

const RESOLVE = "__harn_resolve_tool_call"

fn decision(id: string, proposal_id: string, action: string) -> dict {
  return {id: id, name: RESOLVE, arguments: {proposal_id: proposal_id, action: action}}
}

/** Drive a real retained confirmation into the existing failed-mutation barrier. */
pub fn assert_retained_mutation_barrier(harness: Harness) -> nil {
  const sid = "blocked-${harness.random.uuid()}"
  const checks = harness.runtime.atomic(0)
  const edits = harness.runtime.atomic(0)
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Reject an edit.",
    {
      parameters: {},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
      handler: { _args ->
        harness.runtime.atomic_add(edits, 1)
        return agent_tool_handler_result(
          "Edit rejected.",
          {error: "edit_rejected", mutation_status: "not_applied"},
          "rejected",
        )
      },
    },
  )
  tools = tool_define(
    tools,
    "verify",
    "Check the workspace.",
    {
      parameters: {},
      annotations: {
        kind: "execute",
        side_effect_level: "process_exec",
        completion_evidence_role: "verification",
      },
      handler: { _args ->
        harness.runtime.atomic_add(checks, 1)
        return "checked"
      },
    },
  )
  let turn = 0
  let attempts = 0
  const captured = agent_capture_events(
    harness.agent,
    sid,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              {id: "edit", name: "edit", arguments: {}},
              {id: "verify", name: "verify", arguments: {}},
            ],
          },
        ],
        { ->
          return agent_loop(
            harness,
            "Edit then verify.",
            nil,
            {
              provider: "mock",
              session_id: sid,
              tools: tools,
              tool_format: "native",
              loop_until_done: true,
              max_iterations: 2,
              final_wrapup: false,
              post_turn_callback: { info ->
                turn = turn + 1
                attempts = attempts + __dispatch_call_tally(info.dispatch).attempted
                assert_eq(
                  harness.runtime.atomic_get(checks),
                  0,
                  "confirmation cannot bypass a failed edit",
                )
                const retained = info.dispatch.find(
                  { result -> result?.dispatch_receipt?.retained_proposal_id != nil },
                )
                assert(
                  retained != nil,
                  "blocked verification must remain an explicit retained proposal",
                )
                const id = retained.dispatch_receipt.retained_proposal_id
                harness.llm.mock_enqueue({tool_calls: [decision("confirm-${turn}", id, "resume")]})
                return nil
              },
            },
          )
        },
      )
    },
  )
  assert_eq(turn, 2, "the confirmation must really reach the existing mutation barrier")
  assert_eq(harness.runtime.atomic_get(edits), 1)
  assert_eq(harness.runtime.atomic_get(checks), 0)
  assert_eq(attempts, 1, "blocked confirmations cannot become phantom failed attempts")
  assert_public_tool_outcomes(captured.result, {mutations: 1, attempted: 1, succeeded: 0})
  assert_eq(
    captured.events.filter(
      { event ->
        event?.type == "tool_batch_disposition"
          && event.receipt.disposition == "skipped_after_blocking_result"
      },
    ).count,
    1,
    "explicit confirmation must not bypass the failed-mutation barrier",
  )
}

pub type RetainedProposalTrial = {
  observations: int,
  mutations: int,
  attempted: int,
  succeeded: int,
  deferred: int,
  confirmed: int,
  discarded: int,
  requests: int,
  body_copies: int,
  stable_tools: bool,
}

type ServedProposalProof = {requests: int, body_copies: int, stable_tools: bool}

type MutationOutcome = {mutations: int, attempted: int, succeeded: int}

fn assert_public_tool_outcomes(result: dict, expected: MutationOutcome) -> nil {
  assert(len(result.tools.calls) > 0, "actual model proposals must remain in the public audit")
  assert_eq(result.tools.successful.count, expected.succeeded)
  assert_eq(result.tools.rejected.count, expected.attempted - expected.succeeded)
  assert_eq(result.trace.tool_executions, expected.succeeded)
  assert_eq(result.trace.tool_rejections, expected.attempted - expected.succeeded)
  assert(!result.trace.tools_used.contains(RESOLVE), "a resolution is not a tool execution")
}

fn assert_mutation_outcome(
  fs: HarnessFs,
  variant: string,
  path: string,
  body: string,
  outcome: MutationOutcome,
) -> nil {
  const should_write = ["resume", "replay", "revise", "reread"].contains(variant)
  assert_eq(outcome.mutations, should_write ? 1 : 0)
  assert_eq(
    outcome.attempted,
    ["reread", "reread_denied"].contains(variant) ? 3 : variant == "discard"
      || variant == "compacted"
      || variant == "new_direction" ? 1 : 2,
  )
  assert_eq(
    outcome.succeeded,
    variant == "reread" ? 3 : should_write
      || ["reread_denied", "reread_injected", "reread_inbox"].contains(variant) ? 2 : 1,
  )
  if should_write {
    assert_eq(fs.read_text(path), variant == "revise" ? "revised" : body)
  } else {
    assert(!fs.exists(path), "an abandoned, denied or invalidated proposal must not mutate")
  }
  return nil
}

fn assert_served_proposals(
  calls: list,
  variant: string,
  confirmation_bytes: int,
  body_bytes: int,
) -> ServedProposalProof {
  assert_eq(
    len(calls),
    ["reread_failed", "reread_inbox"].contains(variant) ? 4 : 3,
    "both confirmation and terminal must reach model serving; actual requests=${len(calls)}",
  )
  assert(
    calls[0].tools.any({ tool -> (tool?.function?.name ?? __tool_registry_name(tool)) == RESOLVE }),
    "the no-pending request must really serve the stable confirmation contract",
  )
  assert_eq(calls[0].tools, calls[1].tools, "retention must preserve the served schema prefix")
  assert_eq(calls[1].tools, calls[2].tools, "resolution must preserve served tool definitions")
  let original_bodies = 0
  for message in calls[2].messages {
    if message?.role != "assistant" {
      continue
    }
    for call in message?.tool_calls ?? [] {
      if (call?.function?.name ?? __tool_registry_name(call)) == "edit_value" {
        original_bodies = original_bodies + 1
      }
    }
  }
  if variant == "resume" || variant == "replay" || variant == "reread" {
    const confirmed_result = calls[2].messages.find(
      { message -> message?.tool_call_id == "confirm" },
    )
    assert(
      confirmed_result != nil,
      "the next served request must include the real resolution result",
    )
    assert_eq(confirmed_result.name, RESOLVE, "provider results must answer the invoked contract")
    assert_eq(original_bodies, 1, "confirmation must not regenerate the stored edit body")
    assert(confirmation_bytes < body_bytes / 3, "confirmation must be shorter than the stored body")
  }
  return {
    requests: len(calls),
    body_copies: original_bodies,
    stable_tools: calls[0].tools == calls[1].tools && calls[1].tools == calls[2].tools,
  }
}

fn assert_resolution_events(
  events: list,
  variant: string,
  archived: int,
  archived_at_proposal: int,
) -> list {
  const resolutions = events.filter({ event -> event?.type == "tool_batch_proposal_resolution" })
    .to_list()
  assert(len(resolutions) > 0, "retirement must be measured through the canonical event path")
  for event in resolutions {
    const report = agent_event_report(event, agent_tool_batch_proposal_resolution_event_schema())
    assert(
      report.ok,
      "the native resolution event and public schema must agree: " + json_stringify(report),
    )
  }
  assert(resolutions.any({ event -> event.resolution.pending_count == 0 }))
  if variant == "compacted" {
    assert(
      archived > archived_at_proposal,
      "compaction must really archive retained source context",
    )
    assert(resolutions.any({ event -> event.resolution.reason == "context_compacted" }))
  }
  return resolutions
}

/** Run one deterministic public-loop trial and return its measured observations. */
pub fn retained_proposal_trial(harness: Harness, variant: string) -> RetainedProposalTrial {
  const sid = "retained-proposal-${harness.random.uuid()}"
  const path = path_join(harness.fs.workspace_temp_dir(), "retained-${harness.random.uuid()}.txt")
  const body = "original proposal body " * 120
  const reads = harness.runtime.atomic(0)
  const writes = harness.runtime.atomic(0)
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit_value",
    "Write the confirmed value.",
    {
      parameters: {path: {type: "string"}, value: {type: "string"}},
      annotations: {kind: "edit", side_effect_level: "workspace_write", path_params: ["path"]},
      handler: { args ->
        harness.runtime.atomic_add(writes, 1)
        harness.fs.write_text(args.path, args.value)
        return agent_tool_handler_result(
          "applied",
          {mutation_status: "applied", requires_repair_before_verify: false},
        )
      },
    },
  )
  tools = tool_define(
    tools,
    "read_evidence",
    "Read evidence before deciding on the edit.",
    {
      parameters: {},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { _args ->
        harness.runtime.atomic_add(reads, 1)
        if harness.runtime.atomic_get(reads) == 2 {
          if variant == "reread_failed" {
            return agent_tool_handler_result("Read failed.", {error: "unavailable"}, "error")
          }
          if variant == "reread_injected" {
            harness.agent.inject(sid, {role: "user", content: "Use a new task instead."})
          }
          if variant == "reread_inbox" {
            agent_session_post_event(harness.agent, sid, "user_interrupt", "Pause this work.")
          }
        }
        return variant == "discard" || variant == "revise" ? "The earlier proposal is wrong; discard it." : "Evidence ready. "
          + "x" * 4000
      },
    },
  )
  let turn = 0
  let proposal_id = ""
  let archived = 0
  let archived_at_proposal = 0
  let attempted = 0
  let succeeded = 0
  let confirmation_bytes = 0
  const captured = agent_capture_events(
    harness.agent,
    sid,
    { ->
      return with_llm_script(
        harness.llm,
        [
          {
            tool_calls: [
              {id: "original-edit", name: "edit_value", arguments: {path: path, value: body}},
              {id: "observe", name: "read_evidence", arguments: {}},
            ],
          },
        ],
        { ->
          const result = agent_loop(
            harness,
            "Inspect evidence, then decide whether to write.",
            nil,
            {
              provider: "mock",
              session_id: sid,
              tools: tools,
              tool_format: "native",
              loop_until_done: true,
              max_iterations: 4,
              final_wrapup: false,
              tool_precheck: { call ->
                if ["denied", "reread_denied"].contains(variant) && call?.tool == "edit_value" {
                  return {deny: true, model_cue: "The current policy refuses this edit."}
                }
                return nil
              },
              auto_compact: variant == "compacted" ? {keep_first: 0} : false,
              compact_threshold: 1,
              compact_keep_last: 0,
              compact_strategy: "custom",
              compact_callback: { messages ->
                archived = archived + len(messages)
                return {summary: "Earlier source context was archived."}
              },
              post_turn_callback: { info ->
                turn = turn + 1
                const tally = __dispatch_call_tally(info.dispatch)
                attempted = attempted + tally.attempted
                succeeded = succeeded + tally.succeeded
                if turn == 1 {
                  assert_eq(harness.runtime.atomic_get(reads), 1, "the observation must execute")
                  assert_eq(
                    harness.runtime.atomic_get(writes),
                    0,
                    "the model must reconsider before any edit",
                  )
                  assert_eq(
                    tally.attempted,
                    1,
                    "retaining a proposal is not a failed execution attempt",
                  )
                  const retained = info.dispatch.find({ result -> result?.status == "deferred" })
                  assert(retained != nil, "the actual loop must defer the authored edit")
                  proposal_id = retained.dispatch_receipt.retained_proposal_id
                  assert(
                    type_of(proposal_id) == "string" && proposal_id != "",
                    "the returned proposal must be actionable without retyping its arguments",
                  )
                  const observation = to_string(retained.observation)
                  assert(observation.contains("retained, not executed"), observation)
                  assert(observation.contains("proposal_id=${proposal_id}"), observation)
                  assert(
                    len(observation) < 160,
                    "a retained receipt carries facts, not repeated tool instructions",
                  )
                  archived_at_proposal = archived
                  if variant == "new_direction" {
                    harness.agent.inject(sid, {role: "user", content: "Use a new task instead."})
                  }
                  let next = [
                    decision(
                      "confirm",
                      proposal_id,
                      variant == "discard" || variant == "revise" ? "discard" : "resume",
                    ),
                  ]
                  if variant == "replay" {
                    next.push(decision("replay", proposal_id, "resume"))
                  }
                  if starts_with(variant, "reread") {
                    next.push({id: "reread", name: "read_evidence", arguments: {}})
                  }
                  if variant == "revise" {
                    next.push(
                      {
                        id: "revised-edit",
                        name: "edit_value",
                        arguments: {path: path, value: "revised"},
                      },
                    )
                  }
                  confirmation_bytes = len(json_stringify(next))
                  harness.llm.mock_enqueue({tool_calls: next})
                } else if starts_with(variant, "reread") && turn == 2 {
                  assert_eq(
                    harness.runtime.atomic_get(reads),
                    2,
                    "the new read must run before the retained edit",
                  )
                  assert_eq(
                    harness.runtime.atomic_get(writes),
                    variant == "reread" ? 1 : 0,
                    "continuation must honor explicit intent, read failures, current policy and controls",
                  )
                  if variant == "reread" {
                    assert(
                      info.dispatch.all({ result -> result?.status != "deferred" }),
                      "a confirmed edit must not demand another confirmation after a successful read",
                    )
                  }
                  if ["reread_failed", "reread_inbox"].contains(variant) {
                    const retained = info.dispatch.find({ result -> result?.status == "deferred" })
                    assert(retained != nil, "an unexecuted edit must remain explicitly resolvable")
                    harness.llm.mock_enqueue(
                      {
                        tool_calls: [
                          decision(
                            "discard-after-read",
                            retained.dispatch_receipt.retained_proposal_id,
                            "discard",
                          ),
                        ],
                      },
                    )
                  } else {
                    harness.llm.mock_enqueue(llm_text("Finished. ##DONE##"))
                  }
                } else if ["reread_failed", "reread_inbox"].contains(variant) && turn == 3 {
                  harness.llm.mock_enqueue(llm_text("Finished. ##DONE##"))
                } else if turn == 2 {
                  harness.llm.mock_enqueue(llm_text("Finished. ##DONE##"))
                }
                return nil
              },
            },
          )
          return {run: result}
            + assert_served_proposals(
              harness.llm.mock_calls(),
              variant,
              confirmation_bytes,
              len(body),
            )
        },
      )
    },
  )
  const outcome: MutationOutcome = {
    mutations: harness.runtime.atomic_get(writes),
    attempted: attempted,
    succeeded: succeeded,
  }
  assert_mutation_outcome(harness.fs, variant, path, body, outcome)
  assert_public_tool_outcomes(captured.result.run, outcome)
  const resolutions = assert_resolution_events(
    captured.events,
    variant,
    archived,
    archived_at_proposal,
  )
  return {
    observations: harness.runtime.atomic_get(reads),
    mutations: harness.runtime.atomic_get(writes),
    attempted: attempted,
    succeeded: succeeded,
    deferred: captured.events.filter(
      { event ->
        event?.type == "tool_batch_disposition" && event.receipt.disposition == "deferred"
      },
    ).count,
    confirmed: resolutions.filter({ event -> event.resolution.resolution == "confirmed" }).count,
    discarded: resolutions.filter({ event -> event.resolution.resolution == "discarded" }).count,
    requests: captured.result.requests,
    body_copies: captured.result.body_copies,
    stable_tools: captured.result.stable_tools,
  }
}
