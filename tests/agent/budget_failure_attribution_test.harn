// Run: harn test tests/agent/budget_failure_attribution_test.harn
//
// The LLM boundary already knows which hard ceiling rejected a call. The agent
// terminal and event must preserve that cause without reading provider prose.
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { with_llm_script } from "std/testing"

fn run_budget_limit(harness: Harness, limit: string) {
  const session = "budget-failure-" + limit + "-" + harness.random.uuid()
  const caller = { _call ->
    return {
      ok: false,
      status: "budget_exhausted",
      stop_reason: "budget_exhausted",
      error: {
        kind: "terminal",
        category: "budget_exceeded",
        reason: "budget_exceeded",
        limit: limit,
        limit_value: 1.25,
        projected_cost_usd: 0.75,
        session_cost_usd: 0.69,
        projected_input_tokens: 12000,
        projected_output_tokens: 4000,
        provider: "mock",
        model: "budget-fixture",
      },
    }
  }
  const opts: AgentSpec = {
    provider: "mock",
    model: "budget-fixture",
    llm_caller: caller,
    session_id: session,
    max_iterations: 2,
    final_wrapup: false,
  }
  return agent_capture_events(
    harness.agent,
    session,
    fn() { return agent_loop(harness, "Exercise the budget boundary.", nil, opts) },
  )
}

pipeline test_preserves_each_llm_budget_limit(harness: Harness, task: unknown) {
  for limit in ["total_cost", "per_call_cost", "input_tokens", "output_tokens"] {
    const captured = run_budget_limit(harness, limit)
    assert_eq(captured.result.status, "budget_exhausted")
    assert_eq(captured.result.stop_reason, limit)
    assert_eq(captured.result.error.limit, limit)
    const events = captured.events.filter({ event -> event.type == "budget_exhausted" })
    assert_eq(len(events), 1)
    assert_eq(events[0].kind, limit)
    assert_eq(events[0].limit_value, 1.25)
    assert_eq(events[0].projected_cost_usd, 0.75)
    assert_eq(events[0].session_cost_usd, 0.69)
    assert_eq(events[0].projected_input_tokens, 12000)
    assert_eq(events[0].projected_output_tokens, 4000)
    assert_eq(events[0].provider, "mock")
    assert_eq(events[0].model, "budget-fixture")
  }
}

/** A ceiling crossed at settlement has no projection; the event still names the judged spend. */
pipeline test_a_settlement_stop_names_the_judged_spend(harness: Harness, task: unknown) {
  const session = "budget-settlement-" + harness.random.uuid()
  const caller = { _call ->
    return {
      ok: false,
      status: "budget_exhausted",
      stop_reason: "budget_exhausted",
      error: {
        category: "budget_exceeded",
        message: "LLM budget exceeded: spent $2.2497 of $1.5000 budget",
      },
    }
  }
  const opts: AgentSpec = {
    provider: "mock",
    model: "budget-fixture",
    llm_caller: caller,
    session_id: session,
    max_iterations: 2,
    final_wrapup: false,
  }
  const captured = agent_capture_events(
    harness.agent,
    session,
    fn() { return agent_loop(harness, "Exercise the settlement boundary.", nil, opts) },
  )
  const events = captured.events.filter({ event -> event.type == "budget_exhausted" })
  assert_eq(len(events), 1)
  assert_ne(events[0].session_cost_usd, nil, "the settlement stop names the spend it judged")
  assert_eq(events[0].session_cost_usd, harness.llm.session_cost().budget_charged_usd)
}

/**
 * A call the ceiling refuses when it settles was still paid for. The loop's own
 * cost, its call count and the run ledger all include it, matching the budget
 * ledger that judged the stop.
 */
pipeline test_a_settlement_stop_counts_the_call_it_settled(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [
      {
        text: "A long answer that costs more than the ceiling allows.",
        input_tokens: 4000,
        output_tokens: 900,
        simulated_cost_usd: 0.5,
      },
    ],
    { ->
      harness.llm.budget(0.25)
      const session = "budget-settled-call-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        max_iterations: 2,
        final_wrapup: false,
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Exercise the settlement boundary.", nil, opts) },
      )
      const judged = harness.llm.session_cost().budget_charged_usd
      assert_eq(judged, 0.5)
      assert_eq(captured.result.status, "budget_exhausted")
      assert_eq(captured.result.cost_usd, judged, "the loop's cost includes the settled call")
      assert_eq(captured.result.llm.input_tokens, 4000)
      assert_eq(captured.result.llm.output_tokens, 900)
      assert_eq(captured.result.provider_call_count, 1, "the run ledger counts the settled call")
      assert_eq(captured.result.physical_usage.cost_usd, judged)
      const events = captured.events.filter({ event -> event.type == "budget_exhausted" })
      assert_eq(len(events), 1)
      assert_eq(events[0].cost_usd, judged)
    },
  )
}
