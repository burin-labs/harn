import {
  __response_compact_with_caller,
  response_compaction_read_exact,
} from "std/agent/response_compaction"

type ExactResponse = {text: string, facts: list<string>}

type DynamicResponse = dict

type Summary = {summary: string, critical_facts: list<string>}

fn __caps(fs: HarnessFs, llm: HarnessLlm) -> {fs: HarnessFs, llm: HarnessLlm} {
  return {fs: fs, llm: llm}
}

fn __options(namespace: string, fallback: Summary, threshold: int = 1) {
  return {
    summarize_above_bytes: threshold,
    instructions: "Retain every critical fact.",
    fallback: fallback,
    ladder: "agent_cheap",
    max_tokens: 400,
    ttl_seconds: 3600,
    max_entries: 32,
    namespace: namespace,
  }
}

pipeline test_small_response_stays_exact_without_summarizer(harness: Harness, task: unknown) {
  const calls = harness.runtime.atomic(0)
  const exact: ExactResponse = {text: "ok", facts: ["fact-a"]}
  const result = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    __options(
      "response-compaction-exact-" + harness.random.uuid(),
      {summary: "fallback", critical_facts: []},
      10000,
    ),
    { _prompt, _schema, _ladder, _max_tokens ->
      harness.runtime.atomic_add(calls, 1)
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  assert_eq(result.output.kind, "exact")
  assert_eq(result.output.value, exact)
  assert_eq(result.receipt.state, "exact")
  assert_eq(harness.runtime.atomic_get(calls), 0)
  const retained = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    result.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  assert_eq(retained.state, "found")
  assert_eq(retained.value, exact)
}

pipeline test_summary_is_cached_and_exact_value_remains_retrievable(
  harness: Harness,
  task: unknown,
) {
  const calls = harness.runtime.atomic(0)
  const namespace = "response-compaction-cache-" + harness.random.uuid()
  const exact: ExactResponse = {text: "large response ".repeat(40), facts: ["keep-a", "keep-b"]}
  const options = __options(namespace, {summary: "fallback", critical_facts: []})
  const summarize = { prompt, _schema, ladder, max_tokens ->
    harness.runtime.atomic_add(calls, 1)
    assert_eq(contains(prompt, "large response"), true)
    assert_eq(ladder, "agent_cheap")
    assert_eq(max_tokens, 400)
    return {
      ok: true,
      data: {summary: "compact", critical_facts: ["keep-a", "keep-b"]},
      provider: "fixture",
      model: "fixture-summary",
      usage: {input_tokens: 0, output_tokens: 0},
    }
  }
  const first = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    options,
    summarize,
  )
  const second = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    options,
    summarize,
  )
  assert_eq(first.output.kind, "summarized")
  assert_eq(first.receipt.summary_cache_hit, false)
  assert_eq(second.output.kind, "summarized")
  assert_eq(second.receipt.summary_cache_hit, true)
  assert_eq(second.output.value, first.output.value)
  assert_eq(harness.runtime.atomic_get(calls), 1)
  assert_eq(second.receipt.route.provider, "fixture")
  assert_eq(second.receipt.route.model, "fixture-summary")
  assert_eq(first.receipt.summary_call_count, 1)
  assert_eq(first.receipt.summary_usage.input_tokens, 0)
  assert_eq(first.receipt.summary_usage.output_tokens, 0)
  assert_eq(second.receipt.summary_call_count, 0)
  assert_eq(second.receipt.summary_usage.input_tokens, 0)
  const retained = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    second.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  assert_eq(retained.state, "found")
  assert_eq(retained.value, exact)
}

pipeline test_malformed_summary_uses_typed_fallback_after_exact_commit(
  harness: Harness,
  task: unknown,
) {
  const fallback: Summary = {summary: "deterministic", critical_facts: ["unknown"]}
  const exact: ExactResponse = {text: "large ".repeat(40), facts: ["source"]}
  const result = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    __options("response-compaction-malformed-" + harness.random.uuid(), fallback),
    { _prompt, _schema, _ladder, _max_tokens -> return {ok: true, data: {summary: 7}} },
  )
  assert_eq(result.output.kind, "fallback")
  assert_eq(result.output.value, fallback)
  assert_eq(result.output.cause, "summary_invalid")
  assert_eq(result.receipt.error_category, "schema_validation")
  const retained = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    result.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  assert_eq(retained.state, "found")
  assert_eq(retained.value, exact)
}

pipeline test_model_failure_category_does_not_change_deterministic_fallback(
  harness: Harness,
  task: unknown,
) {
  const fallback: Summary = {summary: "offline", critical_facts: []}
  const result = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    {text: "large ".repeat(40), facts: []},
    schema_of(ExactResponse),
    schema_of(Summary),
    __options("response-compaction-failure-" + harness.random.uuid(), fallback),
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: false, cause: "model_error", error_category: "timeout"}
    },
  )
  assert_eq(result.output.kind, "fallback")
  assert_eq(result.output.value, fallback)
  assert_eq(result.receipt.fallback_cause, "model_error")
  assert_eq(result.receipt.error_category, "timeout")
  assert_eq(result.receipt.summary_call_count, 1)
  assert_eq(result.receipt.summary_usage, nil)
}

pipeline test_summary_identity_changes_with_instructions_and_schema(
  harness: Harness,
  task: unknown,
) {
  const exact: ExactResponse = {text: "large ".repeat(40), facts: []}
  const namespace = "response-compaction-identity-" + harness.random.uuid()
  const base = __options(namespace, {summary: "fallback", critical_facts: []})
  const first = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    base,
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: true, data: {summary: "a", critical_facts: []}}
    },
  )
  const changed = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    base + {instructions: "Retain critical facts and ordering."},
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: true, data: {summary: "b", critical_facts: []}}
    },
  )
  assert_eq(first.receipt.summary_cache_key != changed.receipt.summary_cache_key, true)
  assert_eq(changed.receipt.summary_cache_hit, false)
}

pipeline test_concurrent_exact_commits_never_expose_partial_values(
  harness: Harness,
  task: unknown,
) {
  const exact: ExactResponse = {text: "same", facts: ["one", "two"]}
  const options = __options(
    "response-compaction-concurrent-" + harness.random.uuid(),
    {summary: "fallback", critical_facts: []},
    10000,
  )
  let handles = []
  for _index in range(12) {
    handles = handles
      + [
      spawn {
        __response_compact_with_caller(
          __caps(harness.fs, harness.llm),
          exact,
          schema_of(ExactResponse),
          schema_of(Summary),
          options,
          { _prompt, _schema, _ladder, _max_tokens ->
            return {ok: true, data: {summary: "unused", critical_facts: []}}
          },
        )
      },
    ]
  }
  assert_eq(len(handles), 12)
  for handle in handles {
    const result = await(handle)
    assert_eq(result.output.kind, "exact")
    const retained = response_compaction_read_exact(
      __caps(harness.fs, harness.llm),
      result.receipt.exact_ref,
      schema_of(ExactResponse),
    )
    assert_eq(retained.state, "found")
    assert_eq(retained.value, exact)
  }
}

pipeline test_lru_bound_makes_eviction_visible_as_missing(harness: Harness, task: unknown) {
  const namespace = "response-compaction-bound-" + harness.random.uuid()
  const options = __options(namespace, {summary: "fallback", critical_facts: []}, 10000)
    + {
    max_entries: 1,
  }
  const first = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    {text: "first", facts: []},
    schema_of(ExactResponse),
    schema_of(Summary),
    options,
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  const second = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    {text: "second", facts: []},
    schema_of(ExactResponse),
    schema_of(Summary),
    options,
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  const evicted = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    first.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  const retained = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    second.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  assert_eq(evicted.state, "missing")
  assert_eq(retained.state, "found")
  assert_eq(retained.value.text, "second")
  assert_eq(second.receipt.exact_ref.storage, "workspace_temp")
}

pipeline test_exact_validation_failure_is_closed_before_summarizer(
  harness: Harness,
  task: unknown,
) {
  const calls = harness.runtime.atomic(0)
  const attempted = try {
    __response_compact_with_caller(
      __caps(harness.fs, harness.llm),
      {text: 7, facts: []},
      schema_of(ExactResponse),
      schema_of(Summary),
      __options(
        "response-compaction-invalid-exact-" + harness.random.uuid(),
        {summary: "fallback", critical_facts: []},
      ),
      { _prompt, _schema, _ladder, _max_tokens ->
        harness.runtime.atomic_add(calls, 1)
        return {ok: true, data: {summary: "bad", critical_facts: []}}
      },
    )
  }
  assert_eq(is_err(attempted), true)
  assert_eq(harness.runtime.atomic_get(calls), 0)
}

pipeline test_namespace_cannot_escape_owned_workspace_root(harness: Harness, task: unknown) {
  const calls = harness.runtime.atomic(0)
  const attempted = try {
    __response_compact_with_caller(
      __caps(harness.fs, harness.llm),
      {text: "large ".repeat(20), facts: []},
      schema_of(ExactResponse),
      schema_of(Summary),
      __options("../outside", {summary: "fallback", critical_facts: []}),
      { _prompt, _schema, _ladder, _max_tokens ->
        harness.runtime.atomic_add(calls, 1)
        return {ok: true, data: {summary: "bad", critical_facts: []}}
      },
    )
  }
  assert_eq(is_err(attempted), true)
  assert_eq(harness.runtime.atomic_get(calls), 0)
}

pipeline test_heterogeneous_dict_boundary_remains_lossless(harness: Harness, task: unknown) {
  const exact: DynamicResponse = {
    text: "mixed",
    count: 0,
    nested: {ok: true},
    rows: [1, "two", nil],
  }
  const result = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    exact,
    schema_of(DynamicResponse),
    schema_of(Summary),
    __options(
      "response-compaction-dict-" + harness.random.uuid(),
      {summary: "fallback", critical_facts: []},
      10000,
    ),
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  assert_eq(result.output.kind, "exact")
  assert_eq(result.output.value, exact)
  const retained = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    result.receipt.exact_ref,
    schema_of(DynamicResponse),
  )
  assert_eq(retained.state, "found")
  assert_eq(retained.value, exact)
}

pipeline test_tampered_exact_reference_fails_closed_under_owned_root(
  harness: Harness,
  task: unknown,
) {
  const result = __response_compact_with_caller(
    __caps(harness.fs, harness.llm),
    {text: "exact", facts: []},
    schema_of(ExactResponse),
    schema_of(Summary),
    __options(
      "response-compaction-ref-" + harness.random.uuid(),
      {summary: "fallback", critical_facts: []},
      10000,
    ),
    { _prompt, _schema, _ladder, _max_tokens ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  const tampered = result.receipt.exact_ref + {namespace: "../outside"}
  const read = response_compaction_read_exact(
    __caps(harness.fs, harness.llm),
    tampered,
    schema_of(ExactResponse),
  )
  assert_eq(read.state, "broken")
}
