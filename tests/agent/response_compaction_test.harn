pipeline test_tampered_exact_reference_fails_closed_under_owned_root(
  harness: Harness,
  task: unknown,
) {
  const result = __response_compact_with_caller(
    __caps(harness),
    {text: "exact", facts: []},
    schema_of(ExactResponse),
    schema_of(Summary),
    __options(
      "response-compaction-ref-" + harness.random.uuid(),
      {summary: "fallback", critical_facts: []},
      10000,
    ),
    { _prompt, _schema, _ladder, _max_tokens, _timeout_ms ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  const tampered = result.receipt.exact_ref + {namespace: "../outside"}
  const read = response_compaction_read_exact(__caps(harness), tampered, schema_of(ExactResponse))
  assert_eq(read.state, "broken")
}

pipeline test_exact_reference_schema_discriminator_is_required(harness: Harness, task: unknown) {
  const result = __response_compact_with_caller(
    __caps(harness),
    {text: "exact", facts: []},
    schema_of(ExactResponse),
    schema_of(Summary),
    __options(
      "response-compaction-ref-schema-" + harness.random.uuid(),
      {summary: "fallback", critical_facts: []},
      10000,
    ),
    { _prompt, _schema, _ladder, _max_tokens, _timeout_ms ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  const valid = response_compaction_read_exact(
    __caps(harness),
    result.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  const forged = result.receipt.exact_ref + {schema: "harn.response_compaction.exact_ref.v2"}
  const rejected = response_compaction_read_exact(__caps(harness), forged, schema_of(ExactResponse))
  assert_eq(valid.state, "found")
  assert_eq(valid.value.text, "exact")
  assert_eq(rejected.state, "broken")
  assert_eq(rejected.detail, "exact reference failed validation")
}

pipeline test_schema_valid_exact_content_tamper_fails_digest_verification(
  harness: Harness,
  task: unknown,
) {
  const result = __response_compact_with_caller(
    __caps(harness),
    {text: "original", facts: ["keep"]},
    schema_of(ExactResponse),
    schema_of(Summary),
    __options(
      "response-compaction-content-tamper-" + harness.random.uuid(),
      {summary: "fallback", critical_facts: []},
      10000,
    ),
    { _prompt, _schema, _ladder, _max_tokens, _timeout_ms ->
      return {ok: true, data: {summary: "unused", critical_facts: []}}
    },
  )
  const ref = result.receipt.exact_ref
  const store = fs_cache(
    path_join(harness.fs.workspace_temp_dir(), "harn-response-compaction"),
    {namespace: ref.namespace, ttl_seconds: ref.ttl_seconds, max_entries: ref.max_entries},
  )
  cache_put(harness.llm, ref.key, {text: "schema-valid mutation", facts: ["keep"]}, {store: store})
  const read = response_compaction_read_exact(__caps(harness), ref, schema_of(ExactResponse))
  assert_eq(read.state, "broken")
  assert_eq(read.detail, "exact retained content failed digest verification")
}

pipeline test_summary_cache_rejects_tampered_key_and_exact_digest(harness: Harness, task: unknown) {
  const calls = harness.runtime.atomic(0)
  const namespace = "response-compaction-summary-binding-" + harness.random.uuid()
  const exact: ExactResponse = {text: "large ".repeat(40), facts: ["keep"]}
  const options = __options(namespace, {summary: "fallback", critical_facts: []})
  const summarize = { _prompt, _schema, _ladder, _max_tokens, _timeout_ms ->
    const prior_calls = harness.runtime.atomic_add(calls, 1)
    return {
      ok: true,
      data: {summary: "fresh-" + to_string(prior_calls + 1), critical_facts: ["keep"]},
    }
  }
  const first = __response_compact_with_caller(
    __caps(harness),
    exact,
    schema_of(ExactResponse),
    schema_of(Summary),
    options,
    summarize,
  )
  const store = fs_cache(
    path_join(harness.fs.workspace_temp_dir(), "harn-response-compaction"),
    {namespace: namespace + "-summary", ttl_seconds: 3600, max_entries: 32},
  )
  const tampered_bindings = [
    {
      summary_key: first.receipt.summary_cache_key + "-forged",
      exact_sha256: first.receipt.exact_sha256,
    },
    {summary_key: first.receipt.summary_cache_key, exact_sha256: "0".repeat(64)},
  ]
  let expected_calls = 1
  for binding in tampered_bindings {
    cache_put(
      harness.llm,
      first.receipt.summary_cache_key,
      {
        schema: "harn.response_compaction.summary_cache.v1",
        summary_key: binding.summary_key,
        exact_sha256: binding.exact_sha256,
        outcome: "summarized",
        summary: {summary: "forged", critical_facts: ["wrong"]},
        route: {ladder: "agent_cheap"},
      },
      {store: store},
    )
    const result = __response_compact_with_caller(
      __caps(harness),
      exact,
      schema_of(ExactResponse),
      schema_of(Summary),
      options,
      summarize,
    )
    expected_calls = expected_calls + 1
    assert_eq(harness.runtime.atomic_get(calls), expected_calls)
    assert_eq(result.output.kind, "summarized")
    assert_eq(result.output.value.summary, "fresh-" + to_string(expected_calls))
    assert_eq(result.receipt.summary_cache_hit, false)
    assert_eq(result.receipt.summary_call_count, 1)
  }
}

pipeline test_public_response_compact_returns_scripted_structured_summary(
  harness: Harness,
  task: unknown,
) {
  const result = with_llm_script(
    harness.llm,
    [llm_text("{\"summary\":\"compact\",\"critical_facts\":[\"keep\"]}")],
    { ->
      return response_compact(
        __caps(harness),
        {text: "large ".repeat(30), facts: ["keep"]},
        schema_of(ExactResponse),
        schema_of(Summary),
        __options(
          "response-compaction-production-" + harness.random.uuid(),
          {summary: "fallback", critical_facts: []},
        )
          + {timeout_ms: 1000},
      )
    },
  )
  assert_eq(result.output.kind, "summarized")
  assert_eq(result.output.value.summary, "compact")
  assert_eq(result.output.value.critical_facts, ["keep"])
  assert_eq(result.receipt.summary_call_count, 1)
  assert_eq(result.receipt.summary_timeout_ms, 1000)
  const retained = response_compaction_read_exact(
    __caps(harness),
    result.receipt.exact_ref,
    schema_of(ExactResponse),
  )
  assert_eq(retained.state, "found")
  assert_eq(retained.value.facts, ["keep"])
}
