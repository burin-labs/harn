// Run: harn test tests/agent/goal_test.harn
//
// Config-time validation fixtures for `std/agent/goal`. These pin the LOUD
// config-time guards that keep a mistyped host-fact callback from silently
// dropping the deterministic floor: a criterion `check` that is set but not
// callable, and a `goal_reloop` `facts_fn` that is set but not callable. Also
// pins the behavior-identical swap of `__goal_without_control_keys` onto the
// `__dict_omit` builtin, and typed goal pin serialization. No model calls.
import {
  goal,
  goal_check,
  goal_judge,
  goal_pin,
  goal_reloop,
  goal_text,
  goal_under_obligations,
} from "std/agent/goal"
import { agent_loop_options } from "std/agent/options"
import { pin_reminder } from "std/agent/pins"

fn __manual_omit(o: dict, drop: any) {
  let out = {}
  for key in o.keys() {
    if !contains(drop, key) {
      out = out + {[key]: o[key]}
    }
  }
  return out
}

pipeline test_callable_check_is_kept(harness: Harness, task: unknown) {
  const g = goal(
    {
      objective: "ship it",
      success_criteria: [{check: { f -> f?.ok ?? false }, description: "green"}],
    },
  )
  assert_eq(goal_check(g, {ok: true}).done, true)
  assert_eq(goal_check(g, {ok: false}).done, false)
}

pipeline test_noncallable_check_throws(harness: Harness, task: unknown) {
  const outcome = try {
    goal({objective: "ship it", success_criteria: [{check: "not-callable", description: "green"}]})
  }
  assert(is_err(outcome), "goal rejects a non-callable criterion check")
}

pipeline test_missing_check_is_llm_judged_not_rejected(harness: Harness, task: unknown) {
  // A criterion WITHOUT a `check` is LLM-judged, not machine-checked — it must
  // still normalize cleanly (only a set-but-non-callable check is rejected).
  const g = goal({objective: "ship it", success_criteria: ["works end to end"]})
  assert_eq(len(g.success_criteria), 1)
  assert_eq(goal_check(g, {}).checkable, 0)
}

pipeline test_noncallable_facts_fn_throws(harness: Harness, task: unknown) {
  const g = goal({objective: "ship it"})
  const outcome = try {
    goal_reloop(g, {facts_fn: 42})
  }
  assert(is_err(outcome), "goal_reloop rejects a non-callable facts_fn")
}

pipeline test_callable_facts_fn_is_accepted(harness: Harness, task: unknown) {
  const g = goal({objective: "ship it"})
  const outcome = try {
    goal_reloop(g, {facts_fn: { _payload -> {} }})
  }
  assert(!is_err(outcome), "goal_reloop accepts a callable facts_fn")
}

pipeline test_dict_omit_matches_manual_omit(harness: Harness, task: unknown) {
  // Behavior-identical proof for the __goal_without_control_keys -> __dict_omit
  // swap: top-level key exclusion, missing keys are no-ops, order-insensitive.
  const drop = ["done_sentinel", "facts_fn", "judge", "max_attempts"]
  const samples = [
    {},
    {a: 1},
    {done_sentinel: "x", provider: "mock"},
    {extra: "keep", facts_fn: 1, judge: true, max_attempts: 3, provider: "mock"},
    {a: 1, b: 2, c: 3},
  ]
  for s in samples {
    assert_eq(__dict_omit(s, drop), __manual_omit(s, drop))
  }
}

pipeline test_goal_reloop_strips_control_keys(harness: Harness, task: unknown) {
  const g = goal({objective: "ship it"})
  const opts = goal_reloop(g, {facts_fn: { _payload -> {} }, max_attempts: 2, provider: "mock"})
  assert_eq(opts?.provider, "mock")
  assert_eq(opts?.facts_fn, nil)
  assert_eq(opts?.max_attempts, nil)
  assert_eq(opts?.max_iterations, 2)
}

pipeline test_goal_reloop_judge_passes_agent_loop_validation(harness: Harness, task: unknown) {
  const g = goal({objective: "ship it", success_criteria: ["works end to end"]})
  const options = agent_loop_options(harness, goal_reloop(g, {judge: true, provider: "mock"}))
  assert_eq(type_of(options.turn_end_condition), "dict")
  assert(!contains(options.turn_end_condition.keys(), "enabled"))
}

const __RETARGETED = {
  original_task: "ship it",
  steers: [{message_id: "msg_inj_1", mode: "finish_step", content: "change of plan"}],
  retarget: {control_id: "ctl-1", message_id: "msg_inj_1", objective: "reply BRAVO"},
}

pipeline test_goal_pin_carries_serializable_criteria_and_limits(harness: Harness) {
  const g = goal(
    {
      objective: "reply ALPHA",
      success_criteria: [{id: "alpha", description: "Reply ALPHA", check: { _ -> false }}],
      constraints: ["keep the constraint"],
      budget: {tokens: 42},
    },
  )
  const reminder = pin_reminder(harness.agent, goal_pin(harness.random, g))
  assert_eq(goal_pin(harness.random, g).meta.goal.success_criteria[0]?.check, nil)
  const injected = harness.agent.transcript_inject_reminder(transcript_from_messages([]), reminder)
  const stored = transcript_events_by_kind(injected.transcript, "system_reminder")
  assert_eq(len(stored), 1)
  assert_eq(stored[0].reminder.goal_pin.spec.objective, "reply ALPHA")
  assert_eq(stored[0].reminder.goal_pin.spec.success_criteria[0].id, "alpha")
  assert_eq(stored[0].reminder.goal_pin.spec.success_criteria[0]?.check, nil)
  assert_eq(stored[0].reminder.goal_pin.spec.constraints, ["keep the constraint"])
  assert_eq(stored[0].reminder.goal_pin.spec.budget.tokens, 42)
  const bounded = pin_reminder(harness.agent, goal_pin(harness.random, g), {max_body: 24})
  assert_eq(bounded.goal_pin.max_body, 24)
  assert(contains(bounded.body, "[pin reminder truncated]"))
  const bounded_stored = harness.agent.transcript_inject_reminder(
    transcript_from_messages([]),
    bounded,
  )
  assert_eq(
    transcript_events_by_kind(bounded_stored.transcript, "system_reminder")[0].reminder.goal_pin
      .max_body,
    24,
  )
  const invalid = try {
    harness.agent.transcript_inject_reminder(
      transcript_from_messages([]),
      reminder + {goal_pin: reminder.goal_pin + {unexpected: true}},
    )
  }
  assert(is_err(invalid), "unknown typed pin fields must fail at injection")
}

pipeline test_goal_judge_keeps_the_typed_goal() {
  const g = goal({objective: "reply ALPHA", success_criteria: ["ALPHA"]})
  const config = goal_judge(g)
  assert_eq(config.goal.objective, "reply ALPHA")
  assert_eq(config.goal.success_criteria[0].description, "ALPHA")
}

pipeline test_goal_projection_does_not_duplicate_retired_criteria() {
  const g = goal({objective: "reply ALPHA", success_criteria: ["ALPHA"]})
  const current = goal_under_obligations(g, __RETARGETED)
  assert_eq(goal_under_obligations(current, __RETARGETED), current)
}

pipeline test_a_retarget_replaces_the_objective_and_retires_criteria(
  harness: Harness,
  task: unknown,
) {
  const g = goal(
    {
      objective: "ship it",
      success_criteria: [{check: { f -> f?.ok ?? false }, description: "green", id: "green"}],
      constraints: ["no force push"],
    },
  )
  const current = goal_under_obligations(g, __RETARGETED)
  assert_eq(current.objective, "reply BRAVO")
  assert_eq(len(current.success_criteria), 0)
  assert_eq((current.retired_criteria ?? [])[0].id, "green")
  assert_eq(current.constraints, ["no force push"])
  assert(contains(goal_text(current), "Retired by the operator's retarget"))
  // The retired criterion's check no longer gates completion.
  assert_eq(goal_check(current, {ok: false}).done, true)
  // Negative control: without a retarget the goal is untouched.
  for unchanged in [
    goal_under_obligations(g, nil),
    goal_under_obligations(g, __RETARGETED + {retarget: nil}),
  ] {
    assert_eq(unchanged.objective, "ship it")
    assert_eq(len(unchanged.success_criteria), 1)
    assert_eq(unchanged.retired_criteria, nil)
  }
}

pipeline test_goal_reloop_floor_honors_a_retarget(harness: Harness, task: unknown) {
  const g = goal(
    {
      objective: "ship it",
      success_criteria: [{check: { f -> f?.ok ?? false }, description: "green", id: "green"}],
    },
  )
  const opts = goal_reloop(g, {facts_fn: { _payload -> {ok: false} }})
  const frozen = opts.verify_completion({obligations: nil})
  assert_eq(frozen.confirm, false)
  assert(contains(frozen.feedback, "- green"))
  assert_eq(opts.verify_completion({obligations: __RETARGETED}).confirm, true)
}
