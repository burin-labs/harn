// Run: harn test tests/agent/repair_turn_bare_envelope_test.harn
//
// A turn claimed by the missing-tool-call corrective is sent with an output
// contract, which the provider applies as grammar-constrained decoding: the
// only text the model CAN emit is a bare `{"name": ..., "args": {...}}`
// envelope. The parser is contract-blind, so it reported that envelope as a
// `bare_json` protocol violation — and the loop then charged the model with the
// violation, raised a `text_tool_parse` boundary loss, and injected a corrective
// demanding a ```tool fence, for output the harness itself had constrained it
// to produce.
//
// The three runs below are the falsifier: the SAME bare envelope, on a claimed
// turn that armed the contract, on a claimed turn whose contract never reached
// the provider (the fallback shape, as when the constrained call times out),
// and on an ordinary turn. Both claimed turns must be silent; the ordinary turn
// must still report, so the exemption cannot be mistaken for the parser having
// simply stopped caring. Each run also asserts which side it is on by counting
// how many turns carried `_next_tool_claim_applied` in the options the loop
// actually sent, so no arm can pass by failing to arm or by arming when it was
// supposed to be the fallback.
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"

const BARE_ENVELOPE = "{\"name\": \"add\", \"args\": {\"left\": 2, \"right\": 3}}"

fn _tools() {
  return tool_define(
    tool_registry(),
    "add",
    "Add two integers.",
    {
      handler: { args -> args.left + args.right },
      parameters: {
        left: {type: "integer", description: "Left operand"},
        right: {type: "integer", description: "Right operand"},
      },
      returns: {type: "integer"},
      annotations: {kind: "read"},
    },
  )
}

fn _bump(harness: Harness, cell: any) {
  const snap = harness.runtime.shared_snapshot(cell)
  harness.runtime.shared_cas(cell, snap, snap.value + 1)
}

/**
 * Run one bare-envelope turn and report the loop's own account of it: how many
 * turns the loop actually sent under the output contract, and the two
 * model-facing complaints a `bare_json` verdict produces.
 *
 * `claimed` is whether the missing-call corrective claimed the previous turn.
 * `output_contract` is whether the claim is allowed to reach the provider as a
 * decode grammar; turning it off with the claim still on is how a fallback turn
 * is shaped — claimed, unconstrained, still answering with a bare envelope.
 */
fn _run_bare_envelope_turn(
  harness: Harness,
  session: string,
  claimed: bool,
  output_contract: bool = true,
) -> dict {
  const turns = harness.runtime.shared_cell(
    {scope: "task_group", key: "rbe-turns-" + session, initial: 0},
  )
  const contracted = harness.runtime.shared_cell(
    {scope: "task_group", key: "rbe-armed-" + session, initial: 0},
  )
  const mock_llm = { call ->
    if call?.opts?._next_tool_claim_applied == true {
      _bump(harness, contracted)
    }
    const seen = harness.runtime.shared_snapshot(turns).value
    _bump(harness, turns)
    if seen == 0 {
      return {ok: true, value: {text: BARE_ENVELOPE, provider: "mock", model: "mock"}}
    }
    return {ok: true, value: {text: "Added them. ##DONE##", provider: "mock", model: "mock"}}
  }
  const captured = agent_capture_events(
    harness.agent,
    session,
    fn() { return agent_loop(
      harness,
      "Add 2 and 3, then finish.",
      nil,
      {
        provider: "mock",
        session_id: session,
        tools: _tools(),
        tool_format: "json",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 3,
        llm_caller: mock_llm,
        missing_tool_call_recovery: {output_contract: output_contract},
        _next_tool_claim: if claimed {
          {tool_name: "add", source: "missing_tool_call_recovery"}
        } else {
          nil
        },
      },
    ) },
  )
  let boundary_failures = 0
  let feedback = 0
  let repair_receipts = 0
  for event in captured.events {
    if event.type == "boundary_failure" {
      boundary_failures = boundary_failures + 1
    }
    if event.type == "feedback_injected" {
      feedback = feedback + 1
    }
    if event.type == "typed_checkpoint"
      && event?.checkpoint?.schema
        == "harn.agent_next_tool_claim_receipt.v1" {
      repair_receipts = repair_receipts + 1
    }
  }
  return {
    result: captured.result,
    contracted_turns: harness.runtime.shared_snapshot(contracted).value,
    boundary_failures: boundary_failures,
    feedback: feedback,
    repair_receipts: repair_receipts,
  }
}

pipeline test_contracted_bare_envelope_is_not_a_violation(harness: Harness, task: unknown) {
  const run = _run_bare_envelope_turn(harness, "repair-bare-armed-" + harness.random.uuid(), true)
  // The first turn really was sent under the forced-envelope contract.
  assert_eq(run.contracted_turns > 0, true)
  assert_eq(run.repair_receipts, 1)
  // The envelope is a first-class call: it ran.
  assert_eq(contains(run.result.tools.successful, "add"), true)
  // ...and the harness said nothing about the shape it forced.
  assert_eq(run.boundary_failures, 0)
  assert_eq(run.feedback, 0)
}

pipeline test_claimed_fallback_turn_is_not_a_violation(harness: Harness, task: unknown) {
  // The fallback shape: the corrective claimed the turn, but the contract never
  // reached the provider — as when the constrained call times out or the
  // provider rejects the grammar and the dispatch re-sends unconstrained. The
  // completion is still the bare envelope the repair prompt asked for, so it is
  // still not a violation. Keyed on arming rather than on the claim, this arm
  // took the full scolding path.
  const run = _run_bare_envelope_turn(
    harness,
    "repair-bare-fallback-" + harness.random.uuid(),
    true,
    false,
  )
  // The contract really was withheld: this is the fallback side, not the armed one.
  assert_eq(run.contracted_turns, 0)
  assert_eq(run.repair_receipts, 0)
  assert_eq(contains(run.result.tools.successful, "add"), true)
  assert_eq(run.boundary_failures, 0)
  assert_eq(run.feedback, 0)
}

pipeline test_ordinary_turn_still_reports_a_bare_envelope(harness: Harness, task: unknown) {
  const run = _run_bare_envelope_turn(
    harness,
    "repair-bare-ordinary-" + harness.random.uuid(),
    false,
  )
  // No contract was armed on any turn, so this is the other side of the pair.
  assert_eq(run.contracted_turns, 0)
  assert_eq(run.repair_receipts, 0)
  // Same bytes, same accept-this-turn dispatch...
  assert_eq(contains(run.result.tools.successful, "add"), true)
  // ...but nothing forced them, so the loop still reports and still teaches.
  assert_eq(run.boundary_failures, 1)
  assert_eq(run.feedback, 1)
}
