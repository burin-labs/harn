// Run: harn test tests/agent/abandoned_terminal_test.harn
//
// harn#7915: a run that gave up and a run that finished produced the same typed
// terminal. Every arm below is the issue's own repro shape — a tool the agent
// needs always fails — driven by the mock LLM so the proof needs no provider,
// no sleeps, and no wall clock.
//
// The controls matter more than the positive case here. The rule this file
// pins convicts only on POSITIVE evidence, so the file has to show it stays
// silent when the evidence is absent: a run that used no tools, and a run whose
// tool worked, must both still finish naturally.
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { assert_nil, assert_not_nil, llm_text, llm_tool_call, with_llm_script } from "std/testing"

fn read_only_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "write_file",
    "Write a UTF-8 file.",
    {
      handler: { _args ->
        throw "write_file: this workspace is read-only"
      },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "write"},
    },
  )
  return tools
}

fn working_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "write_file",
    "Write a UTF-8 file.",
    {
      handler: { _args -> "wrote 1 file" },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "write"},
    },
  )
  return tools
}

fn spec(session: string, tools: unknown) -> AgentSpec {
  return {
    provider: "mock",
    session_id: session,
    tools: tools,
    loop_until_done: true,
    iteration_budget: {mode: "fixed", initial: 6, max: 6, extend_by: 0},
  }
}

/**
 * The issue's repro, verbatim in shape. The model behaves correctly: it tries
 * the tool, the tool refuses, and it reports that it cannot proceed. Before
 * this rule the run sealed `done` / `natural` / `completed`, which is
 * byte-identical to a run that did the work.
 */
pipeline test_a_run_whose_only_tool_always_fails_does_not_finish_naturally(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      llm_tool_call("write_file", {path: "/tmp/does-not-matter.txt"}, "write-1"),
      llm_text("I could not create the file; this workspace is read-only. ##DONE##"),
    ],
    { ->
      const result = agent_loop(
        harness,
        "Create /tmp/does-not-matter.txt containing the word hello. Then stop.",
        nil,
        spec("abandoned-" + harness.random.uuid(), read_only_tools()),
      )
      // The three fields a host actually branches on.
      assert_eq(
        result.terminal.kind,
        "completion_unverified",
        "a run whose only tool always failed must not report a natural terminal",
      )
      assert_eq(result.terminal.lifecycle_state, "failed")
      assert_eq(result.terminal.run_record_status, "failed")
      // The cause is named, not left for the reader to infer.
      assert_eq(result.abandonment.cause, "no_tool_call_succeeded")
      // And the run's own reason for stopping is COMPOSED beside it, not
      // written over. Overwriting it would destroy the only record of what the
      // run thought it was doing, which is the fact a person debugging this
      // needs most.
      assert_eq(result.abandonment.natural_stop_reason, result.stop_reason)
      assert_eq(result.abandonment.attempted_tool_calls, 1)
      assert_eq(result.abandonment.succeeded_tool_calls, 0)
    },
  )
}

/**
 * Positive control, and the one that would catch this rule firing too widely.
 * Same prompt, same tool name, same script shape; the only difference is that
 * the handler succeeds. This run MUST still be natural.
 */
pipeline test_a_run_whose_tool_succeeds_still_finishes_naturally(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      llm_tool_call("write_file", {path: "/tmp/does-not-matter.txt"}, "write-1"),
      llm_text("I created the file. ##DONE##"),
    ],
    { ->
      const result = agent_loop(
        harness,
        "Create /tmp/does-not-matter.txt containing the word hello. Then stop.",
        nil,
        spec("finished-" + harness.random.uuid(), working_tools()),
      )
      assert_eq(result.terminal.kind, "natural")
      assert_eq(result.terminal.lifecycle_state, "completed")
      // Absent, not merely falsy: a record is written only on a conviction.
      assert_nil(result?.abandonment)
    },
  )
}

/**
 * The second control, against the failure mode that would be worse than the
 * bug. Answering a question without touching a tool is a legitimate completed
 * run. Absence of tool use is not evidence of abandonment, and a rule that
 * convicted here would fail every question-answering run in the product.
 */
pipeline test_a_run_that_used_no_tools_still_finishes_naturally(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [llm_text("Paris is the capital of France. ##DONE##")],
    { ->
      const result = agent_loop(
        harness,
        "What is the capital of France?",
        nil,
        spec("quiet-" + harness.random.uuid(), read_only_tools()),
      )
      assert_eq(result.terminal.kind, "natural")
      assert_eq(result.terminal.lifecycle_state, "completed")
      // Absent, not merely falsy: a record is written only on a conviction.
      assert_nil(result?.abandonment)
    },
  )
}

/**
 * A run that fails a tool and later succeeds with it has done something, so it
 * is not this rule's business. This pins the boundary at "not one call
 * succeeded" rather than "any call failed", which is the difference between
 * reporting abandonment and reporting every run that ever retried.
 */
pipeline test_a_failed_call_followed_by_a_successful_one_finishes_naturally(
  harness: Harness,
  task: unknown,
) {
  let tools = tool_registry()
  let attempts = 0
  tools = tool_define(
    tools,
    "write_file",
    "Write a UTF-8 file.",
    {
      handler: { _args ->
        attempts = attempts + 1
        if attempts == 1 {
          throw "write_file: transient failure"
        }
        return "wrote 1 file"
      },
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "write"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      llm_tool_call("write_file", {path: "/tmp/a.txt"}, "write-1"),
      llm_tool_call("write_file", {path: "/tmp/a.txt"}, "write-2"),
      llm_text("Created on the retry. ##DONE##"),
    ],
    { ->
      const result = agent_loop(
        harness,
        "Create /tmp/a.txt. Retry once if it fails.",
        nil,
        spec("retry-" + harness.random.uuid(), tools),
      )
      assert_eq(result.terminal.kind, "natural")
      assert_eq(result.terminal.lifecycle_state, "completed")
      // Absent, not merely falsy: a record is written only on a conviction.
      assert_nil(result?.abandonment)
    },
  )
}

/**
 * The fifth arm, and the one that pins the EVIDENCE rather than the verdict.
 *
 * The model tries the tool once, is refused, and then answers from its own
 * knowledge and stops. That is the shape most likely to be mistaken for a
 * finished run, because the final message reads like a completed answer. The
 * counts asserted here are per-CALL counts from the loop's own tally, not the
 * lengths of the deduplicated name lists, which is why one attempted call is
 * reported as one and not as one distinct tool.
 */
pipeline test_a_refused_call_then_an_answer_reports_its_evidence(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      llm_tool_call("write_file", {path: "/tmp/notes.txt"}, "write-1"),
      llm_text("I could not write the file, but the capital of France is Paris. ##DONE##"),
    ],
    { ->
      const result = agent_loop(
        harness,
        "Write the capital of France to /tmp/notes.txt, and tell me what it is.",
        nil,
        spec("evidence-" + harness.random.uuid(), read_only_tools()),
      )
      assert_eq(result.terminal.kind, "completion_unverified")
      assert_eq(result.abandonment.cause, "no_tool_call_succeeded")
      assert_eq(result.abandonment.attempted_tool_calls, 1)
      assert_eq(result.abandonment.succeeded_tool_calls, 0)
      // A failing call with no typed category reads `unclassified`, never
      // nothing, so "failed with no category" cannot be confused with "did not
      // fail".
      assert_not_nil(result.abandonment.last_rejection_category)
    },
  )
}
