// Run: harn test tests/agent/stall_test.harn
//
// Unit tests for the stall detector's handling of soft progress-report tools.
// A turn whose ONLY tool call is `agent_progress` reports status without
// advancing the task, so it must count toward the no-progress streak — a model
// that spams `agent_progress` after getting stuck should trip the detector
// rather than masquerade as activity. A turn that also makes a real tool call
// is unaffected.
import {
  agent_stall_apply_result,
  agent_stall_clear_current_failure,
  agent_stall_current_failure,
  agent_stall_initial_state,
  agent_stall_no_net_progress,
  agent_stall_observe_tool_calls,
  agent_stall_repair_config,
} from "std/agent/stall"
import { assert_throws } from "std/testing"

const CONFIG = {enabled: true, no_progress_messages: 3}

fn _progress_only() {
  return [{name: "agent_progress", arguments: {message: "still working"}}]
}

fn _observe(state, calls, iteration) {
  return agent_stall_observe_tool_calls("unit", calls, iteration, CONFIG, state, true, nil, "")
}

pipeline test_agent_progress_spam_trips_no_progress(task) {
  // Three consecutive turns whose only call is agent_progress → trips at the
  // third (no_progress_messages = 3). Before the fix these were treated as real
  // tool calls and never tripped.
  const o1 = _observe(agent_stall_initial_state(), _progress_only(), 1)
  assert(o1.warning == nil)
  const o2 = _observe(o1.state, _progress_only(), 2)
  assert(o2.warning == nil)
  const o3 = _observe(o2.state, _progress_only(), 3)
  assert(o3.warning != nil)
}

pipeline test_real_tool_calls_do_not_trip_no_progress(task) {
  // Real (substantive) tool calls that make genuine progress are activity — no
  // no-progress trip. The calls must be DISTINCT: three byte-identical calls
  // with no dispatch outcome would (correctly) trip the signature-only
  // repeated-same-signature fallback (threshold 3), which is thrash, not
  // progress. Distinct edits are real forward motion.
  const o1 = _observe(agent_stall_initial_state(), [{name: "edit", arguments: {path: "a.rs"}}], 1)
  const o2 = _observe(o1.state, [{name: "edit", arguments: {path: "b.rs"}}], 2)
  const o3 = _observe(o2.state, [{name: "edit", arguments: {path: "c.rs"}}], 3)
  assert(o3.warning == nil)
}

pipeline test_mixed_turn_with_real_call_is_progress(task) {
  // agent_progress alongside a real (distinct) edit is progress — the real call
  // carries the action stream, so the no-progress streak never accumulates.
  const o1 = _observe(
    agent_stall_initial_state(),
    [{name: "agent_progress", arguments: {}}, {name: "edit", arguments: {path: "a.rs"}}],
    1,
  )
  const o2 = _observe(
    o1.state,
    [{name: "agent_progress", arguments: {}}, {name: "edit", arguments: {path: "b.rs"}}],
    2,
  )
  const o3 = _observe(
    o2.state,
    [{name: "agent_progress", arguments: {}}, {name: "edit", arguments: {path: "c.rs"}}],
    3,
  )
  assert(o3.warning == nil)
}

fn _observe_parse_error(state, iteration) {
  // 0 tool calls + non-empty text, but the turn carried parser errors (the calls
  // were dropped). `had_parse_errors = true`.
  return agent_stall_observe_tool_calls(
    "unit",
    [],
    iteration,
    CONFIG,
    state,
    true,
    nil,
    "I edited the file.",
    true,
  )
}

fn _observe_text_only(state, iteration) {
  // Same shape but a genuine no-progress monologue (no parser errors).
  return agent_stall_observe_tool_calls(
    "unit",
    [],
    iteration,
    CONFIG,
    state,
    true,
    nil,
    "I edited the file.",
    false,
  )
}

pipeline test_parse_error_turn_is_not_no_progress(task) {
  // A turn whose calls were ALL dropped by the parser is a malformed-call turn,
  // not a no-progress monologue. Even across the no_progress_messages threshold
  // (3) it must NOT trip the stall detector and must NOT accumulate the
  // no-progress streak — the model already tried to act; parse-guidance feedback
  // (injected by the loop) is the correct response, not a narration-loop nudge.
  const o1 = _observe_parse_error(agent_stall_initial_state(), 1)
  assert(o1.warning == nil)
  assert(o1.state.no_progress_streak == 0)
  const o2 = _observe_parse_error(o1.state, 2)
  assert(o2.warning == nil)
  assert(o2.state.no_progress_streak == 0)
  const o3 = _observe_parse_error(o2.state, 3)
  assert(o3.warning == nil)
  assert(o3.state.no_progress_streak == 0)
}

fn _observe_errored_no_call(state, iteration) {
  // 0 tool calls + narration text, turn ended with a PROVIDER ERROR
  // (turn_stop_reason = "error"): the cheap-model eval-meter failure class.
  return agent_stall_observe_tool_calls(
    "unit",
    [],
    iteration,
    CONFIG,
    state,
    true,
    nil,
    "We need to make edit to create tests/foo_test.cpp",
    false,
    false,
    "error",
  )
}

pipeline test_errored_no_tool_call_gets_cause_specific_feedback(task) {
  // A turn that ended with a provider error and emitted no tool call gets the
  // cause-specific `errored_no_tool_call` warning (so the model is told its
  // turn errored and to re-emit the intended call), NOT the generic
  // no_progress_monologue nag.
  const o1 = _observe_errored_no_call(agent_stall_initial_state(), 1)
  assert(o1.warning == nil)
  const o2 = _observe_errored_no_call(o1.state, 2)
  assert(o2.warning == nil)
  const o3 = _observe_errored_no_call(o2.state, 3)
  assert(o3.warning != nil)
  assert(o3.warning.pattern == "errored_no_tool_call")
}

pipeline test_text_only_turn_without_parse_errors_still_trips(task) {
  // Control: the SAME 0-call + text turn WITHOUT parse errors is a real
  // no-progress monologue and must still trip at the threshold. Guards against
  // the parse-error gate accidentally disabling no-progress detection wholesale.
  const o1 = _observe_text_only(agent_stall_initial_state(), 1)
  assert(o1.warning == nil)
  assert(o1.state.no_progress_streak == 1)
  const o2 = _observe_text_only(o1.state, 2)
  assert(o2.warning == nil)
  const o3 = _observe_text_only(o2.state, 3)
  assert(o3.warning != nil)
}

/**
 * Evidence-aware repair loop: __agent_stall_fold_diagnostic purity (#repair).
 *
 * The fold is private, so we exercise it through the public observe surface
 * with `repair_aware: true`. Each observe call returns an observation whose
 * `.state` is the folded current-failure model. We drive the fold with a
 * substantive non-edit call ("run") plus a synthetic `prev_dispatch` (the
 * PRIOR turn's verification result) and the prior turn's `turn_made_edit`.
 */
const REPAIR_CONFIG = {enabled: true, repair_aware: true, stuck_same_diagnostic_after: 3, post_edit_reverify: true}

fn _run_call() {
  return [{name: "run", arguments: {cmd: "test"}}]
}

fn _fail_dispatch(error_text) {
  // A failing verification result for tool "run".
  return [{tool_name: "run", ok: false, error: error_text}]
}

fn _stale_dispatch(error_text) {
  return [{tool_name: "run", ok: false, status: "bound_stale", error: error_text}]
}

fn _ok_dispatch() {
  return [{tool_name: "run", ok: true, result: "all tests pass"}]
}

/**
 * Fold one repair turn: observe a substantive "run" call, classifying
 * `prev_dispatch` (the prior turn's result) with `prior_made_edit`.
 */
fn _fold(state, prev_dispatch, prior_made_edit) {
  return agent_stall_observe_tool_calls(
    "unit-repair",
    _run_call(),
    1,
    REPAIR_CONFIG,
    state,
    true,
    prev_dispatch,
    "",
    false,
    prior_made_edit,
  )
}

pipeline test_fold_first_failure_records_model(task) {
  // First failing verification: class "fail", streak 1, epoch 0, no edit owed.
  const o = _fold(agent_stall_initial_state(), _fail_dispatch("boom: assertion X"), false)
  assert(o.state.last_diagnostic_class == "fail")
  assert(o.state.same_diagnostic_streak == 1)
  assert(o.state.write_epoch == 0)
  assert(!o.state.reverify_owed)
  assert(o.state.last_diagnostic_snippet == "boom: assertion X")
  assert(o.warning == nil)
}

pipeline test_fold_same_failure_no_edit_increments_streak(task) {
  // Same failure twice with no intervening edit => futile retry, streak grows.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  const o2 = _fold(o1.state, _fail_dispatch("boom"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  const o3 = _fold(o2.state, _fail_dispatch("boom"), false)
  // Streak hit stuck_same_diagnostic_after (3) => trip with the new pattern.
  assert(o3.state.same_diagnostic_streak == 3)
  assert(o3.warning != nil)
  assert(o3.warning.pattern == "stuck_same_diagnostic")
  // The strategy-shift nudge is grounded in the diagnostic snippet.
  assert(o3.warning.diagnostic_snippet == "boom")
}

pipeline test_fold_location_shift_uses_verification_delta_normalization(task) {
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("src/a.rs:10:2: error E0425: missing foo"), false)
  const o2 = _fold(o1.state, _fail_dispatch("src/a.rs:99:7: error E0425: missing foo"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  assert(o2.state.last_diagnostic_delta_status == "unchanged")
}

pipeline test_fold_stale_diagnostic_does_not_feed_repair_gate(task) {
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  assert(o1.state.failing_verify_turns == 1)
  const stale = _fold(o1.state, _stale_dispatch("boom"), false)
  assert(stale.warning == nil)
  assert(stale.state.same_diagnostic_streak == 1)
  assert(stale.state.failing_verify_turns == 1)
  assert(stale.state.last_diagnostic_delta_status == "initialized")
  const fresh_again = _fold(stale.state, _fail_dispatch("boom"), false)
  assert(fresh_again.state.same_diagnostic_streak == 2)
  assert(fresh_again.warning == nil)
}

pipeline test_fold_stale_after_edit_keeps_reverify_owed(task) {
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  const stale = _fold(o1.state, _stale_dispatch("boom"), true)
  assert(stale.warning == nil)
  assert(stale.state.same_diagnostic_streak == 1)
  assert(stale.state.failing_verify_turns == 1)
  assert(stale.state.reverify_owed)
}

pipeline test_stale_diagnostic_not_generic_repeated_error_when_repair_off(task) {
  const config = {
    enabled: true,
    repair_aware: false,
    post_edit_reverify: false,
    repeat_same_error: 2,
    repeat_same_observation: 2,
    no_progress_messages: 99,
    ping_pong_cycles: 99,
  }
  const o1 = agent_stall_observe_tool_calls(
    "unit-stale-core",
    _run_call(),
    1,
    config,
    agent_stall_initial_state(),
    true,
    _stale_dispatch("boom"),
  )
  const o2 = agent_stall_observe_tool_calls(
    "unit-stale-core",
    _run_call(),
    2,
    config,
    o1.state,
    true,
    _stale_dispatch("boom"),
  )
  assert(o2.warning == nil)
  assert(o2.state.same_error_streak == 0)
  assert(o2.state.same_observation_streak == 0)
}

pipeline test_fold_productive_edit_resets_streak(task) {
  // FALSE-POSITIVE PROOF (signature-keyed): the SIGNATURE is the progress
  // signal. fail(sigA), an edit bumps the epoch (no result yet, owes a
  // re-verify), then a DIFFERENT failure (sigB) => the productive edit changed
  // the error, so the streak resets to 1 and nothing trips. A blind counter
  // would keep climbing; the evidence-aware model recognizes the progress.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom A"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  // The PRIOR turn made a successful edit (turn_made_edit = true). The fold sees
  // no new verification result this turn (prev_dispatch is the edit's ok result),
  // so it bumps the epoch and owes a re-verify; the failure model is preserved.
  const oe = _fold(o1.state, _ok_dispatch(), true)
  assert(oe.state.write_epoch == 1)
  assert(oe.state.reverify_owed)
  assert(oe.state.last_diagnostic_class == "fail")
  assert(oe.state.same_diagnostic_streak == 1)
  // A DIFFERENT failure recurs => productive edit, streak resets to 1, no trip.
  const of = _fold(oe.state, _fail_dispatch("boom B different"), false)
  assert(of.state.same_diagnostic_streak == 1)
  assert(of.warning == nil)
  // The verification result satisfied the owed re-verify.
  assert(!of.state.reverify_owed)
}

pipeline test_repair_diagnostics_nested_config_lowers_to_stall_fields(task) {
  const parsed = agent_stall_repair_config(
    {
      enabled: true,
      repair_diagnostics: {
        repair_aware: true,
        stuck_same_diagnostic_after: 4,
        post_edit_reverify: true,
        no_net_progress_extend_guard: true,
        no_net_progress_extend_after: 5,
        no_net_progress_hard_cap_after: 12,
        reserved_terminal_verify: true,
        reserved_terminal_verify_iterations: 3,
      },
    },
  )
  assert(parsed.repair_aware)
  assert_eq(parsed.stuck_same_diagnostic_after, 4)
  assert(parsed.post_edit_reverify)
  assert(parsed.no_net_progress_extend_guard)
  assert_eq(parsed.no_net_progress_extend_after, 5)
  assert_eq(parsed.no_net_progress_hard_cap_after, 12)
  assert(parsed.reserved_terminal_verify)
  assert_eq(parsed.reserved_terminal_verify_iterations, 3)
}

pipeline test_repair_diagnostics_flat_fields_override_nested(task) {
  const parsed = agent_stall_repair_config(
    {
      enabled: true,
      repair_aware: false,
      post_edit_reverify: false,
      reserved_terminal_verify: false,
      repair_diagnostics: {repair_aware: true, post_edit_reverify: true, reserved_terminal_verify: true},
    },
  )
  assert(!parsed.repair_aware)
  assert(!parsed.post_edit_reverify)
  assert(!parsed.reserved_terminal_verify)
}

pipeline test_fold_edit_retest_thrash_increments_streak(task) {
  // THRASH PROOF (the PRIMARY case): fail(sigA), edit, fail(sigA), edit,
  // fail(sigA) — separate turns, SAME failure signature across the edits. A
  // flailing edit that leaves the same error is real thrash, so the streak
  // advances ACROSS the intervening edits and trips at
  // stuck_same_diagnostic_after (3). The old epoch-keyed model reset on every
  // edit and could NEVER trip this case.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  // Edit turn: no result yet, owes a re-verify, model + streak preserved.
  const e1 = _fold(o1.state, _ok_dispatch(), true)
  assert(e1.state.same_diagnostic_streak == 1)
  assert(e1.state.reverify_owed)
  // Same failure recurs after the edit => streak advances to 2 (not reset).
  const o2 = _fold(e1.state, _fail_dispatch("boom"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  assert(!o2.state.reverify_owed)
  const e2 = _fold(o2.state, _ok_dispatch(), true)
  assert(e2.state.same_diagnostic_streak == 2)
  // Same failure recurs again => streak hits 3 => trip.
  const o3 = _fold(e2.state, _fail_dispatch("boom"), false)
  assert(o3.state.same_diagnostic_streak == 3)
  assert(o3.warning != nil)
  assert(o3.warning.pattern == "stuck_same_diagnostic")
}

pipeline test_fold_pass_clears_model(task) {
  // A passing verification clears the current-failure model entirely.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  const o2 = _fold(o1.state, _fail_dispatch("boom"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  const op = _fold(o2.state, _ok_dispatch(), false)
  assert(op.state.last_diagnostic_class == "pass")
  assert(op.state.same_diagnostic_streak == 0)
  assert(!op.state.reverify_owed)
  assert(!op.state.edit_since_failure)
  assert(op.warning == nil)
}

pipeline test_fold_different_failure_resets_streak(task) {
  // A DIFFERENT failure signature is a different mistake, not a futile retry.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom A"), false)
  const o2 = _fold(o1.state, _fail_dispatch("boom A"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  const o3 = _fold(o2.state, _fail_dispatch("totally different B"), false)
  assert(o3.state.same_diagnostic_streak == 1)
  assert(o3.warning == nil)
}

pipeline test_fold_repair_off_tracks_for_reverify_without_nudge(task) {
  // repair_aware:false disables the strategy-shift nudge, not the
  // current-failure model used by post-edit final verification.
  const off_config = {
    enabled: true,
    repair_aware: false,
    stuck_same_diagnostic_after: 2,
    repeat_same_error: 99,
    repeat_same_observation: 99,
    no_progress_messages: 99,
    ping_pong_cycles: 99,
  }
  const o1 = agent_stall_observe_tool_calls(
    "unit-repair-off",
    _run_call(),
    1,
    off_config,
    agent_stall_initial_state(),
    true,
    _fail_dispatch("boom"),
    "",
    false,
    false,
  )
  assert(o1.state.last_diagnostic_class == "fail")
  assert(o1.state.same_diagnostic_streak == 1)
  assert(!o1.state.reverify_owed)
  assert(o1.warning == nil)
  const o2 = agent_stall_observe_tool_calls(
    "unit-repair-off",
    _run_call(),
    2,
    off_config,
    o1.state,
    true,
    _fail_dispatch("boom"),
    "",
    false,
    false,
  )
  assert(o2.warning == nil)
  assert(o2.state.same_diagnostic_streak == 2)
}

pipeline test_reset_action_preserves_failure_model(task) {
  // The current-failure model must SURVIVE a tool-stream reset: a different
  // corrective action does not clear "same root failure". We force a reset by
  // observing an exempt tool after a recorded failure, and assert the repair
  // fields persist.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  const o2 = _fold(o1.state, _fail_dispatch("boom"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  assert(o2.state.last_diagnostic_class == "fail")
  // An exempt tool triggers __agent_stall_reset_action inside the core observe.
  const reset_config = REPAIR_CONFIG + {exempt_tools: ["search"]}
  const o3 = agent_stall_observe_tool_calls(
    "unit-repair",
    [{name: "search", arguments: {q: "x"}}],
    3,
    reset_config,
    o2.state,
    true,
    nil,
    "",
    false,
    false,
  )
  // Action-stream fields were reset, but the current-failure model survives.
  assert(o3.state.last_signature == "")
  assert(o3.state.last_diagnostic_class == "fail")
  assert(o3.state.same_diagnostic_streak == 2)
  assert(o3.state.last_diagnostic_signature == o2.state.last_diagnostic_signature)
}

pipeline test_clear_current_failure_on_success(task) {
  // FIX #2: a SUCCESSFUL terminal hand-back must not carry a stale failure. A
  // run can end (clean done / verify_completion pass) without ever folding a
  // passing result, leaving last_diagnostic_class == "fail". The loop clears
  // the model on the successful-termination signal before projecting it.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  const o2 = _fold(o1.state, _fail_dispatch("boom"), false)
  assert(o2.state.last_diagnostic_class == "fail")
  // A live failure projects a current_failure on a STUCK hand-back.
  assert(agent_stall_current_failure(o2.state) != nil)
  // Clearing on success drops the stale failure.
  const cleared = agent_stall_clear_current_failure(o2.state)
  assert(agent_stall_current_failure(cleared) == nil)
  assert(cleared.last_diagnostic_class == "pass")
  assert(cleared.same_diagnostic_streak == 0)
  assert(!cleared.reverify_owed)
}

// -------------------------------------------------------------------------------------------------

// Budget-extension guard: agent_stall_no_net_progress. This is the harn-side
// twin of burin's no-net-progress ripcord. The default loop extension policy
// treats any tool-calling turn as "progress" and keeps extending the iteration
// budget; this guard reports when a turn is a no-net-advancement thrash so the
// loop can stop extending. Default OFF, gated on the verify-bearing failing
// path, and resets on genuine progress.

// -------------------------------------------------------------------------------------------------

// Guard ON; same threshold (3) as the stuck nudge for these tests.
const GUARD_CONFIG = {
  enabled: true,
  repair_aware: true,
  stuck_same_diagnostic_after: 3,
  post_edit_reverify: true,
  no_net_progress_extend_guard: true,
  no_net_progress_extend_after: 3,
  no_net_progress_hard_cap_after: 16,
}

const STALE_GUARD_CONFIG = {
  enabled: true,
  repair_aware: true,
  stuck_same_diagnostic_after: 3,
  post_edit_reverify: true,
  no_net_progress_extend_guard: true,
  no_net_progress_extend_after: 3,
  no_net_progress_hard_cap_after: 16,
  repeat_same_error: 99,
  repeat_same_observation: 99,
  no_progress_messages: 99,
  ping_pong_cycles: 99,
}

fn _fold_guarded(state, prev_dispatch, prior_made_edit) {
  return agent_stall_observe_tool_calls(
    "unit-guard",
    _run_call(),
    1,
    GUARD_CONFIG,
    state,
    true,
    prev_dispatch,
    "",
    false,
    prior_made_edit,
  )
}

fn _fold_stale_guarded(state, prev_dispatch, prior_made_edit) {
  return agent_stall_observe_tool_calls(
    "unit-stale-guard",
    _run_call(),
    1,
    STALE_GUARD_CONFIG,
    state,
    true,
    prev_dispatch,
    "",
    false,
    prior_made_edit,
  )
}

pipeline test_no_net_progress_default_off(task) {
  // (a)/(default) Guard OFF (REPAIR_CONFIG has no guard flag): even a long thrash
  // streak never reports no-net-progress => today's behavior is preserved.
  const o1 = _fold(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  const o2 = _fold(o1.state, _fail_dispatch("boom"), false)
  const o3 = _fold(o2.state, _fail_dispatch("boom"), false)
  assert(o3.state.same_diagnostic_streak == 3)
  assert(!agent_stall_no_net_progress(REPAIR_CONFIG, o3.state))
}

pipeline test_no_net_progress_thrash_trips_once_armed(task) {
  // (a) Guard ON: a thrash (same failure recurring every turn, no draining)
  // crosses the threshold and IS reported as no-net-progress, so the loop stops
  // extending. Below threshold it is NOT reported (conservative).
  const o1 = _fold_guarded(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  assert(!agent_stall_no_net_progress(GUARD_CONFIG, o1.state))
  const o2 = _fold_guarded(o1.state, _fail_dispatch("boom"), false)
  assert(o2.state.same_diagnostic_streak == 2)
  assert(!agent_stall_no_net_progress(GUARD_CONFIG, o2.state))
  const o3 = _fold_guarded(o2.state, _fail_dispatch("boom"), false)
  assert(o3.state.same_diagnostic_streak == 3)
  assert(agent_stall_no_net_progress(GUARD_CONFIG, o3.state))
}

pipeline test_no_net_progress_productive_run_keeps_budget(task) {
  // (b) Guard ON: a genuinely-progressing run where each turn changes the error
  // (a productive edit shifts the signature => streak resets to 1) NEVER reports
  // no-net-progress, so its budget is preserved. Errors draining is progress.
  const o1 = _fold_guarded(agent_stall_initial_state(), _fail_dispatch("error A"), true)
  const o2 = _fold_guarded(o1.state, _fail_dispatch("error B"), true)
  const o3 = _fold_guarded(o2.state, _fail_dispatch("error C"), true)
  assert(o3.state.same_diagnostic_streak == 1)
  assert(!agent_stall_no_net_progress(GUARD_CONFIG, o3.state))
}

pipeline test_no_net_progress_pass_keeps_budget(task) {
  // (b) Guard ON: a turn whose verification PASSES clears the failure model
  // (class != "fail") so it never reports no-net-progress even after a prior
  // thrash streak — a failing-then-passing run still progresses.
  const o1 = _fold_guarded(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  const o2 = _fold_guarded(o1.state, _fail_dispatch("boom"), false)
  const op = _fold_guarded(o2.state, _ok_dispatch(), false)
  assert(op.state.last_diagnostic_class == "pass")
  assert(!agent_stall_no_net_progress(GUARD_CONFIG, op.state))
}

pipeline test_no_net_progress_explore_turn_not_starved(task) {
  // (c) Guard ON: a read-only / explore turn has no failing verification, so the
  // failure model is never armed (class stays "") and the guard NEVER reports
  // no-net-progress. Legitimately-exploring turns are not starved of budget.
  const initial = agent_stall_initial_state()
  assert(initial.last_diagnostic_class != "fail")
  assert(!agent_stall_no_net_progress(GUARD_CONFIG, initial))
  // A turn with no verification result (e.g. pure read/list) leaves the model
  // untouched => still not reported.
  const o = _fold_guarded(initial, nil, false)
  assert(o.state.last_diagnostic_class != "fail")
  assert(!agent_stall_no_net_progress(GUARD_CONFIG, o.state))
}

pipeline test_no_net_progress_ignores_stale_diagnostics(task) {
  const o1 = _fold_stale_guarded(agent_stall_initial_state(), _fail_dispatch("boom"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  assert(o1.state.failing_verify_turns == 1)
  const stale1 = _fold_stale_guarded(o1.state, _stale_dispatch("boom"), false)
  const stale2 = _fold_stale_guarded(stale1.state, _stale_dispatch("boom"), false)
  assert(stale2.warning == nil)
  assert(stale2.state.same_diagnostic_streak == 1)
  assert(stale2.state.failing_verify_turns == 1)
  assert(!agent_stall_no_net_progress(STALE_GUARD_CONFIG, stale2.state))
  const fresh_again = _fold_stale_guarded(stale2.state, _fail_dispatch("boom"), false)
  assert(fresh_again.state.same_diagnostic_streak == 2)
  assert(!agent_stall_no_net_progress(STALE_GUARD_CONFIG, fresh_again.state))
}

const HARD_CAP_CONFIG = {
  enabled: true,
  repair_aware: false,
  post_edit_reverify: true,
  no_net_progress_extend_guard: true,
  no_net_progress_extend_after: 99,
  no_net_progress_hard_cap_after: 3,
  repeat_same_error: 99,
  repeat_same_observation: 99,
  no_progress_messages: 99,
  ping_pong_cycles: 99,
}

fn _fold_hard_cap(state, prev_dispatch, prior_made_edit) {
  return agent_stall_observe_tool_calls(
    "unit-hard-cap",
    _run_call(),
    1,
    HARD_CAP_CONFIG,
    state,
    true,
    prev_dispatch,
    "",
    false,
    prior_made_edit,
  )
}

pipeline test_no_net_progress_hard_cap_trips_on_varied_failures(task) {
  // A slow-draining failing run can keep changing the error signature, so the
  // same-diagnostic streak never reaches the no-net threshold. The hard cap is
  // deliberately signature-agnostic: three failing verify turns without a clean
  // pass trips the terminal stuck path anyway.
  const o1 = _fold_hard_cap(agent_stall_initial_state(), _fail_dispatch("error A"), false)
  assert(o1.state.same_diagnostic_streak == 1)
  assert(o1.state.failing_verify_turns == 1)
  assert(o1.warning == nil)
  assert(!agent_stall_no_net_progress(HARD_CAP_CONFIG, o1.state))
  const o2 = _fold_hard_cap(o1.state, _fail_dispatch("error B"), false)
  assert(o2.state.same_diagnostic_streak == 1)
  assert(o2.state.failing_verify_turns == 2)
  assert(o2.warning == nil)
  assert(!agent_stall_no_net_progress(HARD_CAP_CONFIG, o2.state))
  const o3 = _fold_hard_cap(o2.state, _fail_dispatch("error C"), false)
  assert(o3.state.same_diagnostic_streak == 1)
  assert(o3.state.failing_verify_turns == 3)
  assert(o3.warning != nil)
  assert(o3.warning.pattern == "no_net_progress_hard_cap")
  assert(o3.hard_stop)
  assert(o3.state.hard_stop)
  assert(agent_stall_no_net_progress(HARD_CAP_CONFIG, o3.state))
}

pipeline test_no_net_progress_hard_cap_resets_only_on_clean_verify(task) {
  const o1 = _fold_hard_cap(agent_stall_initial_state(), _fail_dispatch("error A"), false)
  const o2 = _fold_hard_cap(o1.state, _fail_dispatch("error B"), false)
  assert(o2.state.failing_verify_turns == 2)
  const pass = _fold_hard_cap(o2.state, _ok_dispatch(), false)
  assert(pass.state.last_diagnostic_class == "pass")
  assert(pass.state.failing_verify_turns == 0)
  assert(!agent_stall_no_net_progress(HARD_CAP_CONFIG, pass.state))
  const fail_after_pass = _fold_hard_cap(pass.state, _fail_dispatch("error C"), false)
  assert(fail_after_pass.state.failing_verify_turns == 1)
  assert(fail_after_pass.warning == nil)
}

pipeline test_no_net_progress_hard_cap_preserves_across_edit_success(task) {
  // Edit success is not a clean verification. It should preserve the failing
  // verify counter so a model cannot evade the cap by interleaving successful
  // writes with still-red verifies.
  const o1 = _fold_hard_cap(agent_stall_initial_state(), _fail_dispatch("error A"), false)
  const edit_ok = _fold_hard_cap(o1.state, _ok_dispatch(), true)
  assert(edit_ok.state.reverify_owed)
  assert(edit_ok.state.failing_verify_turns == 1)
  const o2 = _fold_hard_cap(edit_ok.state, _fail_dispatch("error B"), false)
  assert(o2.state.failing_verify_turns == 2)
  assert(o2.warning == nil)
}

// -------------------------------------------------------------------------------------------------
// #burin-cutover seam 4: per-turn action-signal intake (single-occurrence flailing trip).
// #burin-cutover seam 5: turns_since_clean_verify elapsed-turns hard floor.
// Both are strictly additive and default-off; the parity test below is the anti-regression gate.
// -------------------------------------------------------------------------------------------------

fn _observe_signal(state, cfg, payload) {
  // Substantive "run" call with no prior dispatch: the core/repair paths never
  // trip on this turn, so any warning comes purely from the action_signal seam.
  return agent_stall_observe_tool_calls(
    "unit-signal",
    _run_call(),
    1,
    cfg,
    state,
    true,
    nil,
    "",
    false,
    false,
    "",
    payload,
  )
}

fn _observe_noprog_signal(state, cfg, text, payload) {
  // No substantive tool call + narration text = a no-progress-monologue candidate,
  // used to prove the action_signal seam does not double-fire when the core already
  // tripped this turn.
  return agent_stall_observe_tool_calls(
    "unit-signal-noprog",
    [],
    1,
    cfg,
    state,
    true,
    nil,
    text,
    false,
    false,
    "",
    payload,
  )
}

pipeline test_action_signal_trips_on_single_flailing_action(task) {
  // A truthy action_signal callback trips IMMEDIATELY on a single turn (no streak)
  // with the distinct `flailing_action` pattern, riding the existing warning event.
  const cfg = {enabled: true, action_signal: { _p -> true }, post_edit_reverify: false, repair_aware: false}
  const o = _observe_signal(agent_stall_initial_state(), cfg, {any: "payload"})
  assert(o.warning != nil)
  assert(o.warning.pattern == "flailing_action")
  assert_eq(o.warning.count, 1)
  // First trip is a warning, not yet a hard stop (standard consecutive-trip escalation).
  assert(!o.hard_stop)
  assert_eq(o.state.consecutive_trips, 1)
}

pipeline test_action_signal_receives_payload_and_gates_on_return(task) {
  // The callback receives the full post-turn payload; only a truthy return trips.
  const cfg = {enabled: true, action_signal: { p -> p?.flail == true }, post_edit_reverify: false}
  const trips = _observe_signal(agent_stall_initial_state(), cfg, {flail: true})
  assert(trips.warning != nil)
  assert(trips.warning.pattern == "flailing_action")
  const quiet = _observe_signal(agent_stall_initial_state(), cfg, {flail: false})
  assert(quiet.warning == nil)
}

pipeline test_action_signal_repeated_flailing_escalates_to_hard_stop(task) {
  // Repeated flailing rides the standard consecutive-trip escalation and reaches a
  // hard stop at `hard_stop_after_trips` (default 3).
  const cfg = {enabled: true, action_signal: { _p -> true }, post_edit_reverify: false, repair_aware: false}
  const o1 = _observe_signal(agent_stall_initial_state(), cfg, {})
  assert(!o1.hard_stop)
  const o2 = _observe_signal(o1.state, cfg, {})
  assert(!o2.hard_stop)
  const o3 = _observe_signal(o2.state, cfg, {})
  assert(o3.warning.pattern == "flailing_action")
  assert(o3.hard_stop)
}

pipeline test_action_signal_unset_is_inert(task) {
  // No action_signal callback: even a payload that WOULD flail produces no trip —
  // the seam is invisible by default.
  const cfg = {enabled: true, post_edit_reverify: false, repair_aware: false}
  const o = _observe_signal(agent_stall_initial_state(), cfg, {flail: true})
  assert(o.warning == nil)
}

pipeline test_action_signal_does_not_double_fire_when_core_tripped(task) {
  // One warning per turn: when the core no-progress detector already tripped this
  // turn, a truthy action_signal is skipped (the core warning wins, no double-nudge).
  const cfg = {enabled: true, action_signal: { p -> p?.flail == true }, no_progress_messages: 3, post_edit_reverify: false}
  const o1 = _observe_noprog_signal(agent_stall_initial_state(), cfg, "thinking", {flail: false})
  assert(o1.warning == nil)
  const o2 = _observe_noprog_signal(o1.state, cfg, "thinking", {flail: false})
  assert(o2.warning == nil)
  // Turn 3 trips no_progress in the core AND the action_signal would fire — the core
  // warning must win.
  const o3 = _observe_noprog_signal(o2.state, cfg, "thinking", {flail: true})
  assert(o3.warning != nil)
  assert(o3.warning.pattern == "no_progress_monologue")
}

pipeline test_action_signal_validated_loudly_at_config_time(task) {
  // A mistyped action_signal fails loudly at config parse time, like the sibling seams.
  assert_throws(
    { -> return _observe_signal(agent_stall_initial_state(), {enabled: true, action_signal: "not-a-closure"}, {}) },
    "non-closure action_signal must throw",
  )
}

const FLOOR_CONFIG = {
  enabled: true,
  repair_aware: false,
  post_edit_reverify: true,
  turns_since_clean_verify: 4,
  repeat_same_error: 99,
  repeat_same_observation: 99,
  no_progress_messages: 99,
  ping_pong_cycles: 99,
}

fn _fold_floor(state, cfg, prev_dispatch, prior_made_edit) {
  return agent_stall_observe_tool_calls(
    "unit-floor",
    _run_call(),
    1,
    cfg,
    state,
    true,
    prev_dispatch,
    "",
    false,
    prior_made_edit,
  )
}

pipeline test_turns_since_clean_verify_floor_trips_on_elapsed_turns(task) {
  // The elapsed-turns floor counts EVERY folded turn since the last clean verify and
  // trips at the caller-set floor (4) — even mixing edits and reads that never build
  // the failing-verify counter. Here all four turns fail, so tscv climbs 1..4 and
  // trips a terminal hard stop at turn 4.
  const o1 = _fold_floor(agent_stall_initial_state(), FLOOR_CONFIG, _fail_dispatch("boom A"), false)
  assert_eq(o1.state.turns_since_clean_verify, 1)
  assert(o1.warning == nil)
  const o2 = _fold_floor(o1.state, FLOOR_CONFIG, _fail_dispatch("boom B"), false)
  assert_eq(o2.state.turns_since_clean_verify, 2)
  assert(o2.warning == nil)
  const o3 = _fold_floor(o2.state, FLOOR_CONFIG, _fail_dispatch("boom C"), false)
  assert_eq(o3.state.turns_since_clean_verify, 3)
  assert(o3.warning == nil)
  const o4 = _fold_floor(o3.state, FLOOR_CONFIG, _fail_dispatch("boom D"), false)
  assert(o4.warning != nil)
  assert(o4.warning.pattern == "turns_since_clean_verify_floor")
  assert_eq(o4.warning.count, 4)
  assert(o4.warning.hard_stop)
  assert(o4.hard_stop)
}

pipeline test_turns_since_clean_verify_floor_resets_on_clean_pass(task) {
  // A clean passing verification resets the elapsed-turns counter, so the floor keys
  // on "turns since the LAST clean verify", not total run length.
  const o1 = _fold_floor(agent_stall_initial_state(), FLOOR_CONFIG, _fail_dispatch("boom A"), false)
  const o2 = _fold_floor(o1.state, FLOOR_CONFIG, _fail_dispatch("boom B"), false)
  assert_eq(o2.state.turns_since_clean_verify, 2)
  const pass = _fold_floor(o2.state, FLOOR_CONFIG, _ok_dispatch(), false)
  assert_eq(pass.state.turns_since_clean_verify, 0)
  assert(pass.warning == nil)
  const after = _fold_floor(pass.state, FLOOR_CONFIG, _fail_dispatch("boom C"), false)
  assert_eq(after.state.turns_since_clean_verify, 1)
  assert(after.warning == nil)
}

pipeline test_turns_since_clean_verify_floor_unset_is_inert(task) {
  // With no floor knob the counter is still maintained (cheap) but NEVER trips — even
  // across many more turns than any set floor would allow.
  const cfg = FLOOR_CONFIG + {turns_since_clean_verify: nil}
  let s = agent_stall_initial_state()
  let i = 0
  while i < 8 {
    const o = _fold_floor(s, cfg, _fail_dispatch("boom X"), false)
    assert(o.warning == nil)
    s = o.state
    i = i + 1
  }
  assert_eq(s.turns_since_clean_verify, 8)
}

pipeline test_turns_since_clean_verify_floor_validated_loudly(task) {
  // A non-positive / mistyped floor fails loudly at config time.
  assert_throws(
    { -> return _fold_floor(agent_stall_initial_state(), FLOOR_CONFIG + {turns_since_clean_verify: 0}, _fail_dispatch("boom"), false) },
    "non-positive turns_since_clean_verify must throw",
  )
  assert_throws(
    { -> return _fold_floor(agent_stall_initial_state(), FLOOR_CONFIG + {turns_since_clean_verify: "many"}, _fail_dispatch("boom"), false) },
    "non-int turns_since_clean_verify must throw",
  )
}

fn _parity_drive(cfg) {
  // Canonical edit-retest thrash: fail(boom), edit, fail(boom), edit, fail(boom).
  // Pre-seam behavior trips stuck_same_diagnostic exactly once, at streak 3.
  let s = agent_stall_initial_state()
  let out = []
  const seq = [
    [_fail_dispatch("boom"), false],
    [_ok_dispatch(), true],
    [_fail_dispatch("boom"), false],
    [_ok_dispatch(), true],
    [_fail_dispatch("boom"), false],
  ]
  for step in seq {
    const o = agent_stall_observe_tool_calls("parity", _run_call(), 1, cfg, s, true, step[0], "", false, step[1])
    s = o.state
    out = out.push({
      pattern: o.warning?.pattern,
      hard_stop: o.hard_stop,
      streak: o.state.same_diagnostic_streak,
      failing: o.state.failing_verify_turns,
    })
  }
  return {steps: out, final: s}
}

pipeline test_new_seams_unset_are_byte_identical(task) {
  // ANTI-REGRESSION GATE. With the two new knobs UNSET, every decision must be
  // byte-identical to pre-seam behavior. Drive the canonical thrash sequence under
  // two configs — one that never mentions the new fields, one that sets them to their
  // OFF value (nil) — and assert the decision stream is byte-for-byte equal AND matches
  // the known pre-seam outcome (a single stuck_same_diagnostic trip at streak 3). If a
  // future edit perturbs default behavior, this equality/known-outcome pair breaks.
  const base = {enabled: true, repair_aware: true, stuck_same_diagnostic_after: 3, post_edit_reverify: true}
  const with_off = base + {action_signal: nil, turns_since_clean_verify: nil}
  const a = _parity_drive(base)
  const b = _parity_drive(with_off)
  // Byte-identical decision stream: unset == absent.
  assert_eq(json_stringify(a.steps), json_stringify(b.steps))
  // Known pre-seam decisions preserved: no trip until streak 3, then stuck_same_diagnostic.
  assert(a.steps[0].pattern == nil)
  assert(a.steps[2].pattern == nil)
  assert(a.steps[4].pattern == "stuck_same_diagnostic")
  assert_eq(a.steps[4].streak, 3)
  // The internal turns_since_clean_verify counter must NEVER surface in any
  // eval-fleet-consumed output projection (warnings / current_failure / apply_result),
  // so the live eval measurements are unchanged.
  const applied = agent_stall_apply_result({status: "stuck"}, true, a.final)
  assert(!contains(json_stringify(applied), "turns_since_clean_verify"))
}
