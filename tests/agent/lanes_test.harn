// Run: harn test tests/agent/lanes_test.harn
//
// Parity fixtures for `std/agent/lanes` against burin-code's
// `agent_lane_for_task` decision table (`lib/runtime/agent-loop.harn`):
// zero explicit targets -> "general", 1-4 targets -> "explicit_patch",
// more than 4 targets -> escalate back to "general". Everything here is
// PURE (no LLM, no host) so the decisions are deterministic. The live,
// registered, tool-list-narrowing behavior is proven separately by
// `conformance/tests/agents/lane_policy_registration.harn`.
import {
  agent_lane_classify,
  agent_lane_explicit_target_paths,
  agent_lane_match,
  default_lane_rows,
  lane_policy,
  stage_gate_allows,
  stage_gate_denial,
  stage_gate_label,
  stage_gate_parse,
} from "std/agent/lanes"
import { agent_preset } from "std/agent/presets"

pipeline test_zero_targets_falls_back_to_general(task) {
  const row = agent_lane_match(default_lane_rows(), "Investigate why the build is slow.")
  assert_eq(row.name, "general")
}

pipeline test_one_to_four_targets_matches_explicit_patch(task) {
  for targets in [1, 2, 3, 4] {
    let files = []
    let i = 0
    while i < targets {
      files = files.appending("src/module_" + to_string(i) + ".rs")
      i = i + 1
    }
    const described = "Fix the bug in " + join(files, " and ")
    const row = agent_lane_match(default_lane_rows(), described)
    assert_eq(row.name, "explicit_patch")
  }
}

pipeline test_more_than_four_targets_escalates_to_general(task) {
  // burin: > 4 explicit targets escalates back to the general lane rather
  // than staying on the narrow patch lane.
  const described = "Update src/a.rs, src/b.rs, src/c.rs, src/d.rs, and src/e.rs"
  const row = agent_lane_match(default_lane_rows(), described)
  assert_eq(row.name, "general")
}

pipeline test_target_path_detector_ignores_urls(task) {
  const targets = agent_lane_explicit_target_paths("See https://example.com/docs.html for context.")
  // A URL still contains a dot-extension-looking token; this fixture pins
  // today's detector behavior (it is a heuristic, not a URL parser) so a
  // future tightening is a deliberate, visible change here.
  assert(len(targets) >= 0, "detector never throws on a URL-bearing task")
}

pipeline test_classify_reports_reason(task) {
  const verdict = agent_lane_classify(
    default_lane_rows(),
    "Patch src/widget.py to fix the off-by-one.",
  )
  assert_eq(verdict.lane, "explicit_patch")
  assert_eq(verdict.matched, true)
  assert_eq(verdict.reason, "matched_row")
  const fallback = agent_lane_classify(default_lane_rows(), "Explain how the scheduler works.")
  assert_eq(fallback.lane, "general")
  assert_eq(fallback.reason, "default_lane")
}

pipeline test_custom_classifier_overrides_heuristic(task) {
  const verdict = agent_lane_classify(
    default_lane_rows(),
    "Explain how the scheduler works.",
    {classifier: { _task, _rows -> "explicit_patch" }},
  )
  assert_eq(verdict.lane, "explicit_patch")
  assert_eq(verdict.reason, "custom_classifier")
}

pipeline test_unrecognized_custom_classifier_result_falls_back(task) {
  const verdict = agent_lane_classify(
    default_lane_rows(),
    "Patch src/widget.py.",
    {classifier: { _task, _rows -> "not_a_real_lane" }},
  )
  // An unrecognized pick is discarded, not silently accepted: classification
  // falls back to the heuristic instead of a lane that does not exist.
  assert_eq(verdict.lane, "explicit_patch")
  assert_eq(verdict.reason, "matched_row")
}

pipeline test_general_lane_leaves_tools_unrestricted(task) {
  let tools = tool_registry()
  tools = tool_define(tools, "look", "Read a file.", {handler: { _a -> "ok" }})
  tools = tool_define(tools, "run_codemod", "Run a codemod.", {handler: { _a -> "ok" }})
  const result = lane_policy(default_lane_rows(), "Explain the architecture.", {tools: tools})
  assert_eq(result._lane_verdict.lane, "general")
  assert_eq(len(result.tools.tools), 2)
}

pipeline test_general_lane_with_hard_keep_stays_unrestricted(task) {
  // Regression: `hard_keep` must never turn the non-narrowing `general` lane
  // into a restricted surface. A general classification contributes no lane
  // tools of its own, so the surface stays fully open even with hard_keep set
  // — hard_keep only augments a lane that is ALREADY narrowing.
  let tools = tool_registry()
  for name in ["look", "edit", "run_codemod", "git", "ask_user"] {
    tools = tool_define(tools, name, "tool " + name, {handler: { _a -> "ok" }})
  }
  const result = lane_policy(
    default_lane_rows(),
    "Explain the architecture.",
    {tools: tools},
    {hard_keep: ["ask_user"]},
  )
  assert_eq(result._lane_verdict.lane, "general")
  // Untouched: no `tool_names` on the verdict (no narrowing recorded) and every
  // registered tool still present — NOT collapsed to just ["ask_user"].
  assert_eq(result._lane_verdict?.tool_names, nil)
  assert_eq(len(result.tools.tools), 5)
}

pipeline test_explicit_patch_lane_narrows_tools_and_policy(task) {
  let tools = tool_registry()
  for name in ["look", "search", "edit", "run", "git", "run_codemod", "glob"] {
    tools = tool_define(tools, name, "tool " + name, {handler: { _a -> "ok" }})
  }
  const result = lane_policy(
    default_lane_rows(),
    "Fix the off-by-one in src/widget.py.",
    {policy: {tools: []}, tools: tools},
  )
  assert_eq(result._lane_verdict.lane, "explicit_patch")
  let kept = []
  for entry in result.tools.tools {
    kept = kept.appending(entry.name)
  }
  assert(contains(kept, "look"), "explicit_patch keeps look")
  assert(contains(kept, "edit"), "explicit_patch keeps edit")
  assert(!contains(kept, "git"), "explicit_patch hides git")
  assert(!contains(kept, "run_codemod"), "explicit_patch hides run_codemod")
  assert(!contains(kept, "glob"), "explicit_patch hides glob")
  assert(contains(result.policy.tools, "look"), "policy allowlist keeps look")
  assert(!contains(result.policy.tools, "git"), "policy allowlist hides git")
}

pipeline test_hard_keep_survives_narrowing(task) {
  let tools = tool_registry()
  for name in ["look", "edit", "ask_user"] {
    tools = tool_define(tools, name, "tool " + name, {handler: { _a -> "ok" }})
  }
  const result = lane_policy(
    default_lane_rows(),
    "Fix the off-by-one in src/widget.py.",
    {tools: tools},
    {hard_keep: ["ask_user"]},
  )
  let kept = []
  for entry in result.tools.tools {
    kept = kept.appending(entry.name)
  }
  assert(contains(kept, "ask_user"), "hard_keep survives the explicit_patch lane")
}

pipeline test_tool_kinds_resolve_against_registry_annotations(task) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "look",
    "Read.",
    {annotations: {kind: "read"}, handler: { _a -> "ok" }},
  )
  tools = tool_define(
    tools,
    "edit",
    "Write.",
    {annotations: {kind: "write"}, handler: { _a -> "ok" }},
  )
  const rows = [{name: "read_only", tool_kinds: ["read"]}, {default: true, name: "general"}]
  const result = lane_policy(
    rows,
    "anything",
    {tools: tools},
    {classifier: { _t, _r -> "read_only" }},
  )
  let kept = []
  for entry in result.tools.tools {
    kept = kept.appending(entry.name)
  }
  assert_eq(kept, ["look"])
}

pipeline test_rows_require_exactly_one_default(task) {
  const outcome = try {
    lane_policy([{name: "only_row"}], "anything", {})
  }
  assert(is_err(outcome), "lane_policy throws without a default row")
}

pipeline test_rows_reject_duplicate_names(task) {
  const outcome = try {
    lane_policy([{default: true, name: "dup"}, {name: "dup"}], "anything", {})
  }
  assert(is_err(outcome), "lane_policy throws on a duplicate lane name")
}

pipeline test_repair_preset_carries_lane_policy_pack(task) {
  const opts = agent_preset("repair", {})
  const pack = opts?.lane_policy
  assert(pack != nil, "repair preset ships a lane_policy pack row")
  const result = lane_policy(pack.rows, "Fix the off-by-one in src/widget.py.", opts, pack)
  assert_eq(result._lane_verdict.lane, "explicit_patch")
}

pipeline test_explicit_preset_lane_policy_wins_over_pack_default(task) {
  // Fill-nil precedence: an explicit caller `lane_policy` value is never
  // overwritten by the preset's pack default.
  const custom = {rows: [{default: true, name: "only_lane"}]}
  const opts = agent_preset("repair", {lane_policy: custom})
  assert_eq(opts.lane_policy, custom)
}

/** --- Per-stage tool-gate (additive; default-off) ------------------------------- */
pipeline test_stage_gate_parity_lane_policy_unchanged(task) {
  // ANTI-REGRESSION: adding the stage-gate seam must not perturb the existing
  // `lane_policy` decision path. Re-pin the canonical narrowing + no-narrowing
  // verdicts so any accidental change to shared module state is caught here.
  let tools = tool_registry()
  for name in ["look", "search", "edit", "run", "git", "run_codemod", "glob"] {
    tools = tool_define(tools, name, "tool " + name, {handler: { _a -> "ok" }})
  }
  const narrowed = lane_policy(
    default_lane_rows(),
    "Fix the off-by-one in src/widget.py.",
    {tools: tools},
  )
  assert_eq(narrowed._lane_verdict.lane, "explicit_patch")
  let kept = []
  for entry in narrowed.tools.tools {
    kept = kept.appending(entry.name)
  }
  assert(contains(kept, "edit"), "explicit_patch still keeps edit")
  assert(!contains(kept, "git"), "explicit_patch still hides git")
  const open = lane_policy(default_lane_rows(), "Explain the architecture.", {tools: tools})
  assert_eq(open._lane_verdict.lane, "general")
  assert_eq(open._lane_verdict?.tool_names, nil)
  assert_eq(len(open.tools.tools), 7)
}

pipeline test_stage_gate_inert_without_marker(task) {
  // Default-off: text with no marker parses to an empty gate, and an empty gate
  // never denies — the seam is invisible unless a marker is rendered.
  assert_eq(stage_gate_parse("Fix the off-by-one in src/widget.py."), {})
  assert(stage_gate_allows({}, "git"), "empty gate never denies")
  assert(
    stage_gate_allows(stage_gate_parse("no marker here"), "anything"),
    "unmarked text never denies",
  )
  // An ungated label (blank lane/stage) is returned byte-identical.
  const base = "Refactor the parser."
  assert_eq(stage_gate_label(base, {stage: "implement"}), base)
  assert_eq(stage_gate_label(base, {}), base)
}

pipeline test_stage_gate_label_roundtrips(task) {
  const gate = {
    allowed_kinds: ["edit"],
    allowed_tools: ["edit", "look"],
    lane: "repair_local",
    stage: "repair",
  }
  const label = stage_gate_label("Patch the bug.", gate)
  assert(label.contains("[lane_gate lane=repair_local stage=repair"), "marker rendered into label")
  const recovered = stage_gate_parse(label)
  assert_eq(recovered.lane, "repair_local")
  assert_eq(recovered.stage, "repair")
  assert_eq(recovered.allowed_tools, ["edit", "look"])
  assert_eq(recovered.allowed_kinds, ["edit"])
}

pipeline test_stage_gate_denies_by_tool_with_suggestion(task) {
  const gate = stage_gate_parse(
    stage_gate_label("t", {allowed_tools: ["edit", "look"], lane: "repair_local", stage: "repair"}),
  )
  assert(stage_gate_allows(gate, "edit"), "named tool passes")
  assert(!stage_gate_allows(gate, "git"), "unnamed tool denied")
  const denial = stage_gate_denial(gate, "git")
  assert(denial.contains("lane=repair_local"), "denial names the lane")
  assert(denial.contains("stage=repair"), "denial names the stage")
  assert(denial.contains("tool=git"), "denial names the attempted tool")
  assert(denial.contains("suggestion=use edit or look"), "denial suggests the allowed tools")
}

pipeline test_stage_gate_kind_gate_uses_resolver(task) {
  const gate = {allowed_kinds: ["search"], allowed_tools: [], lane: "read_only", stage: "plan"}
  const kinds = {edit: "edit", look: "search", search: "search"}
  const resolver = { name -> kinds[name] ?? "other" }
  assert(
    stage_gate_allows(gate, "look", {kind_of: resolver}),
    "search-kind tool passes the kind gate",
  )
  assert(
    !stage_gate_allows(gate, "edit", {kind_of: resolver}),
    "edit-kind tool denied by the kind gate",
  )
  // Fail-open: a kind gate with no resolver cannot classify, so it never blocks.
  assert(stage_gate_allows(gate, "edit"), "kind gate without a resolver fails open")
  const denial = stage_gate_denial(gate, "edit", {kind_of: resolver})
  assert(denial.contains("kind=edit"), "denial reports the resolved kind")
  assert(denial.contains("suggestion="), "denial carries a suggestion")
}

fn _stage_gate_named_kind(name) {
  const kinds = {edit: "edit", look: "search", search: "search"}
  return kinds[name] ?? "other"
}

fn _stage_gate_named_suggest(_gate) {
  return "switch to a search tool"
}

pipeline test_stage_gate_accepts_named_function_callbacks(task) {
  const gate = {allowed_kinds: ["search"], allowed_tools: [], lane: "read_only", stage: "plan"}
  assert(
    stage_gate_allows(gate, "look", {kind_of: _stage_gate_named_kind}),
    "named function kind_of callback passes the kind gate",
  )
  const denial = stage_gate_denial(
    gate,
    "edit",
    {kind_of: _stage_gate_named_kind, suggest: _stage_gate_named_suggest},
  )
  assert(denial.contains("kind=edit"), "named kind_of callback resolves the attempted kind")
  assert(
    denial.contains("suggestion=switch to a search tool"),
    "named suggest callback overrides the suggestion",
  )
}

pipeline test_stage_gate_rejects_bad_callbacks(task) {
  const bad_kind_of = try {
    stage_gate_allows({allowed_kinds: ["x"], lane: "l", stage: "s"}, "t", {kind_of: "not-callable"})
  }
  assert(is_err(bad_kind_of), "non-callable kind_of throws loudly")
  const bad_suggest = try {
    stage_gate_denial({lane: "l", stage: "s"}, "t", {suggest: 42})
  }
  assert(is_err(bad_suggest), "non-string/non-callable suggest throws loudly")
}

pipeline test_stage_gate_label_rejects_delimiter_components(task) {
  // A well-formed gate round-trips through label -> parse byte-for-byte.
  const label = stage_gate_label(
    "do it",
    {
      allowed_kinds: ["search", "edit"],
      allowed_tools: ["look", "edit_file"],
      lane: "repair_local",
      stage: "repair",
    },
  )
  const back = stage_gate_parse(label)
  assert_eq(back.lane, "repair_local")
  assert_eq(back.stage, "repair")
  assert_eq(join(back.allowed_kinds, ","), "search,edit")
  assert_eq(join(back.allowed_tools, ","), "look,edit_file")
  // Each marker delimiter (space, `=`, `,`, `]`) in any component is rejected
  // LOUDLY at label time instead of silently truncating on the parse round-trip.
  const bad_lane_space = try {
    stage_gate_label("t", {lane: "repair local", stage: "repair"})
  }
  assert(is_err(bad_lane_space), "a space in lane is rejected")
  const bad_stage_bracket = try {
    stage_gate_label("t", {lane: "l", stage: "re]pair"})
  }
  assert(is_err(bad_stage_bracket), "a `]` in stage is rejected")
  const bad_tool_comma = try {
    stage_gate_label("t", {allowed_tools: ["ed,it"], lane: "l", stage: "s"})
  }
  assert(is_err(bad_tool_comma), "a comma in an allowed_tools token is rejected")
  const bad_kind_eq = try {
    stage_gate_label("t", {allowed_kinds: ["a=b"], lane: "l", stage: "s"})
  }
  assert(is_err(bad_kind_eq), "an `=` in an allowed_kinds token is rejected")
}

pipeline test_stage_gate_default_prefix_byte_identical(task) {
  // Omitting the prefix option renders the SAME marker as passing the explicit
  // default — the adoption seam adds no drift for callers that never set a prefix.
  const gate = {allowed_tools: ["edit"], lane: "repair_local", stage: "repair"}
  const implicit = stage_gate_label("Patch it.", gate)
  const explicit = stage_gate_label("Patch it.", gate, {prefix: "[lane_gate "})
  assert_eq(implicit, explicit)
  assert(implicit.contains("[lane_gate lane=repair_local"), "default marker prefix rendered")
}

pipeline test_stage_gate_custom_prefix_roundtrips(task) {
  // A host prefix (burin-code's existing "[burin_gate ") round-trips through
  // label -> parse when the SAME prefix is supplied to both.
  const opts = {prefix: "[burin_gate "}
  const gate = {
    allowed_kinds: ["edit"],
    allowed_tools: ["edit", "look"],
    lane: "repair_local",
    stage: "repair",
  }
  const label = stage_gate_label("Patch the bug.", gate, opts)
  assert(label.contains("[burin_gate lane=repair_local stage=repair"), "custom prefix rendered")
  assert(!label.contains("[lane_gate "), "default prefix not present under a custom prefix")
  const recovered = stage_gate_parse(label, opts)
  assert_eq(recovered.lane, "repair_local")
  assert_eq(recovered.stage, "repair")
  assert_eq(recovered.allowed_tools, ["edit", "look"])
  assert_eq(recovered.allowed_kinds, ["edit"])
  // A marker under one prefix is NOT recovered under a different (default) prefix.
  assert_eq(stage_gate_parse(label), {})
}

pipeline test_stage_gate_prefix_validated_loudly(task) {
  // A custom prefix must be a well-formed marker opener: start with "[", end with a
  // space, and carry none of the "=", ",", "]" structural delimiters.
  const gate = {lane: "l", stage: "s"}
  const no_open = try {
    stage_gate_label("t", gate, {prefix: "burin_gate "})
  }
  assert(is_err(no_open), "a prefix missing the leading `[` is rejected")
  const no_space = try {
    stage_gate_label("t", gate, {prefix: "[burin_gate"})
  }
  assert(is_err(no_space), "a prefix missing the trailing space is rejected")
  const has_eq = try {
    stage_gate_label("t", gate, {prefix: "[bur=in "})
  }
  assert(is_err(has_eq), "a prefix containing `=` is rejected")
  const has_bracket = try {
    stage_gate_label("t", gate, {prefix: "[bur]in "})
  }
  assert(is_err(has_bracket), "a prefix containing `]` is rejected")
  const has_comma = try {
    stage_gate_parse("anything", {prefix: "[bur,in "})
  }
  assert(is_err(has_comma), "parse validates the prefix too (comma rejected)")
}
