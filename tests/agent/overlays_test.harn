// Run: harn test tests/agent/overlays_test.harn
//
// Parity fixtures for `std/agent/overlays` against a downstream host's
// `mode_overlay_lines` shape (`lib/runtime/agent-loop.harn`): a per-mode base
// row, a narrower per-(mode, lane) row that takes priority when the lane
// matches, and an explicit `overrides` entry that always wins over both. Pure
// (no LLM, no host). The live, registered, fragment-reaches-the-outbound-
// request behavior is proven separately by
// `conformance/tests/agents/overlay_policy_registration.harn`.
import {
  agent_overlay_match,
  default_overlay_rows,
  overlay_context_fragment,
  overlay_policy,
} from "std/agent/overlays"
import { agent_preset } from "std/agent/presets"

pipeline test_mode_only_row_matches_without_a_lane(harness: Harness, task: unknown) {
  const row = agent_overlay_match(default_overlay_rows(), "agent")
  assert_eq(row.lane, nil)
  assert_eq(row.mode, "agent")
  assert(len(row.lines) > 0)
}

pipeline test_lane_specific_row_wins_over_mode_only_row(harness: Harness, task: unknown) {
  const row = agent_overlay_match(default_overlay_rows(), "agent", "explicit_patch")
  assert_eq(row.lane, "explicit_patch")
  assert_eq(row.mode, "agent")
  assert(len(row.lines) > 0)
}

pipeline test_no_match_returns_nil(harness: Harness, task: unknown) {
  const row = agent_overlay_match(default_overlay_rows(), "architect")
  assert_eq(row, nil)
}

pipeline test_disabled_row_is_skipped(harness: Harness, task: unknown) {
  const rows = [{enabled: false, lines: ["should never render"], mode: "agent"}]
  assert_eq(agent_overlay_match(rows, "agent"), nil)
}

pipeline test_fragment_body_joins_lines(harness: Harness, task: unknown) {
  const fragment = overlay_context_fragment(default_overlay_rows(), "plan")
  assert_eq(fragment.id, "overlay:plan")
  assert(fragment.body != "")
}

pipeline test_no_match_yields_no_fragment(harness: Harness, task: unknown) {
  assert_eq(overlay_context_fragment(default_overlay_rows(), "architect"), nil)
}

pipeline test_overlay_policy_preserves_existing_fragments(harness: Harness, task: unknown) {
  const base_opts = {context_profile: {prompt_fragments: [{body: "caller fragment", id: "caller"}]}}
  const result = overlay_policy(default_overlay_rows(), "agent", base_opts)
  const ids = []
  let out = ids
  for fragment in result.context_profile.prompt_fragments {
    out = out.appending(fragment.id)
  }
  assert(contains(out, "caller"), "caller's existing fragment survives")
  assert(contains(out, "overlay:agent"), "overlay fragment was appended")
}

pipeline test_overlay_policy_never_touches_system(harness: Harness, task: unknown) {
  const base_opts = {system: "explicit system prompt"}
  const result = overlay_policy(default_overlay_rows(), "agent", base_opts)
  assert_eq(result.system, "explicit system prompt")
}

pipeline test_overlay_policy_is_a_noop_without_a_match(harness: Harness, task: unknown) {
  const base_opts = {provider: "anthropic"}
  const result = overlay_policy(default_overlay_rows(), "architect", base_opts)
  assert_eq(result?.context_profile, nil)
}

pipeline test_rows_require_lines(harness: Harness, task: unknown) {
  const outcome = try {
    overlay_policy([{mode: "agent"}], "agent", {})
  }
  assert(is_err(outcome), "overlay_policy throws when a row is missing `lines`")
}

pipeline test_review_captain_preset_carries_overlay_policy_pack(harness: Harness, task: unknown) {
  const opts = agent_preset(harness, "review_captain", {})
  const pack = opts?.overlay_policy
  assert(pack != nil, "review_captain preset ships an overlay_policy pack row")
  const fragment = overlay_context_fragment(pack.rows, pack.mode)
  assert_eq(fragment.id, "overlay:agent")
  assert(fragment.body != "")
}

pipeline test_explicit_preset_overlay_policy_wins_over_pack_default(
  harness: Harness,
  task: unknown,
) {
  // Fill-nil precedence: an explicit caller `overlay_policy` value is never
  // overwritten by the preset's pack default.
  const custom = {mode: "plan", rows: [{lines: ["custom"], mode: "plan"}]}
  const opts = agent_preset(harness, "review_captain", {overlay_policy: custom})
  assert_eq(opts.overlay_policy, custom)
}
