// --- Regression: the turn-ender vetoing verified-green work -----------------
// Reproduces eval-py-smoke-20260829-181741-76315a65-66f, where five completion
// judge calls each returned `done` with `met: true` and were each forced to
// `continue` because the cited evidence included the tool actions the packet
// itself had listed.
fn trial_shaped_packet(verification_measurement: string) -> CompletionRequirementEvidencePacket {
  return {
    // Positive indices: the actions the packet showed the judge.
    actions: [{evidence_index: 12, name: "edit"}, {evidence_index: 15, name: "verify"}],
    fallback_observations: [],
    // Negative indices: the typed records the runtime appended.
    requirement_evidence: [
      {
        evidence_index: -3,
        role: "mutation_summary",
        supports_completion: true,
        summary: "Changed 1 artifact(s) across this session.",
        representative_artifact_ids: ["tests/test_calc.py"],
        artifact_count: 1,
        artifact_set_digest: "sha256:fixture",
      },
      {
        evidence_index: -1,
        role: "assistant_output",
        supports_completion: true,
        summary: "##DONE##",
        representative_artifact_ids: [],
        measurement: "present",
      },
      {
        evidence_index: -2,
        role: "deterministic_verification",
        supports_completion: verification_measurement == "passed",
        summary: "Deterministic verification observed `" + verification_measurement + "`.",
        representative_artifact_ids: [],
        measurement: verification_measurement,
      },
    ],
  }
}

// The whole-task catch-all Burin synthesizes when no acceptance items are
// frozen: one requirement, no declared evidence roles, name = the task text.
fn catch_all_contract() -> CompletionRequirementContract {
  return {
    requirements: [
      {
        requirement_id: "extend-tests-test-calc-py-so-mul-21d47e57",
        name:
          "Extend tests/test_calc.py so multiply and divide are covered alongside the existing add tests. Follow the existing pytest style: one top-level test function per case, two cases each — positive and negative — and add a third top-level test for divide that uses pytest.raises(ZeroDivisionError) to cover the error path.",
      },
    ],
  }
}

pipeline test_action_citation_alongside_typed_evidence_is_not_a_veto(
  harness: Harness,
  task: unknown,
) {
  // The exact rows haiku emitted on all five judge calls.
  const report = completion_requirement_report(
    catch_all_contract(),
    [
      {
        requirement_id: "extend-tests-test-calc-py-so-mul-21d47e57",
        met: true,
        evidence_refs: [12, 15, -1],
      },
    ],
    trial_shaped_packet("passed"),
  )
  assert_eq(report.rows[0].status, "met")
  assert(report.complete)
  assert_eq(report.pending_count, 0)
}

pipeline test_execution_item_is_satisfied_by_the_passing_receipt(harness: Harness, task: unknown) {
  const contract: CompletionRequirementContract = {
    requirements: [
      {
        requirement_id: "behavior",
        name: "The declared verifier passes.",
        evidence_roles: ["deterministic_verification"],
      },
    ],
  }
  // Only an action index is cited, so nothing qualifies by citation. The
  // recorded passing receipt settles the item instead.
  const report = completion_requirement_report(
    contract,
    [{requirement_id: "behavior", met: true, evidence_refs: [15]}],
    trial_shaped_packet("passed"),
  )
  assert_eq(report.rows[0].status, "met")
  assert(report.complete)
}

pipeline test_receipt_satisfaction_requires_a_passing_reading(harness: Harness, task: unknown) {
  const contract: CompletionRequirementContract = {
    requirements: [
      {
        requirement_id: "behavior",
        name: "The declared verifier passes.",
        evidence_roles: ["deterministic_verification"],
      },
    ],
  }
  // Negative control for the receipt path: a failing verifier must not satisfy
  // the item, or the fix would accept anything.
  const failed = completion_requirement_report(
    contract,
    [{requirement_id: "behavior", met: true, evidence_refs: [15]}],
    trial_shaped_packet("failed"),
  )
  assert_eq(failed.rows[0].status, "unsupported")
  assert(!failed.complete)
  // And a model that reports the item not met is still believed.
  const unmet = completion_requirement_report(
    contract,
    [{requirement_id: "behavior", met: false, evidence_refs: [-2]}],
    trial_shaped_packet("passed"),
  )
  assert_eq(unmet.rows[0].status, "unmet")
  assert(!unmet.complete)
}

pipeline test_citation_of_nothing_still_fails_the_row(harness: Harness, task: unknown) {
  const contract: CompletionRequirementContract = {
    requirements: [
      {
        requirement_id: "source",
        name: "Update the documented rationale.",
        evidence_roles: ["mutation_summary"],
      },
    ],
  }
  // Control: an unaddressed source-kind item. There is no mutation_summary the
  // model cited and no receipt for this role, so it stays pending — and the
  // feedback has to name it.
  const report = completion_requirement_report(
    contract,
    [{requirement_id: "source", met: true, evidence_refs: [999]}],
    trial_shaped_packet("passed"),
  )
  assert_eq(report.rows[0].status, "unsupported")
  assert(!report.complete)
  const feedback = completion_requirement_pending_feedback(report)
  assert(feedback.contains("`source`"))
  assert(feedback.contains("claimed met without usable evidence"))
  assert(feedback.contains("Accepted evidence kinds: mutation_summary"))
}

pipeline test_pending_feedback_names_the_item_and_its_evidence_kind(
  harness: Harness,
  task: unknown,
) {
  const report = completion_requirement_report(
    requirement_contract(),
    [{requirement_id: "artifact", met: true, evidence_refs: [4]}],
    evidence_packet(),
  )
  const feedback = completion_requirement_pending_feedback(report)
  assert(feedback.contains("1 of 2 acceptance item(s) still pending"))
  assert(feedback.contains("`behavior` is not assessed"))
  assert(feedback.contains("Accepted evidence kinds: deterministic_verification"))
}

// The whole-task catch-all for a task that writes nothing. One row, no declared
// evidence roles, so it accepts assistant_output and deterministic_verification.
fn no_write_contract() -> CompletionRequirementContract {
  return {requirements: [{requirement_id: "say-hello", name: "Say hello."}]}
}

fn no_write_judge_opts(session: string, cap: int) -> AgentSpec {
  return {
    provider: "mock",
    session_id: session,
    tool_format: "native",
    loop_until_done: true,
    done_sentinel: "##DONE##",
    max_iterations: cap,
    verify_completion_judge: {
      provider: "mock",
      max_invocations: 1,
      requirement_contract: no_write_contract(),
    },
  }
}

// harn#7823. A judge that answers `done` and never itemizes is the party that
// failed to assess. Before the fix this vetoed as `completion_requirements_pending`
// — feedback addressed to an actor who does not write assessments, identical on
// every iteration, so the run could only thrash.
pipeline test_omitted_report_is_attributed_to_the_judge_after_one_retry(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      llm_done(),
      // Both the first judge call and its itemization retry answer with a bare
      // scalar. Falling closed is still correct; naming the actor is not.
      {text: json_stringify({verdict: "done", detail: "The greeting was returned."})},
      {text: json_stringify({verdict: "done", detail: "The greeting was returned."})},
      llm_done(),
    ],
    { ->
      const session = "requirement-omitted-report-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Say hello.", nil, no_write_judge_opts(session, 2)) },
      )
      const receipts = completion_receipts(captured.events).filter(
        { receipt -> receipt?.requirements != nil },
      )
        .to_list()
      assert_eq(len(receipts), 1)
      assert_eq(receipts[0].action, "continue")
      assert_eq(receipts[0].reason, "completion_judge_report_omitted")
      assert(
        to_string(receipts[0]?.feedback ?? "").contains("completion judge returned no assessment"),
      )
      assert(to_string(receipts[0]?.feedback ?? "").contains("`say-hello`"))
    },
  )
}

// The retry is asked of the JUDGE, not the actor. One re-ask that itemizes
// closes the ledger on evidence the runtime already recorded.
pipeline test_itemization_retry_closes_the_no_write_row(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [
      llm_done(),
      {text: json_stringify({verdict: "done", detail: "The greeting was returned."})},
      {
        text: json_stringify(
          {
            verdict: "done",
            detail: "The greeting was returned.",
            requirement_report: [{requirement_id: "say-hello", met: true, evidence_refs: [-1]}],
          },
        ),
      },
    ],
    { ->
      const session = "requirement-retry-itemizes-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Say hello.", nil, no_write_judge_opts(session, 2)) },
      )
      assert_eq(captured.result.status, "done")
      const receipts = completion_receipts(captured.events)
      const last = receipts[len(receipts) - 1]
      assert_eq(last.action, "accept")
      assert(last.requirements.complete)
      assert_eq(last.requirements.rows[0].status, "met")
    },
  )
}

// Negative control for the retry. A judge that DID itemize and left the row out
// is a real actor gap: no retry, and the existing pending vocabulary stands.
pipeline test_itemized_report_that_omits_a_row_is_still_an_actor_gap(
  harness: Harness,
  task: unknown,
) {
  const report = completion_requirement_report(
    no_write_contract(),
    [{requirement_id: "unrelated", met: true, evidence_refs: [-1]}],
    trial_shaped_packet("passed"),
  )
  assert(!report.complete)
  assert_eq(report.rows[0].status, "missing")
  const feedback = completion_requirement_pending_feedback(report)
  assert(feedback.contains("still pending"))
  assert(!feedback.contains("completion judge returned no assessment"))
}
