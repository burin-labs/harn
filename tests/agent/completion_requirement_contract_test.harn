import {
  completion_evidence_progress_id,
  completion_requirement_evidence_packet,
} from "std/agent/completion_evidence"
import {
  CompletionFeedbackDelivery,
  completion_progress_observe,
  completion_progress_terminal_verdict,
  completion_progress_update,
} from "std/agent/completion_progress"
// Run: harn test tests/agent/completion_requirement_contract_test.harn
import {
  CompletionRequirementEvidencePacket,
  completion_requirement_report,
} from "std/agent/completion_requirements"
import { agent_capture_events } from "std/agent/events"
import {
  __judge_completion_verdict_read,
  __judge_completion_verdict_schema,
  __judge_evidence_projection,
} from "std/agent/judge"
import { agent_loop } from "std/agent/loop"
import { AgentSpec, CompletionRequirementContract } from "std/agent/options"
import { agent_tool_handler_result } from "std/agent/tool_lifecycle"
import { llm_done, llm_text, with_llm_script } from "std/testing"

fn requirement_contract() -> CompletionRequirementContract {
  return {
    requirements: [
      {
        requirement_id: "artifact",
        name: "Create the requested artifact.",
        evidence_roles: ["mutation_summary"],
      },
      {
        requirement_id: "behavior",
        name: "Exercise the requested behavior.",
        evidence_roles: ["deterministic_verification"],
      },
    ],
  }
}

fn artifact_contract() -> CompletionRequirementContract {
  return {
    requirements: [
      {
        requirement_id: "artifact",
        name: "Create the requested artifact.",
        evidence_roles: ["mutation_summary"],
      },
    ],
  }
}

fn verification_contract() -> CompletionRequirementContract {
  return {
    requirements: [
      {
        requirement_id: "verified",
        name: "Verify the requested behavior.",
        evidence_roles: ["deterministic_verification"],
      },
    ],
  }
}

fn output_contract() -> CompletionRequirementContract {
  return {
    requirements: [
      {
        requirement_id: "answer",
        name: "Provide the requested answer.",
        evidence_roles: ["assistant_output"],
      },
    ],
  }
}

fn evidence_packet() -> CompletionRequirementEvidencePacket {
  return {
    requirement_evidence: [
      {
        evidence_index: 4,
        role: "mutation_summary",
        supports_completion: true,
        summary: "The requested artifact changed.",
        representative_artifact_ids: ["src/artifact.harn"],
        artifact_count: 1,
        artifact_set_digest: "sha256:fixture",
      },
      {
        evidence_index: 9,
        role: "deterministic_verification",
        supports_completion: true,
        summary: "The verifier passed.",
        representative_artifact_ids: [],
        measurement: "passed",
      },
    ],
  }
}

fn completion_receipts(events: list) -> list {
  return events.filter(
    { event ->
      event.type == "typed_checkpoint"
        && event?.checkpoint?.schema
          == "harn.completion_directive_receipt.v1"
    },
  )
    .map({ event -> event.checkpoint })
    .to_list()
}

fn edit_tools() {
  const tools = tool_registry()
  return tool_define(
    tools,
    "edit",
    "Apply a source edit.",
    {
      handler: { _args ->
        agent_tool_handler_result(
          "write applied",
          {mutation_status: "applied", changed_paths: ["src/artifact.harn"]},
        )
      },
      parameters: {content: {type: "string", required: true}},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
}

fn action_messages(
  name: string,
  args: dict,
  data: dict,
  id: string = "action-1",
  result_text: string = "ok",
) -> list {
  return [
    {
      role: "assistant",
      content: "",
      _harn: {kind: "assistant", tool_calls: [{id: id, name: name, arguments: args}]},
    },
    {
      role: "user",
      content: result_text,
      _harn: {kind: "tool_result", tool_call_id: id, tool_name: name, outcome: "ok", data: data},
    },
  ]
}

pipeline test_progress_identity_tracks_typed_action_changes_without_volatile_indices(
  harness: Harness,
  task: unknown,
) {
  const edit_opts = {
    tools: [{name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}}],
  }
  const first_edit = action_messages(
    "edit",
    {path: "src/artifact.harn", content: "first"},
    {mutation_status: "applied", changed_paths: ["src/artifact.harn"]},
  )
  const identical_edit = action_messages(
    "edit",
    {path: "src/artifact.harn", content: "first"},
    {mutation_status: "applied", changed_paths: ["src/artifact.harn"]},
    "action-2",
    "different display prose",
  )
  const changed_edit = action_messages(
    "edit",
    {path: "src/artifact.harn", content: "second"},
    {mutation_status: "applied", changed_paths: ["src/artifact.harn"]},
    "action-3",
  )
  const first_edit_id = completion_evidence_progress_id(
    __judge_evidence_projection(first_edit, edit_opts).packet,
    false,
  )
  assert_eq(
    completion_evidence_progress_id(
      __judge_evidence_projection(first_edit + identical_edit, edit_opts).packet,
      false,
    ),
    first_edit_id,
    "tool-call identity, evidence position, and result prose are not progress",
  )
  assert_ne(
    completion_evidence_progress_id(
      __judge_evidence_projection(first_edit + changed_edit, edit_opts).packet,
      false,
    ),
    first_edit_id,
    "changed typed arguments on the same artifact are progress",
  )
  const verify_opts = {
    tools: [
      {
        name: "verify",
        annotations: {
          kind: "execute",
          side_effect_level: "process_exec",
          completion_evidence_role: "verification",
        },
      },
    ],
  }
  const unit_id = completion_evidence_progress_id(
    __judge_evidence_projection(
      action_messages("verify", {command: "unit"}, {passed: 11, failed: 0}),
      verify_opts,
    ).packet,
    false,
  )
  const integration_id = completion_evidence_progress_id(
    __judge_evidence_projection(
      action_messages("verify", {command: "integration"}, {passed: 11, failed: 0}),
      verify_opts,
    ).packet,
    false,
  )
  assert_ne(integration_id, unit_id, "a stronger typed verifier action is progress")
  const empty_packet = __judge_evidence_projection([], {}).packet
  const deterministic_unit_id = completion_evidence_progress_id(
    completion_requirement_evidence_packet(
      empty_packet,
      "",
      {oracle_expected: true, command: "unit", observed: "passed"},
    ),
    false,
  )
  const deterministic_integration_id = completion_evidence_progress_id(
    completion_requirement_evidence_packet(
      empty_packet,
      "",
      {oracle_expected: true, command: "integration", observed: "passed"},
    ),
    false,
  )
  assert_ne(
    deterministic_integration_id,
    deterministic_unit_id,
    "deterministic closure includes the stable oracle command, not only its outcome",
  )
}

pipeline test_requirement_report_joins_every_row_to_real_evidence(harness: Harness, task: unknown) {
  const report = completion_requirement_report(
    requirement_contract(),
    [
      {requirement_id: "artifact", met: true, evidence_refs: [4]},
      {requirement_id: "behavior", met: true, evidence_refs: [9]},
    ],
    evidence_packet(),
  )
  assert(report.complete)
  assert_eq(report.pending_count, 0)
  assert_eq(report.rows.map({ row -> row.status }).to_list(), ["met", "met"])
}

pipeline test_requirement_report_fails_closed_on_missing_duplicate_and_unsupported_rows(
  harness: Harness,
  task: unknown,
) {
  const missing = completion_requirement_report(
    requirement_contract(),
    [{requirement_id: "artifact", met: true, evidence_refs: [4]}],
    evidence_packet(),
  )
  assert(!missing.complete)
  assert_eq(missing.pending_count, 1)
  assert_eq(missing.pending_names, ["Exercise the requested behavior."])
  assert_eq(missing.rows[1].status, "missing")
  const duplicate = completion_requirement_report(
    requirement_contract(),
    [
      {requirement_id: "artifact", met: true, evidence_refs: [4]},
      {requirement_id: "artifact", met: true, evidence_refs: [4]},
      {requirement_id: "behavior", met: true, evidence_refs: [9]},
    ],
    evidence_packet(),
  )
  assert(!duplicate.complete)
  assert_eq(duplicate.rows[0].status, "unsupported")
  const unsupported = completion_requirement_report(
    requirement_contract(),
    [
      {requirement_id: "artifact", met: true, evidence_refs: [404]},
      {requirement_id: "behavior", met: true, evidence_refs: [9]},
    ],
    evidence_packet(),
  )
  assert(!unsupported.complete)
  assert_eq(unsupported.rows[0].status, "unsupported")
  const malformed = completion_requirement_report(
    requirement_contract(),
    [
      {requirement_id: "artifact", met: true, evidence_refs: ["4"]},
      {requirement_id: "behavior", met: true, evidence_refs: [9]},
    ],
    evidence_packet(),
  )
  assert(!malformed.complete)
  assert_eq(malformed.rows[0].status, "unsupported")
  const extra = completion_requirement_report(
    requirement_contract(),
    [
      {requirement_id: "artifact", met: true, evidence_refs: [4]},
      {requirement_id: "behavior", met: true, evidence_refs: [9]},
      {requirement_id: "invented", met: true, evidence_refs: [4]},
    ],
    evidence_packet(),
  )
  assert(!extra.complete)
  assert_eq(extra.pending_count, 1)
  assert_eq(extra.pending_names, ["Unknown requirement `invented`"])
}

pipeline test_tool_free_answer_can_cite_final_assistant_output(harness: Harness, task: unknown) {
  const projected = __judge_evidence_projection([], {})
  const packet = completion_requirement_evidence_packet(
    projected.packet,
    "The answer follows from the supplied facts.",
  )
  const report = completion_requirement_report(
    {
      requirements: [
        {
          requirement_id: "answer",
          name: "Answer the question.",
          evidence_roles: ["assistant_output"],
        },
      ],
    },
    [{requirement_id: "answer", met: true, evidence_refs: [-1]}],
    packet,
  )
  assert(report.complete)
  const final_evidence = packet.requirement_evidence[0]
  assert(final_evidence != nil)
  assert_eq(final_evidence.role, "assistant_output")
}

pipeline test_requirement_refs_reject_wrong_role_and_missing_measurement(
  harness: Harness,
  task: unknown,
) {
  const projected = __judge_evidence_projection([], {})
  const assistant_packet = completion_requirement_evidence_packet(
    projected.packet,
    "A final answer.",
  )
  const verification_contract = {
    requirements: [
      {
        requirement_id: "verified",
        name: "Verification passed.",
        evidence_roles: ["deterministic_verification"],
      },
    ],
  }
  const wrong_role = completion_requirement_report(
    verification_contract,
    [{requirement_id: "verified", met: true, evidence_refs: [-1]}],
    assistant_packet,
  )
  assert(!wrong_role.complete)
  assert_eq(wrong_role.rows[0].status, "unsupported")
  const unmeasured_packet = completion_requirement_evidence_packet(
    projected.packet,
    "A final answer.",
    {oracle_expected: true, command: "check", observed: "not_run"},
  )
  const unmeasured = completion_requirement_report(
    verification_contract,
    [{requirement_id: "verified", met: true, evidence_refs: [-2]}],
    unmeasured_packet,
  )
  assert(!unmeasured.complete)
  assert_eq(unmeasured.rows[0].status, "unsupported")
}

pipeline test_omitted_roles_do_not_let_mutation_summary_prove_any_requirement(
  harness: Harness,
  task: unknown,
) {
  const report = completion_requirement_report(
    {requirements: [{requirement_id: "answer", name: "Answer the question."}]},
    [{requirement_id: "answer", met: true, evidence_refs: [4]}],
    evidence_packet(),
  )
  assert(!report.complete)
  assert_eq(report.rows[0].status, "unsupported")
}

pipeline test_scalar_done_cannot_override_pending_requirement_on_public_completion_seam(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      {
        text: "",
        tool_calls: [{id: "edit-1", name: "edit", arguments: {content: "implementation"}}],
      },
      llm_done(),
      {
        text: json_stringify(
          {
            verdict: "done",
            detail: "The work is complete.",
            requirement_report: [
              {requirement_id: "artifact", met: true, evidence_refs: [-3]},
              {requirement_id: "behavior", met: false, evidence_refs: []},
            ],
          },
        ),
      },
      llm_done(),
    ],
    { ->
      const session = "requirement-contract-negative-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: edit_tools(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 3,
        verify_completion_judge: {
          provider: "mock",
          max_invocations: 1,
          requirement_contract: requirement_contract(),
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Create and exercise the requested behavior.", nil, opts) },
      )
      const requirement_receipts = completion_receipts(captured.events).filter(
        { receipt -> receipt?.requirements != nil },
      )
        .to_list()
      assert_eq(len(requirement_receipts), 1)
      assert_eq(requirement_receipts[0].action, "continue")
      assert_eq(requirement_receipts[0].reason, "completion_requirements_pending")
      assert_eq(requirement_receipts[0].requirements.pending_count, 1)
      assert_eq(
        requirement_receipts[0].requirements.pending_names,
        ["Exercise the requested behavior."],
      )
    },
  )
}

pipeline test_complete_requirement_report_accepts_on_public_completion_seam(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      {
        text: "",
        tool_calls: [{id: "edit-1", name: "edit", arguments: {content: "implementation"}}],
      },
      llm_done(),
      {
        text: json_stringify(
          {
            verdict: "done",
            detail: "Every requirement has direct evidence.",
            requirement_report: [{requirement_id: "artifact", met: true, evidence_refs: [-3]}],
          },
        ),
      },
    ],
    { ->
      const session = "requirement-contract-positive-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: edit_tools(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 2,
        verify_completion_judge: {
          provider: "mock",
          max_invocations: 1,
          requirement_contract: artifact_contract(),
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Create and exercise the requested behavior.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      const receipts = completion_receipts(captured.events)
      assert_eq(receipts[len(receipts) - 1].action, "accept")
      assert(receipts[len(receipts) - 1].requirements.complete)
    },
  )
}

pipeline test_repeated_done_gap_without_evidence_progress_stops_before_second_judge(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      llm_done(),
      {
        text: json_stringify(
          {
            verdict: "continue",
            detail: "Run deterministic verification before finishing.",
            requirement_report: [{requirement_id: "verified", met: false, evidence_refs: []}],
          },
        ),
      },
      llm_text("I changed only my explanation. ##DONE##"),
    ],
    { ->
      const session = "requirement-gap-no-progress-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish only after deterministic verification passes.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 3,
            done_judge: {
              provider: "mock",
              max_invocations: 3,
              requirement_contract: verification_contract(),
            },
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 3, "the second judge call is cut off")
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "done_judge_repeated_gap_no_progress")
      const receipts = completion_receipts(captured.events)
      assert_eq(len(receipts), 2)
      assert_eq(receipts[0].action, "continue")
      assert_eq(receipts[0].feedback_delivery, "delivered")
      assert(receipts[0].invoked.done_judge)
      assert_eq(receipts[1].action, "stop_unverified")
      assert_eq(receipts[1].reason, "done_judge_repeated_gap_no_progress")
      assert(!receipts[1].invoked.done_judge)
      assert_eq(
        receipts[1].completion_progress.gap.gap.gap_id,
        receipts[0].completion_progress.gap.gap.gap_id,
      )
      assert_eq(
        receipts[1].completion_progress.gap.evidence_progress_id,
        receipts[0].completion_progress.gap.evidence_progress_id,
      )
    },
  )
}

pipeline test_done_judge_cap_remains_absolute_after_structured_progress(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [
      llm_done(),
      {
        text: json_stringify(
          {
            verdict: "continue",
            detail: "Create the requested artifact before finishing.",
            requirement_report: [{requirement_id: "artifact", met: false, evidence_refs: []}],
          },
        ),
      },
      {
        text: "",
        tool_calls: [{id: "edit-1", name: "edit", arguments: {content: "implementation"}}],
      },
      llm_done(),
    ],
    { ->
      const session = "requirement-gap-hard-cap-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Create the requested artifact.",
          nil,
          {
            provider: "mock",
            session_id: session,
            tools: edit_tools(),
            tool_format: "native",
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 4,
            done_judge: {
              provider: "mock",
              max_invocations: 1,
              requirement_contract: artifact_contract(),
            },
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 4, "the hard cap suppresses a second judge call")
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "done_judge_cap_reached")
      const receipts = completion_receipts(captured.events)
      assert_eq(len(receipts), 2)
      assert(receipts[0].invoked.done_judge)
      assert(!receipts[1].invoked.done_judge)
      assert_eq(receipts[1].reason, "done_judge_cap_reached")
    },
  )
}

pipeline test_undelivered_feedback_does_not_arm_repeated_gap_cutoff(
  harness: Harness,
  task: unknown,
) {
  const contract = verification_contract()
  const packet = __judge_evidence_projection([], {}).packet
  const requirements = completion_requirement_report(
    contract,
    [{requirement_id: "verified", met: false, evidence_refs: []}],
    packet,
  )
  const undelivered: list<CompletionFeedbackDelivery> = ["none", "deferred"]
  for delivery in undelivered {
    const observed = completion_progress_observe(
      {
        done_judge_invoked: true,
        vetoed: true,
        feedback_delivery: delivery,
        requirements: requirements,
        requirement_contract: contract,
        evidence: packet,
      },
    )
    const state = completion_progress_update(
      nil,
      {done_judge_invoked: true, directive_reason: "", next: observed},
    )
    assert_eq(state?.gap?.repair_delivery, delivery)
    assert_eq(
      completion_progress_terminal_verdict(state, contract, packet),
      nil,
      "undelivered repair feedback cannot arm the cutoff",
    )
  }
}

