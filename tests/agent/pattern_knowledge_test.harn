import { crystallization_curate } from "std/agent/crystallization_curator"
import { agent_loop } from "std/agent/loop"
import { agent_options } from "std/agent/options"
import {
  pattern_learning_curator_evidence,
  pattern_learning_import_session_records,
  pattern_learning_observations,
  pattern_learning_observe,
  pattern_learning_pending,
  pattern_learning_session_transcript,
  pattern_learning_set_enabled,
  pattern_learning_state,
  pattern_learning_status,
} from "std/agent/pattern_knowledge"
import { pl_redact_command } from "std/agent/pattern_knowledge_persistence"
import { session_store_append, session_store_events, session_store_list } from "std/session-store"
import { llm_text, llm_tool_call, with_llm_script, with_temp_dir } from "std/testing"

fn append_session_evidence(
  agent: HarnessAgent,
  root: string,
  session_id: string,
  prompt: string,
  terminal_kind: string,
  workflow_learning_eligibility: string,
  run_id: string,
) -> nil {
  const base = {
    root: root,
    actor: "pattern-learning-test",
    headers: {"harn.workflow_learning.eligibility": workflow_learning_eligibility, run_id: run_id},
  }
  session_store_append(
    agent,
    session_id,
    {transcript_event: {kind: "message", role: "user", visibility: "public", text: prompt}},
    base + {kind_type: "message"},
  )
  session_store_append(
    agent,
    session_id,
    {
      transcript_event: {
        kind: "tool_call",
        role: "assistant",
        visibility: "internal",
        text: "",
        metadata: {tool_name: "edit", status: "pending"},
      },
    },
    base + {kind_type: "tool_call"},
  )
  session_store_append(
    agent,
    session_id,
    {
      transcript_event: {
        kind: "agent_run_terminal",
        role: "assistant",
        visibility: "internal",
        text: "Agent loop reached a terminal state",
        metadata: {terminal: {kind: terminal_kind}},
      },
    },
    base + {kind_type: "agent_run_terminal"},
  )
}

pipeline test_pattern_learning_imports_natural_terminal_session_evidence_once(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      for entry in [
        ["session-a", "Add a scheduled FraudSignalRefresh worker to this Rivet repository."],
        ["session-b", "Add a scheduled LedgerCompaction worker to this Rivet repository."],
        ["session-c", "Add a scheduled CacheWarmup worker to this Rivet repository."],
      ] {
        const session_id = to_string(entry[0] ?? "")
        const prompt = to_string(entry[1] ?? "")
        append_session_evidence(
          harness.agent,
          root,
          session_id,
          prompt,
          "natural",
          "eligible",
          "coding-" + session_id,
        )
      }
      append_session_evidence(
        harness.agent,
        root,
        "session-error",
        "Add a scheduled FailedWorker worker to this Rivet repository.",
        "provider_error",
        "eligible",
        "failed-run",
      )
      append_session_evidence(
        harness.agent,
        root,
        "session-a",
        "Review this bounded evidence window and submit a crystallization proposal.",
        "natural",
        "excluded",
        "curator-run",
      )
      append_session_evidence(
        harness.agent,
        root,
        "session-holdout-control",
        "Add a scheduled SettlementExceptionSweep worker to this Rivet repository.",
        "natural",
        "excluded",
        "holdout-run",
      )
      const sessions = session_store_list(
        harness.agent,
        {root: root, limit: 10, sort_by: "updated_at", order: "descending"},
      ).value
      assert(
        len(sessions) == 5,
        "canonical session listing must preserve a multi-run conversation as one session",
      )
      assert(
        sessions.all({ session -> session.status == "open" }),
        "the typed list projection must retain session lifecycle state",
      )
      const options = {project_root: root, session_store_root: root}
      pattern_learning_observe(
        harness,
        "legacy-manual-observation",
        "Add an unproven ManualWorker to this Rivet repository.",
        ["edit"],
        options,
      )
      const first = pattern_learning_import_session_records(harness, options)
      assert(
        first?.scanned_session_count == 5,
        "import must inspect the bounded canonical session list",
      )
      assert(
        first?.scanned_count == 6,
        "import must classify each run, including an excluded control turn in a coding session",
      )
      assert(
        first?.imported_count == 3,
        "only producer-eligible, natural-terminal sessions may enter the curator corpus",
      )
      assert(
        first?.skipped_ineligible_count == 3,
        "failed, curator, and holdout sessions must be excluded rather than learned",
      )
      const observations = pattern_learning_observations(harness, options)
      const curator_evidence = pattern_learning_curator_evidence(harness, options)
      assert(
        len(observations) == 4,
        "raw historical observations remain inspectable for migration and operator review",
      )
      assert(
        len(curator_evidence) == 3,
        "only producer-stamped run evidence may seed a curator by default",
      )
      assert(
        curator_evidence.all(
          { item -> item?.source_id.starts_with("session-") && item?.run_id != "" },
        ),
        "each imported observation must retain its run-level provenance key",
      )
      assert(
        curator_evidence.all({ item -> item?.tool_sequence == ["edit"] }),
        "the imported evidence must retain the canonical tool-call sequence",
      )
      const second = pattern_learning_import_session_records(harness, options)
      assert(second?.imported_count == 0, "re-running import must not duplicate session evidence")
      assert(
        second?.skipped_existing_count == 3,
        "existing session ids must be recognized structurally",
      )
      assert(
        len(pattern_learning_curator_evidence(harness, options)) == 3,
        "idempotent import must leave the curator corpus unchanged",
      )
      return nil
    },
  )
}

pipeline test_pattern_learning_set_enabled_returns_the_persisted_state(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      // A fixed clock forces equal timestamps, so this verifies the mutation
      // result itself rather than relying on incidental ordering in memory.
      const options = {project_root: root, now: "2026-06-27T12:00:00Z"}
      const disabled = pattern_learning_set_enabled(harness, false, options)
      assert(disabled?.enabled == false, "set_enabled must return its persisted disabled state")
      assert(
        pattern_learning_status(harness, options)?.enabled == false,
        "set_enabled must persist the disabled state",
      )
      const enabled = pattern_learning_set_enabled(harness, true, options)
      assert(enabled?.enabled == true, "set_enabled must return its persisted enabled state")
      const observed = pattern_learning_observe(
        harness,
        "return-contract",
        "Capture an explicit operator observation.",
        ["edit"],
        options,
      )
      assert(
        observed?.observation?.id != "",
        "observation capture must return the persisted observation record",
      )
      return nil
    },
  )
}

pipeline test_pattern_learning_read_surfaces_do_not_create_memory_state(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const options = {project_root: root}
      const events = path_join(
        root,
        ".harn",
        "memory",
        "project",
        "pattern-learning",
        "events.jsonl",
      )
      const marker = path_join(
        root,
        ".harn",
        "memory",
        "project",
        "pattern-learning",
        ".burin-session-store-migrated-v1.json",
      )
      assert(!harness.fs.exists(events), "fixture must start without pattern events")
      assert(!harness.fs.exists(marker), "fixture must start without a migration marker")
      assert(pattern_learning_state(harness, options)?.enabled == true)
      assert(len(pattern_learning_observations(harness, options)) == 0)
      assert(len(pattern_learning_pending(harness, options)) == 0)
      assert(pattern_learning_status(harness, options)?.pending_count == 0)
      assert(len(pattern_learning_pending(harness, options)) == 0)
      assert(!harness.fs.exists(events), "read surfaces must not append pattern events")
      assert(!harness.fs.exists(marker), "read surfaces must not claim a migration")
      return nil
    },
  )
}

pipeline test_pattern_learning_stamps_terminal_provenance_from_a_live_agent_loop(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      with_llm_script(
        harness.llm,
        [llm_text("<done>##DONE##</done>")],
        { ->
          const result = agent_loop(
            harness,
            "Record a producer-owned workflow-learning terminal.",
            "Finish after the supplied fixture response.",
            agent_options(
              {
                provider: "mock",
                model: "gpt-5.4",
                tool_format: "native",
                loop_until_done: true,
                max_iterations: 2,
                root: root,
                session_id: "pattern-learning-live-terminal",
                workflow_learning_eligibility: "eligible",
              },
            ),
          )
          assert(result.status == "done", "the fixture agent loop must finish naturally")
          const events = session_store_events(
            harness.agent,
            "pattern-learning-live-terminal",
            {root: root},
          ).value
          const terminal = events.find(
            { event -> event?.payload?.transcript_event?.kind == "agent_run_terminal" },
          )
          assert(terminal != nil, "the live loop must persist a terminal event")
          assert(
            terminal?.headers?.["harn.workflow_learning.eligibility"] == "eligible",
            "the producer-owned eligibility must survive through the terminal event",
          )
          return nil
        },
      )
    },
  )
}

fn append_command_call(
  agent: HarnessAgent,
  root: string,
  session_id: string,
  run_id: string,
  call_id: string,
  command: string,
  exit_code: int,
) -> nil {
  const base = {
    root: root,
    actor: "pattern-learning-test",
    headers: {"harn.workflow_learning.eligibility": "eligible", run_id: run_id},
  }
  session_store_append(
    agent,
    session_id,
    {
      transcript_event: {
        kind: "tool_call",
        role: "assistant",
        visibility: "internal",
        text: "",
        metadata: {
          tool_call_id: call_id,
          tool_name: "run",
          raw_input: {command: command},
          status: "pending",
        },
      },
    },
    base + {kind_type: "tool_call"},
  )
  session_store_append(
    agent,
    session_id,
    {
      transcript_event: {
        kind: "tool_call_update",
        role: "assistant",
        visibility: "internal",
        text: "",
        metadata: {
          tool_call_id: call_id,
          tool_name: "run",
          status: "completed",
          health: {command_exit_code: exit_code},
        },
      },
    },
    base + {kind_type: "custom"},
  )
}

pipeline test_pattern_learning_import_keeps_a_redacted_command_ledger(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const session_id = "session-ledger"
      const run_id = "coding-ledger"
      const base = {
        root: root,
        actor: "pattern-learning-test",
        headers: {"harn.workflow_learning.eligibility": "eligible", run_id: run_id},
      }
      session_store_append(
        harness.agent,
        session_id,
        {
          transcript_event: {
            kind: "message",
            role: "user",
            visibility: "public",
            text: "Fix the parser and make the tests pass.",
          },
        },
        base + {kind_type: "message"},
      )
      append_command_call(harness.agent, root, session_id, run_id, "c1", "python3 -m pytest -q", 1)
      append_command_call(
        harness.agent,
        root,
        session_id,
        run_id,
        "c2",
        "APP_DB_URL=sqlite:///:memory: SERVICE_API_KEY=abc123secret python3 -m pytest -m \"not slow\" -q",
        0,
      )
      session_store_append(
        harness.agent,
        session_id,
        {
          transcript_event: {
            kind: "agent_run_terminal",
            role: "assistant",
            visibility: "internal",
            text: "done",
            metadata: {terminal: {kind: "natural"}},
          },
        },
        base + {kind_type: "agent_run_terminal"},
      )
      const options = {project_root: root, session_store_root: root}
      const imported = pattern_learning_import_session_records(harness, options)
      assert_eq(imported?.imported_count, 1)
      const ledger = pattern_learning_curator_evidence(harness, options)[0]?.command_ledger ?? []
      assert_eq(len(ledger), 2)
      assert_eq(ledger[0], {tool: "run", command: "python3 -m pytest -q", exit_code: 1, ok: false})
      assert_eq(ledger[1]?.exit_code, 0)
      assert_eq(ledger[1]?.ok, true)
      assert_eq(
        ledger[1]?.command,
        "APP_DB_URL=sqlite:///:memory: SERVICE_API_KEY=<redacted> python3 -m pytest -m \"not slow\" -q",
      )
      assert(
        !ledger[1]?.command.contains("abc123secret"),
        "a credential assignment must not reach the ledger",
      )
      const transcript = pattern_learning_session_transcript(harness.agent, session_id, options)
      const calls = transcript.entries.filter({ entry -> entry.kind == "tool_call" }).to_list()
      assert_eq(
        transcript.entries[0],
        {kind: "message", role: "user", text: "Fix the parser and make the tests pass."},
      )
      assert_eq(len(calls), 2)
      assert(
        calls[1].input.contains("SERVICE_API_KEY=<redacted>"),
        "the drill-down keeps the command",
      )
      assert(
        !json_stringify(transcript).contains("abc123secret"),
        "the drill-down must not leak a credential",
      )
      return nil
    },
  )
}

pipeline test_command_redaction_removes_whole_quoted_values() {
  assert_eq(
    pl_redact_command("DEPLOY_TOKEN=\"two words\" ./deploy --env prod"),
    "DEPLOY_TOKEN=<redacted> ./deploy --env prod",
  )
  assert_eq(
    pl_redact_command("DEPLOY_TOKEN=\"has \\\"escaped\\\" quotes\" ./deploy"),
    "DEPLOY_TOKEN=<redacted> ./deploy",
  )
  assert_eq(pl_redact_command("DB_PASSWORD='a b c' psql"), "DB_PASSWORD=<redacted> psql")
  assert_eq(pl_redact_command("API_KEY=\"never closed tail"), "API_KEY=<redacted>")
  assert_eq(pl_redact_command("password: \"two words\" next"), "password=<redacted> next")
}

fn append_message(agent: HarnessAgent, root: string, session_id: string, text: string) -> nil {
  session_store_append(
    agent,
    session_id,
    {transcript_event: {kind: "message", role: "assistant", visibility: "public", text: text}},
    {root: root, actor: "pattern-learning-test", kind_type: "message"},
  )
}

pipeline test_session_transcript_redacts_before_clipping_and_bounds_entries(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const options = {project_root: root, session_store_root: root}
      // A token that straddles the 600-character clip: cut first, its head no
      // longer matches the token pattern and would be kept verbatim.
      const token = "ghp_" + "A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8"
      append_message(harness.agent, root, "session-straddle", "x".repeat(590) + " " + token)
      const straddle = pattern_learning_session_transcript(
        harness.agent,
        "session-straddle",
        options,
      )
      const head = to_string(straddle.entries[0]?.text)
      assert(len(head) <= 601, "the entry stays bounded")
      assert(
        !head.contains("ghp_A1b2"),
        "a token straddling the clip must not leak its head: ${head}",
      )
      for index in range(0, 85) {
        append_message(harness.agent, root, "session-long", "step ${index}")
      }
      const transcript = pattern_learning_session_transcript(harness.agent, "session-long", options)
      assert_eq(transcript.entry_count, 85)
      assert_eq(transcript.truncated, true)
      assert_eq(len(transcript.entries), 80)
      assert_eq(transcript.entries[0].text, "step 5")
      assert_eq(transcript.entries[79].text, "step 84")
      return nil
    },
  )
}

pipeline test_inspect_session_evidence_returns_a_bounded_redacted_transcript(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const session_id = "session-inspected"
      append_message(harness.agent, root, session_id, "API_KEY=\"two words\" make deploy")
      for index in range(0, 85) {
        append_message(harness.agent, root, session_id, "step ${index}")
      }
      const evidence = [
        {
          id: "run-inspected",
          session_id: session_id,
          prompt: "Deploy the service",
          tool_sequence: ["run"],
          observed_at: "2026-08-13T12:00:00Z",
        },
      ]
      const result = with_llm_script(
        harness.llm,
        [
          llm_tool_call("inspect_session_evidence", {session_id: session_id}),
          llm_tool_call("submit_crystallization_batch", {proposals: []}),
        ],
        { ->
          crystallization_curate(
            harness,
            {
              project_root: root,
              session_store_root: root,
              memory_root: path_join(root, "memory"),
              evidence: evidence,
              now: "2026-08-13T12:05:00Z",
              agent: {provider: "mock", model: "mock", tool_format: "native", max_iterations: 3},
            },
          )
        },
      )
      const seen = json_stringify(result?.agent_result ?? {})
      assert(seen.contains("truncated"), "the handler ran and returned the bounded transcript")
      assert(seen.contains("step 84"), "the handler returned the newest entries")
      assert(!seen.contains("two words"), "the handler must not return a credential")
      return nil
    },
  )
}
