import {
  pattern_learning_import_session_records,
  pattern_learning_observations,
} from "std/agent/pattern_knowledge"
import { session_store_append, session_store_list } from "std/session-store"
import { with_temp_dir } from "std/testing"

fn append_session_evidence(
  harness: Harness,
  root: string,
  session_id: string,
  prompt: string,
  terminal_kind: string,
) -> nil {
  const base = {root: root, actor: "pattern-learning-test"}
  session_store_append(
    harness.agent,
    session_id,
    {transcript_event: {kind: "message", role: "user", visibility: "public", text: prompt}},
    base + {kind_type: "message"},
  )
  session_store_append(
    harness.agent,
    session_id,
    {
      transcript_event: {
        kind: "tool_call",
        role: "assistant",
        visibility: "internal",
        text: "",
        metadata: {tool_name: "edit", status: "pending"},
      },
    },
    base + {kind_type: "tool_call"},
  )
  session_store_append(
    harness.agent,
    session_id,
    {
      transcript_event: {
        kind: "agent_run_terminal",
        role: "assistant",
        visibility: "internal",
        text: "Agent loop reached a terminal state",
        metadata: {terminal: {kind: terminal_kind}},
      },
    },
    base + {kind_type: "agent_run_terminal"},
  )
}

pipeline test_pattern_learning_imports_natural_terminal_session_evidence_once(
  harness: Harness,
  _task,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      for entry in [
        ["session-a", "Add a scheduled FraudSignalRefresh worker to this Rivet repository."],
        ["session-b", "Add a scheduled LedgerCompaction worker to this Rivet repository."],
        ["session-c", "Add a scheduled CacheWarmup worker to this Rivet repository."],
      ] {
        append_session_evidence(harness, root, entry[0], entry[1], "natural")
      }
      append_session_evidence(
        harness,
        root,
        "session-error",
        "Add a scheduled FailedWorker worker to this Rivet repository.",
        "provider_error",
      )
      const sessions = session_store_list(
        harness.agent,
        {root: root, limit: 10, sort_by: "updated_at", order: "descending"},
      )
      assert(len(sessions) == 4, "canonical session listing must expose every persisted session")
      assert(
        sessions.all({ session -> session?.status == "open" }),
        "the typed list projection must retain session lifecycle state",
      )
      const options = {project_root: root, session_store_root: root}
      const first = pattern_learning_import_session_records(harness, options)
      assert(first?.scanned_count == 4, "import must inspect the bounded canonical session list")
      assert(first?.imported_count == 3, "only natural terminals may enter the curator corpus")
      assert(
        first?.skipped_ineligible_count == 1,
        "failed sessions must be excluded rather than trained",
      )
      const observations = pattern_learning_observations(harness, options)
      assert(len(observations) == 3, "one observation should be projected per eligible session")
      assert(
        observations.all({ item -> item?.tool_sequence == ["edit"] }),
        "the imported evidence must retain the canonical tool-call sequence",
      )
      const second = pattern_learning_import_session_records(harness, options)
      assert(second?.imported_count == 0, "re-running import must not duplicate session evidence")
      assert(
        second?.skipped_existing_count == 3,
        "existing session ids must be recognized structurally",
      )
      assert(
        len(pattern_learning_observations(harness, options)) == 3,
        "idempotent import must leave the curator corpus unchanged",
      )
      return nil
    },
  )
}
