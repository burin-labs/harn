import {
  AgentStallObservation,
  AgentStallState,
  agent_stall_observe_tool_calls,
} from "std/agent/stall"

pub type StallObservationInput = {
  config?: dict | bool,
  session_id?: string?,
  calls?: list?,
  iteration?: int?,
  defer_feedback?: bool?,
  dispatch?: list?,
  text?: string?,
  parse_error?: bool?,
  made_edit?: bool?,
  stop_reason?: string?,
  payload?: any?,
  diagnostic_consumed?: bool?,
  verification_dispatch?: list?,
}

/**
 * Exercise direct detector intake with named turn facts.
 * @effects: [agent]
 * @errors: [agent_loop]
 */
pub fn observe_stall(
  agent: HarnessAgent,
  state: AgentStallState,
  input: StallObservationInput,
) -> AgentStallObservation {
  return agent_stall_observe_tool_calls(
    agent,
    input.session_id ?? "unit",
    input.calls ?? _run_call(),
    input.iteration ?? 1,
    input.config,
    state,
    input.defer_feedback ?? true,
    input.dispatch,
    input.text ?? "",
    input.parse_error ?? false,
    input.made_edit ?? false,
    input.stop_reason ?? "",
    input.payload,
    input.diagnostic_consumed ?? false,
    input.verification_dispatch ?? [],
  )
}

/**
 * A substantive verification proposal.
 * @effects: []
 * @errors: []
 */
pub fn _run_call() -> list {
  return [{name: "run", arguments: {cmd: "test"}}]
}

/**
 * A failed verification dispatch.
 * @effects: []
 * @errors: []
 */
pub fn _fail_dispatch(error_text: any) -> list {
  // A failing verification result for tool "run".
  return [{tool_name: "run", ok: false, error: error_text}]
}

/**
 * The declared verification evidence in a dispatch. These fixtures name their
 * verification tool "run"; every other result is an action, mirroring the
 * evidence-role selection the agent loop owns in production.
 * @effects: []
 * @errors: []
 */
pub fn _verification_of(prev_dispatch: any) -> list {
  return (prev_dispatch ?? []).filter({ result -> result.tool_name == "run" }).to_list()
}
