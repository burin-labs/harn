// Run: harn test tests/agent/loop_control_test.harn
//
// Unit tests for the default adaptive loop-control policy
// (`std/agent/control`), exercised at the public seam
// `agent_loop_control_invoke(opts, budget, state)` with hand-built loop state —
// no agent_loop, no mock LLM, no inference. The policy decides, at the budget
// boundary, whether to extend the iteration cap (and why) or let the loop stop.
//
// The headline case is the regression that motivated the rule-table refactor:
// a turn that produced visible-text progress but made NO tool call this turn
// (an interleaved planning turn) must still extend. The previous inline
// `progress.changed && tool_call_count > 0` denied that extension and cut a
// productive multi-file refactor off mid-work.
import { agent_loop_control_invoke } from "std/agent/control"

// Adaptive budget so the default policy (not a caller override) is consulted.
const BUDGET = {
  mode: "adaptive",
  initial: 8,
  max: 50,
  extend_by: 4,
  progress_window: 4,
  expose_decisions: false,
  wall_clock_ms: nil,
  total_cost_usd: nil,
  consecutive_failures: nil,
}

/**
 * Build a loop state. `remaining` is the budget headroom: the policy only
 * decides once it reaches 0 (the boundary).
 */
fn _state(
  progress_changed: bool,
  tool_call_count: int,
  remaining: int,
  vetoed: bool,
  required_ok: bool,
) {
  return {
    iteration: 10,
    budget: {remaining: remaining},
    turn: {tool_call_count: tool_call_count},
    session: {required_tools_satisfied: required_ok},
    completion: {vetoed: vetoed},
    progress: {changed: progress_changed},
  }
}

pipeline test_text_only_progress_extends(harness: Harness, task: unknown) {
  // Visible-text progress, ZERO tool calls this turn, at the boundary → extend.
  // This is the bug the rule table fixed.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(true, 0, 0, false, true))
  assert_eq(cmd.action, "extend")
  assert_eq(cmd.reason, "progress within window")
}

pipeline test_tool_progress_extends(harness: Harness, task: unknown) {
  // Tool-call progress at the boundary → extend (unchanged behavior).
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(true, 2, 0, false, true))
  assert_eq(cmd.action, "extend")
  assert_eq(cmd.reason, "progress within window")
}

pipeline test_no_progress_does_not_extend(harness: Harness, task: unknown) {
  // No progress at the boundary → no extension; the loop stops at its cap.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(false, 0, 0, false, true))
  assert_eq(cmd.action, "none")
}

pipeline test_below_boundary_is_noop(harness: Harness, task: unknown) {
  // remaining > 0 → not at the boundary yet, the policy makes no decision even
  // when progress is being made.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(true, 1, 5, false, true))
  assert_eq(cmd.action, "none")
}

pipeline test_completion_veto_extends(harness: Harness, task: unknown) {
  // A vetoed completion gate extends regardless of per-turn progress, and is
  // ordered ahead of the progress rule.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(false, 0, 0, true, true))
  assert_eq(cmd.action, "extend")
  assert_eq(cmd.reason, "completion gate vetoed")
}

pipeline test_required_tools_missing_extends(harness: Harness, task: unknown) {
  // Required tools not yet satisfied extends even with no fresh progress.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(false, 0, 0, false, false))
  assert_eq(cmd.action, "extend")
  assert_eq(cmd.reason, "required tools missing")
}

/**
 * Like `_state` but carries the extension-window counter: turns elapsed since
 * the last turn that satisfied the progress predicate. Zero means this turn
 * did; the loop sets it in `agent_loop_snapshot_state`.
 */
fn _state_with_window(turns_since_progressing: int) {
  return {
    iteration: 10,
    budget: {remaining: 0},
    turn: {tool_call_count: 0},
    session: {required_tools_satisfied: true},
    completion: {vetoed: false},
    progress: {changed: false, turns_since_progressing: turns_since_progressing},
  }
}

pipeline test_progress_inside_window_extends(harness: Harness, task: unknown) {
  // A quiet boundary turn must retain activity measured inside the window.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state_with_window(2))
  assert_eq(cmd.action, "extend")
  assert_eq(cmd.reason, "progress within window")
}

pipeline test_progress_outside_window_does_not_extend(harness: Harness, task: unknown) {
  // Matched control for the case above: same state, but the last progressing
  // turn is now 4 turns back, at the window edge. A window in which no turn
  // progressed still stops the loop, so a thrash cannot buy runway forever.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state_with_window(4))
  assert_eq(cmd.action, "none")
}

pipeline test_window_edge_is_exclusive(harness: Harness, task: unknown) {
  // The last turn still inside a window of 4 is three turns back.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state_with_window(3))
  assert_eq(cmd.action, "extend")
  assert_eq(cmd.reason, "progress within window")
}

pipeline test_unadvanced_window_counter_does_not_extend(harness: Harness, task: unknown) {
  // Absence must not read as success. A non-progressing turn whose counter was
  // never advanced (field missing, so it reads 0 — nominally "this turn
  // progressed") must fall back to the boundary-turn answer and NOT extend.
  const cmd = agent_loop_control_invoke({}, BUDGET, _state(false, 0, 0, false, true))
  assert_eq(cmd.action, "none")
}
