// Run: harn test tests/agent/iteration_telemetry_test.harn
//
// Regression for #6474: the iteration event is the public progress seam used
// by ACP hosts. It must preserve cache usage from the provider response.
import { __iteration_info_payload } from "std/agent/loop_internal"

pipeline test_iteration_info_preserves_cache_usage(harness: Harness, task) {
  const info = __iteration_info_payload(
    {
      provider: "openai",
      model: "gpt-test",
      usage: {
        input_tokens: 500,
        output_tokens: 20,
        cache_read_tokens: 320,
        cache_write_tokens: 64,
        cache_supported: true,
      },
    },
    2,
    "done",
  )
  assert_eq(info.cache_read_tokens, 320)
  assert_eq(info.cache_write_tokens, 64)
  assert_eq(info.cache_supported, true)
}

pipeline test_iteration_info_defaults_missing_cache_usage(harness: Harness, task) {
  const info = __iteration_info_payload({usage: {}}, 0, "")
  assert_eq(info.cache_read_tokens, 0)
  assert_eq(info.cache_write_tokens, 0)
}

pipeline test_iteration_info_carries_first_frame_latency(harness: Harness, task) {
  // A streamed call reports both, and the pair is what lets a consumer
  // separate the wait for the first frame from the time spent streaming.
  const info = __iteration_info_payload(
    {usage: {provider_telemetry: {client_wall_ms: 2000, client_first_frame_ms: 1500}}},
    0,
    "",
  )
  assert_eq(info.response_ms, 2000)
  assert_eq(info.client_first_frame_ms, 1500)
}

pipeline test_iteration_info_omits_an_unmeasured_first_frame(harness: Harness, task) {
  // A single-shot call has no first frame. The key must be absent rather than
  // 0, or "not streamed" reads as "arrived instantly".
  const info = __iteration_info_payload(
    {usage: {provider_telemetry: {client_wall_ms: 2000}}},
    0,
    "",
  )
  assert_eq(info.response_ms, 2000)
  // Positive control: prove the absence check can see a key that is there,
  // so the assertion below fails for the right reason rather than because
  // `keys().contains` never reports true.
  assert_eq(info.keys().contains("response_ms"), true)
  assert_eq(info.keys().contains("client_first_frame_ms"), false)
}
