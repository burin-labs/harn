// Run: harn test tests/agent/done_sentinel_wording_test.harn
//
// The completion contract and the tool contract render into ONE system prompt,
// and they used to disagree about how to spell the done sentinel: the loop
// contract taught `<done>##DONE##</done>` as its own top-level block on every
// non-native route, while the json tool contract taught plain-text `##DONE##`
// and said explicitly not to put it in a block.
//
// Which spelling the detector honors is a property of the tool grammar. Only
// the tagged text grammar parses a `<done>` block, and only there does a parsed
// block redirect the sentinel check to its body (std/agent/postturn
// `__sentinel_hit`); every other route scans the raw response for the sentinel.
// So the wrapper belongs on the text lane and nowhere else.
//
// These tests read the assembled system prompt, not the template, so a binding
// that stops reaching the asset fails them.
import {
  agent_build_turn_system_fragments,
  agent_completion_prompt_bindings,
} from "std/agent/preflight"
import { agent_session_init } from "std/agent/state"

const WRAPPER = "<done>##DONE##</done>"

const PLAIN = "`##DONE##` exactly once in assistant text"

pipeline test_hosts_receive_exact_completion_prompt_bindings(harness: Harness, task: unknown) {
  const json = agent_completion_prompt_bindings(
    harness.llm,
    {tool_format: "json", done_sentinel: "##DONE##"},
  )
  assert_eq(
    json,
    {
      tool_format: "json",
      final_answer: "as plain text",
      done_sentinel: "##DONE##",
      done_sentinel_form: "plain_text",
      done_sentinel_rendered: "##DONE##",
    },
  )
  assert_eq(
    harness.fs.render_template("Give the final user-facing answer {{ final_answer }}.", json),
    "Give the final user-facing answer as plain text.",
  )
  assert_eq(
    agent_completion_prompt_bindings(harness.llm, {tool_format: "text", done_sentinel: "##DONE##"}),
    {
      tool_format: "text",
      final_answer: "in a `<user_response>` block",
      done_sentinel: "##DONE##",
      done_sentinel_form: "done_block",
      done_sentinel_rendered: "<done>##DONE##</done>",
    },
  )
  assert_eq(
    agent_completion_prompt_bindings(harness.llm, {tool_format: "native"}),
    {
      tool_format: "native",
      final_answer: "in concise assistant text",
      done_sentinel: nil,
      done_sentinel_form: "none",
      done_sentinel_rendered: "",
    },
  )
}

pipeline test_completion_prompt_bindings_follow_missing_and_malformed_input_policy(
  harness: Harness,
  task: unknown,
) {
  const missing = agent_completion_prompt_bindings(harness.llm)
  assert_eq(missing.tool_format, "json")
  assert_eq(missing.final_answer, "as plain text")
  assert_eq(missing.done_sentinel_form, "none")
  const malformed_format = try {
    agent_completion_prompt_bindings(harness.llm, {tool_format: "jsonish"})
  }
  assert_eq(is_err(malformed_format), true)
  assert_eq(
    contains(to_string(unwrap_err(malformed_format)), "must be one of native, text, json"),
    true,
  )
  const malformed_sentinel = try {
    agent_completion_prompt_bindings(harness.llm, {tool_format: "json", done_sentinel: 7})
  }
  assert_eq(is_err(malformed_sentinel), true)
  assert_eq(contains(to_string(unwrap_err(malformed_sentinel)), "done_sentinel"), true)
}

pipeline test_completion_prompt_bindings_preserve_denied_format_policy(
  harness: Harness,
  task: unknown,
) {
  harness.llm.provider_capabilities_install(
    """
[[provider.completionbindingtest]]
model_match = "native-only-*"
native_tools = true
preferred_tool_format = "native"
tool_mode_parity = "native_only"
""",
  )
  defer {
    harness.llm.provider_capabilities_clear()
  }
  const denied = try {
    agent_completion_prompt_bindings(
      harness.llm,
      {provider: "completionbindingtest", model: "native-only-model", tool_format: "json"},
    )
  }
  assert_eq(is_err(denied), true)
  assert_eq(contains(to_string(unwrap_err(denied)), "catalog parity native_only"), true)
}

fn _system_prompt(harness: Harness, format: string) -> string {
  const opts = {
    provider: "mock",
    session_id: "done-wording-" + format + "-" + harness.random.uuid(),
    tools: tool_define(
      tool_registry(),
      "look",
      "Look something up.",
      {handler: { _args -> return "ok" }, parameters: {query: {type: "string"}}},
    ),
    tool_format: format,
    loop_until_done: true,
    done_sentinel: "##DONE##",
  }
  const session = agent_session_init(harness.agent, "probe", nil, opts)
  let out = ""
  for fragment in agent_build_turn_system_fragments(harness, session, opts, 0) {
    out = out + to_string(fragment?.text ?? fragment) + "\n"
  }
  return out
}

pipeline test_json_lane_teaches_only_the_plain_text_sentinel(harness: Harness, task: unknown) {
  // The json tool contract already says "as plain text (NOT inside a ```tool
  // block)". The completion contract must not answer that with a block.
  const rendered = _system_prompt(harness, "json")
  assert_eq(contains(rendered, PLAIN), true)
  assert_eq(contains(rendered, WRAPPER), false)
}

pipeline test_text_lane_still_teaches_the_done_block(harness: Harness, task: unknown) {
  // The tagged grammar is the one route where a parsed `<done>` block is
  // authoritative, and its own tool contract teaches the same wrapper.
  const rendered = _system_prompt(harness, "text")
  assert_eq(contains(rendered, WRAPPER), true)
  assert_eq(contains(rendered, PLAIN), false)
}

pipeline test_native_lane_still_teaches_the_plain_text_sentinel(harness: Harness, task: unknown) {
  const rendered = _system_prompt(harness, "native")
  assert_eq(contains(rendered, PLAIN), true)
  assert_eq(contains(rendered, WRAPPER), false)
}
