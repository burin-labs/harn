// Run: harn test tests/agent/runtime_feedback_ttl_test.harn
//
// Post-turn feedback is advice about the turn that just completed. The
// production callback path gives each injection a one-turn lifetime, while a
// still-true condition renews that lifetime by injecting a new reminder.
// Observe that contract through typed feedback and reminder lifecycle events,
// not through the rendered prompt's wording.
import {
  agent_capture_events,
  agent_event_value,
  agent_feedback_injected_event_schema,
} from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

const REMINDER_TOPIC = "transcript.reminder.lifecycle"

fn feedback_count(captured: dict, kind: string) -> int {
  let count = 0
  for event in captured.events {
    if event.type != "feedback_injected" {
      continue
    }
    const feedback = agent_event_value(event, agent_feedback_injected_event_schema())
    if feedback.kind == kind {
      count = count + 1
    }
  }
  return count
}

fn assert_one_turn_expiry(expired: dict, session: string) {
  assert_eq(expired.kind, "transcript.reminder.expired")
  assert_eq(expired.payload.session_id, session)
  assert_eq(expired.payload.reason, "ttl")
  assert_eq(expired.payload.ttl_turns_before, 1)
  assert(expired.payload.reminder_id != "")
}

pipeline test_post_turn_callback_feedback_expires_after_one_turn(harness: Harness, task: unknown) {
  const cursor = harness.obs.event_log_latest(REMINDER_TOPIC)
  with_llm_script(
    harness.llm,
    [llm_text("first pass"), llm_text("second pass"), llm_text("finished ##DONE##")],
    { ->
      const session = "post-turn-ttl-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 4,
        post_turn_callback: { info ->
          if info.iteration == 1 {
            return {feedback_kind: "post_turn_probe", message: "verify the latest change"}
          }
          return nil
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Do the work, then finish.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert_eq(feedback_count(captured, "post_turn_probe"), 1)
      const stream = harness.obs.event_log_subscribe(
        {topic: REMINDER_TOPIC, from_cursor: cursor, kind_prefix: "transcript.reminder.expired"},
      )
      assert_one_turn_expiry(stream.next().value, session)
    },
  )
}

pipeline test_reinjection_renews_the_one_turn_lifetime(harness: Harness, task: unknown) {
  const cursor = harness.obs.event_log_latest(REMINDER_TOPIC)
  with_llm_script(
    harness.llm,
    [
      llm_text("first pass"),
      llm_text("second pass"),
      llm_text("third pass"),
      llm_text("finished ##DONE##"),
    ],
    { ->
      const session = "post-turn-renewal-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 5,
        post_turn_callback: { info ->
          if info.iteration <= 1 {
            return {feedback_kind: "still_true_probe", message: "verify the latest change"}
          }
          return nil
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Do the work, then finish.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert_eq(feedback_count(captured, "still_true_probe"), 2)
      const stream = harness.obs.event_log_subscribe(
        {topic: REMINDER_TOPIC, from_cursor: cursor, kind_prefix: "transcript.reminder.expired"},
      )
      const first = stream.next().value
      const second = stream.next().value
      assert_one_turn_expiry(first, session)
      assert_one_turn_expiry(second, session)
      assert(first.payload.reminder_id != second.payload.reminder_id)
    },
  )
}
