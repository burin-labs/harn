import {
  CompletionRequirementReport,
  completion_requirement_boundary_report,
  completion_requirement_ledger_empty,
  completion_requirement_ledger_unassessed,
  completion_requirement_report,
} from "std/agent/completion_requirements"

fn declared(id: string) {
  return {requirements: [{requirement_id: id, name: id, evidence_roles: ["assistant_output"]}]}
}

fn supported(id: string) -> CompletionRequirementReport {
  return completion_requirement_report(
    declared(id),
    [{requirement_id: id, met: true, evidence_refs: [-1]}],
    {
      requirement_evidence: [
        {
          evidence_index: -1,
          role: "assistant_output",
          supports_completion: true,
          summary: "The answer is present.",
          representative_artifact_ids: [],
        },
      ],
    },
  )
    ?? completion_requirement_ledger_empty()
}

pipeline test_empty_judge_cannot_erase_supported_gate_requirement() {
  const report = completion_requirement_boundary_report(
    {
      gate: supported("answer"),
      verification: completion_requirement_ledger_empty(),
      completion: completion_requirement_ledger_empty(),
    },
  )
  assert_eq(report.required_count, 1)
  assert_eq(report.pending_count, 0)
  assert(report.complete)
  assert_eq(report.rows[0].evidence_refs, [-1])
}

pipeline test_every_judge_declaration_survives_in_boundary_report() {
  const report = completion_requirement_boundary_report(
    {
      gate: supported("answer"),
      verification: completion_requirement_ledger_unassessed(declared("review")),
      completion: completion_requirement_ledger_unassessed(declared("delivery")),
    },
  )
  assert_eq(report.required_count, 3)
  assert_eq(report.pending_count, 2)
  assert_eq(report.pending_names, ["review", "delivery"])
  assert(!report.complete)
}

pipeline test_shared_requirement_stays_pending_until_all_assessors_support_it() {
  const empty = completion_requirement_ledger_empty()
  const met = supported("answer")
  const pending = completion_requirement_ledger_unassessed(declared("answer"))
  for boundary in [
    {gate: met, verification: pending, completion: empty},
    {gate: pending, verification: met, completion: empty},
  ] {
    const report = completion_requirement_boundary_report(boundary)
    assert_eq(report.required_count, 1)
    assert_eq(report.pending_count, 1)
    assert_eq(report.pending_names, ["answer"])
    assert(!report.complete)
    assert_eq(report.rows[0].evidence_refs, [-1])
  }
  const completed = completion_requirement_boundary_report(
    {gate: met, verification: met, completion: empty},
  )
  assert_eq(completed.required_count, 1)
  assert_eq(completed.pending_count, 0)
  assert(completed.complete)
}

pipeline test_invalid_assessment_diagnostics_survive_the_join() {
  const invalid = completion_requirement_report(
    declared("answer"),
    [{requirement_id: "unknown", met: true, evidence_refs: []}],
    {},
  )
    ?? completion_requirement_ledger_empty()
  const report = completion_requirement_boundary_report(
    {
      gate: supported("answer"),
      verification: invalid,
      completion: completion_requirement_ledger_empty(),
    },
  )
  assert_eq(report.required_count, 1)
  assert_eq(report.pending_count, 2)
  assert_eq(report.pending_names, ["answer", "Unknown requirement `unknown`"])
  assert(!report.complete)
}

pipeline test_shared_met_requirement_retains_each_assessors_evidence() {
  const answer = supported("answer")
  const verified = completion_requirement_report(
    {
      requirements: [
        {
          requirement_id: "answer",
          name: "Verified answer",
          evidence_roles: ["deterministic_verification"],
        },
      ],
    },
    [{requirement_id: "answer", met: true, evidence_refs: [-2]}],
    {
      requirement_evidence: [
        {
          evidence_index: -2,
          role: "deterministic_verification",
          supports_completion: true,
          measurement: "passed",
          summary: "Verification passed.",
          representative_artifact_ids: [],
        },
      ],
    },
  )
    ?? completion_requirement_ledger_empty()
  assert(verified.complete)
  for boundary in [
    {gate: answer, verification: verified, completion: answer},
    {gate: verified, verification: answer, completion: verified},
  ] {
    const report = completion_requirement_boundary_report(boundary)
    assert(report.complete)
    assert_eq(report.required_count, 1)
    assert_eq(report.pending_count, 0)
    assert_eq(len(report.rows[0].evidence_refs), 2)
    assert(report.rows[0].evidence_refs.contains(-1))
    assert(report.rows[0].evidence_refs.contains(-2))
    assert_eq(len(report.rows[0].evidence_roles), 2)
    assert(report.rows[0].evidence_roles.contains("assistant_output"))
    assert(report.rows[0].evidence_roles.contains("deterministic_verification"))
    assert_eq(report.rows[0].name, boundary.gate.rows[0].name)
  }
}
