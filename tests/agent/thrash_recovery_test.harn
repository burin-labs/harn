// Run: harn test tests/agent/thrash_recovery_test.harn
//
// Regression coverage for #3943: a cheap model can repeat the same broad read
// until the stall detector reaches `thrash_hard_stop`, then recover on the very
// next model call by reading the exact target file. The loop must give that
// natural recovery one bounded chance instead of converting it into a final
// wrapup whose tool call is silently dropped.
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_text, with_llm_script } from "std/testing"

fn toolset() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "run",
    "Run a command.",
    {
      handler: { _args -> "same capped listing" },
      parameters: {command: {type: "string", description: "Command to run"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  tools = tool_define(
    tools,
    "look",
    "Read a file.",
    {
      handler: { args -> "contents of " + args.path },
      parameters: {path: {type: "string", description: "Path to read"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  tools = tool_define(
    tools,
    "fail",
    "Always fail.",
    {
      handler: { _args ->
        throw "same failure"
      },
      parameters: {command: {type: "string", description: "Command to fail"}},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

fn run_call(id) {
  return {text: "", tool_calls: [{id: id, name: "run", arguments: {command: "ls -R"}}]}
}

fn fail_call(id) {
  return {text: "", tool_calls: [{id: id, name: "fail", arguments: {command: "boom"}}]}
}

fn look_call(id) {
  return {text: "", tool_calls: [{id: id, name: "look", arguments: {path: "app/Models/Entry.php"}}]}
}

fn events_of(events, kind) {
  return events.filter({ event -> event.type == kind })
}

pipeline test_thrash_hard_stop_gets_one_bounded_recovery_turn(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [
      run_call("r1"),
      run_call("r2"),
      look_call("look_recovery"),
      llm_text("Read the Entry model. ##DONE##"),
    ],
    { ->
      let session = "thrash-recovery-" + harness.random.uuid()
      let opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          repeat_same_observation: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 2,
        },
      }
      let captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Write tests after inspecting the target model.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert(contains(captured.result.tools.successful, "look"), "recovery look should dispatch")
      let decisions = events_of(captured.events, "loop_control_decision").filter(
        { event -> event.reason == "thrash_recovery_continue" },
      )
      assert_eq(len(decisions), 1)
      assert_eq(decisions[0].action, "thrash_rescue")
      assert_eq(decisions[0].old_limit, decisions[0].new_limit)
      let iteration_ends = events_of(captured.events, "iteration_end").filter(
        { event -> event.iteration_info?.skip_reason == "thrash_recovery" },
      )
      assert_eq(len(iteration_ends), 1)
      let receipts = events_of(captured.events, "typed_checkpoint").filter(
        { event -> event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1" },
      )
      assert_eq(len(receipts), 1)
      assert_eq(receipts[0].checkpoint.receipt_kind, "thrash_hard_stop_recovery")
      assert_eq(receipts[0].checkpoint.reason, "thrash_recovery_continue")
      assert_eq(receipts[0].checkpoint.warning.pattern, "repeated_same_observation")
      assert(receipts[0].checkpoint.warning.signature != "")
      assert(contains(receipts[0].checkpoint.tool_names, "run"))
      let calls = harness.llm.mock_calls()
      let recovery_prompt = json_stringify(calls[2].messages)
      assert(contains(recovery_prompt, "<context-directives>"))
      assert(!contains(recovery_prompt, "thrash_recovery"))
      assert(!contains(recovery_prompt, "Repeated call signature"))
      assert(contains(recovery_prompt, "Do not issue that same call again"))
    },
  )
}

pipeline test_no_progress_monologue_gets_one_tool_call_recovery_turn(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I should inspect APP models Entry PHP before editing!"),
      look_call("look_after_monologue"),
      llm_text("Read the Entry model. ##DONE##"),
    ],
    { ->
      const session = "monologue-recovery-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 1,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Edit the target file after inspecting it.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert(contains(captured.result.tools.successful, "look"), "recovery look should dispatch")
      const decisions = events_of(captured.events, "loop_control_decision").filter(
        { event -> event.reason == "monologue_recovery_continue" },
      )
      assert_eq(len(decisions), 1)
      assert_eq(decisions[0].action, "thrash_rescue")
      assert_eq(decisions[0].old_limit, decisions[0].new_limit)
      const iteration_ends = events_of(captured.events, "iteration_end").filter(
        { event -> event.iteration_info?.skip_reason == "monologue_recovery" },
      )
      assert_eq(len(iteration_ends), 1)
      const receipts = events_of(captured.events, "typed_checkpoint").filter(
        { event -> event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1" },
      )
      assert_eq(len(receipts), 1)
      const receipt = receipts[0].checkpoint
      assert_eq(receipt.receipt_kind, "thrash_hard_stop_recovery")
      assert_eq(receipt.status, "fired")
      assert_eq(receipt.action, "thrash_rescue")
      assert_eq(receipt.reason, "monologue_recovery_continue")
      assert_eq(receipt.warning.pattern, "no_progress_monologue")
      assert(receipt.warning.signature != "", "monologue warning should carry a content signature")
      assert_eq(receipt.tool_count, 0)
      assert_eq(len(receipt.tool_names), 0)
      const calls = harness.llm.mock_calls()
      const recovery_prompt = json_stringify(calls[2].messages)
      assert(contains(recovery_prompt, "<context-directives>"), "recovery prompt should be scoped")
      assert(!contains(recovery_prompt, "monologue_recovery"), "internal reason should stay hidden")
      assert(
        contains(recovery_prompt, "emit exactly one concrete tool call"),
        "recovery prompt should demand one call",
      )
      assert(
        contains(recovery_prompt, "inspect app/Models/Entry.php"),
        "recovery prompt should preserve stated intent",
      )
    },
  )
}

pipeline test_distinct_monologues_do_not_fire_recovery(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [
      llm_text("First I will inspect the Entry model."),
      llm_text("The controller determines which fields are written."),
      look_call("look_after_distinct_planning"),
      llm_text("Inspection complete. ##DONE##"),
    ],
    { ->
      const session = "distinct-monologues-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 1,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Inspect the model and controller.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert(contains(captured.result.tools.successful, "look"))
      const recoveries = events_of(captured.events, "loop_control_decision").filter(
        { event -> event.reason == "monologue_recovery_continue" },
      )
      assert_eq(len(recoveries), 0)
    },
  )
}

pipeline test_uncovered_thrash_hard_stop_emits_skipped_recovery_receipt(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [fail_call("f1"), fail_call("f2"), fail_call("f3")],
    { ->
      const session = "thrash-no-rung-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 6,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          repeat_same_error: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 1,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Edit the target file.", nil, opts) },
      )
      assert_eq(captured.result.status, "stuck")
      const decisions = events_of(captured.events, "loop_control_decision").filter(
        { event -> event.reason == "thrash_hard_stop" },
      )
      assert_eq(len(decisions), 1)
      const receipts = events_of(captured.events, "typed_checkpoint").filter(
        { event -> event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1" },
      )
      assert_eq(len(receipts), 1)
      const receipt = receipts[0].checkpoint
      assert_eq(receipt.receipt_kind, "thrash_hard_stop_recovery")
      assert_eq(receipt.status, "skipped")
      assert_eq(receipt.action, "stop")
      assert_eq(receipt.reason, "no_rung_for_pattern")
      assert_eq(receipt.outcome, "no_rung_for_pattern")
      assert_eq(receipt.tool_count, 1)
      assert(contains(receipt.tool_names, "fail"))
      assert_eq(receipt.warning.pattern, "repeated_error")
    },
  )
}

pipeline test_final_wrapup_tool_call_skip_is_observable(harness: Harness, task) {
  let session = "wrapup-tool-skip-" + harness.random.uuid()
  let wrapup_counter = harness.runtime.shared_cell(
    {scope: "task_group", key: "wrapup-tool-skip-" + session, initial: 0},
  )
  let mock_llm = { call ->
    if call?.opts?._final_wrapup == true {
      let snap = harness.runtime.shared_snapshot(wrapup_counter)
      harness.runtime.shared_cas(wrapup_counter, snap, snap.value + 1)
      return {ok: true, value: look_call("wrapup_look") + {provider: "mock", model: "mock"}}
    }
    return {ok: true, value: run_call("r1") + {provider: "mock", model: "mock"}}
  }
  let opts: AgentSpec = {
    provider: "mock",
    tools: toolset(),
    tool_format: "native",
    loop_until_done: true,
    done_sentinel: "##DONE##",
    done_judge: nil,
    max_iterations: 1,
    session_id: session,
    llm_caller: mock_llm,
  }
  let captured = agent_capture_events(
    harness.agent,
    session,
    fn() { return agent_loop(harness, "Run out of budget while still trying tools.", nil, opts) },
  )
  assert_eq(captured.result.status, "budget_exhausted")
  assert_eq(harness.runtime.shared_get(wrapup_counter), 1)
  let skipped = events_of(captured.events, "typed_checkpoint").filter(
    { event -> event.checkpoint?.kind == "final_wrapup_tool_calls_skipped" },
  )
  assert_eq(len(skipped), 1)
  assert_eq(skipped[0].checkpoint.schema, "harn.agent_loop_final_wrapup_receipt.v1")
  assert_eq(skipped[0].checkpoint.tool_count, 1)
  assert(contains(skipped[0].checkpoint.tool_names, "look"))
}

// A single prose corrective is not a ladder. When the first monologue rescue
// does not land, the transcript the model reads back is dominated by its own
// repeated narration, so the same request produces the same narration. The
// second rung drops that repeated turn before re-asking, and the loop only
// reports a terminal stall once every rung it owns has been tried.
pipeline test_repeated_monologue_gets_a_second_rung_that_drops_the_narration(
  harness: Harness,
  task,
) {
  with_llm_script(
    harness.llm,
    [
      // The detector builds a no-progress streak only across turns whose
      // token sets overlap by at least 0.8, so these narrations must stay
      // near-identical. Rewriting them into distinct prose stops the streak
      // from ever reaching the threshold and this test would then pass
      // vacuously by never entering recovery at all. The marker on the third
      // turn is one extra token, which keeps similarity above the threshold
      // while staying greppable in the transcript.
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("REPEATEDNARRATION I should inspect app/Models/Entry.php before editing."),
      look_call("look_after_second_rung"),
      llm_text("Read the Entry model. ##DONE##"),
    ],
    { ->
      const session = "monologue-second-rung-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 8,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 2,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Edit the target file after inspecting it.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert(
        contains(captured.result.tools.successful, "look"),
        "second-rung recovery look should dispatch",
      )
      const decisions = events_of(captured.events, "loop_control_decision").filter(
        { event -> event.reason == "monologue_recovery_continue" },
      )
      assert_eq(len(decisions), 2)
      const receipts = events_of(captured.events, "typed_checkpoint").filter(
        { event ->
          event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1"
            && event.checkpoint?.status
            == "fired"
        },
      )
      assert_eq(len(receipts), 2)
      assert_eq(receipts[0].checkpoint.rung, 1)
      assert_eq(receipts[0].checkpoint.rung_budget, 2)
      assert_eq(receipts[0].checkpoint.dropped_narration, false)
      assert_eq(receipts[1].checkpoint.rung, 2)
      assert_eq(receipts[1].checkpoint.dropped_narration, true)
      // The repeated narration reaches the second-rung request only as the
      // quoted intent inside the corrective. Left in place as an assistant
      // turn as well, it would appear twice.
      const calls = harness.llm.mock_calls()
      const second_rung_prompt = json_stringify(calls[3].messages)
      assert_eq(len(split(second_rung_prompt, "REPEATEDNARRATION")) - 1, 1)
      assert(contains(second_rung_prompt, "emit exactly one concrete tool call"))
    },
  )
}

// The ladder must not become a way to keep a dead run alive. Once every rung
// is spent the loop still reports a terminal stuck stop.
pipeline test_monologue_ladder_still_stops_when_every_rung_is_spent(harness: Harness, task) {
  with_llm_script(
    harness.llm,
    [
      // Near-identical on purpose: the no-progress streak only advances across
      // turns whose token sets overlap by at least 0.8. Distinct prose here
      // would never reach the threshold, and the test would pass for the wrong
      // reason — never entering the ladder rather than exhausting it.
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I should inspect app/Models/Entry.php before editing."),
      llm_text("I should inspect app/Models/Entry.php before editing."),
    ],
    { ->
      const session = "monologue-ladder-exhausted-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        tools: toolset(),
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        done_judge: nil,
        max_iterations: 10,
        final_wrapup: false,
        session_id: session,
        stall_diagnostics: {
          enabled: true,
          no_progress_messages: 2,
          hard_stop_after_trips: 1,
          inject_feedback: true,
          max_feedback: 2,
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Edit the target file after inspecting it.", nil, opts) },
      )
      assert_eq(captured.result.status, "stuck")
      assert_eq(captured.result.stop_reason, "thrash_hard_stop")
      const fired = events_of(captured.events, "typed_checkpoint").filter(
        { event ->
          event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1"
            && event.checkpoint?.status
            == "fired"
        },
      )
      assert_eq(len(fired), 2)
      const skipped = events_of(captured.events, "typed_checkpoint").filter(
        { event ->
          event.checkpoint?.schema == "harn.agent_loop_recovery_receipt.v1"
            && event.checkpoint?.status
            == "skipped"
        },
      )
      assert(len(skipped) > 0, "an exhausted ladder should record why it stopped")
      assert_eq(skipped[0].checkpoint.outcome, "rung_limit_exhausted")
    },
  )
}
