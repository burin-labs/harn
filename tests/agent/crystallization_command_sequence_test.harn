import { crystallization_command_sequence_package } from "std/agent/crystallization_curator"

const STEPS: list = [
  {label: "codegen", argv: ["python3", "tools/codegen.py"]},
  {label: "Build wire", argv: ["python3", "tools/build_wire.py"]},
  {label: "tests", argv: ["python3", "-m", "pytest", "-q", "-m", "not soak"]},
]

pipeline test_package_projects_one_sequence_to_a_tool_and_a_shell_line() {
  const pkg = crystallization_command_sequence_package("Relay check", "Verify like CI.", STEPS)
  assert_eq(pkg.entrypoint, "server.harn")
  assert_eq(pkg.tool_names, ["relay_check"])
  assert_eq(
    pkg.verify_command,
    "python3 tools/codegen.py && python3 tools/build_wire.py && python3 -m pytest -q -m 'not soak'",
  )
  assert(
    pkg.source.contains("\"label\":\"build_wire\""),
    "labels are normalized into the tool's plan",
  )
  assert(pkg.source.contains("\"relay_check\""), "the tool is registered under its name")
  assert(
    pkg.test_source.contains("[\"codegen\",\"build_wire\",\"tests\"]"),
    "the test pins the order",
  )
}

pipeline test_package_quotes_a_single_quote_for_the_shell() {
  const pkg = crystallization_command_sequence_package(
    "say",
    "Echo a phrase.",
    [{label: "say", argv: ["echo", "it's done"]}],
  )
  assert_eq(pkg.verify_command, "echo 'it'\"'\"'s done'")
}

pipeline test_emitted_package_preserves_placeholder_like_data(harness: Harness) {
  const steps = [
    {label: "first", argv: ["python3", "__TOOL__.py", "__DESCRIPTION__", "__STEPS__"]},
    {label: "second", argv: ["python3", "__LABELS__.py", "left  right"], cwd: "__TOOL__"},
  ]
  const description = "Keep __TOOL__, __STEPS__, __DESCRIPTION__ and  spaces."
  const pkg = crystallization_command_sequence_package("check", description, steps)
  const dir = harness.fs.mkdtemp_in_workspace("sequence-literal-data")
  harness.fs.write_text(path_join(dir, "server.harn"), pkg.source)
  harness.fs.write_text(path_join(dir, "authored.harn"), pkg.test_source)
  harness.fs.write_text(path_join(dir, "verify.json"), json_stringify(pkg.verify_command))
  harness.fs.write_text(
    path_join(dir, "test.harn"),
    """
import { check_plan, run_plan } from "./server"
import { command_sequence_plan } from "std/command"

pipeline test_original_arguments_reach_the_emitted_runner(harness: Harness) {
  const expected = [
    {label: "first", argv: ["python3", "__TOOL__.py", "__DESCRIPTION__", "__STEPS__"]},
    {label: "second", argv: ["python3", "__LABELS__.py", "left  right"], cwd: "__TOOL__"},
  ]
  assert_eq(check_plan(""), expected)
  let calls = []
  const receipt = run_plan({ argv, cwd ->
    calls = calls + [{argv: argv, cwd: cwd}]
    return {success: true, exit_code: 0, combined: "passed"}
  }, "workspace", check_plan(""))
  assert_eq(receipt.ok, true)
  assert_eq(calls, [
    {argv: expected[0].argv, cwd: "workspace"},
    {argv: expected[1].argv, cwd: path_join("workspace", "__TOOL__")},
  ])
  const verifier = json_parse(harness.fs.read_text(path_join(harness.fs.project_root(), "verify.json")))
  const planned = command_sequence_plan(verifier)
  assert_eq(planned.status, "measured")
  assert_eq(planned.steps, [
    {argv: expected[0].argv, cwd: ""},
    {argv: expected[1].argv, cwd: "__TOOL__"},
  ])
}
""",
  )
  const binary = harness.env.get("HARN_BIN") ?? "harn"
  const executed = harness.process.exec(
    binary,
    "test",
    path_join(dir, "test.harn"),
    path_join(dir, "authored.harn"),
  )
  assert_eq(executed.exit_code, 0, executed.stdout + executed.stderr)
  assert(pkg.source.contains(json_stringify(description)), "description bytes remain literal data")
  harness.fs.delete(dir)
}

pipeline test_package_projects_a_fast_check_beside_the_full_chain() {
  const full = crystallization_command_sequence_package("Relay check", "Verify like CI.", STEPS)
  assert_eq(full?.fast_verify_command, nil, "no fast check unless one is learned")
  const pkg = crystallization_command_sequence_package(
    "Relay check",
    "Verify like CI.",
    STEPS,
    [{label: "alerts", argv: ["python3", "-m", "pytest", "-q", "tests/alerts"]}],
  )
  assert_eq(pkg.fast_verify_command, "python3 -m pytest -q tests/alerts")
  assert_eq(pkg.verify_command, full.verify_command, "the full chain is unchanged")
}

pipeline test_package_runs_a_step_from_its_directory() {
  const pkg = crystallization_command_sequence_package(
    "web check",
    "Generate, then test the web package.",
    [
      {label: "codegen", argv: ["python3", "tools/codegen.py"]},
      {label: "web", argv: ["npm", "test"], cwd: "packages/web"},
    ],
  )
  assert_eq(pkg.verify_command, "python3 tools/codegen.py && (cd packages/web && npm test)")
  assert(
    pkg.source.contains("\"cwd\":\"packages/web\""),
    "the tool's plan keeps the step directory",
  )
  const escaped = try {
    crystallization_command_sequence_package(
      "web check",
      "Escape.",
      [{label: "web", argv: ["npm", "test"], cwd: "../other"}],
    )
  }
  assert(is_err(escaped), "a step directory must stay inside the repository")
  for dir in [" packages/web", "packages/web ", "packages/ web"] {
    const unsupported = try {
      crystallization_command_sequence_package(
        "web check",
        "Keep the supplied directory.",
        [{label: "web", argv: ["npm", "test"], cwd: dir}],
      )
    }
    assert(is_err(unsupported), "unsupported directory bytes must not be silently rewritten")
  }
}

pipeline test_package_rejects_machine_paths_and_unbounded_sequences() {
  const absolute = try {
    crystallization_command_sequence_package(
      "check",
      "Run it.",
      [{label: "run", argv: ["/usr/local/bin/make", "test"]}],
    )
  }
  assert(is_err(absolute), "a machine-specific absolute path must not become a learned tool")
  let many = []
  for index in range(0, 9) {
    many = many + [{label: "step ${index}", argv: ["make", "step${index}"]}]
  }
  const unbounded = try {
    crystallization_command_sequence_package("check", "Run it.", many)
  }
  assert(is_err(unbounded), "a sequence is at most eight steps")
  const empty = try {
    crystallization_command_sequence_package("check", "Run it.", [])
  }
  assert(is_err(empty), "a sequence needs at least one step")
}
