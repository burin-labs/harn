import {
  agent_session_inject_feedback,
  agent_session_inject_reminder,
  agent_session_messages,
} from "std/agent/state"
import { llm_text, with_llm_script } from "std/testing"

pipeline test_feedback_and_reminders_share_one_provider_bound_envelope(harness: Harness, task) {
  const session = harness.agent.open("feedback-envelope-" + harness.random.uuid())
  harness.agent.inject(session, {role: "user", content: "Fix the failing test."})
  agent_session_inject_feedback(harness.agent, session, "step_judge", "same residual")
  agent_session_inject_feedback(harness.agent, session, "verify_completion", "same residual")
  agent_session_inject_reminder(
    harness.agent,
    session,
    {body: " same   residual ", authority: "contract", dedupe_key: "task-contract"},
  )
  agent_session_inject_feedback(harness.agent, session, "parse_guidance", "emit valid JSON")
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  assert_eq(len(reminders), 4, "every producer persists through the typed directive lifecycle")
  assert_eq(
    len(reminders.filter({ event -> event.reminder.authority == "corrective" }).to_list()),
    3,
  )
  assert_eq(harness.agent.snapshot(session).messages[0].content, "Fix the failing test.")
  with_llm_script(
    harness.llm,
    [llm_text("ok")],
    { ->
      harness.llm.call(
        "ignored",
        "base system",
        {
          provider: "mock",
          model: "mock",
          messages: agent_session_messages(harness.agent, session),
          session_id: session,
        },
      )
      const call = harness.llm.mock_calls()[0]
      const last = call.messages[len(call.messages) - 1]
      assert_eq(last.role, "user")
      assert(contains(last.content, "<context-directives>"))
      assert(contains(last.content, "authority=\"contract\""))
      assert(contains(last.content, "authority=\"corrective\""))
      assert_eq(
        len(split(last.content, "<directive authority=")) - 1,
        2,
        "the contract duplicate and one corrective directive survive",
      )
      assert(contains(last.content, "same   residual"))
      assert(!contains(last.content, "<directive authority=\"corrective\">\nsame residual\n"))
      assert(contains(last.content, "emit valid JSON"))
      assert(
        index_of(last.content, "authority=\"contract\"")
          < index_of(last.content, "authority=\"corrective\""),
      )
      assert(!contains(last.content, "runtime_feedback"))
      assert(!contains(last.content, "step_judge"))
      assert(!contains(last.content, "verify_completion"))
    },
  )
  harness.agent.close(session)
}

pipeline test_feedback_dedupe_key_replaces_same_kind_before_render(harness: Harness, task) {
  const session = harness.agent.open("feedback-key-dedupe-" + harness.random.uuid())
  harness.agent.inject(session, {role: "user", content: "Repair the output."})
  agent_session_inject_feedback(harness.agent, session, "parse_guidance", "first correction")
  agent_session_inject_feedback(harness.agent, session, "parse_guidance", "latest correction")
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  assert_eq(len(reminders), 1)
  assert_eq(reminders[0].reminder.body, "latest correction")
  assert_eq(reminders[0].reminder.dedupe_key, "runtime_feedback/parse_guidance")
  assert_eq(reminders[0].reminder.authority, "corrective")
  harness.agent.close(session)
}
