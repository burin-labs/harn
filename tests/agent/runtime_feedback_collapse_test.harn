import { agent_session_inject_feedback } from "std/agent/state"

pipeline test_feedback_dedupe_key_replaces_same_kind_before_render(
  harness: Harness,
  task: unknown,
) {
  const session = harness.agent.open("feedback-key-dedupe-" + harness.random.uuid())
  harness.agent.inject(session, {role: "user", content: "Repair the output."})
  agent_session_inject_feedback(harness.agent, session, "parse_guidance", "first correction")
  agent_session_inject_feedback(harness.agent, session, "parse_guidance", "latest correction")
  const reminders = transcript_events_by_kind(harness.agent.snapshot(session), "system_reminder")
  assert_eq(len(reminders), 1)
  assert_eq(reminders[0].reminder.body, "latest correction")
  assert_eq(reminders[0].reminder.dedupe_key, "runtime_feedback/parse_guidance")
  assert_eq(reminders[0].reminder.authority, "corrective")
  harness.agent.close(session)
}
