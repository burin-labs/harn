import { agent_stall_apply_result, agent_stall_initial_state } from "std/agent/stall"
import { assert_throws } from "std/testing"
import { _fail_dispatch, _verification_of, observe_stall } from "./stall_dispatch_fixture"

// -------------------------------------------------------------------------------------------------

// #burin-cutover seam 3: remediation_delivered cumulative-count intake. The callback
// may return a bool (per-turn, unchanged) OR an int cumulative count; for the int form
// harn derives the per-turn delivered event by diffing against the previously-seen
// count for the active signature, resetting the baseline on a signature change. The
// count-tracking state must never enter an output projection.

// -------------------------------------------------------------------------------------------------

const REMEDIATION_CONFIG = {
  enabled: true,
  repair_aware: true,
  stuck_same_diagnostic_after: 99,
  post_edit_reverify: true,
  repeat_same_error: 99,
  repeat_same_observation: 99,
  no_progress_messages: 99,
  ping_pong_cycles: 99,
}

fn _fold_remediation(agent: HarnessAgent, state: any, cb: any, prev_dispatch: any) {
  return observe_stall(
    agent,
    state,
    {
      session_id: "unit-rem",
      config: REMEDIATION_CONFIG + {remediation_delivered: cb},
      dispatch: prev_dispatch,
      verification_dispatch: _verification_of(prev_dispatch),
    },
  )
}

pipeline test_remediation_bool_true_trips_each_qualifying_turn(harness: Harness, task: any) {
  // Bool path (unchanged): a truthy per-turn fact trips delivered_fix_not_landing on
  // EVERY qualifying turn (streak >= 2, advanced) — turns 2 and 3 both fire.
  const cb = { _ctx -> true }
  const o1 = _fold_remediation(
    harness.agent,
    agent_stall_initial_state(),
    cb,
    _fail_dispatch("boom"),
  )
  assert(o1.warning == nil, "streak 1 does not yet qualify")
  const o2 = _fold_remediation(harness.agent, o1.state, cb, _fail_dispatch("boom"))
  assert(o2.warning != nil)
  assert(o2.warning.pattern == "delivered_fix_not_landing")
  assert(o2.warning.remediation_delivered)
  const o3 = _fold_remediation(harness.agent, o2.state, cb, _fail_dispatch("boom"))
  assert(o3.warning != nil)
  assert(o3.warning.pattern == "delivered_fix_not_landing")
}

pipeline test_remediation_count_trips_once_per_increase(harness: Harness, task: any) {
  // Count path: a CONSTANT cumulative count of 1 means one fix was delivered (when the
  // signature first went active) and none since. It parity-trips at turn 2 (0 -> 1
  // crossing) exactly like the bool true, but does NOT re-fire at turn 3 (1 -> 1 is no
  // new delivery) — the per-signature diff, not a raw truthiness, drives the event.
  const cb = { _ctx -> 1 }
  const o1 = _fold_remediation(
    harness.agent,
    agent_stall_initial_state(),
    cb,
    _fail_dispatch("boom"),
  )
  assert(o1.warning == nil)
  const o2 = _fold_remediation(harness.agent, o1.state, cb, _fail_dispatch("boom"))
  assert(o2.warning != nil)
  assert(o2.warning.pattern == "delivered_fix_not_landing")
  assert_eq(o2.state.remediation_delivered_count, 1)
  const o3 = _fold_remediation(harness.agent, o2.state, cb, _fail_dispatch("boom"))
  assert(o3.warning == nil, "a flat cumulative count does not re-deliver")
}

pipeline test_remediation_count_zero_never_trips(harness: Harness, task: any) {
  // A cumulative count that never leaves 0 means no fix was delivered — no trip, even
  // though the streak qualifies. Distinguishes count intake from bool (0 is a real
  // count, not a falsy sentinel that a bool would otherwise treat identically).
  const cb = { _ctx -> 0 }
  const o1 = _fold_remediation(
    harness.agent,
    agent_stall_initial_state(),
    cb,
    _fail_dispatch("boom"),
  )
  const o2 = _fold_remediation(harness.agent, o1.state, cb, _fail_dispatch("boom"))
  assert(o2.warning == nil)
  const o3 = _fold_remediation(harness.agent, o2.state, cb, _fail_dispatch("boom"))
  assert(o3.warning == nil)
  // Internal count-tracking never leaks into the terminal projection.
  const applied = agent_stall_apply_result({status: "stuck"}, true, o3.state)
  assert(!contains(json_stringify(applied), "remediation_delivered_count"))
  assert(!contains(json_stringify(applied), "remediation_delivered_signature"))
}

pipeline test_remediation_count_baseline_resets_on_signature_change(harness: Harness, task: any) {
  // Reset-on-signature-change: the same cumulative count of 1 trips again for a NEW
  // failure signature, because the diff baseline resets when the active signature
  // changes (the count is "since this signature became active").
  const cb = { _ctx -> 1 }
  const a1 = _fold_remediation(
    harness.agent,
    agent_stall_initial_state(),
    cb,
    _fail_dispatch("boom A"),
  )
  const a2 = _fold_remediation(harness.agent, a1.state, cb, _fail_dispatch("boom A"))
  assert(a2.warning != nil, "first signature trips at streak 2")
  // Switch to a different failure signature: streak resets to 1 (no trip yet).
  const b1 = _fold_remediation(harness.agent, a2.state, cb, _fail_dispatch("totally different B"))
  assert(b1.warning == nil)
  assert_eq(b1.state.same_diagnostic_streak, 1)
  // Same cumulative-1 count trips again for signature B: its baseline reset to 0.
  const b2 = _fold_remediation(harness.agent, b1.state, cb, _fail_dispatch("totally different B"))
  assert(b2.warning != nil)
  assert(b2.warning.pattern == "delivered_fix_not_landing")
}

pipeline test_remediation_bad_return_throws(harness: Harness, task: any) {
  // A callback returning neither bool, int, nor nil fails loudly.
  const cb = { _ctx -> "not-a-count" }
  assert_throws(
    { ->
      return _fold_remediation(
        harness.agent,
        _fold_remediation(harness.agent, agent_stall_initial_state(), cb, _fail_dispatch("boom"))
          .state,
        cb,
        _fail_dispatch("boom"),
      )
    },
    "non-bool/int/nil remediation return must throw",
  )
}
