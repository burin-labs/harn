pipeline test_completion_judge_prompt_uses_projection_not_callable_schema(
  harness: Harness,
  task: unknown,
) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "look",
    "UNUSED_READ_SCHEMA_BULK ".repeat(600),
    {
      handler: { _args -> "READ_ONLY_RESULT_BULK ".repeat(600) },
      parameters: {path: {type: "string", required: true}},
      annotations: {kind: "read", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "edit",
    "UNUSED_EDIT_SCHEMA_BULK ".repeat(600),
    {
      handler: { _args -> "WRITE_RESULT_MARKER" },
      parameters: {content: {type: "string", required: true}},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "read-1", name: "look", arguments: {path: "fact.txt"}}]},
      {
        text: "",
        tool_calls: [{id: "edit-1", name: "edit", arguments: {content: "WRITE_ARG_MARKER"}}],
      },
      llm_done(),
      {text: "{\"verdict\":\"done\",\"detail\":\"The write and verification are sufficient.\"}"},
    ],
    { ->
      const session = "judge-projection-prompt-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: tools,
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 4,
        verify_completion_judge: {provider: "mock", max_invocations: 1},
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Apply the requested change.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      assert_eq(len(harness.llm.mock_calls()), 4)
      const projection = captured.events.filter(
        { event ->
          event.type == "typed_checkpoint"
            && event?.checkpoint?.schema
              == "harn.completion_judge_evidence_projection.v1"
        },
      )
        .to_list()
      assert_eq(len(projection), 1)
      assert_eq(projection[0].checkpoint.included_action_count, 1)
      assert_eq(projection[0].checkpoint.included_read_only_call_count, 1)
      assert_eq(projection[0].checkpoint.omitted_read_only_call_count, 0)
    },
  )
}

pipeline test_completion_judge_keeps_mutation_and_lifecycle_anomaly_after_many_verifiers(
  harness: Harness,
  task: unknown,
) {
  let messages = [
    __assistant_facts(
      "",
      [{id: "edit-1", name: "edit", arguments: {content: "NEGATIVE_ASSERTION"}}],
    ),
    __result_facts("edit", "edit-1", "write applied", "ok"),
  ]
  let index = 0
  while index < 8 {
    const id = "verify-" + to_string(index)
    messages = messages
      + [
        __assistant_facts("", [{id: id, name: "verify", arguments: {}}]),
        __result_facts("verify", id, "verification passed", "ok"),
      ]
    index = index + 1
  }
  messages = messages
    + [__assistant_facts("", [{id: "pending", name: "run", arguments: {}}])]
  let registry = [
    {name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}},
    {
      name: "verify",
      annotations: {
        kind: "execute",
        side_effect_level: "process_exec",
        completion_evidence_role: "verification",
      },
    },
    {name: "run", annotations: {kind: "execute", side_effect_level: "process_exec"}},
  ]
  let tool_index = 0
  while tool_index < 500 {
    registry = registry
      + [
        {
          name: "unused-" + to_string(tool_index) + "-" + "x".repeat(300),
          description: "UNBOUNDED_REGISTRY_BULK".repeat(100),
        },
      ]
    tool_index = tool_index + 1
  }
  const projected = __judge_evidence_projection(messages, {tools: registry})
  assert(contains(projected.serialized, "NEGATIVE_ASSERTION"))
  assert(contains(projected.serialized, "pending"))
  assert(contains(projected.serialized, "tool_call_result_missing"))
  assert(!contains(projected.serialized, "UNBOUNDED_REGISTRY_BULK"))
  assert(
    projected.stats.serialized_chars < 18000,
    "semantic slots bound registry and history growth",
  )
}

pipeline test_completion_judge_preserves_ambiguous_result_evidence(
  harness: Harness,
  task: unknown,
) {
  const projected = __judge_evidence_projection(
    [
      __assistant_facts("", [{id: "edit-1", name: "edit", arguments: {content: "MUTATION_BODY"}}]),
      __result_facts("edit", "edit-1", "FIRST_RECEIPT", "ok"),
      __result_facts("edit", "edit-1", "SECOND_RECEIPT", "ok"),
    ],
    {tools: [{name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}}]},
  )
  const action = projected.packet.actions[0]
  assert(action != nil)
  assert_eq(action.lifecycle_status, "ambiguous")
  assert(contains(projected.serialized, "MUTATION_BODY"))
  assert(contains(projected.serialized, "FIRST_RECEIPT"))
  assert(contains(projected.serialized, "SECOND_RECEIPT"))
  assert(contains(projected.serialized, "duplicate_tool_result"))
}

pipeline test_completion_judge_transports_veto_and_repair_from_compact_packet(
  harness: Harness,
  task: unknown,
) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Edit a file.",
    {
      handler: { _args -> "write applied" },
      parameters: {content: {type: "string", required: true}},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {
        text: "",
        tool_calls: [
          {
            id: "edit-1",
            name: "edit",
            arguments: {content: "assert not hasattr(service, 'delete_experiment')"},
          },
        ],
      },
      llm_done(),
      {
        text: json_stringify(
          {
            verdict: "continue",
            detail:
              "Deletion behavior is not exercised; replace the hollow negative with a behavior-sensitive test.",
          },
        ),
      },
      llm_done(),
    ],
    { ->
      const session = "judge-hollow-negative-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Implement experiment deletion with a behavior-sensitive regression.",
          nil,
          {
            provider: "mock",
            session_id: session,
            tools: tools,
            tool_format: "native",
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 4,
            verify_completion_judge: {provider: "mock", max_invocations: 1},
          },
        ) },
      )
      assert_eq(captured.result.status, "completion_unverified")
      // Every judge call the user waits through opens a window and closes it,
      // in that order. Without the start half the host has nothing to show
      // between the last edit and the verdict (bc#6934).
      const window = __judge_window(captured.events)
      assert(len(window) > 0, "a real judge run must emit window events")
      assert_eq(window[0], "judge_started", "the window opens before it closes")
      assert_eq(
        len(window.filter({ kind -> kind == "judge_started" }).to_list()),
        len(window.filter({ kind -> kind == "judge_decision" }).to_list()),
        "every opened window is closed",
      )
      const receipts = __completion_receipts(captured.events)
      assert_eq(receipts[0].action, "continue")
      assert(contains(receipts[0].evidence_id, "sha256:"))
      assert_eq(receipts[len(receipts) - 1].action, "stop_unverified")
      assert_eq(receipts[len(receipts) - 1].reason, "completion_judge_cap_reached")
    },
  )
}

pipeline test_completion_judge_refuses_request_that_cannot_fit_terminal_deadline(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [llm_done()],
    { ->
      const session = "judge-deadline-admission-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish with a typed terminal receipt.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 2,
            deadline_ms: 1,
            verify_completion_judge: {
              provider: "mock",
              max_invocations: 1,
              operation_timeout_ms: 100,
              deadline_reserve_ms: 0,
            },
            turn_end_condition: {provider: "mock", max_invocations: 1},
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 1, "only the primary model turn may dispatch")
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "completion_judge_deadline_admission_refused")
      const admissions = captured.events.filter(
        { event ->
          event.type == "typed_checkpoint"
            && event?.checkpoint?.schema
              == "harn.completion_judge_admission.v1"
        },
      )
        .to_list()
      assert_eq(len(admissions), 1, "one refused judge admission receipt")
      assert(!admissions[0].checkpoint.admitted)
      assert_eq(admissions[0].checkpoint.outcome, "deadline_budget_insufficient")
      const decisions = captured.events.filter(
        { event ->
          event.type == "judge_decision"
            && event?.verdict == "unavailable"
            && event?.reason
              == "completion_judge_deadline_admission_refused"
        },
      )
        .to_list()
      assert_eq(len(decisions), 1, "one unavailable judge decision")
      // The window opens one gate before the model call, so a request refused
      // at admission still announces and then immediately closes. A host that
      // renders `judge_started` must never be left holding an open window.
      assert_eq(
        __judge_window(captured.events),
        ["judge_started", "judge_decision"],
        "a refused admission still closes the window it opened",
      )
      const receipts = __completion_receipts(captured.events)
      assert_eq(len(receipts), 1, "one terminal completion directive")
      assert_eq(receipts[0].action, "stop_unverified")
      assert_eq(receipts[0].reason, "completion_judge_deadline_admission_refused")
      assert(!receipts[0].invoked.verify_completion_judge)
    },
  )
}

pipeline test_fenced_completion_judge_uses_typed_checkpoint(harness: Harness, task: unknown) {
  const judge_response = {
    text:
      "```json\n{\"verdict\":\"continue\",\"detail\":\"Run `harn test tests/agent/judge_runtime_test.harn` now because verification is missing.\"}\n```",
  }
  with_llm_script(
    harness.llm,
    [llm_done(), judge_response, llm_text("Addressed the gap. ##DONE##")],
    { ->
      const session = "judge-fenced-typed-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        done_sentinel: "##DONE##",
        loop_until_done: true,
        max_iterations: 3,
        verify_completion_judge: {provider: "mock", max_invocations: 1},
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Finish after satisfying the judge.", nil, opts) },
      )
      const feedback = __feedback_contents(captured, "verify_completion")
      assert_eq(
        feedback,
        [
          "Run `harn test tests/agent/judge_runtime_test.harn` now because verification is missing.",
        ],
      )
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "completion_judge_cap_reached")
    },
  )
}

pipeline test_completion_judge_accepts_then_clamps_overlong_detail(
  harness: Harness,
  task: unknown,
) {
  const detail = "Verified the requested behavior with the focused end-to-end test. ".repeat(6)
  assert(len(detail) > 240)
  with_llm_script(
    harness.llm,
    [llm_done(), {text: json_stringify({verdict: "done", detail: detail})}],
    { ->
      const session = "judge-overlong-detail-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        done_sentinel: "##DONE##",
        loop_until_done: true,
        max_iterations: 1,
        verify_completion_judge: {provider: "mock", max_invocations: 1},
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish after the completion judge confirms the evidence.",
          nil,
          opts,
        ) },
      )
      assert_eq([len(harness.llm.mock_calls()), captured.result.status], [2, "done"])
      const decisions =
        captured.events.filter({ event -> event.type == "judge_decision" }).to_list()
      assert_eq(len(decisions), 1)
      assert_eq(decisions[0].verdict, "done")
      assert_eq(decisions[0].reasoning, substring(detail, 0, 240))
    },
  )
}

pipeline test_invalid_deterministic_completion_result_stops_unverified(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [llm_done()],
    { ->
      const session = "judge-invalid-deterministic-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish only after the deterministic completion check decides.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 1,
            verify_completion: { _payload -> 42 },
          },
        ) },
      )
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "completion_verifier_invalid_result")
      const receipts = __completion_receipts(captured.events)
      assert_eq(len(receipts), 1)
      assert_eq(receipts[0].action, "stop_unverified")
      assert(receipts[0].invoked.deterministic)
    },
  )
}

pipeline test_deterministic_veto_short_circuits_model_judges(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [llm_done()],
    { ->
      const session = "judge-short-circuit-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Do not spend a model judge call after a deterministic veto.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 1,
            verify_completion: { _payload -> "deterministic repair" },
            verify_completion_judge: {provider: "mock", max_invocations: 1},
            turn_end_condition: {provider: "mock", max_invocations: 1},
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 1)
      const receipts = __completion_receipts(captured.events)
      assert_eq(len(receipts), 1)
      assert(receipts[0].invoked.deterministic)
      assert(!receipts[0].invoked.verify_completion_judge)
      assert(!receipts[0].invoked.turn_end_condition)
    },
  )
}

// The read-only tool registry used by the research-summary fixtures below.
// `delete` is a canonical workspace mutation; the rest are pure reads.
fn __research_tools() -> list {
  return [
    {name: "grep", annotations: {kind: "read", side_effect_level: "read_only"}},
    {name: "read_file", annotations: {kind: "read", side_effect_level: "read_only"}},
    {name: "delete", annotations: {kind: "edit", side_effect_level: "workspace_write"}},
  ]
}

fn __read_turn(ordinal: int, name: string, target: string, result: string) -> list {
  const call_id = "read-" + to_string(ordinal)
  return [
    __assistant_facts(
      "Look at " + target + ".",
      [{id: call_id, function: {name: name, arguments: {path: target}}}],
    ),
    __result_facts(name, call_id, result, "ok"),
  ]
}

/*
 * harn#7797. A turn that proves no work is warranted produces read-only
 * evidence and nothing else. Before the research summary the packet kept the
 * single mutation and dropped every read, so the judge saw a bare `delete` and
 * read a compliant stop as an unexplained gap.
 */
pipeline test_completion_evidence_carries_read_only_research(harness: Harness, task: unknown) {
  let messages = []
  messages = messages
    + __read_turn(1, "grep", "src/service.rs", "grep: no matches for `delete_experiment`")
  messages = messages + __read_turn(2, "read_file", "src/service.rs", "pub struct Service {}")
  messages = messages + __read_turn(3, "grep", "tests/", "grep: no matches")
  messages = messages + __read_turn(4, "read_file", "Cargo.toml", "[package]\nname = \"svc\"")
  messages = messages + __read_turn(5, "grep", "docs/", "grep: no matches")
  messages = messages
    + [
      __assistant_facts(
        "No typed code exists; revert the speculative change.",
        [{id: "delete-1", function: {name: "delete", arguments: {path: "src/new.rs"}}}],
      ),
      __result_facts("delete", "delete-1", "removed", "ok", {mutation_status: "applied"}),
    ]
  const projected = __judge_evidence_projection(messages, {tools: __research_tools()})
  const summary = projected.packet.research_summary
  assert_eq(summary.schema, "harn.completion_judge_research_summary.v1")
  assert_eq(summary.read_only_call_count, 5)
  assert_eq(summary.included_count, 5)
  assert_eq(summary.omitted_count, 0)
  assert_eq(len(summary.reads), 5)
  assert_eq(projected.stats.included_read_only_call_count, 5)
  assert_eq(projected.stats.omitted_read_only_call_count, 0)
  const names = summary.reads.map({ read -> read.name }).to_list()
  assert(contains(names, "grep"))
  assert(contains(names, "read_file"))
  const first = summary.reads[0]
  assert(contains(first.target, "src/service.rs"))
  assert(contains(first.result_digest, "no matches"))
  assert(!first.has_error_result)
  // The research must reach the judge's own view, not only telemetry.
  assert(contains(projected.serialized, "delete_experiment"))
  assert(contains(projected.serialized, "Cargo.toml"))
  // Negative direction: the mutation is still the retained action.
  assert_eq(len(projected.packet.actions), 1)
  assert_eq(projected.packet.actions[0].name, "delete")
}

/*
 * The budget degrades to counts, never to silence. Nine reads exceed the
 * record budget; the recent ones keep records and the rest stay visible as a
 * non-zero omitted count.
 */
pipeline test_completion_evidence_research_budget_degrades_to_counts(
  harness: Harness,
  task: unknown,
) {
  let messages = []
  for index in range(1, 10) {
    messages = messages
      + __read_turn(index, "grep", "file-" + to_string(index) + ".rs", "no matches")
  }
  const projected = __judge_evidence_projection(messages, {tools: __research_tools()})
  const summary = projected.packet.research_summary
  assert_eq(summary.read_only_call_count, 9)
  assert_eq(summary.included_count, 6)
  assert_eq(summary.omitted_count, 3)
  assert_eq(len(summary.reads), 6)
  // The retained window is the most recent reads, not the oldest.
  assert(contains(summary.reads[0].target, "file-4.rs"))
  assert(contains(summary.reads[5].target, "file-9.rs"))
  assert_eq(projected.stats.included_read_only_call_count, 6)
  assert_eq(projected.stats.omitted_read_only_call_count, 3)
}

/*
 * Negative control. A turn with only mutations gains no research records and
 * keeps its action selection unchanged.
 */
pipeline test_completion_evidence_mutation_only_turn_has_empty_research(
  harness: Harness,
  task: unknown,
) {
  const messages = [
    __assistant_facts(
      "Apply the change.",
      [{id: "edit-1", function: {name: "delete", arguments: {path: "src/old.rs"}}}],
    ),
    __result_facts("delete", "edit-1", "removed", "ok", {mutation_status: "applied"}),
  ]
  const projected = __judge_evidence_projection(messages, {tools: __research_tools()})
  const summary = projected.packet.research_summary
  assert_eq(summary.read_only_call_count, 0)
  assert_eq(summary.included_count, 0)
  assert_eq(summary.omitted_count, 0)
  assert_eq(len(summary.reads), 0)
  assert_eq(projected.stats.included_read_only_call_count, 0)
  assert_eq(projected.stats.omitted_read_only_call_count, 0)
  assert_eq(len(projected.packet.actions), 1)
  assert_eq(projected.packet.actions[0].name, "delete")
}

/**
 * A BACKGROUND VERIFIER'S POLL IS VERIFICATION EVIDENCE, AND MUST BE DECLARED SO.
 *
 * From the 2026-09-02 py-test trial 1 kill
 * (`eval-py-test-20260902-204700-4d07ec7f-ab3-t1`). The agent dispatched its
 * verifier to a background handle and polled it five times. Every poll returned
 * ok with `dispatch_status: completed` and "Command succeeded (exit 0) ...
 * 5 passed in 2.24s". The deterministic gate returned done with confirm at
 * iterations 12, 14, 16, 18 and 20; the completion judge overrode every one,
 * each time saying the verifier was still running and naming handle
 * `hto-2f4b-3`; the judge cap then ended a verified run as
 * `completion_unverified`.
 *
 * WHY THE JUDGE NEVER SAW A POLL, precisely. `poll_command` and `wait_command`
 * are annotated `kind: "execute"`, `side_effect_level: "read_only"`. That does
 * NOT make them read-only to the classifier -- `__AGENT_READ_ONLY_TOOL_KINDS` is
 * `["read", "search", "think", "fetch"]` and excludes `execute`, so
 * `agent_tool_is_read_only` returns false and the read-only research path never
 * touches them. Instead `__judge_evidence_role` fell through every branch: not
 * an edit, not a workspace write, not read-only. It returned "other". An
 * "other" action is counted in `relevant_action_count` and then fills no slot,
 * because selection only keeps the latest mutation, verification and problem.
 * So the poll was silently dropped as an older action while the judge was told
 * a verifier existed and never shown its result.
 *
 * The fix is a declaration at the annotation seam, not a rule in the judge: the
 * two handle-reading tools now carry `completion_evidence_role: "verification"`,
 * because what they return IS the command's outcome -- the same proof a
 * synchronous verifier produces.
 *
 * The discriminator is not how many calls were dropped. The passing sibling in
 * the same cell, one iteration apart, dropped six read-only calls and finished
 * cleanly, because it verified synchronously through `verify` and none of its
 * verification evidence arrived through a handle. What matters is whether the
 * ONLY proof that verification succeeded arrives through a call that fills no
 * evidence slot.
 */
pipeline test_command_handle_polls_are_declared_verification_evidence(
  harness: Harness,
  _task: any,
) {
  // The handle tools are opt-in; a run that never dispatches to the background
  // never registers them. Enable them explicitly so this census measures the
  // annotation rather than the default tool set.
  const tools = agent_command_tools(harness, nil, {background_commands: true})
  let seen: list<string> = []
  for entry in tools.tools {
    const name = to_string(entry?.name ?? "")
    if name != "poll_command" && name != "wait_command" {
      continue
    }
    seen = seen + [name]
    assert_eq(
      "verification",
      to_string(entry?.annotations?.completion_evidence_role ?? ""),
      "${name} returns the background command's own outcome, so it must be declared verification evidence or the completion judge can never be shown a passing async verifier",
    )
  }
  // A census that found neither tool would pass the loop above vacuously.
  assert_eq(2, len(seen), "expected both handle-reading tools, saw ${json_stringify(seen)}")
}

/**
 * The projection consequence of that declaration, in both directions.
 *
 * Without the declared role the poll classifies "other" and fills no slot, so
 * the judge is never shown the passing command. With it, the poll takes the
 * verification slot and the output reaches the packet. The second half is the
 * control that keeps this honest: a plain read must STAY out of `actions`, or
 * the fix has widened from "verification-bearing" to "every call" and the
 * projection has stopped projecting.
 */
pipeline test_declared_role_decides_whether_a_poll_reaches_the_judge(_task: any) {
  const poll_text = "Command succeeded (exit 0)\n5 passed in 2.24s"
  const messages = [
    __assistant_facts(
      "Read the module.",
      [{id: "look-1", function: {name: "look", arguments: {file: "src/calc.py"}}}],
    ),
    __result_facts("look", "look-1", "def add(a, b):\n    return a + b", "ok"),
    __assistant_facts(
      "Apply the fix.",
      [{id: "edit-1", function: {name: "edit", arguments: {content: "return a + b"}}}],
    ),
    __result_facts("edit", "edit-1", "write applied", "ok", {mutation_status: "applied"}),
    __assistant_facts(
      "Poll the focused verifier.",
      [{id: "poll-1", function: {name: "poll_command", arguments: {handle_id: "hto-2f4b-3"}}}],
    ),
    __result_facts("poll_command", "poll-1", poll_text, "ok", {dispatch_status: "completed"}),
  ]
  const look_tool = {name: "look", annotations: {kind: "read", side_effect_level: "read_only"}}
  const edit_tool = {
    name: "edit",
    annotations: {kind: "edit", side_effect_level: "workspace_write"},
  }
  // Exactly the annotation `host_tools.harn` shipped BEFORE the fix.
  const undeclared = {
    tools: [
      look_tool,
      edit_tool,
      {name: "poll_command", annotations: {kind: "execute", side_effect_level: "read_only"}},
    ],
  }
  const before = __judge_evidence_projection(messages, undeclared)
  const before_names = before.packet.actions.map({ action -> action.name }).to_list()
  assert(
    !contains(before_names, "poll_command"),
    "without a declared role the poll classifies \"other\" and fills no slot; if it now appears, this control has stopped measuring the defect: ${json_stringify(before_names)}",
  )

  // Exactly the annotation `host_tools.harn` ships now.
  const declared = {
    tools: [
      look_tool,
      edit_tool,
      {
        name: "poll_command",
        annotations: {
          kind: "execute",
          side_effect_level: "read_only",
          completion_evidence_role: "verification",
        },
      },
    ],
  }
  const after = __judge_evidence_projection(messages, declared)
  const after_names = after.packet.actions.map({ action -> action.name }).to_list()
  const after_roles = after.packet.actions.map({ action -> action.semantics.evidence_role }).to_list()
  assert(
    contains(after_names, "poll_command"),
    "the declared poll must reach the judge as selected evidence, got ${json_stringify(after_names)}",
  )
  assert(
    contains(after_roles, "verification"),
    "the poll must occupy the verification slot, got ${json_stringify(after_roles)}",
  )
  assert(
    contains(after.serialized, "5 passed in 2.24s"),
    "the judge must be shown the command's outcome, not merely told a poll happened",
  )
  // CONTROL: a plain read is still research, never selected evidence.
  assert(
    !contains(after_names, "look"),
    "a plain read must not be promoted to selected evidence: ${json_stringify(after_names)}",
  )
}
