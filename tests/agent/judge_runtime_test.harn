pipeline test_completion_judge_prompt_uses_projection_not_callable_schema(
  harness: Harness,
  task: unknown,
) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "look",
    "UNUSED_READ_SCHEMA_BULK ".repeat(600),
    {
      handler: { _args -> "READ_ONLY_RESULT_BULK ".repeat(600) },
      parameters: {path: {type: "string", required: true}},
      annotations: {kind: "read", side_effect_level: "read_only"},
    },
  )
  tools = tool_define(
    tools,
    "edit",
    "UNUSED_EDIT_SCHEMA_BULK ".repeat(600),
    {
      handler: { _args -> "WRITE_RESULT_MARKER" },
      parameters: {content: {type: "string", required: true}},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {text: "", tool_calls: [{id: "read-1", name: "look", arguments: {path: "fact.txt"}}]},
      {
        text: "",
        tool_calls: [{id: "edit-1", name: "edit", arguments: {content: "WRITE_ARG_MARKER"}}],
      },
      llm_done(),
      {text: "{\"verdict\":\"done\",\"detail\":\"The write and verification are sufficient.\"}"},
    ],
    { ->
      const session = "judge-projection-prompt-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: tools,
        tool_format: "native",
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 4,
        verify_completion_judge: {provider: "mock", max_invocations: 1},
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Apply the requested change.", nil, opts) },
      )
      assert_eq(captured.result.status, "done")
      const calls = harness.llm.mock_calls()
      assert_eq(len(calls), 4)
      const judge = calls[3]
      assert(!contains(judge.system, "UNUSED_READ_SCHEMA_BULK"))
      assert(!contains(judge.system, "UNUSED_EDIT_SCHEMA_BULK"))
      assert(!contains(judge.system, "workspace_write"))
      const user = judge.messages[0].content
      assert(contains(user, "workspace_write"))
      assert(contains(user, "WRITE_ARG_MARKER"))
      assert(contains(user, "WRITE_RESULT_MARKER"))
      assert(!contains(user, "READ_ONLY_RESULT_BULK"))
      assert(
        contains(json_stringify(harness.agent.snapshot(session).messages), "READ_ONLY_RESULT_BULK"),
        "bounded judge context must not mutate durable replay evidence",
      )
      const projection = captured.events.filter(
        { event ->
          event.type == "typed_checkpoint"
            && event?.checkpoint?.schema
              == "harn.completion_judge_evidence_projection.v1"
        },
      )
        .to_list()
      assert_eq(len(projection), 1)
      assert_eq(projection[0].checkpoint.included_action_count, 1)
      assert_eq(projection[0].checkpoint.omitted_read_only_call_count, 1)
    },
  )
}

pipeline test_completion_judge_keeps_mutation_and_lifecycle_anomaly_after_many_verifiers(
  harness: Harness,
  task: unknown,
) {
  let messages = [
    __assistant_facts(
      "",
      [{id: "edit-1", name: "edit", arguments: {content: "NEGATIVE_ASSERTION"}}],
    ),
    __result_facts("edit", "edit-1", "write applied", "ok"),
  ]
  let index = 0
  while index < 8 {
    const id = "verify-" + to_string(index)
    messages = messages
      + [
        __assistant_facts("", [{id: id, name: "verify", arguments: {}}]),
        __result_facts("verify", id, "verification passed", "ok"),
      ]
    index = index + 1
  }
  messages = messages
    + [__assistant_facts("", [{id: "pending", name: "run", arguments: {}}])]
  let registry = [
    {name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}},
    {
      name: "verify",
      annotations: {
        kind: "execute",
        side_effect_level: "process_exec",
        completion_evidence_role: "verification",
      },
    },
    {name: "run", annotations: {kind: "execute", side_effect_level: "process_exec"}},
  ]
  let tool_index = 0
  while tool_index < 500 {
    registry = registry
      + [
        {
          name: "unused-" + to_string(tool_index) + "-" + "x".repeat(300),
          description: "UNBOUNDED_REGISTRY_BULK".repeat(100),
        },
      ]
    tool_index = tool_index + 1
  }
  const projected = __judge_evidence_projection(messages, {tools: registry})
  assert(contains(projected.serialized, "NEGATIVE_ASSERTION"))
  assert(contains(projected.serialized, "pending"))
  assert(contains(projected.serialized, "tool_call_result_missing"))
  assert(!contains(projected.serialized, "UNBOUNDED_REGISTRY_BULK"))
  assert(
    projected.stats.serialized_chars < 18000,
    "semantic slots bound registry and history growth",
  )
}

pipeline test_completion_judge_preserves_ambiguous_result_evidence(
  harness: Harness,
  task: unknown,
) {
  const projected = __judge_evidence_projection(
    [
      __assistant_facts("", [{id: "edit-1", name: "edit", arguments: {content: "MUTATION_BODY"}}]),
      __result_facts("edit", "edit-1", "FIRST_RECEIPT", "ok"),
      __result_facts("edit", "edit-1", "SECOND_RECEIPT", "ok"),
    ],
    {tools: [{name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}}]},
  )
  assert_eq(projected.packet.actions[0].lifecycle_status, "ambiguous")
  assert(contains(projected.serialized, "MUTATION_BODY"))
  assert(contains(projected.serialized, "FIRST_RECEIPT"))
  assert(contains(projected.serialized, "SECOND_RECEIPT"))
  assert(contains(projected.serialized, "duplicate_tool_result"))
}

pipeline test_completion_judge_transports_veto_and_repair_from_compact_packet(
  harness: Harness,
  task: unknown,
) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Edit a file.",
    {
      handler: { _args -> "write applied" },
      parameters: {content: {type: "string", required: true}},
      annotations: {kind: "edit", side_effect_level: "workspace_write"},
    },
  )
  with_llm_script(
    harness.llm,
    [
      {
        text: "",
        tool_calls: [
          {
            id: "edit-1",
            name: "edit",
            arguments: {content: "assert not hasattr(service, 'delete_experiment')"},
          },
        ],
      },
      llm_done(),
      {
        text: json_stringify(
          {
            verdict: "continue",
            detail:
              "Deletion behavior is not exercised; replace the hollow negative with a behavior-sensitive test.",
          },
        ),
      },
      llm_done(),
    ],
    { ->
      const session = "judge-hollow-negative-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Implement experiment deletion with a behavior-sensitive regression.",
          nil,
          {
            provider: "mock",
            session_id: session,
            tools: tools,
            tool_format: "native",
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 4,
            verify_completion_judge: {provider: "mock", max_invocations: 1},
          },
        ) },
      )
      assert_eq(captured.result.status, "completion_unverified")
      const judge_call = harness.llm.mock_calls()[2]
      assert(contains(judge_call.messages[0].content, "assert not hasattr"))
      assert(
        contains(join(__feedback_contents(captured, "verify_completion"), "\n"), "hollow negative"),
        "the compact packet drives a real completion veto and repair receipt",
      )
      // Every judge call the user waits through opens a window and closes it,
      // in that order. Without the start half the host has nothing to show
      // between the last edit and the verdict (bc#6934).
      const window = __judge_window(captured.events)
      assert(len(window) > 0, "a real judge run must emit window events")
      assert_eq(window[0], "judge_started", "the window opens before it closes")
      assert_eq(
        len(window.filter({ kind -> kind == "judge_started" }).to_list()),
        len(window.filter({ kind -> kind == "judge_decision" }).to_list()),
        "every opened window is closed",
      )
      const receipts = __completion_receipts(captured.events)
      assert_eq(receipts[0].action, "continue")
      assert(contains(receipts[0].evidence_id, "sha256:"))
      assert_eq(receipts[len(receipts) - 1].action, "stop_unverified")
      assert_eq(receipts[len(receipts) - 1].reason, "completion_judge_cap_reached")
    },
  )
}

pipeline test_completion_judge_refuses_request_that_cannot_fit_terminal_deadline(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [llm_done()],
    { ->
      const session = "judge-deadline-admission-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish with a typed terminal receipt.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 2,
            deadline_ms: 1,
            verify_completion_judge: {
              provider: "mock",
              max_invocations: 1,
              operation_timeout_ms: 100,
              deadline_reserve_ms: 0,
            },
            done_judge: {provider: "mock", max_invocations: 1},
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 1, "only the primary model turn may dispatch")
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "completion_judge_deadline_admission_refused")
      const admissions = captured.events.filter(
        { event ->
          event.type == "typed_checkpoint"
            && event?.checkpoint?.schema
              == "harn.completion_judge_admission.v1"
        },
      )
        .to_list()
      assert_eq(len(admissions), 1, "one refused judge admission receipt")
      assert(!admissions[0].checkpoint.admitted)
      assert_eq(admissions[0].checkpoint.outcome, "deadline_budget_insufficient")
      const decisions = captured.events.filter(
        { event ->
          event.type == "judge_decision"
            && event?.verdict == "unavailable"
            && event?.reason
              == "completion_judge_deadline_admission_refused"
        },
      )
        .to_list()
      assert_eq(len(decisions), 1, "one unavailable judge decision")
      // The window opens one gate before the model call, so a request refused
      // at admission still announces and then immediately closes. A host that
      // renders `judge_started` must never be left holding an open window.
      assert_eq(
        __judge_window(captured.events),
        ["judge_started", "judge_decision"],
        "a refused admission still closes the window it opened",
      )
      const receipts = __completion_receipts(captured.events)
      assert_eq(len(receipts), 1, "one terminal completion directive")
      assert_eq(receipts[0].action, "stop_unverified")
      assert_eq(receipts[0].reason, "completion_judge_deadline_admission_refused")
      assert(!receipts[0].invoked.verify_completion_judge)
    },
  )
}

pipeline test_fenced_completion_judge_uses_typed_checkpoint(harness: Harness, task: unknown) {
  const judge_response = {
    text:
      "```json\n{\"verdict\":\"continue\",\"detail\":\"Run `harn test tests/agent/judge_runtime_test.harn` now because verification is missing.\"}\n```",
  }
  with_llm_script(
    harness.llm,
    [llm_done(), judge_response, llm_text("Addressed the gap. ##DONE##")],
    { ->
      const session = "judge-fenced-typed-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        done_sentinel: "##DONE##",
        loop_until_done: true,
        max_iterations: 3,
        verify_completion_judge: {provider: "mock", max_invocations: 1, fail_open_on_error: false},
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Finish after satisfying the judge.", nil, opts) },
      )
      const feedback = __feedback_contents(captured, "verify_completion")
      assert_eq(
        feedback,
        [
          "Run `harn test tests/agent/judge_runtime_test.harn` now because verification is missing.",
        ],
      )
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "completion_judge_cap_reached")
    },
  )
}

pipeline test_completion_judge_accepts_then_clamps_overlong_detail(
  harness: Harness,
  task: unknown,
) {
  const detail = "Verified the requested behavior with the focused end-to-end test. ".repeat(6)
  assert(len(detail) > 240)
  with_llm_script(
    harness.llm,
    [llm_done(), {text: json_stringify({verdict: "done", detail: detail})}],
    { ->
      const session = "judge-overlong-detail-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        done_sentinel: "##DONE##",
        loop_until_done: true,
        max_iterations: 1,
        verify_completion_judge: {provider: "mock", max_invocations: 1, fail_open_on_error: false},
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish after the completion judge confirms the evidence.",
          nil,
          opts,
        ) },
      )
      assert_eq([len(harness.llm.mock_calls()), captured.result.status], [2, "done"])
      const decisions =
        captured.events.filter({ event -> event.type == "judge_decision" }).to_list()
      assert_eq(len(decisions), 1)
      assert_eq(decisions[0].verdict, "done")
      assert_eq(decisions[0].reasoning, substring(detail, 0, 240))
    },
  )
}

pipeline test_invalid_deterministic_completion_result_stops_unverified(
  harness: Harness,
  task: unknown,
) {
  with_llm_script(
    harness.llm,
    [llm_done()],
    { ->
      const session = "judge-invalid-deterministic-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Finish only after the deterministic completion check decides.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 1,
            verify_completion: { _payload -> 42 },
          },
        ) },
      )
      assert_eq(captured.result.status, "completion_unverified")
      assert_eq(captured.result.stop_reason, "completion_verifier_invalid_result")
      const receipts = __completion_receipts(captured.events)
      assert_eq(len(receipts), 1)
      assert_eq(receipts[0].action, "stop_unverified")
      assert(receipts[0].invoked.deterministic)
    },
  )
}

pipeline test_deterministic_veto_short_circuits_model_judges(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [llm_done()],
    { ->
      const session = "judge-short-circuit-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Do not spend a model judge call after a deterministic veto.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 1,
            verify_completion: { _payload -> "deterministic repair" },
            verify_completion_judge: {provider: "mock", max_invocations: 1},
            done_judge: {provider: "mock", max_invocations: 1},
          },
        ) },
      )
      assert_eq(len(harness.llm.mock_calls()), 1)
      const receipts = __completion_receipts(captured.events)
      assert_eq(len(receipts), 1)
      assert(receipts[0].invoked.deterministic)
      assert(!receipts[0].invoked.verify_completion_judge)
      assert(!receipts[0].invoked.done_judge)
    },
  )
}
