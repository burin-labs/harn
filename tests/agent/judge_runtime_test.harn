// Run: harn test tests/agent/judge_runtime_test.harn
//
// Production-boundary completion-judge fixtures. The structured checkpoint
// owns extraction and schema validation; the judge consumes its typed data
// without reparsing provider text.
import { agent_capture_events } from "std/agent/events"
import { AgentLoopOptions } from "std/agent/options"
import { llm_done, llm_text, with_llm_script } from "std/testing"

fn __feedback_contents(captured, kind: string) -> list<string> {
  let contents: list<string> = []
  for event in captured.events {
    if event.type == "feedback_injected" && event.kind == kind {
      contents = contents.push(to_string(event.content ?? ""))
    }
  }
  return contents
}

pipeline test_fenced_completion_judge_uses_typed_checkpoint(task) {
  const judge_response = {
    text:
      "```json\n{\"verdict\":\"continue\",\"reasoning\":\"The verifier has not run.\",\"next_step\":\"Run `harn test tests/agent/judge_runtime_test.harn` now.\",\"specific_gaps\":[\"Run the narrow verifier.\"]}\n```",
  }
  with_llm_script(
    [llm_done(), judge_response, llm_text("Addressed the gap. ##DONE##")],
    { ->
      const session = "judge-fenced-typed-" + uuid()
      const opts: AgentLoopOptions = {
        provider: "mock",
        session_id: session,
        done_sentinel: "##DONE##",
        loop_until_done: true,
        max_iterations: 3,
        verify_completion_judge: {provider: "mock", max_invocations: 1, fail_open_on_error: false},
      }
      const captured = agent_capture_events(
        session,
        fn() { return agent_loop("Finish after satisfying the judge.", nil, opts) },
      )
      const feedback = __feedback_contents(captured, "verify_completion")
      assert_eq(
        feedback,
        [
          "Run `harn test tests/agent/judge_runtime_test.harn` now.\n\nAddress these specific gaps before finishing:\n- Run the narrow verifier.\n\nThe verifier has not run.",
        ],
      )
      assert_eq(captured.result.status, "verify_capped")
      assert_eq(captured.result.stop_reason, "completion_judge_cap_reached")
    },
  )
}
