// Run: harn test tests/agent/judge_runtime_test.harn
//
// Production-boundary completion-judge fixtures. The structured checkpoint
// owns extraction and schema validation; the judge consumes its typed data
// without reparsing provider text.
import { agent_capture_events } from "std/agent/events"
import { __judge_evidence_projection } from "std/agent/judge"
import { __judge_completion_admission } from "std/agent/judge_internals"
import { agent_loop } from "std/agent/loop"
import { __agent_loop_deadline_contract } from "std/agent/loop_foundation"
import { AgentSpec } from "std/agent/options"
import { llm_done, llm_text, with_llm_script } from "std/testing"

fn __feedback_contents(captured: dict, kind: string) -> list<string> {
  let contents: list<string> = []
  for event in captured.events {
    if event.type == "feedback_injected" && event.kind == kind {
      contents = contents.appending(to_string(event.content ?? ""))
    }
  }
  return contents
}

/*
 * The completion-judge window as an ordered list of its own boundary events.
 *
 * Ordering is the whole contract: a host renders "checking the work" on
 * `judge_started` and clears it on `judge_decision`, so a decision that arrives
 * without its start, or a start with no decision, is a stuck progress claim on
 * a real user's screen.
 */
fn __judge_window(events: list) -> list<string> {
  return events.filter({ event -> event.type == "judge_started" || event.type == "judge_decision" })
    .map({ event -> to_string(event.type) })
    .to_list()
}

fn __completion_receipts(events: list) {
  return events.filter(
    { event ->
      event.type == "typed_checkpoint"
        && event?.checkpoint?.schema
          == "harn.completion_directive_receipt.v1"
    },
  )
    .map({ event -> event.checkpoint })
    .to_list()
}

fn __assistant_facts(text: string, tool_calls: list) -> dict {
  return {role: "assistant", content: text, _harn: {kind: "assistant", tool_calls: tool_calls}}
}

fn __result_facts(
  name: string,
  tool_call_id: string,
  content: string,
  outcome: "ok" | "error",
  data: dict = {},
) -> dict {
  // Use the text-channel role deliberately. Lifecycle identity and outcome
  // come from dispatch-owned facts, not from provider-specific message roles.
  return {
    role: "user",
    content: content,
    _harn: {
      kind: "tool_result",
      tool_call_id: tool_call_id,
      tool_name: name,
      outcome: outcome,
      data: data,
    },
  }
}

pipeline test_completion_judge_admission_has_exact_budget_boundary(
  harness: Harness,
  task: unknown,
) {
  const refused = __judge_completion_admission(1000, 65999, 60000, 5000)
  const admitted = __judge_completion_admission(1000, 66000, 60000, 5000)
  assert(!refused.admitted)
  assert_eq(refused.remaining_ms, 64999)
  assert(admitted.admitted)
  assert_eq(admitted.remaining_ms, 65000)
}

pipeline test_agent_loop_deadline_uses_earliest_duration_in_one_clock_domain(
  harness: Harness,
  task: unknown,
) {
  const configured = __agent_loop_deadline_contract(9000, 70000, nil)
  const budget = __agent_loop_deadline_contract(9000, 70000, 45000)
  assert_eq(configured.deadline_at_ms, 79000)
  assert_eq(configured.source, "deadline_ms")
  assert_eq(budget.deadline_at_ms, 54000)
  assert_eq(budget.duration_ms, 45000)
  assert_eq(budget.source, "iteration_budget.wall_clock_ms")
  assert_eq(__agent_loop_deadline_contract(9000, nil, nil), nil)
}

pipeline test_completion_judge_projects_bounded_structural_evidence(
  harness: Harness,
  task: unknown,
) {
  const huge_read = "READ_ONLY_TRANSCRIPT_BULK".repeat(1000)
  const huge_edit = "EDIT_HEAD\n" + "implementation body\n".repeat(700)
    + "assert not hasattr(service, 'delete_experiment')\nEDIT_TAIL"
  const huge_failure = "VERIFY_FAILURE_HEAD\n" + "trace line\n".repeat(900)
    + "VERIFY_FAILURE_TAIL"
  const huge_success = "VERIFY_SUCCESS_HEAD\n" + "passing output\n".repeat(900)
    + "VERIFY_SUCCESS_TAIL"
  const messages = [
    __assistant_facts(
      "Inspect first.",
      [{id: "read-1", function: {name: "look", arguments: {file: "large.txt"}}}],
    ),
    __result_facts("look", "read-1", huge_read, "ok"),
    __assistant_facts(
      "Write the focused test.",
      [{id: "edit-1", function: {name: "edit", arguments: {content: huge_edit}}}],
    ),
    __result_facts("edit", "edit-1", "write applied", "ok", {mutation_status: "applied"}),
    __assistant_facts("Verify.", [{id: "verify-1", function: {name: "verify", arguments: {}}}]),
    __result_facts("verify", "verify-1", huge_failure, "error"),
    __assistant_facts(
      "Verify the repair.",
      [{id: "verify-2", function: {name: "verify", arguments: {}}}],
    ),
    __result_facts("verify", "verify-2", huge_success, "ok", {passed: 11, failed: 0}),
  ]
  const opts = {
    tools: [
      {name: "look", annotations: {kind: "read", side_effect_level: "read_only"}},
      {name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}},
      {
        name: "verify",
        annotations: {
          kind: "execute",
          side_effect_level: "process_exec",
          completion_evidence_role: "verification",
        },
      },
    ],
  }
  const projected = __judge_evidence_projection(messages, opts)
  assert_eq(projected.packet.schema, "harn.completion_judge_evidence.v2")
  assert_eq(projected.packet.raw_transcript_digest, "sha256:" + sha256(json_stringify(messages)))
  assert_eq(projected.packet.raw_message_count, 8)
  assert_eq(projected.packet.omitted_read_only_call_count, 1)
  assert_eq(projected.packet.relevant_action_count, 3)
  assert_eq(len(projected.packet.actions), 3)
  assert(contains(projected.packet.actions.map({ action -> action.name }).to_list(), "edit"))
  assert(!contains(projected.serialized, "READ_ONLY_TRANSCRIPT_BULK"))
  assert(contains(projected.serialized, "EDIT_HEAD"))
  assert(contains(projected.serialized, "assert not hasattr"))
  assert(contains(projected.serialized, "VERIFY_FAILURE_HEAD"))
  assert(contains(projected.serialized, "VERIFY_FAILURE_TAIL"))
  assert(contains(projected.serialized, "VERIFY_SUCCESS_HEAD"))
  assert(contains(projected.serialized, "VERIFY_SUCCESS_TAIL"))
  assert(
    projected.stats.serialized_chars < 20000,
    "three pathological fields must remain below the fixed evidence envelope",
  )
}

pipeline test_completion_evidence_is_identical_across_text_and_native_channels(
  harness: Harness,
  task: unknown,
) {
  const calls = [
    {id: "edit-1", name: "edit", arguments: {path: "src/lib.rs"}},
    {id: "verify-1", name: "verify", arguments: {command: "make test"}},
  ]
  const text_messages = [
    __assistant_facts("<tool_call>...</tool_call>", calls),
    __result_facts("edit", "edit-1", "0 errors, 0 failed", "ok", {mutation_status: "applied"}),
    __result_facts("verify", "verify-1", "command completed", "error", {exit_code: 1}),
  ]
  const native_messages = [
    text_messages[0] + {tool_calls: calls},
    text_messages[1] + {role: "tool", name: "edit", tool_call_id: "edit-1"},
    text_messages[2] + {role: "tool", name: "verify", tool_call_id: "verify-1"},
  ]
  const opts = {
    tools: [
      {name: "edit", annotations: {kind: "edit", side_effect_level: "workspace_write"}},
      {
        name: "verify",
        annotations: {
          kind: "execute",
          side_effect_level: "process_exec",
          completion_evidence_role: "verification",
        },
      },
    ],
  }
  const text_projection = __judge_evidence_projection(text_messages, opts)
  const native_projection = __judge_evidence_projection(native_messages, opts)
  assert_eq(text_projection.packet.actions, native_projection.packet.actions)
  assert_eq(text_projection.packet.lifecycle_issues, native_projection.packet.lifecycle_issues)
  assert(!text_projection.packet.actions[0].has_error_result)
  assert(text_projection.packet.actions[1].has_error_result)
}

pipeline test_completion_judge_keeps_one_observation_for_read_only_answer(
  harness: Harness,
  task: unknown,
) {
  const projected = __judge_evidence_projection(
    [
      __assistant_facts(
        "",
        [{id: "read-1", function: {name: "look", arguments: {file: "fact.txt"}}}],
      ),
      __result_facts("look", "read-1", "decisive observed fact", "ok"),
    ],
    {tools: [{name: "look", annotations: {kind: "read", side_effect_level: "read_only"}}]},
  )
  assert_eq(projected.stats.included_action_count, 0)
  assert_eq(projected.stats.included_fallback_observation_count, 1)
  assert(contains(projected.serialized, "decisive observed fact"))
}

