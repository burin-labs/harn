// Run: harn test tests/agent/completion_judge_exit_authority_test.harn
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_done, with_llm_script } from "std/testing"

// A judge reply the schema cannot read. This is the shape a replay document
// produces once its scripted verdicts are exhausted and the catch-all answers.
const MALFORMED_JUDGE_REPLY = "REPLAY-FIXTURE-EXHAUSTED"

fn judge_opts(session: string) -> AgentSpec {
  return {
    provider: "mock",
    session_id: session,
    tool_format: "native",
    loop_until_done: true,
    done_sentinel: "##DONE##",
    max_iterations: 6,
    verify_completion_judge: {model: "mock-judge", provider: "mock"},
  }
}

fn judge_admissions(events: list) -> list {
  return events.filter(
    { event ->
      event.type == "typed_checkpoint"
        && event?.checkpoint?.schema == "harn.completion_judge_admission.v1"
        && event?.checkpoint?.outcome != nil
    },
  )
    .map({ event -> event.checkpoint })
    .to_list()
}

// bc#7798. A judge whose reply never parses is an exit authority that cannot
// answer. Before the fix it was recorded `completion_judge_error` and read as
// `continue`, so the run could only stop by exhausting an unrelated policy.
pipeline test_malformed_judge_terminates_with_a_typed_reason(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [
      llm_done(),
      {text: MALFORMED_JUDGE_REPLY},
      {text: MALFORMED_JUDGE_REPLY},
      {text: MALFORMED_JUDGE_REPLY},
      {text: MALFORMED_JUDGE_REPLY},
      {text: MALFORMED_JUDGE_REPLY},
      {text: MALFORMED_JUDGE_REPLY},
      {text: MALFORMED_JUDGE_REPLY},
      llm_done(),
      llm_done(),
      llm_done(),
    ],
    { ->
      const session = "judge-malformed-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Say hello.", nil, judge_opts(session)) },
      )
      // The run terminates on the judge's own authority, not by running out of
      // some other budget.
      assert_eq(captured.result.status, "completion_unverified")
      assert(to_string(captured.result?.stop_reason ?? "").contains("completion_judge_error"))
      // And it does so within the bound, rather than after a long veto run.
      // Measured on the defect: 16 judge calls before an unrelated policy stop.
      assert(len(judge_admissions(captured.events)) <= 8)
    },
  )
}

// Negative control. A judge that answers well-formed is untouched by the bound.
pipeline test_well_formed_judge_run_is_unchanged(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [llm_done(), {text: json_stringify({verdict: "done", detail: "The greeting was returned."})}],
    { ->
      const session = "judge-wellformed-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Say hello.", nil, judge_opts(session)) },
      )
      assert_eq(captured.result.status, "done")
      // Two admissions is what a well-formed run costs today; the bound must
      // not add a call to the path that never errors.
      assert_eq(len(judge_admissions(captured.events)), 2)
    },
  )
}

// The bound is a retry, not just a shorter path to failure: a transient bad
// reply followed by a good one still completes.
pipeline test_a_recovered_judge_reply_still_completes(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [
      llm_done(),
      {text: MALFORMED_JUDGE_REPLY},
      {text: json_stringify({verdict: "done", detail: "The greeting was returned."})},
    ],
    { ->
      const session = "judge-recovered-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Say hello.", nil, judge_opts(session)) },
      )
      assert_eq(captured.result.status, "done")
    },
  )
}
