// Run: harn test tests/agent/judge_gate_test.harn
//
// Config-time validation fixtures for `agent_completion_gate` (std/agent/judge).
// Pins the LOUD guards that keep a mistyped seam from blowing up deep inside an
// agent_loop run (a non-callable host-fact callback), a silently-dead knob (a
// `classify_write` without `facts`, or a typo'd `judge_seam`), while preserving
// the graceful judge-only degradation for a facts-free config. Everything here is
// PURE — building the bundle runs no LLM and no host.
import { agent_completion_gate, agent_completion_gate_veto_counts } from "std/agent/judge"

fn __facts(_ctx) {
  return {source_write_count: 1}
}

fn __classify(_path, _diff) {
  return "source"
}

fn __verify() {
  return {ok: true}
}

pipeline test_noncallable_facts_throws(task) {
  const outcome = try {
    agent_completion_gate({facts: "nope"})
  }
  assert(is_err(outcome), "gate rejects a non-callable facts")
}

pipeline test_noncallable_classify_write_throws(task) {
  const outcome = try {
    agent_completion_gate({classify_write: 7, facts: __facts})
  }
  assert(is_err(outcome), "gate rejects a non-callable classify_write")
}

pipeline test_noncallable_verify_command_throws(task) {
  const outcome = try {
    agent_completion_gate({verify_command: "x"})
  }
  assert(is_err(outcome), "gate rejects a non-callable verify_command")
}

pipeline test_noncallable_veto_combine_throws(task) {
  const outcome = try {
    agent_completion_gate({facts: __facts, veto_combine: 3})
  }
  assert(is_err(outcome), "gate rejects a non-callable veto_combine")
}

pipeline test_classify_write_without_facts_throws(task) {
  const outcome = try {
    agent_completion_gate({classify_write: __classify})
  }
  assert(is_err(outcome), "gate rejects classify_write set without facts")
}

pipeline test_classify_write_with_facts_ok(task) {
  const bundle = agent_completion_gate({classify_write: __classify, facts: __facts})
  assert_eq(bundle._completion_gate.facts_available, true)
}

pipeline test_bad_judge_seam_throws(task) {
  const outcome = try {
    agent_completion_gate({facts: __facts, judge: true, judge_seam: "typo_seam"})
  }
  assert(is_err(outcome), "gate rejects an unknown judge_seam")
}

pipeline test_done_judge_seam_routes(task) {
  const bundle = agent_completion_gate({facts: __facts, judge: true, judge_seam: "done_judge"})
  assert(bundle?.done_judge != nil, "judge rides the done_judge seam")
  assert_eq(bundle?.verify_completion_judge, nil)
}

pipeline test_valid_config_builds(task) {
  const bundle = agent_completion_gate({facts: __facts, verify_command: __verify})
  assert_eq(bundle._completion_gate.facts_available, true)
  assert(bundle?.verify_completion != nil, "gate wires the verify_completion seam")
}

pipeline test_empty_config_degrades_not_throws(task) {
  // A facts-free config is legal — it degrades to judge-only mode and surfaces
  // the degraded state on the bundle rather than throwing.
  const bundle = agent_completion_gate({})
  assert_eq(bundle._completion_gate.facts_available, false)
}

pipeline test_feedback_templates_unknown_key_throws(task) {
  const outcome = try {
    agent_completion_gate({facts: __facts, feedback_templates: {bogus_key: "x"}})
  }
  assert(is_err(outcome), "gate rejects an unknown feedback_templates key")
}

pipeline test_feedback_templates_nonstring_throws(task) {
  const outcome = try {
    agent_completion_gate({facts: __facts, feedback_templates: {missing_verification: 7}})
  }
  assert(is_err(outcome), "gate rejects a non-string feedback_templates value")
}

pipeline test_feedback_templates_valid_accepted(task) {
  const outcome = try {
    agent_completion_gate({facts: __facts, feedback_templates: {missing_verification: "Custom."}})
  }
  assert(!is_err(outcome), "gate accepts a valid feedback_templates override")
}

// --- Per-class veto counters (item 6): keyed by the vetoing ladder rule id -------
// Facts keyed on the payload text so one gate closure can produce two different
// vetoing classes: "nowrite" -> evidence gate (`no_source_write`), otherwise a
// source write with a red verifier (`verification_after_write_red`).
fn __class_facts(ctx) {
  if ctx.text == "nowrite" {
    return {requires_write: true, source_write_count: 0}
  }
  return {requires_write: true, source_write_count: 1}
}

fn __red_verify() {
  return {findings: "boom", ok: false}
}

pipeline test_veto_counts_accumulate_per_class(task) {
  // Each charged veto increments BOTH the flat total and a per-class counter keyed by
  // the ladder rule id that vetoed. Deltas (not absolutes) keep the test robust to a
  // pre-populated persistent store. max_vetoes:0 disables the budget so soft vetoes
  // always charge.
  const sid = "gate6-classcount"
  const bundle = agent_completion_gate({facts: __class_facts, max_vetoes: 0, verify_command: __red_verify})
  const gate = bundle.verify_completion
  const before = agent_completion_gate_veto_counts(sid)
  gate({session_id: sid, text: "nowrite", transcript: "[]"})
  gate({session_id: sid, text: "nowrite", transcript: "[]"})
  gate({session_id: sid, text: "write", transcript: "[]"})
  const after = agent_completion_gate_veto_counts(sid)
  assert_eq(after.total - before.total, 3)
  assert_eq(after.by_class.no_source_write - before.by_class.no_source_write, 2)
  assert_eq(
    after.by_class.verification_after_write_red - before.by_class.verification_after_write_red,
    1,
  )
  // A class that never fired stays flat.
  assert_eq(after.by_class.missing_verification - before.by_class.missing_verification, 0)
}

pipeline test_veto_counts_absent_without_session(task) {
  // No session id: nothing is charged, and the reader reports a stable zeroed shape
  // (every chargeable class present) rather than throwing.
  const counts = agent_completion_gate_veto_counts("")
  assert_eq(counts.total, 0)
  assert_eq(counts.by_class.no_source_write, 0)
  assert_eq(counts.by_class.verification_after_write_red, 0)
  assert_eq(counts.by_class.missing_verification, 0)
}

pipeline test_veto_count_keys_do_not_leak_into_bundle_projection(task) {
  // The new per-class counts are read via the reader, NOT baked into the static
  // `_completion_gate` output projection — that block stays byte-identical.
  const bundle = agent_completion_gate({facts: __class_facts, verify_command: __red_verify})
  assert_eq(bundle._completion_gate?.by_class, nil)
  assert_eq(bundle._completion_gate?.veto_counts, nil)
  assert_eq(bundle._completion_gate?.total, nil)
  // The projection keeps exactly its known keys.
  const known = ["facts_available", "max_vetoes", "require_source_write"]
  for key in keys(bundle._completion_gate) {
    assert(contains(known, key), "unexpected _completion_gate projection key: " + key)
  }
}
