import {
  PatternLearningObservation,
  pl_observation_from_input,
  pl_sanitize_command_ledger,
} from "std/agent/pattern_knowledge_persistence"
import {
  pattern_learning_session_transcript,
  pl_run_goal_outcome,
  pl_run_has_eligible_natural_terminal,
  pl_session_command_ledger,
  pl_session_prompt,
  pl_session_runs,
  pl_session_tool_sequence,
} from "std/agent/pattern_knowledge_sessions"
import { session_store_append } from "std/session-store"
import { with_temp_dir } from "std/testing"

struct RunHeaders {
  run_id: string
}

struct Message {
  kind: string
  role: string
  visibility: string
  text: string
}

struct MessagePayload {
  transcript_event: Message
}

struct SessionEvent {
  headers: RunHeaders
  payload: MessagePayload
}

pipeline test_pattern_sessions_retain_nominal_records_and_extensions(harness: Harness) {
  const message = Message {
    kind: "message",
    role: "user",
    visibility: "public",
    text: "  repeat this task  ",
  }
  const event = SessionEvent {
    headers: RunHeaders {run_id: "nominal"},
    payload: MessagePayload {transcript_event: message},
  }
  assert_eq(pl_session_prompt([event]), "repeat this task")
  const groups = pl_session_runs([event])
  assert_eq(len(groups), 1)
  const group = groups[0]
  require group != nil, "the nominal event must produce a group"
  assert_eq(group.run_id, "nominal")
  const grouped_event = group.events[0]
  require grouped_event != nil, "the nominal event must be retained"
  assert_eq(type_of(grouped_event), "struct")
  assert_eq(type_of(grouped_event.headers), "struct")
  const extended = {
    headers: {run_id: "extended", extension: [false, 0]},
    payload: {transcript_event: {kind: "tool_call", metadata: {tool_name: "Run Shell"}}},
    [7]: "integer extension",
    extension: {empty: [], missing: nil},
  }
  const extended_group = pl_session_runs([extended])[0]
  require extended_group != nil, "the extended event must produce a group"
  const retained = extended_group.events[0]
  require retained != nil, "the extended event must be retained"
  assert_eq(retained, extended)
  assert_eq(pl_session_tool_sequence([extended]), ["run-shell"])
  assert_eq(pl_session_runs([{headers: {run_id: ""}}]), [])
}

pipeline test_pattern_sessions_preserve_raw_command_evidence(harness: Harness) {
  let events = []
  for code in [nil, false, 0, 7, [], {extension: true}] {
    const id = to_string(len(events))
    events = events
      + [
        {
          payload: {
            transcript_event: {
              kind: "tool_call_update",
              metadata: {
                tool_call_id: id,
                tool_name: "run",
                status: "completed",
                raw_input: {command: "printf source"},
                health: {command_exit_code: code},
              },
            },
          },
        },
      ]
  }
  const ledger = pl_session_command_ledger(events)
  assert_eq(len(ledger), 6)
  assert_eq(
    ledger.map({ entry -> entry.exit_code }).to_list(),
    [nil, false, 0, 7, [], {extension: true}],
  )
  assert_eq(ledger.map({ entry -> entry.ok }).to_list(), [true, false, true, false, false, false])
  const normalized = pl_sanitize_command_ledger(ledger)
  assert_eq(normalized.map({ entry -> entry.exit_code }).to_list(), [nil, nil, 0, 7, nil, nil])
  assert_eq(
    normalized.map({ entry -> entry.ok }).to_list(),
    [true, false, true, false, false, false],
  )
  const outcome = {kind: "achieved", reason: "observed", extra: [false, 0, nil]}
  const terminal = {
    payload: {
      transcript_event: {
        kind: "agent_run_terminal",
        metadata: {terminal: {kind: "natural"}, goal_outcome: outcome},
      },
    },
    headers: {"harn.workflow_learning.eligibility": "eligible"},
  }
  assert_eq(pl_run_goal_outcome([terminal]), outcome)
  assert(pl_run_has_eligible_natural_terminal([terminal]))
  const observation: PatternLearningObservation = pl_observation_from_input(
    harness.clock,
    harness.random,
    {id: "fixed", observed_at: "fixed", prompt: "source", command_ledger: ledger, outcome: outcome},
  )
  assert_eq(observation.command_ledger, normalized)
  assert_eq(observation.outcome, {kind: "achieved", reason: "observed"})
}

pipeline test_pattern_sessions_keep_conditional_leaf_refusals(harness: Harness) {
  assert_eq(pl_session_prompt([{payload: {transcript_event: false}}]), "")
  assert_eq(
    pl_session_command_ledger(
      [
        {
          payload: {
            transcript_event: {
              kind: "tool_call_update",
              metadata: {tool_call_id: "", status: false},
            },
          },
        },
      ],
    ),
    [],
  )
  assert_eq(pl_run_has_eligible_natural_terminal([{headers: false}]), false)
  const malformed_text = try {
    pl_session_prompt(
      [
        {
          payload: {
            transcript_event: {kind: "message", role: "user", visibility: "public", text: false},
          },
        },
      ],
    )
    false
  } catch (_) {
    true
  }
  assert(malformed_text, "a used message string must still be checked")
  const malformed_headers = try {
    pl_run_has_eligible_natural_terminal(
      [
        {
          headers: false,
          payload: {
            transcript_event: {kind: "agent_run_terminal", metadata: {terminal: {kind: "natural"}}},
          },
        },
      ],
    )
    false
  } catch (_) {
    true
  }
  assert(malformed_headers, "eligibility must refuse malformed headers when it reads them")
  const hidden_fallback = pl_session_command_ledger(
    [
      {
        payload: {
          transcript_event: {
            kind: "tool_call_update",
            metadata: {
              tool_call_id: "call",
              tool_name: "run",
              status: "completed",
              raw_output: {data: {run_outcome: false}, run_outcome: {command: "must not win"}},
              health: {command_exit_code: 0},
            },
          },
        },
      },
    ],
  )
  assert_eq(hidden_fallback, [])
}

pipeline test_pattern_transcript_reads_store_and_redacts_before_bounds(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const token = "ghp_" + "A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8"
      for entry in [
        {kind: "message", role: "user", visibility: "internal", text: "private"},
        {kind: "message", role: "user", visibility: "public", text: "x".repeat(590) + " " + token},
        {kind: "tool_call", metadata: {tool_name: "run", raw_input: {nested: {token: token}}}},
        {kind: "tool_result", text: "result"},
      ] {
        session_store_append(harness.agent, "boundary", {transcript_event: entry}, {root: root})
      }
      const page = pattern_learning_session_transcript(
        harness.agent,
        "boundary",
        {session_store_root: root},
        {entry_limit: 2, start_entry: 0},
      )
      assert_eq(page.state, "present")
      assert_eq(page.entry_count, 3)
      assert_eq(page.returned_count, 2)
      assert_eq(page.next_entry, 2)
      const first = page.entries[0]
      require first != nil, "the public message must reach the transcript page"
      assert_eq(first.kind, "message")
      assert(first.content_truncated)
      const serialized = json_stringify(page)
      assert(!serialized.contains("private"))
      assert(
        !serialized.contains("ghp_A1b2"),
        "redaction must precede clipping and visit nested input",
      )
      return nil
    },
  )
}
