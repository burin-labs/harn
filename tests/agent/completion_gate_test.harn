// Run: harn test tests/agent/completion_gate_test.harn
//
// Parity fixtures for the completion-gate veto arithmetic in
// `std/agent/judge_internals`. These pin a downstream completion-judge
// decisions (lib/runtime/completion-judge.harn) on synthetic verdict sets:
// the source-vs-cosmetic evidence gate (ledger ⛔#5), the strict post-write-red
// class that the budget may never convert, the per-session veto budget
// (COMPLETION_GATE_MAX_VETOES = 3), and AND-of-oracles verify composition.
// Everything here is PURE — no LLM, no host, no store — so the decisions are
// deterministic and byte-stable.
import {
  __completion_gate_apply_budget,
  __completion_gate_classify_writes,
  __completion_gate_combine_verify,
  __completion_gate_ladder,
} from "std/agent/judge_internals"

fn classify_by_ext(path: string?, _diff: unknown) {
  if lowercase(path).ends_with(".md") {
    return "cosmetic"
  }
  return "source"
}

pipeline test_no_write_on_coding_task_vetoes(harness: Harness, task: unknown) {
  // burin no_write_on_coding_task: a task needing a source change with zero writes.
  const v = __completion_gate_ladder(
    {source_known: true, source_write_count: 0, cosmetic_write_count: 0, requires_write: true},
  )
  assert_eq(v.ok, false)
  assert_eq(v.reason, "no_source_write")
  assert_eq(v.strict, false)
}

pipeline test_cosmetic_only_write_still_vetoes(harness: Harness, task: unknown) {
  // ledger ⛔#5: a cosmetic (.md) final write is NOT source progress; done stays blocked.
  const v = __completion_gate_ladder(
    {source_known: true, source_write_count: 0, cosmetic_write_count: 2, requires_write: true},
  )
  assert_eq(v.ok, false)
  assert_eq(v.reason, "no_source_write")
}

pipeline test_source_write_red_verifier_is_strict_veto(harness: Harness, task: unknown) {
  // burin failed_verification / repeated_verification_failures: source write + red verifier.
  const v = __completion_gate_ladder(
    {
      source_known: true,
      source_write_count: 1,
      requires_write: true,
      verify: {ok: false, findings: "error[E0308]"},
      oracle_expected: true,
    },
  )
  assert_eq(v.ok, false)
  assert_eq(v.reason, "verification_after_write_red")
  assert_eq(v.strict, true)
}

pipeline test_red_verifier_with_streak_uses_failed_reason_before_threshold(
  harness: Harness,
  task: unknown,
) {
  const v = __completion_gate_ladder(
    {
      consecutive_failed_after_write: 2,
      escalation_target: "frontier",
      escalation_threshold: 3,
      requires_write: true,
      source_known: true,
      source_write_count: 1,
      verification_failures_converging: false,
      verify: {ok: false, findings: "error[E0308]"},
    },
  )
  assert_eq(v.reason, "failed_verification")
  assert_eq(v.escalation_recommended, false)
  assert_eq(v.escalation_target, nil)
}

pipeline test_red_verifier_escalates_at_streak_threshold(harness: Harness, task: unknown) {
  const v = __completion_gate_ladder(
    {
      consecutive_failed_after_write: 3,
      escalation_target: "frontier",
      escalation_threshold: 3,
      requires_write: true,
      source_known: true,
      source_write_count: 1,
      verification_failures_converging: false,
      verify: {ok: false, findings: "error[E0308]"},
    },
  )
  assert_eq(v.reason, "repeated_verification_failures")
  assert_eq(v.escalation_recommended, true)
  assert_eq(v.escalation_target, "frontier")
}

pipeline test_converging_failure_churn_does_not_escalate(harness: Harness, task: unknown) {
  const v = __completion_gate_ladder(
    {
      consecutive_failed_after_write: 8,
      escalation_target: "frontier",
      escalation_threshold: 3,
      requires_write: true,
      source_known: true,
      source_write_count: 1,
      verification_failures_converging: true,
      verify: {ok: false, findings: "one fewer diagnostic"},
    },
  )
  assert_eq(v.reason, "failed_verification")
  assert_eq(v.escalation_recommended, false)
  assert_eq(v.escalation_target, nil)
}

pipeline test_source_write_green_verifier_allows(harness: Harness, task: unknown) {
  // burin verified_after_write.
  const v = __completion_gate_ladder(
    {
      source_known: true,
      source_write_count: 1,
      requires_write: true,
      verify: {ok: true, findings: ""},
      oracle_expected: true,
    },
  )
  assert_eq(v.ok, true)
  assert_eq(v.reason, "verified_after_write")
}

pipeline test_source_write_no_verify_run_vetoes(harness: Harness, task: unknown) {
  // burin missing_verification: wrote source, verifier configured, never ran.
  // Strict — burin's budget never releases a post-write state without a fresh
  // green verifier (`saw_write && !verification_after_last_write`).
  const v = __completion_gate_ladder(
    {
      source_known: true,
      source_write_count: 1,
      requires_write: true,
      verify: nil,
      oracle_expected: true,
    },
  )
  assert_eq(v.ok, false)
  assert_eq(v.reason, "missing_verification")
  assert_eq(v.strict, true)
}

pipeline test_non_coding_task_allows_without_write(harness: Harness, task: unknown) {
  // burin no_workspace_write: a task that does not require a source change.
  const v = __completion_gate_ladder(
    {source_known: true, source_write_count: 0, requires_write: false, verify: nil},
  )
  assert_eq(v.ok, true)
  assert_eq(v.reason, "no_workspace_write")
}

pipeline test_source_write_no_oracle_allows(harness: Harness, task: unknown) {
  const v = __completion_gate_ladder(
    {
      source_known: true,
      source_write_count: 1,
      requires_write: true,
      verify: nil,
      oracle_expected: false,
    },
  )
  assert_eq(v.ok, true)
  assert_eq(v.reason, "wrote_source_no_oracle")
}

pipeline test_thin_facts_abstain(harness: Harness, task: unknown) {
  // No write facts, no verifier signal: the deterministic gate abstains (judge-only).
  const v = __completion_gate_ladder({source_known: false, verify: nil})
  assert_eq(v.ok, true)
  assert_eq(v.reason, "gate_abstain")
}

pipeline test_unknown_source_but_red_verifier_still_strict(harness: Harness, task: unknown) {
  // Even with source counts unknown, a red verifier blocks (strict).
  const v = __completion_gate_ladder(
    {source_known: false, verify: {ok: false, findings: "lint"}, oracle_expected: true},
  )
  assert_eq(v.ok, false)
  assert_eq(v.reason, "verification_after_write_red")
  assert_eq(v.strict, true)
}

pipeline test_classify_writes_with_callback(harness: Harness, task: unknown) {
  const counts = __completion_gate_classify_writes(
    [{path: "src/a.rs"}, {path: "README.md"}, {path: "src/b.rs"}],
    classify_by_ext,
  )
  assert_eq(counts.source_write_count, 2)
  assert_eq(counts.cosmetic_write_count, 1)
  assert_eq(counts.other_write_count, 0)
}

pipeline test_classify_writes_uses_kind_field_then_conservative_default(
  harness: Harness,
  task: unknown,
) {
  // No callback: honor an explicit kind, default the unclassified write to source.
  const counts = __completion_gate_classify_writes([{kind: "cosmetic"}, {kind: "source"}, {}], nil)
  assert_eq(counts.source_write_count, 2)
  assert_eq(counts.cosmetic_write_count, 1)
}

pipeline test_classify_writes_other_kind_not_source(harness: Harness, task: unknown) {
  const counts = __completion_gate_classify_writes([{kind: "test"}, {kind: "doc"}], nil)
  assert_eq(counts.source_write_count, 0)
  assert_eq(counts.other_write_count, 2)
}

pipeline test_combine_verify_nil_is_nil(harness: Harness, task: unknown) {
  assert_eq(__completion_gate_combine_verify(nil, nil), nil)
}

pipeline test_combine_verify_any_red_blocks(harness: Harness, task: unknown) {
  const combined = __completion_gate_combine_verify(
    [{ok: true}, {ok: false, findings: "lint"}],
    nil,
  )
  assert_eq(combined.ok, false)
  assert_eq(combined.findings, "lint")
}

pipeline test_combine_verify_concatenates_findings(harness: Harness, task: unknown) {
  const combined = __completion_gate_combine_verify(
    [{ok: false, findings: "a"}, {ok: false, findings: "b"}],
    nil,
  )
  assert_eq(combined.ok, false)
  assert_eq(combined.findings, "a; b")
}

pipeline test_combine_verify_custom_combiner_wins(harness: Harness, task: unknown) {
  const combiner = fn(_verdicts) { return {ok: true, findings: "overridden"} }
  const combined = __completion_gate_combine_verify([{ok: false, findings: "x"}], combiner)
  assert_eq(combined.ok, true)
  assert_eq(combined.findings, "overridden")
}

pipeline test_budget_allow_never_charges(harness: Harness, task: unknown) {
  const out = __completion_gate_apply_budget({ok: true, reason: "verified_after_write"}, 5, 3)
  assert_eq(out.verdict.ok, true)
  assert_eq(out.charge, false)
}

pipeline test_budget_soft_veto_under_budget_charges(harness: Harness, task: unknown) {
  const out = __completion_gate_apply_budget(
    {ok: false, reason: "no_source_write", strict: false},
    1,
    3,
  )
  assert_eq(out.verdict.ok, false)
  assert_eq(out.verdict.reason, "no_source_write")
  assert_eq(out.charge, true)
}

pipeline test_budget_soft_veto_exhausted_converts_to_allow(harness: Harness, task: unknown) {
  // At the budget, a non-strict veto converts to an attributable allow.
  const out = __completion_gate_apply_budget(
    {ok: false, reason: "no_source_write", strict: false},
    3,
    3,
  )
  assert_eq(out.verdict.ok, true)
  assert_eq(out.verdict.reason, "veto_budget_exhausted")
  assert_eq(out.verdict.converted_from, "no_source_write")
  assert_eq(out.charge, false)
}

pipeline test_budget_strict_veto_never_converts(harness: Harness, task: unknown) {
  // burin carve-out: a source write with a red verifier is NEVER let through by
  // budget exhaustion — only a fresh green verifier ends it.
  const out = __completion_gate_apply_budget(
    {ok: false, reason: "verification_after_write_red", strict: true},
    9,
    3,
  )
  assert_eq(out.verdict.ok, false)
  assert_eq(out.verdict.reason, "verification_after_write_red")
  assert_eq(out.charge, true)
}

pipeline test_budget_missing_verification_never_converts(harness: Harness, task: unknown) {
  // The divergence crux: a post-write state with a configured-but-unrun verifier
  // is strict in burin (`saw_write && !verification_after_last_write` is never
  // budget-released), so the budget must never convert it to done either.
  const out = __completion_gate_apply_budget(
    {ok: false, reason: "missing_verification", strict: true},
    9,
    3,
  )
  assert_eq(out.verdict.ok, false)
  assert_eq(out.verdict.reason, "missing_verification")
  assert_eq(out.charge, true)
}

pipeline test_budget_disabled_never_converts(harness: Harness, task: unknown) {
  // max_vetoes = 0 disables the budget: soft vetoes stay vetoes forever.
  const out = __completion_gate_apply_budget(
    {ok: false, reason: "no_source_write", strict: false},
    99,
    0,
  )
  assert_eq(out.verdict.ok, false)
  assert_eq(out.verdict.reason, "no_source_write")
  assert_eq(out.charge, true)
}

pipeline test_ladder_feedback_override_replaces(harness: Harness, task: unknown) {
  const v = __completion_gate_ladder(
    {cosmetic_write_count: 1, requires_write: true, source_known: true, source_write_count: 0},
    {no_source_write_cosmetic: "Custom cosmetic guidance."},
  )
  assert_eq(v.reason, "no_source_write")
  assert_eq(v.feedback, "Custom cosmetic guidance.")
}

pipeline test_ladder_feedback_override_keeps_findings_token(harness: Harness, task: unknown) {
  // An override may keep the dynamic findings via the {findings} token.
  const v = __completion_gate_ladder(
    {
      oracle_expected: true,
      requires_write: true,
      source_known: true,
      source_write_count: 1,
      verify: {findings: "E0308", ok: false},
    },
    {verification_after_write_red: "Red.{findings} Retry."},
  )
  assert_eq(v.feedback, "Red. Findings: E0308. Retry.")
}

pipeline test_escalated_feedback_override_renders_attempts_and_findings(
  harness: Harness,
  task: unknown,
) {
  const v = __completion_gate_ladder(
    {
      consecutive_failed_after_write: 4,
      escalation_threshold: 3,
      requires_write: true,
      source_known: true,
      source_write_count: 1,
      verify: {findings: "E0308", ok: false},
    },
    {repeated_verification_failures: "Attempt {attempts}.{findings} Escalate."},
  )
  assert_eq(v.feedback, "Attempt 4. Findings: E0308. Escalate.")
}
