import { agent_loop } from "std/agent/loop"
import { with_temp_dir } from "std/testing"

fn finish_one_turn(harness: Harness, session: string, root: string) {
  return agent_loop(
    harness,
    "Finish immediately.",
    nil,
    {
      session_id: session,
      root: root,
      provider: "mock",
      model: "mock",
      llm_caller: { _ ->
        return {
          ok: true,
          value: {text: "##DONE##", tool_calls: [], provider: "mock", model: "mock"},
        }
      },
      loop_until_done: true,
      done_sentinel: "##DONE##",
      turn_end_condition: false,
      final_wrapup: false,
      iteration_budget: {mode: "fixed", initial: 1, max: 1},
    },
  )
}

pipeline test_registered_listener_keeps_its_policy_and_restores_the_emitter(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const session = "subscriber-owner-" + harness.random.uuid()
      const key = session + "/observed"
      const later_key = session + "/later-listener"
      const emitter_key = session + "/emitter-write"
      harness.runtime.store_set(key, false)
      harness.runtime.store_set(later_key, false)
      harness.runtime.store_set(emitter_key, false)
      assert_eq(harness.runtime.store_get(key), false)
      harness.agent.subscribe(
        session,
        { event ->
          if event.type == "iteration_start" {
            assert_eq(harness.agent.current_id(), session)
            harness.runtime.store_set(key, true)
            throw "subscriber failure must not leak its execution policy"
          }
        },
      )
      harness.agent.subscribe(
        session,
        { event ->
          if event.type == "iteration_start" {
            harness.runtime.store_set(later_key, true)
          }
        },
      )
      harness.runtime.with_execution_policy(
        {side_effect_level: "read_only"},
        { ->
          const result = finish_one_turn(harness, session, root)
          assert_eq(result.terminal.kind, "natural")
          const forbidden = try {
            harness.runtime.store_set(emitter_key, true)
          }
          assert(is_err(forbidden), "the emitting caller must retain its read-only limit")
        },
      )
      assert_eq(harness.runtime.store_get(key), true, "the first listener must update its state")
      assert_eq(
        harness.runtime.store_get(later_key),
        true,
        "a failed listener must not skip the next",
      )
      assert_eq(harness.runtime.store_get(emitter_key), false)
      harness.runtime.store_set(emitter_key, true)
      assert_eq(
        harness.runtime.store_get(emitter_key),
        true,
        "the outer caller must regain its policy",
      )
    },
  )
}

pipeline test_restricted_listener_does_not_borrow_the_emitters_authority(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const session = "subscriber-restricted-" + harness.random.uuid()
      const key = session + "/forbidden-write"
      let reached = false
      harness.runtime.store_set(key, false)
      assert_eq(harness.runtime.store_get(key), false)
      harness.runtime.with_execution_policy(
        {side_effect_level: "read_only"},
        { ->
          harness.agent.subscribe(
            session,
            { event ->
              if event.type == "iteration_start" {
                reached = true
                harness.runtime.store_set(key, true)
              }
            },
          )
        },
      )
      const result = finish_one_turn(harness, session, root)
      assert_eq(result.terminal.kind, "natural")
      assert_eq(reached, true, "the restricted listener must run")
      assert_eq(
        harness.runtime.store_get(key),
        false,
        "registration restrictions must still deny state writes",
      )
      harness.runtime.store_set(key, true)
      assert_eq(
        harness.runtime.store_get(key),
        true,
        "the emitting caller must remain unrestricted",
      )
    },
  )
}
