// Run: harn test tests/agent/completion_typed_green_terminal_test.harn
//
// A run whose declared verifier passed over a source write, and whose turn is
// the sealed final answer, is already finished. These fixtures prove the
// completion judge is not called at that boundary, and — the load-bearing half —
// that it is still called everywhere else.
//
// The positive case alone would look identical to a mechanism that simply
// stopped calling the judge. Every control below is a boundary where the judge
// MUST still spend its call: no gate, an unrun verifier, a green verifier with
// no source write behind it, a non-sentinel stop, and a deferred effect that
// outlives the turn. See harn#8110.
import { agent_capture_events } from "std/agent/events"
import { agent_completion_adjudicator_declared } from "std/agent/judge"
import { __completion_typed_green_terminal } from "std/agent/judge_internals"
import { agent_loop } from "std/agent/loop"
import { llm_done, with_llm_script } from "std/testing"

const SKIP_OUTCOME = "skipped_verified_after_write"

fn __completion_receipts(events: unknown) {
  return events.filter(
    { event ->
      event.type == "typed_checkpoint"
        && event?.checkpoint?.schema
          == "harn.completion_directive_receipt.v1"
    },
  )
    .map({ event -> event.checkpoint })
    .to_list()
}

/**
 * How many times a completion judge was actually asked.
 *
 * Counted from `judge_started`, which is emitted immediately before the model
 * call and never for a skip. A count read off receipts or verdicts would also
 * be satisfied by a judge that ran and agreed, which is precisely the outcome
 * this mechanism must be distinguished from.
 */
fn __judge_calls(events: unknown) -> int {
  return len(events.filter({ event -> event.type == "judge_started" }).to_list())
}

/** A judge that refuses. Scripted so a call that happens is visible as a veto. */
fn __judge_refuses(detail: string) -> dict {
  return {
    text: json_stringify({verdict: "continue", detail: detail, gap_class: "missing_artifact"}),
  }
}

/** A gate that reports exactly the reading the case is about. */
fn __gate_reporting(confirm: bool, reason: string, observed: string) {
  return { _payload ->
    {
      confirm: confirm,
      message: "gate",
      reason: reason,
      verification: {
        oracle_expected: true,
        command: "run the project checks",
        observed: observed,
        observed_at_evidence_index: nil,
      },
    }
  }
}

/** The verification slot's judge, which runs BEFORE the completion slot's. */
fn __verification_judge_opts() -> dict {
  return {verify_completion_judge: {provider: "mock", max_invocations: 1}}
}

fn __run(harness: Harness, label: string, script: list, opts_extra: dict) {
  return with_llm_script(
    harness.llm,
    script,
    { ->
      const session = label + "-" + harness.random.uuid()
      const opts = {
        provider: "mock",
        session_id: session,
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 2,
        turn_end_condition: {provider: "mock", max_invocations: 1},
      }
        + opts_extra
      assert(
        agent_completion_adjudicator_declared(opts, "sentinel"),
        "every case here must declare an adjudicator, or it differs from the others by two variables",
      )
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Make the requested change.", nil, opts) },
      )
      return {events: captured.events, result: captured.result}
    },
  )
}

// -------------------------------------------------------------------------------------------------

// The conditions, at the owning interface. Each clause isolated, because every
// end-to-end case below blocks on several at once by construction.

// -------------------------------------------------------------------------------------------------

/** The reading a run that is genuinely finished presents. Cases vary ONE field. */
fn __green_reading() {
  return {
    deterministic_invoked: true,
    deterministic_reason: "verified_after_write",
    // A verifier command was actually declared. Without this the reading says a
    // pass came from a verifier that never existed, which three runs on a
    // downstream host were accepted on before the clause existed.
    oracle_expected: true,
    observed: "passed",
    stop_reason: "sentinel",
    final_text: "Implemented the selector and the verifier passed.",
    pending_tool_batch_effect_count: 0,
    ledger_pending_count: 0,
  }
}

pipeline test_typed_green_terminal_requires_every_clause(harness: Harness, task: unknown) {
  assert(__completion_typed_green_terminal(__green_reading()), "all seven clauses hold")
  assert(
    !__completion_typed_green_terminal(__green_reading() + {oracle_expected: false}),
    "a pass with no declared verifier is an answer about nothing and skips no judge",
  )
  assert(
    !__completion_typed_green_terminal(__green_reading() + {deterministic_invoked: false}),
    "a gate that never ran leaves the judge as the only authority",
  )
  // The clause the whole mechanism turns on: a green verifier with NO source
  // write behind it is `verified`, not `verified_after_write`, and it proves
  // nothing about work that was never done.
  assert(
    !__completion_typed_green_terminal(__green_reading() + {deterministic_reason: "verified"}),
    "a green verifier with no source write is an ordinary prose completion",
  )
  assert(
    !__completion_typed_green_terminal(
      __green_reading() + {deterministic_reason: "no_workspace_write"},
    ),
    "a gate that had nothing to gate is not a verified terminal",
  )
  assert(
    !__completion_typed_green_terminal(
      __green_reading() + {deterministic_reason: "facts_unavailable"},
    ),
    "a gate that could not look does not skip the judge, even beside a passed reading",
  )
  // Reason and reading must agree. A gate whose summary says green while the
  // reading it summarized says otherwise keeps the judge.
  assert(
    !__completion_typed_green_terminal(__green_reading() + {observed: "not_run"}),
    "an unrun verifier is not a passing one",
  )
  assert(
    !__completion_typed_green_terminal(__green_reading() + {observed: "failed"}),
    "a failing verifier is not a passing one",
  )
  assert(
    !__completion_typed_green_terminal(__green_reading() + {stop_reason: "stalled"}),
    "a stall is not the sealed final answer",
  )
  assert(
    !__completion_typed_green_terminal(__green_reading() + {final_text: "   "}),
    "an empty final response is the ambiguous case the judge exists for",
  )
  assert(
    !__completion_typed_green_terminal(__green_reading() + {pending_tool_batch_effect_count: 1}),
    "a deferred effect outliving the turn makes the verifier's reading stale",
  )
  // A green verifier answers "did the declared command pass". It is not an
  // answer to "was each thing the task asked for delivered", and the judge is
  // where a declared acceptance row is assessed.
  assert(
    !__completion_typed_green_terminal(__green_reading() + {ledger_pending_count: 1}),
    "an outstanding acceptance row is not something the verifier established",
  )
}

// -------------------------------------------------------------------------------------------------
// The canonical path, and every boundary where the judge must still be asked.
// -------------------------------------------------------------------------------------------------

pipeline test_verified_after_write_sentinel_never_calls_the_judge(harness: Harness, task: unknown) {
  // The judge is scripted to REFUSE. If it is called, the run continues and the
  // receipt says `continue`; the assertions below then fail on the quantity
  // this mechanism owns rather than on a downstream count.
  const captured = __run(
    harness,
    "typed-green",
    [llm_done(), __judge_refuses("the fixture does not satisfy the required case")],
    {verify_completion: __gate_reporting(true, "verified_after_write", "passed")},
  )
  assert_eq(__judge_calls(captured.events), 0)
  const receipts = __completion_receipts(captured.events)
  assert_eq(len(receipts), 1)
  assert_eq(receipts[0].action, "accept")
  assert_eq(receipts[0].outcome, SKIP_OUTCOME)
  assert_eq(receipts[0].reason, "verified_after_write")
  assert_eq(receipts[0].source, "gate")
  assert(receipts[0].invoked.deterministic, "the gate is recorded as having run")
  assert(
    !receipts[0].invoked.turn_end_condition,
    "a judge that never ran is not recorded as invoked",
  )
  assert_eq(receipts[0].verification.observed, "passed")
  assert_eq(captured.result.status, "done")
}

pipeline test_green_verifier_without_a_source_write_still_calls_the_judge(
  harness: Harness,
  task: unknown,
) {
  // The direction control. Same green reading, same sentinel, no source write:
  // the gate reports `verified` and the judge keeps its full authority.
  const captured = __run(
    harness,
    "typed-green-no-write",
    [llm_done(), __judge_refuses("no artifact was produced"), llm_done()],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  assert(__judge_calls(captured.events) >= 1, "the judge is asked on an ordinary prose completion")
  assert_eq(__completion_receipts(captured.events)[0].action, "continue")
}

pipeline test_unrun_verifier_still_calls_the_judge(harness: Harness, task: unknown) {
  const captured = __run(
    harness,
    "typed-green-unrun",
    [llm_done(), __judge_refuses("run the verifier before finishing"), llm_done()],
    {verify_completion: __gate_reporting(true, "no_workspace_write", "not_run")},
  )
  assert(__judge_calls(captured.events) >= 1, "an unverified path keeps the judge")
  assert_eq(__completion_receipts(captured.events)[0].action, "continue")
}

pipeline test_no_deterministic_gate_still_calls_the_judge(harness: Harness, task: unknown) {
  const captured = __run(
    harness,
    "typed-green-no-gate",
    [llm_done(), __judge_refuses("nothing verified this run"), llm_done()],
    {},
  )
  assert(__judge_calls(captured.events) >= 1, "with no gate the judge is the only authority")
  const receipts = __completion_receipts(captured.events)
  assert(!receipts[0].invoked.deterministic)
  assert_eq(receipts[0].action, "continue")
}

// -------------------------------------------------------------------------------------------------

// The other judge seam. `verify_completion_judge` runs first and had its own
// skip rule, catalog-declared and blind to the verification. One predicate now
// answers for both slots.

// -------------------------------------------------------------------------------------------------

pipeline test_the_verification_judge_is_skipped_on_the_same_terminal(
  harness: Harness,
  task: unknown,
) {
  const captured = __run(
    harness,
    "typed-green-verification",
    [llm_done(), __judge_refuses("the fixture does not satisfy the required case")],
    {verify_completion: __gate_reporting(true, "verified_after_write", "passed")}
      + __verification_judge_opts(),
  )
  assert_eq(__judge_calls(captured.events), 0)
  const receipts = __completion_receipts(captured.events)
  assert_eq(receipts[0].outcome, SKIP_OUTCOME)
  assert_eq(receipts[0].source, "gate")
  assert(
    !receipts[0].invoked.verify_completion_judge,
    "the verification judge is not recorded as invoked",
  )
  assert_eq(captured.result.status, "done")
}

pipeline test_both_judges_configured_and_neither_is_called(harness: Harness, task: unknown) {
  // The two slots are evaluated in order, so a skip that reached only one of
  // them would still spend a call. Both are declared here and the count is zero.
  const captured = __run(
    harness,
    "typed-green-both",
    [llm_done(), __judge_refuses("still not right"), __judge_refuses("still not right")],
    {verify_completion: __gate_reporting(true, "verified_after_write", "passed")}
      + __verification_judge_opts(),
  )
  assert_eq(__judge_calls(captured.events), 0)
  const receipts = __completion_receipts(captured.events)
  assert(
    !receipts[0].invoked.verify_completion_judge && !receipts[0].invoked.turn_end_condition,
    "neither judge is recorded as invoked",
  )
  assert_eq(captured.result.status, "done")
}

pipeline test_the_verification_judge_keeps_every_other_boundary(harness: Harness, task: unknown) {
  // The same three controls the completion slot has, on this slot. A green
  // verifier with no source write behind it, an unrun verifier, and no gate at
  // all each still spend the call.
  const no_write = __run(
    harness,
    "verification-no-write",
    [llm_done(), __judge_refuses("no artifact was produced"), llm_done()],
    {verify_completion: __gate_reporting(true, "verified", "passed")} + __verification_judge_opts(),
  )
  assert(
    __completion_receipts(no_write.events)[0].invoked.verify_completion_judge,
    "a prose completion keeps the VERIFICATION judge specifically, not merely some judge",
  )
  const unrun = __run(
    harness,
    "verification-unrun",
    [llm_done(), __judge_refuses("run the verifier before finishing"), llm_done()],
    {verify_completion: __gate_reporting(true, "no_workspace_write", "not_run")}
      + __verification_judge_opts(),
  )
  assert(
    __completion_receipts(unrun.events)[0].invoked.verify_completion_judge,
    "an unverified path keeps the verification judge",
  )
  const no_gate = __run(
    harness,
    "verification-no-gate",
    [llm_done(), __judge_refuses("nothing verified this run"), llm_done()],
    __verification_judge_opts(),
  )
  assert(
    __completion_receipts(no_gate.events)[0].invoked.verify_completion_judge,
    "with no gate the judge is the only authority",
  )
}

// -------------------------------------------------------------------------------------------------

// The acceptance ledger. The skip does not only skip the judge, it skips
// everything behind the judge, and the pending-requirements check that turns a
// done into a continue lives inside the structured invocation. Found against
// harn#8126, and the case below is the reproduction as reported. See harn#8110.

// -------------------------------------------------------------------------------------------------

/** A completion judge declaring one acceptance row nothing has measured. */
fn __completion_judge_with_open_ledger() -> dict {
  return {
    turn_end_condition: {
      provider: "mock",
      max_invocations: 1,
      requirement_contract: {
        requirements: [
          {
            requirement_id: "unmet-row",
            name: "The acceptance row nobody measured.",
            evidence_roles: ["deterministic_verification"],
          },
        ],
      },
    },
  }
}

pipeline test_an_open_ledger_row_still_blocks_the_terminal(harness: Harness, task: unknown) {
  const captured = __run(
    harness,
    "typed-green-open-ledger",
    [llm_done(), __judge_refuses("not there yet"), llm_done()],
    {verify_completion: __gate_reporting(true, "verified_after_write", "passed")}
      + __completion_judge_with_open_ledger(),
  )
  const receipts = __completion_receipts(captured.events)
  // Non-vacuity first. A `requirement_contract` under an unrecognized key
  // configures no ledger at all, and every assertion below would then be
  // measuring a run with nothing declared. The count is read off the receipt,
  // which is the runtime's own reading of the contract rather than the fixture
  // restated.
  assert_eq(receipts[0].requirements.required_count, 1)
  assert(
    __judge_calls(captured.events) >= 1,
    "an outstanding acceptance row is the judge's question, so it must be asked",
  )
  assert(receipts[0].requirements != nil, "a sealed done must never carry a null ledger")
  assert_eq(receipts[0].action, "continue")
  assert(captured.result.status != "done", "an open acceptance row outranks the terminal reading")
}

pipeline test_a_run_with_no_ledger_records_an_empty_one_not_a_null(
  harness: Harness,
  task: unknown,
) {
  // The direction control, and the receipt half of the fix. This run skips the
  // judge exactly as before. What must not happen is the skip recording `nil`,
  // which is the same value a run with an unassessed ledger would carry and is
  // therefore unreadable as evidence of anything.
  const captured = __run(
    harness,
    "typed-green-no-ledger",
    [llm_done(), __judge_refuses("the fixture does not satisfy the required case")],
    {verify_completion: __gate_reporting(true, "verified_after_write", "passed")},
  )
  assert_eq(__judge_calls(captured.events), 0)
  const receipts = __completion_receipts(captured.events)
  assert_eq(captured.result.status, "done")
  assert(
    receipts[0].requirements != nil,
    "a done sealed without a judge still says what the ledger held",
  )
  assert_eq(receipts[0].requirements.required_count, 0)
  assert_eq(receipts[0].requirements.pending_count, 0)
  assert(receipts[0].requirements.complete, "an undeclared ledger is complete, not unknown")
}

/**
 * Run a longer boundary sequence, so the judge can exhaust its budget rather
 * than the fixture running out of scripted turns. `__run`'s two iterations end
 * the run before a cap is ever reached.
 */
fn __run_to_cap(harness: Harness, label: string, script: list, opts_extra: dict) {
  return with_llm_script(
    harness.llm,
    script,
    { ->
      const session = label + "-" + harness.random.uuid()
      const opts = {
        provider: "mock",
        session_id: session,
        loop_until_done: true,
        done_sentinel: "##DONE##",
        max_iterations: 5,
        // `verified`, not `verified_after_write`, so the typed-green skip does
        // not fire and the boundary actually reaches the cap. `observed` is
        // still `passed`, which is the reading the cap conversion depends on,
        // so the two cases below differ only in whether a ledger is declared.
        verify_completion: __gate_reporting(true, "verified", "passed"),
      }
        + opts_extra
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Make the requested change.", nil, opts) },
      )
      return {events: captured.events, result: captured.result}
    },
  )
}

fn __refusing_run_to_cap(harness: Harness, label: string, judge_cfg: dict) {
  return __run_to_cap(
    harness,
    label,
    [
      llm_done(),
      __judge_refuses("not there yet"),
      llm_done(),
      __judge_refuses("still not"),
      llm_done(),
      llm_done(),
      llm_done(),
    ],
    {turn_end_condition: judge_cfg},
  )
}

pipeline test_a_judge_cap_over_an_open_ledger_does_not_seal_a_verified_stop(
  harness: Harness,
  task: unknown,
) {
  // The other way a boundary ends without asking the judge. A cap reached over
  // a passing verifier converts to `stop_verified`, which seals `done`. Read
  // without the ledger, that conversion fires on a run whose judge spent its
  // whole budget saying the acceptance row was not met. Measured before the
  // fix: two recorded refusals naming the row, then `stop_verified` with
  // reason `judge_cap_reached_over_verified_pass`, `requirements` null, and a
  // run status of `done`.
  const capped = __refusing_run_to_cap(
    harness,
    "cap-open-ledger",
    {
      provider: "mock",
      max_invocations: 2,
      requirement_contract: {
        requirements: [
          {
            requirement_id: "unmet-row",
            name: "The acceptance row nobody measured.",
            evidence_roles: ["deterministic_verification"],
          },
        ],
      },
    },
  )
  const receipts = __completion_receipts(capped.events)
  const sealing = receipts[len(receipts) - 1]
  // Non-vacuity: the judge really was handed a one-row ledger. Read off the
  // receipt it assessed, which is the runtime's reading of the contract.
  assert_eq(receipts[0].requirements.required_count, 1)
  assert(receipts[0].requirements.pending_count > 0, "the row was never established")
  assert_eq(__judge_calls(capped.events), 2)
  assert_eq(sealing.action, "stop_unverified")
  assert(capped.result.status != "done", "a cap is a budget, not an assessment")
}

pipeline test_a_judge_cap_with_no_ledger_still_stops_verified(harness: Harness, task: unknown) {
  // The direction control. The cap-over-a-passing-oracle conversion is a
  // deliberate mechanism and this change must not retire it: with no acceptance
  // rows outstanding there is nothing the judge was going to add, and the run
  // still stops verified on the oracle's answer.
  const capped = __refusing_run_to_cap(
    harness,
    "cap-no-ledger",
    {provider: "mock", max_invocations: 2},
  )
  const receipts = __completion_receipts(capped.events)
  const sealing = receipts[len(receipts) - 1]
  assert_eq(__judge_calls(capped.events), 2)
  assert_eq(sealing.action, "stop_verified")
  assert_eq(sealing.reason, "judge_cap_reached_over_verified_pass")
  assert_eq(capped.result.status, "done")
  // The receipt half of the fix, on the action class the rule is about: a
  // sealed done says what the ledger held rather than staying silent.
  assert(sealing.requirements != nil, "a sealed done always says what the ledger held")
  assert_eq(sealing.requirements.required_count, 0)
}
