// Run: harn test tests/agent/governors_test.harn
//
// Config-time validation for `std/agent/governors`. Pins the loud guard that
// rejects an unrecognized `policy.signal`, which would otherwise silently meter
// turn count. Everything here is pure: no model and no host.
import { governor_post_turn } from "std/agent/governors"

fn __live_payload() {
  return {iteration: 2, session_id: "gov-test", successful_tool_names: ["edit"]}
}

pipeline test_unrecognized_signal_throws(harness: Harness, task: unknown) {
  const cb = governor_post_turn(harness.agent, {budget: 5.0, signal: "iteration"})
  const outcome = try {
    cb(__live_payload())
  }
  assert(is_err(outcome), "governor rejects an unrecognized policy.signal")
}

pipeline test_recognized_signal_ok(harness: Harness, task: unknown) {
  const cb = governor_post_turn(harness.agent, {budget: 100.0, signal: "iterations"})
  const outcome = try {
    cb(__live_payload())
  }
  assert(!is_err(outcome), "governor accepts a recognized policy.signal")
}

pipeline test_default_signal_ok(harness: Harness, task: unknown) {
  // Absent signal defaults to "iterations" and must not trip the guard.
  const cb = governor_post_turn(harness.agent, {budget: 100.0})
  const outcome = try {
    cb(__live_payload())
  }
  assert(!is_err(outcome), "governor accepts an absent (defaulted) policy.signal")
}
