// Run: harn test tests/agent/purpose_labels_test.harn
//
// Deterministic unit tests for the purpose-label declaration grammar. These
// cover the pure half of the mechanism: option normalization, label clamping,
// and extracting the declaration out of one turn's prose. The last two run the
// real loop on a mock script to prove the label reaches the tool-call start
// event as `intent`. The wire shapes are proven separately by Rust tests.
import { agent_capture_events } from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import {
  agent_purpose_label_config,
  agent_purpose_label_extract,
  agent_purpose_label_normalize,
  agent_purpose_label_prefill,
  agent_purpose_label_prompt_fragment,
  agent_purpose_label_turn_nudge,
} from "std/agent/purpose_labels"
import { llm_text, llm_tool_call, with_llm_script } from "std/testing"

pipeline test_purpose_labels_default_off(harness: Harness, task: unknown) {
  const config = agent_purpose_label_config()
  assert(config.enabled == false)
  assert(config.max_chars == 64)
  assert(agent_purpose_label_prompt_fragment(config) == "")
}

pipeline test_purpose_labels_bool_shorthand(harness: Harness, task: unknown) {
  assert(agent_purpose_label_config(true).enabled == true)
  assert(agent_purpose_label_config(false).enabled == false)
  assert(agent_purpose_label_config({max_chars: 24}).enabled == true)
  assert(agent_purpose_label_config({max_chars: 24}).max_chars == 24)
}

pipeline test_purpose_labels_reject_bad_option(harness: Harness, task: unknown) {
  assert(
    is_err(
      try {
        agent_purpose_label_config("yes")
      },
    ),
  )
  assert(
    is_err(
      try {
        agent_purpose_label_config({enabled: "yes"})
      },
    ),
  )
  assert(
    is_err(
      try {
        agent_purpose_label_config({max_chars: 4})
      },
    ),
  )
}

pipeline test_purpose_label_normalize_collapses_and_clamps(harness: Harness, task: unknown) {
  assert(agent_purpose_label_normalize("  Searching\n  for issues  ", 64) == "Searching for issues")
  assert(agent_purpose_label_normalize(nil, 64) == "")
  assert(agent_purpose_label_normalize("   ", 64) == "")
  // Clipping keeps whole words and marks the truncation.
  assert(
    agent_purpose_label_normalize("Searching for open GitHub issues", 16) == "Searching for...",
  )
}

pipeline test_purpose_label_extract_pulls_declaration(harness: Harness, task: unknown) {
  const config = agent_purpose_label_config(true)
  const result = agent_purpose_label_extract(
    config,
    "<purpose>Searching for GitHub issues</purpose>\nI will look at the tracker.",
  )
  assert(result.declared == true)
  assert(result.label == "Searching for GitHub issues")
  // The tag never reaches the rendered prose or the replayed history.
  assert(result.text == "I will look at the tracker.")
}

pipeline test_purpose_label_extract_strips_every_declaration(harness: Harness, task: unknown) {
  const result = agent_purpose_label_extract(
    agent_purpose_label_config(true),
    "<purpose>First</purpose>a<purpose>Second</purpose>b",
  )
  assert(result.label == "First")
  assert(result.text == "ab")
}

pipeline test_purpose_label_extract_is_inert_when_off(harness: Harness, task: unknown) {
  const text = "<purpose>Searching</purpose>rest"
  const result = agent_purpose_label_extract(agent_purpose_label_config(), text)
  assert(result.declared == false)
  assert(result.label == "")
  // Off means untouched, not stripped: the option must have no effect on prose.
  assert(result.text == text)
}

pipeline test_purpose_label_extract_tolerates_undeclared_turn(harness: Harness, task: unknown) {
  const result = agent_purpose_label_extract(
    agent_purpose_label_config(true),
    "Just prose, no declaration.",
  )
  assert(result.declared == false)
  assert(result.label == "")
  assert(result.text == "Just prose, no declaration.")
}

pipeline test_purpose_label_prompt_fragment_teaches_the_grammar(harness: Harness, task: unknown) {
  const fragment = agent_purpose_label_prompt_fragment(agent_purpose_label_config(true))
  assert(contains(fragment, "<purpose>"))
  assert(contains(fragment, "</purpose>"))
  assert(contains(fragment, "64"))
}

pipeline test_purpose_label_delivery_defaults_to_system(harness: Harness, task: unknown) {
  const config = agent_purpose_label_config(true)
  assert(config.delivery == "system")
  assert(agent_purpose_label_prompt_fragment(config) != "")
  // Only one seam carries the instruction wording, so `system` and `nudge`
  // stay comparable. `prefill` is the exception and adds an opener on top.
  assert(agent_purpose_label_turn_nudge(config) == "")
  assert(agent_purpose_label_prefill(config) == "")
}

pipeline test_purpose_label_nudge_delivery_moves_the_instruction(harness: Harness, task: unknown) {
  const config = agent_purpose_label_config({delivery: "nudge"})
  assert(agent_purpose_label_prompt_fragment(config) == "")
  assert(contains(agent_purpose_label_turn_nudge(config), "<purpose>"))
  assert(agent_purpose_label_prefill(config) == "")
}

pipeline test_purpose_label_prefill_delivery_arms_the_opening_tag(harness: Harness, task: unknown) {
  const config = agent_purpose_label_config({delivery: "prefill"})
  // Prefill positions the declaration and the instruction says what belongs
  // in it. Measured with the opener alone, the model continued its ordinary
  // narration past the tag on 5 of 8 turns — every one a fired event carrying
  // prose, which is worse than a miss because it reads as compliance.
  assert(contains(agent_purpose_label_prompt_fragment(config), "<purpose>"))
  assert(agent_purpose_label_turn_nudge(config) == "")
  assert(agent_purpose_label_prefill(config) == "<purpose>")
}

pipeline test_purpose_label_reject_unknown_delivery(harness: Harness, task: unknown) {
  assert(
    is_err(
      try {
        agent_purpose_label_config({delivery: "sidecar"})
      },
    ),
  )
}

/**
 * A prefilled turn comes back without its opening tag. Reading that as "no
 * declaration" would make the whole prefill rung measure zero while looking
 * like model non-compliance.
 */
pipeline test_purpose_label_extract_recovers_a_prefilled_heading(harness: Harness, task: unknown) {
  const result = agent_purpose_label_extract(
    agent_purpose_label_config({delivery: "prefill"}),
    "Listing the agent stdlib</purpose>\nHere are the entries.",
  )
  assert(result.declared == true)
  assert(result.label == "Listing the agent stdlib")
  assert(result.text == "Here are the entries.")
}

/**
 * The orphan pattern is anchored, so a stray closing tag mid-prose cannot
 * promote arbitrary text into a heading.
 */
pipeline test_purpose_label_orphan_recovery_is_anchored(harness: Harness, task: unknown) {
  const result = agent_purpose_label_extract(
    agent_purpose_label_config(true),
    "I read the file. Then</purpose> I stopped.",
  )
  assert(result.declared == false)
  assert(result.label == "")
}

fn intent_tools() {
  return tool_define(
    tool_registry(),
    "inspect",
    "Inspect the target.",
    {
      handler: { _args -> "artifact list" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
}

/**
 * Run one declared tool turn through the real loop and return the tool-call
 * start event and every purpose-label event it produced.
 */
fn intent_run(harness: Harness, purpose_labels: bool) -> dict {
  const session = "purpose-intent-" + harness.random.uuid()
  return with_llm_script(
    harness.llm,
    [
      llm_tool_call("inspect", {}, "inspect-1")
        + {text: "<purpose>  Looking for\n PR 456 artifacts </purpose>"},
      llm_text("Done. ##DONE##"),
    ],
    { ->
      const captured = agent_capture_events(
        harness.agent,
        session,
        { ->
          agent_loop(
            harness,
            "Find the PR 456 artifacts.",
            nil,
            {
              provider: "mock",
              session_id: session,
              tools: intent_tools(),
              purpose_labels: purpose_labels,
              loop_until_done: true,
              max_iterations: 3,
              final_wrapup: false,
            },
          )
        },
      )
      const starts = captured.events.filter(
        { event -> event.type == "tool_call" && event?.tool_call_id == "inspect-1" },
      )
        .to_list()
      assert_eq(len(starts), 1, "the scripted call must reach dispatch exactly once")
      return {
        start: starts[0],
        labels: captured.events.filter({ event -> event.type == "purpose_label" }).to_list(),
      }
    },
  )
}

/**
 * The batch's declared heading rides the tool-call start event as `intent`,
 * from the same extraction that publishes the `purpose_label` event.
 */
pipeline test_purpose_label_reaches_the_tool_call_event_as_intent(harness: Harness, task: unknown) {
  const run = intent_run(harness, true)
  assert_eq(len(run.labels), 1)
  assert_eq(run.labels[0].label, "Looking for PR 456 artifacts")
  assert_eq(run.start?.intent, run.labels[0].label)
}

/** Labels stay opt-in: with the option off the call carries no intent. */
pipeline test_tool_call_has_no_intent_when_labels_are_off(harness: Harness, task: unknown) {
  const run = intent_run(harness, false)
  assert_eq(len(run.labels), 0)
  assert_eq(run.start?.intent, nil)
}
