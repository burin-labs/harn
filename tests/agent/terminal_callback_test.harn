// Run: harn test tests/agent/terminal_callback_test.harn
//
// In-process regression coverage for terminal callback rescue. This uses the
// mock LLM script and explicit callback verdicts, so it proves the loop
// mechanics without sleeps, wall-clock polling, API calls, or broad eval
// machinery.
import {
  agent_capture_events,
  agent_event_value,
  agent_feedback_injected_event_schema,
} from "std/agent/events"
import { agent_loop } from "std/agent/loop"
import { AgentSpec } from "std/agent/options"
import { llm_text, llm_tool_call, with_llm_script, with_temp_dir } from "std/testing"

fn terminal_callback_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "inspect",
    "Inspect the target.",
    {
      handler: { _args -> "target contents" },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  tools = tool_define(
    tools,
    "fail",
    "Fail to inspect the target.",
    {
      handler: { _args ->
        throw "inspection failed"
      },
      parameters: {},
      returns: {type: "string"},
      annotations: {kind: "read"},
    },
  )
  return tools
}

pipeline test_terminal_callback_can_continue_max_iteration_exit(harness: Harness, task: unknown) {
  with_llm_script(
    harness.llm,
    [
      llm_tool_call("inspect", {}, "inspect-1"),
      llm_tool_call("inspect", {}, "inspect-2"),
      llm_tool_call("fail", {}, "fail-1"),
      llm_tool_call("fail", {}, "fail-2"),
      llm_text("The rescue turn completed the task. ##DONE##"),
    ],
    { ->
      const session = "terminal-callback-" + harness.random.uuid()
      const opts: AgentSpec = {
        provider: "mock",
        session_id: session,
        tools: terminal_callback_tools(),
        loop_until_done: true,
        iteration_budget: {mode: "fixed", initial: 4, max: 4, extend_by: 0, expose_decisions: true},
        post_turn_callback: { _info ->
          return {message: "Keep going until the done sentinel is present."}
        },
        // Called twice now: once for the budget cut it rescues, and once for
        // the natural seal of the rescued run. The rescue verdict is only
        // correct on the first, so the branch is on the reported cause.
        terminal_callback: { info ->
          if info?.final_status != "budget_exhausted" {
            assert_eq(info?.final_status, "done")
            return {message: "The rescued run sealed on its own."}
          }
          assert_eq(info?.final_status, "budget_exhausted")
          assert_eq(info?.stop_reason, "max_iterations")
          assert(info?.budget_exhausted, "payload must expose a budget_exhausted boolean")
          assert_eq(info?.session_successful_tools, ["inspect"])
          assert_eq(info?.session_rejected_tools, ["fail"])
          return {
            message: "Terminal callback granted a bounded rescue turn.",
            next_options: {llm_options: {temperature: 0.0}},
          }
        },
      }
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(harness, "Continue once, then finish.", nil, opts) },
      )
      const result = captured.result
      assert_eq(result.status, "done")
      assert(result.llm.iterations >= 5, "terminal callback must allow the scripted rescue turn")
      const decisions = result?.adaptive_budget?.decisions ?? []
      assert(
        len(decisions) > 0 && decisions[len(decisions) - 1]?.reason == "terminal_callback_continue",
        "adaptive budget decisions should record the terminal rescue extension",
      )
      const feedback_kinds = captured.events.filter({ event -> event.type == "feedback_injected" })
        .map({ event -> agent_event_value(event, agent_feedback_injected_event_schema()).kind })
        .to_list()
      assert(
        contains(feedback_kinds, "post_turn"),
        "post-turn callback feedback should be injected as runtime feedback",
      )
      assert(
        contains(feedback_kinds, "terminal_callback"),
        "terminal callback feedback should be injected under its own kind",
      )
    },
  )
}

fn denial_toolset() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "edit",
    "Edit a file.",
    {
      handler: { args -> "wrote " + args.path },
      parameters: {
        path: {type: "string", description: "Path to edit"},
        text: {type: "string", description: "Replacement text"},
      },
      returns: {type: "string"},
      annotations: {kind: "write"},
    },
  )
  return tools
}

fn edit_call(id: string) {
  return {
    text: "",
    tool_calls: [{id: id, name: "edit", arguments: {path: "src/app.rs", text: "fixed"}}],
  }
}

fn record_terminal(fs: HarnessFs, path: string, info: dict) -> nil {
  const prior: list = if fs.exists(path) {
    json_parse(fs.read_text(path))
  } else {
    []
  }
  fs.write_text(
    path,
    json_stringify(
      prior.appending(
        {
          status: info.final_status,
          reason: info.stop_reason,
          has_error: info?.terminal_error != nil,
          iteration: info.iteration,
          successful_tools: info.session_successful_tools,
        },
      ),
    ),
  )
}

fn terminal_records(fs: HarnessFs, path: string) -> list {
  assert(fs.exists(path), "the terminal callback must write its artifact")
  return json_parse(fs.read_text(path))
}

fn terminal_spec(session: string) -> AgentSpec {
  return {
    provider: "mock",
    session_id: session,
    tools: terminal_callback_tools(),
    tool_format: "native",
    loop_until_done: true,
    done_sentinel: "##DONE##",
    max_iterations: 4,
    final_wrapup: false,
    stall_diagnostics: {enabled: false},
  }
}

pipeline test_a_thrown_loop_error_writes_the_terminal_artifact(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      with_llm_script(
        harness.llm,
        [llm_tool_call("inspect", {}, "inspect-1")],
        { ->
          const opts = terminal_spec("terminal-throw-" + harness.random.uuid())
            + {
              post_turn_callback: { _info ->
                throw "injected post-turn failure"
              },
              terminal_callback: { info -> record_terminal(harness.fs, path, info) },
            }
          const outcome = try {
            agent_loop(harness, "Inspect the target.", nil, opts)
          }
          assert(is_err(outcome), "the loop must retain its thrown failure")
          assert(contains(to_string(unwrap_err(outcome)), "injected post-turn failure"))
          assert_eq(len(harness.llm.mock_calls()), 1)
          const records = terminal_records(harness.fs, path)
          assert_eq(len(records), 1)
          assert_eq(records[0].status, "failed")
          assert_eq(records[0].reason, "error")
          assert(records[0].has_error)
          assert_eq(records[0].iteration, 1)
          assert_eq(records[0].successful_tools, ["inspect"])
        },
      )
    },
  )
}

pipeline test_a_terminal_denial_is_recorded_without_a_rescue(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      with_llm_script(
        harness.llm,
        [edit_call("edit-1"), edit_call("edit-2"), edit_call("edit-3")],
        { ->
          const opts = terminal_spec("terminal-denial-" + harness.random.uuid())
            + {
              tools: denial_toolset(),
              approval_policy: {auto_deny: ["edit"]},
              terminal_callback: { info ->
                record_terminal(harness.fs, path, info)
                return {message: "Try once more."}
              },
            }
          const result = agent_loop(harness, "Edit src/app.rs.", nil, opts)
          assert_eq(result.status, "error")
          assert_eq(result.stop_reason, "repeated_non_retryable_denial")
          assert_eq(len(harness.llm.mock_calls()), 2, "a terminal denial cannot be rescued")
          const records = terminal_records(harness.fs, path)
          assert_eq(len(records), 1)
          assert_eq(records[0].status, result.status)
          assert_eq(records[0].reason, result.stop_reason)
          assert(records[0].has_error)
        },
      )
    },
  )
}

pipeline test_natural_completion_writes_its_artifact_before_the_artifact_check(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      with_llm_script(
        harness.llm,
        [llm_text("Nothing to change. ##DONE##")],
        { ->
          const opts = terminal_spec("terminal-natural-" + harness.random.uuid())
            + {
              require_artifacts: [path],
              terminal_callback: { info -> record_terminal(harness.fs, path, info) },
            }
          const result = agent_loop(harness, "Report the outcome.", nil, opts)
          assert_eq(result.terminal.kind, "natural")
          assert_eq(len(harness.llm.mock_calls()), 1)
          const records = terminal_records(harness.fs, path)
          assert_eq(len(records), 1)
          assert_eq(records[0].status, "done")
          assert_eq(records[0].reason, result.stop_reason)
          assert(!records[0].has_error, "natural completion must not be relabeled as an error")
        },
      )
    },
  )
}

pipeline test_spent_terminal_allowance_still_notifies_but_cannot_extend(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      with_llm_script(
        harness.llm,
        [
          llm_tool_call("inspect", {}, "inspect-1"),
          llm_tool_call("inspect", {}, "inspect-2"),
          llm_text("This call must not be reached. ##DONE##"),
        ],
        { ->
          const opts = terminal_spec("terminal-spent-" + harness.random.uuid())
            + {
              iteration_budget: {
                mode: "fixed",
                initial: 1,
                max: 1,
                extend_by: 1,
                expose_decisions: true,
              },
              post_turn_callback: { _info -> return {message: "Keep inspecting."} },
              terminal_callback: { info ->
                record_terminal(harness.fs, path, info)
                return {message: "Request a rescue turn."}
              },
            }
          const result = agent_loop(harness, "Inspect the target.", nil, opts)
          assert_eq(result.terminal.kind, "policy_budget")
          assert_eq(result.stop_reason, "max_iterations")
          assert_eq(len(harness.llm.mock_calls()), 2, "only one rescue turn may be spent")
          const grants = result.adaptive_budget.decisions.filter(
            { decision -> decision.reason == "terminal_callback_continue" },
          )
            .to_list()
          assert_eq(len(grants), 1, "the terminal-report allowance must actually be spent")
          const records = terminal_records(harness.fs, path)
          assert_eq(len(records), 2, "the exhausted terminal must notify after the rescue terminal")
          assert_eq(
            records.map({ row -> row.status }).to_list(),
            ["budget_exhausted", "budget_exhausted"],
          )
          assert_eq(records.map({ row -> row.iteration }).to_list(), [1, 2])
        },
      )
    },
  )
}

pipeline test_a_callback_that_throws_is_not_called_twice(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      with_llm_script(
        harness.llm,
        [llm_text("Done. ##DONE##")],
        { ->
          const opts = terminal_spec("terminal-callback-throw-" + harness.random.uuid())
            + {
              terminal_callback: { info ->
                record_terminal(harness.fs, path, info)
                throw "injected terminal callback failure"
              },
            }
          const outcome = try {
            agent_loop(harness, "Report the outcome.", nil, opts)
          }
          assert(is_err(outcome))
          assert(contains(to_string(unwrap_err(outcome)), "injected terminal callback failure"))
          assert_eq(len(terminal_records(harness.fs, path)), 1)
          assert_eq(len(harness.llm.mock_calls()), 1)
        },
      )
    },
  )
}

pipeline test_callback_failure_preserves_the_original_loop_error(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      with_llm_script(
        harness.llm,
        [llm_tool_call("inspect", {}, "inspect-1")],
        { ->
          const opts = terminal_spec("terminal-double-error-" + harness.random.uuid())
            + {
              post_turn_callback: { _info ->
                throw "original loop failure"
              },
              terminal_callback: { info ->
                record_terminal(harness.fs, path, info)
                throw "terminal writer failure"
              },
            }
          const outcome = try {
            agent_loop(harness, "Inspect the target.", nil, opts)
          }
          assert(is_err(outcome))
          const error = unwrap_err(outcome)
          assert_eq(error.kind, "agent_loop_terminal_callback_failed")
          assert(contains(to_string(error.cause.terminal_error), "original loop failure"))
          assert(contains(to_string(error.cause.callback_error), "terminal writer failure"))
          assert_eq(len(terminal_records(harness.fs, path)), 1)
          assert_eq(len(harness.llm.mock_calls()), 1)
        },
      )
    },
  )
}

pipeline test_a_deadline_notifies_without_reopening_the_loop(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      harness.testing.clock_set(0)
      try {
        const opts = terminal_spec("terminal-deadline-" + harness.random.uuid())
          + {
            iteration_budget: {mode: "fixed", initial: 5, max: 5, wall_clock_ms: 1000},
            llm_caller: { _call ->
              harness.testing.clock_advance(1500)
              return {ok: true, value: {text: "still working", provider: "mock", model: "mock"}}
            },
            terminal_callback: { info ->
              record_terminal(harness.fs, path, info)
              return {message: "Try another turn."}
            },
          }
        const result = agent_loop(harness, "Keep inspecting.", nil, opts)
        assert_eq(result.terminal.kind, "policy_budget")
        assert_eq(result.stop_reason, "wall_clock")
        assert_eq(result.llm.iterations, 1)
        const records = terminal_records(harness.fs, path)
        assert_eq(len(records), 1)
        assert_eq(records[0].status, "budget_exhausted")
        assert_eq(records[0].reason, "wall_clock")
      } catch (error) {
        throw error
      } finally {
        harness.testing.clock_reset()
      }
    },
  )
}

pipeline test_reserved_verification_still_reaches_terminal_notification(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const path = path_join(root, "terminal.json")
      const source = path_join(root, "source.txt")
      let tools = tool_registry()
      tools = tool_define(
        tools,
        "apply_fix",
        "Apply the fix.",
        {
          handler: { _args ->
            harness.fs.write_text(source, "fixed")
            return "fixed"
          },
          parameters: {},
          returns: {type: "string"},
          annotations: {kind: "write"},
        },
      )
      with_llm_script(
        harness.llm,
        [llm_tool_call("apply_fix", {}, "edit-1")],
        { ->
          const opts = terminal_spec("terminal-reserved-" + harness.random.uuid())
            + {
              tools: tools,
              max_iterations: 1,
              verify_completion: { info ->
                assert_eq(info.stop_reason, "reserved_terminal_verify")
                assert_eq(harness.fs.read_text(source), "fixed")
                return nil
              },
              stall_diagnostics: {
                enabled: true,
                repair_aware: true,
                post_edit_reverify: true,
                reserved_terminal_verify: true,
                reserved_terminal_verify_iterations: 1,
              },
              terminal_callback: { info -> record_terminal(harness.fs, path, info) },
            }
          const result = agent_loop(harness, "Apply and verify the fix.", nil, opts)
          assert_eq(result.status, "done")
          assert_eq(result.stop_reason, "reserved_terminal_verify")
          const records = terminal_records(harness.fs, path)
          assert_eq(len(records), 1)
          assert_eq(records[0].status, "done")
          assert_eq(records[0].reason, "reserved_terminal_verify")
        },
      )
    },
  )
}
