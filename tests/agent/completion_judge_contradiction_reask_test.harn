// Run: harn test tests/agent/completion_judge_contradiction_reask_test.harn
//
// harn#8060. `done` beside a populated `gap_class` is refused (harn#7910), and
// refusing it once is right. Refusing it N times is not: the re-ask prompt was
// unchanged between invocations, so a judge whose reply is stable returned the
// identical contradiction on every call, the actor was handed the judge's own
// "the work is finished" text as its next step, and the run died at
// `turn_end_judge_cap_reached` having never actually been refused by anyone.
//
// Measured on two hosted coding cells at harn v0.10.129: ten of ten completion
// judge invocations replied `{"verdict":"done","gap_class":"other"}` with a
// detail naming a passing verifier, ten of ten were inverted to `continue`, and
// both runs ended `completion_unverified` over a declared verifier that had
// passed and a clean-checkout re-execution that had passed.
//
// The fix is in two halves and this file pins both, with the controls that
// separate them from a blanket weakening:
//   1. the contradiction is re-asked ONCE with the contradiction named;
//   2. if it survives that AND names nothing AND the deterministic gate observed
//      the verifier passing, the refusal is overruled rather than spent.
// A NAMED gap converts nothing, in either half. That is harn#7910's case and it
// must keep failing exactly as it does today.
import { agent_capture_events } from "std/agent/events"
import { __completion_contradiction_arbitration_converts } from "std/agent/judge_internals"
import { agent_loop } from "std/agent/loop"
import { llm_done, with_llm_script } from "std/testing"

const CONVERSION = "gap_contradicts_done_survived_reask_over_passing_verifier"

const RETRY_SCHEMA = "harn.completion_judge_contradiction_retry.v1"

fn __completion_receipts(events: unknown) {
  return events.filter(
    { event ->
      event.type == "typed_checkpoint"
        && event?.checkpoint?.schema
          == "harn.completion_directive_receipt.v1"
    },
  )
    .map({ event -> event.checkpoint })
    .to_list()
}

/** Count conversions by `converted_from` ONLY. */
fn __conversion_count(events: unknown) -> int {
  let count = 0
  for receipt in __completion_receipts(events) {
    if receipt?.converted_from == CONVERSION {
      count = count + 1
    }
  }
  return count
}

/** Count the re-asks by their own receipt, never by a judge-call arithmetic. */
fn __reask_count(events: unknown) -> int {
  return len(
    events.filter(
      { event -> event.type == "typed_checkpoint" && event?.checkpoint?.schema == RETRY_SCHEMA },
    )
      .to_list(),
  )
}

/** A gate that reports exactly the reading the case is about. */
fn __gate_reporting(confirm: bool, reason: string, observed: string) {
  return { _payload ->
    {
      confirm: confirm,
      message: "checked",
      reason: reason,
      verification: {
        oracle_expected: true,
        command: "run the project checks",
        observed: observed,
        observed_at_evidence_index: nil,
      },
    }
  }
}

/**
 * The reply shape measured in the field: an acceptance whose detail cites the
 * passing verifier, with `gap_class` populated anyway.
 */
fn __judge_done_with_gap(gap_class: string?) -> dict {
  const detail =
    "Median is implemented across lexer, AST, parser, and aggregation logic. The required verifier passed all 3 tests with 0 failures."
  const body = if gap_class == nil {
    {verdict: "done", detail: detail}
  } else {
    {verdict: "done", detail: detail, gap_class: gap_class}
  }
  return {text: json_stringify(body)}
}

fn __run(harness: Harness, label: string, script: list, opts_extra: dict) {
  return with_llm_script(
    harness.llm,
    script,
    { ->
      const session = label + "-" + harness.random.uuid()
      const captured = agent_capture_events(
        harness.agent,
        session,
        fn() { return agent_loop(
          harness,
          "Make the requested change.",
          nil,
          {
            provider: "mock",
            session_id: session,
            loop_until_done: true,
            done_sentinel: "##DONE##",
            max_iterations: 6,
            verify_completion_judge: {provider: "mock", max_invocations: 3},
          }
            + opts_extra,
        ) },
      )
      return {events: captured.events, result: captured.result}
    },
  )
}

// -------------------------------------------------------------------------------------------------
// The conditions, at the owning interface.
// -------------------------------------------------------------------------------------------------

pipeline test_contradiction_arbitration_requires_every_clause(harness: Harness, task: unknown) {
  assert(
    __completion_contradiction_arbitration_converts(
      "other",
      true,
      true,
      true,
      "verified_after_write",
      "passed",
    ),
    "all five clauses hold",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "unresolved_authorization",
      true,
      true,
      true,
      "verified_after_write",
      "passed",
    ),
    "a NAMED gap is never converted — this is harn#7910's case",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "missing_artifact",
      true,
      true,
      true,
      "verified_after_write",
      "passed",
    ),
    "a missing artifact is never converted",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "other",
      false,
      true,
      true,
      "verified_after_write",
      "passed",
    ),
    "a FIRST contradiction still refuses; only one that survived its re-ask converts",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "other",
      true,
      false,
      true,
      "verified_after_write",
      "passed",
    ),
    "a gate that never ran cannot overrule anyone",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "other",
      true,
      true,
      true,
      "facts_unavailable",
      "passed",
    ),
    "`facts_unavailable` blocks the conversion even alongside a passed reading",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "other",
      true,
      true,
      true,
      "verified_after_write",
      "not_run",
    ),
    "an unrun verifier is not a passing one",
  )
  assert(
    !__completion_contradiction_arbitration_converts(
      "other",
      true,
      true,
      true,
      "verified_after_write",
      "failed",
    ),
    "a failing verifier is not a passing one",
  )
}

// -------------------------------------------------------------------------------------------------

// Half one: the contradiction is resolved once, and a judge that takes an exit
// is believed. No arbitration is involved in either of these.

// -------------------------------------------------------------------------------------------------

pipeline test_a_contradiction_is_reasked_exactly_once(harness: Harness, task: unknown) {
  // The judge drops the field on the re-ask, which is the exit the prompt asks
  // for. That reply is the one of record, so the run finishes with NO conversion
  // — nothing was overruled, the judge simply answered.
  const captured = __run(
    harness,
    "contradiction-reask-resolves",
    [llm_done(), __judge_done_with_gap("other"), __judge_done_with_gap(nil), llm_done()],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  assert_eq(__reask_count(captured.events), 1)
  assert_eq(__conversion_count(captured.events), 0)
  assert_eq(captured.result.status, "done")
  const receipts = __completion_receipts(captured.events)
  assert_eq(receipts[0].action, "accept")
  assert_eq(receipts[0].converted_from, nil)
}

pipeline test_a_reask_that_names_a_real_gap_is_believed(harness: Harness, task: unknown) {
  // The other exit the prompt offers. The judge turns its contradiction into an
  // honest refusal, and that refusal stands: the run must not finish.
  const captured = __run(
    harness,
    "contradiction-reask-refuses",
    [
      llm_done(),
      __judge_done_with_gap("other"),
      {
        text: json_stringify(
          {
            verdict: "continue",
            detail: "the vendored directory was modified",
            gap_class: "unmet_manner_clause",
          },
        ),
      },
      llm_done(),
      __judge_done_with_gap("unmet_manner_clause"),
      llm_done(),
      __judge_done_with_gap("unmet_manner_clause"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  assert(
    captured.result.status != "done",
    "a judge that named a manner-clause gap on the re-ask still produced a finished run: "
      + to_string(captured.result.status),
  )
  assert_eq(__conversion_count(captured.events), 0)
}

// -------------------------------------------------------------------------------------------------

// Half two: the contradiction survives, and the run must not be spent on it.
// This is the falsifier for harn#8060.

// -------------------------------------------------------------------------------------------------

pipeline test_a_surviving_unnamed_contradiction_cannot_reach_the_cap(
  harness: Harness,
  task: unknown,
) {
  // The measured shape: the judge returns the same self-contradiction however
  // many times it is asked, on a run the gate observed verifying green.
  const captured = __run(
    harness,
    "contradiction-survives",
    [
      llm_done(),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  // The conversion count comes first deliberately: it is counted by
  // `converted_from` alone. Reverting the arbitration must fail HERE, naming the
  // missing conversion, rather than downstream on a status a dozen unrelated
  // changes could also move.
  assert_eq(__conversion_count(captured.events), 1)
  assert_eq(__reask_count(captured.events), 1)
  assert_eq(captured.result.status, "done")
  assert(
    to_string(captured.result?.terminal?.reason ?? "") != "turn_end_judge_cap_reached",
    "the run reached the judge cap on a contradiction nobody could answer",
  )
  const receipts = __completion_receipts(captured.events)
  assert_eq(receipts[0].action, "accept")
  assert_eq(receipts[0].converted_from, CONVERSION)
  assert_eq(receipts[0].gap_class, "other")
  assert(receipts[0].invoked.deterministic, "the gate must be recorded as having run")
  assert_eq(receipts[0].verification.observed, "passed")
}

pipeline test_a_surviving_named_contradiction_still_refuses(harness: Harness, task: unknown) {
  // The direction control that matters most. Same gate, same green verifier,
  // same stubborn judge — but it names an obligation. harn#7910's run returns
  // exactly this, and it must still be refused.
  const captured = __run(
    harness,
    "contradiction-named-survives",
    [
      llm_done(),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  assert(
    captured.result.status != "done",
    "a judge naming an unresolved authorization gap still produced a finished run: "
      + to_string(captured.result.status),
  )
  assert_eq(__conversion_count(captured.events), 0)
}

pipeline test_a_surviving_contradiction_without_a_passing_verifier_still_refuses(
  harness: Harness,
  task: unknown,
) {
  // The evidence clause, end to end. `other` names nothing on either side, so
  // with no positive reading from the gate there is nothing to prefer the
  // acceptance over — and the refusal stands.
  const captured = __run(
    harness,
    "contradiction-unrun",
    [
      llm_done(),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      __judge_done_with_gap("other"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "no_workspace_write", "not_run")},
  )
  assert(
    captured.result.status != "done",
    "an unnamed contradiction converted with no passing verifier behind it: "
      + to_string(captured.result.status),
  )
  assert_eq(__conversion_count(captured.events), 0)
}

/**
 * WHY THE END-TO-END CASES ABOVE SAY `verified` AND NOT `verified_after_write`.
 *
 * On the after-write reading the judge is no longer called at all: the runtime
 * holds a typed green terminal and answers the boundary itself (harn#8110). A
 * re-ask cannot happen to a judge that never ran, so a case that wants to
 * exercise the re-ask has to pick a reading the skip does not cover.
 *
 * This pipeline pins the transition rather than letting the fixture edit hide
 * it: on the ORIGINAL reading, the contradiction the suite is built around never
 * gets asked, and the run finishes on the runtime's own evidence.
 */
pipeline test_the_original_reading_never_asks_the_judge(harness: Harness, task: unknown) {
  const captured = __run(
    harness,
    "contradiction-typed-green",
    [llm_done(), __judge_done_with_gap("other"), __judge_done_with_gap("other")],
    {verify_completion: __gate_reporting(true, "verified_after_write", "passed")},
  )
  assert_eq(len(captured.events.filter({ event -> event.type == "judge_started" }).to_list()), 0)
  assert_eq(captured.result.status, "done")
  assert_eq(__conversion_count(captured.events), 0)
}

pipeline test_contradiction_conversion_needs_a_declared_oracle(harness: Harness, task: unknown) {
  // The clause the sibling conversion was also missing. A run on a downstream
  // host was accepted under this exact conversion with a reading of `passed`
  // whose command was empty, so the contradiction lost to a verifier that never
  // existed. The direction control sits beside it, because a conversion that
  // stops firing on real green verifiers is a retirement, not a fix.
  assert(
    !__completion_contradiction_arbitration_converts(
      "other",
      true,
      true,
      false,
      "verified_after_write",
      "passed",
    ),
    "an unnamed contradiction is not overruled by a pass no declared verifier produced",
  )
  assert(
    __completion_contradiction_arbitration_converts(
      "other",
      true,
      true,
      true,
      "verified_after_write",
      "passed",
    ),
    "but a declared verifier that passed still overrules it after the re-ask",
  )
}

// -------------------------------------------------------------------------------------------------

// harn#8193 and the code-explore judge-cap cells. The re-ask half above landed;
// the ACTOR-facing half did not. This file's own preamble names the symptom —
// "the actor was handed the judge's own 'the work is finished' text as its next
// step" — and then pins only the re-ask and the arbitration. These three close
// the gap the preamble described.

// -------------------------------------------------------------------------------------------------

/** Every `verify_completion` feedback string the loop actually injected. */
fn __verify_feedback(events: unknown) -> list<string> {
  return events.filter(
    { event -> event.type == "feedback_injected" && event?.kind == "verify_completion" },
  )
    .map({ event -> to_string(event?.content ?? "") })
    .to_list()
}

/** Every canonical judge decision, in order. */
fn __judge_decisions(events: unknown) {
  return events.filter({ event -> event.type == "judge_decision" }).to_list()
}

pipeline test_a_vetoed_done_is_not_told_it_is_done(harness: Harness, task: unknown) {
  // THE FALSIFIER, from the archived code-explore cells. A named gap survives
  // its re-ask, so the refusal stands and the actor is fed. What it must not be
  // fed is the judge's own rationale for finishing, which is what the loop sent
  // on five consecutive iterations: the same sentence each time, indistinguish-
  // able from an approval, one tool call across seven turns, cap reached.
  const captured = __run(
    harness,
    "contradiction-feedback-names-the-condition",
    [
      llm_done(),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  const feedback = __verify_feedback(captured.events)
  assert(len(feedback) >= 1, "a standing refusal must feed the actor something")
  // The falsifier proper. Before the fix EVERY one of these was the judge's own
  // rationale for finishing; the assertion is over all of them because one
  // surviving copy is enough to tell the actor it is done.
  for message in feedback {
    assert(
      !contains(message, "The required verifier passed all 3 tests"),
      "the veto handed back the judge's own DONE rationale, so it reads as an "
        + "approval and the actor has nothing to act on: "
        + message,
    )
  }
  // And the veto has to actually say what is unmet, not merely avoid saying the
  // wrong thing. Scoped to at least one message because the loop also injects
  // feedback on paths this fix does not own.
  assert(
    len(feedback.filter({ message -> contains(message, "outstanding gap") }).to_list()) >= 1,
    "no injected feedback named the condition the veto found unmet: "
      + json_stringify(feedback),
  )
}

pipeline test_the_veto_feedback_is_not_merely_suppressed(harness: Harness, task: unknown) {
  // THE DIRECTION CONTROL. Emitting nothing would satisfy the assertions above
  // by removing the evidence rather than fixing it, and a silent veto is the
  // same non-advancing loop with less to read. Every refusal still speaks.
  const captured = __run(
    harness,
    "contradiction-feedback-not-suppressed",
    [
      llm_done(),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  for message in __verify_feedback(captured.events) {
    assert(trim(message) != "", "a refusal that says nothing cannot advance the loop either")
  }
}

pipeline test_an_override_does_not_wear_the_judges_name(harness: Harness, task: unknown) {
  // harn#8193. The record used to report `source: "llm"` on a verdict the model
  // never gave, and carried no field holding what it did give. One archived cell
  // reported the judge's final verdict as `done` while all five of its canonical
  // decisions read `continue`.
  const captured = __run(
    harness,
    "override-names-its-author",
    [
      llm_done(),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      __judge_done_with_gap("unresolved_authorization"),
      llm_done(),
    ],
    {verify_completion: __gate_reporting(true, "verified", "passed")},
  )
  // Only the model judge's decisions carry the pair. The deterministic gate
  // also emits a `judge_decision`, with `source: "deterministic"` and no judge
  // answer of its own, and reading that row as an override is how this test
  // failed the first time I wrote it.
  const decisions = __judge_decisions(captured.events).filter(
    { decision -> decision?.judge_verdict != nil },
  )
    .to_list()
  assert(len(decisions) >= 1, "the model judge must have been asked at least once")
  let saw_override = false
  for decision in decisions {
    if decision?.verdict != decision?.judge_verdict {
      saw_override = true
      assert_eq(decision?.judge_verdict, "done")
      assert_eq(decision?.verdict, "continue")
      assert_eq(
        decision?.source,
        "gate",
        "an overridden verdict must name the gate as its author, not the model",
      )
      assert_eq(decision?.override?.party, "gate")
      assert_eq(decision?.override?.rule, "completion_judge_gap_contradicts_done")
    } else {
      assert_eq(
        decision?.source,
        "llm",
        "a verdict the judge actually gave must still be sourced to the judge",
      )
    }
  }
  assert(saw_override, "this fixture must actually exercise an override, or it proves nothing")
}
