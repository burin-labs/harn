import { crystallization_curate } from "std/agent/crystallization_curator"
import { llm_tool_call, with_llm_script, with_temp_dir } from "std/testing"

fn curate_with(harness: Harness, root: string, script: list, extra: dict) -> dict {
  const evidence = [
    {
      id: "run-one",
      session_id: "",
      prompt: "Verify the widget package",
      tool_sequence: ["run"],
      observed_at: "2026-08-13T12:00:00Z",
    },
  ]
  return with_llm_script(
    harness.llm,
    script,
    { ->
      crystallization_curate(
        harness,
        {
          project_root: root,
          memory_root: path_join(root, "memory"),
          session_store_root: root,
          evidence: evidence,
          now: "2026-08-13T12:05:00Z",
          agent: {provider: "mock", model: "mock", tool_format: "native", max_iterations: 2},
        }
          + extra,
      )
    },
  )
}

/** A review with no newly imported session evidence makes no model call. */
pipeline test_curator_skips_without_new_evidence(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const result = curate_with(
        harness,
        root,
        [
          llm_tool_call("submit_crystallization_batch", {proposals: []})
            + {input_tokens: 900, output_tokens: 40, simulated_cost_usd: 0.01},
        ],
        {require_new_evidence: true},
      )
      assert_eq(result.status, "no_new_evidence")
      assert_eq(result?.usage, nil, "no model call was made")
      return nil
    },
  )
}

/** A proposal that matches an installed capability is not staged again. */
pipeline test_curator_drops_a_proposal_matching_an_installed_capability(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      const skill = {
        kind: "skill",
        name: "verify-widget",
        title: "Verify Widget",
        description: "Run the widget checks.",
        when_to_use: "Before merging widget changes.",
        body: "# Verify Widget\n\nRun the checks.",
        evidence_ids: ["run-one"],
      }
      const result = curate_with(
        harness,
        root,
        [llm_tool_call("submit_crystallization_batch", {proposals: [skill]})],
        {installed: [{name: "verify-widget", verify_command: "make check"}]},
      )
      assert_eq(result.proposal_count, 0, "the installed capability is not proposed again")
      const fresh = curate_with(
        harness,
        root,
        [
          llm_tool_call(
            "submit_crystallization_batch",
            {proposals: [skill + {name: "lint-widget"}]},
          ),
        ],
        {installed: [{name: "verify-widget", verify_command: "make check"}]},
      )
      assert_eq(fresh.proposal_count, 1, "a new capability is still staged")
      return nil
    },
  )
}
