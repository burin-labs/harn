// Run: harn test tests/agent/equivalent_failover_test.harn
import { agent_loop } from "std/agent/loop"
import { omit } from "std/json"

fn run_with_options(harness: Harness, key: string, options: dict) {
  const observed = harness.runtime.shared_cell({scope: "task_group", key: key, initial: {}})
  const caller = { call ->
    harness.runtime.shared_set(observed, call.opts)
    return {ok: true, value: {text: "DONE", tool_calls: [], provider: "mock", model: "model"}}
  }
  agent_loop(
    harness,
    "finish",
    nil,
    options
      + {
        provider: "mock",
        model: "model",
        llm_caller: caller,
        loop_until_done: true,
        done_sentinel: "DONE",
        max_iterations: 1,
      },
  )
  return omit(harness.runtime.shared_get(observed), ["messages"])
}

pipeline test_agent_loop_enables_equivalent_failover_on_primary(harness: Harness) {
  const opts = run_with_options(harness, "equivalent-primary", {})
  assert_eq(opts.equivalent_failover, {max_routes: 3, on_no_dispatch: true})
}

pipeline test_agent_loop_preserves_equivalent_failover_opt_out(harness: Harness) {
  const opts = run_with_options(harness, "equivalent-opt-out", {equivalent_failover: false})
  assert_eq(opts.equivalent_failover, false)
}

pipeline test_agent_loop_preserves_explicit_route_owner(harness: Harness) {
  const opts = run_with_options(
    harness,
    "equivalent-route-owner",
    {fallback_chain: ["backup:model"]},
  )
  assert_eq(opts?.equivalent_failover, nil)
  assert_eq(opts.fallback_chain, ["backup:model"])
}
