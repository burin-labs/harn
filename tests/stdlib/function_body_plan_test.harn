import { edit_replace_function_body } from "std/edit"

pipeline test_literal_safety_body_refuses_multiline_tokens(harness: Harness) {
  for example in [
    {
      language: "javascript",
      source: "function target() { return 'old'; }\n",
      body: "return `first\nsecond`;",
    },
    {
      language: "python",
      source: "def target():\n    return 'old'\n",
      body: "return \"\"\"first\nsecond\"\"\"",
    },
    {
      language: "rust",
      source: "fn target() -> &'static str { \"old\" }\n",
      body: "r#\"first\nsecond\"#",
    },
    {
      language: "kotlin",
      source: "fun target(): String { return \"old\" }\n",
      body: "return \"\"\"first\nsecond\"\"\"",
    },
  ] {
    const result = edit_replace_function_body(
      harness.ast,
      {
        source: example.source,
        language: example.language,
        function_name: "target",
        new_body: example.body,
      },
    )
    assert_eq(result.result, "body_unavailable", example.language)
    const escaped_body = example.body.replace("\n", "\\n")
    const single_line = edit_replace_function_body(
      harness.ast,
      {
        source: example.source,
        language: example.language,
        function_name: "target",
        new_body: escaped_body,
      },
    )
    assert_eq(single_line.result, "replaced", example.language)
    assert(single_line.source.contains(escaped_body), example.language)
  }
}

pipeline test_body_plan_preserves_surroundings(harness: Harness) {
  for example in [
    {
      language: "kotlin",
      before: "class Calc {\n    fun target(): Int {\n        return 1\n    }\n}\n",
      body: "return 2",
      after: "class Calc {\n    fun target(): Int {\n        return 2\n    }\n}\n",
    },
    {
      language: "rust",
      before: "// café\nfn target() -> i32 { 1 }\nfn keep() {}\n",
      body: "2",
      after: "// café\nfn target() -> i32 {\n    2\n}\nfn keep() {}\n",
    },
    {
      language: "python",
      before: "# café\ndef target():\n    return 1\n\ndef keep():\n    pass\n",
      body: "    value = 2\n    return value",
      after: "# café\ndef target():\n    value = 2\n    return value\n\ndef keep():\n    pass\n",
    },
    {
      language: "javascript",
      before: "function target() { return 1; }\n",
      body: "function target() { return 2; }",
      after: "function target() {\n    return 2; \n}\n",
    },
  ] {
    const result = edit_replace_function_body(
      harness.ast,
      {
        source: example.before,
        language: example.language,
        function_name: "target",
        new_body: example.body,
      },
    )
    assert_eq(result.result, "replaced")
    assert_eq(result.source, example.after)
    assert_eq(result.health.coverage, "verified")
  }
}

pipeline test_body_plan_refuses_unsafe_structure(harness: Harness) {
  const declarations = edit_replace_function_body(
    harness.ast,
    {
      source: "const first = () => { return 1; }, target = () => { return 2; };",
      language: "javascript",
      function_name: "target",
      new_body: "return 3;",
    },
  )
  assert_eq(declarations.result, "replaced")
  assert(declarations.source.contains("first = () => { return 1; }"))
  assert(declarations.source.contains("return 3;"))
  const duplicate = edit_replace_function_body(
    harness.ast,
    {
      source: "fn target() {}\nfn target() {}",
      language: "rust",
      function_name: "target",
      new_body: "2",
    },
  )
  assert_eq(duplicate.result, "ambiguous")
  const unsupported = edit_replace_function_body(
    harness.ast,
    {
      source: "unknown syntax",
      language: "unsupported_language",
      function_name: "target",
      new_body: "replacement",
    },
  )
  assert_eq(unsupported.result, "unsupported_language")
  assert_eq(unsupported.health.coverage, "unavailable")
  const broken = edit_replace_function_body(
    harness.ast,
    {source: "fn target() {", language: "rust", function_name: "target", new_body: "2"},
  )
  assert_eq(broken.result, "parser_not_verified")
  const empty = edit_replace_function_body(
    harness.ast,
    {source: "fn target() {}", language: "rust", function_name: "target", new_body: ""},
  )
  assert_eq(empty.result, "body_unavailable")
}

pipeline test_body_plan_qualified_target_is_not_a_nested_namesake(harness: Harness) {
  const source =
    "class Outer:\n    class Inner:\n        def target(self):\n            return 1\n    def target(self):\n        return 2\n"
  const result = edit_replace_function_body(
    harness.ast,
    {source: source, language: "python", function_name: "Outer.target", new_body: "return 3"},
  )
  assert_eq(result.result, "replaced")
  assert_eq(
    result.source,
    "class Outer:\n    class Inner:\n        def target(self):\n            return 1\n    def target(self):\n        return 3\n",
  )
}
