import {
  CompletionBehaviorCheck,
  CompletionBehaviorTarget,
  completion_behavior_run_check,
} from "std/agent/completion_behavior_evidence"
import {
  agent_completion_gate,
  agent_completion_gate_preview,
  agent_completion_gate_veto_counts,
  completion_gate_verdict,
} from "std/agent/completion_gate"
import { agent_loop } from "std/agent/loop"
import { command_run } from "std/command"
import {
  edit_apply_old_new_patch,
  edit_nearest_anchor_blocks,
  edit_patch_growth_risk,
  edit_strip_line_number_prefixes,
  edit_whitespace_change_is_rejectable,
} from "std/edit"
import { git_status } from "std/git"
import { llm_text, llm_tool_call, with_llm_script, with_temp_dir } from "std/testing"
import { VerificationInputState } from "std/verification"

pipeline test_literal_safety_context_preserves_unmatched_line_bytes(harness: Harness) {
  const source = "distinctive_value = 1; preserve_side_effect()\nkeep_other_line()"
  const refused = edit_apply_old_new_patch(
    source,
    "distinctive_value = 1  ",
    "next_value = 2",
    {match: "conservative"},
  )
  assert_eq(refused.ok, false)
  assert_eq(refused.patched, source)
  const exact = edit_apply_old_new_patch(
    source,
    "distinctive_value = 1",
    "next_value = 2",
    {match: "conservative"},
  )
  assert(exact.ok)
  assert_eq(exact.patched, "next_value = 2; preserve_side_effect()\nkeep_other_line()")
}

pipeline test_large_content_preserving_patch(harness: Harness) {
  let lines: list<string> = []
  let index = 0
  while index < 900 {
    lines.push("// added ${index}")
    index += 1
  }
  const anchor = "// line 98\n// line 99"
  const replacement = "${anchor}\n${join(lines, "\n")}"
  const source = "// original\n${anchor}"
  const patch = edit_apply_old_new_patch(source, anchor, replacement)
  assert(patch.ok, patch.message)
  assert_eq(patch.patched, "// original\n${replacement}")
}

pipeline test_changed_paths_include_new_files_in_new_directories(harness: Harness) {
  with_temp_dir(
    harness.fs,
    { root ->
      assert(command_run(harness.tools, {argv: ["git", "init", "--quiet", root]}).success)
      harness.fs.mkdir(path_join(root, "new directory"), true)
      harness.fs.write_text(path_join(root, "new directory", "created.py"), "value = 1\n")
      const status = git_status(harness.process, root)
      assert(status.success)
      assert(status.data.entries.any({ entry -> entry.path == "new directory/created.py" }))
      return nil
    },
  )
}

pipeline test_pending_requirements_preserve_verification_escalation(harness: Harness) {
  const verdict = agent_completion_gate_preview(
    harness.runtime,
    {},
    {
      facts: fn(_ctx) { return {
        source_write_count: 1,
        verify: {ok: false, command: "check", findings: "broken calculation"},
        consecutive_failed_after_write: 3,
        requirement_contract: {requirements: [{requirement_id: "output", name: "Output exists"}]},
        requirement_assessments: [],
        requirement_evidence: [],
      } },
    },
  )
  assert_eq(verdict.confirm, false)
  assert_eq(verdict.reason, "requirements_unmet")
  assert_eq(verdict.requirement_report.pending_count, 1)
  assert_eq(verdict.escalation_recommended, true)
  assert(verdict.message.contains("broken calculation"))
}

pipeline test_completion_evidence(harness: Harness) {
  const facts = {source_write_count: 1, verify: {ok: true}, requires_write: true}
  assert(completion_gate_verdict(facts).ok == true)
  assert(
    completion_gate_verdict(facts + {verification_current: false}).reason == "stale_verification",
  )
  assert(completion_gate_verdict(facts + {verification_discriminates: false}).ok == false)
  assert(completion_gate_verdict(facts + {observed_failure_required: true}).ok == false)
  assert(
    completion_gate_verdict(facts + {observed_failure_required: true, observed_failure: true}).ok
      == true,
  )
  assert(completion_gate_verdict({source_write_count: 1, oracle_expected: true}).ok == false)
  assert(completion_gate_verdict({source_write_count: 0, requires_write: false}).ok == true)
  assert(
    completion_gate_verdict({source_write_count: 0, requires_write: false, oracle_expected: true})
      .ok
      == false,
  )
  assert(
    completion_gate_verdict(facts + {verifier_available: false}).reason == "verifier_unavailable",
  )
}

pipeline test_untyped_refactor_remains_strict(harness: Harness) {
  if harness.system.platform().os == "windows" {
    skip("the real verification control uses a POSIX shell")
  }
  with_temp_dir(
    harness.fs,
    { root ->
      const source = path_join(root, "calc.sh")
      const sid = "refactor-strict-${harness.random.uuid()}"
      const verified_key = "refactor-strict.verify.${sid}"
      const check = {argv: ["sh", "-c", "test \"$(sh calc.sh)\" = 3"], cwd: root}
      harness.fs.write_text(source, "printf '3\\n'\n")
      const before = command_run(harness.tools, check)
      assert(before.success, "the real verifier must pass before the refactor")
      const tools = tool_define(
        tool_registry(),
        "refactor",
        "Change the source while preserving its output",
        {
          parameters: {},
          returns: {type: "string"},
          annotations: {kind: "write"},
          handler: { _ ->
            harness.fs.write_text(source, "printf '%s\\n' 3\n")
            const after = command_run(harness.tools, check)
            harness.runtime.store_set(verified_key, after.success)
            return "refactor and verification reached"
          },
        },
      )
      const gate = agent_completion_gate(
        harness.runtime,
        {
          max_vetoes: 1,
          exhaustion: "stop_unverified",
          facts: fn(_ctx) { return {
            source_write_count: 1,
            verify: {ok: harness.runtime.store_get(verified_key) == true, command: "check calc"},
            verification_current: true,
            verification_discriminates: false,
          } },
        },
      )
      with_llm_script(
        harness.llm,
        [
          llm_tool_call("refactor", {}),
          llm_text("<user_response>Done.</user_response>\n<done>##DONE##</done>"),
          llm_text("<user_response>Done.</user_response>\n<done>##DONE##</done>"),
        ],
        { ->
          const result = agent_loop(
            harness,
            "Refactor calc.sh while preserving its behavior",
            nil,
            {
              provider: "mock",
              model: "mock",
              session_id: sid,
              root: root,
              tools: tools,
              tool_format: "native",
              loop_until_done: true,
              max_iterations: 4,
              max_nudges: 10,
            }
              + gate,
          )
          assert_eq(len(result.tools.successful), 1, "the actual refactor tool must run")
          assert_eq(harness.runtime.store_get(verified_key), true, "the after-check must pass")
          assert(result.status != "done", "untyped intent must retain the strict veto")
          assert(
            agent_completion_gate_veto_counts(harness.runtime, sid).by_class
              .non_discriminating_verification
              > 0,
            "the pre-work green must reach the non-discriminating veto",
          )
        },
      )
    },
  )
}

pipeline test_bound_preserving_refactor_completes(harness: Harness) {
  if harness.system.platform().os == "windows" {
    skip("the real verification control uses a POSIX shell")
  }
  with_temp_dir(
    harness.fs,
    { root ->
      const source = path_join(root, "calc.sh")
      const revision = path_join(root, "revision")
      const sid = harness.agent.open(
        "refactor-bound-${harness.random.uuid()}",
        {workspace_anchor: {primary: root}},
      )
      const after_key = "refactor-bound.after.${sid}"
      const command = "test \"$(sh calc.sh)\" = 3"
      const check = {mode: "shell", command: command, cwd: root}
      const target = { ->
        const current: CompletionBehaviorTarget = {
          identity: "calc.sh",
          digest: sha256(harness.fs.read_text(source)),
        }
        return current
      }
      const reuse = {
        scope: "refactor-bound/${sid}",
        inputs: { ->
          const current: VerificationInputState = {
            revision: to_int(harness.fs.read_text(revision)) ?? -1,
            workspace: root,
            source: sha256(harness.fs.read_text(source)),
            dependencies: "none",
            environment: "fixture",
          }
          return current
        },
        accept: { result -> result.success },
      }
      const verify_options = {record: false, reuse: reuse}
      const loop_options = {
        provider: "mock",
        model: "mock",
        session_id: sid,
        root: root,
        tool_format: "native",
        loop_until_done: true,
        max_iterations: 4,
        max_nudges: 10,
      }
      harness.fs.write_text(source, "printf '3\\n'\n")
      harness.fs.write_text(revision, "0")
      const other_sid = harness.agent.open(
        "refactor-other-${harness.random.uuid()}",
        {workspace_anchor: {primary: root}},
      )
      harness.agent.with_run(
        other_sid,
        loop_options + {session_id: other_sid},
        { ->
          harness.agent.set_goal(
            other_sid,
            {
              spec: {
                objective: "Refactor calc.sh while preserving behavior",
                success_criteria: [],
                retired_criteria: [],
                constraints: [],
                budget: {},
              },
              metadata: {
                acceptance_note: "",
                criterion_sources: {},
                verification: {command: command, source: "test"},
                target: "calc.sh",
                source: "test",
              },
            },
          )
        },
      )
      harness.agent.with_run(
        sid,
        loop_options,
        { ->
          harness.agent.set_goal(
            sid,
            {
              spec: {
                objective: "Refactor calc.sh while preserving behavior",
                success_criteria: [],
                retired_criteria: [],
                constraints: [],
                budget: {},
              },
              metadata: {
                acceptance_note: "",
                criterion_sources: {},
                verification: {command: command, source: "test"},
                target: "calc.sh",
                source: "test",
              },
            },
          )
          const wrong_goal = completion_behavior_run_check(
            harness,
            sid,
            other_sid,
            target,
            "calc",
            check,
            verify_options + {reuse: reuse + {scope: "other-goal/${sid}"}},
          )
          assert(
            wrong_goal.check.result.success && wrong_goal.behavior_check == nil,
            "a passing verifier from an unrelated goal session must not bind",
          )
          with_temp_dir(
            harness.fs,
            { other ->
              harness.fs.write_text(path_join(other, "calc.sh"), "printf '3\\n'\n")
              const wrong_workspace = completion_behavior_run_check(
                harness,
                sid,
                sid,
                target,
                "calc",
                {mode: "shell", command: command, cwd: other},
                verify_options,
              )
              assert(
                wrong_workspace.check.result.success,
                "the outside verifier must actually pass",
              )
              assert_eq(
                wrong_workspace.behavior_check,
                nil,
                "a verifier outside the session workspace must not bind",
              )
              const anchor = harness.agent.workspace_anchor(sid)
              harness.agent.set_workspace_anchor(
                sid,
                {primary: root, additional_roots: [{path: other, mount_mode: "extend"}]},
              )
              const mounted = completion_behavior_run_check(
                harness,
                sid,
                sid,
                target,
                "calc",
                {mode: "shell", command: command, cwd: other},
                verify_options + {reuse: reuse + {scope: "mounted-root/${sid}"}},
              )
              assert(
                mounted.check.result.success && mounted.behavior_check != nil,
                "the same verifier must bind when the directory is mounted",
              )
              harness.agent.set_workspace_anchor(sid, anchor)
            },
          )
          const unrelated = completion_behavior_run_check(
            harness,
            sid,
            sid,
            target,
            "calc",
            {mode: "shell", command: "true", cwd: root},
            verify_options,
          )
          assert(unrelated.check.result.success && unrelated.behavior_check == nil)
          const before = completion_behavior_run_check(
            harness,
            sid,
            sid,
            target,
            "calc",
            check,
            verify_options,
          )
          assert(before.check.result.success && before.behavior_check != nil)
          const baseline = schema_expect(before.behavior_check, schema_of(CompletionBehaviorCheck))
          const tools = tool_define(
            tool_registry(),
            "refactor",
            "Change the source while preserving its output",
            {
              parameters: {},
              returns: {type: "string"},
              annotations: {kind: "write"},
              handler: { _ ->
                harness.fs.write_text(source, "printf '%s\\n' 3\n")
                harness.fs.write_text(revision, "1")
                const after = completion_behavior_run_check(
                  harness,
                  sid,
                  sid,
                  target,
                  "calc",
                  check,
                  verify_options,
                )
                assert(after.check.result.success && after.behavior_check != nil)
                harness.runtime.store_set(after_key, after.behavior_check)
                return "refactor and verification reached"
              },
            },
          )
          const options = {
            facts: fn(_ctx) { return {
              source_write_count: 1,
              verify: {ok: true, command: command},
              verification_current: true,
              verification_discriminates: false,
            } },
            behavior_evidence: { _ctx ->
              const stored = harness.runtime.store_get(after_key)
              if stored == nil {
                return nil
              }
              const after = schema_expect(stored, schema_of(CompletionBehaviorCheck))
              return {
                agent: harness.agent,
                active_goal_id: sid,
                intent: "behavior_preserving",
                before: before.behavior_check,
                after: after,
                reuse: reuse,
                target: target,
              }
            },
          }
          with_llm_script(
            harness.llm,
            [
              llm_tool_call("refactor", {}),
              llm_text("<user_response>Done.</user_response>\n<done>##DONE##</done>"),
            ],
            { ->
              const result = agent_loop(
                harness,
                "Refactor calc.sh while preserving behavior",
                nil,
                loop_options + {tools: tools} + agent_completion_gate(harness.runtime, options),
              )
              assert_eq(len(result.tools.successful), 1, "the real refactor tool must run")
              assert_eq(result.status, "done", "the bound preserving refactor must complete")
            },
          )
          const accepted = agent_completion_gate_preview(
            harness.runtime,
            {session_id: sid},
            options,
          )
          assert(accepted.confirm, "the same evidence must be accepted by the preview")
          assert_eq(accepted.verification.observed, "passed")
          const callback_verifier = agent_completion_gate_preview(
            harness.runtime,
            {session_id: sid},
            options
              + {
                facts: fn(_ctx) { return {
                  source_write_count: 1,
                  verification_current: true,
                  verification_discriminates: false,
                } },
                verify_command: fn() { return {ok: true, command: command} },
              },
          )
          assert(callback_verifier.confirm, "the verifier callback must use the same decision")
          assert_eq(callback_verifier.verification.observed, "passed")
          const wrong_command = agent_completion_gate_preview(
            harness.runtime,
            {session_id: sid},
            options
              + {
                facts: fn(_ctx) { return {
                  source_write_count: 1,
                  verify: {ok: true, command: "different check"},
                  verification_current: true,
                  verification_discriminates: false,
                } },
              },
          )
          assert_eq(wrong_command.confirm, false, "an unrelated verifier cannot use this evidence")
          const saved_after = schema_expect(
            harness.runtime.store_get(after_key),
            schema_of(CompletionBehaviorCheck),
          )
          const unrelated_source = path_join(root, "unrelated.sh")
          const unrelated_revision = path_join(root, "unrelated-revision")
          harness.fs.write_text(unrelated_source, "before\n")
          harness.fs.write_text(unrelated_revision, "0")
          const broad_reuse = reuse
            + {
              scope: "unrelated-change/${sid}",
              inputs: { ->
                const current: VerificationInputState = {
                  revision: to_int(harness.fs.read_text(unrelated_revision)) ?? -1,
                  workspace: root,
                  source: sha256(
                    harness.fs.read_text(source) + harness.fs.read_text(unrelated_source),
                  ),
                  dependencies: "none",
                  environment: "fixture",
                }
                return current
              },
            }
          const broad_before = completion_behavior_run_check(
            harness,
            sid,
            sid,
            target,
            "calc",
            check,
            verify_options + {reuse: broad_reuse},
          )
          harness.fs.write_text(unrelated_source, "after\n")
          harness.fs.write_text(unrelated_revision, "1")
          const broad_after = completion_behavior_run_check(
            harness,
            sid,
            sid,
            target,
            "calc",
            check,
            verify_options + {reuse: broad_reuse},
          )
          assert(broad_before.check.result.success && broad_after.check.result.success)
          const unrelated_change = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: broad_before.behavior_check,
                  after: broad_after.behavior_check,
                  reuse: broad_reuse,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, unrelated_change)
              .confirm,
            false,
            "an unrelated source change must not stand in for the requested target edit",
          )
          const unrelated_target = { ->
            const current: CompletionBehaviorTarget = {
              identity: "unrelated.sh",
              digest: sha256(harness.fs.read_text(unrelated_source)),
            }
            return current
          }
          const wrong_reuse = broad_reuse + {scope: "wrong-target/${sid}"}
          const unrelated_before = completion_behavior_run_check(
            harness,
            sid,
            sid,
            unrelated_target,
            "calc",
            check,
            verify_options + {reuse: wrong_reuse},
          )
          harness.fs.write_text(unrelated_source, "after again\n")
          harness.fs.write_text(unrelated_revision, "2")
          const unrelated_after = completion_behavior_run_check(
            harness,
            sid,
            sid,
            unrelated_target,
            "calc",
            check,
            verify_options + {reuse: wrong_reuse},
          )
          assert(unrelated_before.check.result.success && unrelated_after.check.result.success)
          assert_eq(unrelated_before.check.execution, "executed")
          assert_eq(unrelated_after.check.execution, "executed")
          assert(unrelated_before.behavior_check == nil && unrelated_after.behavior_check == nil)
          const wrong_target = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: unrelated_before.behavior_check,
                  after: unrelated_after.behavior_check,
                  reuse: wrong_reuse,
                  target: unrelated_target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, wrong_target).confirm,
            false,
            "a changed file outside the goal's declared target cannot grant completion",
          )
          const missing_target = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: before.behavior_check,
                  after: saved_after,
                  reuse: reuse,
                  target: { -> nil },
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, missing_target)
              .confirm,
            false,
            "an unresolved requested target must remain strict",
          )
          const replaced_target = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: before.behavior_check,
                  after: saved_after,
                  reuse: reuse,
                  target: { ->
                    {identity: "unrelated.sh", digest: sha256(harness.fs.read_text(source))}
                  },
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, replaced_target)
              .confirm,
            false,
            "a changed target identity must retire earlier evidence",
          )
          const cross_session = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: other_sid,
                  intent: "behavior_preserving",
                  before: baseline + {goal_id: other_sid},
                  after: saved_after + {goal_id: other_sid},
                  reuse: reuse,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, cross_session)
              .confirm,
            false,
            "matching evidence from an unassociated goal session cannot complete this run",
          )
          const wrong_active_goal = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: other_sid,
                  intent: "behavior_preserving",
                  before: before.behavior_check,
                  after: saved_after,
                  reuse: reuse,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, wrong_active_goal)
              .confirm,
            false,
            "evidence for a different active goal must not complete",
          )
          const wrong_baseline_goal = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: baseline + {goal_id: other_sid},
                  after: saved_after,
                  reuse: reuse,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, wrong_baseline_goal)
              .confirm,
            false,
            "a baseline captured for a different goal must not complete",
          )
          const missing_before = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: nil,
                  after: saved_after,
                  reuse: reuse,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, missing_before)
              .confirm,
            false,
            "a missing baseline must retain the strict veto",
          )
          const unreadable = reuse
            + {
              inputs: { ->
                throw "workspace input unavailable"
              },
            }
          const unreadable_options = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: before.behavior_check,
                  after: saved_after,
                  reuse: unreadable,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, unreadable_options)
              .confirm,
            false,
            "unreadable workspace input must retain the strict veto",
          )
          const unchanged = options
            + {
              behavior_evidence: { _ctx ->
                {
                  agent: harness.agent,
                  active_goal_id: sid,
                  intent: "behavior_preserving",
                  before: saved_after,
                  after: saved_after,
                  reuse: reuse,
                  target: target,
                }
              },
            }
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, unchanged).confirm,
            false,
            "one check cannot stand in for before and after source states",
          )
          for intent in ["behavior_change", "unknown"] {
            const strict_options = options
              + {
                behavior_evidence: { _ctx ->
                  {
                    agent: harness.agent,
                    active_goal_id: sid,
                    intent: intent,
                    before: before.behavior_check,
                    after: saved_after,
                    reuse: reuse,
                    target: target,
                  }
                },
              }
            const strict = agent_completion_gate_preview(
              harness.runtime,
              {session_id: sid},
              strict_options,
            )
            assert_eq(strict.confirm, false, "${intent} must remain strict")
            assert_eq(strict.verification.observed, "not_run")
          }
          const wrong_session = agent_completion_gate_preview(
            harness.runtime,
            {session_id: sid + "-other"},
            options,
          )
          assert_eq(wrong_session.confirm, false, "another session cannot use this evidence")
          const required_failure = agent_completion_gate_preview(
            harness.runtime,
            {session_id: sid},
            options
              + {
                facts: fn(_ctx) { return {
                  source_write_count: 1,
                  verify: {ok: true, command: command},
                  verification_current: true,
                  verification_discriminates: false,
                  observed_failure_required: true,
                  observed_failure: false,
                } },
              },
          )
          assert_eq(required_failure.reason, "required_failure_unobserved")
          harness.fs.write_text(source, "printf '%s\\n' changed\n")
          const external_change = agent_completion_gate_preview(
            harness.runtime,
            {session_id: sid},
            options,
          )
          assert_eq(
            external_change.confirm,
            false,
            "a changed source digest must invalidate even without an agent revision bump",
          )
          harness.fs.write_text(revision, "2")
          const stale = agent_completion_gate_preview(harness.runtime, {session_id: sid}, options)
          assert_eq(stale.confirm, false, "a post-verification edit must be refused")
          assert_eq(stale.reason, "non_discriminating_verification")
          harness.fs.write_text(source, "printf '3\\n'\n")
          harness.fs.write_text(revision, "3")
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, options).confirm,
            false,
            "reverting the source must not reuse the post-change verifier",
          )
          harness.fs.write_text(source, "printf '%s\\n' 3\n")
          harness.fs.write_text(revision, "4")
          const rechecked = completion_behavior_run_check(
            harness,
            sid,
            sid,
            target,
            "calc",
            check,
            verify_options,
          )
          assert(rechecked.behavior_check != nil, "restored source needs a fresh executed check")
          harness.runtime.store_set(after_key, rechecked.behavior_check)
          assert(agent_completion_gate_preview(harness.runtime, {session_id: sid}, options).confirm)
          const original_anchor = harness.agent.workspace_anchor(sid)
          harness.agent.with_run(
            sid,
            loop_options,
            { ->
              harness.agent.set_workspace_anchor(sid, {primary: root, anchored_at: "replacement"})
            },
          )
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, options).confirm,
            false,
            "a replaced workspace anchor must retire the evidence",
          )
          harness.agent.with_run(
            sid,
            loop_options,
            { -> harness.agent.set_workspace_anchor(sid, original_anchor) },
          )
          assert(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, options).confirm,
            "restoring the anchor isolates the goal replacement control",
          )
          harness.agent.with_run(
            sid,
            loop_options,
            { ->
              harness.agent.set_goal(
                sid,
                {
                  spec: {
                    objective: "Refactor calc.sh while preserving behavior",
                    success_criteria: [],
                    retired_criteria: [],
                    constraints: [],
                    budget: {},
                  },
                  metadata: {
                    acceptance_note: "",
                    criterion_sources: {},
                    verification: {command: command, source: "test"},
                    target: "calc.sh",
                    source: "test",
                  },
                },
              )
            },
          )
          assert_eq(
            agent_completion_gate_preview(harness.runtime, {session_id: sid}, options).confirm,
            false,
            "a replacement goal with identical wording must retire the evidence",
          )
        },
      )
      harness.agent.close(sid)
      harness.agent.close(other_sid)
    },
  )
}

pipeline test_unrun_command_survives_the_terminal_bound(harness: Harness) {
  const sid = "unrun-command-${harness.random.uuid()}"
  const gate = agent_completion_gate(
    harness.runtime,
    {
      max_vetoes: 1,
      exhaustion: "stop_unverified",
      facts: fn(_ctx) { return {
        source_write_count: 1,
        oracle_expected: true,
        verification_command: "project-check",
      } },
    },
  )
  const pending = gate.verify_completion({session_id: sid})
  assert_eq(pending.confirm, false)
  assert_eq(pending.verification.command, "project-check")
  assert_eq(pending.verification.observed, "not_run")
  const terminal = gate.verify_completion({session_id: sid})
  assert_eq(terminal.action, "stop_unverified")
  assert_eq(terminal.verification.command, "project-check")
  assert_eq(terminal.verification.observed, "not_run")
}

pipeline test_strict_verification_refusals_report_their_classes(harness: Harness) {
  for scenario in [
    {reason: "stale_verification", facts: {verification_current: false}},
    {reason: "non_discriminating_verification", facts: {verification_discriminates: false}},
    {reason: "required_failure_unobserved", facts: {observed_failure_required: true}},
  ] {
    const sid = "verification-class-${harness.random.uuid()}"
    const gate = agent_completion_gate(
      harness.runtime,
      {facts: fn(_ctx) { return {source_write_count: 1, verify: {ok: true}} + scenario.facts }},
    )
    const refusal = gate.verify_completion({session_id: sid})
    assert_eq(refusal.confirm, false)
    assert_eq(refusal.reason, scenario.reason)
    const counts = agent_completion_gate_veto_counts(harness.runtime, sid)
    assert_eq(counts.total, 1)
    assert_eq(counts.by_class[scenario.reason], 1)
  }
}

pipeline test_exhaustion_stops_actual_loop_unverified(harness: Harness) {
  const session_id = "bounded-completion-${harness.random.uuid()}"
  const options = {
    max_vetoes: 1,
    exhaustion: "stop_unverified",
    facts: fn(_ctx) { return {
      source_write_count: 1,
      verify: {ok: false, command: "check", findings: "broken"},
    } },
  }
  const preview = agent_completion_gate_preview(harness.runtime, {session_id: session_id}, options)
  assert(preview.confirm == false)
  assert(agent_completion_gate_veto_counts(harness.runtime, session_id).total == 0)
  with_llm_script(
    harness.llm,
    [
      llm_text("<user_response>Finished.</user_response>\n<done>##DONE##</done>"),
      llm_text("<user_response>Finished.</user_response>\n<done>##DONE##</done>"),
    ],
    fn() {
      const result = agent_loop(
        harness,
        "Repair the program",
        nil,
        {
          provider: "mock",
          session_id: session_id,
          loop_until_done: true,
          max_iterations: 4,
          max_nudges: 10,
        }
          + agent_completion_gate(harness.runtime, options),
      )
      assert(result.status != "done")
      assert(result.terminal.reason == "veto_budget_exhausted")
      assert(agent_completion_gate_veto_counts(harness.runtime, session_id).total == 1)
    },
  )
}

pipeline test_conservative_patch(harness: Harness) {
  const options = {match: "conservative", structural_min_nonblank_lines: 2}
  for quoted in ["\"a  b\"", "'a  b'", "`a  b`"] {
    const source = "const message = ${quoted}\nfinish_value()"
    const anchor = "const message = ${quoted.replace("a  b", "a b")}\nfinish_value()"
    assert_eq(edit_apply_old_new_patch(source, anchor, "replacement()", options).ok, false)
    assert_eq(edit_apply_old_new_patch(source, source, "replacement()", options).ok, true)
  }
  const source = "  first_value()\n\n  second_value()\n\nkeep()"
  const patch = edit_apply_old_new_patch(
    source,
    "first_value()\nsecond_value()",
    "replacement()",
    options,
  )
  assert(patch.ok)
  assert(patch.patched == "replacement()\n\nkeep()")
  assert(
    edit_apply_old_new_patch("wordvalue = 1\nwordvalue = 1", "wordvalue", "replacement", options)
      .error_code
      == "ambiguous_match",
  )
  assert(
    edit_apply_old_new_patch(
      "value = \"ab\"\nfinish_value()",
      "value = \"a b\"\nfinish_value()",
      "replacement",
      options,
    ).error_code
      == "no_match",
  )
  const context = edit_apply_old_new_patch(
    "  distinctive_value = 1",
    "distinctive_value = 1  ",
    "next_value = 2",
    options,
  )
  assert_eq(context.match_kind, "context")
  assert_eq(context.patched, "next_value = 2")
  assert(
    edit_strip_line_number_prefixes("1: first\n2\tsecond\n3    third") == "first\nsecond\nthird",
  )
  assert(edit_nearest_anchor_blocks("new_long_identifier()", "old new_long_identifier()") != "")
  assert(!edit_whitespace_change_is_rejectable("value = \"a b\"", "value = \"a  b\""))
  assert(!edit_whitespace_change_is_rejectable("const value = `a b`", "const value = `a  b`"))
  assert(edit_whitespace_change_is_rejectable("call_value()", " call_value()"))
  assert(!edit_whitespace_change_is_rejectable("call_value()", " call_value()", true))
  assert(
    !edit_patch_growth_risk(
      {before: "anchor", after: "anchor\nmore", old_text: "anchor", new_text: "anchor\nmore"},
    ),
  )
}

pipeline test_current_requirements_survive_retarget(harness: Harness) {
  const contract = {
    requirements: [{requirement_id: "current-output", name: "Current output exists"}],
  }
  const payload = {
    session_id: "current-contract-${harness.random.uuid()}",
    task: "Old objective",
    obligations: {
      original_task: "Old objective",
      steers: [],
      retarget: {control_id: "steer", message_id: "new-task", objective: "New objective"},
    },
  }
  const current = agent_completion_gate_preview(
    harness.runtime,
    payload,
    {
      facts: fn(_ctx) { return {
        source_write_count: 0,
        requires_write: false,
        requirement_contract: contract,
        requirement_assessments: [],
        requirement_evidence: [],
      } },
    },
  )
  assert_eq(current.confirm, false)
  assert_eq(current.requirement_report.pending_count, 1)
  assert_eq(current.requirement_report.pending_names, ["Current output exists"])
  const retired = agent_completion_gate_preview(
    harness.runtime,
    payload,
    {
      requirement_contract: contract,
      facts: fn(_ctx) { return {source_write_count: 0, requires_write: false} },
    },
  )
  assert_eq(retired.confirm, true)
  assert_eq(retired.requirement_report, nil)
}
