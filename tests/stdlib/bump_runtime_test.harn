// Run: harn test tests/stdlib/bump_runtime_test.harn
//
// In-process, no-network fixtures for the std/bump/runtime state machine.
// Each scenario injects a recording fake adapter and asserts on the returned
// receipt plus the side-effect calls the orchestrator made. There are no
// sleeps and no wall-clock assertions: readiness, leases, and auto-merge are
// all driven by adapter return values, never by elapsed time.
import {
  BumpAdapter,
  BumpOptions,
  BumpPrState,
  bump_changeset_empty,
  bump_is_current,
  bump_options,
  run_bump,
} from "std/bump/runtime"
import { assert_eq, assert_throws } from "std/testing"

/**
 * A recorder threads a mutable call log through the fake adapter so tests can
 * assert not just the receipt but the exact effect sequence (leased disarm,
 * atomic publication, PR upsert, auto-merge).
 */
fn make_fake(config = {}) {
  let calls = []
  const record = fn(name, arg) { calls = calls + [{name: name, arg: arg}] }
  const cfg = {
    target: "v0.10.30",
    ready: true,
    readiness_detail: "harn-cli 0.10.30 published; assets present; release finalized",
    current: "v0.10.29",
    apply_ok: true,
    apply_changed: true,
    refreshed: ["harn.lock"],
    validation_ok: true,
    validation_detail: "",
    additions: [".harn-version", "harn.lock"],
    deletions: [],
    existing_pr: nil,
    branch_matches: false,
    commit_oid: "c0ffee",
    auto_merge_enabled: true,
    disable_ok: true,
  }
    + config
  const adapter: BumpAdapter = {
    resolve_target_tag: fn(tag) { return if trim(tag ?? "") != "" {
      tag
    } else {
      cfg.target
    } },
    release_ready: fn(_target) { return {
      ready: cfg.ready,
      detail: cfg.readiness_detail,
      attempts: 1,
      attempt_lines: ["attempt 1: ${cfg.readiness_detail}"],
    } },
    read_current_version: fn() { return cfg.current },
    base_sha: fn() { return "base000" },
    apply_version: fn(_target) {
      record("apply_version", _target)
      return {
        ok: cfg.apply_ok,
        changed: cfg.apply_changed,
        refreshed: cfg.refreshed,
        detail: if cfg.apply_ok {
          ""
        } else {
          "repository refresh failed"
        },
      }
    },
    run_validation: fn() {
      record("run_validation", nil)
      return {
        ok: cfg.validation_ok,
        steps: [{name: "package-policy", ok: cfg.validation_ok, detail: cfg.validation_detail}],
        detail: cfg.validation_detail,
      }
    },
    working_changes: fn() { return {additions: cfg.additions, deletions: cfg.deletions} },
    find_bump_pr: fn() { return cfg.existing_pr },
    disable_auto_merge: fn(pr, base_sha) {
      record("disable_auto_merge", {pr: pr, base_sha: base_sha})
      return cfg.disable_ok
    },
    publish_commit: fn(request) {
      record("publish_commit", request)
      return {
        oid: cfg.commit_oid,
        url: "https://example.test/commit/${cfg.commit_oid}",
        branch_action: "reset",
      }
    },
    branch_matches_base: fn() { return cfg.branch_matches },
    upsert_pr: fn(existing, expected_head_oid) {
      record("upsert_pr", {existing: existing, expected_head_oid: expected_head_oid})
      const number = existing?.number ?? 4242
      return {
        number: number,
        head_oid: cfg.commit_oid,
        url: "https://example.test/pull/${number}",
        created: existing == nil,
      }
    },
    close_pr: fn(number, comment) {
      record("close_pr", {number: number, comment: comment})
      return true
    },
    enable_auto_merge: fn(number, head) {
      record("enable_auto_merge", {number: number, head: head})
      return {
        enabled: cfg.auto_merge_enabled,
        state: if cfg.auto_merge_enabled {
          "enabled"
        } else {
          "failed"
        },
        detail: "",
      }
    },
  }
  return {adapter: adapter, calls: fn() { return calls }}
}

fn call_names(calls) -> list<string> {
  return calls.map({ c -> c.name }).to_list()
}

fn opts(overrides = {}) -> BumpOptions {
  return bump_options({repo: "burin-labs/example"} + overrides)
}

pipeline test_pure_predicates_are_v_insensitive(harness: Harness, task) {
  assert_eq(bump_is_current("v0.10.30", "0.10.30"), true)
  assert_eq(bump_is_current("v0.10.29", "v0.10.30"), false)
  assert_eq(bump_is_current("", ""), false)
  assert_eq(bump_changeset_empty({additions: [], deletions: []}), true)
  assert_eq(bump_changeset_empty({additions: ["x"], deletions: []}), false)
}

/** 1. No-op: the pin already matches the target. Zero mutation. */
pipeline test_already_current_is_a_clean_noop(harness: Harness, task) {
  const fake = make_fake({current: "v0.10.30", target: "v0.10.30"})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "already_current")
  assert_eq(receipt.ok, true)
  assert_eq(call_names(fake.calls()), [])
}

/** 2. Delayed asset publication: readiness gate stops before any change. */
pipeline test_release_not_ready_stops_before_mutation(harness: Harness, task) {
  const fake = make_fake({ready: false, readiness_detail: "missing release assets: SHA256SUMS"})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "not_ready")
  assert_eq(receipt.ok, true)
  assert_eq(receipt.ready, false)
  assert_eq(receipt.readiness_detail, "missing release assets: SHA256SUMS")
  assert_eq(call_names(fake.calls()), [])
}

/**
 * 3. Lockfile regeneration flows through to a created PR with the refreshed
 * files recorded on the receipt.
 */
pipeline test_lockfile_refresh_produces_committed_pr(harness: Harness, task) {
  const fake = make_fake({refreshed: ["harn.lock", "generated/schema.json"]})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "committed")
  assert_eq(receipt.changed, true)
  assert_eq(receipt.refreshed, ["harn.lock", "generated/schema.json"])
  assert_eq(receipt.pr_action, "created")
  assert_eq(receipt.commit_oid, "c0ffee")
  assert_eq(
    call_names(fake.calls()),
    ["apply_version", "run_validation", "publish_commit", "upsert_pr", "enable_auto_merge"],
  )
}

/** 4. Refresh failure: fail closed before validation, commit, or PR mutation. */
pipeline test_refresh_failure_blocks_validation_and_commit(harness: Harness, task) {
  const fake = make_fake({apply_ok: false})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "refresh_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.refresh_ok, false)
  assert_eq(receipt.refresh_detail, "repository refresh failed")
  assert_eq(call_names(fake.calls()), ["apply_version"])
}

/** 5. Validation failure: no commit, no PR, ok=false. */
pipeline test_validation_failure_blocks_commit(harness: Harness, task) {
  const fake = make_fake({validation_ok: false, validation_detail: "harn check failed"})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "validation_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.validation.ok, false)
  assert_eq(call_names(fake.calls()), ["apply_version", "run_validation"])
}

/** Fleet repair opt-in publishes an exact lease but never arms auto-merge. */
pipeline test_validation_failure_can_publish_repair_pr_without_auto_merge(harness: Harness, task) {
  const fake = make_fake({validation_ok: false, validation_detail: "harn check failed"})
  const receipt = run_bump(opts({publish_failure_for_repair: true}), fake.adapter)
  assert_eq(receipt.outcome, "validation_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.validation.ok, false)
  assert_eq(receipt.pr_action, "created")
  assert_eq(receipt.pr_number, 4242)
  assert_eq(receipt.commit_oid, "c0ffee")
  assert_eq(receipt.auto_merge, nil)
  assert_eq(
    call_names(fake.calls()),
    ["apply_version", "run_validation", "publish_commit", "upsert_pr"],
  )
}

pipeline test_validation_failure_opt_in_does_not_publish_an_empty_delta(harness: Harness, task) {
  const fake = make_fake(
    {validation_ok: false, validation_detail: "harn check failed", additions: [], deletions: []},
  )
  const receipt = run_bump(opts({publish_failure_for_repair: true}), fake.adapter)
  assert_eq(receipt.outcome, "validation_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.pr_action, "none")
  assert_eq(call_names(fake.calls()), ["apply_version", "run_validation"])
}

pipeline test_validation_failure_opt_in_never_becomes_success_when_branch_matches_base(
  harness: Harness,
  task,
) {
  const fake = make_fake(
    {validation_ok: false, validation_detail: "harn check failed", branch_matches: true},
  )
  const receipt = run_bump(opts({publish_failure_for_repair: true}), fake.adapter)
  assert_eq(receipt.outcome, "validation_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.pr_action, "none")
  assert_eq(call_names(fake.calls()), ["apply_version", "run_validation", "publish_commit"])
}

pipeline test_refresh_failure_can_publish_repair_pr_without_validation_or_auto_merge(
  harness: Harness,
  task,
) {
  const fake = make_fake({apply_ok: false})
  const receipt = run_bump(opts({publish_failure_for_repair: true}), fake.adapter)
  assert_eq(receipt.outcome, "refresh_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.refresh_ok, false)
  assert_eq(receipt.validation.ok, true)
  assert_eq(receipt.pr_action, "created")
  assert_eq(receipt.pr_number, 4242)
  assert_eq(receipt.commit_oid, "c0ffee")
  assert_eq(receipt.auto_merge, nil)
  assert_eq(call_names(fake.calls()), ["apply_version", "publish_commit", "upsert_pr"])
}

pipeline test_refresh_failure_opt_in_does_not_publish_without_a_mutation(harness: Harness, task) {
  const fake = make_fake({apply_ok: false, apply_changed: false, additions: [], deletions: []})
  const receipt = run_bump(opts({publish_failure_for_repair: true}), fake.adapter)
  assert_eq(receipt.outcome, "refresh_failed")
  assert_eq(receipt.ok, false)
  assert_eq(receipt.pr_action, "none")
  assert_eq(call_names(fake.calls()), ["apply_version"])
}

/**
 * 6. Stale branch/PR lease: an open PR with auto-merge armed is disarmed
 * BEFORE the branch and signed commit are atomically published. Order matters.
 */
pipeline test_stale_lease_is_disarmed_before_publication(harness: Harness, task) {
  const stale: BumpPrState = {
    number: 71,
    head_oid: "stale99",
    base_ref: "main",
    base_oid: "base000",
    auto_merge_enabled: true,
    auto_merge_method: "SQUASH",
    url: "https://example.test/pull/71",
    state: "open",
  }
  const fake = make_fake({existing_pr: stale})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "committed")
  assert_eq(receipt.lease_recovered, true)
  assert_eq(receipt.pr_action, "refreshed")
  assert_eq(receipt.pr_number, 71)
  assert_eq(
    call_names(fake.calls()),
    [
      "apply_version",
      "run_validation",
      "disable_auto_merge",
      "publish_commit",
      "upsert_pr",
      "enable_auto_merge",
    ],
  )
}

pipeline test_failed_lease_disarm_stops_before_publication(harness: Harness, task) {
  const stale: BumpPrState = {
    number: 72,
    head_oid: "stale100",
    base_ref: "main",
    base_oid: "base000",
    auto_merge_enabled: true,
    auto_merge_method: "SQUASH",
    url: "https://example.test/pull/72",
    state: "open",
  }
  const fake = make_fake({existing_pr: stale, disable_ok: false})
  assert_eq(
    assert_throws({ -> run_bump(opts(), fake.adapter) }),
    "std/bump/runtime: failed to disable stale auto-merge on #72",
  )
  assert_eq(call_names(fake.calls()), ["apply_version", "run_validation", "disable_auto_merge"])
}

/**
 * 7. Existing PR refresh: an open PR without armed auto-merge is edited in
 * place, not recreated, and NOT disarmed.
 */
pipeline test_existing_pr_is_refreshed_in_place(harness: Harness, task) {
  const open: BumpPrState = {
    number: 88,
    head_oid: "old123",
    base_ref: "main",
    base_oid: "base000",
    auto_merge_enabled: false,
    auto_merge_method: nil,
    url: "https://example.test/pull/88",
    state: "open",
  }
  const fake = make_fake({existing_pr: open})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "committed")
  assert_eq(receipt.lease_recovered, false)
  assert_eq(receipt.pr_action, "refreshed")
  assert_eq(receipt.pr_number, 88)
  assert_eq(
    call_names(fake.calls()),
    ["apply_version", "run_validation", "publish_commit", "upsert_pr", "enable_auto_merge"],
  )
}

/** 8. Successful auto-merge: a fresh bump creates a PR and arms auto-merge. */
pipeline test_successful_bump_arms_auto_merge(harness: Harness, task) {
  const fake = make_fake({})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "committed")
  assert_eq(receipt.pr_action, "created")
  assert_eq(receipt.auto_merge?.enabled, true)
  const enable_calls = fake.calls().filter({ c -> c.name == "enable_auto_merge" }).to_list()
  assert_eq(len(enable_calls), 1)
  assert_eq(enable_calls[0].arg.number, 4242)
}

/**
 * Bonus: a refreshed branch whose tree matches base closes a stale PR instead
 * of opening an empty one — the concurrency-safe "someone already landed it"
 * path.
 */
pipeline test_branch_matching_base_closes_stale_pr(harness: Harness, task) {
  const stale: BumpPrState = {
    number: 12,
    head_oid: "x",
    base_ref: "main",
    base_oid: "base000",
    auto_merge_enabled: false,
    auto_merge_method: nil,
    url: "https://example.test/pull/12",
    state: "open",
  }
  const fake = make_fake({existing_pr: stale, branch_matches: true})
  const receipt = run_bump(opts(), fake.adapter)
  assert_eq(receipt.outcome, "closed_noop")
  assert_eq(receipt.pr_action, "closed")
  assert_eq(
    call_names(fake.calls()),
    ["apply_version", "run_validation", "publish_commit", "close_pr"],
  )
}
