import { live_bump_adapter } from "std/bump/live"

pipeline test_apply_version_writes_bare_semver() {
  const root = path_join(harness.fs.temp_dir(), "harn-bump-live-" + uuid())
  harness.fs.mkdir(root)
  const version_file = path_join(root, ".harn-version")
  const adapter = live_bump_adapter({version_file: version_file, refresh_command: "true"})
  adapter.apply_version("v1.2.3")
  assert(harness.fs.read_text(version_file) == "1.2.3\n")
  harness.fs.delete(root)
}
